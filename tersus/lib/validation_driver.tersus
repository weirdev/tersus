// The driver of the validator compiled to native code: it is put after
// lib/validation.tersus only for that build (see ValidatorNative), never
// for the interpreted one. It reads the encoded program the bridge writes
// (a count, then per function an entry block number, the entry state and
// the blocks, as the values SelfHostedMir.encode makes, written by
// ValidatorNative's serializer), checks each function with
// validateExecution, and writes the first non-zero verdict as four
// numbers on one line: status, block, step, function index. Four zeroes
// with index -1 mean every function proved.

enum DriverValue { DriverInvalid, DriverInt { value: Int }, DriverBool { value: Bool }, DriverList { items: List<DriverValue> }, DriverData { name: List<Int>, fields: List<DriverValue> } };

impl Clone for DriverValue { };

// (the parse reads one list of bytes, lent, and gives back the position it
// reached)
struct DriverParsed { value: DriverValue, pos: Int };

struct DriverIntParsed { value: Int, pos: Int, ok: Bool };

fn driverReadAll() -> List<Int> [{ }] [{ }] {
    bytes = [];
    remaining = 2000000000;
    c = readByte();
    while c >= 0 [{ affirm size(bytes) >= 0; }] shrinks remaining {
        bytes = push(bytes, c);
        remaining = remaining - 1;
        c = readByte();
    };
    return bytes;
};

fn driverSigned(sign: Int, negative: Int) -> Int {
    if sign < 0 { return negative; };
    return 0 - negative;
};

fn driverSkipWs(bytes: &List<Int>, start: Int) -> Int {
    pos = start;
    while pos < size(bytes) [{ affirm pos >= 0; }] shrinks size(bytes) - pos {
        if get(bytes, pos) > 32 { return pos; };
        pos = pos + 1;
    };
    return pos;
};

fn driverReadInt(bytes: &List<Int>, start: Int) -> DriverIntParsed {
    pos = driverSkipWs(bytes, start);
    sign = 1;
    if pos >= size(bytes) { return DriverIntParsed { value: 0, pos: pos, ok: false }; };
    if get(bytes, pos) = 45 { sign = 0 - 1; pos = pos + 1; };
    digits = pos;
    value = 0;
    while pos < size(bytes) [{ affirm pos >= 0; }] shrinks size(bytes) - pos {
        c = get(bytes, pos);
        if c < 48 || c > 57 {
            if pos = digits || c > 32 || (sign > 0 && value = 0 - 9223372036854775807 - 1) {
                return DriverIntParsed { value: 0, pos: pos, ok: false };
            };
            return DriverIntParsed { value: driverSigned(sign, value), pos: pos, ok: true };
        };
        digit = c - 48;
        if value < 0 - 922337203685477580 || (value = 0 - 922337203685477580 && digit > 8) {
            return DriverIntParsed { value: 0, pos: pos, ok: false };
        };
        value = value * 10 - digit;
        pos = pos + 1;
    };
    if pos = digits || (sign > 0 && value = 0 - 9223372036854775807 - 1) {
        return DriverIntParsed { value: 0, pos: pos, ok: false };
    };
    return DriverIntParsed { value: driverSigned(sign, value), pos: pos, ok: true };
};

fn driverParseItems(bytes: &List<Int>, start: Int, count: Int) -> DriverParsed [{ }] [{ }] {
    items = [];
    pos = start;
    for i in 0..count {
        parsed = driverParseValue(bytes, pos);
        if parsed.value is DriverValue::DriverInvalid { return parsed; };
        pos = parsed.pos;
        items = push(items, parsed.value);
    };
    return DriverParsed { value: DriverValue::DriverList { items: items }, pos: pos };
};

fn driverParseValue(bytes: &List<Int>, start: Int) -> DriverParsed [{ }] [{ }] shrinks size(bytes) - start {
    at = driverSkipWs(bytes, start);
    if at >= size(bytes) { return DriverParsed { value: DriverValue::DriverInvalid, pos: at }; };
    kind = get(bytes, at);
    if kind = 105 {
        parsed = driverReadInt(bytes, at + 1);
        if !parsed.ok { return DriverParsed { value: DriverValue::DriverInvalid, pos: parsed.pos }; };
        return DriverParsed { value: DriverValue::DriverInt { value: parsed.value }, pos: parsed.pos };
    };
    if kind = 98 {
        parsed = driverReadInt(bytes, at + 1);
        if !parsed.ok || (parsed.value != 0 && parsed.value != 1) { return DriverParsed { value: DriverValue::DriverInvalid, pos: parsed.pos }; };
        return DriverParsed { value: DriverValue::DriverBool { value: parsed.value != 0 }, pos: parsed.pos };
    };
    if kind = 108 {
        parsed = driverReadInt(bytes, at + 1);
        if !parsed.ok || parsed.value < 0 { return DriverParsed { value: DriverValue::DriverInvalid, pos: parsed.pos }; };
        return driverParseItems(bytes, parsed.pos, parsed.value);
    };
    if kind = 100 {
        nameStart = driverSkipWs(bytes, at + 1);
        if nameStart >= size(bytes) { return DriverParsed { value: DriverValue::DriverInvalid, pos: nameStart }; };
        if get(bytes, nameStart) != 110 { return DriverParsed { value: DriverValue::DriverInvalid, pos: nameStart }; };
        lenParsed = driverReadInt(bytes, nameStart + 1);
        if !lenParsed.ok || lenParsed.value < 0 { return DriverParsed { value: DriverValue::DriverInvalid, pos: lenParsed.pos }; };
        name = [];
        pos = lenParsed.pos;
        if pos >= size(bytes) { return DriverParsed { value: DriverValue::DriverInvalid, pos: pos }; };
        if get(bytes, pos) != 32 { return DriverParsed { value: DriverValue::DriverInvalid, pos: pos }; };
        pos = pos + 1;
        if lenParsed.value > size(bytes) - pos { return DriverParsed { value: DriverValue::DriverInvalid, pos: pos }; };
        for i in 0..lenParsed.value { name = push(name, get(bytes, pos + i)); };
        countParsed = driverReadInt(bytes, pos + lenParsed.value);
        if !countParsed.ok || countParsed.value < 0 { return DriverParsed { value: DriverValue::DriverInvalid, pos: countParsed.pos }; };
        items = driverParseItems(bytes, countParsed.pos, countParsed.value);
        if items.value is DriverValue::DriverList {
            return DriverParsed { value: DriverValue::DriverData { name: name, fields: clone((items.value as DriverValue::DriverList).items) }, pos: items.pos };
        };
        return items;
    };
    return DriverParsed { value: DriverValue::DriverInvalid, pos: at };
};

fn driverNameIs(name: &List<Int>, text: String) -> Bool {
    if size(name) != size(text.bytes) { return false; };
    for i in 0..size(name) {
        if get(name, i) != toInt(get(text.bytes, i)) { return false; };
    };
    return true;
};

fn driverInt(value: &DriverValue) -> Int {
    if value is DriverValue::DriverInt { return (value as DriverValue::DriverInt).value; };
    return 0;
};

fn driverBool(value: &DriverValue) -> Bool {
    if value is DriverValue::DriverBool { return (value as DriverValue::DriverBool).value; };
    return false;
};

fn driverItems(value: &DriverValue) -> List<DriverValue> {
    if value is DriverValue::DriverList { return clone((value as DriverValue::DriverList).items); };
    if value is DriverValue::DriverData { return clone((value as DriverValue::DriverData).fields); };
    return [];
};

fn driverField(value: &DriverValue, index: Int) -> DriverValue {
    items = driverItems(value);
    if index < size(items) { return clone(get(items, index)); };
    return DriverValue::DriverInt { value: 0 };
};

fn driverName(value: &DriverValue) -> List<Int> {
    if value is DriverValue::DriverData { return clone((value as DriverValue::DriverData).name); };
    return [];
};

fn driverInts(value: &DriverValue) -> List<Int> {
    out = [];
    for item in driverItems(value) { out = push(out, driverInt(item)); };
    return out;
};

fn driverValueRef(value: &DriverValue) -> ValueRef {
    if driverNameIs(driverName(value), "ValueRef::Local") { return ValueRef::Local { local: driverInt(driverField(value, 0)) }; };
    return ValueRef::Term { term: driverInt(driverField(value, 0)) };
};

fn driverValueRefs(value: &DriverValue) -> List<ValueRef> {
    out = [];
    for item in driverItems(value) { out = push(out, driverValueRef(item)); };
    return out;
};

fn driverGoal(value: &DriverValue) -> ValidatorGoal {
    name = driverName(value);
    if driverNameIs(name, "ValidatorGoal::Different") { return ValidatorGoal::Different { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) }; };
    if driverNameIs(name, "ValidatorGoal::Less") { return ValidatorGoal::Less { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) }; };
    if driverNameIs(name, "ValidatorGoal::AtMost") { return ValidatorGoal::AtMost { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) }; };
    if driverNameIs(name, "ValidatorGoal::Difference") { return ValidatorGoal::Difference { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)), bound: driverInt(driverField(value, 2)) }; };
    if driverNameIs(name, "ValidatorGoal::Within") { return ValidatorGoal::Within { inner: driverInt(driverField(value, 0)), outer: driverInt(driverField(value, 1)) }; };
    return ValidatorGoal::Equal { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) };
};

fn driverProofStep(value: &DriverValue) -> ProofStep {
    name = driverName(value);
    if driverNameIs(name, "ProofStep::KnownDifferent") { return ProofStep::KnownDifferent { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) }; };
    if driverNameIs(name, "ProofStep::KnownOrder") { return ProofStep::KnownOrder { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)), strict: driverBool(driverField(value, 2)) }; };
    if driverNameIs(name, "ProofStep::KnownDifference") { return ProofStep::KnownDifference { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)), bound: driverInt(driverField(value, 2)) }; };
    if driverNameIs(name, "ProofStep::Check") { return ProofStep::Check { goal: driverGoal(driverField(value, 0)) }; };
    return ProofStep::KnownEquality { left: driverInt(driverField(value, 0)), right: driverInt(driverField(value, 1)) };
};

fn driverStep(value: &DriverValue) -> ExecutionStep {
    name = driverName(value);
    if driverNameIs(name, "ExecutionStep::AdmitProofCall") {
        fields = driverItems(value);
        if size(fields) != 1 { return ExecutionStep::Unsupported; };
        function = get(fields, 0);
        if function is DriverValue::DriverInt {
            return ExecutionStep::AdmitProofCall { function: (function as DriverValue::DriverInt).value };
        };
        return ExecutionStep::Unsupported;
    };
    if driverNameIs(name, "ExecutionStep::Assign") { return ExecutionStep::Assign { local: driverInt(driverField(value, 0)), value: driverValueRef(driverField(value, 1)) }; };
    if driverNameIs(name, "ExecutionStep::Literal") { return ExecutionStep::Literal { result: driverInt(driverField(value, 0)), function: driverInt(driverField(value, 1)), arguments: driverValueRefs(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::Apply") { return ExecutionStep::Apply { local: driverInt(driverField(value, 0)), result: driverInt(driverField(value, 1)), function: driverInt(driverField(value, 2)), arguments: driverValueRefs(driverField(value, 3)) }; };
    if driverNameIs(name, "ExecutionStep::ApplyFresh") { return ExecutionStep::ApplyFresh { local: driverInt(driverField(value, 0)), function: driverInt(driverField(value, 1)), arguments: driverValueRefs(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::Push") { return ExecutionStep::Push { local: driverInt(driverField(value, 0)), list: driverValueRef(driverField(value, 1)), value: driverValueRef(driverField(value, 2)), zero: driverValueRef(driverField(value, 3)) }; };
    if driverNameIs(name, "ExecutionStep::Last") { return ExecutionStep::Last { local: driverInt(driverField(value, 0)), list: driverValueRef(driverField(value, 1)), zero: driverValueRef(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::Set") { return ExecutionStep::Set { local: driverInt(driverField(value, 0)), list: driverValueRef(driverField(value, 1)), index: driverValueRef(driverField(value, 2)), value: driverValueRef(driverField(value, 3)) }; };
    if driverNameIs(name, "ExecutionStep::Pop") { return ExecutionStep::Pop { local: driverInt(driverField(value, 0)), list: driverValueRef(driverField(value, 1)) }; };
    if driverNameIs(name, "ExecutionStep::NewArray") { return ExecutionStep::NewArray { local: driverInt(driverField(value, 0)), length: driverValueRef(driverField(value, 1)), value: driverValueRef(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::Havoc") { return ExecutionStep::Havoc { local: driverInt(driverField(value, 0)) }; };
    if driverNameIs(name, "ExecutionStep::RequireDefined") { return ExecutionStep::RequireDefined { value: driverValueRef(driverField(value, 0)) }; };
    if driverNameIs(name, "ExecutionStep::Check") { return ExecutionStep::Check { relation: driverInt(driverField(value, 0)), left: driverValueRef(driverField(value, 1)), right: driverValueRef(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::Assume") { return ExecutionStep::Assume { relation: driverInt(driverField(value, 0)), left: driverValueRef(driverField(value, 1)), right: driverValueRef(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::AssumeForall") { return ExecutionStep::AssumeForall { template: driverTemplate(driverField(value, 0)) }; };
    if driverNameIs(name, "ExecutionStep::AssumeVariant") { return ExecutionStep::AssumeVariant { object: driverValueRef(driverField(value, 0)), family: driverInt(driverField(value, 1)), constructor: driverInt(driverField(value, 2)), matches: driverBool(driverField(value, 3)) }; };
    if driverNameIs(name, "ExecutionStep::RequireVariant") { return ExecutionStep::RequireVariant { object: driverValueRef(driverField(value, 0)), family: driverInt(driverField(value, 1)), constructor: driverInt(driverField(value, 2)) }; };
    if driverNameIs(name, "ExecutionStep::CheckWithin") { return ExecutionStep::CheckWithin { inner: driverValueRef(driverField(value, 0)), outer: driverValueRef(driverField(value, 1)) }; };
    if driverNameIs(name, "ExecutionStep::Proof") { return ExecutionStep::Proof { step: driverProofStep(driverField(value, 0)) }; };
    return ExecutionStep::Unsupported;
};

fn driverSteps(value: &DriverValue) -> List<ExecutionStep> {
    out = [];
    for item in driverItems(value) { out = push(out, driverStep(item)); };
    return out;
};

fn driverLoopTests(value: &DriverValue) -> List<LoopTest> {
    result = [];
    for item in driverItems(value) { result = push(result, LoopTest { relation: driverInt(driverField(item, 0)), left: driverValueRef(driverField(item, 1)), right: driverValueRef(driverField(item, 2)) }); };
    return result;
};

fn driverEnd(value: &DriverValue) -> ExecutionEnd {
    name = driverName(value);
    if driverNameIs(name, "ExecutionEnd::Jump") { return ExecutionEnd::Jump { target: driverInt(driverField(value, 0)) }; };
    if driverNameIs(name, "ExecutionEnd::Branch") { return ExecutionEnd::Branch { yes: driverInt(driverField(value, 0)), no: driverInt(driverField(value, 1)), yesSteps: driverSteps(driverField(value, 2)), noSteps: driverSteps(driverField(value, 3)) }; };
    if driverNameIs(name, "ExecutionEnd::BooleanBranch") { return ExecutionEnd::BooleanBranch { yes: driverInt(driverField(value, 0)), no: driverInt(driverField(value, 1)), join: driverInt(driverField(value, 2)), value: driverValueRef(driverField(value, 3)), trueValue: driverValueRef(driverField(value, 4)), falseValue: driverValueRef(driverField(value, 5)) }; };
    if driverNameIs(name, "ExecutionEnd::Condition") { return ExecutionEnd::Condition { yes: driverInt(driverField(value, 0)), no: driverInt(driverField(value, 1)), relation: driverInt(driverField(value, 2)), left: driverValueRef(driverField(value, 3)), right: driverValueRef(driverField(value, 4)) }; };
    if driverNameIs(name, "ExecutionEnd::Loop") { return ExecutionEnd::Loop { exit: driverInt(driverField(value, 0)), body: driverInt(driverField(value, 1)), region: driverInts(driverField(value, 2)), checks: driverSteps(driverField(value, 3)), assumptions: driverSteps(driverField(value, 4)), havoc: driverInts(driverField(value, 5)), relation: driverInt(driverField(value, 6)), left: driverValueRef(driverField(value, 7)), right: driverValueRef(driverField(value, 8)), variant: driverValueRef(driverField(value, 9)), variantMode: driverInt(driverField(value, 10)), variantOther: driverValueRef(driverField(value, 11)), zero: driverValueRef(driverField(value, 12)), variantObject: driverValueRef(driverField(value, 13)), variantFamily: driverInt(driverField(value, 14)), variantConstructor: driverInt(driverField(value, 15)), orTests: driverLoopTests(driverField(value, 16)) }; };
    if driverNameIs(name, "ExecutionEnd::Unsupported") { return ExecutionEnd::Unsupported; };
    return ExecutionEnd::Done;
};

fn driverBlock(value: &DriverValue) -> ExecutionBlock {
    return ExecutionBlock { id: driverInt(driverField(value, 0)), steps: driverSteps(driverField(value, 1)), end: driverEnd(driverField(value, 2)) };
};

fn driverBlocks(value: &DriverValue) -> List<ExecutionBlock> {
    out = [];
    for item in driverItems(value) { out = push(out, driverBlock(item)); };
    return out;
};

fn driverEqualities(value: &DriverValue) -> List<EqualityFact> {
    out = [];
    for item in driverItems(value) { out = push(out, EqualityFact { left: driverInt(driverField(item, 0)), right: driverInt(driverField(item, 1)) }); };
    return out;
};

fn driverApplications(value: &DriverValue) -> List<ApplicationTerm> {
    out = [];
    for item in driverItems(value) { out = push(out, ApplicationTerm { id: driverInt(driverField(item, 0)), function: driverInt(driverField(item, 1)), arguments: driverInts(driverField(item, 2)) }); };
    return out;
};

fn driverConstants(value: &DriverValue) -> List<ConstantTerm> {
    out = [];
    for item in driverItems(value) { out = push(out, ConstantTerm { id: driverInt(driverField(item, 0)), kind: driverInt(driverField(item, 1)), value: driverInt(driverField(item, 2)) }); };
    return out;
};

fn driverOrders(value: &DriverValue) -> List<OrderFact> {
    out = [];
    for item in driverItems(value) { out = push(out, OrderFact { smaller: driverInt(driverField(item, 0)), greater: driverInt(driverField(item, 1)), strict: driverBool(driverField(item, 2)) }); };
    return out;
};

fn driverDifferent(value: &DriverValue) -> List<DisequalityFact> {
    out = [];
    for item in driverItems(value) { out = push(out, DisequalityFact { left: driverInt(driverField(item, 0)), right: driverInt(driverField(item, 1)) }); };
    return out;
};

fn driverVariants(value: &DriverValue) -> List<VariantFact> {
    out = [];
    for item in driverItems(value) { out = push(out, VariantFact { object: driverInt(driverField(item, 0)), family: driverInt(driverField(item, 1)), constructor: driverInt(driverField(item, 2)), matches: driverBool(driverField(item, 3)) }); };
    return out;
};

fn driverConstructorFields(value: &DriverValue) -> List<ConstructorField> {
    out = [];
    for item in driverItems(value) { out = push(out, ConstructorField { constructor: driverInt(driverField(item, 0)), field: driverInt(driverField(item, 1)), index: driverInt(driverField(item, 2)) }); };
    return out;
};

fn driverDifferences(value: &DriverValue) -> List<DifferenceFact> {
    out = [];
    for item in driverItems(value) { out = push(out, DifferenceFact { left: driverInt(driverField(item, 0)), right: driverInt(driverField(item, 1)), bound: driverInt(driverField(item, 2)) }); };
    return out;
};

fn driverProofFunction(value: &DriverValue) -> ProofFunction {
    bad = ProofFunction { function: driverInt(driverField(value, 0)), dependencies: [], io: false, userMayDiverge: false, unknown: true };
    if value is DriverValue::DriverData {
        data = value as DriverValue::DriverData;
        if driverNameIs(data.name, "ProofFunction") = false || size(data.fields) != 5 { return bad; };
        function = get(data.fields, 0);
        dependencies = get(data.fields, 1);
        io = get(data.fields, 2);
        diverges = get(data.fields, 3);
        unknown = get(data.fields, 4);
        if function is DriverValue::DriverInt && dependencies is DriverValue::DriverList
            && io is DriverValue::DriverBool && diverges is DriverValue::DriverBool && unknown is DriverValue::DriverBool {
            targets = [];
            for dependency in (dependencies as DriverValue::DriverList).items {
                if dependency is DriverValue::DriverInt { targets = push(targets, (dependency as DriverValue::DriverInt).value); }
                else { return bad; };
            };
            return ProofFunction { function: (function as DriverValue::DriverInt).value, dependencies: targets,
                io: (io as DriverValue::DriverBool).value, userMayDiverge: (diverges as DriverValue::DriverBool).value,
                unknown: (unknown as DriverValue::DriverBool).value };
        };
    };
    return bad;
};

fn driverProofFunctions(value: &DriverValue) -> List<ProofFunction> {
    rows = [];
    if value is DriverValue::DriverList {
        for row in (value as DriverValue::DriverList).items { rows = push(rows, driverProofFunction(row)); };
    };
    return rows;
};

fn driverContext(value: &DriverValue) -> ValidatorContext {
    return ValidatorContext {
        equalities: driverEqualities(driverField(value, 0)),
        applications: driverApplications(driverField(value, 1)),
        constants: driverConstants(driverField(value, 2)),
        orders: driverOrders(driverField(value, 3)),
        different: driverDifferent(driverField(value, 4)),
        variants: driverVariants(driverField(value, 5)),
        fieldFunctions: driverInts(driverField(value, 6)),
        constructorFunctions: driverInts(driverField(value, 7)),
        constructorFields: driverConstructorFields(driverField(value, 8)),
        differences: driverDifferences(driverField(value, 9)),
        proofFunctions: driverProofFunctions(driverField(value, 10)),
    };
};

fn driverLocals(value: &DriverValue) -> HashMap<Int, Int> {
    out = HashMap::new();
    if value is DriverValue::DriverData {
        for bucket in driverItems(driverField(value, 0)) {
            for entry in driverItems(bucket) {
                out = out.insert(driverInt(driverField(entry, 0)), driverInt(driverField(entry, 1)));
            };
        };
        return out;
    };
    for entry in driverItems(value) {
        out = out.insert(driverInt(driverField(entry, 0)), driverInt(driverField(entry, 1)));
    };
    return out;
};

fn driverTemplateNode(value: &DriverValue) -> TemplateNode {
    return TemplateNode { kind: driverInt(driverField(value, 0)), function: driverInt(driverField(value, 1)), value: driverValueRef(driverField(value, 2)), arguments: driverInts(driverField(value, 3)) };
};

fn driverTemplateRelation(value: &DriverValue) -> TemplateRelation {
    return TemplateRelation { relation: driverInt(driverField(value, 0)), left: driverInt(driverField(value, 1)), right: driverInt(driverField(value, 2)) };
};

fn driverTemplate(value: &DriverValue) -> ForallTemplate {
    nodes = [];
    for item in driverItems(driverField(value, 1)) { nodes = push(nodes, driverTemplateNode(item)); };
    guards = [];
    for item in driverItems(driverField(value, 2)) { guards = push(guards, driverTemplateRelation(item)); };
    return ForallTemplate { id: driverInt(driverField(value, 0)), nodes: nodes, guards: guards, body: driverTemplateRelation(driverField(value, 3)) };
};

fn driverState(value: &DriverValue) -> ExecutionState {
    return ExecutionState { context: driverContext(driverField(value, 0)), locals: driverLocals(driverField(value, 1)), templates: noTemplates() };
};

fn driverPrintInt(value: Int) -> Int [{ }] [{ }] {
    if value < 0 { writeByte(toByte(45)); out = driverPrintInt(0 - value); return out; };
    if value >= 10 { out = driverPrintInt(value / 10); };
    writeByte(toByte(48 + value % 10));
    return 0;
};

fn driverPrintVerdict(status: Int, block: Int, step: Int, index: Int) -> Int [{ }] [{ }] {
    out = driverPrintInt(status);
    writeByte(toByte(32));
    out = driverPrintInt(block);
    writeByte(toByte(32));
    out = driverPrintInt(step);
    writeByte(toByte(32));
    out = driverPrintInt(index);
    writeByte(toByte(10));
    return 0;
};

bytes = driverReadAll();
countParsed = driverReadInt(bytes, 0);
if !countParsed.ok || countParsed.value < 0 {
    printed = driverPrintVerdict(2, -1, -1, 0);
    return 0;
};
total = countParsed.value;
at = countParsed.pos;
index = 0;
while index < total [{ affirm index >= 0; }] shrinks total - index {
    entryParsed = driverReadInt(bytes, at);
    if !entryParsed.ok {
        printed = driverPrintVerdict(2, -1, -1, index);
        return 0;
    };
    stateParsed = driverParseValue(bytes, entryParsed.pos);
    if stateParsed.value is DriverValue::DriverInvalid {
        printed = driverPrintVerdict(2, -1, -1, index);
        return 0;
    };
    blocksParsed = driverParseValue(bytes, stateParsed.pos);
    if blocksParsed.value is DriverValue::DriverInvalid {
        printed = driverPrintVerdict(2, -1, -1, index);
        return 0;
    };
    at = blocksParsed.pos;
    result = validateExecution(driverBlocks(blocksParsed.value), entryParsed.value, driverState(stateParsed.value));
    if result.status != 0 {
        printed = driverPrintVerdict(result.status, result.block, result.step, index);
        return 0;
    };
    index = index + 1;
};
if driverSkipWs(bytes, at) != size(bytes) {
    printed = driverPrintVerdict(2, -1, -1, 0);
    return 0;
};
printed = driverPrintVerdict(0, -1, -1, -1);
return 0;
