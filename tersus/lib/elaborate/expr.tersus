import data::ast::ast { AstArg, AstArgs, AstBody, AstBuiltin, AstExpression, AstNode, AstOptName, AstValue };
import data::codec::codec { catStrings };
import elaborate::builtins { builtinIndex, builtinKey, builtinOfValue };
import elaborate::calls { argContext, argsOfFn, builtinHead, builtinIndexType, builtinRecord, checkCall, coerce, ctorArgTypes, emitIntValue, head, headKey, inScope, instantiateGenerics, intLiteral, keyType, lookupVar, sizeArgument, teHead, valueType, withType };
import elaborate::check { fnSigOf, mentionsParameter };
import elaborate::core { arrayOk, baseNameOf, checkConstruct, ctorInfo, ensureInstance, hasFunction, holdsGhost, isBoxTy, isListTy, isTuple, literalOk, ownsHeap, readField, tupleType, typeCtors, unrefOf };
import elaborate::out { emit, emitBuiltinCall, emitCall, emitName, emitNames, emitProofs, emitType, emitVal, emitValidations, emitVar };
import elaborate::records { exprOf, isVar, listItems, nameText, namesText, nodeIn, varName };
import elaborate::refs { Call, callOf, checkCallWrites, placeForm, placeRoot, refResultIndex };
import elaborate::state { St, TE, Ty, addTy, argAt, arrayTy, beginTry, boxTy, builtinKindAt, builtinValueAt, endTry, expect, fail, firstText, fnTy, freshSize, freshVar, indexIn, instanceName, intText, isSize, joinWith, kindOf, listTy, namedTy, notModelled, nth, ownedParameter, parameterOwner, parametersClone, protocolName, protocolIs, productFits, unclonedParameter, render, resolve, simpleTy, sizeConst, teHeadAt, tyAt, typeError, undoTry, unify, withTy, wrapTy, zonk };
import elaborate::traits { boundCallWritten, builtinSequenceCall, callResolved, emptyTemplate, implFunctionName, ownerOfValue, ownerThroughTrait, primitiveTraitCall, resolveAssociated, sequenceFunction, templateCall, traitArguments, traitFnNamed, traitFnOf, traitOwner };

fn leaf(st: St, t: Int, node: Int) -> St ~ {
    return St { te: TE { node: node, types: push([], t) }, ..st };
};

// A typed expression of a node, its type, and the typed expressions inside it in visit order
fn typed(st: St, node: Int, t: Int, inner: &List<TE>) -> St ~ {
    types = push([], t);
    for te in inner { for x in &te.types { types = push(types, x); }; };
    return St { te: TE { node: node, types: types }, ..st };
};

fn nodesOf(tes: &List<TE>) -> List<Int> ~ {
    out = [];
    for te in tes { out = push(out, te.node); };
    return out;
};

fn typesHeads(tes: &List<TE>) -> List<Int> ~ {
    out = [];
    for te in tes { out = push(out, head(&te.types)); };
    return out;
};

fn inferAll(st: St, args: &List<Int>) -> St ~ {
    tes = [];
    for a in args {
        st = inferExpr(st, a);
        if st.status != 0 { return St { tes: tes, ..st }; };
        tes = push(tes, clone(st.te));
    };
    return St { tes: tes, ..st };
};

fn argsCountText(name: String, n: Int, args: Int) -> String ~ {
    word = " arguments, got ";
    if n = 1 { word = " argument, got "; };
    return catStrings(catStrings(catStrings(catStrings(name, " takes "), intText(n)), word), intText(args));
};

// The type of an expression, and the expression with its calls resolved (inferExprR)
fn inferExpr(st: St, e: Int) -> St ~ {
    if st.status != 0 { return st; };
    ex = exprOf(st, e);
    if ex is AstExpression::Val { return inferValueExpr(st, e, (ex as AstExpression::Val).v); };
    if ex is AstExpression::Var { return inferVarExpr(st, e, (ex as AstExpression::Var).n); };
    return inferCall(st, e);
};

fn inferValueExpr(st: St, e: Int, v: Int) -> St ~ {
    st = valueType(st, v);
    return leaf(st, st.ty, e);
};

fn inferVarExpr(st: St, e: Int, n: Int) -> St ~ {
    name = nameText(&st.nodes, n);
    st = lookupVar(st, &name);
    if st.status != 0 { return st; };
    t = st.ty;
    st = zonk(st, t);
    x = tyAt(st, st.ty);
    if x.kind = 13 {
        names = clone(x.types);
        for s in &x.sizes { names = push(names, clone(s)); };
        return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings(clone(name), " has parameters <"), joinWith(&names, ", ")), ">, so it is called, as in "), clone(name)), "(...), and cannot be used as a value"));
    };
    return leaf(st, t, e);
};

// A call: the forms the checker gives a meaning of its own first, then a call of a function (inferExprR)
fn inferCall(st: St, e: Int) -> St ~ {
    c = callOf(st, e);
    args = clone(c.args);
    if c.key = "Field" && size(args) = 1 { return inferFieldCall(st, c.head, nth(&args, 0)); };
    if c.key = "Ctor" { return inferCtorCall(st, c.head, &args); };
    if c.key = "BorrowOf" || c.key = "BorrowMutOf" { return inferBorrowCall(st, c.key = "BorrowMutOf", &args); };
    return inferPlaceCall(st, e, c);
};

fn inferBorrowCall(st: St, mutable: Bool, args: &List<Int>) -> St ~ {
    if size(args) != 1 {
        word = "&";
        if mutable { word = "&mut"; };
        return typeError(st, catStrings(catStrings(catStrings(word, " takes a place, got "), intText(size(args))), " arguments"));
    };
    return borrowCall(st, mutable, nth(args, 0));
};

fn inferPlaceCall(st: St, e: Int, c: Call) -> St ~ {
    if c.key = "DerefOf" {
        if size(c.args) != 1 { return typeError(st, catStrings(catStrings("* takes a reference, got ", intText(size(c.args))), " arguments")); };
        return derefCall(st, nth(&c.args, 0));
    };
    if c.key = "OldOf" { return fail(st, "Type error: old(...) is only written in a postcondition, of the place an update parameter is to"); };
    return inferNamedCall(st, e, c.head, &c.args, &c.callee, &c.key);
};

fn inferNamedCall(st: St, e: Int, funct: Int, args: &List<Int>, fname: &String, key: &String) -> St ~ {
    if fname = "Box::new" { return inferBoxNew(st, args); };
    if fname = "Box::unbox" { return inferUnbox(st, args); };
    if fname = "Array::empty" { return inferEmptyArray(st, args); };
    return inferArrayCall(st, e, funct, args, fname, key);
};

fn inferArrayCall(st: St, e: Int, funct: Int, args: &List<Int>, fname: &String, key: &String) -> St ~ {
    if fname = "Array::fromList" { return inferArrayFromList(st, args); };
    if fname = "Array::uninit" { return inferUninit(st, args); };
    if fname = "Array::boxed" { return inferBoxedArray(st, args); };
    if headKey(st, funct) = "NewArray" { return inferNewArray(st, funct, args); };
    if key = "ArrayFrom" && size(args) = 1 && listLiteral(st, nth(args, 0)) { return inferArrayLiteral(st, e, args); };
    return inferCallRest(st, funct, args);
};

fn inferUninit(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 1 { return typeError(st, argsCountText("Array::uninit", 1, size(args))); };
    st = emitVar(st, "Uninit::empty");
    noArgs = [];
    st = emitCall(st, st.nid, &noArgs);
    boxedArgs = push(push([], nth(args, 0)), st.nid);
    st = emitVar(st, "Array::boxed");
    st = emitCall(st, st.nid, &boxedArgs);
    return inferExpr(st, st.nid);
};

// Whether an expression writes out a list value (Val (VList ...))
fn listLiteral(st: &St, e: Int) -> Bool ~ {
    lit = exprOf(st, e);
    if !(lit is AstExpression::Val) { return false; };
    vnode = nodeIn(&st.nodes, (lit as AstExpression::Val).v);
    return vnode is AstNode::Value && (vnode as AstNode::Value).value is AstValue::VList;
};

fn inferCallRest(st: St, funct: Int, args: &List<Int>) -> St ~ {
    fex = exprOf(st, funct);
    if headKey(st, funct) = "CloneOf" { return cloneCall(st, args); };
    if fex is AstExpression::Var {
        fname = nameText(&st.nodes, (fex as AstExpression::Var).n);
        if fname = "clone" && !HashMap::contains(&st.fns, "clone") && !inScope(st, "clone") { return cloneCall(st, args); };
        if fname = ".clone" && size(args) = 1 { return cloneMethod(st, args); };
        if size(fname.bytes) > 1 && get(fname.bytes, 0) = toByte(46) && size(args) > 0 {
            return methodCall(st, funct, fname.slice(1, size(fname.bytes)), args);
        };
        if HashMap::contains(&st.ghostNames, &fname) && !inScope(st, &fname) && !HashMap::contains(&st.fns, &fname) {
            index = HashMap::lookup(&st.ghostNames, &fname, 0 - 1);
            key = builtinKindAt(st, index);
            if !isAddressKey(&key) { return ghostExpr(st, fname, index, key, funct, args); };
        };
        if HashMap::contains(&st.pointer, &fname) && !inScope(st, &fname) && !HashMap::contains(&st.fns, &fname) {
            return pointerCall(st, fname, HashMap::lookup(&st.pointer, &fname, 0 - 1), args);
        };
        if size(fname.bytes) > 0 && get(fname.bytes, 0) = toByte(60) {
            st = inferAll(st, args);
            if st.status != 0 { return st; };
            inferred = clone(st.tes);
            return callResolved(st, fname, &inferred);
        };
        if traitPath(&fname) { return traitCall(st, funct, pathOf(&fname), functionOf(&fname), args); };
    };
    if fex is AstExpression::Val && size(args) = 2 {
        key = headKey(st, funct);
        if key = "Rel 0" || key = "Rel 1" {
            if st.inGhost { return general(st, funct, args); };
            return inferEquality(st, funct, key = "Rel 1", args);
        };
    };
    return general(st, funct, args);
};

fn inferBoxNew(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 1 { return typeError(st, argsCountText("Box::new", 1, size(args))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    x = clone(st.te);
    st = boxTy(st, head(&x.types));
    t = st.ty;
    callArgs = push([], x.node);
    st = emitBuiltinCall(st, "NewBox", &callArgs);
    parts = push([], x);
    return typed(st, st.nid, t, &parts);
};

fn inferUnbox(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 1 { return typeError(st, argsCountText("Box::unbox", 1, size(args))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    x = clone(st.te);
    st = zonk(st, head(&x.types));
    t = st.ty;
    if isBoxTy(st, t) {
        inner = argAt(st, t, 0);
        ix = tyAt(st, inner);
        if ix.kind = 6 && kindOf(st, nth(&ix.args, 1)) = 21 {
            return fail(st, "Type error: Box::unbox cannot take an array of no size out of its Box, since it would not know how much to take: read its elements with get and size");
        };
        callArgs = push([], x.node);
        st = emitBuiltinCall(st, "UnBox", &callArgs);
        parts = push([], x);
        return typed(st, st.nid, inner, &parts);
    };
    return typeError(st, catStrings("Box::unbox takes a Box, got ", render(st, t)));
};

fn inferEmptyArray(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 0 { return typeError(st, catStrings("Array::empty takes no arguments, got ", intText(size(args)))); };
    st = freshVar(st);
    elem = st.ty;
    st = simpleTy(st, 21);
    st = arrayTy(st, elem, st.ty);
    st = boxTy(st, st.ty);
    t = st.ty;
    callArgs = [];
    st = emitBuiltinCall(st, "NewEmptyArray", &callArgs);
    parts = [];
    return typed(st, st.nid, t, &parts);
};

fn inferArrayFromList(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 1 { return typeError(st, argsCountText("Array::fromList", 1, size(args))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    x = clone(st.te);
    st = zonk(st, head(&x.types));
    xt = st.ty;
    if isListTy(st, xt) {
        elem = argAt(st, xt, 0);
        st = freshSize(st);
        st = arrayTy(st, elem, st.ty);
        t = st.ty;
        st = arrayOk(st, t);
        callArgs = push([], x.node);
        st = emitBuiltinCall(st, "ArrayFromList", &callArgs);
        parts = push([], x);
        return typed(st, st.nid, t, &parts);
    };
    return typeError(st, catStrings("Array::fromList takes a list, got ", render(st, xt)));
};

fn inferBoxedArray(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 2 { return typeError(st, argsCountText("Array::boxed", 2, size(args))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    n = clone(st.te);
    st = simpleTy(st, 0);
    st = expect(st, "argument 1 of Array::boxed", st.ty, head(&n.types));
    st = inferExpr(st, nth(args, 1));
    if st.status != 0 { return st; };
    x = clone(st.te);
    st = simpleTy(st, 21);
    st = arrayTy(st, head(&x.types), st.ty);
    arr = st.ty;
    st = arrayOk(st, arr);
    st = requireClone(st, head(&x.types));
    st = boxTy(st, arr);
    t = st.ty;
    callArgs = push(push([], n.node), x.node);
    st = emitBuiltinCall(st, "NewBoxedArray", &callArgs);
    parts = push(push([], n), x);
    return typed(st, st.nid, t, &parts);
};

fn inferNewArray(st: St, funct: Int, args: &List<Int>) -> St ~ {
    if size(args) != 2 { return typeError(st, argsCountText("array", 2, size(args))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    n = clone(st.te);
    st = simpleTy(st, 0);
    intTy = st.ty;
    st = expect(st, "argument 1 of array", intTy, head(&n.types));
    st = inferExpr(st, nth(args, 1));
    if st.status != 0 { return st; };
    x = clone(st.te);
    st = arraySize(st, n.node);
    if st.status != 0 { return st; };
    sz = st.ty;
    sizeArg = st.nid;
    st = arrayTy(st, head(&x.types), sz);
    t = st.ty;
    st = arrayOk(st, t);
    st = requireClone(st, head(&x.types));
    callArgs = push(push([], sizeArg), x.node);
    st = emitCall(st, funct, &callArgs);
    parts = push(push([], TE { node: sizeArg, types: push([], intTy) }), x);
    return typed(st, st.nid, t, &parts);
};

fn inferArrayLiteral(st: St, e: Int, args: &List<Int>) -> St ~ {
    lit = exprOf(st, nth(args, 0));
    if lit is AstExpression::Val {
        v = (lit as AstExpression::Val).v;
        vnode = nodeIn(&st.nodes, v);
        if vnode is AstNode::Value && (vnode as AstNode::Value).value is AstValue::VList {
            items = listItems(&st.nodes, ((vnode as AstNode::Value).value as AstValue::VList).xs);
            st = valueType(st, v);
            if st.status != 0 { return st; };
            listT = st.ty;
            if !isListTy(st, listT) { return fail(st, "Type error: an array literal is made from a list"); };
            elem = argAt(st, listT, 0);
            st = sizeConst(st, size(items));
            st = arrayTy(st, elem, st.ty);
            t = st.ty;
            st = arrayOk(st, t);
            st = literalOk(st, elem);
            parts = push([], TE { node: nth(args, 0), types: push([], listT) });
            return typed(st, e, t, &parts);
        };
    };
return notModelled(st, "an array literal the data does not give");
};


fn isAddressKey(key: &String) -> Bool ~ {
    return key = "AddrNull" || key = "AddrOffset" || key = "AddrCast" || key = "AddrToInt" || key = "AddrFromInt";
};

// Whether a function of what is known of a permission is called on one, given the type of its first argument
// (permissionArgument)
fn permissionType(st: St, key: &String, t0: Int) -> St ~ {
    st = zonk(st, t0);
    t = st.ty;
    k = kindOf(st, t);
    inner = t;
    if k = 10 || k = 11 { inner = argAt(st, t, 0); };
    ik = kindOf(st, inner);
    if ik = 8 { return St { ok: true, ..st }; };
    if ik = 9 { return St { ok: key = "BlockFilled" || key = "BlockContents", ..st }; };
    return St { ok: false, ..st };
};

fn takesNoPermission(key: &String) -> Bool ~ {
    return isAddressKey(key) || key = "BlockExtent";
};

// What is known of a permission, in an expression of the validator (a define); in code it is not a value there is
fn ghostExpr(st: St, name: String, index: Int, key: String, funct: Int, args: &List<Int>) -> St ~ {
    if !takesNoPermission(&key) {
        if size(args) = 0 { return general(st, funct, args); };
        st = inferExpr(st, nth(args, 0));
        if st.status != 0 { return st; };
        first = teHead(&st.te);
        st = permissionType(st, &key, first);
        if !st.ok { return general(st, funct, args); };
    };
    if !st.inGhost {
        return typeError(st, catStrings(clone(name), " is what the validator knows of a permission, and is not a value the program has: it is written in an affirm, a contract, an invariant or a define"));
    };
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred = clone(st.tes);
    st = builtinIndexType(st, index);
    if st.status != 0 { return st; };
    ft = st.ty;
    filled = key = "BlockFilled" || key = "BlockContents";
    if filled && size(inferred) = 1 {
        uninitKey = "UninitAt";
        if key = "BlockFilled" { uninitKey = "UninitFilled"; };
        st = keyType(st, clone(uninitKey));
        if st.status != 0 { return st; };
        argTys = typesHeads(&inferred);
        st = checkCall(st, &name, st.ty, &argTys);
        if st.status != 0 { return st; };
        resultT = st.ty;
        argNodes = nodesOf(&inferred);
        st = emitBuiltinCall(st, uninitKey, &argNodes);
        return typed(st, st.nid, resultT, &inferred);
    };
    if filled {
        if size(inferred) != 2 { return typeError(st, catStrings(catStrings(clone(name), " takes a permission and a slot, as in "), catStrings(clone(name), "(b, i)"))); };
        blockT = clone(get(inferred, 0));
        indexT = clone(get(inferred, 1));
        blockTys = push([], teHead(&blockT));
        st = checkCall(st, &name, ft, &blockTys);
        if st.status != 0 { return st; };
        listT = st.ty;
        st = simpleTy(st, 0);
        st = expect(st, catStrings("argument 2 of ", clone(name)), st.ty, teHead(&indexT));
        st = freshVar(st);
        elementT = st.ty;
        st = listTy(st, elementT);
        st = expect(st, clone(name), st.ty, listT);
        if st.status != 0 { return st; };
        blockNodes = push([], blockT.node);
        st = emitBuiltinCall(st, clone(key), &blockNodes);
        innerParts = push([], blockT);
        st = typed(st, st.nid, listT, &innerParts);
        inner = clone(st.te);
        getNodes = push(push([], inner.node), indexT.node);
        st = emitBuiltinCall(st, "Get", &getNodes);
        parts = push(push([], inner), indexT);
        return typed(st, st.nid, elementT, &parts);
    };
    argTys = typesHeads(&inferred);
    st = checkCall(st, &name, ft, &argTys);
    if st.status != 0 { return st; };
    resultT = st.ty;
    argNodes = nodesOf(&inferred);
    st = emitBuiltinCall(st, key, &argNodes);
    return typed(st, st.nid, resultT, &inferred);
};

// Addr::alloc(n), Addr::get(p, i, b), Block::split(b, i), ...: the operations on addresses and permissions
fn pointerCall(st: St, name: String, index: Int, args: &List<Int>) -> St ~ {
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred0 = clone(st.tes);
    st = builtinIndexType(st, index);
    if st.status != 0 { return st; };
    ft = st.ty;
    st = coerceArguments(st, ft, &inferred0);
    if st.status != 0 { return st; };
    inferred = clone(st.tes);
    key = builtinKindAt(st, index);
    argTys = typesHeads(&inferred);
    st = checkBuiltinCall(st, clone(key), name, ft, &argTys);
    if st.status != 0 { return st; };
    resultT = st.ty;
    argNodes = nodesOf(&inferred);
    st = emitBuiltinCall(st, key, &argNodes);
    return typed(st, st.nid, resultT, &inferred);
};

fn pathOf(name: &String) -> String ~ {
    n = size(name.bytes);
    i = 1;
    while i + 2 < n [{ affirm i >= 1; affirm n = size(name.bytes); }] shrinks n - i {
        if get(name.bytes, i) = toByte(58) && get(name.bytes, i + 1) = toByte(58) { return name.slice(0, i); };
        i = i + 1;
    };
    return "";
};

// &place and &mut place: a reference to a place (borrowCall)
fn borrowCall(st: St, mutable: Bool, place: Int) -> St ~ {
    if !placeForm(st, place) {
        return fail(st, "Type error: & is to a place (a variable, a field of one, an element of one, or through a reference, as in &p.x, &get(xs, 0) or &*r): bind the value to a variable first if it needs borrowing");
    };
    readOnly = clone(st.readOnly);
    c = callOf(st, place);
    throughDeref = c.ok && c.key = "DerefOf" && size(c.args) = 1;
    placeT = TE { node: 0 - 1, types: [] };
    if throughDeref {
        st = inferExpr(st, nth(&c.args, 0));
        if st.status != 0 { return st; };
        innerT = clone(st.te);
        st = zonk(st, teHead(&innerT));
        itz = st.ty;
        if isBoxTy(st, itz) {
            boxed = argAt(st, itz, 0);
            derefArgs = push([], innerT.node);
            st = emitBuiltinCall(st, "DerefOf", &derefArgs);
            parts = push([], innerT);
            st = typed(st, st.nid, boxed, &parts);
            placeT = clone(st.te);
        } else {
            st = inferExpr(st, place);
            if st.status != 0 { return st; };
            placeT = clone(st.te);
        };
    } else {
        st = inferExpr(st, place);
        if st.status != 0 { return st; };
        placeT = clone(st.te);
    };
    st = zonk(st, teHead(&placeT));
    ptz = st.ty;
    pk = kindOf(st, ptz);
    if pk = 10 || pk = 11 { return fail(st, "Type error: a reference to a reference is not in the language: write &*r to borrow what a reference is to"); };
    if mutable {
        root = placeRoot(st, place);
        if size(root.bytes) > 0 && indexIn(&readOnly, &root) >= 0 {
            return typeError(st, catStrings(root, " is lent (&T) to this function and can only be read, so it cannot be borrowed for updating (&mut)"));
        };
        if throughDeref {
            st = inferExpr(st, nth(&c.args, 0));
            if st.status != 0 { return st; };
            st = zonk(st, teHead(&st.te));
            if kindOf(st, st.ty) = 10 {
                return fail(st, "Type error: an update reference (&mut) cannot be made through a read reference (&T): the read reference does not allow updating what it is to");
            };
        };
    };
    kind = 10;
    key = "BorrowOf";
    if mutable { kind = 11; key = "BorrowMutOf"; };
    st = wrapTy(st, kind, ptz);
    t = st.ty;
    borrowArgs = push([], placeT.node);
    st = emitBuiltinCall(st, key, &borrowArgs);
    parts = push([], placeT);
    return typed(st, st.nid, t, &parts);
};

// *r: the value a reference is to
fn derefCall(st: St, inner: Int) -> St ~ {
    innerName = varName(st, inner);
    lent = isVar(st, inner) && (indexIn(&st.readOnly, &innerName) >= 0 || indexIn(&st.mutParams, &innerName) >= 0);
    st = inferExpr(st, inner);
    if st.status != 0 { return st; };
    innerT = clone(st.te);
    t = teHead(&innerT);
    if !lent {
        st = zonk(st, t);
        etz = st.ty;
        ek = kindOf(st, etz);
        if ek != 10 && ek != 11 {
            return typeError(st, catStrings(catStrings("* is only through a reference, and the value here is ", render(st, etz)), ": write *r for a reference r, or clone(x) for a copy of a value"));
        };
        t = argAt(st, etz, 0);
    };
    derefArgs = push([], innerT.node);
    st = emitBuiltinCall(st, "DerefOf", &derefArgs);
    parts = push([], innerT);
    return typed(st, st.nid, t, &parts);
};

// A name that names a function of a trait or a type, as Type::f (traitPath)
fn traitPath(name: &String) -> Bool ~ {
    n = size(name.bytes);
    i = 1;
    while i + 2 < n [{ affirm i >= 1; affirm n = size(name.bytes); }] shrinks n - i {
        if get(name.bytes, i) = toByte(58) && get(name.bytes, i + 1) = toByte(58) { return true; };
        i = i + 1;
    };
    return false;
};

fn headBuiltin(st: &St, funct: Int) -> AstBuiltin ~ {
    ex = exprOf(st, funct);
    if ex is AstExpression::Val {
        b = builtinOfValue(st, (ex as AstExpression::Val).v);
        if b >= 0 { return builtinRecord(st, b); };
    };
    return AstBuiltin::Primitive { name: "" };
};

fn inferFieldCall(st: St, funct: Int, structExpr: Int) -> St ~ {
    rec = headBuiltin(st, funct);
    if !(rec is AstBuiltin::FieldBuiltin) { return notModelled(st, "a field read the data does not give"); };
    return inferField(st, funct, rec as AstBuiltin::FieldBuiltin, structExpr);
};

fn inferCtorCall(st: St, funct: Int, args: &List<Int>) -> St ~ {
    rec = headBuiltin(st, funct);
    if !(rec is AstBuiltin::Ctor) { return notModelled(st, "a constructor the data does not give"); };
    return inferCtor(st, funct, rec as AstBuiltin::Ctor, args);
};

fn inferField(st: St, funct: Int, field: AstBuiltin::FieldBuiltin, structExpr: Int) -> St ~ {
    owner = "";
    on = nodeIn(&st.nodes, field.owner);
    if on is AstNode::OptName && (on as AstNode::OptName).value is AstOptName::SomeName {
        owner = nameText(&st.nodes, ((on as AstNode::OptName).value as AstOptName::SomeName).n);
    };
    name = nameText(&st.nodes, field.n);
    st = inferExpr(st, structExpr);
    if st.status != 0 { return st; };
    s = clone(st.te);
    // (a field of the value itself is read as it is, and so is one of each value it is looked through to in turn; a field
    // none of them has is read from the last of them, which is where the error names it)
    reading = true;
    while reading [{ }] ~ {
        next = st.next;
        st = beginTry(st);
        st = readField(st, &owner, &name, head(&s.types));
        if st.status = 1 {
            st = undoTry(st, next);
            st = derefStepExpr(st, clone(s));
            if st.status != 0 { return st; };
            if st.ok { s = clone(st.te); } else {
                st = readField(st, &owner, &name, head(&s.types));
                reading = false;
            };
        } else { st = endTry(st); reading = false; };
    };
    if st.status != 0 { return st; };
    t = st.ty;
    st = zonk(st, head(&s.types));
    ty = st.ty;
    f = funct;
    // (a Box's own fields, the address of what it holds and the permission to it, are read as the Box instance's)
    if size(owner.bytes) = 0 && isBoxTy(st, ty) && (name = "addr" || name = "blk") {
        st = emitFieldValue(st, instanceName(st, ty), clone(name));
        st = emitVal(st, st.nid);
        f = st.nid;
    };
    callArgs = push([], s.node);
    st = emitCall(st, f, &callArgs);
    parts = push([], s);
    return typed(st, st.nid, t, &parts);
};

// An expression looked through one step, by a call of its type's deref where it has a Deref impl (derefStepExpr): st.ok
// whether it was, st.te the call. A Box's look-through is the language's, in the type.
fn derefStepExpr(st: St, te: TE) -> St ~ {
    st = zonk(st, teHead(&te));
    t = st.ty;
    if isBoxTy(st, t) { return St { ok: false, te: te, ..st }; };
    st = derefTarget(st, t);
    if st.status != 0 { return st; };
    if !st.ok { return St { te: te, ..st }; };
    st = derefOwner(st, t);
    if st.status != 0 { return st; };
    owner = firstText(&st.names);
    provider = protocolName(&st, "Deref");
    st = emitVar(st, implFunctionName(&owner, &provider, "deref"));
    functNode = st.nid;
    callArgs = push([], te.node);
    st = emitCall(st, functNode, &callArgs);
    st = inferExpr(st, st.nid);
    if st.status != 0 { return st; };
    return St { ok: true, ..st };
};

// An expression looked through to the value it holds, a step at a time (derefExpr)
fn derefExpr(st: St, te: TE) -> St ~ {
    looking = true;
    current = te;
    while looking [{ }] ~ {
        st = derefStepExpr(st, clone(current));
        if st.status != 0 { return st; };
        if st.ok { current = clone(st.te); } else { looking = false; };
    };
    return St { te: current, ..st };
};

// What a type is looked through to (derefTarget): st.ok, st.ty
fn derefTarget(st: St, t0: Int) -> St ~ {
    st = zonk(st, t0);
    t = st.ty;
    if isBoxTy(st, t) {
        inner = argAt(st, t, 0);
        return St { ok: true, ty: inner, ..st };
    };
    st = traitArguments(st, "Deref", t);
    if st.status != 0 { return st; };
    if st.ok && size(st.te.types) = 1 {
        target = get(st.te.types, 0);
        return St { ok: true, ty: target, ..st };
    };
    return St { ok: false, ..st };
};

// The type that owns the Deref impl of a type (derefOwner); st.names
fn derefOwner(st: St, t0: Int) -> St ~ {
    st = zonk(st, t0);
    t = st.ty;
    x = tyAt(st, t);
    if x.kind = 4 { return St { names: push([], clone(x.name)), ..st }; };
    if x.kind = 5 {
        st = ctorInfo(st, &x.name);
        if st.status != 0 { return st; };
        owner = clone(st.ctor.owner);
        return St { names: push([], owner), ..st };
    };
    return typeError(st, catStrings(render(st, t), " has no Deref impl"));
};

fn inferCtor(st: St, funct: Int, ctor: AstBuiltin::Ctor, args: &List<Int>) -> St ~ {
    name = nameText(&st.nodes, ctor.n);
    fields = namesText(&st.nodes, ctor.fs);
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred0 = clone(st.tes);
    base = baseNameOf(&name);
    st = ctorArgTypes(st, ctor.args);
    ctorArgs = clone(st.te.types);
    st = namedTy(st, clone(base), ctorArgs);
    ty0 = st.ty;
    tuple = isTuple(&base);
    if !tuple { st = ensureInstance(st, ty0); };
    declared = [];
    if !tuple {
        st = ctorInfo(st, &name);
        if st.status != 0 { return st; };
        declared = clone(st.ctor.types);
    };
    inferred = clone(inferred0);
    if size(declared) = size(inferred0) {
        inferred = [];
        i = 0;
        while i < size(declared) [{ affirm i >= 0; affirm size(declared) = size(inferred0); }] ~ {
            st = coerce(st, get(declared, i), clone(get(inferred0, i)));
            inferred = push(inferred, clone(st.te));
            i = i + 1;
        };
    };
    argTypes = typesHeads(&inferred);
    st = checkConstruct(st, ty0, &fields, &argTypes);
    if st.status != 0 { return st; };
    t = st.ty;
    argNodes = nodesOf(&inferred);
    st = emitCall(st, funct, &argNodes);
    return typed(st, st.nid, t, &inferred);
};

fn methodCall(st: St, funct: Int, method: String, args: &List<Int>) -> St ~ {
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred = clone(st.tes);
    st = zonk(st, teHeadAt(&inferred, 0));
    receiverTy = unrefOf(st, st.ty);
    if HashMap::contains(&st.methods, &method) && sequenceType(st, receiverTy) {
        index = HashMap::lookup(&st.methods, &method, 0 - 1);
        value = builtinValueAt(st, index);
        st = emitVal(st, value);
        functNode = st.nid;
        st = inferExpr(st, functNode);
        if st.status != 0 { return st; };
        functT = clone(st.te);
        return ordinaryBuiltin(st, functNode, functT, head(&functT.types), &inferred);
    };
    st = ownerOfValue(st, &method, teHeadAt(&inferred, 0));
    if st.status != 0 { return st; };
    owner = firstText(&st.names);
    st = sequenceFunction(st, &owner, &method);
    if st.status != 0 { return st; };
    resolved = firstText(&st.names);
    if size(ownedParameter(&owner).bytes) > 0 { st = boundCallWritten(st, funct, &owner, &method, false); };
    return callResolved(st, resolved, &inferred);
};

fn sequenceType(st: &St, t: Int) -> Bool ~ {
    x = tyAt(st, t);
    if isListTy(st, t) || x.kind = 6 { return true; };
    if isBoxTy(st, t) { return kindOf(st, nth(&x.args, 0)) = 6; };
    return false;
};

fn primitiveEq(st: &St, t: Int) -> Bool ~ {
    k = kindOf(st, t);
    return k = 0 || k = 1 || k = 2 || k = 3 || k = 7;
};

// a = b and a != b in code: the words of a primitive value are compared, and any other value by its Eq
fn inferEquality(st: St, funct: Int, negated: Bool, args: &List<Int>) -> St ~ {
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred = clone(st.tes);
    st = zonk(st, teHeadAt(&inferred, 0));
    at = unrefOf(st, st.ty);
    st = zonk(st, teHeadAt(&inferred, 1));
    bt = unrefOf(st, st.ty);
    st = expect(st, "argument 2 of the comparison", at, bt);
    if st.status != 0 { return st; };
    st = zonk(st, at);
    st = defaultUnknown(st, st.ty);
    st = zonk(st, at);
    t = st.ty;
    operands = clone(inferred);
    // (a Box has the value of what it holds, so two Boxes are compared by what they hold)
    unboxing = true;
    while unboxing [{ }] ~ {
        unboxing = false;
        if isBoxTy(st, t) {
            inner = argAt(st, t, 0);
            ix = tyAt(st, inner);
            if !(ix.kind = 6 && kindOf(st, nth(&ix.args, 1)) = 21) {
                unboxed = [];
                for e in &operands {
                    callArgs = push([], e.node);
                    st = emitBuiltinCall(st, "UnBox", &callArgs);
                    parts = push([], clone(e));
                    st = typed(st, st.nid, inner, &parts);
                    unboxed = push(unboxed, clone(st.te));
                };
                operands = unboxed;
                t = inner;
                st = zonk(st, t);
                t = st.ty;
                unboxing = true;
            };
        };
    };
    if primitiveEq(st, t) {
        st = inferExpr(st, funct);
        if st.status != 0 { return st; };
        functT = clone(st.te);
        return ordinaryBuiltin(st, funct, functT, head(&functT.types), &operands);
    };
    compared = push([], t);
    st = comparing(st, funct, &compared);
    if st.status != 0 { return st; };
    tx = tyAt(st, t);
    if isBoxTy(st, t) && kindOf(st, nth(&tx.args, 0)) = 6 && kindOf(st, argAt(st, nth(&tx.args, 0), 1)) = 21 {
        st = traitArguments(st, "Eq", t);
        if st.status != 0 { return st; };
        if !st.ok { return typeError(st, catStrings(render(st, t), " is compared with =, which needs its elements to implement Eq")); };
        st = callResolved(st, "eqBoxedArrays", &operands);
    } else {
        st = equalityCall(st, t, &operands);
    };
    if st.status != 0 || !negated { return st; };
    callT = clone(st.te);
    callArgs = push([], callT.node);
    st = emitBuiltinCall(st, "Not", &callArgs);
    parts = push([], callT);
    st = simpleTy(st, 2);
    return typed(st, st.nid, st.ty, &parts);
};

// A comparison of values of a type that implements Eq: a call of its eq (equalityCall)
fn equalityCall(st: St, t: Int, operands: &List<TE>) -> St ~ {
    provider = protocolName(&st, "Eq");
    if !HashSet::contains(&st.traits, &provider) {
        return typeError(st, catStrings(render(st, t), " is compared with =, which needs the trait Eq of lib/eq.tersus, which a program has unless it declares a trait Eq of its own"));
    };
    st = traitArguments(st, "Eq", t);
    if st.status != 0 { return st; };
    if !st.ok {
        x = tyAt(st, t);
        if x.kind = 15 { return fail(st, "Type error: the type of the values compared is not known yet; annotate it"); };
        if x.kind = 12 { return typeError(st, catStrings(catStrings(catStrings(catStrings(clone(x.name), " is compared with =, which needs it to implement Eq: bound it, as in <"), clone(x.name)), ": Eq>"), "")); };
        st = missingEq(st, t);
        if st.status != 0 { return st; };
        return typeError(st, catStrings(catStrings(render(st, t), " is compared with =, which needs it to implement Eq, and "), firstText(&st.names)));
    };
    st = traitOwner(st, "eq", t);
    if st.status != 0 { return st; };
    owner = firstText(&st.names);
    return callResolved(st, implFunctionName(&owner, &provider, "eq"), operands);
};

// Which part of a type has no Eq, to say what to write (missingEq); st.names
fn missingEq(st: St, t: Int) -> St ~ {
    x = tyAt(st, t);
    if isListTy(st, t) || isBoxTy(st, t) || x.kind = 6 {
        e = nth(&x.args, 0);
        st = traitArguments(st, "Eq", e);
        if st.status != 0 { return st; };
        if st.ok {
            shown = render(st, t);
            return St { names: push([], catStrings(shown, " does not")), ..st };
        };
        st = zonk(st, e);
        return missingEq(st, st.ty);
    };
    if x.kind = 4 {
        if HashSet::contains(&st.impls, catStrings("Eq ", x.name)) {
            lacking = [];
            for a in x.args {
                if !isSize(st, a) {
                    st = traitArguments(st, "Eq", a);
                    if st.status != 0 { return st; };
                    if !st.ok { lacking = push(lacking, a); };
                };
            };
            if size(lacking) > 0 { return missingEq(st, get(lacking, 0)); };
            shown = render(st, t);
            return St { names: push([], catStrings(shown, " does not")), ..st };
        };
        return St { names: push([], catStrings(catStrings(catStrings(clone(x.name), " does not: write impl Eq for "), clone(x.name)), " { }; to compare its fields")), ..st };
    };
    if x.kind = 5 {
        st = ctorInfo(st, &x.name);
        if st.status != 0 { return st; };
        enumName = clone(st.ctor.owner);
        return St { names: push([], catStrings(catStrings(catStrings(clone(enumName), " does not: write impl Eq for "), enumName), " { }; to compare its fields")), ..st };
    };
    shown = render(st, t);
    return St { names: push([], catStrings(shown, " does not")), ..st };
};

// The function part of Trait::function
fn functionOf(name: &String) -> String ~ {
    i = 0;
    while i + 1 < size(name.bytes) [{ affirm i >= 0; }] shrinks size(name.bytes) - i {
        if get(name.bytes, i) = toByte(58) && get(name.bytes, i + 1) = toByte(58) && i > 0 { return name.slice(i + 2, size(name.bytes)); };
        i = i + 1;
    };
    return "";
};

// Trait::f(x) and Type::f(x) (traitCall)
fn traitCall(st: St, funct: Int, path: String, function: String, args: &List<Int>) -> St ~ {
    if HashMap::contains(&st.traitFns, &path) {
        fns = HashMap::lookup(&st.traitFns, &path, []);
        st = inferAll(st, args);
        if st.status != 0 { return st; };
        inferred = clone(st.tes);
        st = primitiveTraitCall(st, &path, &fns, &function, &inferred);
        if st.status != 0 || st.ok { return st; };
        // (the builtin of that name, called as the program would call it by its name)
        if size(inferred) > 0 && builtinSequenceCall(&st, &path, &function, teHeadAt(&inferred, 0)) {
            st = emitVar(st, clone(function));
            return inferCallRest(st, st.nid, args);
        };
        ats = typesHeads(&inferred);
        st = ownerThroughTrait(st, &path, &fns, &function, &ats);
        if st.status != 0 { return st; };
        owner = firstText(&st.names);
        return callResolved(st, implFunctionName(&owner, &path, &function), &inferred);
    };
    if HashMap::contains(&st.types, &path) || HashMap::contains(&st.generics, &path) {
        st = inferAll(st, args);
        if st.status != 0 { return st; };
        inferred = clone(st.tes);
        st = resolveAssociated(st, &path, &function);
        if st.status != 0 { return st; };
        return callResolved(st, firstText(&st.names), &inferred);
    };
    if funct < 0 {
        st = emitVar(st, catStrings(catStrings(path, "::"), function));
        return general(st, st.nid, args);
    };
    return general(st, funct, args);
};

// x.clone(): the impl's clone when the value's type has one of its own, and clone(x) otherwise
fn cloneMethod(st: St, args: &List<Int>) -> St ~ {
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    receiver = clone(st.te);
    st = zonk(st, teHead(&receiver));
    x = tyAt(st, st.ty);
    owned = x.kind = 4 && !isBoxTy(st, st.ty) && HashMap::contains(&st.assoc, catStrings(x.name, " clone"));
    if !owned { return cloneCall(st, args); };
    st = ownerOfValue(st, "clone", teHead(&receiver));
    if st.status != 0 { return st; };
    owner = firstText(&st.names);
    st = resolveAssociated(st, &owner, "clone");
    if st.status != 0 { return st; };
    name = firstText(&st.names);
    input = clone(receiver);
    provider = protocolName(&st, "Clone");
    if HashMap::contains(&st.traitFns, &provider) && name = implFunctionName(&owner, &provider, "clone") {
        fns = HashMap::lookup(&st.traitFns, &provider, []);
        st = cloneTraitInput(st, &fns, receiver);
        input = clone(st.te);
    };
    inputs = push([], input);
    return callResolved(st, name, &inputs);
};

// clone(x): a copy of x, which has its value (cloneCall)
fn cloneCall(st: St, args: &List<Int>) -> St ~ {
    if size(args) != 1 { return typeError(st, catStrings("clone takes 1 argument, got ", intText(size(args)))); };
    st = inferExpr(st, nth(args, 0));
    if st.status != 0 { return st; };
    x = clone(st.te);
    xt = teHead(&x);
    st = zonk(st, xt);
    xtz = st.ty;
    k = kindOf(st, xtz);
    if k = 8 { st = requireMarker(st, "Clone", xt); return St { te: x, ..st }; };
    if k = 9 {
        st = ownsHeap(st, argAt(st, xtz, 0));
        if st.status != 0 { return st; };
        if st.ok { st = requireMarker(st, "Clone", xt); return St { te: x, ..st }; };
        return cloneWrap(st, x, xt);
    };
    // (a word, an address, a function and a reference are their own copy)
    if k = 0 || k = 1 || k = 2 || k = 3 || k = 7 || k = 14 || k = 10 || k = 11 { return St { te: x, ..st }; };
    if k = 12 || k = 15 || mentionsParameter(st, xtz) {
        uncloned = unclonedParameter(&st, xtz);
        if size(uncloned.bytes) > 0 {
            return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings(clone(st.current), " clones a "), render(st, xtz)), ", and its bounds do not say "), uncloned), ": Clone"));
        };
        return cloneWrap(st, x, xt);
    };
    xx = tyAt(st, xtz);
    if isBoxTy(st, xtz) && kindOf(st, nth(&xx.args, 0)) = 6 && kindOf(st, argAt(st, nth(&xx.args, 0), 1)) = 21 {
        if HashMap::contains(&st.templates, "cloneBoxedArray") || HashMap::contains(&st.fns, "cloneBoxedArray") {
            params = [];
            if HashMap::contains(&st.templates, "cloneBoxedArray") {
                params = HashMap::lookup(&st.templates, "cloneBoxedArray", emptyTemplate()).ptys;
            } else {
                ft = tyAt(st, HashMap::lookup(&st.fns, "cloneBoxedArray", 0));
                if ft.kind = 13 { ft = tyAt(st, nth(&ft.args, 0)); };
                if ft.kind = 14 { params = argsOfFn(&ft); };
            };
            input = clone(x);
            if size(params) > 0 && kindOf(st, get(params, 0)) = 10 {
                st = cloneInput(st, x);
                input = clone(st.te);
            };
            inputs = push([], input);
            return callResolved(st, "cloneBoxedArray", &inputs);
        };
        return traitCall(st, 0 - 1, "Clone", "clone", args);
    };
    // (a tuple is cloned part by part, as a struct is by its impl)
    if xx.kind = 4 && isTuple(&xx.name) {
        name = instanceName(st, xtz);
        st = ctorInfo(st, &name);
        if st.status != 0 { return st; };
        partNames = clone(st.ctor.names);
        parts = [];
        for field in &partNames {
            st = emitFieldValue(st, clone(name), clone(field));
            st = emitVal(st, st.nid);
            fieldFunct = st.nid;
            fieldArgs = push([], x.node);
            st = emitCall(st, fieldFunct, &fieldArgs);
            partArgs = push([], st.nid);
            st = cloneCall(st, &partArgs);
            if st.status != 0 { return st; };
            parts = push(parts, clone(st.te));
        };
        tupleArgs = clone(xx.args);
        st = emitCtorValue(st, clone(name), &tupleArgs, &partNames);
        st = emitVal(st, st.nid);
        ctorFunct = st.nid;
        partNodes = nodesOf(&parts);
        st = emitCall(st, ctorFunct, &partNodes);
        return typed(st, st.nid, xt, &parts);
    };
    return cloneTrait(st, x);
};

fn cloneWrap(st: St, x: TE, xt: Int) -> St ~ {
    callArgs = push([], x.node);
    st = emitBuiltinCall(st, "CloneOf", &callArgs);
    parts = push([], x);
    return typed(st, st.nid, xt, &parts);
};

// The impl's clone, given a borrow of the value when it takes one (cloneTrait)
fn cloneTrait(st: St, x: TE) -> St ~ {
    provider = protocolName(&st, "Clone");
    if !HashMap::contains(&st.traitFns, &provider) {
        args = push([], x.node);
        return traitCall(st, 0 - 1, provider, "clone", &args);
    };
    fns = HashMap::lookup(&st.traitFns, &provider, []);
    st = cloneTraitInput(st, &fns, clone(x));
    input = clone(st.te);
    ats = push([], teHead(&x));
    st = ownerThroughTrait(st, &provider, &fns, "clone", &ats);
    if st.status != 0 { return st; };
    owner = firstText(&st.names);
    inputs = push([], input);
    return callResolved(st, implFunctionName(&owner, &provider, "clone"), &inputs);
};

fn cloneTraitInput(st: St, fns: &List<Int>, x: TE) -> St ~ {
    f = traitFnNamed(st, fns, "clone");
    if f < 0 { return St { te: x, ..st }; };
    tf = traitFnOf(st, f);
    st = fnSigOf(st, tf.ps, tf.sig);
    ptys = clone(st.fnSig.ptys);
    if size(ptys) = 1 {
        p = tyAt(st, nth(&ptys, 0));
        if p.kind = 10 {
            q = tyAt(st, nth(&p.args, 0));
            if q.kind = 4 && q.name = "Self" && size(q.args) = 0 { return cloneInput(st, x); };
        };
    };
    return St { te: x, ..st };
};

// Whether a type, after any reference, is a Box: a value read through one (throughBox, over the types of the subexpressions)
fn crossesBox(st: St, types: &List<Int>, from: Int) -> St ~ {
    i = from;
    if i < 0 { i = 0; };
    while i < size(types) [{ affirm i >= 0; }] ~ {
        st = zonk(st, get(types, i));
        if isBoxTy(st, unrefOf(st, st.ty)) { return St { ok: true, ..st }; };
        i = i + 1;
    };
    return St { ok: false, ..st };
};

// A lent Clone input: a place is lent to the impl's clone by a borrow, not moved (cloneInput)
fn cloneInput(st: St, x: TE) -> St ~ {
    c = callOf(st, x.node);
    if c.ok && c.key = "UnBox" && size(c.args) = 1 && clonePlace(st, nth(&c.args, 0)) {
        ty = teHead(&x);
        st = zonk(st, ty);
        arrayPayload = kindOf(st, st.ty) = 6;
        st = crossesBox(st, &x.types, 2);
        if arrayPayload || st.ok { return St { te: x, ..st }; };
        derefArgs = push([], nth(&c.args, 0));
        st = emitBuiltinCall(st, "DerefOf", &derefArgs);
        pointee = TE { node: st.nid, types: clone(x.types) };
        borrowArgs = push([], pointee.node);
        st = emitBuiltinCall(st, "BorrowOf", &borrowArgs);
        borrowNode = st.nid;
        st = wrapTy(st, 10, ty);
        types = push([], st.ty);
        for t in &pointee.types { types = push(types, t); };
        return St { te: TE { node: borrowNode, types: types }, ..st };
    };
    st = crossesBox(st, &x.types, 1);
    boxed = st.ok;
    projection = !isVar(st, x.node) && clonePlace(st, x.node);
    if projection && !boxed {
        borrowArgs = push([], x.node);
        st = emitBuiltinCall(st, "BorrowOf", &borrowArgs);
        borrowNode = st.nid;
        st = wrapTy(st, 10, teHead(&x));
        types = push([], st.ty);
        for t in &x.types { types = push(types, t); };
        return St { te: TE { node: borrowNode, types: types }, ..st };
    };
    return St { te: x, ..st };
};

fn clonePlace(st: &St, e: Int) -> Bool ~ {
    if isVar(st, e) { return true; };
    c = callOf(st, e);
    if !c.ok { return false; };
    if (c.key = "Field" || c.key = "Cast") && size(c.args) = 1 { return clonePlace(st, nth(&c.args, 0)); };
    if size(c.args) = 2 && headKey(st, c.head) = "Get" { return clonePlace(st, nth(&c.args, 0)) && stableCloneIndex(st, nth(&c.args, 1)); };
    return c.key = "DerefOf" && size(c.args) = 1;
};

// (a later index call can replace a container whose earlier snapshot must be kept)
fn stableCloneIndex(st: &St, e: Int) -> Bool ~ {
    if isVar(st, e) { return true; };
    ex = exprOf(st, e);
    if ex is AstExpression::Val {
        v = nodeIn(&st.nodes, (ex as AstExpression::Val).v);
        return v is AstNode::Value && (v as AstNode::Value).value is AstValue::VInt;
    };
    c = callOf(st, e);
    if !c.ok { return false; };
    key = headKey(st, c.head);
    if key = "Plus" || key = "Minus" || key = "Times" || key = "Div" || key = "Mod" || key = "FromByte" {
        for a in &c.args {
            if !stableCloneIndex(st, a) { return false; };
        };
        return true;
    };
    return false;
};

// A copy is made of a type that has the marker (requireMarker)
fn requireMarker(st: St, marker: String, t: Int) -> St ~ {
    if st.status != 0 { return st; };
    st = implementsMarker(st, clone(marker), t, 0);
    if st.ok { return st; };
    st = zonk(st, t);
    st = lackingMarker(st, &marker, st.ty);
    lt = st.ty;
    k = kindOf(st, lt);
    if k = 8 { return typeError(st, catStrings(render(st, lt), " is a permission, which is never copied: there is only ever one for a piece of memory")); };
    if k = 9 { return typeError(st, catStrings(render(st, lt), " holds a value that owns something, or nothing, and native code cannot tell which: it is not copied (take the value out with Uninit::take, and copy that)")); };
    tail = "";
    if kindOf(st, lt) = 12 {
        tail = catStrings(catStrings(catStrings(catStrings(": bound it, as in <", render(st, lt)), ": "), clone(marker)), ">");
    } else { if marker = "Clone" {
        x = tyAt(st, lt);
        owner = render(st, lt);
        if x.kind = 4 { owner = clone(x.name); };
        if x.kind = 5 { owner = clone(x.name); };
        tail = catStrings(catStrings(", so a copy of it is not made: write impl Clone for ", owner), " { }; (its fields have to be Clone) if it should be");
    }; };
    return typeError(st, catStrings(catStrings(catStrings(render(st, lt), " does not implement "), clone(marker)), tail));
};

// (the type inside a list, a Box or an array that is the one without it)
fn lackingMarker(st: St, marker: &String, t: Int) -> St ~ {
    x = tyAt(st, t);
    if isListTy(st, t) || isBoxTy(st, t) || x.kind = 6 {
        e = nth(&x.args, 0);
        st = implementsMarker(st, clone(marker), e, 0);
        if st.ok { return withTy(st, t); };
        st = zonk(st, e);
        return lackingMarker(st, marker, st.ty);
    };
    return withTy(st, t);
};

// The value a builtin field read is, as the checker writes one (StdLib.builtinFunct (Field owner field)): owner "" for none
fn emitFieldValue(st: St, owner: String, field: String) -> St ~ {
    if size(owner.bytes) = 0 {
        st = emit(st, AstNode::OptName { value: AstOptName::NoName });
    } else {
        st = emitName(st, owner);
        st = emit(st, AstNode::OptName { value: AstOptName::SomeName { n: st.nid } });
    };
    ownerNode = st.nid;
    st = emitName(st, field);
    st = emit(st, AstNode::Builtin { value: AstBuiltin::FieldBuiltin { owner: ownerNode, n: st.nid } });
    params = push([], "struct");
    return emitBuiltinValue(st, st.nid, &params);
};

// The value a constructor is, as the checker writes one (StdLib.builtinFunct (Ctor name args fields))
fn emitCtorValue(st: St, name: String, args: &List<Int>, fields: &List<String>) -> St ~ {
    argNodes = [];
    for a in args {
        st = emitType(st, a);
        st = emit(st, AstNode::Arg { value: AstArg::ArgType { t: st.nid } });
        argNodes = push(argNodes, st.nid);
    };
    st = emit(st, AstNode::Args { value: AstArgs::End });
    tail = st.nid;
    i = size(argNodes) - 1;
    while i >= 0 [{ affirm i < size(argNodes); }] shrinks i + 1 {
        st = emit(st, AstNode::Args { value: AstArgs::Cons { head: get(argNodes, i), tail: tail } });
        tail = st.nid;
        i = i - 1;
    };
    argsNode = tail;
    st = emitName(st, name);
    nameNode = st.nid;
    st = emitNames(st, fields);
    st = emit(st, AstNode::Builtin { value: AstBuiltin::Ctor { n: nameNode, args: argsNode, fs: st.nid } });
    return emitBuiltinValue(st, st.nid, fields);
};

fn emitBuiltinValue(st: St, builtin: Int, params: &List<String>) -> St ~ {
    st = emit(st, AstNode::Body { value: AstBody::BuiltinFunct { b: builtin } });
    bodyNode = st.nid;
    st = emitNames(st, params);
    paramsNode = st.nid;
    noValidations = [];
    st = emitValidations(st, &noValidations);
    insNode = st.nid;
    st = emitValidations(st, &noValidations);
    outsNode = st.nid;
    noProofs = [];
    st = emitProofs(st, &noProofs);
    return emit(st, AstNode::Value { value: AstValue::VFunct { ps: paramsNode, ins: insNode, outs: outsNode, body: bodyNode, exports: st.nid } });
};

fn defaultUnknown(st: St, t: Int) -> St ~ {
    x = tyAt(st, t);
    if x.kind = 15 {
        st = simpleTy(st, 0);
        return unify(st, t, st.ty);
    };
    if isListTy(st, t) || isBoxTy(st, t) || x.kind = 6 { return defaultUnknown(st, nth(&x.args, 0)); };
    return st;
};

// A call that is not one of the forms above (general and generalCall)
fn general(st: St, funct: Int, args: &List<Int>) -> St ~ {
    fex = exprOf(st, funct);
    if fex is AstExpression::Var {
        name = nameText(&st.nodes, (fex as AstExpression::Var).n);
        if HashMap::contains(&st.templates, &name) && !inScope(st, &name) {
            tm = HashMap::lookup(&st.templates, &name, emptyTemplate());
            st = inferAll(st, args);
            if st.status != 0 { return st; };
            inferred = clone(st.tes);
            st = templateCall(st, name, tm, &inferred);
            return refResultKnown(st, funct);
        };
    };
    st = generalCall(st, funct, args);
    return refResultKnown(st, funct);
};

// A reference result has to come from a function whose signature names what it is from, called by name
fn refResultKnown(st: St, funct: Int) -> St ~ {
    if st.status != 0 { return st; };
    fex = exprOf(st, funct);
    k = kindOf(st, head(&st.te.types));
    if k = 10 || k = 11 {
        named = false;
        if fex is AstExpression::Var {
            callee = nameText(&st.nodes, (fex as AstExpression::Var).n);
            named = refResultIndex(st, &callee) >= 0 || callee = st.current;
        };
        if !(named || fex is AstExpression::Val) {
            return fail(st, "Type error: this call returns a reference, but what the result is from is not known: a reference result comes from a function whose signature names it (as in -> &T from xs), called by name");
        };
    };
    return st;
};

fn generalCall(st: St, funct: Int, args: &List<Int>) -> St ~ {
    ft = 0 - 1;
    functT = TE { node: funct, types: [] };
    if isVar(st, funct) && builtinHead(st, funct) < 0 {
        name = varName(st, funct);
        st = lookupVar(st, &name);
        if st.status != 0 { return st; };
        ft = st.ty;
        functT = TE { node: funct, types: push([], ft) };
    } else {
        st = inferExpr(st, funct);
        if st.status != 0 { return st; };
        functT = clone(st.te);
        ft = head(&functT.types);
    };
    st = zonk(st, ft);
    ftz = tyAt(st, st.ty);
    if ftz.kind = 13 {
        st = inferAll(st, args);
        if st.status != 0 { return st; };
        inferredG = clone(st.tes);
        st = genericCall(st, describe(st, funct), &ftz.sizes, &ftz.types, nth(&ftz.args, 0), &inferredG);
        if st.status != 0 { return st; };
        resultT = st.ty;
        argsG = clone(st.tes);
        argNodes = nodesOf(&argsG);
        st = emitCall(st, functT.node, &argNodes);
        all = headTExpr(st, &functT);
        for a in &argsG { all = push(all, clone(a)); };
        return typed(st, st.nid, resultT, &all);
    };
    return ordinary(st, funct, functT, ft, args);
};

fn describe(st: &St, funct: Int) -> String ~ {
    if isVar(st, funct) { return varName(st, funct); };
    return "call";
};

// The head of a call is visited when it is itself computed (not a name or a value)
fn headTExpr(st: &St, functT: &TE) -> List<TE> ~ {
    ex = exprOf(st, functT.node);
    if ex is AstExpression::F { return push([], clone(functT)); };
    return [];
};

fn ordinary(st: St, funct: Int, functT: TE, ft: Int, args: &List<Int>) -> St ~ {
    st = inferAll(st, args);
    if st.status != 0 { return st; };
    inferred0 = clone(st.tes);
    b = builtinHead(st, funct);
    if b >= 0 && size(inferred0) > 0 {
        key = builtinKey(st, b);
        i = builtinIndex(st, &key);
        if HashMap::contains(&st.methodOf, i) {
            fname = HashMap::lookup(&st.methodOf, i, "");
            st = zonk(st, teHeadAt(&inferred0, 0));
            x = tyAt(st, st.ty);
            if x.kind = 4 && x.name != "List" && x.name != "Box" {
                owner = clone(x.name);
                st = sequenceFunction(st, &owner, &fname);
                if st.status != 0 { return st; };
                return callResolved(st, firstText(&st.names), &inferred0);
            };
            if x.kind = 12 && st.defChecking {
                powner = parameterOwner(&x.name);
                st = resolveAssociated(st, &powner, &fname);
                if st.status != 0 { return st; };
                resolved = firstText(&st.names);
                st = boundCallWritten(st, funct, &powner, &fname, false);
                return callResolved(st, resolved, &inferred0);
            };
        };
    };
    return ordinaryBuiltin(st, funct, functT, ft, &inferred0);
};

fn isLookThroughKey(key: &String) -> Bool ~ { return key = "Is" || key = "Cast" || key = "Project"; };

fn ordinaryBuiltin(st: St, funct: Int, functT: TE, ft: Int, inferred0: &List<TE>) -> St ~ {
    key = headKey(st, funct);
    looked = clone(inferred0);
    if isLookThroughKey(&key) && size(inferred0) > 0 {
        st = derefExpr(st, clone(get(inferred0, 0)));
        if st.status != 0 { return st; };
        looked = set(looked, 0, clone(st.te));
    };
    inferred = clone(looked);
    if key = "WriteByte" || key = "WriteError" || key = "PathByte" || key = "StoreByte" || size(key.bytes) = 0 {
        st = coerceArguments(st, ft, &looked);
        if st.status != 0 { return st; };
        inferred = clone(st.tes);
    };
    ats = typesHeads(&inferred);
    st = checkBuiltinCall(st, headKey(st, funct), describe(st, funct), ft, &ats);
    if st.status != 0 { return st; };
    resultT = st.ty;
    st = comparing(st, funct, &ats);
    if st.status != 0 { return st; };
    argNodes = nodesOf(&inferred);
    st = emitCall(st, functT.node, &argNodes);
    all = headTExpr(st, &functT);
    for a in &inferred { all = push(all, clone(a)); };
    return typed(st, st.nid, resultT, &all);
};

// The arguments of a call of a function of the program, with the conversions its parameters ask for (coerceArguments)
fn coerceArguments(st: St, ft: Int, inferred: &List<TE>) -> St ~ {
    st = zonk(st, ft);
    x = tyAt(st, st.ty);
    if x.kind != 14 || size(x.args) - 1 != size(inferred) { return St { tes: clone(inferred), ..st }; };
    out = [];
    i = 0;
    while i < size(inferred) [{ affirm i >= 0; }] ~ {
        arg = clone(get(inferred, i));
        st = zonk(st, get(x.args, i));
        ptz = st.ty;
        st = zonk(st, head(&arg.types));
        atz = st.ty;
        pk = kindOf(st, ptz);
        ak = kindOf(st, atz);
        if pk = 10 && (ak = 10 || ak = 11) {
            st = expect(st, "reference argument", argAt(st, ptz, 0), argAt(st, atz, 0));
            if ak = 10 { arg = withType(&arg, ptz); };
        } else {
            if pk = 11 && ak = 11 {
                st = expect(st, "reference argument", argAt(st, ptz, 0), argAt(st, atz, 0));
                st = checkCallWrites(st, arg.node);
                arg = withType(&arg, ptz);
            } else {
                if pk = 11 && ak = 10 {
                    return fail(st, "Type error: a read reference (&T) cannot be given where an update reference (&mut T) is wanted: borrow the place for updating, as in &mut x");
                };
                if pk = 11 {
                    st = expect(st, "reference argument", argAt(st, ptz, 0), head(&arg.types));
                    if st.status != 0 { return st; };
                    argName = varName(st, arg.node);
                    if !(isVar(st, arg.node) && indexIn(&st.mutParams, &argName) >= 0) {
                        return fail(st, "Type error: an update reference (&mut T) is not lent silently: write &mut and the place, as in &mut x");
                    };
                    st = checkCallWrites(st, arg.node);
                    arg = withType(&arg, ptz);
                } else {
                    st = coerce(st, unrefOf(st, ptz), arg);
                    arg = clone(st.te);
                };
            };
        };
        if st.status != 0 { return st; };
        out = push(out, arg);
        i = i + 1;
    };
    return St { tes: out, ..st };
};

// size, first, last, get, set and replace on an array, toInt of a word, and is/as of a Box (checkBuiltinCall)
fn checkBuiltinCall(st: St, key: String, name: String, ft: Int, ats: &List<Int>) -> St ~ {
    if size(ats) > 0 && (key = "Size" || key = "First" || key = "Last" || key = "Get" || key = "Set" || key = "Replace") {
        st = zonk(st, nth(ats, 0));
        t = st.ty;
        x = tyAt(st, t);
        if x.kind = 6 { return arrayCall(st, &key, &name, false, nth(&x.args, 1), ats); };
        if isBoxTy(st, t) && kindOf(st, nth(&x.args, 0)) = 6 { return arrayCall(st, &key, &name, true, argAt(st, nth(&x.args, 0), 1), ats); };
        return checkCall(st, &name, ft, ats);
    };
    if size(ats) > 0 && isLookThroughKey(&key) {
        st = zonk(st, nth(ats, 0));
        t = st.ty;
        lookedThrough = set(clone(ats), 0, argAt(st, t, 0));
        if isBoxTy(st, t) { return checkCall(st, &name, ft, &lookedThrough); };
        return checkCall(st, &name, ft, ats);
    };
    if size(ats) = 1 && key = "FromByte" {
        st = zonk(st, nth(ats, 0));
        if kindOf(st, st.ty) = 3 { return simpleTy(st, 0); };
        return checkCall(st, &name, ft, ats);
    };
    return checkCall(st, &name, ft, ats);
};

fn arrayCall(st: St, key: &String, name: &String, boxed: Bool, sz: Int, ats: &List<Int>) -> St ~ {
    st = freshVar(st);
    a = st.ty;
    st = arrayTy(st, a, sz);
    seq = st.ty;
    if boxed { st = boxTy(st, seq); seq = st.ty; };
    st = wrapTy(st, 10, seq);
    refSeq = st.ty;
    st = simpleTy(st, 0);
    intTy = st.ty;
    if key = "Size" { st = fnTy(st, push([], refSeq), intTy); };
    if key = "Get" { st = fnTy(st, push(push([], refSeq), intTy), a); };
    if key = "Set" { st = fnTy(st, push(push(push([], seq), intTy), a), seq); };
    if key = "Replace" {
        pair = push(push([], seq), a);
        st = tupleType(st, &pair);
        st = fnTy(st, push(push(push([], seq), intTy), a), st.ty);
    };
    if key = "First" || key = "Last" { st = fnTy(st, push([], refSeq), a); };
    return checkCall(st, name, st.ty, ats);
};

// Equality is structural, which functions do not have (comparing): only the first argument of = and != is looked at
fn comparing(st: St, funct: Int, ats: &List<Int>) -> St ~ {
    if st.status != 0 { return st; };
    ex = exprOf(st, funct);
    if !(ex is AstExpression::Val) || size(ats) = 0 { return st; };
    key = headKey(st, funct);
    if key != "Rel 0" && key != "Rel 1" { return st; };
    st = zonk(st, nth(ats, 0));
    t = st.ty;
    k = kindOf(st, t);
    if k = 14 { return fail(st, "Type error: functions cannot be compared"); };
    if k = 9 { return fail(st, "Type error: an Uninit cannot be compared, since it may hold nothing: what it holds is compared, as in Uninit::get(a) = Uninit::get(b)"); };
    st = holdsGhost(st, t);
    if st.ok {
        return typeError(st, catStrings(render(st, t), " holds a permission, which cannot be compared: what a permission says is compared, as in at(a, 0) = at(b, 0)"));
    };
    return st;
};

// The size of an array made by array(n, x): a constant, or a size parameter of the function (arraySize); st.ty the
// size and st.nid the argument as it is written in the result
fn arraySize(st: St, n: Int) -> St ~ {
    if isVar(st, n) {
        v = varName(st, n);
        if indexIn(&st.sizeScope, &v) >= 0 {
            st = addTy(st, Ty { kind: 22, name: v, args: [], n: 0, flag: false, sizes: [], types: [] });
            return St { nid: n, ..st };
        };
    };
    c = constantInt(st, n);
    if c.status = 1 { return fail(st, noConstantSize()); };
    if c.status = 2 { return fail(st, c.msg); };
    st = sizeConst(st, c.value);
    sz = st.ty;
    st = emitIntValue(st, c.value);
    st = emitVal(st, st.nid);
    return St { ty: sz, ..st };
};

fn noConstantSize() -> String ~ {
    return "Type error: the size of an array must be a constant (a number, arithmetic on numbers, or a size parameter of the function), since the array is held inline (for a size that the program works out, use Array::boxed(n, x), which puts the array on the heap in a Box)";
};

// The value of an expression made of numbers and arithmetic (constantInt): status 0 a value, 1 not one, 2 an error
struct Folded { value: Int, status: Int, msg: String };
impl Clone for Folded { };

fn constantInt(st: &St, e: Int) -> Folded ~ {
    lit = intLiteral(st, e);
    if lit.ok { return Folded { value: lit.value, status: 0, msg: "" }; };
    ex = exprOf(st, e);
    if !(ex is AstExpression::F) { return Folded { value: 0, status: 1, msg: "" }; };
    call = ex as AstExpression::F;
    fex = exprOf(st, call.f);
    if !(fex is AstExpression::Val) { return Folded { value: 0, status: 1, msg: "" }; };
    key = headKey(st, call.f);
    args = listItems(&st.nodes, call.xs);
    if size(args) != 2 || !(key = "Plus" || key = "Minus" || key = "Times" || key = "Div" || key = "Mod") { return Folded { value: 0, status: 1, msg: "" }; };
    a = constantInt(st, nth(&args, 0));
    if a.status = 1 { return a; };
    c = constantInt(st, nth(&args, 1));
    if c.status = 1 { return c; };
    if a.status = 2 { return a; };
    if c.status = 2 { return c; };
    return constantArithmetic(&key, a.value, c.value);
};

// One step of the arithmetic of a size, which has to stay in the Int range and not divide by zero, as when the
// program runs (constantArithmetic)
fn constantArithmetic(key: &String, a: Int, c: Int) -> Folded ~ {
    if key = "Plus" { return foldedPlus(a, c); };
    if key = "Minus" { return foldedMinus(a, c); };
    if key = "Times" { return foldedTimes(a, c); };
    if key = "Div" { return foldedDiv(a, c); };
    return foldedMod(a, c);
};

fn sizeOverflow() -> Folded ~ { return Folded { value: 0, status: 2, msg: "Type error: integer overflow in the size of an array (an Int is 64 bits)" }; };

// (the bounds of an Int are written out: the validator sees a constant, where maxInt() says nothing of its result)
fn foldedPlus(a: Int, c: Int) -> Folded ~ {
    if c > 0 && a > 9223372036854775807 - c { return sizeOverflow(); };
    if c < 0 && a < 0 - 9223372036854775807 - 1 - c { return sizeOverflow(); };
    return Folded { value: a + c, status: 0, msg: "" };
};

fn foldedMinus(a: Int, c: Int) -> Folded ~ {
    if c > 0 && a < 0 - 9223372036854775807 - 1 + c { return sizeOverflow(); };
    if c < 0 && a > 9223372036854775807 + c { return sizeOverflow(); };
    return Folded { value: a - c, status: 0, msg: "" };
};

fn foldedTimes(a: Int, c: Int) -> Folded ~ {
    if !productFits(a, c) { return sizeOverflow(); };
    return Folded { value: a * c, status: 0, msg: "" };
};

fn foldedDiv(a: Int, c: Int) -> Folded ~ {
    if c = 0 { return Folded { value: 0, status: 2, msg: "Type error: division by zero in the size of an array" }; };
    if a = 0 - 9223372036854775807 - 1 && c = 0 - 1 { return sizeOverflow(); };
    return Folded { value: a / c, status: 0, msg: "" };
};

fn foldedMod(a: Int, c: Int) -> Folded ~ {
    if c = 0 { return Folded { value: 0, status: 2, msg: "Type error: modulo by zero in the size of an array" }; };
    if a = 0 - 9223372036854775807 - 1 && c = 0 - 1 { return Folded { value: 0, status: 0, msg: "" }; };
    return Folded { value: a % c, status: 0, msg: "" };
};

// A call of a function with size and type parameters (genericCall): st.ty the result, st.tes the arguments and the sizes
fn genericCall(st: St, name: String, names: &List<String>, types: &List<String>, inner: Int, inferred: &List<TE>) -> St ~ {
    st = instantiateGenerics(st, names, types, inner);
    instantiated = st.ty;
    vars = clone(st.te.types);
    x = tyAt(st, instantiated);
    if x.kind != 14 { return typeError(st, catStrings(name, " is not a function")); };
    pts = argsOfFn(&x);
    if size(pts) - size(names) != size(inferred) {
        return typeError(st, catStrings(catStrings(catStrings(catStrings(clone(name), " takes "), intText(size(pts) - size(names))), " arguments, got "), intText(size(inferred))));
    };
    out = [];
    i = 0;
    while i < size(inferred) [{ affirm i >= 0; }] ~ {
        st = zonk(st, get(pts, i));
        ptz = st.ty;
        st = coerce(st, unrefOf(st, ptz), clone(get(inferred, i)));
        if st.status != 0 { return st; };
        arg = clone(st.te);
        st = zonk(st, head(&arg.types));
        atz = st.ty;
        pk = kindOf(st, ptz);
        ak = kindOf(st, atz);
        if (pk = 10 && (ak = 10 || ak = 11)) || (pk = 11 && ak = 11) {
            st = expect(st, argContext(&name, i + 1), argAt(st, ptz, 0), argAt(st, atz, 0));
        } else {
            st = expect(st, argContext(&name, i + 1), unrefOf(st, ptz), atz);
        };
        if st.status != 0 { return st; };
        out = push(out, arg);
        i = i + 1;
    };
    given = [];
    j = 0;
    while j < size(names) && j < size(vars) [{ affirm j >= 0; }] ~ {
        st = zonk(st, get(vars, j));
        st = sizeArgument(st, &name, &get(names, j), st.ty);
        if st.status != 0 { return st; };
        given = push(given, st.nid);
        j = j + 1;
    };
    k = 0;
    while k < size(types) [{ affirm k >= 0; }] ~ {
        st = zonk(st, nth(&vars, size(names) + k));
        t = st.ty;
        n = get(types, k);
        if hasFunction(st, t) {
            return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings("the type ", clone(n)), " of "), clone(name)), catStrings(" would be ", render(st, t))), ", and a type parameter is not a function"));
        };
        st = holdsGhost(st, t);
        if st.ok {
            return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings("the type ", clone(n)), " of "), clone(name)), catStrings(" would be ", render(st, t))), ", which holds a permission, and a type parameter is not one (a function that takes any type may drop or keep a value of it, and a permission is used exactly once)"));
        };
        if st.current = name && isExpanding(st, &st.typeScope, t) {
            return typeError(st, catStrings(catStrings(catStrings(catStrings(clone(name), " calls itself with the type "), render(st, t)), catStrings(" for ", clone(n))), ", which is made of its own type parameters: a call of itself gives each type parameter as it is, or a type that does not use them, since a copy of the function is made for each type and would be needed for each depth"));
        };
        k = k + 1;
    };
    st = zonk(st, nth(&x.args, size(x.args) - 1));
    resultT = st.ty;
    st = simpleTy(st, 0);
    intTy = st.ty;
    for g in given { out = push(out, TE { node: g, types: push([], intTy) }); };
    return St { ty: resultT, tes: out, ..st };
};

fn isExpanding(st: &St, scope: &List<String>, t: Int) -> Bool ~ {
    if kindOf(st, resolve(st, t)) = 12 { return false; };
    return usesParam(st, scope, t);
};

fn usesParam(st: &St, scope: &List<String>, t: Int) -> Bool ~ {
    x = tyAt(st, resolve(st, t));
    if x.kind = 12 { return indexIn(scope, &x.name) >= 0; };
    if x.kind = 6 { return usesParam(st, scope, nth(&x.args, 0)); };
    if x.kind = 4 || x.kind = 14 || (x.kind >= 7 && x.kind <= 11) {
        for a in x.args { if !isSize(st, a) && usesParam(st, scope, a) { return true; }; };
    };
    return false;
};

// A copy is made of a type that implements Clone (requireClone, implementsMarker)
fn requireClone(st: St, t: Int) -> St ~ {
    if st.status != 0 { return st; };
    return requireMarker(st, "Clone", t);
};

fn implementsMarker(st: St, marker: String, t0: Int, depth: Int) -> St ~ {
    if depth > 16 { return St { ok: true, ..st }; };
    st = zonk(st, t0);
    t = st.ty;
    x = tyAt(st, t);
    if x.kind <= 3 || x.kind = 14 || x.kind = 15 || x.kind = 7 { return St { ok: true, ..st }; };
    if x.kind = 10 { return implementsMarker(st, marker, nth(&x.args, 0), depth + 1); };
    if x.kind = 12 && marker = "Clone" { return St { ok: parametersClone(&st, t), ..st }; };
    if x.kind = 12 { return St { ok: st.defChecking && HashSet::contains(&st.impls, catStrings(catStrings(clone(marker), " "), parameterOwner(&x.name))), ..st }; };
    if x.kind = 6 { return implementsMarker(st, marker, nth(&x.args, 0), depth + 1); };
    if isListTy(st, t) || isBoxTy(st, t) {
        if marker = "Clone" { return implementsMarker(st, marker, nth(&x.args, 0), depth + 1); };
        return St { ok: false, ..st };
    };
    if x.kind = 8 { return St { ok: false, ..st }; };
    if x.kind = 9 {
        st = ownsHeap(st, nth(&x.args, 0));
        if st.ok { return St { ok: false, ..st }; };
        return implementsMarker(st, marker, nth(&x.args, 0), depth + 1);
    };
    if x.kind = 4 && x.name = "Self" { return St { ok: marker = "Clone", ..st }; };
    if x.kind = 4 && isTuple(&x.name) {
        for a in x.args {
            if !isSize(st, a) {
                st = implementsMarker(st, clone(marker), a, depth + 1);
                if !st.ok { return st; };
            };
        };
        return St { ok: true, ..st };
    };
    if x.kind = 4 { return declaredMarker(st, marker, depth, instanceName(st, t)); };
    if x.kind = 5 {
        st = ctorInfo(st, &x.name);
        if st.status != 0 { return st; };
        return declaredMarker(st, marker, depth, clone(st.ctor.owner));
    };
    return St { ok: false, ..st };
};

fn declaredMarker(st: St, marker: String, depth: Int, name: String) -> St ~ {
    base = baseNameOf(&name);
    if !HashSet::contains(&st.impls, catStrings(catStrings(marker, " "), clone(base))) { return St { ok: false, ..st }; };
    // (a struct with types is Copy for the types that are, and a Clone one is checked where its impl is)
    if marker = "Copy" && base != name {
        st = typeCtors(st, &name);
        if st.status != 0 { return st; };
        for c in clone(st.names) {
            st = ctorInfo(st, &c);
            if st.status != 0 { return st; };
            for t in clone(st.ctor.types) {
                st = implementsMarker(st, clone(marker), t, depth + 1);
                if st.status != 0 || !st.ok { return st; };
            };
        };
    };
    return St { ok: true, ..st };
};
