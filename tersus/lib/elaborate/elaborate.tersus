// The elaborator written in Tersus: a `tersus-elaborate 1` request on standard input, a `tersus-elaborated 1`
// response on standard output (AST_DATA.md). It answers `unmodelled` for what it does not handle yet.

fn newState() -> St ~ {
    return St {
        nodes: [], tys: [], subst: HashMap::new(), sizeSubst: HashMap::new(), next: 0,
        wireVersion: false, wireProtocols: HashMap::new(), wireOwnership: HashMap::new(),
        types: HashMap::new(), ctors: HashMap::new(), generics: HashMap::new(), linearTypes: HashSet::new(), drops: HashSet::new(),
        traits: HashSet::new(), traitFns: HashMap::new(), traitParams: HashMap::new(), traitSelf: [], inTrait: false, assoc: HashMap::new(), implArgs: HashMap::new(), implBounds: HashMap::new(), implBoundsNodes: HashMap::new(), ownerViews: [], logging: false, implDefined: [], ghostCache: HashMap::new(), refCache: HashMap::new(), boundedParts: noBoundedParts(), big: [], undo: [], sizeUndo: [], templates: HashMap::new(), references: HashMap::new(), referenceList: [], boundStubs: HashMap::new(), boundStubSigs: [], builtinStubs: HashSet::new(), genericOut: [], genericTypes: [], fns: HashMap::new(), scopes: oneScope(),
        ret: 0 - 1, programReturn: 0 - 1, sizeScope: [], typeScope: [], readOnly: [], mutParams: [], writes: [], aliasNames: [], aliasPlaces: [], originNames: [], originRoots: [], refResultNames: [], refResultParams: [], refResultFroms: [], resultFrom: [], params: [], current: "", inGhost: false,
        predeclared: HashSet::new(), impls: HashSet::new(), builtinNames: HashMap::new(), builtinValues: [], builtinSchemes: [],
        builtinKinds: [], stdNames: HashMap::new(), pointer: HashMap::new(), ghostNames: HashMap::new(), methods: HashMap::new(),
        methodOf: HashMap::new(), ty: 0, ok: true, te: TE { node: 0 - 1, types: [] }, tes: [], outs: [], nid: 0 - 1, n: 0,
        gen: Generic { params: [], names: [], types: [] }, ctor: CtorInfo { owner: "", names: [], types: [] }, names: [],
        fnSig: FnSig { params: [], ptys: [], rty: 0, sizes: [], types: [], writes: [], froms: [] }, sigNode: 0 - 1, boundsOut: [],
        seen: [], defQueue: [], defChecking: false, sequenceTraits: HashSet::new(), storageCopies: false, status: 0, msg: ""
    };
};

// `data N` and then an AST block of N records
fn readBlock() -> Parsed<AstProgram> ~ {
    line = readLine();
    return readBlockAfter(&line);
};

fn readBlockAfter(line: &Line) -> Parsed<AstProgram> ~ {
    bad = Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
    if !wordIs(line, 0, "data") || size(line.words) != 2 { return bad; };
    n = intAt(&line.words, 1);
    if !n.ok || n.value < 2 { return bad; };
    return readAstRecords(n.value);
};

// A block whose records are the same as an earlier one's is not read again: a request carries an interface once for
// the module and once in the defining context of each module that depends on it
struct Blocks { seen: HashMap<String, AstProgram>, block: Parsed<AstProgram>, key: String };

fn readCachedBlock(seen: HashMap<String, AstProgram>) -> Blocks ~ {
    bad = Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
    line = readLine();
    if !wordIs(&line, 0, "data") || size(line.words) != 2 { return Blocks { seen: seen, block: bad, key: "" }; };
    n = intAt(&line.words, 1);
    if !n.ok || n.value < 2 { return Blocks { seen: seen, block: bad, key: "" }; };
    lines = readRecords(n.value);
    if !lines.ok { return Blocks { seen: seen, block: bad, key: "" }; };
    keyBytes = [];
    for l in &lines.value {
        for c in &l.bytes { keyBytes = push(keyBytes, c); };
        keyBytes = push(keyBytes, toByte(10));
    };
    key = String { bytes: keyBytes };
    if HashMap::contains(&seen, &key) {
        known = HashMap::lookup(&seen, &key, AstProgram { stage: "", nodes: [], root: 0 });
        return Blocks { seen: seen, block: done(known, 0), key: key };
    };
    parsed = parseAstLines(&lines.value);
    if !parsed.ok { return Blocks { seen: seen, block: parsed, key: "" }; };
    kept = clone(parsed.value);
    return Blocks { seen: seen.insert(clone(key), kept), block: parsed, key: key };
};

// The interface's records joined to the program's, so that what refers to them, a trait's functions or a template's body,
// is in the one arena: st.n is where they start
fn appendInterface(st: St, iface: &AstProgram) -> St ~ {
    base = size(st.nodes);
    shift = [];
    for i in 0..size(iface.nodes) { shift = push(shift, base + i); };
    all = st.nodes;
    for node in &iface.nodes { all = push(all, remapNode(clone(node), &shift)); };
    return St { nodes: all, n: base, ..st };
};

// What an interface whose records start at base gives the checker (Interface.interfaceImportEnv, merged so that the first
// interface wins a name)
fn loadInterface(st: St, iface: &AstProgram, base: Int, collectBindings: Bool) -> St ~ {
    root = nodeIn(&iface.nodes, iface.root);
    if st.wireVersion {
        st = wireLoad(st, iface, &root, collectBindings);
        if st.status != 0 { return st; };
        if !(root is AstNode::OwnershipInterface) { return notModelled(st, "version 2 requires checked interface ownership transport"); };
        root = nodeIn(&iface.nodes, (root as AstNode::OwnershipInterface).base);
    } else {
        if root is AstNode::OwnershipInterface { return notModelled(st, "version 1 cannot consume checked ownership transport"); };
    };
    if !(root is AstNode::Interface) { return notModelled(st, "an interface the data does not give"); };
    v = (root as AstNode::Interface).value;
    nodes = &iface.nodes;
    // (the library's Sequence and Growable, by the module that declares them, not by their names)
    moduNode = nodeIn(nodes, v.modu);
    preludeModule = false;
    if nameText(nodes, v.pkg) = "tersuslib" && moduNode is AstNode::OptName && (moduNode as AstNode::OptName).value is AstOptName::SomeName {
        preludeModule = nameText(nodes, ((moduNode as AstNode::OptName).value as AstOptName::SomeName).n) = "prelude";
    };
    for e in listItems(nodes, v.types) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::NamesEntry {
            ne = entry as AstEntry::NamesEntry;
            name = nameText(nodes, ne.n);
            if !HashMap::contains(&st.types, &name) { st = St { types: st.types.insert(name, namesText(nodes, ne.ns)), ..st }; };
        };
    };
    for e in listItems(nodes, v.ctors) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::CtorEntry {
            ce = entry as AstEntry::CtorEntry;
            name = nameText(nodes, ce.n);
            // (a generic constructor's owner is a compiler-only physical view, which a library module sees as a type)
            if name = nameText(nodes, ce.owner) { st = St { ownerViews: push(st.ownerViews, clone(name)), ..st }; };
            if !HashMap::contains(&st.ctors, &name) {
                tycs = fieldCodecTypes(nodes, ce.fs); st = fromCodecs(st, &tycs);
                fieldTypes = clone(st.te.types);
                st = St { ctors: st.ctors.insert(name, CtorInfo { owner: nameText(nodes, ce.owner), names: fieldNames(nodes, ce.fs), types: fieldTypes }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.generics) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::GenericEntry {
            ge = entry as AstEntry::GenericEntry;
            name = nameText(nodes, ge.n);
            if !HashMap::contains(&st.generics, &name) {
                tycs = fieldCodecTypes(nodes, ge.fs); st = fromCodecs(st, &tycs);
                fieldTypes = clone(st.te.types);
                st = St { generics: st.generics.insert(name, Generic { params: namesText(nodes, ge.ps), names: fieldNames(nodes, ge.fs), types: fieldTypes }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.traits) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::TraitEntry {
            te = entry as AstEntry::TraitEntry;
            name = nameText(nodes, te.n);
            if !HashMap::contains(&st.traitFns, &name) {
                fns = [];
                for f in listItems(nodes, te.fs) { fns = push(fns, base + f); };
                st = St { traits: st.traits.insert(clone(name)), traitFns: st.traitFns.insert(clone(name), fns), ..st };
                if preludeModule && (name = "Sequence" || name = "Growable") { st = St { sequenceTraits: st.sequenceTraits.insert(clone(name)), ..st }; };
            };
            // (each interface's own trait gives its reference results, the first of a name winning)
            for f in listItems(nodes, te.fs) {
                fnode = nodeIn(nodes, f);
                if fnode is AstNode::TraitFn {
                    tf = (fnode as AstNode::TraitFn).value;
                    sig = signatureOf(nodes, tf.sig);
                    params = namesText(nodes, tf.ps);
                    ptycs = codecTypesAt(nodes, sig.ts);
                    isRef = [];
                    for c in &ptycs { isRef = push(isRef, isRefCodec(c)); };
                    named = namesText(nodes, sig.fs);
                    froms = traitResultFrom(&named, &params, &isRef);
                    key = catStrings(catStrings(clone(name), "::"), nameText(nodes, tf.n));
                    retc = codecTypeAt(nodes, sig.ret);
                    if size(froms) > 0 && isRefCodec(&retc) && refResultIndex(st, &key) < 0 { st = putRefResult(st, key, params, froms); };
                };
            };
        };
    };
    for e in listItems(nodes, v.traitParams) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::NamesEntry {
            ne = entry as AstEntry::NamesEntry;
            name = nameText(nodes, ne.n);
            if !HashMap::contains(&st.traitParams, &name) { st = St { traitParams: st.traitParams.insert(name, namesText(nodes, ne.ns)), ..st }; };
        };
    };
    for e in listItems(nodes, v.assoc) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::AssocEntry {
            ae = entry as AstEntry::AssocEntry;
            key = catStrings(catStrings(nameText(nodes, ae.a), " "), nameText(nodes, ae.b));
            origins = HashMap::lookup(&st.assoc, &key, []);
            for o in listItems(nodes, ae.origins) {
                onode = nodeIn(nodes, o);
                origin = "";
                if onode is AstNode::OptName && (onode as AstNode::OptName).value is AstOptName::SomeName {
                    origin = nameText(nodes, ((onode as AstNode::OptName).value as AstOptName::SomeName).n);
                };
                origins = push(origins, origin);
            };
            st = St { assoc: st.assoc.insert(key, origins), ..st };
        };
    };
    for e in listItems(nodes, v.implArgs) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::ImplArgsEntry {
            ia = entry as AstEntry::ImplArgsEntry;
            key = catStrings(catStrings(nameText(nodes, ia.a), " "), nameText(nodes, ia.b));
            if !HashMap::contains(&st.implArgs, &key) {
                tyc = codecTypeAt(nodes, ia.ty);
                st = fromCodec(st, &tyc);
                selfTy = st.ty;
                st = argListOf(st, base + ia.args);
                argTypes = clone(st.te.types);
                st = St { implArgs: st.implArgs.insert(key, ImplArgs { ty: selfTy, args: argTypes, tyNode: base + ia.ty, argsNode: base + ia.args }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.implBounds) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::ImplBoundsEntry {
            ib = entry as AstEntry::ImplBoundsEntry;
            key = catStrings(catStrings(nameText(nodes, ib.a), " "), nameText(nodes, ib.b));
            if !HashMap::contains(&st.implBounds, &key) {
                st = boundsOf(st, base + ib.bs);
                bounds = clone(st.boundsOut);
                st = St { implBounds: st.implBounds.insert(clone(key), bounds), implBoundsNodes: st.implBoundsNodes.insert(key, base + ib.bs), ..st };
            };
        };
    };
    for e in listItems(nodes, v.functions) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::FunctionEntry {
            fe = entry as AstEntry::FunctionEntry;
            name = nameText(nodes, fe.n);
            if !HashMap::contains(&st.fns, &name) {
                sd = sigData(nodes, fe.sig); st = functionTypeFrom(st, &sd);
                st = St { fns: st.fns.insert(clone(name), st.ty), ..st };
            };
            froms = namesText(nodes, signatureOf(nodes, fe.sig).fs);
            if size(froms) > 0 && refResultIndex(st, &name) < 0 { st = putRefResult(st, clone(name), namesText(nodes, fe.ps), froms); };
        };
    };
    for e in listItems(nodes, v.impls) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::PairEntry {
            pe = entry as AstEntry::PairEntry;
            st = St { impls: st.impls.insert(catStrings(catStrings(nameText(nodes, pe.a), " "), nameText(nodes, pe.b))), ..st };
        };
    };
    for n in namesText(nodes, v.linear) { st = St { linearTypes: st.linearTypes.insert(clone(n)), ..st }; };
    for n in namesText(nodes, v.drops) { st = St { drops: st.drops.insert(clone(n)), ..st }; };
    for e in listItems(nodes, v.templates) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::TemplateEntry {
            tme = entry as AstEntry::TemplateEntry;
            name = nameText(nodes, tme.n);
            if !HashMap::contains(&st.templates, &name) {
                // (a call of an imported function with bounds is checked against its signature and bounds alone, so what
                // else an interface written by an older elaborator carries is not read)
                st = boundsOf(st, base + tme.bs);
                bounds = clone(st.boundsOut);
                st = fnSigOf(st, base + tme.ps, base + tme.sig);
                fs = clone(st.fnSig);
                tm = Template { bounds: bounds, params: clone(fs.params), ptys: clone(fs.ptys), rty: fs.rty, sizes: clone(fs.sizes), types: clone(fs.types), from: clone(fs.froms), ins: 0 - 1, outs: 0 - 1, term: 0 - 1, body: 0 - 1, boundsNode: base + tme.bs, paramsNode: base + tme.ps, sigNode: base + tme.sig, retNode: base + tme.ret };
                if size(tm.from) > 0 { st = putRefResult(st, clone(name), clone(tm.params), clone(tm.from)); };
                st = St { templates: st.templates.insert(name, tm), ..st };
            };
        };
    };
    return st;
};

// What a module the module does not import declares under canonical names (its types, traits and impls), which the
// signature and bounds of a function with bounds it calls may name: a call of one is checked against them, and nothing
// is made visible by a name the module can write (its functions and associated functions are not taken; its canonical
// templates are, only under version 2)
fn contextFacts(st: St, iface: &AstProgram, base: Int) -> St ~ {
    types = st.types;
    wireProtocols = clone(st.wireProtocols);
    ctors = st.ctors;
    generics = st.generics;
    linearTypes = st.linearTypes;
    drops = st.drops;
    traits = st.traits;
    traitFns = st.traitFns;
    traitParams = st.traitParams;
    assoc = st.assoc;
    impls = st.impls;
    implArgs = st.implArgs;
    implBounds = st.implBounds;
    implBoundsNodes = st.implBoundsNodes;
    templates = st.templates;
    fns = st.fns;
    refResultNames = st.refResultNames;
    refResultParams = st.refResultParams;
    refResultFroms = st.refResultFroms;
    ownerViews = st.ownerViews;
    sequenceTraits = st.sequenceTraits;
    st = St { types: HashMap::new(), ctors: HashMap::new(), generics: HashMap::new(), linearTypes: HashSet::new(), drops: HashSet::new(), traits: HashSet::new(), traitFns: HashMap::new(), traitParams: HashMap::new(), assoc: HashMap::new(), impls: HashSet::new(), implArgs: HashMap::new(), implBounds: HashMap::new(), implBoundsNodes: HashMap::new(), templates: HashMap::new(), fns: HashMap::new(), refResultNames: [], refResultParams: [], refResultFroms: [], ownerViews: [], ..st };
    // (its types are read with its own checked role providers)
    if st.wireVersion { st = wireOwnerBindings(st, iface); if st.status != 0 { return st; }; };
    st = loadInterface(st, iface, base, false);
    if st.wireVersion { for e in HashMap::entries(&st.templates) { if canonicalName(&e.key) && !HashMap::contains(&templates, &e.key) { templates = templates.insert(clone(e.key), clone(e.value)); }; }; };
    for e in HashMap::entries(&st.types) { if canonicalName(&e.key) && !HashMap::contains(&types, &e.key) { types = types.insert(clone(e.key), clone(e.value)); }; };
    for e in HashMap::entries(&st.ctors) { if canonicalName(&e.key) && !HashMap::contains(&ctors, &e.key) { ctors = ctors.insert(clone(e.key), clone(e.value)); }; };
    for e in HashMap::entries(&st.generics) { if canonicalName(&e.key) && !HashMap::contains(&generics, &e.key) { generics = generics.insert(clone(e.key), clone(e.value)); }; };
    for bucket in &st.linearTypes.map.buckets { for e in bucket { if canonicalName(&e.key) { linearTypes = linearTypes.insert(clone(e.key)); }; }; };
    for bucket in &st.drops.map.buckets { for e in bucket { if canonicalName(&e.key) { drops = drops.insert(clone(e.key)); }; }; };
    for bucket in &st.traits.map.buckets { for e in bucket { if canonicalName(&e.key) { traits = traits.insert(clone(e.key)); }; }; };
    for e in HashMap::entries(&st.traitFns) { if canonicalName(&e.key) && !HashMap::contains(&traitFns, &e.key) { traitFns = traitFns.insert(clone(e.key), clone(e.value)); }; };
    for e in HashMap::entries(&st.traitParams) { if canonicalName(&e.key) && !HashMap::contains(&traitParams, &e.key) { traitParams = traitParams.insert(clone(e.key), clone(e.value)); }; };
    for bucket in &st.impls.map.buckets { for e in bucket { if canonicalName(&e.key) { impls = impls.insert(clone(e.key)); }; }; };
    for e in HashMap::entries(&st.implArgs) { if canonicalName(&e.key) && !HashMap::contains(&implArgs, &e.key) { implArgs = implArgs.insert(clone(e.key), clone(e.value)); }; };
    for e in HashMap::entries(&st.implBounds) { if canonicalName(&e.key) && !HashMap::contains(&implBounds, &e.key) { implBounds = implBounds.insert(clone(e.key), clone(e.value)); }; };
    for e in HashMap::entries(&st.implBoundsNodes) { if canonicalName(&e.key) && !HashMap::contains(&implBoundsNodes, &e.key) { implBoundsNodes = implBoundsNodes.insert(clone(e.key), e.value); }; };
    return St { wireProtocols: wireProtocols, types: types, ctors: ctors, generics: generics, linearTypes: linearTypes, drops: drops, traits: traits, traitFns: traitFns, traitParams: traitParams, assoc: assoc, impls: impls, implArgs: implArgs, implBounds: implBounds, implBoundsNodes: implBoundsNodes, templates: templates, fns: fns, refResultNames: refResultNames, refResultParams: refResultParams, refResultFroms: refResultFroms, ownerViews: ownerViews, sequenceTraits: sequenceTraits, ..st };
};

fn canonicalName(name: &String) -> Bool ~ {
    for b in &name.bytes { if b = toByte(36) { return true; }; };
    return false;
};

fn isRefCodec(t: &Type) -> Bool ~ { return t is Type::TRef || t is Type::TMutRef; };

// The signatures of the functions defined at the top, known before any body is checked (gatheredSignatures)
fn gatherSignatures(st: St, stmts: &List<Int>) -> St ~ {
    gathered = HashMap::new();
    for s in stmts {
        stmt = stmtOf(st, s);
        if stmt is AstStatement::Assign {
            a = stmt as AstStatement::Assign;
            v = functionValue(st, a.e);
            name = nameText(&st.nodes, a.n);
            if v >= 0 && !HashMap::contains(&st.stdNames, &name) && !HashMap::contains(&st.ghostNames, &name) {
                value = nativeFn(&st.nodes, v);
                sd = sigData(&st.nodes, value.sig); st = functionTypeFrom(st, &sd);
                gathered = gathered.insert(name, st.ty);
            };
        };
    };
    fns = st.fns;
    for e in gathered.entries() { fns = fns.insert(clone(e.key), e.value); };
    return St { fns: fns, ..st };
};

fn noBases() -> HashMap<String, Int> ~ { return HashMap::new(); };

fn unresolvedState(st: St, msg: String) -> St ~ {
    if st.status != 0 { return st; };
    return St { status: 4, msg: msg, ..st };
};

fn libraryProgram(libs: &List<Lib>, name: &String, seen: &HashMap<String, AstProgram>) -> Parsed<AstProgram> ~ {
    bad = Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
    i = libIndex(libs, name);
    if i < 0 || i >= size(libs) { return bad; };
    lib = get(libs, i);
    if HashMap::contains(seen, &lib.key) { return done(HashMap::lookup(seen, &lib.key, AstProgram { stage: "", nodes: [], root: 0 }), 0); };
    parsed = parseAstLines(&lib.lines);
    if !parsed.ok || parsed.value.stage != "interface" { return bad; };
    return parsed;
};

fn libraryKey(libs: &List<Lib>, name: &String) -> String ~ {
    i = libIndex(libs, name);
    if i < 0 || i >= size(libs) { return ""; };
    return clone(get(libs, i).key);
};

struct Program { nodes: List<AstNode>, roots: List<Int> };

fn preparedProgram(program: Program, raw: List<Int>, pkg: &Pkg, key: &String) -> Prepared ~ {
    if !pkg.present { return Prepared { nodes: program.nodes, stmts: raw, ok: true, msg: "" }; };
    return prepareModule(program.nodes, pkg, key, &program.roots);
};

fn joinBlock(p: Program, block: &AstProgram) -> Program ~ {
    base = size(p.nodes);
    shift = [];
    for i in 0..size(block.nodes) { shift = push(shift, base + i); };
    all = p.nodes;
    for node in &block.nodes { all = push(all, remapNode(clone(node), &shift)); };
    return Program { nodes: all, roots: push(p.roots, base + block.root) };
};

struct Sections { ok: Bool, given: Bool, catalog: Catalog, pkg: Pkg, program: Program };

fn readSections() -> Sections ~ {
    bad = Sections { ok: false, given: false, catalog: Catalog { ok: false, libs: [] }, pkg: noPackage(), program: Program { nodes: [], roots: [] } };
    next = readLine();
    catalog = Catalog { ok: true, libs: [] };
    given = wordIs(&next, 0, "libraries");
    if given {
        catalog = readCatalog(&next);
        if !catalog.ok { return bad; };
        next = readLine();
    };
    block = readBlockAfter(&next);
    if !block.ok || block.value.stage != "parsed" { return bad; };
    end = readRecord();
    if !end.ok || end.pos != 0 { return bad; };
    return Sections { ok: true, given: given, catalog: catalog, pkg: noPackage(), program: joinBlock(Program { nodes: [], roots: [] }, &block.value) };
};

fn givenState(g: Given) -> St ~ { return g.st; };

fn statementsOf(program: &Program) -> List<Int> ~ {
    out = [];
    for r in &program.roots { for s in listItems(&program.nodes, r) { out = push(out, s); }; };
    return out;
};

// status 1: the request does not give a library whole
struct Given { st: St, bases: HashMap<String, Int>, status: Int };

fn giveLibraries(st: St, catalog: &Catalog, selected: &List<String>, stmts: &List<Int>, seen: &HashMap<String, AstProgram>, inPackage: Bool, key: &String) -> Given ~ {
    if st.status != 0 { return Given { st: st, bases: noBases(), status: 0 }; };
    replaced = ownEq(&st.nodes, stmts) >= 0;
    names = [];
    for w in seenLibraries(&catalog.libs, selected) { if !replaced || w != "eq" { names = push(names, clone(w)); }; };
    views = [];
    for w in &names {
        lib = libraryProgram(&catalog.libs, w, seen);
        if !lib.ok { return Given { st: st, bases: noBases(), status: 1 }; };
        views = push(views, lib.value);
    };
    if replaced && !eqKept(&st.nodes, stmts, &views, &catalog.libs, seen) {
        message = "Type error: a replacement Eq used with cached library implementations must have exactly the library Eq's parameters, method signatures and contracts";
        if inPackage { message = catStrings(catStrings(catStrings("in module ", key), ": "), message); };
        return Given { st: unresolvedState(st, message), bases: noBases(), status: 0 };
    };
    hide = ownDeclarations(&st.nodes, stmts, inPackage);
    loaded = loadViews(st, &views, &names, &catalog.libs, &hide);
    if !inPackage || !needsDropTrait(&loaded.st.nodes, stmts) || indexIn(selected, "prelude") >= 0 || libIndex(&catalog.libs, "prelude") < 0 { return loaded; };
    prelude = libraryProgram(&catalog.libs, "prelude", seen);
    if !prelude.ok { return Given { status: 1, ..loaded }; };
    dropHide = Hide { declared: HashSet::new(), own: [], dropOnly: true };
    dropOnly = viewOf(&prelude.value, &dropHide);
    st = appendInterface(loaded.st, &dropOnly.program);
    base = st.n;
    st = loadInterface(st, &dropOnly.program, base, true);
    return Given { st: st, bases: loaded.bases, status: 0 };
};

fn eqKept(nodes: &List<AstNode>, stmts: &List<Int>, views: &List<AstProgram>, libs: &List<Lib>, seen: &HashMap<String, AstProgram>) -> Bool ~ {
    retains = false;
    for v in views { retains = retains || implsEq(v); };
    if !retains { return true; };
    eq = libraryProgram(libs, "eq", seen);
    return eq.ok && sameEq(nodes, ownEq(nodes, stmts), &eq.value);
};

fn ownDeclarations(nodes: &List<AstNode>, stmts: &List<Int>, inPackage: Bool) -> Hide ~ {
    own = [];
    if inPackage { own = topTypeNames(nodes, stmts); } else { own = declaredNames(nodes, stmts); };
    for d in definedFunctions(nodes, stmts) { own = push(own, clone(d)); };
    ownSet = HashSet::new();
    for o in &own { ownSet = ownSet.insert(clone(o)); };
    return Hide { declared: ownSet, own: own, dropOnly: false };
};

// (a library interface the module sees whole is read where a defining context that carries it again reads it; one it
// sees without some of its names is another interface)
fn loadViews(st: St, views: &List<AstProgram>, names: &List<String>, libs: &List<Lib>, hide: &Hide) -> Given ~ {
    bases = noBases();
    k = 0;
    while k < size(views) && k < size(names) [{ affirm k >= 0; }] shrinks size(views) - k {
        lib = get(views, k);
        view = viewOf(&lib, hide);
        if view.changed {
            st = appendInterface(st, &view.program);
            base = st.n;
            st = loadInterface(st, &view.program, base, true);
        } else {
            libKey = libraryKey(libs, &get(names, k));
            if !HashMap::contains(&bases, &libKey) {
                st = appendInterface(st, &lib);
                bases = bases.insert(clone(libKey), st.n);
            };
            st = loadInterface(st, &lib, HashMap::lookup(&bases, &libKey, 0), true);
        };
        k = k + 1;
    };
    return Given { st: st, bases: bases, status: 0 };
};

fn printIntWord(n: Int) -> Int ~ { return " ".print() + intText(n).print(); };

fn printQuoted(text: &String) -> Int ~ { return quotedName(text).print(); };

fn malformed() -> Int ~ {
    "not an elaboration request\n".printError();
    return 1;
};

// One module's elaboration (ElaborateRequest.Request): read from a module request, or made by a load (elaborate::units)
struct Unit {
    pkgName: String, modu: String, hasModule: Bool, predeclaring: Bool, viewing: Bool, extracting: Bool, libExtract: Bool,
    ifaces: List<AstProgram>, ifaceKeys: List<String>, definitions: List<List<AstProgram>>, definitionKeys: List<List<String>>,
    hasCatalog: Bool, catalog: Catalog, pkg: Pkg, program: Program,
    wireVersion: Bool, wireProtocols: HashMap<String, List<String>>
};

// What a request of version 2 says it is: its explicit protocol providers (AST_DATA.md, "Ownership transport")
struct Wire { version: Bool, protocols: HashMap<String, List<String>> };

fn noWire() -> Wire ~ { return Wire { version: false, protocols: HashMap::new() }; };

struct Protocols { ok: Bool, wire: Wire };

// The `protocols` section of a version 2 request: each role once and in order, each with its providers in order
fn readProtocols() -> Protocols ~ {
    bad = Protocols { ok: false, wire: noWire() };
    protocols = readLine();
    count = countAt(&protocols, 1);
    if size(protocols.words) != 2 || !wordIs(&protocols, 0, "protocols") || count < 0 { return bad; };
    roles = noWire().protocols;
    previous = "";
    for i in 0..count {
        line = readLine();
        n = countAt(&line, 2);
        if size(line.words) < 3 || !wordIs(&line, 0, "protocol") || !get(line.words, 1).quoted || n < 1 || size(line.words) != n + 3 { return bad; };
        role = clone(get(line.words, 1).text);
        if indexIn(wireRoles(), &role) < 0 || roles.contains(&role) || (size(previous.bytes) > 0 && !before(&previous, &role)) { return bad; };
        previous = clone(role);
        providers = [];
        priorProvider = "";
        for j in 0..n {
            item = get(line.words, 3 + j);
            if !item.quoted || size(item.text.bytes) = 0 || (size(priorProvider.bytes) > 0 && !before(&priorProvider, &item.text)) { return bad; };
            priorProvider = clone(item.text);
            providers = push(providers, clone(item.text));
        };
        roles = roles.insert(role, providers);
    };
    return Protocols { ok: true, wire: Wire { version: true, protocols: roles } };
};

// status: St.status, or -1 when the request does not give a library it names
struct Answer { status: Int, msg: String, out: AstProgram, iface: AstProgram, extracting: Bool, selected: List<String> };

fn unitAnswer(st: &St, out: AstProgram, iface: AstProgram, extracting: Bool, selected: List<String>) -> Answer ~ {
    return Answer { status: st.status, msg: clone(st.msg), out: out, iface: iface, extracting: extracting, selected: selected };
};

fn noProgram(stage: String) -> AstProgram ~ { return AstProgram { stage: stage, nodes: [], root: 0 }; };

fn malformedAnswer() -> Answer ~ {
    return Answer { status: 0 - 1, msg: "", out: noProgram("elaborated"), iface: noProgram("interface"), extracting: false, selected: [] };
};

fn elaborateUnit(table: &AstProgram, unit: Unit, seenBlocks: &HashMap<String, AstProgram>) -> Answer ~ {
    st = newState();
    modKey = moduleKey(&unit.pkgName, &unit.modu, unit.hasModule);
    program = unit.program;
    catalog = unit.catalog;
    pkg = unit.pkg;
    ifaces = unit.ifaces;
    ifaceKeys = unit.ifaceKeys;
    givenDefinitions = unit.definitions;
    givenDefinitionKeys = unit.definitionKeys;
    raw = statementsOf(&program);
    probe = Probe { declared: [], mentioned: HashSet::new(), literal: false };
    if unit.hasCatalog { probe = probeModule(&program.nodes, &raw, &ifaces); };
    prepared = preparedProgram(program, raw, &pkg, &modKey);
    stmts = prepared.stmts;
    st = St { nodes: prepared.nodes, wireVersion: unit.wireVersion, wireProtocols: clone(unit.wireProtocols), storageCopies: unit.pkgName = "tersuslib" && unit.hasModule && (unit.modu = "lists" || unit.modu = "box"), ..st };
    if unit.hasModule && unit.pkgName = "tersuslib" && unit.modu = "prelude" { st = St { sequenceTraits: st.sequenceTraits.insert("Sequence").insert("Growable"), ..st }; };
    if !prepared.ok { st = unresolvedState(st, prepared.msg); };
    st = loadBuiltins(st, table);
    selected = [];
    if unit.hasCatalog && st.status = 0 { selected = librariesFor(&probe); };
    given = giveLibraries(st, &catalog, &selected, &stmts, seenBlocks, pkg.present, &modKey);
    if given.status = 1 { return malformedAnswer(); };
    bases = clone(given.bases);
    st = givenState(given);
    k = 0;
    while k < size(ifaces) && k < size(ifaceKeys) [{ affirm k >= 0; }] shrinks size(ifaces) - k {
        st = appendInterface(st, &get(ifaces, k));
        bases = bases.insert(clone(get(ifaceKeys, k)), st.n);
        st = loadInterface(st, &get(ifaces, k), st.n, true);
        k = k + 1;
    };
    // (the interfaces of the modules that define the functions with bounds the module calls: a call is checked against a
    // function's signature and bounds, which may name their canonical types, traits and impls; contextFacts)
    k = 0;
    while k < size(givenDefinitions) && k < size(givenDefinitionKeys) [{ affirm k >= 0; }] shrinks size(givenDefinitions) - k {
        context = clone(get(givenDefinitions, k));
        keys = clone(get(givenDefinitionKeys, k));
        j = 0;
        while j < size(context) && j < size(keys) [{ affirm j >= 0; }] shrinks size(context) - j {
            key = clone(get(keys, j));
            if !HashMap::contains(&bases, &key) {
                st = appendInterface(st, &get(context, j));
                bases = bases.insert(clone(key), st.n);
                st = contextFacts(st, &get(context, j), st.n);
            };
            j = j + 1;
        };
        k = k + 1;
    };
    if unit.viewing {
        for o in clone(st.ownerViews) {
            if !HashMap::contains(&st.types, &o) { st = St { types: st.types.insert(clone(o), push([], clone(o))), ..st }; };
        };
    };
    if st.status = 0 {
        if st.wireVersion {
            st = wireBindDeclarations(st, &stmts);
            st = wireStorageDeclarations(st, &stmts);
            st = wireValidateBindings(st);
        };
        st = gatherSignatures(st, &stmts);
        if unit.predeclaring {
            st = predeclareOwn(st, &stmts);
            st = checkOwnFinite(st, &stmts);
        };
        if st.status = 0 { st = checkStatements(st, true, &stmts); };
    };
    out = noProgram("elaborated");
    iface = noProgram("interface");
    if st.status = 0 {
        statementsNode = st.te.node;
        types = clone(st.te.types);
        st = checkDefinitions(st);
        // (the checked ownership facts select their callees through templateReference, so emitInstances names them too)
        if st.status = 0 && st.wireVersion { st = wireBindDeclarations(st, &stmts); st = wireComplete(st); };
        // (the program is the Instance records of the copies it names and the functions bounds give, its statements, and
        // the checked bodies of its functions with bounds, whose expression types follow its own)
        st = emitInstances(st);
        all = clone(st.outs);
        for item in listItems(&st.nodes, statementsNode) { all = push(all, item); };
        for g in &st.genericOut { all = push(all, g); };
        for t in &st.genericTypes { types = push(types, t); };
        st = emitStatements(st, &all);
        programNode = st.nid;
        st = emitTypes(st, &types);
        if st.status = 0 {
            typeNode = st.nid;
            if st.wireVersion {
                roles = clone(st.wireProtocols);
                st = wireEntries(st, &roles);
                protocolNode = st.nid;
                facts = clone(st.wireOwnership);
                st = wireEntries(st, &facts);
                st = emit(st, AstNode::OwnershipElaborated { statements: programNode, types: typeNode, protocols: protocolNode, ownership: st.nid });
            } else {
                st = emit(st, AstNode::Elaborated { value: AstElaborated { statements: programNode, types: typeNode } });
            };
            out = reorderArena(&st.nodes, st.nid, "elaborated");
            if unit.extracting {
                elaborated = listItems(&st.nodes, statementsNode);
                st = extractInterface(st, unit.libExtract, clone(unit.pkgName), clone(unit.modu), unit.hasModule, &stmts, &elaborated);
                if st.status = 0 && st.wireVersion { st = wireWrapInterface(st, st.nid); };
                if st.status = 0 { iface = reorderArena(&st.nodes, st.nid, "interface"); };
            };
        };
    };
    return unitAnswer(&st, out, iface, unit.extracting, selected);
};

fn printAnswer(a: &Answer) -> Int ~ {
    n = "tersus-elaborated 1\n".print();
    return n + printAnswerBody(a);
};

fn printAnswerBody(a: &Answer) -> Int ~ {
    n = 0;
    if a.status = 0 {
        n = n + "accepted\ndata".print() + printIntWord(size(a.out.nodes) + 2) + "\n".print();
        n = n + printAst(&a.out);
        if !a.extracting { n = n + "interface none\n".print(); } else {
            n = n + "interface\ndata".print() + printIntWord(size(a.iface.nodes) + 2) + "\n".print();
            n = n + printAst(&a.iface);
        };
        if size(a.selected) = 0 { return n; };
        n = n + "libraries".print() + printIntWord(size(a.selected));
        for l in &a.selected { n = n + " ".print() + printQuoted(l); };
        return n + "\n".print();
    };
    if a.status = 2 { return n + "unmodelled ".print() + printQuoted(&a.msg) + "\n".print(); };
    if a.status = 3 { return n + "interfaceRefused ".print() + printQuoted(&a.msg) + "\n".print(); };
    if a.status = 4 { return n + "unresolved ".print() + printQuoted(&a.msg) + "\n".print(); };
    return n + "refused ".print() + printQuoted(&a.msg) + "\n".print();
};

// A module request (AST_DATA.md, "Elaboration requests"), after its header and module lines
fn answerModule(moduleLine: &Line, version2: Bool) -> Int ~ {
    predeclare = readLine();
    library = readLine();
    extract = readLine();
    if !wordIs(moduleLine, 0, "module") || size(moduleLine.words) != 3 || !get(moduleLine.words, 1).quoted || size(predeclare.words) != 2 || size(library.words) != 2 || size(extract.words) != 2 || !wordIs(&predeclare, 0, "predeclare") || !wordIs(&library, 0, "library") || !wordIs(&extract, 0, "extract") { return malformed(); };
    hasModule = get(moduleLine.words, 2).quoted;
    if !hasModule && !wordIs(moduleLine, 2, "none") { return malformed(); };
    wire = noWire();
    if version2 {
        read = readProtocols();
        if !read.ok { return malformed(); };
        wire = read.wire;
    };
    builtinsLine = readLine();
    if !wordIs(&builtinsLine, 0, "builtins") || size(builtinsLine.words) != 1 { return malformed(); };
    table = readBlock();
    if !table.ok { return malformed(); };
    countLine = readLine();
    if !wordIs(&countLine, 0, "interfaces") || size(countLine.words) != 2 { return malformed(); };
    count = intAt(&countLine.words, 1);
    if !count.ok || count.value < 0 { return malformed(); };
    ifaces = [];
    ifaceKeys = [];
    seenBlocks = HashMap::new();
    for i in 0..count.value {
        read = readCachedBlock(seenBlocks);
        seenBlocks = read.seen;
        b = read.block;
        if !b.ok || b.value.stage != "interface" { return malformed(); };
        ifaces = push(ifaces, b.value);
        ifaceKeys = push(ifaceKeys, read.key);
    };
    definitionsLine = readLine();
    if !wordIs(&definitionsLine, 0, "definitions") || size(definitionsLine.words) != 2 { return malformed(); };
    definitionCount = intAt(&definitionsLine.words, 1);
    if !definitionCount.ok || definitionCount.value < 0 { return malformed(); };
    definitions = [];
    definitionKeys = [];
    for i in 0..definitionCount.value {
        contextLine = readLine();
        if !wordIs(&contextLine, 0, "definition") || size(contextLine.words) != 2 { return malformed(); };
        contextCount = intAt(&contextLine.words, 1);
        if !contextCount.ok || contextCount.value < 1 { return malformed(); };
        context = [];
        keys = [];
        for j in 0..contextCount.value {
            read = readCachedBlock(seenBlocks);
            seenBlocks = read.seen;
            b = read.block;
            if !b.ok || b.value.stage != "interface" { return malformed(); };
            context = push(context, b.value);
            keys = push(keys, read.key);
        };
        definitions = push(definitions, context);
        definitionKeys = push(definitionKeys, keys);
    };
    pkgName = clone(get(moduleLine.words, 1).text);
    modu = "";
    if hasModule { modu = clone(get(moduleLine.words, 2).text); };
    modKey = moduleKey(&pkgName, &modu, hasModule);
    sections = readSections();
    if !sections.ok { return malformed(); };
    predeclaring = wordIs(&predeclare, 1, "true");
    viewing = wordIs(&library, 1, "true");
    extracting = !wordIs(&extract, 1, "none");
    if (!predeclaring && !wordIs(&predeclare, 1, "false")) || (!viewing && !wordIs(&library, 1, "false")) || (extracting && !wordIs(&extract, 1, "module") && !wordIs(&extract, 1, "lib")) { return malformed(); };
    unit = Unit { pkgName: pkgName, modu: modu, hasModule: hasModule, predeclaring: predeclaring, viewing: viewing, extracting: extracting, libExtract: wordIs(&extract, 1, "lib"),
        ifaces: ifaces, ifaceKeys: ifaceKeys, definitions: definitions, definitionKeys: definitionKeys,
        hasCatalog: sections.given, catalog: sections.catalog, pkg: sections.pkg, program: sections.program,
        wireVersion: wire.version, wireProtocols: wire.protocols };
    answer = elaborateUnit(&table.value, unit, &seenBlocks);
    if answer.status < 0 { return malformed(); };
    printAnswer(&answer);
    return 0;
};

header = readLine();
if size(header.words) != 2 || !wordIs(&header, 0, "tersus-elaborate") || (!wordIs(&header, 1, "1") && !wordIs(&header, 1, "2")) { return malformed(); };
version2 = wordIs(&header, 1, "2");
second = readLine();
if wordIs(&second, 0, "load") {
    if answerLoad(&second, version2) != 0 { return 1; };
} else {
    if answerModule(&second, version2) != 0 { return 1; };
};
