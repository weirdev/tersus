import data::arena::arena { remapNode, reorderArena };
import data::ast::ast { AstElaborated, AstEntry, AstNode, AstOptName, AstProgram, AstStatement, printAst };
import data::codec::codec { Parsed, Token, Type, catStrings, done, intAt, tokenize };
import data::reader::reader { parseAstLines, readAstRecords, readRecord, readRecords };
import elaborate::builtins { loadBuiltins };
import elaborate::check { checkStatements, fnSigOf, functionValue, stmtOf };
import elaborate::exports { checkOwnFinite, extractInterface, predeclareOwn };
import elaborate::out { emit, emitTypes, quotedName };
import elaborate::records { codecTypeAt, codecTypesAt, fieldCodecTypes, fieldNames, fromCodec, fromCodecs, functionTypeFrom, listItems, nameText, namesText, nativeFn, nodeIn, sigData, signatureOf };
import elaborate::refs { putRefResult, refResultIndex, traitResultFrom };
import elaborate::state { CtorInfo, Defining, FnSig, Generic, ImplArgs, St, TE, Template, intText, noBoundedParts, notModelled, oneScope };
import elaborate::traits { argListOf, boundsOf, emptyTemplate };

// The elaborator written in Tersus: a `tersus-elaborate 1` request on standard input, a `tersus-elaborated 1`
// response on standard output (AST_DATA.md). It answers `unmodelled` for what it does not handle yet.

fn newState() -> St ~ {
    return St {
        nodes: [], tys: [], subst: HashMap::new(), sizeSubst: HashMap::new(), next: 0,
        types: HashMap::new(), ctors: HashMap::new(), generics: HashMap::new(), linearTypes: HashSet::new(), drops: HashSet::new(),
        traits: HashSet::new(), traitFns: HashMap::new(), traitParams: HashMap::new(), traitSelf: [], inTrait: false, assoc: HashMap::new(), implArgs: HashMap::new(), implBounds: HashMap::new(), implBoundsNodes: HashMap::new(), ownerViews: [], logging: false, implDefined: [], ghostCache: HashMap::new(), refCache: HashMap::new(), boundedParts: noBoundedParts(), big: [], undo: [], sizeUndo: [], templates: HashMap::new(), instances: HashMap::new(), emitted: [], emittedTypes: [], activeNames: [], activeSizes: [], companions: HashMap::new(), definitions: [], fns: HashMap::new(), scopes: oneScope(),
        ret: 0 - 1, programReturn: 0 - 1, sizeScope: [], typeScope: [], readOnly: [], mutParams: [], writes: [], aliasNames: [], aliasPlaces: [], originNames: [], originRoots: [], refResultNames: [], refResultParams: [], refResultFroms: [], resultFrom: [], params: [], current: "", inGhost: false,
        predeclared: HashSet::new(), impls: HashSet::new(), builtinNames: HashMap::new(), builtinValues: [], builtinSchemes: [],
        builtinKinds: [], stdNames: HashMap::new(), pointer: HashMap::new(), ghostNames: HashMap::new(), methods: HashMap::new(),
        methodOf: HashMap::new(), ty: 0, ok: true, te: TE { node: 0 - 1, types: [] }, tes: [], outs: [], nid: 0 - 1, n: 0,
        gen: Generic { params: [], names: [], types: [] }, ctor: CtorInfo { owner: "", names: [], types: [] }, names: [],
        fnSig: FnSig { params: [], ptys: [], rty: 0, sizes: [], types: [], writes: [], froms: [] }, sigNode: 0 - 1, boundsOut: [],
        seen: [], status: 0, msg: ""
    };
};

struct Line { words: List<Token>, ok: Bool };
impl Clone for Line { };

fn readLine() -> Line ~ {
    r = readRecord();
    if !r.ok || r.pos = 0 { return Line { words: [], ok: false }; };
    t = tokenize(&r.value);
    if !t.ok { return Line { words: [], ok: false }; };
    return Line { words: t.value, ok: true };
};

fn wordIs(line: &Line, i: Int, w: &String) -> Bool ~ {
    if !line.ok || i < 0 || i >= size(line.words) { return false; };
    tok = get(line.words, i);
    return !tok.quoted && tok.text = clone(w);
};

// `data N` and then an AST block of N records
fn readBlock() -> Parsed<AstProgram> ~ {
    bad = Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
    line = readLine();
    if !wordIs(&line, 0, "data") || size(line.words) != 2 { return bad; };
    n = intAt(&line.words, 1);
    if !n.ok || n.value < 2 { return bad; };
    return readAstRecords(n.value);
};

// A block whose records are the same as an earlier one's is not read again: a request carries an interface once for
// the module and once in the defining context of each module that depends on it
struct Blocks { seen: HashMap<String, AstProgram>, block: Parsed<AstProgram>, key: String };

fn readCachedBlock(seen: HashMap<String, AstProgram>) -> Blocks ~ {
    bad = Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
    line = readLine();
    if !wordIs(&line, 0, "data") || size(line.words) != 2 { return Blocks { seen: seen, block: bad, key: "" }; };
    n = intAt(&line.words, 1);
    if !n.ok || n.value < 2 { return Blocks { seen: seen, block: bad, key: "" }; };
    lines = readRecords(n.value);
    if !lines.ok { return Blocks { seen: seen, block: bad, key: "" }; };
    keyBytes = [];
    for l in &lines.value {
        for c in &l.bytes { keyBytes = push(keyBytes, c); };
        keyBytes = push(keyBytes, toByte(10));
    };
    key = String { bytes: keyBytes };
    if HashMap::contains(&seen, &key) {
        known = HashMap::lookup(&seen, &key, AstProgram { stage: "", nodes: [], root: 0 });
        return Blocks { seen: seen, block: done(known, 0), key: key };
    };
    parsed = parseAstLines(&lines.value);
    if !parsed.ok { return Blocks { seen: seen, block: parsed, key: "" }; };
    kept = clone(parsed.value);
    return Blocks { seen: seen.insert(clone(key), kept), block: parsed, key: key };
};

// The interface's records joined to the program's, so that what refers to them, a trait's functions or a template's body,
// is in the one arena: st.n is where they start
fn appendInterface(st: St, iface: &AstProgram) -> St ~ {
    base = size(st.nodes);
    shift = [];
    for i in 0..size(iface.nodes) { shift = push(shift, base + i); };
    all = st.nodes;
    for node in &iface.nodes { all = push(all, remapNode(clone(node), &shift)); };
    return St { nodes: all, n: base, ..st };
};

// What an interface whose records start at base gives the checker (Interface.interfaceImportEnv, merged so that the first
// interface wins a name)
fn loadInterface(st: St, iface: &AstProgram, base: Int) -> St ~ {
    root = nodeIn(&iface.nodes, iface.root);
    if !(root is AstNode::Interface) { return notModelled(st, "an interface the data does not give"); };
    v = (root as AstNode::Interface).value;
    nodes = &iface.nodes;
    for e in listItems(nodes, v.types) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::NamesEntry {
            ne = entry as AstEntry::NamesEntry;
            name = nameText(nodes, ne.n);
            if !HashMap::contains(&st.types, &name) { st = St { types: st.types.insert(name, namesText(nodes, ne.ns)), ..st }; };
        };
    };
    for e in listItems(nodes, v.ctors) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::CtorEntry {
            ce = entry as AstEntry::CtorEntry;
            name = nameText(nodes, ce.n);
            // (a generic constructor's owner is a compiler-only physical view, which a library module sees as a type)
            if name = nameText(nodes, ce.owner) { st = St { ownerViews: push(st.ownerViews, clone(name)), ..st }; };
            if !HashMap::contains(&st.ctors, &name) {
                tycs = fieldCodecTypes(nodes, ce.fs); st = fromCodecs(st, &tycs);
                fieldTypes = clone(st.te.types);
                st = St { ctors: st.ctors.insert(name, CtorInfo { owner: nameText(nodes, ce.owner), names: fieldNames(nodes, ce.fs), types: fieldTypes }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.generics) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::GenericEntry {
            ge = entry as AstEntry::GenericEntry;
            name = nameText(nodes, ge.n);
            if !HashMap::contains(&st.generics, &name) {
                tycs = fieldCodecTypes(nodes, ge.fs); st = fromCodecs(st, &tycs);
                fieldTypes = clone(st.te.types);
                st = St { generics: st.generics.insert(name, Generic { params: namesText(nodes, ge.ps), names: fieldNames(nodes, ge.fs), types: fieldTypes }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.traits) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::TraitEntry {
            te = entry as AstEntry::TraitEntry;
            name = nameText(nodes, te.n);
            if !HashMap::contains(&st.traitFns, &name) {
                fns = [];
                for f in listItems(nodes, te.fs) { fns = push(fns, base + f); };
                st = St { traits: st.traits.insert(clone(name)), traitFns: st.traitFns.insert(clone(name), fns), ..st };
            };
            // (each interface's own trait gives its reference results, the first of a name winning)
            for f in listItems(nodes, te.fs) {
                fnode = nodeIn(nodes, f);
                if fnode is AstNode::TraitFn {
                    tf = (fnode as AstNode::TraitFn).value;
                    sig = signatureOf(nodes, tf.sig);
                    params = namesText(nodes, tf.ps);
                    ptycs = codecTypesAt(nodes, sig.ts);
                    isRef = [];
                    for c in &ptycs { isRef = push(isRef, isRefCodec(c)); };
                    named = namesText(nodes, sig.fs);
                    froms = traitResultFrom(&named, &params, &isRef);
                    key = catStrings(catStrings(clone(name), "::"), nameText(nodes, tf.n));
                    retc = codecTypeAt(nodes, sig.ret);
                    if size(froms) > 0 && isRefCodec(&retc) && refResultIndex(st, &key) < 0 { st = putRefResult(st, key, params, froms); };
                };
            };
        };
    };
    for e in listItems(nodes, v.traitParams) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::NamesEntry {
            ne = entry as AstEntry::NamesEntry;
            name = nameText(nodes, ne.n);
            if !HashMap::contains(&st.traitParams, &name) { st = St { traitParams: st.traitParams.insert(name, namesText(nodes, ne.ns)), ..st }; };
        };
    };
    for e in listItems(nodes, v.assoc) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::AssocEntry {
            ae = entry as AstEntry::AssocEntry;
            key = catStrings(catStrings(nameText(nodes, ae.a), " "), nameText(nodes, ae.b));
            origins = HashMap::lookup(&st.assoc, &key, []);
            for o in listItems(nodes, ae.origins) {
                onode = nodeIn(nodes, o);
                origin = "";
                if onode is AstNode::OptName && (onode as AstNode::OptName).value is AstOptName::SomeName {
                    origin = nameText(nodes, ((onode as AstNode::OptName).value as AstOptName::SomeName).n);
                };
                origins = push(origins, origin);
            };
            st = St { assoc: st.assoc.insert(key, origins), ..st };
        };
    };
    for e in listItems(nodes, v.implArgs) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::ImplArgsEntry {
            ia = entry as AstEntry::ImplArgsEntry;
            key = catStrings(catStrings(nameText(nodes, ia.a), " "), nameText(nodes, ia.b));
            if !HashMap::contains(&st.implArgs, &key) {
                tyc = codecTypeAt(nodes, ia.ty);
                st = fromCodec(st, &tyc);
                selfTy = st.ty;
                st = argListOf(st, base + ia.args);
                argTypes = clone(st.te.types);
                st = St { implArgs: st.implArgs.insert(key, ImplArgs { ty: selfTy, args: argTypes, tyNode: base + ia.ty, argsNode: base + ia.args }), ..st };
            };
        };
    };
    for e in listItems(nodes, v.implBounds) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::ImplBoundsEntry {
            ib = entry as AstEntry::ImplBoundsEntry;
            key = catStrings(catStrings(nameText(nodes, ib.a), " "), nameText(nodes, ib.b));
            if !HashMap::contains(&st.implBounds, &key) {
                st = boundsOf(st, base + ib.bs);
                bounds = clone(st.boundsOut);
                st = St { implBounds: st.implBounds.insert(clone(key), bounds), implBoundsNodes: st.implBoundsNodes.insert(key, base + ib.bs), ..st };
            };
        };
    };
    for e in listItems(nodes, v.companions) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::NamesEntry {
            ne = entry as AstEntry::NamesEntry;
            name = nameText(nodes, ne.n);
            existing = HashMap::lookup(&st.companions, &name, []);
            for c in namesText(nodes, ne.ns) { existing = push(existing, clone(c)); };
            st = St { companions: st.companions.insert(name, existing), ..st };
        };
    };
    for e in listItems(nodes, v.functions) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::FunctionEntry {
            fe = entry as AstEntry::FunctionEntry;
            name = nameText(nodes, fe.n);
            if !HashMap::contains(&st.fns, &name) {
                sd = sigData(nodes, fe.sig); st = functionTypeFrom(st, &sd);
                st = St { fns: st.fns.insert(clone(name), st.ty), ..st };
            };
            froms = namesText(nodes, signatureOf(nodes, fe.sig).fs);
            if size(froms) > 0 && refResultIndex(st, &name) < 0 { st = putRefResult(st, clone(name), namesText(nodes, fe.ps), froms); };
        };
    };
    for e in listItems(nodes, v.impls) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::PairEntry {
            pe = entry as AstEntry::PairEntry;
            st = St { impls: st.impls.insert(catStrings(catStrings(nameText(nodes, pe.a), " "), nameText(nodes, pe.b))), ..st };
        };
    };
    for n in namesText(nodes, v.linear) { st = St { linearTypes: st.linearTypes.insert(clone(n)), ..st }; };
    for n in namesText(nodes, v.drops) { st = St { drops: st.drops.insert(clone(n)), ..st }; };
    for e in listItems(nodes, v.templates) {
        entry = entryOf(nodes, e);
        if entry is AstEntry::TemplateEntry {
            tme = entry as AstEntry::TemplateEntry;
            name = nameText(nodes, tme.n);
            if !HashMap::contains(&st.templates, &name) {
                st = boundsOf(st, base + tme.bs);
                bounds = clone(st.boundsOut);
                fnNames = [];
                fnTypes = [];
                for t in listItems(nodes, tme.fns) {
                    tnode = nodeIn(nodes, t);
                    if tnode is AstNode::Entry && (tnode as AstNode::Entry).value is AstEntry::TypeEntry {
                        tye = (tnode as AstNode::Entry).value as AstEntry::TypeEntry;
                        tyc = codecTypeAt(nodes, tye.ty);
                        st = fromCodec(st, &tyc);
                        fnNames = push(fnNames, nameText(nodes, tye.n));
                        fnTypes = push(fnTypes, st.ty);
                    };
                };
                st = fnSigOf(st, base + tme.ps, base + tme.sig);
                fs = clone(st.fnSig);
                tm = Template { bounds: bounds, fnNames: fnNames, fnTypes: fnTypes, params: clone(fs.params), ptys: clone(fs.ptys), rty: fs.rty, sizes: clone(fs.sizes), types: clone(fs.types), from: clone(fs.froms), ins: base + tme.ins, outs: base + tme.outs, term: base + tme.term, body: base + tme.body, boundsNode: base + tme.bs, paramsNode: base + tme.ps, sigNode: base + tme.sig, retNode: base + tme.ret };
                st = St { templates: st.templates.insert(name, tm), ..st };
            };
        };
    };
    return st;
};

// A defining context (ElaborateRequest.rqDefinitions): its interfaces seeded into a checker of their own, kept with the
// templates its first interface owns (seededTcState); bases says where each interface's records start
fn definingContext(st: St, context: &List<AstProgram>, bases: &List<Int>) -> St ~ {
    if size(context) = 0 || size(context) != size(bases) { return notModelled(st, "an empty template defining context"); };
    types = st.types;
    ctors = st.ctors;
    generics = st.generics;
    linearTypes = st.linearTypes;
    drops = st.drops;
    traits = st.traits;
    traitFns = st.traitFns;
    traitParams = st.traitParams;
    assoc = st.assoc;
    impls = st.impls;
    implArgs = st.implArgs;
    implBounds = st.implBounds;
    implBoundsNodes = st.implBoundsNodes;
    templates = st.templates;
    companions = st.companions;
    fns = st.fns;
    refResultNames = st.refResultNames;
    refResultParams = st.refResultParams;
    refResultFroms = st.refResultFroms;
    ownerViews = st.ownerViews;
    st = St { types: HashMap::new(), ctors: HashMap::new(), generics: HashMap::new(), linearTypes: HashSet::new(), drops: HashSet::new(), traits: HashSet::new(), traitFns: HashMap::new(), traitParams: HashMap::new(), assoc: HashMap::new(), impls: HashSet::new(), implArgs: HashMap::new(), implBounds: HashMap::new(), implBoundsNodes: HashMap::new(), templates: HashMap::new(), companions: HashMap::new(), fns: HashMap::new(), refResultNames: [], refResultParams: [], refResultFroms: [], ownerViews: [], ..st };
    i = 0;
    while i < size(context) && i < size(bases) [{ affirm i >= 0; }] shrinks size(context) - i {
        st = loadInterface(st, &get(context, i), get(bases, i));
        i = i + 1;
    };
    owner = get(context, 0);
    owned = HashMap::new();
    root = nodeIn(&owner.nodes, owner.root);
    if root is AstNode::Interface {
        for e in listItems(&owner.nodes, (root as AstNode::Interface).value.templates) {
            entry = entryOf(&owner.nodes, e);
            if entry is AstEntry::TemplateEntry {
                name = nameText(&owner.nodes, (entry as AstEntry::TemplateEntry).n);
                if HashMap::contains(&st.templates, &name) { owned = owned.insert(clone(name), HashMap::lookup(&st.templates, &name, emptyTemplate())); };
            };
        };
    };
    d = Defining { owned: owned, types: clone(st.types), ctors: clone(st.ctors), generics: clone(st.generics), linearTypes: clone(st.linearTypes), drops: clone(st.drops), traits: clone(st.traits), traitFns: clone(st.traitFns), traitParams: clone(st.traitParams), assoc: clone(st.assoc), impls: clone(st.impls), implArgs: clone(st.implArgs), implBounds: clone(st.implBounds), implBoundsNodes: clone(st.implBoundsNodes), templates: clone(st.templates), companions: clone(st.companions), refResultNames: clone(st.refResultNames), refResultParams: clone(st.refResultParams), refResultFroms: clone(st.refResultFroms) };
    definitions = push(clone(st.definitions), d);
    return St { types: types, ctors: ctors, generics: generics, linearTypes: linearTypes, drops: drops, traits: traits, traitFns: traitFns, traitParams: traitParams, assoc: assoc, impls: impls, implArgs: implArgs, implBounds: implBounds, implBoundsNodes: implBoundsNodes, templates: templates, companions: companions, fns: fns, refResultNames: refResultNames, refResultParams: refResultParams, refResultFroms: refResultFroms, ownerViews: ownerViews, definitions: definitions, ..st };
};

fn isRefCodec(t: &Type) -> Bool ~ { return t is Type::TRef || t is Type::TMutRef; };

fn entryOf(nodes: &List<AstNode>, e: Int) -> AstEntry ~ {
    node = nodeIn(nodes, e);
    if node is AstNode::Entry { return clone((node as AstNode::Entry).value); };
    return AstEntry::PairEntry { a: 0 - 1, b: 0 - 1 };
};

// The signatures of the functions defined at the top, known before any body is checked (gatheredSignatures)
fn gatherSignatures(st: St, stmts: &List<Int>) -> St ~ {
    gathered = HashMap::new();
    for s in stmts {
        stmt = stmtOf(st, s);
        if stmt is AstStatement::Assign {
            a = stmt as AstStatement::Assign;
            v = functionValue(st, a.e);
            name = nameText(&st.nodes, a.n);
            if v >= 0 && !HashMap::contains(&st.stdNames, &name) && !HashMap::contains(&st.ghostNames, &name) {
                value = nativeFn(&st.nodes, v);
                sd = sigData(&st.nodes, value.sig); st = functionTypeFrom(st, &sd);
                gathered = gathered.insert(name, st.ty);
            };
        };
    };
    fns = st.fns;
    for e in gathered.entries() { fns = fns.insert(clone(e.key), e.value); };
    return St { fns: fns, ..st };
};

fn respond(st: &St, program: &AstProgram, iface: &AstProgram, hasInterface: Bool) -> Int ~ {
    n = "tersus-elaborated 1\n".print();
    if st.status = 0 {
        n = n + "accepted\ndata".print() + printIntWord(size(program.nodes) + 2) + "\n".print();
        n = n + printAst(program);
        if !hasInterface { return n + "interface none\n".print(); };
        n = n + "interface\ndata".print() + printIntWord(size(iface.nodes) + 2) + "\n".print();
        return n + printAst(iface);
    };
    if st.status = 2 { return n + "unmodelled ".print() + printQuoted(&st.msg) + "\n".print(); };
    if st.status = 3 { return n + "interfaceRefused ".print() + printQuoted(&st.msg) + "\n".print(); };
    return n + "refused ".print() + printQuoted(&st.msg) + "\n".print();
};

fn printIntWord(n: Int) -> Int ~ { return " ".print() + intText(n).print(); };

fn printQuoted(text: &String) -> Int ~ { return quotedName(text).print(); };

fn malformed() -> Int ~ {
    "not an elaboration request\n".printError();
    return 1;
};

st = newState();
header = readLine();
if !wordIs(&header, 0, "tersus-elaborate") || !wordIs(&header, 1, "1") { return malformed(); };
moduleLine = readLine();
predeclare = readLine();
library = readLine();
extract = readLine();
if !wordIs(&moduleLine, 0, "module") || size(moduleLine.words) != 3 || !get(moduleLine.words, 1).quoted || size(predeclare.words) != 2 || size(library.words) != 2 || size(extract.words) != 2 || !wordIs(&predeclare, 0, "predeclare") || !wordIs(&library, 0, "library") || !wordIs(&extract, 0, "extract") { return malformed(); };
hasModule = get(moduleLine.words, 2).quoted;
if !hasModule && !wordIs(&moduleLine, 2, "none") { return malformed(); };
builtinsLine = readLine();
if !wordIs(&builtinsLine, 0, "builtins") { return malformed(); };
table = readBlock();
if !table.ok { return malformed(); };
countLine = readLine();
if !wordIs(&countLine, 0, "interfaces") || size(countLine.words) != 2 { return malformed(); };
count = intAt(&countLine.words, 1);
if !count.ok || count.value < 0 { return malformed(); };
ifaces = [];
ifaceKeys = [];
seenBlocks = HashMap::new();
for i in 0..count.value {
    read = readCachedBlock(seenBlocks);
    seenBlocks = read.seen;
    b = read.block;
    if !b.ok || b.value.stage != "interface" { return malformed(); };
    ifaces = push(ifaces, b.value);
    ifaceKeys = push(ifaceKeys, read.key);
};
definitionsLine = readLine();
if !wordIs(&definitionsLine, 0, "definitions") || size(definitionsLine.words) != 2 { return malformed(); };
definitionCount = intAt(&definitionsLine.words, 1);
if !definitionCount.ok || definitionCount.value < 0 { return malformed(); };
definitions = [];
definitionKeys = [];
for i in 0..definitionCount.value {
    contextLine = readLine();
    if !wordIs(&contextLine, 0, "definition") || size(contextLine.words) != 2 { return malformed(); };
    contextCount = intAt(&contextLine.words, 1);
    if !contextCount.ok || contextCount.value < 1 { return malformed(); };
    context = [];
    keys = [];
    for j in 0..contextCount.value {
        read = readCachedBlock(seenBlocks);
        seenBlocks = read.seen;
        b = read.block;
        if !b.ok || b.value.stage != "interface" { return malformed(); };
        context = push(context, b.value);
        keys = push(keys, read.key);
    };
    definitions = push(definitions, context);
    definitionKeys = push(definitionKeys, keys);
};
programBlock = readBlock();
if !programBlock.ok || programBlock.value.stage != "parsed" { return malformed(); };
end = readRecord();
if !end.ok || end.pos != 0 { return malformed(); };
parsedRoot = programBlock.value.root;
st = St { nodes: programBlock.value.nodes, ..st };
st = loadBuiltins(st, &table.value);
// (an interface a defining context carries again is read where its records already are, so that its templates are
// those the module imported)
bases = HashMap::new();
k = 0;
while k < size(ifaces) && k < size(ifaceKeys) [{ affirm k >= 0; }] shrinks size(ifaces) - k {
    st = appendInterface(st, &get(ifaces, k));
    bases = bases.insert(clone(get(ifaceKeys, k)), st.n);
    st = loadInterface(st, &get(ifaces, k), st.n);
    k = k + 1;
};
k = 0;
while k < size(definitions) && k < size(definitionKeys) [{ affirm k >= 0; }] shrinks size(definitions) - k {
    context = clone(get(definitions, k));
    keys = clone(get(definitionKeys, k));
    contextBases = [];
    j = 0;
    while j < size(context) && j < size(keys) [{ affirm j >= 0; }] shrinks size(context) - j {
        key = clone(get(keys, j));
        if !HashMap::contains(&bases, &key) {
            st = appendInterface(st, &get(context, j));
            bases = bases.insert(clone(key), st.n);
        };
        contextBases = push(contextBases, HashMap::lookup(&bases, &key, 0));
        j = j + 1;
    };
    st = definingContext(st, &context, &contextBases);
    k = k + 1;
};
predeclaring = wordIs(&predeclare, 1, "true");
viewing = wordIs(&library, 1, "true");
extracting = !wordIs(&extract, 1, "none");
if (!predeclaring && !wordIs(&predeclare, 1, "false")) || (!viewing && !wordIs(&library, 1, "false")) || (extracting && !wordIs(&extract, 1, "module") && !wordIs(&extract, 1, "lib")) { return malformed(); };
pkg = clone(get(moduleLine.words, 1).text);
modu = "";
if hasModule { modu = clone(get(moduleLine.words, 2).text); };
if viewing {
    for o in clone(st.ownerViews) {
        if !HashMap::contains(&st.types, &o) { st = St { types: st.types.insert(clone(o), push([], clone(o))), ..st }; };
    };
};
stmts = listItems(&st.nodes, parsedRoot);
if st.status = 0 {
    st = gatherSignatures(st, &stmts);
    if predeclaring {
        st = predeclareOwn(st, &stmts);
        st = checkOwnFinite(st, &stmts);
    };
    if st.status = 0 { st = checkStatements(st, true, &stmts); };
};
out = AstProgram { stage: "elaborated", nodes: [], root: 0 };
iface = AstProgram { stage: "interface", nodes: [], root: 0 };
if st.status = 0 {
    statementsNode = st.te.node;
    types = clone(st.te.types);
    st = emitTypes(st, &types);
    if st.status = 0 {
        st = emit(st, AstNode::Elaborated { value: AstElaborated { statements: statementsNode, types: st.nid } });
        out = reorderArena(&st.nodes, st.nid, "elaborated");
        if extracting {
            elaborated = listItems(&st.nodes, statementsNode);
            st = extractInterface(st, wordIs(&extract, 1, "lib"), pkg, modu, hasModule, &stmts, &elaborated);
            if st.status = 0 { iface = reorderArena(&st.nodes, st.nid, "interface"); };
        };
    };
};
respond(&st, &out, &iface, extracting);
