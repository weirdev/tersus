import data::ast::ast { AstNode };
import data::codec::codec { catStrings };
import elaborate::calls { teHead };

// A type. kind: 0 Int, 1 Byte, 2 Bool, 3 a word (flag signed, n bits), 4 a named type (name, args: its arguments,
// a size kind among them an ArgSize), 5 a variant (name), 6 an array (args: element, size), 7 Addr, 8 Block,
// 9 Uninit, 10 &, 11 &mut (args: what it is of), 12 a type parameter (name), 13 a function with parameters (sizes,
// types, args: its type), 14 a function (args: parameters, then the result), 15 an unknown (n), and the sizes: 20 a
// constant (n), 21 any, 22 a size parameter (name), 23 an unknown size (n).
// A function of an impl, as the checks against its trait read it
struct Defined { name: String, params: List<String>, ptys: List<Int>, rty: Int, sizes: Int, term: Int, sigNode: Int };
impl Clone for Defined { };

struct Ty { kind: Int, name: String, args: List<Int>, n: Int, flag: Bool, sizes: List<String>, types: List<String> };
impl Clone for Ty { };

// An expression with the types of it and of the expressions inside it, in the order the lowering visits them
struct TE { node: Int, types: List<Int> };
impl Clone for TE { };

// A constructor: the type it makes and its fields
struct CtorInfo { owner: String, names: List<String>, types: List<Int> };
impl Clone for CtorInfo { };

// A struct with parameters: the parameters, and its fields with them in their types
struct Generic { params: List<String>, names: List<String>, types: List<Int> };
impl Clone for Generic { };

// The variables in scope: a stack of scopes, each the bindings from its mark to the next one's
struct Scopes { names: List<String>, types: List<Int>, marks: List<Int> };
impl Clone for Scopes { };

fn oneScope() -> Scopes ~ {
    return Scopes { names: [], types: [], marks: push([], 0) };
};

// A bound on a type parameter: the parameter, the trait and the types it gives the trait
struct BoundInfo { p: String, n: String, ts: List<Int> };
impl Clone for BoundInfo { };

// For a trait and a type that implements it, the impl's type and the types (and sizes) it gives the trait
struct ImplArgs { ty: Int, args: List<Int>, tyNode: Int, argsNode: Int };
impl Clone for ImplArgs { };

// A function with bounds on its types (Template): its bounds, its parameters, its signature as types, and the records of
// its contracts, termination and body (an imported one has only its signature and bounds)
struct Template {
    bounds: List<BoundInfo>, params: List<String>, ptys: List<Int>, rty: Int,
    sizes: List<String>, types: List<String>, from: List<String>, ins: Int, outs: Int, term: Int, body: Int,
    boundsNode: Int, paramsNode: Int, sigNode: Int, retNode: Int
};
impl Clone for Template { };


// A function's parameters and signature, its types as types of the arena (Signature)
struct FnSig { params: List<String>, ptys: List<Int>, rty: Int, sizes: List<String>, types: List<String>, writes: List<String>, froms: List<String> };
impl Clone for FnSig { };

// A copy of a function with bounds that the module names (templateReference): the function, its types and the sizes its
// bounds name, and the copy's signature
struct Reference { f: String, types: List<Int>, sizes: List<Int>, sig: FnSig };
impl Clone for Reference { };

// A place as the root it starts from and its steps: a field's name, or "" for an element
struct Place { ok: Bool, root: String, steps: List<String> };
impl Clone for Place { };

// The functions of an impl with bounds as its checking goes: their names, values, signatures and how the checks against
// the trait read them, and the functions that make those checks (the trait functions they check, values and names)
struct BoundedParts { names: List<String>, values: List<Int>, sigs: List<FnSig>, defined: List<Defined>, wrapperOf: List<String>, wrapperValues: List<Int>, wrapperNames: List<String> };
impl Clone for BoundedParts { };

fn noBoundedParts() -> BoundedParts ~ { return BoundedParts { names: [], values: [], sigs: [], defined: [], wrapperOf: [], wrapperValues: [], wrapperNames: [] }; };

// The checker's state. status: 0 checking, 1 refused, 2 not modelled, 3 interface refused, 4 unresolved; msg says why. defQueue holds the functions with bounds the module defines, which are checked against their bounds alone once
// it is checked, and defChecking is set while one is; genericOut and genericTypes are the checked bodies and their
// expression types, references the copies the module names and boundStubs the functions bounds give (all given to the
// program after it is checked); sequenceTraits holds the library's Sequence and Growable when the module has them, which lists, arrays and Boxes of
// arrays implement with the builtins;
// storageCopies is set for the native storage helpers (tersuslib's lists and box), whose clones are the copies native code
// makes of a value of any type.
// ty is the result of the last function that makes a type, ok of the last unify, te of the last inference.
struct St {
    nodes: List<AstNode>,
    tys: List<Ty>,
    subst: HashMap<Int, Int>,
    sizeSubst: HashMap<Int, Int>,
    next: Int,
    wireVersion: Bool,
    wireProtocols: HashMap<String, List<String>>,
    wireOwnership: HashMap<String, List<String>>,
    types: HashMap<String, List<String>>,
    ctors: HashMap<String, CtorInfo>,
    generics: HashMap<String, Generic>,
    linearTypes: HashSet<String>,
    drops: HashSet<String>,
    traits: HashSet<String>,
    traitFns: HashMap<String, List<Int>>,
    traitParams: HashMap<String, List<String>>,
    traitSelf: List<Int>,
    inTrait: Bool,
    assoc: HashMap<String, List<String>>,
    implArgs: HashMap<String, ImplArgs>,
    implBounds: HashMap<String, List<BoundInfo>>,
    implBoundsNodes: HashMap<String, Int>,
    ownerViews: List<String>,
    logging: Bool,
    implDefined: List<Defined>,
    ghostCache: HashMap<String, Bool>,
    refCache: HashMap<String, Bool>,
    boundedParts: BoundedParts,
    big: List<Int>,
    undo: List<Int>,
    sizeUndo: List<Int>,
    templates: HashMap<String, Template>,
    references: HashMap<String, Int>,
    referenceList: List<Reference>,
    boundStubs: HashMap<String, Int>,
    boundStubSigs: List<FnSig>,
    builtinStubs: HashSet<String>,
    genericOut: List<Int>,
    genericTypes: List<Int>,
    fns: HashMap<String, Int>,
    scopes: Scopes,
    ret: Int,
    programReturn: Int,
    sizeScope: List<String>,
    typeScope: List<String>,
    readOnly: List<String>,
    mutParams: List<String>,
    writes: List<String>,
    aliasNames: List<String>,
    aliasPlaces: List<Place>,
    originNames: List<String>,
    originRoots: List<List<String>>,
    refResultNames: List<String>,
    refResultParams: List<List<String>>,
    refResultFroms: List<List<String>>,
    resultFrom: List<String>,
    params: List<String>,
    current: String,
    inGhost: Bool,
    predeclared: HashSet<String>,
    impls: HashSet<String>,
    builtinNames: HashMap<String, Int>,
    builtinValues: List<Int>,
    builtinSchemes: List<Int>,
    builtinKinds: List<String>,
    stdNames: HashMap<String, Int>,
    pointer: HashMap<String, Int>,
    ghostNames: HashMap<String, Int>,
    methods: HashMap<String, Int>,
    methodOf: HashMap<Int, String>,
    ty: Int,
    ok: Bool,
    te: TE,
    tes: List<TE>,
    outs: List<Int>,
    nid: Int,
    n: Int,
    gen: Generic,
    ctor: CtorInfo,
    names: List<String>,
    fnSig: FnSig,
    boundsOut: List<BoundInfo>,
    sigNode: Int,
    seen: List<String>,
    defQueue: List<String>,
    defChecking: Bool,
    sequenceTraits: HashSet<String>,
    storageCopies: Bool,
    status: Int,
    msg: String
};

fn fail(st: St, msg: String) -> St ~ {
    if st.status != 0 { return st; };
    return St { status: 1, msg: msg, ..st };
};

fn notModelled(st: St, what: String) -> St ~ {
    if st.status != 0 { return st; };
    return St { status: 2, msg: what, ..st };
};

fn typeError(st: St, what: String) -> St ~ {
    return fail(st, "Type error: ".concat(what));
};

// The first type parameter of a type that keeps a value of it from being cloned, or "": a type parameter is cloned only in a
// body checked against its bounds, when a bound makes it Clone (or Copy, which is Clone too), so a function without bounds
// clones none, except in the native storage helpers (storageCopies).
fn unclonedParameter(st: &St, t: Int) -> String ~ {
    x = tyAt(st, resolve(st, t));
    if x.kind = 12 {
        if st.storageCopies || (st.defChecking && (HashSet::contains(&st.impls, catStrings(catStrings(protocolName(st, "Clone"), " "), parameterOwner(&x.name))) || HashSet::contains(&st.impls, catStrings(catStrings(protocolName(st, "Copy"), " "), parameterOwner(&x.name))))) { return ""; };
        return clone(x.name);
    };
    for a in &x.args {
        p = unclonedParameter(st, a);
        if size(p.bytes) > 0 { return p; };
    };
    return "";
};

fn parametersClone(st: &St, t: Int) -> Bool ~ { return size(unclonedParameter(st, t).bytes) = 0; };

// What a bound of the type parameter p is an impl for while a body is checked against its bounds: a name no program
// writes, so that no type or function of the program is taken for one of the bound's
fn parameterOwner(p: &String) -> String ~ { return catStrings("$param ", clone(p)); };

// The type parameter that parameterOwner made the owner for, or ""
fn ownedParameter(owner: &String) -> String ~ {
    prefix = "$param ";
    if size(owner.bytes) <= size(prefix.bytes) || owner.slice(0, size(prefix.bytes)) != prefix { return ""; };
    return owner.slice(size(prefix.bytes), size(owner.bytes));
};

fn withTy(st: St, t: Int) -> St ~ {
    if st.ty = t { return st; };
    return St { ty: t, ..st };
};

fn noTy() -> Ty ~ {
    return Ty { kind: 0 - 1, name: "", args: [], n: 0, flag: false, sizes: [], types: [] };
};

fn tyAt(st: &St, t: Int) -> Ty ~ {
    if t < 0 || t >= size(st.tys) { return noTy(); };
    return clone(get(st.tys, t));
};

fn kindOf(st: &St, t: Int) -> Int ~ {
    if t < 0 || t >= size(st.tys) { return 0 - 1; };
    return get(st.tys, t).kind;
};

fn nameOf(st: &St, t: Int) -> String ~ {
    if t < 0 || t >= size(st.tys) { return ""; };
    return clone(get(st.tys, t).name);
};

fn argsOf(st: &St, t: Int) -> List<Int> ~ {
    if t < 0 || t >= size(st.tys) { return []; };
    return clone(get(st.tys, t).args);
};

// The i-th of a list of nodes, -1 when there is none (tyAt and the readers of nodes take -1 for "nothing")
fn nth(xs: &List<Int>, i: Int) -> Int ~ {
    if i < 0 || i >= size(xs) { return 0 - 1; };
    return get(xs, i);
};

fn builtinKindAt(st: &St, i: Int) -> String ~ {
    if i < 0 || i >= size(st.builtinKinds) { return ""; };
    return clone(get(st.builtinKinds, i));
};

fn builtinValueAt(st: &St, i: Int) -> Int ~ {
    if i < 0 || i >= size(st.builtinValues) { return 0 - 1; };
    return get(st.builtinValues, i);
};

fn teHeadAt(xs: &List<TE>, i: Int) -> Int ~ {
    if i < 0 || i >= size(xs) { return 0 - 1; };
    return teHead(&get(xs, i));
};

// What holdsGhost and holdsRef found no longer holds once a type, its constructors, a linear type or a drop is declared
fn typesChanged(st: St) -> St ~ { return St { ghostCache: HashMap::new(), refCache: HashMap::new(), ..st }; };

fn firstText(xs: &List<String>) -> String ~ {
    if size(xs) = 0 { return ""; };
    return clone(get(xs, 0));
};

fn argAt(st: &St, t: Int, i: Int) -> Int ~ {
    args = argsOf(st, t);
    if i < 0 || i >= size(args) { return 0 - 1; };
    return get(args, i);
};

fn numberOf(st: &St, t: Int) -> Int ~ {
    if t < 0 || t >= size(st.tys) { return 0; };
    return get(st.tys, t).n;
};

fn addTy(st: St, t: Ty) -> St ~ {
    id = size(st.tys);
    return St { tys: push(st.tys, t), ty: id, ..st };
};

fn simpleTy(st: St, kind: Int) -> St ~ {
    return addTy(st, Ty { kind: kind, name: "", args: [], n: 0, flag: false, sizes: [], types: [] });
};

fn wrapTy(st: St, kind: Int, inner: Int) -> St ~ {
    return addTy(st, Ty { kind: kind, name: "", args: push([], inner), n: 0, flag: false, sizes: [], types: [] });
};

fn namedTy(st: St, base: String, args: List<Int>) -> St ~ {
    return addTy(st, Ty { kind: 4, name: base, args: args, n: 0, flag: false, sizes: [], types: [] });
};

fn protocolName(st: &St, role: &String) -> String ~ {
    if !st.wireVersion { return clone(role); };
    providers = st.wireProtocols.lookup(role, []);
    if size(providers) = 1 { return clone(get(providers, 0)); };
    return "";
};

fn protocolIs(st: &St, role: &String, provider: &String) -> Bool ~ {
    name = protocolName(st, role);
    return size(name.bytes) > 0 && name = clone(provider);
};

fn listTy(st: St, elem: Int) -> St ~ {
    provider = protocolName(&st, "List");
    if size(provider.bytes) = 0 { return typeError(st, "List syntax requires its checked provider"); };
    return namedTy(st, provider, push([], elem));
};

fn boxTy(st: St, inner: Int) -> St ~ {
    provider = protocolName(&st, "Box");
    if size(provider.bytes) = 0 { return typeError(st, "Box syntax requires its checked provider"); };
    return namedTy(st, provider, push([], inner));
};

fn fnTy(st: St, params: List<Int>, ret: Int) -> St ~ {
    return addTy(st, Ty { kind: 14, name: "", args: push(params, ret), n: 0, flag: false, sizes: [], types: [] });
};

fn arrayTy(st: St, elem: Int, sz: Int) -> St ~ {
    return addTy(st, Ty { kind: 6, name: "", args: push(push([], elem), sz), n: 0, flag: false, sizes: [], types: [] });
};

fn wordTy(st: St, signed: Bool, bits: Int) -> St ~ {
    return addTy(st, Ty { kind: 3, name: "", args: [], n: bits, flag: signed, sizes: [], types: [] });
};

fn sizeConst(st: St, n: Int) -> St ~ {
    return addTy(st, Ty { kind: 20, name: "", args: [], n: n, flag: false, sizes: [], types: [] });
};

fn freshVar(st: St) -> St ~ {
    n = st.next;
    st = St { next: n + 1, ..st };
    return addTy(st, Ty { kind: 15, name: "", args: [], n: n, flag: false, sizes: [], types: [] });
};

fn freshSize(st: St) -> St ~ {
    n = st.next;
    st = St { next: n + 1, ..st };
    return addTy(st, Ty { kind: 23, name: "", args: [], n: n, flag: false, sizes: [], types: [] });
};

fn isSize(st: &St, t: Int) -> Bool ~ {
    k = kindOf(st, t);
    return k >= 20 && k <= 23;
};

// What an unknown or an unknown size has come to, followed to the end
fn resolve(st: &St, t: Int) -> Int ~ {
    r = t;
    going = true;
    while going [{ }] ~ {
        k = kindOf(st, r);
        if k = 15 && HashMap::contains(&st.subst, numberOf(st, r)) {
            r = HashMap::lookup(&st.subst, numberOf(st, r), r);
        } else {
            if k = 23 && HashMap::contains(&st.sizeSubst, numberOf(st, r)) {
                r = HashMap::lookup(&st.sizeSubst, numberOf(st, r), r);
            } else {
                going = false;
            };
        };
    };
    return r;
};

// Whether zonk would give another type than t (most types it is given are already resolved, and finding that out
// needs no new state)
fn zonkChanges(st: &St, t: Int) -> Bool ~ {
    if resolve(st, t) != t { return true; };
    if t < 0 || t >= size(st.tys) { return false; };
    i = 0;
    while i < size(get(st.tys, t).args) [{ affirm i >= 0; }] ~ {
        if zonkChanges(st, get(get(st.tys, t).args, i)) { return true; };
        i = i + 1;
    };
    return false;
};

// The type with everything known of its unknowns put in, as a type of its own
fn zonk(st: St, t: Int) -> St ~ {
    if !zonkChanges(st, t) { return withTy(st, t); };
    r = resolve(st, t);
    x = tyAt(st, r);
    if size(x.args) = 0 { return withTy(st, r); };
    args = [];
    changed = false;
    for a in x.args {
        st = zonk(st, a);
        if st.ty != a { changed = true; };
        args = push(args, st.ty);
    };
    if !changed { return withTy(st, r); };
    return addTy(st, Ty { args: args, ..x });
};

// Whether two types are the same, as Haskell's == on zonked types says
fn sameTy(st: &St, a: Int, b: Int) -> Bool ~ {
    x = tyAt(st, resolve(st, a));
    y = tyAt(st, resolve(st, b));
    if x.kind != y.kind || x.name != y.name || x.n != y.n || x.flag != y.flag || size(x.args) != size(y.args) { return false; };
    if x.sizes != y.sizes || x.types != y.types { return false; };
    i = 0;
    while i < size(x.args) [{ affirm i >= 0; affirm size(x.args) = size(y.args); }] ~ {
        if !sameTy(st, get(x.args, i), get(y.args, i)) { return false; };
        i = i + 1;
    };
    return true;
};

fn occurs(st: &St, v: Int, t: Int) -> Bool ~ {
    r = resolve(st, t);
    x = tyAt(st, r);
    if x.kind = 15 { return x.n = v; };
    for a in x.args {
        if kindOf(st, a) < 20 && occurs(st, v, a) { return true; };
    };
    return false;
};

fn bindVar(st: St, n: Int, t: Int) -> St ~ {
    if st.logging { st = St { undo: push(st.undo, n), ..st }; };
    return St { subst: st.subst.insert(n, t), ok: true, ..st };
};

fn unifySize(st: St, a: Int, b: Int) -> St ~ {
    x = resolve(st, a);
    y = resolve(st, b);
    kx = kindOf(st, x);
    ky = kindOf(st, y);
    if kx = 23 && ky = 23 && numberOf(st, x) = numberOf(st, y) { return St { ok: true, ..st }; };
    if kx = 23 {
        nx = numberOf(st, x);
        if st.logging { st = St { sizeUndo: push(st.sizeUndo, nx), ..st }; };
        return St { sizeSubst: st.sizeSubst.insert(nx, y), ok: true, ..st };
    };
    if ky = 23 {
        ny = numberOf(st, y);
        if st.logging { st = St { sizeUndo: push(st.sizeUndo, ny), ..st }; };
        return St { sizeSubst: st.sizeSubst.insert(ny, x), ok: true, ..st };
    };
    same = sameTy(st, x, y);
    return St { ok: same, ..st };
};

fn unifyArg(st: St, a: Int, b: Int) -> St ~ {
    sa = isSize(st, a);
    sb = isSize(st, b);
    if sa && sb { return unifySize(st, a, b); };
    if !sa && !sb { return unify(st, a, b); };
    return St { ok: false, ..st };
};

fn unifyAll(st: St, xs: &List<Int>, ys: &List<Int>, args: Bool) -> St ~ {
    if size(xs) != size(ys) { return St { ok: false, ..st }; };
    i = 0;
    while i < size(xs) [{ affirm i >= 0; affirm size(xs) = size(ys); }] ~ {
        if args { st = unifyArg(st, get(xs, i), get(ys, i)); } else { st = unify(st, get(xs, i), get(ys, i)); };
        if !st.ok { return st; };
        i = i + 1;
    };
    return St { ok: true, ..st };
};

// Makes the two types equal if they can be; st.ok says whether they could
fn unify(st: St, a: Int, b: Int) -> St ~ {
    x = resolve(st, a);
    y = resolve(st, b);
    kx = kindOf(st, x);
    ky = kindOf(st, y);
    if kx = 15 && ky = 15 && numberOf(st, x) = numberOf(st, y) { return St { ok: true, ..st }; };
    if kx = 15 && !occurs(st, numberOf(st, x), y) { return bindVar(st, numberOf(st, x), y); };
    if ky = 15 && !occurs(st, numberOf(st, y), x) { return bindVar(st, numberOf(st, y), x); };
    if kx = 4 && ky = 4 {
        xs = argsOf(st, x);
        ys = argsOf(st, y);
        if nameOf(st, x) = nameOf(st, y) && size(xs) = size(ys) { return unifyAll(st, &xs, &ys, true); };
        return St { ok: false, ..st };
    };
    if kx = 4 && ky = 5 {
        variant = nameOf(st, y);
        whole = instanceName(st, x);
        variants = HashMap::lookup(&st.types, &whole, []);
        return St { ok: indexIn(&variants, &variant) >= 0, ..st };
    };
    if kx != ky {
        // (&mut T and &T unify as their referents do)
        if (kx = 10 || kx = 11) && (ky = 10 || ky = 11) { return unify(st, argAt(st, x, 0), argAt(st, y, 0)); };
        return St { ok: false, ..st };
    };
    if kx <= 2 { return St { ok: true, ..st }; };
    if kx = 3 {
        sameWord = numberOf(st, x) = numberOf(st, y) && tyAt(st, x).flag = tyAt(st, y).flag;
        return St { ok: sameWord, ..st };
    };
    if kx = 5 || kx = 12 {
        sameName = nameOf(st, x) = nameOf(st, y);
        return St { ok: sameName, ..st };
    };
    if kx = 6 {
        st = unifySize(st, argAt(st, x, 1), argAt(st, y, 1));
        if !st.ok { return st; };
        return unify(st, argAt(st, x, 0), argAt(st, y, 0));
    };
    if kx >= 7 && kx <= 11 { return unify(st, argAt(st, x, 0), argAt(st, y, 0)); };
    if kx = 14 {
        xs = argsOf(st, x);
        ys = argsOf(st, y);
        if size(xs) != size(ys) { return St { ok: false, ..st }; };
        // (the result first, then the parameters, as Haskell unifies them)
        st = unify(st, nth(&xs, size(xs) - 1), nth(&ys, size(ys) - 1));
        if !st.ok { return st; };
        i = 0;
        while i + 1 < size(xs) [{ affirm i >= 0; affirm size(xs) = size(ys); }] ~ {
            st = unify(st, get(xs, i), get(ys, i));
            if !st.ok { return st; };
            i = i + 1;
        };
        return St { ok: true, ..st };
    };
    return St { ok: false, ..st };
};

fn indexIn(names: &List<String>, name: &String) -> Int ~ {
    i = 0;
    for n in names {
        if n = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

fn joinWith(parts: &List<String>, sep: &String) -> String ~ {
    out = "";
    i = 0;
    for p in parts {
        if i > 0 { out = catStrings(out, sep); };
        out = catStrings(out, p);
        i = i + 1;
    };
    return out;
};

fn maxInt() -> Int ~ { return 9223372036854775807; };
fn minInt() -> Int ~ { return 0 - 9223372036854775807 - 1; };

fn productFits(a: Int, c: Int) -> Bool ~ {
    if a = 0 || c = 0 { return true; };
    if a = minInt() { return c = 1; };
    if c = minInt() { return a = 1; };
    ua = a;
    if a < 0 { ua = 0 - a; };
    uc = c;
    if c < 0 { uc = 0 - c; } else { affirm c > 0; };
    if (a < 0) = (c < 0) { return ua <= maxInt() / uc; };
    // (a negative product may be the least Int, 2^63 below zero)
    return ua <= maxInt() / uc || (maxInt() % uc = uc - 1 && ua = maxInt() / uc + 1);
};

fn intText(n: Int) -> String ~ {
    if n = 0 { return "0"; };
    if n = minInt() { return "-9223372036854775808"; };
    negative = n < 0;
    m = n;
    if negative { m = 0 - n; };
    digits = [];
    while m > 0 [{ }] shrinks m {
        digits = push(digits, toByte(48 + m % 10));
        m = m / 10;
    };
    out = [];
    if negative { out = push(out, toByte(45)); };
    i = size(digits) - 1;
    while i >= 0 [{ affirm i < size(digits); }] shrinks i + 1 {
        out = push(out, get(digits, i));
        i = i - 1;
    };
    return String { bytes: out };
};

fn wordName(signed: Bool, bits: Int) -> String ~ {
    if signed { return catStrings("I", intText(bits)); };
    return catStrings("U", intText(bits));
};

fn renderSize(st: &St, t: Int) -> String ~ {
    return sizeText(st, t, true);
};

fn sizeText(st: &St, t: Int, deep: Bool) -> String ~ {
    r = t;
    if deep { r = resolve(st, t); };
    x = tyAt(st, r);
    if x.kind = 20 { return intText(x.n); };
    if x.kind = 21 { return "?"; };
    if x.kind = 22 { return clone(x.name); };
    return catStrings("_", intText(x.n));
};

fn isLowerByte(c: Int) -> Bool ~ { return c >= 97 && c <= 122; };
fn isUpperByte(c: Int) -> Bool ~ { return c >= 65 && c <= 90; };

// Whether a name is bare and starts with a small letter (Types.bareLower)
fn bareLower(name: &String) -> Bool ~ {
    n = size(name.bytes);
    if n = 0 || !isLowerByte(toInt(get(name.bytes, 0))) { return false; };
    i = 1;
    while i < n [{ affirm i >= 1; affirm n = size(name.bytes); }] shrinks n - i {
        c = toInt(get(name.bytes, i));
        if !(isLowerByte(c) || isUpperByte(c) || (c >= 48 && c <= 57)) { return false; };
        i = i + 1;
    };
    return true;
};

// A parameter that starts with a capital letter is a type, and any other is a size
fn isTypeName(name: &String) -> Bool ~ {
    return size(name.bytes) > 0 && isUpperByte(toInt(get(name.bytes, 0)));
};

// The rendered name of an instance (Types.instanceName)
fn instanceName(st: &St, t: Int) -> String ~ {
    return instanceText(st, t, true);
};

// The name of an instance as the type is, its unknowns not looked up (as Haskell names one it has not zonked)
fn rawInstanceName(st: &St, t: Int) -> String ~ {
    return instanceText(st, t, false);
};

fn instanceText(st: &St, t: Int, deep: Bool) -> String ~ {
    r = t;
    if deep { r = resolve(st, t); };
    x = tyAt(st, r);
    if size(x.args) = 0 { return clone(x.name); };
    parts = [];
    for a in x.args {
        if isSize(st, a) { parts = push(parts, sizeText(st, a, deep)); } else { parts = push(parts, typeNameText(st, a, deep)); };
    };
    return catStrings(catStrings(catStrings(x.name, "<"), joinWith(&parts, ", ")), ">");
};

fn wrapped(prefix: &String, inner: String, suffix: &String) -> String ~ {
    return catStrings(catStrings(prefix, inner), suffix);
};

// A type as the rendered name of an instance writes it (Types.renderTypeForName)
fn typeNameText(st: &St, t: Int, deep: Bool) -> String ~ {
    r = t;
    if deep { r = resolve(st, t); };
    x = tyAt(st, r);
    k = x.kind;
    if k = 0 { return "Int"; };
    if k = 1 { return "Byte"; };
    if k = 2 { return "Bool"; };
    if k = 3 { return wordName(x.flag, x.n); };
    if k = 4 {
        if size(x.args) = 0 && bareLower(&x.name) { return catStrings("`", x.name); };
        return instanceText(st, r, deep);
    };
    if k = 5 { return clone(x.name); };
    if k = 6 { return wrapped("Array<", catStrings(catStrings(typeNameText(st, nth(&x.args, 0), deep), ", "), sizeText(st, nth(&x.args, 1), deep)), ">"); };
    if k = 7 { return wrapped("Addr<", typeNameText(st, nth(&x.args, 0), deep), ">"); };
    if k = 8 { return wrapped("Block<", typeNameText(st, nth(&x.args, 0), deep), ">"); };
    if k = 9 { return wrapped("Uninit<", typeNameText(st, nth(&x.args, 0), deep), ">"); };
    if k = 10 { return catStrings("&", typeNameText(st, nth(&x.args, 0), deep)); };
    if k = 11 { return catStrings("&mut ", typeNameText(st, nth(&x.args, 0), deep)); };
    if k = 12 { return catStrings("'", x.name); };
    if k = 13 { return typeNameText(st, nth(&x.args, 0), deep); };
    if k = 14 {
        parts = [];
        i = 0;
        while i + 1 < size(x.args) [{ affirm i >= 0; }] ~ {
            parts = push(parts, typeNameText(st, get(x.args, i), deep));
            i = i + 1;
        };
        return catStrings(wrapped("fn(", joinWith(&parts, ", "), ") -> "), typeNameText(st, nth(&x.args, size(x.args) - 1), deep));
    };
    return catStrings("?", intText(x.n));
};

// A type in Tersus syntax, as messages write it (Pretty.renderType)
fn render(st: &St, t: Int) -> String ~ {
    r = resolve(st, t);
    x = tyAt(st, r);
    k = x.kind;
    if k = 0 { return "Int"; };
    if k = 1 { return "Byte"; };
    if k = 2 { return "Bool"; };
    if k = 3 { return wordName(x.flag, x.n); };
    if k = 4 {
        if x.name = "List" && size(x.args) = 1 && !isSize(st, nth(&x.args, 0)) { return wrapped("List<", render(st, nth(&x.args, 0)), ">"); };
        if x.name = "Box" && size(x.args) = 1 && !isSize(st, nth(&x.args, 0)) { return wrapped("Box<", render(st, nth(&x.args, 0)), ">"); };
        return instanceName(st, r);
    };
    if k = 5 { return clone(x.name); };
    if k = 6 { return wrapped("Array<", catStrings(catStrings(render(st, nth(&x.args, 0)), ", "), renderSize(st, nth(&x.args, 1))), ">"); };
    if k = 7 { return wrapped("Addr<", render(st, nth(&x.args, 0)), ">"); };
    if k = 8 { return wrapped("Block<", render(st, nth(&x.args, 0)), ">"); };
    if k = 9 { return wrapped("Uninit<", render(st, nth(&x.args, 0)), ">"); };
    if k = 10 { return catStrings("&", render(st, nth(&x.args, 0))); };
    if k = 11 { return catStrings("&mut ", render(st, nth(&x.args, 0))); };
    if k = 12 { return clone(x.name); };
    if k = 13 {
        names = clone(x.types);
        for s in x.sizes { names = push(names, clone(s)); };
        return catStrings(wrapped("<", joinWith(&names, ", "), ">"), render(st, nth(&x.args, 0)));
    };
    if k = 14 {
        parts = [];
        i = 0;
        while i + 1 < size(x.args) [{ affirm i >= 0; }] ~ {
            parts = push(parts, render(st, get(x.args, i)));
            i = i + 1;
        };
        return catStrings(wrapped("fn(", joinWith(&parts, ", "), ") -> "), render(st, nth(&x.args, size(x.args) - 1)));
    };
    return "?";
};

// Fails with the context if the types cannot be made equal
fn expect(st: St, context: String, expected: Int, actual: Int) -> St ~ {
    if st.status != 0 { return st; };
    st = unify(st, expected, actual);
    if st.ok { return st; };
    message = catStrings(catStrings(catStrings(catStrings(context, ": expected "), render(st, expected)), ", got "), render(st, actual));
    return typeError(st, message);
};

// A try (tryTc): what follows is undone if it fails. The bindings it makes are logged, so they can be taken back.
fn beginTry(st: St) -> St ~ { return St { logging: true, undo: [], sizeUndo: [], ..st }; };

// The try failed: its bindings and fresh variables are taken back, and its failure forgotten
fn undoTry(st: St, next: Int) -> St ~ {
    subst = st.subst;
    for n in &st.undo { subst = subst.remove(n); };
    sizes = st.sizeSubst;
    for n in &st.sizeUndo { sizes = sizes.remove(n); };
    return St { subst: subst, sizeSubst: sizes, next: next, status: 0, msg: "", logging: false, undo: [], sizeUndo: [], ..st };
};

fn endTry(st: St) -> St ~ { return St { logging: false, undo: [], sizeUndo: [], ..st }; };
