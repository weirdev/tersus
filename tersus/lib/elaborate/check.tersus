import data::ast::ast { AstBody, AstExpression, AstNode, AstOptTermination, AstRule, AstSignature, AstStatement, AstTermination, AstValidation, AstValue };
import data::codec::codec { catStrings };
import elaborate::calls { assignVar, bindIn, bindInner, coerce, head, lookupVar, popScope, pushScope, scopeLookup, teHead, withType };
import elaborate::core { checkFieldType, checkFinite, checkType, declareTypeWith, holdsRef, isBoxTy, isListTy, readField, registerCtors, unrefOf };
import elaborate::expr { derefExpr, freshElementType, inferExpr, packIndexFolds };
import elaborate::out { emit, emitName, emitNames, emitProofs, emitStatements, emitType, emitTypes, emitVal, emitValidations };
import elaborate::proofs { inferProof, rewriteOldStatements };
import elaborate::records { codecTypeAt, codecTypesAt, exprOf, fieldCodecTypes, fieldNames, fromCodec, fromCodecs, isVar, listItems, nameText, namesText, nativeFn, nodeIn, signatureOf, varName };
import elaborate::refs { derefRoot, exprRefOrigins, placeSteps, putRefResult, recordAlias, recordOrigins, resolveRefPlace, withinWrites, writesTarget, writesText };
import elaborate::state { FnSig, Generic, St, TE, Ty, addTy, isPackTypeName, resolve, argAt, expect, fail, fnTy, indexIn, intText, isSize, isTypeName, joinWith, kindOf, nth, oneScope, render, simpleTy, tyAt, typeError, typesChanged, zonk };
import elaborate::traits { boundsOf, checkImplDef, checkTrait, declareTemplate, templateOf };

fn stmtOf(st: &St, s: Int) -> AstStatement ~ {
    node = nodeIn(&st.nodes, s);
    if node is AstNode::Statement { return clone((node as AstNode::Statement).value); };
    return AstStatement::Mark { line: 0, col: 0 };
};

// Statements: each gives back the statement it stands for (st.nid) and the types of its code (st.te.types)
fn checkStatements(st: St, top: Bool, stmts: &List<Int>) -> St ~ {
    out = [];
    types = [];
    for s in stmts {
        st = checkItem(st, top, s);
        if st.status != 0 { return st; };
        for o in &st.outs { out = push(out, o); };
        for t in &st.te.types { types = push(types, t); };
    };
    st = emitStatements(st, &out);
    return St { te: TE { node: st.nid, types: types }, ..st };
};

fn checkItem(st: St, top: Bool, s: Int) -> St ~ {
    stmt = stmtOf(st, s);
    if stmt is AstStatement::TraitDef {
        if !top { return fail(st, "Type error: a trait can only be defined at the top of the program"); };
        td = stmt as AstStatement::TraitDef;
        return checkTrait(st, nameText(&st.nodes, td.n), namesText(&st.nodes, td.ps), listItems(&st.nodes, td.fs));
    };
    if stmt is AstStatement::ImplDef {
        d = stmt as AstStatement::ImplDef;
        return checkImplDef(st, top, d.traitName, d.args, d.n, d.ty, d.bs, d.xs);
    };
    if stmt is AstStatement::BoundedDef {
        bd = stmt as AstStatement::BoundedDef;
        inner = stmtOf(st, bd.s);
        if inner is AstStatement::Assign {
            a = inner as AstStatement::Assign;
            v = functionValue(st, a.e);
            if v >= 0 {
                if !top { return fail(st, "Type error: a function with bounds on its types can only be defined at the top of the program or in an impl of a type, not in a block or a function"); };
                st = boundsOf(st, bd.bs);
                bounds = clone(st.boundsOut);
                value = nativeFn(&st.nodes, v);
                st = fnSigOf(st, value.ps, value.sig);
                fs = clone(st.fnSig);
                tm = templateOf(st, v, &bounds, bd.bs, &fs, 0 - 1);
                st = declareTemplate(st, nameText(&st.nodes, a.n), bounds, tm);
                return St { outs: [], te: TE { node: 0 - 1, types: [] }, ..st };
            };
        };
        return fail(st, "Type error: only a function can have bounds on its types");
    };
    st = checkStatement(st, top, s);
    if st.status != 0 { return st; };
    return St { outs: push([], st.nid), ..st };
};

// The statement and the types of its code expressions in visit order (checkStatement)
fn checkStatement(st: St, top: Bool, s: Int) -> St ~ {
    stmt = stmtOf(st, s);
    match stmt {
        AstStatement::Assign { n: n, e: e } => {
            return checkStatementAssign(st, top, n, e);
        },
        AstStatement::Let { n: n, e: e } => {
            return checkStatementLet(st, n, e);
        },
        AstStatement::Return { e: e } => {
            return checkStatementReturn(st, s, e);
        },
        AstStatement::ValidationStatement { v: v } => {
            return checkStatementValidationStatement(st, v);
        },
        AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: vs } => {
            return checkStatementStructDef(st, n, ps, fs, vs);
        },
        AstStatement::EnumDef { n: n, vs: vs } => {
            return checkStatementEnumDef(st, s, n, vs);
        },
        AstStatement::Block { xs: xs } => {
            return checkStatementBlock(st, xs);
        },
        AstStatement::If { e: e, a: a, b: b } => {
            return checkStatementIf(st, e, a, b);
        },
        AstStatement::While { e: e, vs: vs, t: t, xs: xs } => {
            return checkStatementWhile(st, e, vs, t, xs);
        },
        AstStatement::AxiomDef { n: n, ps: ps, ins: ins, outs: outs } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::ProofDef { n: n, ps: ps, ins: ins, outs: outs, body: body } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::Mark { line: line, col: col } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::Dissolve { n: n } => {
            name = nameText(&st.nodes, n);
            st = lookupVar(st, &name);
            return St { nid: s, te: TE { node: s, types: [] }, ..st };
        },
        AstStatement::CopyDef { n: n } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::DropDef { n: n } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::ExternDef { n: n } => { return St { nid: s, te: TE { node: s, types: [] }, ..st }; },
        AstStatement::LinearDef { n: n } => {
            linearName = nameText(&st.nodes, n);
            st = typesChanged(St { linearTypes: st.linearTypes.insert(linearName), ..st });
            return St { nid: s, te: TE { node: s, types: [] }, ..st };
        },
        AstStatement::AssignDeref { a: a, b: b } => { return checkAssignDeref(st, a, b); },
        AstStatement::TraitDef { n: n, ps: ps, fs: fs } => { return fail(st, "Type error: a trait can only be defined at the top of the program"); },
        AstStatement::ImplDef { traitName: tn, args: args, n: n, ty: ty, bs: bs, xs: xs } => { return fail(st, "Type error: an impl can only be written at the top of the program"); },
        AstStatement::BoundedDef { bs: bs, s: inner } => { return fail(st, "Type error: a function with bounds on its types cannot be written in a block"); },
        AstStatement::Instance { n: n, f: f, args: args, ps: ps, sig: sig } => { return fail(st, "Type error: an instance record is written by the elaborator, not by a program"); },
        AstStatement::PackLoop { i: i, a: a, p: p, lo: lo, hi: hi, take: take, xs: xs } => { return checkStatementPackLoop(st, i, a, p, lo, hi, take, xs); },
    };
    return st;
};

fn checkStatementAssign(st: St, top: Bool, n: Int, e: Int) -> St ~ {
    name = nameText(&st.nodes, n);
    v = functionValue(st, e);
    if v >= 0 { return checkFunctionDef(st, top, name, n, v); };
    st = notSize(st, &name);
    st = inferExpr(st, e);
    if st.status != 0 { return st; };
    inferred = clone(st.te);
    texpr = clone(inferred);
    existing = scopeLookup(st, &name);
    if existing >= 0 {
        st = coerce(st, existing, inferred);
        texpr = clone(st.te);
    };
    st = assignVar(st, &name, head(&texpr.types));
    st = recordAlias(st, &name, head(&texpr.types), texpr.node);
    st = recordOrigins(st, &name, head(&texpr.types), texpr.node);
    if st.status != 0 { return st; };
    st = emit(st, AstNode::Statement { value: AstStatement::Assign { n: n, e: texpr.node } });
    return St { te: TE { node: st.nid, types: texpr.types }, ..st };
};

fn checkStatementLet(st: St, n: Int, e: Int) -> St ~ {
    name = nameText(&st.nodes, n);
    st = notSize(st, &name);
    st = inferExpr(st, e);
    if st.status != 0 { return st; };
    texpr = clone(st.te);
    st = recordAlias(st, &name, head(&texpr.types), texpr.node);
    st = recordOrigins(st, &name, head(&texpr.types), texpr.node);
    if st.status != 0 { return st; };
    st = bindInner(st, &name, head(&texpr.types));
    st = emit(st, AstNode::Statement { value: AstStatement::Let { n: n, e: texpr.node } });
    return St { te: TE { node: st.nid, types: texpr.types }, ..st };
};

fn checkStatementReturn(st: St, s: Int, e: Int) -> St ~ {
    st = inferExpr(st, e);
    if st.status != 0 { return st; };
    inferred = clone(st.te);
    if st.ret >= 0 {
        rty = st.ret;
        // (a reference parameter returned is the reference to the caller's place)
        rk = kindOf(st, rty);
        if (rk = 10 || rk = 11) && isVar(st, e) {
            v = varName(st, e);
            st = zonk(st, head(&inferred.types));
            tz = st.ty;
            tk = kindOf(st, tz);
            if tk = 10 || tk = 11 || indexIn(&st.readOnly, &v) >= 0 || indexIn(&st.mutParams, &v) >= 0 {
                st = expect(st, "returned value", argAt(st, rty, 0), tz);
                inferred = withType(&inferred, rty);
            };
        };
        st = coerce(st, rty, inferred);
        if st.status != 0 { return st; };
        texpr = clone(st.te);
        st = expect(st, "returned value", rty, head(&texpr.types));
        if st.status != 0 { return st; };
        if size(st.resultFrom) > 0 {
            st = exprRefOrigins(st, e);
            if st.status != 0 { return st; };
            allFrom = size(st.names) > 0;
            for o in &st.names { if indexIn(&st.resultFrom, o) < 0 { allFrom = false; }; };
            if !allFrom {
                return typeError(st, catStrings(catStrings("the value returned is not a reference from ", joinWith(&st.resultFrom, ", ")), ", which the signature names: return a reference to a place of one of them"));
            };
        };
        st = emit(st, AstNode::Statement { value: AstStatement::Return { e: texpr.node } });
        return St { te: TE { node: st.nid, types: texpr.types }, ..st };
    };
    t = head(&inferred.types);
    k = kindOf(st, t);
    if k = 10 || k = 11 { return fail(st, "Type error: the program cannot return a reference: a reference is from a place in the program, and no place outlives it"); };
    if st.programReturn < 0 { st = St { programReturn: t, ..st }; } else { st = expect(st, "returned value of the program", st.programReturn, t); };
    if st.status != 0 { return st; };
    st = emit(st, AstNode::Statement { value: AstStatement::Return { e: inferred.node } });
    return St { te: TE { node: st.nid, types: inferred.types }, ..st };
};

fn checkStatementValidationStatement(st: St, v: Int) -> St ~ {
    st = checkValidation(st, v);
    if st.status != 0 { return st; };
    st = emit(st, AstNode::Statement { value: AstStatement::ValidationStatement { v: st.nid } });
    return St { te: TE { node: st.nid, types: [] }, ..st };
};

fn checkStatementStructDef(st: St, n: Int, ps: Int, fs: Int, vs: Int) -> St ~ {
    name = nameText(&st.nodes, n);
    params = namesText(&st.nodes, ps);
    fieldNamesList = fieldNames(&st.nodes, fs);
    tycs = fieldCodecTypes(&st.nodes, fs); st = fromCodecs(st, &tycs);
    fieldTys = clone(st.te.types);
    if size(params) > 0 {
        st = declareGeneric(st, &name, &params, &fieldNamesList, &fieldTys);
        sizes = [];
        types = [];
        for p in &params { if isTypeName(p) { types = push(types, clone(p)); } else { sizes = push(sizes, clone(p)); }; };
        outerSizes = clone(st.sizeScope);
        outerTypes = clone(st.typeScope);
        st = St { sizeScope: sizes, typeScope: types, ..st };
        st = checkInvariant(st, &fieldNamesList, &fieldTys, vs);
        st = St { sizeScope: outerSizes, typeScope: outerTypes, ..st };
    } else {
        st = declareTypeWith(st, &name, push([], clone(name)));
        for t in &fieldTys { st = checkFieldType(st, t); };
        ctorNames = push([], clone(name));
        ctorFieldNames = push([], clone(fieldNamesList));
        ctorFieldTypes = push([], clone(fieldTys));
        st = registerCtors(st, &name, &ctorNames, &ctorFieldNames, &ctorFieldTypes);
        variantTypes = push([], clone(fieldTys));
        st = checkFinite(st, &name, &variantTypes);
        st = checkInvariant(st, &fieldNamesList, &fieldTys, vs);
    };
    if st.status != 0 { return st; };
    st = emit(st, AstNode::Statement { value: AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: st.nid } });
    return St { te: TE { node: st.nid, types: [] }, ..st };
};

fn checkStatementEnumDef(st: St, s: Int, n: Int, vs: Int) -> St ~ {
    name = nameText(&st.nodes, n);
    variantNames = [];
    variantFieldNames = [];
    variantFieldTypes = [];
    for v in listItems(&st.nodes, vs) {
        vn = nodeIn(&st.nodes, v);
        if vn is AstNode::Variant {
            variant = (vn as AstNode::Variant).value;
            variantNames = push(variantNames, nameText(&st.nodes, variant.n));
            variantFieldNames = push(variantFieldNames, fieldNames(&st.nodes, variant.fs));
            tycs = fieldCodecTypes(&st.nodes, variant.fs); st = fromCodecs(st, &tycs);
            variantFieldTypes = push(variantFieldTypes, clone(st.te.types));
        };
    };
    st = declareTypeWith(st, &name, clone(variantNames));
    for tys in &variantFieldTypes { for t in tys { st = checkFieldType(st, t); }; };
    st = registerCtors(st, &name, &variantNames, &variantFieldNames, &variantFieldTypes);
    st = checkFinite(st, &name, &variantFieldTypes);
    if st.status != 0 { return st; };
    return St { nid: s, te: TE { node: s, types: [] }, ..st };
};

fn checkStatementBlock(st: St, xs: Int) -> St ~ {
    st = pushScope(st);
    blockStmts = listItems(&st.nodes, xs);
    st = checkStatements(st, false, &blockStmts);
    st = popScope(st);
    if st.status != 0 { return st; };
    types = clone(st.te.types);
    st = emit(st, AstNode::Statement { value: AstStatement::Block { xs: st.te.node } });
    return St { te: TE { node: st.nid, types: types }, ..st };
};

fn checkStatementIf(st: St, e: Int, a: Int, b: Int) -> St ~ {
    st = inferExpr(st, e);
    if st.status != 0 { return st; };
    cond = clone(st.te);
    st = simpleTy(st, 2);
    st = expect(st, "condition of if", st.ty, head(&cond.types));
    st = pushScope(st);
    thenStmts = listItems(&st.nodes, a);
    st = checkStatements(st, false, &thenStmts);
    st = popScope(st);
    if st.status != 0 { return st; };
    thenPart = clone(st.te);
    st = pushScope(st);
    elseStmts = listItems(&st.nodes, b);
    st = checkStatements(st, false, &elseStmts);
    st = popScope(st);
    if st.status != 0 { return st; };
    elsePart = clone(st.te);
    st = emit(st, AstNode::Statement { value: AstStatement::If { e: cond.node, a: thenPart.node, b: elsePart.node } });
    types = clone(cond.types);
    for t in &thenPart.types { types = push(types, t); };
    for t in &elsePart.types { types = push(types, t); };
    return St { te: TE { node: st.nid, types: types }, ..st };
};

fn checkStatementWhile(st: St, e: Int, vs: Int, t: Int, xs: Int) -> St ~ {
    st = inferExpr(st, e);
    if st.status != 0 { return st; };
    cond = clone(st.te);
    st = simpleTy(st, 2);
    st = expect(st, "condition of while", st.ty, head(&cond.types));
    // (what the invariant defines is only its own)
    beforeInvariant = clone(st.scopes);
    st = checkValidations(st, vs);
    if st.status != 0 { return st; };
    invariant = st.nid;
    st = St { scopes: beforeInvariant, ..st };
    st = resolveTermination(st, t);
    if st.status != 0 { return st; };
    term = st.nid;
    st = pushScope(st);
    loopStmts = listItems(&st.nodes, xs);
    st = checkStatements(st, false, &loopStmts);
    st = popScope(st);
    if st.status != 0 { return st; };
    body = clone(st.te);
    st = emit(st, AstNode::Statement { value: AstStatement::While { e: cond.node, vs: invariant, t: term, xs: body.node } });
    types = clone(cond.types);
    for ty in &body.types { types = push(types, ty); };
    return St { te: TE { node: st.nid, types: types }, ..st };
};

// The value of a function definition, x = fn ...: the VFunct record with a native body (or -1)
fn functionValue(st: &St, e: Int) -> Int ~ {
    ex = exprOf(st, e);
    if !(ex is AstExpression::Val) { return 0 - 1; };
    v = (ex as AstExpression::Val).v;
    node = nodeIn(&st.nodes, v);
    if !(node is AstNode::Value) { return 0 - 1; };
    value = (node as AstNode::Value).value;
    if !(value is AstValue::VFunct) { return 0 - 1; };
    body = nodeIn(&st.nodes, (value as AstValue::VFunct).body);
    if body is AstNode::Body && (body as AstNode::Body).value is AstBody::NativeFunct { return v; };
    return 0 - 1;
};

// A size, a borrowed parameter and an update parameter are not assigned (notSize)
fn notSize(st: St, name: &String) -> St ~ {
    if st.status != 0 { return st; };
    if indexIn(&st.readOnly, name) >= 0 {
        return typeError(st, catStrings(clone(name), " is borrowed (&), so it is only read: a copy of it can be assigned to another variable"));
    };
    if indexIn(&st.mutParams, name) >= 0 {
        return typeError(st, catStrings(catStrings(catStrings(clone(name), " is borrowed (&mut), so it is assigned through it, as in *"), clone(name)), " = value;: the parameter itself cannot be assigned"));
    };
    if indexIn(&st.sizeScope, name) >= 0 {
        return typeError(st, catStrings(clone(name), " is a size parameter of the function, which a call gives, and it cannot be assigned"));
    };
    return st;
};

// x = fn ...: the function is visible to itself and, at the top, to what comes after it (checkStatement, Assign of a VFunct)
fn checkFunctionDef(st: St, top: Bool, name: String, n: Int, v: Int) -> St ~ {
    value = nativeFn(&st.nodes, v);
    st = fnSigOf(st, value.ps, value.sig);
    return checkFunctionWith(st, top, name, n, v, clone(st.fnSig), false);
};

// A function definition with its signature as types (rewritten: they are not the ones its record writes, as an impl's Self
// replaced), giving back the definition with its contracts, termination and body checked (checkStatement)
fn checkFunctionWith(st: St, top: Bool, name: String, n: Int, v: Int, fs: FnSig, rewritten: Bool) -> St ~ {
    if HashMap::contains(&st.templates, &name) { return typeError(st, catStrings(clone(name), " is already defined")); };
    value = nativeFn(&st.nodes, v);
    sig = signatureOf(&st.nodes, value.sig);
    st = fnTypeOf(st, &fs);
    fnT = st.ty;
    if top { st = St { fns: st.fns.insert(clone(name), fnT), ..st }; };
    st = assignVar(st, &name, fnT);
    if st.status != 0 { return st; };
    // (a function nested in a body checked against its bounds is checked as any function is: those bounds are not its)
    outerDefChecking = st.defChecking;
    st = St { defChecking: false, ..st };
    st = checkFunction(st, &name, clone(fs), value.ins, value.outs, value.term, value.stmts);
    if st.status != 0 { return st; };
    st = St { defChecking: outerDefChecking, ..st };
    // (st.outs: the requires, the ensures, the termination and the body)
    parts = clone(st.outs);
    bodyTypes = clone(st.te.types);
    from = clone(st.names);
    if size(from) > 0 { st = putRefResult(st, clone(name), clone(fs.params), clone(from)); };
    sigNode = value.sig;
    if rewritten || from != fs.froms {
        tsNode = sig.ts;
        retNode = sig.ret;
        if rewritten {
            st = emitTypes(st, &fs.ptys);
            tsNode = st.nid;
            st = emitType(st, fs.rty);
            retNode = st.nid;
        };
        st = emitNames(st, &from);
        st = emit(st, AstNode::Signature { value: AstSignature { ts: tsNode, ret: retNode, ss: sig.ss, ps: sig.ps, ws: sig.ws, fs: st.nid } });
        sigNode = st.nid;
    };
    st = emit(st, AstNode::Body { value: AstBody::NativeFunct { sig: sigNode, term: nth(&parts, 2), stmts: nth(&parts, 3) } });
    st = emit(st, AstNode::Value { value: AstValue::VFunct { ps: value.ps, ins: nth(&parts, 0), outs: nth(&parts, 1), body: st.nid, exports: value.exports } });
    st = emitVal(st, st.nid);
    st = emit(st, AstNode::Statement { value: AstStatement::Assign { n: n, e: st.nid } });
    return St { te: TE { node: st.nid, types: bodyTypes }, sigNode: sigNode, ..st };
};

// The type of a function of a signature
fn fnTypeOf(st: St, fs: &FnSig) -> St ~ {
    st = fnTy(st, clone(fs.ptys), fs.rty);
    if size(fs.sizes) = 0 && size(fs.types) = 0 { return st; };
    return addTy(st, Ty { kind: 13, name: "", args: push([], st.ty), n: 0, flag: false, sizes: clone(fs.sizes), types: clone(fs.types) });
};

// The parameters and signature of a function value, with its types made in the arena
fn fnSigOf(st: St, ps: Int, sigNode: Int) -> St ~ {
    sig = signatureOf(&st.nodes, sigNode);
    tycs = codecTypesAt(&st.nodes, sig.ts); st = fromCodecs(st, &tycs);
    ptys = clone(st.te.types);
    tyc = codecTypeAt(&st.nodes, sig.ret); st = fromCodec(st, &tyc);
    fs = FnSig { params: namesText(&st.nodes, ps), ptys: ptys, rty: st.ty, sizes: namesText(&st.nodes, sig.ss), types: namesText(&st.nodes, sig.ps), writes: namesText(&st.nodes, sig.ws), froms: namesText(&st.nodes, sig.fs) };
    return St { fnSig: fs, ..st };
};

// The parameters a reference result is from (refResultFrom): st.names
fn refResultFrom(st: St, name: &String, params: &List<String>, ptys: &List<Int>, rty: Int, froms: &List<String>) -> St ~ {
    rk = kindOf(st, rty);
    isRefResult = false;
    if rk = 10 || rk = 11 {
        st = checkType(st, argAt(st, rty, 0));
        isRefResult = true;
    } else {
        st = holdsRef(st, rty);
        isRefResult = st.ok;
    };
    if st.status != 0 { return st; };
    from = [];
    if !isRefResult {
        if size(froms) > 0 {
            return typeError(st, catStrings(catStrings(catStrings(clone(name), " is written from "), joinWith(froms, ", ")), ", but its result is not a reference"));
        };
    } else {
        if size(froms) > 0 {
            for p in froms {
                at = indexIn(params, p);
                ok = false;
                if at >= 0 && at < size(ptys) { pk = kindOf(st, get(ptys, at)); ok = pk = 10 || pk = 11; };
                if !ok { return typeError(st, catStrings(catStrings(catStrings(clone(name), " is written from "), clone(p)), ", which is not a reference parameter of it")); };
            };
            from = clone(froms);
        } else {
            refParams = [];
            i = 0;
            while i < size(params) && i < size(ptys) [{ affirm i >= 0; }] ~ {
                pk = kindOf(st, get(ptys, i));
                if pk = 10 || pk = 11 { refParams = push(refParams, clone(get(params, i))); };
                i = i + 1;
            };
            if size(refParams) = 0 {
                return typeError(st, catStrings(clone(name), " returns a reference, but no parameter of it is a reference for the result to be from: write the result as -> &T from <parameter>"));
            };
            if size(refParams) > 1 {
                return typeError(st, catStrings(clone(name), " returns a reference and has more than one reference parameter: say which the result is from, as in -> &T from (a, b)"));
            };
            from = refParams;
        };
    };
    return St { names: from, ..st };
};

// The body sees its parameters and the functions known at the top, itself among them (checkFunction)
fn checkFunction(st: St, name: &String, fs: FnSig, ins: Int, outs: Int, term: Int, body: Int) -> St ~ {
    params = clone(fs.params);
    sizes = clone(fs.sizes);
    types = clone(fs.types);
    writes = clone(fs.writes);
    froms = clone(fs.froms);
    ptys = clone(fs.ptys);
    rty = fs.rty;
    outerSizes = clone(st.sizeScope);
    outerTypes = clone(st.typeScope);
    outerCurrent = clone(st.current);
    st = St { sizeScope: clone(sizes), typeScope: clone(types), current: clone(name), ..st };
    distinct = true;
    i = 0;
    while i < size(sizes) [{ affirm i >= 0; }] shrinks size(sizes) - i {
        j = 0;
        while j < size(sizes) [{ affirm j >= 0; }] shrinks size(sizes) - j {
            if i != j && get(sizes, i) = get(sizes, j) { distinct = false; };
            j = j + 1;
        };
        k = 0;
        while k < size(params) - size(sizes) && k < size(params) [{ affirm k >= 0; }] shrinks size(params) - k {
            if get(params, k) = get(sizes, i) { distinct = false; };
            k = k + 1;
        };
        i = i + 1;
    };
    if !distinct { return typeError(st, catStrings(catStrings("function ", clone(name)), " names a size twice, or the same as a parameter")); };
    st = refResultFrom(st, name, &params, &ptys, rty, &froms);
    if st.status != 0 { return st; };
    from = clone(st.names);
    rk = kindOf(st, rty);
    for p in &ptys { st = checkType(st, p); };
    if rk = 10 { st = checkType(st, argAt(st, rty, 0)); } else { st = checkType(st, rty); };
    if st.status != 0 { return st; };
    if size(params) != size(ptys) {
        return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings("function ", clone(name)), " has "), intText(size(params))), " parameters but "), catStrings(intText(size(ptys)), " types")));
    };
    readOnly = [];
    mutParams = [];
    i = 0;
    while i < size(params) && i < size(ptys) [{ affirm i >= 0; }] ~ {
        pk = kindOf(st, get(ptys, i));
        if pk = 10 { readOnly = push(readOnly, clone(get(params, i))); };
        if pk = 11 { mutParams = push(mutParams, clone(get(params, i))); };
        i = i + 1;
    };
    // (the pack of a variadic function is its last parameter whose type is a pack of types: a function nested in its body has
    // its own, or none)
    outerPack = clone(st.pack);
    outerPackType = clone(st.packType);
    outerPackLent = st.packLent;
    outerPackIndexNames = clone(st.packIndexNames);
    outerPackIndexTypes = clone(st.packIndexTypes);
    outerPackElements = clone(st.packElements);
    outerPackElementTexts = clone(st.packElementTexts);
    packName = "";
    packType = "";
    packLent = false;
    i = 0;
    while i < size(params) && i < size(ptys) [{ affirm i >= 0; }] ~ {
        px = tyAt(st, get(ptys, i));
        lent = false;
        if px.kind = 10 { px = tyAt(st, nth(&px.args, 0)); lent = true; };
        if px.kind = 12 && isPackTypeName(&px.name) { packName = clone(get(params, i)); packType = clone(px.name); packLent = lent; };
        i = i + 1;
    };
    st = St { pack: packName, packType: packType, packLent: packLent, packIndexNames: [], packIndexTypes: [], packElements: [], packElementTexts: [], ..st };
    outerReadOnly = clone(st.readOnly);
    outerMut = clone(st.mutParams);
    outerWrites = clone(st.writes);
    outerAliasNames = clone(st.aliasNames);
    outerAliasPlaces = clone(st.aliasPlaces);
    outerResultFrom = clone(st.resultFrom);
    outerParams = clone(st.params);
    outerOriginNames = clone(st.originNames);
    outerOriginRoots = clone(st.originRoots);
    st = St { readOnly: readOnly, mutParams: clone(mutParams), writes: clone(writes), aliasNames: [], aliasPlaces: [], resultFrom: clone(from), params: clone(params), originNames: [], originRoots: [], ..st };
    // (writes(...) names update parameters, whole or by a field)
    for w in &writes {
        root = clone(w);
        field = "";
        dot = indexOfByte(w, 46);
        if dot >= 0 && dot < size(w.bytes) { root = w.slice(0, dot); field = w.slice(dot + 1, size(w.bytes)); };
        at = indexIn(&params, &root);
        if at < 0 || at >= size(ptys) || kindOf(st, get(ptys, at)) != 11 {
            return typeError(st, catStrings(catStrings(catStrings(catStrings("writes(", clone(w)), ") in "), clone(name)), " does not name an update parameter (&mut T) of the function"));
        };
        if dot >= 0 {
            st = readField(st, "", &field, argAt(st, get(ptys, at), 0));
            if st.status != 0 { return st; };
            st = zonk(st, st.ty);
        };
    };
    outerRet = st.ret;
    outerScopes = clone(st.scopes);
    paramScope = oneScope();
    i = 0;
    while i < size(params) && i < size(ptys) [{ affirm i >= 0; }] ~ {
        paramScope = bindIn(paramScope, &get(params, i), unrefOf(st, get(ptys, i)));
        i = i + 1;
    };
    st = St { ret: rty, scopes: clone(paramScope), ..st };
    st = checkValidations(st, ins);
    if st.status != 0 { return st; };
    insNode = st.nid;
    st = resolveTermination(st, term);
    if st.status != 0 { return st; };
    termNode = st.nid;
    // (the ensures see return and the requires' defines, in the parameters' scope)
    i = 0;
    while i < size(params) && i < size(ptys) [{ affirm i >= 0; }] ~ {
        if kindOf(st, get(ptys, i)) = 11 {
            oldName = catStrings("$old ", get(params, i));
            st = bindInner(st, &oldName, unrefOf(st, get(ptys, i)));
        };
        i = i + 1;
    };
    st = bindInner(st, "return", rty);
    st = rewriteOldStatements(st, outs);
    outsOld = st.nid;
    st = checkValidations(st, outsOld);
    if st.status != 0 { return st; };
    outsNode = st.nid;
    st = St { scopes: paramScope, ..st };
    st = pushScope(st);
    bodyStmts = listItems(&st.nodes, body);
    st = checkStatements(st, false, &bodyStmts);
    if st.status != 0 { return st; };
    bodyTE = clone(st.te);
    st = St { sizeScope: outerSizes, typeScope: outerTypes, current: outerCurrent, ret: outerRet, scopes: outerScopes, readOnly: outerReadOnly, mutParams: outerMut, writes: outerWrites, aliasNames: outerAliasNames, aliasPlaces: outerAliasPlaces, resultFrom: outerResultFrom, params: outerParams, originNames: outerOriginNames, originRoots: outerOriginRoots, pack: outerPack, packType: outerPackType, packLent: outerPackLent, packIndexNames: outerPackIndexNames, packIndexTypes: outerPackIndexTypes, packElements: outerPackElements, packElementTexts: outerPackElementTexts, ..st };
    return St { outs: push(push(push(push([], insNode), outsNode), termNode), bodyTE.node), te: bodyTE, names: from, ..st };
};

// What shrinks is an Int, which counts down to 0, or a struct or enum value, which loses a field at a time (resolveTermination)
fn resolveTermination(st: St, t: Int) -> St ~ {
    node = nodeIn(&st.nodes, t);
    if !(node is AstNode::OptTermination) { return St { nid: t, ..st }; };
    ot = (node as AstNode::OptTermination).value;
    if !(ot is AstOptTermination::SomeTermination) { return St { nid: t, ..st }; };
    termNode = nodeIn(&st.nodes, (ot as AstOptTermination::SomeTermination).t);
    if !(termNode is AstNode::Termination) { return St { nid: t, ..st }; };
    term = (termNode as AstNode::Termination).value;
    if !(term is AstTermination::Shrinks) { return St { nid: t, ..st }; };
    variant = (term as AstTermination::Shrinks).e;
    st = inferExpr(st, variant);
    if st.status != 0 { return st; };
    st = derefExpr(st, clone(st.te));
    if st.status != 0 { return st; };
    v0 = clone(st.te);
    st = zonk(st, head(&v0.types));
    ty = st.ty;
    k = kindOf(st, ty);
    if k = 0 {
        st = emit(st, AstNode::Termination { value: AstTermination::Counting { e: v0.node } });
    } else {
        if k = 4 || k = 5 {
            st = emit(st, AstNode::Termination { value: AstTermination::Parts { e: v0.node } });
        } else {
            return typeError(st, catStrings("shrinks needs an Int, an enum or a struct, got ", render(st, ty)));
        };
    };
    st = emit(st, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: st.nid } });
    return st;
};

fn checkValidations(st: St, vs: Int) -> St ~ {
    out = [];
    for v in listItems(&st.nodes, vs) {
        st = checkValidation(st, v);
        if st.status != 0 { return st; };
        out = push(out, st.nid);
    };
    return emitValidations(st, &out);
};

// The invariant of a struct is written with the names of its fields (checkInvariant); st.nid the checked invariant
fn checkInvariant(st: St, names: &List<String>, types: &List<Int>, vs: Int) -> St ~ {
    if size(listItems(&st.nodes, vs)) = 0 { return St { nid: vs, ..st }; };
    outerScopes = clone(st.scopes);
    scope = oneScope();
    i = 0;
    while i < size(names) && i < size(types) [{ affirm i >= 0; }] ~ {
        scope = bindIn(scope, &get(names, i), get(types, i));
        i = i + 1;
    };
    st = St { scopes: scope, ..st };
    st = checkValidations(st, vs);
    return St { scopes: outerScopes, ..st };
};

fn validationOf(st: &St, v: Int) -> AstValidation ~ {
    node = nodeIn(&st.nodes, v);
    if node is AstNode::Validation { return clone((node as AstNode::Validation).value); };
    return AstValidation::Assume { p: 0 - 1 };
};

// checkValidation: st.nid the checked validation statement
fn checkValidation(st: St, v: Int) -> St ~ {
    scrutinee = validationOf(st, v);
    match scrutinee {
        AstValidation::ProofAssert { p: p } => {
            st = inferProof(st, p);
            if st.status != 0 { return st; };
            checked = st.nid;
            t = st.ty;
            st = simpleTy(st, 2);
            st = expect(st, "affirmed proof", st.ty, t);
            st = emit(st, AstNode::Validation { value: AstValidation::ProofAssert { p: checked } });
            return st;
        },
        AstValidation::Assume { p: p } => {
            st = inferProof(st, p);
            if st.status != 0 { return st; };
            checked = st.nid;
            t = st.ty;
            st = simpleTy(st, 2);
            st = expect(st, "assumed proof", st.ty, t);
            st = emit(st, AstNode::Validation { value: AstValidation::Assume { p: checked } });
            return st;
        },
        AstValidation::AssignProofVar { n: n, e: e } => {
            name = nameText(&st.nodes, n);
            outer = st.inGhost;
            st = St { inGhost: true, ..st };
            st = inferExpr(st, e);
            st = St { inGhost: outer, ..st };
            if st.status != 0 { return st; };
            texpr = clone(st.te);
            st = assignVar(st, &name, head(&texpr.types));
            st = emit(st, AstNode::Validation { value: AstValidation::AssignProofVar { n: n, e: texpr.node } });
            return st;
        },
        AstValidation::Rewrite { r: r } => {
            st = checkRule(st, r);
            if st.status != 0 { return st; };
            st = emit(st, AstNode::Validation { value: AstValidation::Rewrite { r: st.nid } });
            return st;
        },
    };
    return st;
};

fn checkRule(st: St, r: Int) -> St ~ {
    node = nodeIn(&st.nodes, r);
    if !(node is AstNode::Rule) { return St { nid: r, ..st }; };
    scrutinee = (node as AstNode::Rule).value;
    match scrutinee {
        AstRule::Refl { p: p } => { st = inferProof(st, p); return emit(st, AstNode::Rule { value: AstRule::Refl { p: st.nid } }); },
        AstRule::Eval { n: n } => { termName = nameText(&st.nodes, n); st = lookupVar(st, &termName); return St { nid: r, ..st }; },
        AstRule::EvalAll => { return St { nid: r, ..st }; },
        AstRule::CheckGtZero { p: p } => { st = inferProof(st, p); return emit(st, AstNode::Rule { value: AstRule::CheckGtZero { p: st.nid } }); },
        AstRule::CheckRel { p: p } => { st = inferProof(st, p); return emit(st, AstNode::Rule { value: AstRule::CheckRel { p: st.nid } }); },
        AstRule::UserRewrite { n: n, xs: xs } => {
            out = [];
            for p in listItems(&st.nodes, xs) {
                st = inferProof(st, p);
                if st.status != 0 { return st; };
                out = push(out, st.nid);
            };
            st = emitProofs(st, &out);
            return emit(st, AstNode::Rule { value: AstRule::UserRewrite { n: n, xs: st.nid } });
        },
    };
    return st;
};

// A struct with sizes and types (declareGeneric)
fn declareGeneric(st: St, name: &String, params: &List<String>, names: &List<String>, types: &List<Int>) -> St ~ {
    if st.status != 0 { return st; };
    predeclared = HashSet::contains(&st.predeclared, name);
    if !predeclared && (HashMap::contains(&st.types, name) || HashSet::contains(&st.traits, name) || HashMap::contains(&st.generics, name)) {
        return fail(st, catStrings("Type already defined: ", clone(name)));
    };
    distinct = true;
    i = 0;
    while i < size(params) [{ affirm i >= 0; }] shrinks size(params) - i {
        j = i + 1;
        while j < size(params) [{ affirm j > i; }] shrinks size(params) - j {
            if get(params, i) = get(params, j) { distinct = false; };
            j = j + 1;
        };
        i = i + 1;
    };
    if predeclared {
        st = St { generics: st.generics.insert(clone(name), Generic { params: clone(params), names: clone(names), types: clone(types) }), predeclared: st.predeclared.remove(name), ..st };
        if !distinct { return typeError(st, catStrings(clone(name), " names a parameter twice")); };
    } else {
        if !distinct { return typeError(st, catStrings(clone(name), " names a parameter twice")); };
        st = St { generics: st.generics.insert(clone(name), Generic { params: clone(params), names: clone(names), types: clone(types) }), ..st };
    };
    for t in types {
        if selfExpands(st, name, t) {
            return typeError(st, catStrings(clone(name), " uses itself with a type made of its own parameters, which would make a struct for each depth (Node<List<T>> inside Node<T>): a struct that holds itself gives its own parameters as they are"));
        };
    };
    sizes = [];
    typeNames = [];
    for p in params { if isTypeName(p) { typeNames = push(typeNames, clone(p)); } else { sizes = push(sizes, clone(p)); }; };
    outerSizes = clone(st.sizeScope);
    outerTypes = clone(st.typeScope);
    st = St { sizeScope: sizes, typeScope: typeNames, ..st };
    for t in types { st = checkFieldType(st, t); };
    st = St { sizeScope: outerSizes, typeScope: outerTypes, ..st };
    variantTypes = push([], clone(types));
    return checkFinite(st, name, &variantTypes);
};

fn selfExpands(st: &St, name: &String, t: Int) -> Bool ~ {
    x = tyAt(st, t);
    // (a list and a Box are looked into before their names are, as Haskell's TList and TBox patterns are)
    if isListTy(st, t) || isBoxTy(st, t) { return selfExpands(st, name, nth(&x.args, 0)); };
    if x.kind = 4 {
        if x.name = clone(name) {
            for a in x.args {
                if !isSize(st, a) && kindOf(st, a) != 12 && mentionsParameter(st, a) { return true; };
            };
        };
        for a in x.args { if !isSize(st, a) && selfExpands(st, name, a) { return true; }; };
        return false;
    };
    if x.kind = 6 || (x.kind >= 7 && x.kind <= 10) { return selfExpands(st, name, nth(&x.args, 0)); };
    if x.kind = 14 { for a in x.args { if selfExpands(st, name, a) { return true; }; }; };
    return false;
};

fn mentionsParameter(st: &St, t: Int) -> Bool ~ {
    x = tyAt(st, t);
    if x.kind = 12 { return true; };
    if x.kind = 6 { return mentionsParameter(st, nth(&x.args, 0)) || kindOf(st, nth(&x.args, 1)) = 22; };
    if x.kind = 4 {
        for a in x.args {
            if isSize(st, a) { if kindOf(st, a) = 22 { return true; }; } else { if mentionsParameter(st, a) { return true; }; };
        };
        return false;
    };
    if x.kind = 14 || (x.kind >= 7 && x.kind <= 11) { for a in x.args { if mentionsParameter(st, a) { return true; }; }; };
    return false;
};

fn indexOfByte(text: &String, b: Int) -> Int ~ {
    i = 0;
    for c in &text.bytes {
        if toInt(c) = b { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

// *r = value; and (*r).field = value;: the place must be through an update reference, and the value is
// evaluated before the replacement, so its types come first (checkStatement, AssignDeref)
fn checkAssignDeref(st: St, lhs: Int, value: Int) -> St ~ {
    st = inferExpr(st, lhs);
    if st.status != 0 { return st; };
    lhsT = clone(st.te);
    targetTy = head(&lhsT.types);
    refExpr = derefRoot(st, lhs);
    if refExpr < 0 { return fail(st, "Type error: assignment through a reference is written *r = value; or (*r).field = value;"); };
    mutable = false;
    refName = varName(st, refExpr);
    if isVar(st, refExpr) && indexIn(&st.mutParams, &refName) >= 0 {
        mutable = true;
    } else {
        st = inferExpr(st, refExpr);
        if st.status != 0 { return st; };
        st = zonk(st, teHead(&st.te));
        mutable = kindOf(st, st.ty) = 11;
    };
    if !mutable { return fail(st, "Type error: assignment is through a read reference (&T), which does not allow updating what it is to: borrow the place with &mut"); };
    steps = placeSteps(st, lhs);
    if steps.ok && size(st.writes) > 0 {
        place = resolveRefPlace(st, clone(steps.root), clone(steps.steps));
        if indexIn(&st.mutParams, &place.root) >= 0 && !withinWrites(&st.writes, &place) {
            return typeError(st, catStrings(catStrings(catStrings("this assignment changes ", writesTarget(&place)), ", which the writes clause of the function does not allow "), writesText(st)));
        };
    };
    st = inferExpr(st, value);
    if st.status != 0 { return st; };
    inferred = clone(st.te);
    st = coerce(st, targetTy, inferred);
    if st.status != 0 { return st; };
    exprT = clone(st.te);
    st = emit(st, AstNode::Statement { value: AstStatement::AssignDeref { a: lhsT.node, b: exprT.node } });
    types = clone(exprT.types);
    for t in &lhsT.types { types = push(types, t); };
    return St { te: TE { node: st.nid, types: types }, ..st };
};

// A loop over the pack of the enclosing variadic function, which each copy unrolls: its bounds are fixed in each copy, its
// index is an Int that indexes the pack, and its element has a type of its own, which get(args, i) on its index shares
fn checkStatementPackLoop(st: St, i: Int, a: Int, p: Int, lo: Int, hi: Int, take: Bool, xs: Int) -> St ~ {
    packName = nameText(&st.nodes, p);
    if size(st.pack.bytes) = 0 || packName != st.pack { return typeError(st, "a loop over a pack is only written in a function with a pack"); };
    if !packIndexFolds(&st, lo) || !packIndexFolds(&st, hi) {
        return typeError(st, catStrings(catStrings("the bounds of a for loop over ", clone(st.pack)), " are fixed in each copy: numbers, size(args), the index of a for loop over args, and + - * of those"));
    };
    st = inferExpr(st, lo);
    if st.status != 0 { return st; };
    loTE = clone(st.te);
    st = simpleTy(st, 0);
    intTy = st.ty;
    st = expect(st, "the start of a for loop over a pack", intTy, head(&loTE.types));
    st = inferExpr(st, hi);
    if st.status != 0 { return st; };
    hiTE = clone(st.te);
    st = expect(st, "the end of a for loop over a pack", intTy, head(&hiTE.types));
    if st.status != 0 { return st; };
    indexName = nameText(&st.nodes, i);
    elementName = nameText(&st.nodes, a);
    firstElement = st.packCounter;
    // (what a message calls the element: its name, or what the body reads it as when the loop names none)
    elementText = catStrings(catStrings("the element ", clone(elementName)), catStrings(" of the loop over ", clone(st.pack)));
    if elementName.startsWith("$") { elementText = catStrings(catStrings(catStrings("get(", clone(st.pack)), ", "), catStrings(clone(indexName), ")")); };
    st = freshElementType(st, elementText);
    elementTy = st.ty;
    st = assignVar(st, &indexName, intTy);
    if st.status != 0 { return st; };
    outerReadOnly = clone(st.readOnly);
    outerIndexNames = clone(st.packIndexNames);
    outerIndexTypes = clone(st.packIndexTypes);
    st = pushScope(st);
    st = bindInner(st, &elementName, elementTy);
    readOnly = clone(st.readOnly);
    if st.packLent || !take { readOnly = push(readOnly, clone(elementName)); };
    st = St { readOnly: readOnly, packIndexNames: push(st.packIndexNames, clone(indexName)), packIndexTypes: push(st.packIndexTypes, elementTy), ..st };
    loopStmts = listItems(&st.nodes, xs);
    st = checkStatements(st, false, &loopStmts);
    st = popScope(st);
    if st.status != 0 { return st; };
    body = clone(st.te);
    // (each iteration of the copy gives the element, and what the body reads of the pack at its index, a type of its own,
    // so none of those types outlives the iteration)
    kept = 0;
    while kept < size(st.scopes.names) && kept < size(st.scopes.types) [{ affirm kept >= 0; }] ~ {
        if heldElement(&st, get(st.scopes.types, kept), firstElement) {
            readAs = clone(elementName);
            if elementName.startsWith("$") { readAs = catStrings(catStrings(catStrings("get(", clone(st.pack)), ", "), catStrings(clone(indexName), ")")); };
            return typeError(st, catStrings(catStrings(catStrings(catStrings(catStrings(clone(get(st.scopes.names, kept)), " would keep an element of "), clone(st.pack)), catStrings(" after the loop over it, which reads it as ", readAs)), catStrings(catStrings(": an element has a type of its own in each iteration of the loop over ", clone(st.pack)), ", so it cannot be kept after it")), ""));
        };
        kept = kept + 1;
    };
    st = St { readOnly: outerReadOnly, packIndexNames: outerIndexNames, packIndexTypes: outerIndexTypes, ..st };
    st = emitName(st, indexName);
    iNode = st.nid;
    st = emitName(st, elementName);
    aNode = st.nid;
    st = emitName(st, packName);
    pNode = st.nid;
    // (a loop over a lent pack reads its elements, however it is written)
    takes = take && !st.packLent;
    st = emit(st, AstNode::Statement { value: AstStatement::PackLoop { i: iNode, a: aNode, p: pNode, lo: loTE.node, hi: hiTE.node, take: takes, xs: body.node } });
    types = push([], elementTy);
    for t in &loTE.types { types = push(types, t); };
    for t in &hiTE.types { types = push(types, t); };
    for t in &body.types { types = push(types, t); };
    return St { te: TE { node: st.nid, types: types }, ..st };
};

// Whether a type holds the type of an element of the pack made from the counter on (one of a loop over the pack, or of a read
// of the pack in its body)
fn heldElement(st: &St, t: Int, from: Int) -> Bool ~ {
    x = tyAt(st, resolve(st, t));
    if x.kind = 12 {
        prefix = catStrings(clone(st.packType), "@");
        if size(x.name.bytes) > size(prefix.bytes) && x.name.slice(0, size(prefix.bytes)) = prefix {
            digits = x.name.slice(size(prefix.bytes), size(x.name.bytes));
            n = 0;
            for c in &digits.bytes { n = n * 10 + (toInt(c) - 48); };
            return n >= from;
        };
        return false;
    };
    for g in &x.args { if heldElement(st, g, from) { return true; }; };
    return false;
};
