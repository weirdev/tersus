import data::arena::arena { remapNode };
import data::ast::ast { AstBody, AstBuiltin, AstEntry, AstNode, AstProgram, AstScheme, AstValue };
import data::codec::codec { catStrings };
import elaborate::records { codecTypeAt, codecTypesAt, fromCodec, fromCodecs, listItems, nameText, nodeIn };
import elaborate::state { St, Ty, addTy, builtinValueAt, fail, fnTy, freshVar, indexIn, intText, isSize, kindOf, nameOf, notModelled, nth, tyAt, withTy, wordName };

// The key a builtin is known by here: its primitive name, or the kind and arguments of a parameterized one
fn builtinKey(st: &St, b: Int) -> String ~ {
    node = nodeIn(&st.nodes, b);
    if !(node is AstNode::Builtin) { return ""; };
    scrutinee = (node as AstNode::Builtin).value;
    return match scrutinee {
        AstBuiltin::Primitive { name: n } => clone(n),
        AstBuiltin::ToWord { signed: s, bits: bits } => catStrings(catStrings(wordName(s, bits), " "), "ToWord"),
        AstBuiltin::Rel { r: r } => catStrings("Rel ", intText(r)),
        AstBuiltin::Ctor { n: n, args: args, fs: fs } => "Ctor",
        AstBuiltin::FieldBuiltin { owner: o, n: n } => "Field",
        AstBuiltin::Is { n: n } => "Is",
        AstBuiltin::Project { n: n, f: f } => "Project",
        AstBuiltin::Cast { n: n } => "Cast",
    };
};

// The builtin a value is, when it is one: the Builtin record of the BuiltinFunct body of a VFunct value (or -1)
fn builtinOfValue(st: &St, v: Int) -> Int ~ {
    node = nodeIn(&st.nodes, v);
    if !(node is AstNode::Value) { return 0 - 1; };
    value = (node as AstNode::Value).value;
    if !(value is AstValue::VFunct) { return 0 - 1; };
    body = nodeIn(&st.nodes, (value as AstValue::VFunct).body);
    if !(body is AstNode::Body) { return 0 - 1; };
    b = (body as AstNode::Body).value;
    if !(b is AstBody::BuiltinFunct) { return 0 - 1; };
    return (b as AstBody::BuiltinFunct).b;
};

// The builtin table of the request, put into the arena of the program after its own records, with the names a
// program calls each builtin by, its signature scheme and the record of its value
fn loadBuiltins(st: St, table: &AstProgram) -> St ~ {
    base = size(st.nodes);
    shift = [];
    for i in 0..size(table.nodes) { shift = push(shift, base + i); };
    nodes = st.nodes;
    for node in &table.nodes { nodes = push(nodes, remapNode(clone(node), &shift)); };
    st = St { nodes: nodes, ..st };
    for e in listItems(&table.nodes, table.root) {
        entry = nodeIn(&table.nodes, e);
        if entry is AstNode::Entry {
            ev = (entry as AstNode::Entry).value;
            if ev is AstEntry::BuiltinEntry {
                be = ev as AstEntry::BuiltinEntry;
                index = size(st.builtinValues);
                key = builtinKey(st, base + be.b);
                st = St { builtinNames: st.builtinNames.insert(clone(key), index), builtinValues: push(st.builtinValues, base + be.value), builtinKinds: push(st.builtinKinds, clone(key)), ..st };
                st = loadScheme(st, &table.nodes, be.scheme);
                st = St { builtinSchemes: push(st.builtinSchemes, st.ty), ..st };
                for s in listItems(&table.nodes, be.surface) {
                    surface = nodeIn(&table.nodes, s);
                    if surface is AstNode::Entry {
                        sv = (surface as AstNode::Entry).value;
                        if sv is AstEntry::SurfaceEntry {
                            se = sv as AstEntry::SurfaceEntry;
                            name = nameText(&table.nodes, se.n);
                            if se.space = "std" { st = St { stdNames: st.stdNames.insert(clone(name), index), ..st }; };
                            if se.space = "pointer" && !st.pointer.contains(&name) { st = St { pointer: st.pointer.insert(clone(name), index), ..st }; };
                            if se.space = "ghost" && !st.ghostNames.contains(&name) { st = St { ghostNames: st.ghostNames.insert(clone(name), index), ..st }; };
                            if se.space = "method" {
                                if !st.methods.contains(&name) { st = St { methods: st.methods.insert(clone(name), index), ..st }; };
                                if !st.methodOf.contains(index) { st = St { methodOf: st.methodOf.insert(index, clone(name)), ..st }; };
                            };
                        };
                    };
                };
            };
        };
    };
    return st;
};

// A scheme as a type: a function type with parameters for its type variables, a value error (a type of kind -2
// with the message as its name), or dynamic (kind -3)
fn loadScheme(st: St, nodes: &List<AstNode>, id: Int) -> St ~ {
    node = nodeIn(nodes, id);
    if !(node is AstNode::Scheme) { return addTy(st, Ty { kind: 0 - 3, name: "", args: [], n: 0, flag: false, sizes: [], types: [] }); };
    scrutinee = (node as AstNode::Scheme).value;
    return match scrutinee {
        AstScheme::SigFn { ts: ts, ret: ret } => schemeFn(st, nodes, ts, ret),
        AstScheme::SigDynamic => addTy(st, Ty { kind: 0 - 3, name: "", args: [], n: 0, flag: false, sizes: [], types: [] }),
        AstScheme::SigValueError { n: n } => addTy(st, Ty { kind: 0 - 2, name: nameText(nodes, n), args: [], n: 0, flag: false, sizes: [], types: [] }),
    };
};

fn schemeFn(st: St, nodes: &List<AstNode>, ts: Int, ret: Int) -> St ~ {
    tycs = codecTypesAt(nodes, ts); st = fromCodecs(st, &tycs);
    params = clone(st.te.types);
    tyc = codecTypeAt(nodes, ret); st = fromCodec(st, &tyc);
    return fnTy(st, params, st.ty);
};

fn builtinIndex(st: &St, key: &String) -> Int ~ {
    return st.builtinNames.lookup(key, 0 - 1);
};

// The record of the value StdLib.builtinFunct gives for a builtin, in the arena (-1 when the table has none)
fn builtinValueOf(st: &St, key: &String) -> Int ~ {
    i = builtinIndex(st, key);
    if i < 0 || i >= size(st.builtinValues) { return 0 - 1; };
    return builtinValueAt(st, i);
};

// Every occurrence of a type parameter in a type, the result of a function before its parameters (schemeVars
// before its nub)
fn schemeVarsOf(st: &St, t: Int, out: List<String>) -> List<String> ~ {
    x = tyAt(st, t);
    if x.kind = 12 { return push(out, clone(x.name)); };
    if x.kind = 14 {
        out = schemeVarsOf(st, nth(&x.args, size(x.args) - 1), out);
        i = 0;
        while i + 1 < size(x.args) [{ affirm i >= 0; }] ~ {
            out = schemeVarsOf(st, get(x.args, i), out);
            i = i + 1;
        };
        return out;
    };
    if x.kind = 6 { return schemeVarsOf(st, nth(&x.args, 0), out); };
    for a in x.args {
        if !isSize(st, a) { out = schemeVarsOf(st, a, out); };
    };
    return out;
};

// The type with each type parameter named in names made the type at the same place in given (Types.substitute
// for types), and each size parameter in sizeNames the size at its place in sizes
fn substitute(st: St, t: Int, sizeNames: &List<String>, sizes: &List<Int>, names: &List<String>, given: &List<Int>) -> St ~ {
    x = tyAt(st, t);
    if x.kind = 12 {
        i = indexIn(names, &x.name);
        if i >= 0 && i < size(given) { return withTy(st, get(given, i)); };
        return withTy(st, t);
    };
    if x.kind = 22 {
        i = indexIn(sizeNames, &x.name);
        if i >= 0 && i < size(sizes) { return withTy(st, get(sizes, i)); };
        return withTy(st, t);
    };
    if size(x.args) = 0 { return withTy(st, t); };
    if x.kind = 13 {
        // (a function with parameters of its own hides the outer ones of those names)
        sn = [];
        ss = [];
        i = 0;
        while i < size(sizeNames) && i < size(sizes) [{ affirm i >= 0; }] ~ {
            if indexIn(&x.sizes, &get(sizeNames, i)) < 0 { sn = push(sn, clone(get(sizeNames, i))); ss = push(ss, get(sizes, i)); };
            i = i + 1;
        };
        tn = [];
        ts = [];
        i = 0;
        while i < size(names) && i < size(given) [{ affirm i >= 0; }] ~ {
            if indexIn(&x.types, &get(names, i)) < 0 { tn = push(tn, clone(get(names, i))); ts = push(ts, get(given, i)); };
            i = i + 1;
        };
        st = substitute(st, nth(&x.args, 0), &sn, &ss, &tn, &ts);
        if st.ty = nth(&x.args, 0) { return withTy(st, t); };
        return addTy(st, Ty { args: push([], st.ty), ..x });
    };
    args = [];
    changed = false;
    for a in x.args {
        st = substitute(st, a, sizeNames, sizes, names, given);
        if st.ty != a { changed = true; };
        args = push(args, st.ty);
    };
    if !changed { return withTy(st, t); };
    return addTy(st, Ty { args: args, ..x });
};

// The type of a builtin with a signature scheme, its type variables made new unknowns (TypeCheckCore.builtinType)
fn schemeType(st: St, scheme: Int) -> St ~ {
    k = kindOf(st, scheme);
    if k = 0 - 2 { return fail(st, nameOf(st, scheme)); };
    if k != 14 { return notModelled(st, "a builtin whose type the program's declarations give"); };
    all = schemeVarsOf(st, scheme, []);
    // (the last occurrence of each, in order)
    names = [];
    i = 0;
    while i < size(all) [{ affirm i >= 0; }] shrinks size(all) - i {
        later = false;
        j = i + 1;
        while j < size(all) [{ affirm j > i; }] shrinks size(all) - j {
            if get(all, j) = get(all, i) { later = true; };
            j = j + 1;
        };
        if !later { names = push(names, clone(get(all, i))); };
        i = i + 1;
    };
    given = [];
    for n in &names { st = freshVar(st); given = push(given, st.ty); };
    noSizeNames = [];
    noSizes = [];
    return substitute(st, scheme, &noSizeNames, &noSizes, &names, &given);
};
