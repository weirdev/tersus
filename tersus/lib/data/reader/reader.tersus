    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 3 {
        h = refAt(ts, 1, nodes, 14);
        t = refAt(ts, 2, nodes, 34);
        if !h.ok || !t.ok { return bad; };
        return done(AstNode::Bounds { value: AstBounds::Cons { head: h.value, tail: t.value } }, size(ts));
    };
    if k = 1 && size(ts) = 3 {
        s = refAt(ts, 1, nodes, 24);
        t = refAt(ts, 2, nodes, 31);
        if !s.ok || !t.ok { return bad; };
        return done(AstNode::Elaborated { value: AstElaborated { statements: s.value, types: t.value } }, size(ts));
    };
    return bad;
};

// The entries of an interface or of the builtin table, and the nodes only they hold
fn entryNodeAt1(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        ns = refAt(ts, 2, nodes, 22);
        if !n.ok || !ns.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::NamesEntry { n: n.value, ns: ns.value } }, size(ts));
    };
    if k = 1 && size(ts) = 4 {
        n = refAt(ts, 1, nodes, 1);
        o = refAt(ts, 2, nodes, 1);
        fs = refAt(ts, 3, nodes, 28);
        if !n.ok || !o.ok || !fs.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::CtorEntry { n: n.value, owner: o.value, fs: fs.value } }, size(ts));
    };
    if k = 2 && size(ts) = 4 {
        n = refAt(ts, 1, nodes, 1);
        ps = refAt(ts, 2, nodes, 22);
        fs = refAt(ts, 3, nodes, 28);
        if !n.ok || !ps.ok || !fs.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::GenericEntry { n: n.value, ps: ps.value, fs: fs.value } }, size(ts));
    };
    if k = 3 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        vs = refAt(ts, 2, nodes, 26);
        if !n.ok || !vs.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::InvariantEntry { n: n.value, vs: vs.value } }, size(ts));
    };
    if k = 4 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        fs = refAt(ts, 2, nodes, 33);
        if !n.ok || !fs.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::TraitEntry { n: n.value, fs: fs.value } }, size(ts));
    };
    return bad;
};

fn entryNodeAt2(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 8 {
        n = refAt(ts, 1, nodes, 1);
        ps = refAt(ts, 2, nodes, 22);
        sig = refAt(ts, 3, nodes, 12);
        ins = refAt(ts, 4, nodes, 26);
        outs = refAt(ts, 5, nodes, 26);
        term = refAt(ts, 6, nodes, 20);
        exports = refAt(ts, 7, nodes, 27);
        if !n.ok || !ps.ok || !sig.ok || !ins.ok || !outs.ok || !term.ok || !exports.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::FunctionEntry { n: n.value, ps: ps.value, sig: sig.value, ins: ins.value, outs: outs.value, term: term.value, exports: exports.value } }, size(ts));
    };
    if k = 1 && size(ts) = 3 {
        a = refAt(ts, 1, nodes, 1);
        b = refAt(ts, 2, nodes, 1);
        if !a.ok || !b.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::PairEntry { a: a.value, b: b.value } }, size(ts));
    };
    if k = 2 && size(ts) = 4 {
        a = refAt(ts, 1, nodes, 1);
        b = refAt(ts, 2, nodes, 1);
        os = refAt(ts, 3, nodes, 38);
        if !a.ok || !b.ok || !os.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::AssocEntry { a: a.value, b: b.value, origins: os.value } }, size(ts));
    };
    if k = 3 && size(ts) = 5 {
        a = refAt(ts, 1, nodes, 1);
        b = refAt(ts, 2, nodes, 1);
        ty = refAt(ts, 3, nodes, 2);
        args = refAt(ts, 4, nodes, 32);
        if !a.ok || !b.ok || !ty.ok || !args.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::ImplArgsEntry { a: a.value, b: b.value, ty: ty.value, args: args.value } }, size(ts));
    };
    if k = 4 && size(ts) = 4 {
        a = refAt(ts, 1, nodes, 1);
        b = refAt(ts, 2, nodes, 1);
        bs = refAt(ts, 3, nodes, 34);
        if !a.ok || !b.ok || !bs.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::ImplBoundsEntry { a: a.value, b: b.value, bs: bs.value } }, size(ts));
    };
    return bad;
};

fn entryNodeAt3(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 11 {
        n = refAt(ts, 1, nodes, 1);
        bs = refAt(ts, 2, nodes, 34);
        fns = refAt(ts, 3, nodes, 37);
        ret = refAt(ts, 4, nodes, 39);
        ps = refAt(ts, 5, nodes, 22);
        sig = refAt(ts, 6, nodes, 12);
        ins = refAt(ts, 7, nodes, 26);
        outs = refAt(ts, 8, nodes, 26);
        term = refAt(ts, 9, nodes, 20);
        body = refAt(ts, 10, nodes, 24);
        if !n.ok || !bs.ok || !fns.ok || !ret.ok || !ps.ok || !sig.ok || !ins.ok || !outs.ok || !term.ok || !body.ok { return bad; };
        if !entriesAre(nodes, fns.value, 11) || !entriesAscending(nodes, fns.value) { return bad; };
        return done(AstNode::Entry { value: AstEntry::TemplateEntry { n: n.value, bs: bs.value, fns: fns.value, ret: ret.value, ps: ps.value, sig: sig.value, ins: ins.value, outs: outs.value, term: term.value, body: body.value } }, size(ts));
    };
    if k = 1 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        ty = refAt(ts, 2, nodes, 2);
        if !n.ok || !ty.ok { return bad; };
        return done(AstNode::Entry { value: AstEntry::TypeEntry { n: n.value, ty: ty.value } }, size(ts));
    };
    if k = 2 && size(ts) = 3 {
        space = wordAt(ts, 1);
        n = refAt(ts, 2, nodes, 1);
        if !space.ok || !n.ok || indexOf(spaceWords(), space.value) < 0 { return bad; };
        return done(AstNode::Entry { value: AstEntry::SurfaceEntry { space: space.value, n: n.value } }, size(ts));
    };
    if k = 3 && size(ts) = 5 {
        b = refAt(ts, 1, nodes, 21);
        surface = refAt(ts, 2, nodes, 37);
        scheme = refAt(ts, 3, nodes, 41);
        value = refAt(ts, 4, nodes, 4);
        if !b.ok || !surface.ok || !scheme.ok || !value.ok { return bad; };
        if !entriesAre(nodes, surface.value, 12) { return bad; };
        return done(AstNode::Entry { value: AstEntry::BuiltinEntry { b: b.value, surface: surface.value, scheme: scheme.value, value: value.value } }, size(ts));
    };
    if k = 4 && size(ts) = 3 {
        params = refAt(ts, 1, nodes, 31);
        ret = refAt(ts, 2, nodes, 2);
        if !params.ok || !ret.ok { return bad; };
        return done(AstNode::Scheme { value: AstScheme::SigFn { ts: params.value, ret: ret.value } }, size(ts));
    };
    return bad;
};

fn entryNodeAt4(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 1 { return done(AstNode::Scheme { value: AstScheme::SigDynamic }, size(ts)); };
    if k = 1 && size(ts) = 2 {
        n = refAt(ts, 1, nodes, 1);
        if !n.ok { return bad; };
        return done(AstNode::Scheme { value: AstScheme::SigValueError { n: n.value } }, size(ts));
    };
    if k = 2 && size(ts) = 1 { return done(AstNode::OptType { value: AstOptType::NoType }, size(ts)); };
    if k = 3 && size(ts) = 2 {
        t = refAt(ts, 1, nodes, 2);
        if !t.ok { return bad; };
        return done(AstNode::OptType { value: AstOptType::SomeType { t: t.value } }, size(ts));
    };
    if k = 4 && size(ts) = 1 { return done(AstNode::Entries { value: AstEntries::End }, size(ts)); };
    return bad;
};

fn entryNodeAt5(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 3 {
        h = refAt(ts, 1, nodes, 36);
        t = refAt(ts, 2, nodes, 37);
        if !h.ok || !t.ok { return bad; };
        return done(AstNode::Entries { value: AstEntries::Cons { head: h.value, tail: t.value } }, size(ts));
    };
    if k = 1 && size(ts) = 1 { return done(AstNode::OptNames { value: AstOptNames::End }, size(ts)); };
    if k = 2 && size(ts) = 3 {
        h = refAt(ts, 1, nodes, 19);
        t = refAt(ts, 2, nodes, 38);
        if !h.ok || !t.ok { return bad; };
        return done(AstNode::OptNames { value: AstOptNames::Cons { head: h.value, tail: t.value } }, size(ts));
    };
    if k = 3 && size(ts) = 22 { return interfaceNodeAt(ts, nodes); };
    return bad;
};

fn interfaceNodeAt(ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ affirm size(ts) = 22; }] [{ }] {
    bad = failed(noNode(), ts);
    pkg = refAt(ts, 1, nodes, 1);
    modu = refAt(ts, 2, nodes, 19);
    types = mapAt(ts, 3, nodes, 0);
    ctors = mapAt(ts, 4, nodes, 1);
    generics = mapAt(ts, 5, nodes, 2);
    invariants = mapAt(ts, 6, nodes, 3);
    traits = mapAt(ts, 7, nodes, 4);
    traitParams = mapAt(ts, 8, nodes, 0);
    functions = mapAt(ts, 9, nodes, 5);
    impls = mapAt(ts, 10, nodes, 6);
    assoc = mapAt(ts, 11, nodes, 7);
    implArgs = mapAt(ts, 12, nodes, 8);
    implBounds = mapAt(ts, 13, nodes, 9);
    copySet = setAt(ts, 14, nodes);
    linearSet = setAt(ts, 15, nodes);
    dropSet = setAt(ts, 16, nodes);
    axioms = refAt(ts, 17, nodes, 24);
    proofs = refAt(ts, 18, nodes, 24);
    externSet = setAt(ts, 19, nodes);
    templates = mapAt(ts, 20, nodes, 10);
    companions = mapAt(ts, 21, nodes, 0);
    if !pkg.ok || !modu.ok || !types.ok || !ctors.ok || !generics.ok || !invariants.ok || !traits.ok || !traitParams.ok || !functions.ok || !impls.ok || !assoc.ok { return bad; };
    if !implArgs.ok || !implBounds.ok || !copySet.ok || !linearSet.ok || !dropSet.ok || !axioms.ok || !proofs.ok || !externSet.ok || !templates.ok || !companions.ok { return bad; };
    v = AstInterface {
        pkg: pkg.value, modu: modu.value, types: types.value, ctors: ctors.value, generics: generics.value, invariants: invariants.value,
        traits: traits.value, traitParams: traitParams.value, functions: functions.value, impls: impls.value, assoc: assoc.value,
        implArgs: implArgs.value, implBounds: implBounds.value, copies: copySet.value, linear: linearSet.value, drops: dropSet.value,
        axioms: axioms.value, proofs: proofs.value, externs: externSet.value, templates: templates.value, companions: companions.value
    };
    return done(AstNode::Interface { value: v }, size(ts));
};

// A map of an interface: entries of one kind, in ascending order of their keys, no key twice
fn mapAt(ts: &List<Token>, pos: Int, nodes: &List<AstNode>, kind: Int) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] {
    r = refAt(ts, pos, nodes, 37);
    if !r.ok || !entriesAre(nodes, r.value, kind) || !entriesAscending(nodes, r.value) { return Parsed<Int> { value: 0, pos: r.pos, ok: false }; };
    return r;
};

// A set of an interface: names in ascending order, none twice
fn setAt(ts: &List<Token>, pos: Int, nodes: &List<AstNode>) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] {
    r = refAt(ts, pos, nodes, 22);
    if !r.ok || !namesAscending(nodes, r.value) { return Parsed<Int> { value: 0, pos: r.pos, ok: false }; };
    return r;
};

// Whether a comes before b, byte by byte (the order of their code points, as Haskell orders a String)
fn before(a: &String, b: &String) -> Bool [{ }] [{ }] {
    n = size(a.bytes);
    m = size(b.bytes);
    i = 0;
    while i < n && i < m [{ affirm i >= 0; affirm n = size(a.bytes); affirm m = size(b.bytes); }] shrinks n - i {
        x = toInt(get(a.bytes, i));
        y = toInt(get(b.bytes, i));
        if x != y { return x < y; };
        i = i + 1;
    };
    return n < m;
};

// The key of an entry: its name, or its two names
fn entryKey(nodes: &List<AstNode>, e: &AstEntry) -> List<String> [{ }] [{ }] {
    return match e {
        AstEntry::NamesEntry { n: n, ns: ns } => push([], nameValue(nodes, n)),
        AstEntry::CtorEntry { n: n, owner: o, fs: fs } => push([], nameValue(nodes, n)),
        AstEntry::GenericEntry { n: n, ps: ps, fs: fs } => push([], nameValue(nodes, n)),
        AstEntry::InvariantEntry { n: n, vs: vs } => push([], nameValue(nodes, n)),
        AstEntry::TraitEntry { n: n, fs: fs } => push([], nameValue(nodes, n)),
        AstEntry::FunctionEntry { n: n, ps: ps, sig: sig, ins: ins, outs: outs, term: term, exports: exports } => push([], nameValue(nodes, n)),
        AstEntry::PairEntry { a: a, b: b } => push(push([], nameValue(nodes, a)), nameValue(nodes, b)),
        AstEntry::AssocEntry { a: a, b: b, origins: os } => push(push([], nameValue(nodes, a)), nameValue(nodes, b)),
        AstEntry::ImplArgsEntry { a: a, b: b, ty: ty, args: args } => push(push([], nameValue(nodes, a)), nameValue(nodes, b)),
        AstEntry::ImplBoundsEntry { a: a, b: b, bs: bs } => push(push([], nameValue(nodes, a)), nameValue(nodes, b)),
        AstEntry::TemplateEntry { n: n, bs: bs, fns: fns, ret: ret, ps: ps, sig: sig, ins: ins, outs: outs, term: term, body: body } => push([], nameValue(nodes, n)),
        AstEntry::TypeEntry { n: n, ty: ty } => push([], nameValue(nodes, n)),
        AstEntry::SurfaceEntry { space: space, n: n } => push([], nameValue(nodes, n)),
        AstEntry::BuiltinEntry { b: b, surface: surface, scheme: scheme, value: value } => [],
    };
};

// Whether key a comes before key b: by the first name, then by the second
fn keyBefore(a: &List<String>, b: &List<String>) -> Bool [{ }] [{ }] {
    if size(a) = 0 || size(b) = 0 { return false; };
    x = get(a, 0);
    y = get(b, 0);
    if before(x, y) { return true; };
    if before(y, x) { return false; };
    if size(a) < 2 || size(b) < 2 { return false; };
    return before(get(a, 1), get(b, 1));
};

// Whether the keys of a list of entries ascend. A list only refers to earlier records.
fn entriesAscending(nodes: &List<AstNode>, start: Int) -> Bool [{ }] [{ }] {
    id = start;
    previous = [];
    first = true;
    while id >= 0 && id < size(nodes) [{ }] shrinks id + 1 {
        node = get(nodes, id);
        if !(node is AstNode::Entries) { return false; };
        match (node as AstNode::Entries).value {
            AstEntries::End => { return true; },
            AstEntries::Cons { head: h, tail: t } => {
                if h < 0 || h >= size(nodes) || t >= id { return false; };
                e = get(nodes, h);
                if !(e is AstNode::Entry) { return false; };
                key = entryKey(nodes, (e as AstNode::Entry).value);
                if !first && !keyBefore(&previous, &key) { return false; };
                previous = key;
                first = false;
                id = t;
            },
        };
    };
    return false;
};

// Whether a list of names ascends
fn namesAscending(nodes: &List<AstNode>, start: Int) -> Bool [{ }] [{ }] {
    id = start;
    previous = "";
    first = true;
    while id >= 0 && id < size(nodes) [{ }] shrinks id + 1 {
        node = get(nodes, id);
        if !(node is AstNode::Names) { return false; };
        match (node as AstNode::Names).value {
            AstNames::End => { return true; },
            AstNames::Cons { head: h, tail: t } => {
                if t >= id { return false; };
                name = nameValue(nodes, h);
                if !first && !before(&previous, &name) { return false; };
                previous = name;
                first = false;
                id = t;
            },
        };
    };
    return false;
};

fn spaceWords() -> List<String> [{ }] [{ }] {
    w = push([], "std");
    w = push(w, "pointer");
    w = push(w, "ghost");
    w = push(w, "proof");
    w = push(w, "method");
    w = push(w, "syntax");
    return w;
};

// The variant of an entry, in the order of AstEntry
fn entryKind(e: &AstEntry) -> Int [{ }] [{ }] {
    return match e {
        AstEntry::NamesEntry { n: n, ns: ns } => 0,
        AstEntry::CtorEntry { n: n, owner: o, fs: fs } => 1,
        AstEntry::GenericEntry { n: n, ps: ps, fs: fs } => 2,
        AstEntry::InvariantEntry { n: n, vs: vs } => 3,
        AstEntry::TraitEntry { n: n, fs: fs } => 4,
        AstEntry::FunctionEntry { n: n, ps: ps, sig: sig, ins: ins, outs: outs, term: term, exports: exports } => 5,
        AstEntry::PairEntry { a: a, b: b } => 6,
        AstEntry::AssocEntry { a: a, b: b, origins: os } => 7,
        AstEntry::ImplArgsEntry { a: a, b: b, ty: ty, args: args } => 8,
        AstEntry::ImplBoundsEntry { a: a, b: b, bs: bs } => 9,
        AstEntry::TemplateEntry { n: n, bs: bs, fns: fns, ret: ret, ps: ps, sig: sig, ins: ins, outs: outs, term: term, body: body } => 10,
        AstEntry::TypeEntry { n: n, ty: ty } => 11,
        AstEntry::SurfaceEntry { space: space, n: n } => 12,
        AstEntry::BuiltinEntry { b: b, surface: surface, scheme: scheme, value: value } => 13,
    };
};

// Whether every entry of a list of entries is of one variant. A list only refers to earlier records.
fn entriesAre(nodes: &List<AstNode>, start: Int, kind: Int) -> Bool [{ }] [{ }] {
    id = start;
    while id >= 0 && id < size(nodes) [{ }] shrinks id + 1 {
        node = get(nodes, id);
        if !(node is AstNode::Entries) { return false; };
        match (node as AstNode::Entries).value {
            AstEntries::End => { return true; },
            AstEntries::Cons { head: h, tail: t } => {
                if h < 0 || h >= size(nodes) || t >= id { return false; };
                e = get(nodes, h);
                if !(e is AstNode::Entry) || entryKind((e as AstNode::Entry).value) != kind { return false; };
                id = t;
            },
        };
    };
    return false;
};

fn nodeRefs(node: &AstNode) -> List<Int> [{ }] [{ }] {
    refs = noInts();
    match node {
        AstNode::Name { value: v } => { match v { AstName::End => { }, AstName::Part { text: s, tail: t } => { refs = push(refs, t); }, }; },
        AstNode::Type { value: v } => { },
        AstNode::Size { value: v } => { },
        AstNode::Value { value: v } => {
            match v {
                AstValue::VInt { n: n } => { refs = push(refs, n); },
                AstValue::VList { xs: xs } => { refs = push(refs, xs); },
                AstValue::VBool { b: b } => {  },
                AstValue::VData { n: n, xs: xs } => { refs = push(refs, n); refs = push(refs, xs); },
                AstValue::VFnRef { n: n } => { refs = push(refs, n); },
                AstValue::VFunct { ps: ps, ins: ins, outs: outs, body: body, exports: exports } => { refs = push(refs, ps); refs = push(refs, ins); refs = push(refs, outs); refs = push(refs, body); refs = push(refs, exports); },
            };
        },
        AstNode::Body { value: v } => {
            match v {
                AstBody::NativeFunct { sig: sig, term: term, stmts: stmts } => { refs = push(refs, sig); refs = push(refs, term); refs = push(refs, stmts); },
                AstBody::BuiltinFunct { b: b } => { refs = push(refs, b); },
            };
        },
        AstNode::Expression { value: v } => {
            match v {
                AstExpression::Val { v: v } => { refs = push(refs, v); },
                AstExpression::Var { n: n } => { refs = push(refs, n); },
                AstExpression::F { f: f, xs: xs } => { refs = push(refs, f); refs = push(refs, xs); },
            };
        },
        AstNode::Termination { value: v } => {
            match v {
                AstTermination::Shrinks { e: e } => { refs = push(refs, e); },
                AstTermination::Counting { e: e } => { refs = push(refs, e); },
                AstTermination::Parts { e: e } => { refs = push(refs, e); },
                AstTermination::MayDiverge => {  },
                AstTermination::Recursing { t: t } => { refs = push(refs, t); },
            };
        },
        AstNode::Validation { value: v } => {
            match v {
                AstValidation::Rewrite { r: r } => { refs = push(refs, r); },
                AstValidation::ProofAssert { p: p } => { refs = push(refs, p); },
                AstValidation::AssignProofVar { n: n, e: e } => { refs = push(refs, n); refs = push(refs, e); },
                AstValidation::Assume { p: p } => { refs = push(refs, p); },
            };
        },
        AstNode::Proof { value: v } => {
            match v {
                AstProof::FApp { f: f, xs: xs } => { refs = push(refs, f); refs = push(refs, xs); },
                AstProof::ATerm { n: n } => { refs = push(refs, n); },
                AstProof::CTerm { v: v } => { refs = push(refs, v); },
                AstProof::Forall { n: n, gs: gs, b: b } => { refs = push(refs, n); refs = push(refs, gs); refs = push(refs, b); },
                AstProof::BVar { n: n } => { refs = push(refs, n); },
            };
        },
        AstNode::Rule { value: v } => {
            match v {
                AstRule::Refl { p: p } => { refs = push(refs, p); },
                AstRule::Eval { n: n } => { refs = push(refs, n); },
                AstRule::EvalAll => {  },
                AstRule::CheckGtZero { p: p } => { refs = push(refs, p); },
                AstRule::CheckRel { p: p } => { refs = push(refs, p); },
                AstRule::UserRewrite { n: n, xs: xs } => { refs = push(refs, n); refs = push(refs, xs); },
            };
        },
        AstNode::Statement { value: v } => {
            match v {
                AstStatement::Assign { n: n, e: e } => { refs = push(refs, n); refs = push(refs, e); },
                AstStatement::AssignDeref { a: a, b: b } => { refs = push(refs, a); refs = push(refs, b); },
                AstStatement::Let { n: n, e: e } => { refs = push(refs, n); refs = push(refs, e); },
                AstStatement::Return { e: e } => { refs = push(refs, e); },
                AstStatement::ValidationStatement { v: v } => { refs = push(refs, v); },
                AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: vs } => { refs = push(refs, n); refs = push(refs, ps); refs = push(refs, fs); refs = push(refs, vs); },
                AstStatement::EnumDef { n: n, vs: vs } => { refs = push(refs, n); refs = push(refs, vs); },
                AstStatement::AxiomDef { n: n, ps: ps, ins: ins, outs: outs } => { refs = push(refs, n); refs = push(refs, ps); refs = push(refs, ins); refs = push(refs, outs); },
                AstStatement::ProofDef { n: n, ps: ps, ins: ins, outs: outs, body: body } => { refs = push(refs, n); refs = push(refs, ps); refs = push(refs, ins); refs = push(refs, outs); refs = push(refs, body); },
                AstStatement::Block { xs: xs } => { refs = push(refs, xs); },
                AstStatement::If { e: e, a: a, b: b } => { refs = push(refs, e); refs = push(refs, a); refs = push(refs, b); },
                AstStatement::While { e: e, vs: vs, t: t, xs: xs } => { refs = push(refs, e); refs = push(refs, vs); refs = push(refs, t); refs = push(refs, xs); },
                AstStatement::TraitDef { n: n, ps: ps, fs: fs } => { refs = push(refs, n); refs = push(refs, ps); refs = push(refs, fs); },
                AstStatement::ImplDef { traitName: traitName, args: args, n: n, ty: ty, bs: bs, xs: xs } => { refs = push(refs, traitName); refs = push(refs, args); refs = push(refs, n); refs = push(refs, ty); refs = push(refs, bs); refs = push(refs, xs); },
                AstStatement::BoundedDef { bs: bs, s: s } => { refs = push(refs, bs); refs = push(refs, s); },
                AstStatement::Mark { line: line, col: col } => {  },
                AstStatement::CopyDef { n: n } => { refs = push(refs, n); },
                AstStatement::LinearDef { n: n } => { refs = push(refs, n); },
                AstStatement::ExternDef { n: n } => { refs = push(refs, n); },
                AstStatement::DropDef { n: n } => { refs = push(refs, n); },
                AstStatement::Dissolve { n: n } => { refs = push(refs, n); },
                AstStatement::Instance { n: n, f: f, args: args, ps: ps, sig: sig } => { refs = push(refs, n); refs = push(refs, f); refs = push(refs, args); refs = push(refs, ps); refs = push(refs, sig); },
                AstStatement::PackLoop { i: i, a: a, p: p, lo: lo, hi: hi, take: take, xs: xs } => { refs = push(refs, i); refs = push(refs, a); refs = push(refs, p); refs = push(refs, lo); refs = push(refs, hi); refs = push(refs, xs); },
            };
        },
        AstNode::Signature { value: v } => { refs = push(refs, v.ts); refs = push(refs, v.ret); refs = push(refs, v.ss); refs = push(refs, v.ps); refs = push(refs, v.ws); refs = push(refs, v.fs); },
        AstNode::TraitFn { value: v } => { refs = push(refs, v.n); refs = push(refs, v.ps); refs = push(refs, v.sig); refs = push(refs, v.ins); refs = push(refs, v.outs); },
        AstNode::Bound { value: v } => { refs = push(refs, v.p); refs = push(refs, v.n); refs = push(refs, v.ts); },
        AstNode::Field { value: v } => { refs = push(refs, v.n); refs = push(refs, v.ty); },
        AstNode::Variant { value: v } => { refs = push(refs, v.n); refs = push(refs, v.fs); },
        AstNode::ValueField { value: v } => { refs = push(refs, v.n); refs = push(refs, v.v); },
        AstNode::Arg { value: v } => {
            match v {
                AstArg::ArgSize { s: s } => { refs = push(refs, s); },
                AstArg::ArgType { t: t } => { refs = push(refs, t); },
            };
        },
        AstNode::OptName { value: v } => {
            match v {
                AstOptName::NoName => {  },
                AstOptName::SomeName { n: n } => { refs = push(refs, n); },
            };
        },
        AstNode::OptTermination { value: v } => {
            match v {
                AstOptTermination::NoTermination => {  },
                AstOptTermination::SomeTermination { t: t } => { refs = push(refs, t); },
            };
        },
        AstNode::Builtin { value: v } => {
            match v {
                AstBuiltin::Ctor { n: n, args: args, fs: fs } => { refs = push(refs, n); refs = push(refs, args); refs = push(refs, fs); },
                AstBuiltin::FieldBuiltin { owner: owner, n: n } => { refs = push(refs, owner); refs = push(refs, n); },
                AstBuiltin::Is { n: n } => { refs = push(refs, n); },
                AstBuiltin::Project { n: n, f: f } => { refs = push(refs, n); refs = push(refs, f); },
                AstBuiltin::Cast { n: n } => { refs = push(refs, n); },
                AstBuiltin::ToWord { signed: signed, bits: bits } => {  },
                AstBuiltin::Rel { r: r } => {  },
                AstBuiltin::Primitive { name: n } => { },
            };
        },
        AstNode::Names { value: v } => { match v { AstNames::End => { }, AstNames::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Values { value: v } => { match v { AstValues::End => { }, AstValues::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Statements { value: v } => { match v { AstStatements::End => { }, AstStatements::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Expressions { value: v } => { match v { AstExpressions::End => { }, AstExpressions::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Validations { value: v } => { match v { AstValidations::End => { }, AstValidations::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Proofs { value: v } => { match v { AstProofs::End => { }, AstProofs::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Fields { value: v } => { match v { AstFields::End => { }, AstFields::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Variants { value: v } => { match v { AstVariants::End => { }, AstVariants::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::ValueFields { value: v } => { match v { AstValueFields::End => { }, AstValueFields::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Types { value: v } => { match v { AstTypes::End => { }, AstTypes::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Args { value: v } => { match v { AstArgs::End => { }, AstArgs::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::TraitFns { value: v } => { match v { AstTraitFns::End => { }, AstTraitFns::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Bounds { value: v } => { match v { AstBounds::End => { }, AstBounds::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::Elaborated { value: v } => { refs = push(refs, v.statements); refs = push(refs, v.types); },
        AstNode::Entry { value: v } => { refs = entryRefs(v); },
        AstNode::Entries { value: v } => { match v { AstEntries::End => { }, AstEntries::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::OptNames { value: v } => { match v { AstOptNames::End => { }, AstOptNames::Cons { head: h, tail: t } => { refs = push(refs, h); refs = push(refs, t); }, }; },
        AstNode::OptType { value: v } => { match v { AstOptType::NoType => { }, AstOptType::SomeType { t: t } => { refs = push(refs, t); }, }; },
        AstNode::Interface { value: v } => { refs = interfaceRefs(v); },
        AstNode::Scheme { value: v } => {
            match v {
                AstScheme::SigFn { ts: ts, ret: ret } => { refs = push(refs, ts); refs = push(refs, ret); },
                AstScheme::SigDynamic => { },
                AstScheme::SigValueError { n: n } => { refs = push(refs, n); },
            };
        },
    };
    return refs;
};

fn entryRefs(e: &AstEntry) -> List<Int> [{ }] [{ }] {
    refs = noInts();
    match e {
        AstEntry::NamesEntry { n: n, ns: ns } => { refs = push(push(refs, n), ns); },
        AstEntry::CtorEntry { n: n, owner: o, fs: fs } => { refs = push(push(push(refs, n), o), fs); },
        AstEntry::GenericEntry { n: n, ps: ps, fs: fs } => { refs = push(push(push(refs, n), ps), fs); },
        AstEntry::InvariantEntry { n: n, vs: vs } => { refs = push(push(refs, n), vs); },
        AstEntry::TraitEntry { n: n, fs: fs } => { refs = push(push(refs, n), fs); },
        AstEntry::FunctionEntry { n: n, ps: ps, sig: sig, ins: ins, outs: outs, term: term, exports: exports } => {
            refs = push(push(push(push(push(push(push(refs, n), ps), sig), ins), outs), term), exports);
        },
        AstEntry::PairEntry { a: a, b: b } => { refs = push(push(refs, a), b); },
        AstEntry::AssocEntry { a: a, b: b, origins: os } => { refs = push(push(push(refs, a), b), os); },
        AstEntry::ImplArgsEntry { a: a, b: b, ty: ty, args: args } => { refs = push(push(push(push(refs, a), b), ty), args); },
        AstEntry::ImplBoundsEntry { a: a, b: b, bs: bs } => { refs = push(push(push(refs, a), b), bs); },
        AstEntry::TemplateEntry { n: n, bs: bs, fns: fns, ret: ret, ps: ps, sig: sig, ins: ins, outs: outs, term: term, body: body } => {
            refs = push(push(push(push(push(refs, n), bs), fns), ret), ps);
            refs = push(push(push(push(push(refs, sig), ins), outs), term), body);
        },
        AstEntry::TypeEntry { n: n, ty: ty } => { refs = push(push(refs, n), ty); },
        AstEntry::SurfaceEntry { space: space, n: n } => { refs = push(refs, n); },
        AstEntry::BuiltinEntry { b: b, surface: surface, scheme: scheme, value: value } => { refs = push(push(push(push(refs, b), surface), scheme), value); },
    };
    return refs;
};

fn interfaceRefs(v: &AstInterface) -> List<Int> [{ }] [{ }] {
    refs = push(push(push(push(push(noInts(), v.pkg), v.modu), v.types), v.ctors), v.generics);
    refs = push(push(push(push(push(refs, v.invariants), v.traits), v.traitParams), v.functions), v.impls);
    refs = push(push(push(push(push(refs, v.assoc), v.implArgs), v.implBounds), v.copies), v.linear);
    refs = push(push(push(push(push(refs, v.drops), v.axioms), v.proofs), v.externs), v.templates);
    return push(refs, v.companions);
};

fn nameValue(nodes: &List<AstNode>, start: Int) -> String [{ }] [{ }] {
    out = "";
    id = start;
    fuel = size(nodes);
    while fuel > 0 [{ affirm fuel >= 0; }] shrinks fuel {
        if id < 0 || id >= size(nodes) { return out; };
        node = get(nodes, id);
        if node is AstNode::Name {
            v = node as AstNode::Name;
            match v.value {
                AstName::End => { return out; },
                AstName::Part { text: text, tail: tail } => { out = out.concat(text); id = tail; },
            };
        } else { return out; };
        fuel = fuel - 1;
    };
    return out;
};

fn validDecimal(text: &String) -> Bool [{ }] [{ }] {
    n = size(text.bytes);
    i = 0;
    if n > 0 && get(text.bytes, 0) = toByte(45) { i = 1; };
    if i >= n { return false; };
    while i < n [{ affirm i >= 0; affirm i <= n; }] shrinks n - i {
        c = toInt(get(text.bytes, i));
        if c < 48 || c > 57 { return false; };
        i = i + 1;
    };
    return true;
};

fn badAst() -> Parsed<AstProgram> [{ }] [{ }] {
    return Parsed<AstProgram> { value: AstProgram { stage: "", nodes: [], root: 0 }, pos: 0, ok: false };
};

// The kind of the root of each stage of the data: Statements, Elaborated, Interface, or Entries of builtins
fn rootKindOf(stage: &String) -> Int [{ }] [{ }] {
    if stage = "parsed" { return 24; };
    if stage = "elaborated" { return 35; };
    if stage = "interface" { return 40; };
    if stage = "builtins" { return 37; };
    return 0 - 1;
};

fn readRecord() -> Parsed<String> [{ }] [{ }] {
    bytes = [];
    c = readByte();
    if c < 0 { return Parsed<String> { value: "", pos: 0, ok: true }; };
    n = 0;
    while c >= 0 && c != 10 [{ affirm n >= 0; affirm n <= 1000000; }] shrinks 1000000 - n {
        if n >= 1000000 { return Parsed<String> { value: "", pos: 1, ok: false }; };
        if c < 32 || c > 126 { return Parsed<String> { value: "", pos: 1, ok: false }; };
        bytes = push(bytes, toByte(c));
        n = n + 1;
        c = readByte();
    };
    return Parsed<String> { value: String { bytes: bytes }, pos: 1, ok: true };
};

fn readAst() -> Parsed<AstProgram> ~ {
    return readAstRecords(0 - 1);
};

// An AST block of exactly count records on standard input (a header, the nodes and the root), with more input
// after it; with a negative count, the whole input
fn readAstRecords(count: Int) -> Parsed<AstProgram> ~ {
    lines = readRecords(count);
    if !lines.ok { return badAst(); };
    return parseAstLines(&lines.value);
};

// count records of standard input, or with a negative count every record to its end
fn readRecords(count: Int) -> Parsed<List<String>> ~ {
    lines = [];
    while true [{ }] ~ {
        if count >= 0 && size(lines) >= count { return done(lines, 0); };
        line = readRecord();
        if !line.ok { return Parsed<List<String>> { value: [], pos: 0, ok: false }; };
        if line.pos = 0 {
            if count < 0 { return done(lines, 0); };
            return Parsed<List<String>> { value: [], pos: 0, ok: false };
        };
        lines = push(lines, line.value);
    };
    return Parsed<List<String>> { value: [], pos: 0, ok: false };
};

// An AST block as its records: a header, the nodes and the root, which is the last record
fn parseAstLines(lines: &List<String>) -> Parsed<AstProgram> ~ {
    if size(lines) < 2 { return badAst(); };
    header = get(lines, 0);
    if size(header.bytes) < 14 || !header.startsWith("tersus-ast 1 ") { return badAst(); };
    stage = header.slice(13, size(header.bytes));
    rootKind = rootKindOf(stage);
    if rootKind < 0 { return badAst(); };
    tags = recordTags();
    nodes = [];
    uses = noInts();
    i = 1;
    while i < size(lines) [{ affirm i >= 1; }] ~ {
        line = get(lines, i);
        if size(line.bytes) = 0 { return badAst(); };
        tokens = tokenizeStrict(line);
        if !tokens.ok { return badAst(); };
        ts = tokens.value;
        if isWord(ts, 0, "root") {
            if size(ts) != 2 || i != size(lines) - 1 { return badAst(); };
            root = intAt(ts, 1);
            if !root.ok || root.value < 0 || root.value != size(nodes) - 1 { return badAst(); };
            if nodeKind(&get(nodes, root.value)) != rootKind { return badAst(); };
            if stage = "builtins" && !entriesAre(nodes, root.value, 13) { return badAst(); };
            for j in 0..size(uses) {
                expected = 1;
                if j = root.value { expected = 0; };
                if get(uses, j) != expected { return badAst(); };
            };
            total = size(nodes);
            return done(AstProgram { stage: stage, nodes: nodes, root: root.value }, total);
        };
        node = nodeAt(&tags, ts, nodes);
        if !node.ok { return badAst(); };
        refs = nodeRefs(node.value);
        for r in refs {
            if r < 0 || r >= size(uses) { return badAst(); };
            if get(uses, r) != 0 { return badAst(); };
            uses = set(uses, r, 1);
        };
        nodes = push(nodes, node.value);
        uses = push(uses, 0);
        i = i + 1;
    };
    return badAst();
};

fn validUtf8(s: &String) -> Bool [{ }] [{ }] {
    i = 0;
    n = size(s.bytes);
    while i < n [{ affirm i >= 0; affirm i <= n; }] shrinks n - i {
        c = toInt(get(s.bytes, i));
        count = 0;
        point = c;
        least = 0;
        if c >= 128 {
            if c >= 194 && c <= 223 { count = 1; point = c - 192; least = 128; }
            else { if c >= 224 && c <= 239 { count = 2; point = c - 224; least = 2048; }
            else { if c >= 240 && c <= 244 { count = 3; point = c - 240; least = 65536; }
            else { return false; }; }; };
        };
        if count < 0 || i + count >= n { return false; };
        for j in 0..count [{ affirm count >= 0; affirm i >= 0; affirm i + count < n; }] {
            b = toInt(get(s.bytes, i + j + 1));
            if b < 128 || b > 191 { return false; };
            point = point * 64 + b - 128;
        };
        if point < least || point > 1114111 || (point >= 55296 && point <= 57343) { return false; };
        i = i + count + 1;
    };
    return true;
};

fn tokenizeStrict(line: &String) -> Parsed<List<Token>> [{ }] [{ }] {
    bad = Parsed<List<Token>> { value: [], pos: 0, ok: false };
    ts = tokenize(line);
    if !ts.ok { return bad; };
    i = 0;
    n = size(line.bytes);
    while i < n [{ affirm i >= 0; affirm i <= n; }] shrinks n - i {
        c = toInt(get(line.bytes, i));
        if c = 32 { i = i + 1; }
        else {
            if c = 34 {
                q = quoted(line, i + 1);
                if !q.ok || !validUtf8(q.value) { return bad; };
                if q.pos < n && get(line.bytes, q.pos) != toByte(32) { return bad; };
                i = q.pos;
            } else {
                if c = 92 { return bad; };
                j = i + 1;
                while j < n && get(line.bytes, j) != toByte(32) [{ affirm j >= i + 1; affirm j <= n; }] shrinks n - j {
                    b = toInt(get(line.bytes, j));
                    if b = 34 || b = 92 { return bad; };
                    j = j + 1;
                };
                if (c >= 48 && c <= 57) || c = 45 {
                    v = parseInt(line.slice(i, j));
                    if !v.ok { return bad; };
                };
                i = j;
            };
        };
    };
    return ts;
};
