import data::codec::codec { Token, Parsed, Size, Type, failed, done, noInts, quoted, tokenize, parseInt, wordAt, nameAt, intAt, sizeAt, catStrings, typeAt, isWord, indexOf };
import data::ast::ast { AstName, AstValue, AstBody, AstExpression, AstTermination, AstValidation, AstProof, AstRule, AstStatement, AstSignature, AstTraitFn, AstBound, AstField, AstVariant, AstValueField, AstArg, AstOptName, AstOptTermination, AstBuiltin, AstNames, AstValues, AstStatements, AstExpressions, AstValidations, AstProofs, AstFields, AstVariants, AstValueFields, AstTypes, AstArgs, AstTraitFns, AstBounds, AstElaborated, AstEntry, AstEntries, AstOptNames, AstOptType, AstScheme, AstInterface, AstNode, AstProgram, relationWords };

// The reader of the AST arena data (AST_DATA.md): every stage, with its strict record, reference and UTF-8 checks.
// The AST reader, and anything else written in Tersus that reads the data, read it with readAst.
fn nodeKind(node: &AstNode) -> Int [{ }] [{ }] {
    return match node {
        AstNode::Name { value: v } => 1,
        AstNode::Type { value: v } => 2,
        AstNode::Size { value: v } => 3,
        AstNode::Value { value: v } => 4,
        AstNode::Body { value: v } => 5,
        AstNode::Expression { value: v } => 6,
        AstNode::Termination { value: v } => 7,
        AstNode::Validation { value: v } => 8,
        AstNode::Proof { value: v } => 9,
        AstNode::Rule { value: v } => 10,
        AstNode::Statement { value: v } => 11,
        AstNode::Signature { value: v } => 12,
        AstNode::TraitFn { value: v } => 13,
        AstNode::Bound { value: v } => 14,
        AstNode::Field { value: v } => 15,
        AstNode::Variant { value: v } => 16,
        AstNode::ValueField { value: v } => 17,
        AstNode::Arg { value: v } => 18,
        AstNode::OptName { value: v } => 19,
        AstNode::OptTermination { value: v } => 20,
        AstNode::Builtin { value: v } => 21,
        AstNode::Names { value: v } => 22,
        AstNode::Values { value: v } => 23,
        AstNode::Statements { value: v } => 24,
        AstNode::Expressions { value: v } => 25,
        AstNode::Validations { value: v } => 26,
        AstNode::Proofs { value: v } => 27,
        AstNode::Fields { value: v } => 28,
        AstNode::Variants { value: v } => 29,
        AstNode::ValueFields { value: v } => 30,
        AstNode::Types { value: v } => 31,
        AstNode::Args { value: v } => 32,
        AstNode::TraitFns { value: v } => 33,
        AstNode::Bounds { value: v } => 34,
        AstNode::Elaborated { value: v } => 35,
        AstNode::Entry { value: v } => 36,
        AstNode::Entries { value: v } => 37,
        AstNode::OptNames { value: v } => 38,
        AstNode::OptType { value: v } => 39,
        AstNode::Interface { value: v } => 40,
        AstNode::Scheme { value: v } => 41,
    };
};

fn refAt(ts: &List<Token>, pos: Int, nodes: &List<AstNode>, kind: Int) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] {
    r = intAt(ts, pos);
    if !r.ok || r.value < 0 || r.value >= size(nodes) { return Parsed<Int> { value: 0, pos: r.pos, ok: false }; };
    if nodeKind(&get(nodes, r.value)) != kind { return Parsed<Int> { value: 0, pos: r.pos, ok: false }; };
    return r;
};

fn boolAt(ts: &List<Token>, pos: Int) -> Parsed<Bool> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] {
    w = wordAt(ts, pos);
    if w.ok && w.value = "true" { return done(true, w.pos); };
    if w.ok && w.value = "false" { return done(false, w.pos); };
    return Parsed<Bool> { value: false, pos: w.pos, ok: false };
};

fn relAt(ts: &List<Token>, pos: Int) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] {
    w = wordAt(ts, pos);
    i = indexOf(relationWords(), w.value);
    return Parsed<Int> { value: i, pos: w.pos, ok: w.ok && i >= 0 };
};

fn primitiveWords() -> List<String> [{ }] [{ }] {
    w = push([], "Size");
    w = push(w, "First");
    w = push(w, "Last");
    w = push(w, "Get");
    w = push(w, "Push");
    w = push(w, "Pop");
    w = push(w, "Set");
    w = push(w, "Plus");
    w = push(w, "Minus");
    w = push(w, "Times");
    w = push(w, "Div");
    w = push(w, "Mod");
    w = push(w, "NewArray");
    w = push(w, "ArrayFrom");
    w = push(w, "ArrayFromList");
    w = push(w, "NewBoxedArray");
    w = push(w, "NewEmptyArray");
    w = push(w, "WriteByte");
    w = push(w, "WriteError");
    w = push(w, "ReadByte");
    w = push(w, "ArgCount");
    w = push(w, "ArgByte");
    w = push(w, "PathByte");
    w = push(w, "FileLoad");
    w = push(w, "FileByte");
    w = push(w, "StoreByte");
    w = push(w, "FileStore");
    w = push(w, "ToByte");
    w = push(w, "FromByte");
    w = push(w, "BytesFrom");
    w = push(w, "Unsize");
    w = push(w, "NewBox");
    w = push(w, "UnBox");
    w = push(w, "CloneOf");
    w = push(w, "BorrowOf");
    w = push(w, "BorrowMutOf");
    w = push(w, "DerefOf");
    w = push(w, "OldOf");
    w = push(w, "AddrNull");
    w = push(w, "AddrOffset");
    w = push(w, "AddrCast");
    w = push(w, "AddrToInt");
    w = push(w, "AddrFromInt");
    w = push(w, "AddrAlloc");
    w = push(w, "AddrGet");
    w = push(w, "AddrWrite");
    w = push(w, "AddrTake");
    w = push(w, "AddrDropValue");
    w = push(w, "AddrDropRange");
    w = push(w, "AddrResize");
    w = push(w, "AddrFree");
    w = push(w, "AllocPair");
    w = push(w, "TakePair");
    w = push(w, "ResizePair");
    w = push(w, "SplitPair");
    w = push(w, "BlockNew");
    w = push(w, "BlockTaken");
    w = push(w, "BlockResized");
    w = push(w, "BlockSplitLo");
    w = push(w, "BlockSplitHi");
    w = push(w, "BlockJoin");
    w = push(w, "BlockAssume");
    w = push(w, "BlockCast");
    w = push(w, "BlockBase");
    w = push(w, "BlockCap");
    w = push(w, "BlockFilled");
    w = push(w, "BlockContents");
    w = push(w, "BlockOrigin");
    w = push(w, "BlockStart");
    w = push(w, "BlockExtent");
    w = push(w, "BlockCount");
    w = push(w, "UninitEmpty");
    w = push(w, "UninitNew");
    w = push(w, "UninitGet");
    w = push(w, "UninitTake");
    w = push(w, "UninitDiscard");
    w = push(w, "UninitFilled");
    w = push(w, "UninitAt");
    w = push(w, "Replace");
    w = push(w, "And");
    w = push(w, "Or");
    w = push(w, "Not");
    w = push(w, "Within");
    return w;
};

fn noNode() -> AstNode [{ }] [{ }] { return AstNode::Name { value: AstName::End }; };









// The tags of the records and the words of the primitives: each tag is the number of the reader of its records times
// 8, plus its place among that reader's tags
struct Tags { codes: HashMap<String, Int>, primitives: HashMap<String, Int> };

fn recordTags() -> Tags [{ }] [{ }] {
    codes = HashMap::new();
    codes = codes.insert("NameEnd", 0);
    codes = codes.insert("NamePart", 1);
    codes = codes.insert("Type", 2);
    codes = codes.insert("Size", 3);
    codes = codes.insert("Primitive", 4);
    codes = codes.insert("VInt", 8);
    codes = codes.insert("VList", 9);
    codes = codes.insert("VBool", 10);
    codes = codes.insert("VData", 11);
    codes = codes.insert("VFnRef", 12);
    codes = codes.insert("VFunct", 16);
    codes = codes.insert("NativeFunct", 17);
    codes = codes.insert("BuiltinFunct", 18);
    codes = codes.insert("Val", 19);
    codes = codes.insert("Var", 20);
    codes = codes.insert("F", 24);
    codes = codes.insert("NamesEnd", 32);
    codes = codes.insert("NamesCons", 33);
    codes = codes.insert("ValuesEnd", 34);
    codes = codes.insert("ValuesCons", 35);
    codes = codes.insert("StatementsEnd", 36);
    codes = codes.insert("StatementsCons", 40);
    codes = codes.insert("ExpressionsEnd", 41);
    codes = codes.insert("ExpressionsCons", 42);
    codes = codes.insert("ValidationsEnd", 43);
    codes = codes.insert("ValidationsCons", 44);
    codes = codes.insert("ProofsEnd", 48);
    codes = codes.insert("ProofsCons", 49);
    codes = codes.insert("FieldsEnd", 50);
    codes = codes.insert("FieldsCons", 51);
    codes = codes.insert("VariantsEnd", 52);
    codes = codes.insert("VariantsCons", 56);
    codes = codes.insert("ValueFieldsEnd", 57);
    codes = codes.insert("ValueFieldsCons", 58);
    codes = codes.insert("TypesEnd", 59);
    codes = codes.insert("TypesCons", 60);
    codes = codes.insert("ArgsEnd", 64);
    codes = codes.insert("ArgsCons", 65);
    codes = codes.insert("TraitFnsEnd", 66);
    codes = codes.insert("TraitFnsCons", 67);
    codes = codes.insert("BoundsEnd", 68);
    codes = codes.insert("BoundsCons", 72);
    codes = codes.insert("Elaborated", 73);
    codes = codes.insert("Signature", 80);
    codes = codes.insert("TraitFn", 81);
    codes = codes.insert("Bound", 82);
    codes = codes.insert("Field", 83);
    codes = codes.insert("Variant", 84);
    codes = codes.insert("ValueField", 88);
    codes = codes.insert("ArgSize", 89);
    codes = codes.insert("ArgType", 90);
    codes = codes.insert("NoName", 91);
    codes = codes.insert("SomeName", 92);
    codes = codes.insert("NoTermination", 96);
    codes = codes.insert("SomeTermination", 97);
    codes = codes.insert("Ctor", 98);
    codes = codes.insert("FieldBuiltin", 99);
    codes = codes.insert("Is", 100);
    codes = codes.insert("Project", 104);
    codes = codes.insert("Cast", 105);
    codes = codes.insert("ToWord", 106);
    codes = codes.insert("Rel", 107);
    codes = codes.insert("Assign", 112);
    codes = codes.insert("AssignDeref", 113);
    codes = codes.insert("Let", 114);
    codes = codes.insert("Return", 115);
    codes = codes.insert("ValidationStatement", 116);
    codes = codes.insert("StructDef", 120);
    codes = codes.insert("EnumDef", 121);
    codes = codes.insert("AxiomDef", 122);
    codes = codes.insert("ProofDef", 123);
    codes = codes.insert("Block", 124);
    codes = codes.insert("If", 128);
    codes = codes.insert("While", 129);
    codes = codes.insert("TraitDef", 130);
    codes = codes.insert("ImplDef", 131);
    codes = codes.insert("BoundedDef", 132);
    codes = codes.insert("Mark", 136);
    codes = codes.insert("CopyDef", 137);
    codes = codes.insert("LinearDef", 138);
    codes = codes.insert("ExternDef", 139);
    codes = codes.insert("DropDef", 140);
    codes = codes.insert("Dissolve", 144);
    codes = codes.insert("Instance", 145);
    codes = codes.insert("PackLoop", 146);
    codes = codes.insert("Shrinks", 152);
    codes = codes.insert("Counting", 153);
    codes = codes.insert("Parts", 154);
    codes = codes.insert("MayDiverge", 155);
    codes = codes.insert("Recursing", 156);
    codes = codes.insert("Rewrite", 160);
    codes = codes.insert("ProofAssert", 161);
    codes = codes.insert("AssignProofVar", 162);
    codes = codes.insert("Assume", 163);
    codes = codes.insert("FApp", 168);
    codes = codes.insert("ATerm", 169);
    codes = codes.insert("CTerm", 170);
    codes = codes.insert("Forall", 171);
    codes = codes.insert("BVar", 172);
    codes = codes.insert("Refl", 176);
    codes = codes.insert("Eval", 177);
    codes = codes.insert("EvalAll", 178);
    codes = codes.insert("CheckGtZero", 179);
    codes = codes.insert("CheckRel", 180);
    codes = codes.insert("UserRewrite", 184);
    codes = codes.insert("NamesEntry", 192);
    codes = codes.insert("CtorEntry", 193);
    codes = codes.insert("GenericEntry", 194);
    codes = codes.insert("InvariantEntry", 195);
    codes = codes.insert("TraitEntry", 196);
    codes = codes.insert("FunctionEntry", 200);
    codes = codes.insert("PairEntry", 201);
    codes = codes.insert("AssocEntry", 202);
    codes = codes.insert("ImplArgsEntry", 203);
    codes = codes.insert("ImplBoundsEntry", 204);
    codes = codes.insert("TemplateEntry", 208);
    codes = codes.insert("TypeEntry", 209);
    codes = codes.insert("SurfaceEntry", 210);
    codes = codes.insert("BuiltinEntry", 211);
    codes = codes.insert("SigFn", 212);
    codes = codes.insert("SigDynamic", 216);
    codes = codes.insert("SigValueError", 217);
    codes = codes.insert("NoType", 218);
    codes = codes.insert("SomeType", 219);
    codes = codes.insert("EntriesEnd", 220);
    codes = codes.insert("EntriesCons", 224);
    codes = codes.insert("OptNamesEnd", 225);
    codes = codes.insert("OptNamesCons", 226);
    codes = codes.insert("Interface", 227);
    primitives = HashMap::new();
    for w in primitiveWords() { primitives = primitives.insert(clone(w), 1); };
    return Tags { codes: codes, primitives: primitives };
};

// A record of the arena, read by the reader of its tag
fn nodeAt(tags: &Tags, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if size(ts) < 1 { return bad; };
    tag = wordAt(ts, 0);
    if !tag.ok { return bad; };
    code = tags.codes.lookup(&tag.value, 0 - 1);
    if code < 0 { return bad; };
    c = code / 8;
    k = code % 8;
    if c = 0 { return leafNodeAt(k, ts, nodes, &tags.primitives); };
    if c = 1 { return valueNodeAt1(k, ts, nodes); };
    if c = 2 { return valueNodeAt2(k, ts, nodes); };
    if c = 3 { return valueNodeAt3(k, ts, nodes); };
    if c = 4 { return listNodeAt1(k, ts, nodes); };
    if c = 5 { return listNodeAt2(k, ts, nodes); };
    if c = 6 { return listNodeAt3(k, ts, nodes); };
    if c = 7 { return listNodeAt4(k, ts, nodes); };
    if c = 8 { return listNodeAt5(k, ts, nodes); };
    if c = 9 { return listNodeAt6(k, ts, nodes); };
    if c = 10 { return partNodeAt1(k, ts, nodes); };
    if c = 11 { return partNodeAt2(k, ts, nodes); };
    if c = 12 { return partNodeAt3(k, ts, nodes); };
    if c = 13 { return partNodeAt4(k, ts, nodes); };
    if c = 14 { return statementNodeAt1(k, ts, nodes); };
    if c = 15 { return statementNodeAt2(k, ts, nodes); };
    if c = 16 { return statementNodeAt3(k, ts, nodes); };
    if c = 17 { return statementNodeAt4(k, ts, nodes); };
    if c = 18 { return statementNodeAt5(k, ts, nodes); };
    if c = 19 { return validationNodeAt1(k, ts, nodes); };
    if c = 20 { return validationNodeAt2(k, ts, nodes); };
    if c = 21 { return proofNodeAt1(k, ts, nodes); };
    if c = 22 { return proofNodeAt2(k, ts, nodes); };
    if c = 23 { return proofNodeAt3(k, ts, nodes); };
    if c = 24 { return entryNodeAt1(k, ts, nodes); };
    if c = 25 { return entryNodeAt2(k, ts, nodes); };
    if c = 26 { return entryNodeAt3(k, ts, nodes); };
    if c = 27 { return entryNodeAt4(k, ts, nodes); };
    if c = 28 { return entryNodeAt5(k, ts, nodes); };
    return bad;
};

fn leafNodeAt(k: Int, ts: &List<Token>, nodes: &List<AstNode>, primitives: &HashMap<String, Int>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 1 { return done(AstNode::Name { value: AstName::End }, size(ts)); };
    if k = 1 && size(ts) = 3 {
        text = nameAt(ts, 1);
        tail = refAt(ts, 2, nodes, 1);
        if !text.ok || !tail.ok { return bad; };
        return done(AstNode::Name { value: AstName::Part { text: text.value, tail: tail.value } }, size(ts));
    };
    if k = 2 && size(ts) > 1 {
        t = typeAt(ts, 1);
        if !t.ok || t.pos != size(ts) { return bad; };
        return done(AstNode::Type { value: t.value }, size(ts));
    };
    if k = 3 && size(ts) > 1 {
        s = sizeAt(ts, 1);
        if !s.ok || s.pos != size(ts) { return bad; };
        return done(AstNode::Size { value: s.value }, size(ts));
    };
    if k = 4 && size(ts) = 2 {
        n = nameAt(ts, 1);
        if !n.ok || !primitives.contains(&n.value) { return bad; };
        return done(AstNode::Builtin { value: AstBuiltin::Primitive { name: n.value } }, size(ts));
    };
    return bad;
};

fn valueNodeAt1(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 2 {
        n = refAt(ts, 1, nodes, 1);
        if !n.ok { return bad; };
        if !validDecimal(nameValue(nodes, n.value)) { return bad; };
        return done(AstNode::Value { value: AstValue::VInt { n: n.value } }, size(ts));
    };
    if k = 1 && size(ts) = 2 {
        xs = refAt(ts, 1, nodes, 23);
        if !xs.ok { return bad; };
        return done(AstNode::Value { value: AstValue::VList { xs: xs.value } }, size(ts));
    };
    if k = 2 && size(ts) = 2 {
        b = boolAt(ts, 1);
        if !b.ok { return bad; };
        return done(AstNode::Value { value: AstValue::VBool { b: b.value } }, size(ts));
    };
    if k = 3 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        xs = refAt(ts, 2, nodes, 30);
        if !n.ok || !xs.ok { return bad; };
        return done(AstNode::Value { value: AstValue::VData { n: n.value, xs: xs.value } }, size(ts));
    };
    if k = 4 && size(ts) = 2 {
        n = refAt(ts, 1, nodes, 1);
        if !n.ok { return bad; };
        return done(AstNode::Value { value: AstValue::VFnRef { n: n.value } }, size(ts));
    };
    return bad;
};

fn valueNodeAt2(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 6 {
        ps = refAt(ts, 1, nodes, 22);
        ins = refAt(ts, 2, nodes, 26);
        outs = refAt(ts, 3, nodes, 26);
        body = refAt(ts, 4, nodes, 5);
        exports = refAt(ts, 5, nodes, 27);
        if !ps.ok || !ins.ok || !outs.ok || !body.ok || !exports.ok { return bad; };
        return done(AstNode::Value { value: AstValue::VFunct { ps: ps.value, ins: ins.value, outs: outs.value, body: body.value, exports: exports.value } }, size(ts));
    };
    if k = 1 && size(ts) = 4 {
        sig = refAt(ts, 1, nodes, 12);
        term = refAt(ts, 2, nodes, 20);
        stmts = refAt(ts, 3, nodes, 24);
        if !sig.ok || !term.ok || !stmts.ok { return bad; };
        return done(AstNode::Body { value: AstBody::NativeFunct { sig: sig.value, term: term.value, stmts: stmts.value } }, size(ts));
    };
    if k = 2 && size(ts) = 2 {
        b = refAt(ts, 1, nodes, 21);
        if !b.ok { return bad; };
        return done(AstNode::Body { value: AstBody::BuiltinFunct { b: b.value } }, size(ts));
    };
    if k = 3 && size(ts) = 2 {
        v = refAt(ts, 1, nodes, 4);
        if !v.ok { return bad; };
        return done(AstNode::Expression { value: AstExpression::Val { v: v.value } }, size(ts));
    };
    if k = 4 && size(ts) = 2 {
        n = refAt(ts, 1, nodes, 1);
        if !n.ok { return bad; };
        return done(AstNode::Expression { value: AstExpression::Var { n: n.value } }, size(ts));
    };
    return bad;
};

fn valueNodeAt3(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 3 {
        f = refAt(ts, 1, nodes, 6);
        xs = refAt(ts, 2, nodes, 25);
        if !f.ok || !xs.ok { return bad; };
        return done(AstNode::Expression { value: AstExpression::F { f: f.value, xs: xs.value } }, size(ts));
    };
    return bad;
};

fn validationNodeAt1(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 2 {
        e = refAt(ts, 1, nodes, 6);
        if !e.ok { return bad; };
        return done(AstNode::Termination { value: AstTermination::Shrinks { e: e.value } }, size(ts));
    };
    if k = 1 && size(ts) = 2 {
        e = refAt(ts, 1, nodes, 6);
        if !e.ok { return bad; };
        return done(AstNode::Termination { value: AstTermination::Counting { e: e.value } }, size(ts));
    };
    if k = 2 && size(ts) = 2 {
        e = refAt(ts, 1, nodes, 6);
        if !e.ok { return bad; };
        return done(AstNode::Termination { value: AstTermination::Parts { e: e.value } }, size(ts));
    };
    if k = 3 && size(ts) = 1 {
        return done(AstNode::Termination { value: AstTermination::MayDiverge }, size(ts));
    };
    if k = 4 && size(ts) = 2 {
        t = refAt(ts, 1, nodes, 20);
        if !t.ok { return bad; };
        return done(AstNode::Termination { value: AstTermination::Recursing { t: t.value } }, size(ts));
    };
    return bad;
};

fn validationNodeAt2(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 2 {
        r = refAt(ts, 1, nodes, 10);
        if !r.ok { return bad; };
        return done(AstNode::Validation { value: AstValidation::Rewrite { r: r.value } }, size(ts));
    };
    if k = 1 && size(ts) = 2 {
        p = refAt(ts, 1, nodes, 9);
        if !p.ok { return bad; };
        return done(AstNode::Validation { value: AstValidation::ProofAssert { p: p.value } }, size(ts));
    };
    if k = 2 && size(ts) = 3 {
        n = refAt(ts, 1, nodes, 1);
        e = refAt(ts, 2, nodes, 6);
        if !n.ok || !e.ok { return bad; };
        return done(AstNode::Validation { value: AstValidation::AssignProofVar { n: n.value, e: e.value } }, size(ts));
    };
    if k = 3 && size(ts) = 2 {
        p = refAt(ts, 1, nodes, 9);
        if !p.ok { return bad; };
        return done(AstNode::Validation { value: AstValidation::Assume { p: p.value } }, size(ts));
    };
    return bad;
};

fn proofNodeAt1(k: Int, ts: &List<Token>, nodes: &List<AstNode>) -> Parsed<AstNode> [{ }] [{ }] {
    bad = failed(noNode(), ts);
    if k = 0 && size(ts) = 3 {
        f = refAt(ts, 1, nodes, 9);
        xs = refAt(ts, 2, nodes, 27);
        if !f.ok || !xs.ok { return bad; };
        return done(AstNode::Proof { value: AstProof::FApp { f: f.value, xs: xs.value } }, size(ts));
    };
    if k = 1 && size(ts) = 2 {
        n = refAt(ts, 1, nodes, 1);
        if !n.ok { return bad; };
        return done(AstNode::Proof { value: AstProof::ATerm { n: n.value } }, size(ts));
    };
    if k = 2 && size(ts) = 2 {
        v = refAt(ts, 1, nodes, 4);
        if !v.ok { return bad; };
        return done(AstNode::Proof { value: AstProof::CTerm { v: v.value } }, size(ts));
    };
    if k = 3 && size(ts) = 4 {
        n = refAt(ts, 1, nodes, 1);
        gs = refAt(ts, 2, nodes, 27);
        b = refAt(ts, 3, nodes, 9);
