import data::codec::codec { Token, Parsed, Size, Type, hexValue, quoted, catStrings, renderTypeForName, printInt, printName, printNames, newLine, printType };
import data::ast::ast { AstName, AstValue, AstBody, AstExpression, AstTermination, AstValidation, AstProof, AstRule, AstStatement, AstSignature, AstTraitFn, AstBound, AstField, AstVariant, AstValueField, AstArg, AstOptName, AstOptTermination, AstBuiltin, AstNames, AstValues, AstStatements, AstExpressions, AstValidations, AstProofs, AstFields, AstVariants, AstValueFields, AstTypes, AstArgs, AstTraitFns, AstBounds, AstElaborated, AstNode, AstProgram, printBool, printAst };
import data::arena::arena { reorderArena };

// The Tersus parser, written in Tersus: reads source segments and writes the AST as data (`tersus-ast 1 parsed`, AST_DATA.md), using the shared AST/file codecs. The host protocol is documented in AST_DATA.md.

// ---- parser state ----

struct CtorInfo { name: String, fields: List<String>, active: Bool };
impl Clone for CtorInfo { };
struct FieldInfo { name: String, ty: Type };
impl Clone for FieldInfo { };
struct FieldsInfo { name: String, fields: List<FieldInfo> };
impl Clone for FieldsInfo { };
struct TypeInfo { name: String, variants: List<String>, active: Bool };
impl Clone for TypeInfo { };
struct GenInfo { name: String, params: List<String>, active: Bool };
impl Clone for GenInfo { };
struct ArgV { isSize: Bool, size: Size, ty: Type };
impl Clone for ArgV { };

struct Input { text: String, starts: List<Int>, columns: List<Int> };

fn newInput(text: String) -> Input ~ {
    starts = push([], 0);
    columns = push([], 1);
    col = 1;
    i = 0;
    while i < size(text.bytes) [{ affirm i >= 0; affirm i <= size(text.bytes) + 4; }] ~ {
        c = toInt(get(&text.bytes, i));
        width = 1;
        if c = 10 { col = 1; starts = push(starts, i + 1); }
        else {
            if c = 9 { col = col + 8 - (col - 1) % 8; }
            else {
                if c >= 128 { d = decodeStrAt(text, i); width = get(d, 1); };
                col = col + 1;
            };
        };
        if width < 1 { width = 1; };
        if width > 4 { width = 4; };
        columns = push(columns, col);
        if width >= 2 { columns = push(columns, col); };
        if width >= 3 { columns = push(columns, col); };
        if width >= 4 { columns = push(columns, col); };
        i = i + width;
    };
    return Input { text: text, starts: starts, columns: columns };
};

fn inputLineCol(input: &Input, pos: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; }] ~ {
    at = pos;
    if at < 0 { at = 0; };
    if at > (size(input.columns) - 1) { at = (size(input.columns) - 1); };
    lo = 0;
    hi = size(input.starts);
    while lo + 1 < hi ~ {
        mid = lo + (hi - lo) / 2;
        if intAtOr(&input.starts, mid, 0) <= at { lo = mid; } else { hi = mid; };
    };
    return push(push([], lo + 1), intAtOr(&input.columns, at, 1));
};

struct St {
    pos: Int, nodes: List<AstNode>,
    ctors: List<CtorInfo>, fieldsOf: List<FieldsInfo>, types: List<TypeInfo>, generics: List<GenInfo>,
    selfName: String, hasSelf: Bool, selfTy: Type, hasSelfTy: Bool,
    typeParams: List<String>, implParams: List<String>, ownClone: Bool, locate: Bool,
    err: String, errPos: Int, genLine: Int, genCol: Int
};
impl Clone for St { };

struct Checkpoint { state: St, nodeCount: Int, ctorCount: Int, fieldCount: Int, typeCount: Int, genericCount: Int };

fn checkpoint(st: &St) -> Checkpoint ~ {
    saved = St { pos: st.pos, nodes: [], ctors: [], fieldsOf: [], types: [], generics: [],
        selfName: clone(st.selfName), hasSelf: st.hasSelf, selfTy: clone(st.selfTy), hasSelfTy: st.hasSelfTy,
        typeParams: clone(st.typeParams), implParams: clone(st.implParams), ownClone: st.ownClone, locate: st.locate,
        err: clone(st.err), errPos: st.errPos, genLine: st.genLine, genCol: st.genCol };
    return Checkpoint { state: saved, nodeCount: size(st.nodes), ctorCount: size(st.ctors), fieldCount: size(st.fieldsOf), typeCount: size(st.types), genericCount: size(st.generics) };
};

fn restore(st: St, saved: Checkpoint) -> St ~ {
    St { pos: ignoredPos, nodes: nodes, ctors: ctors, fieldsOf: fieldsOf, types: types, generics: generics,
        selfName: ignoredSelf, hasSelf: ignoredHasSelf, selfTy: ignoredSelfType, hasSelfTy: ignoredHasSelfType,
        typeParams: ignoredTypeParams, implParams: ignoredImplParams, ownClone: ignoredClone, locate: ignoredLocate,
        err: ignoredError, errPos: ignoredErrorPos, genLine: ignoredLine, genCol: ignoredCol } = st;
    while size(nodes) > saved.nodeCount && size(nodes) > 0 ~ { nodes = pop(nodes); };
    while size(ctors) > saved.ctorCount && size(ctors) > 0 ~ { ctors = pop(ctors); };
    while size(fieldsOf) > saved.fieldCount && size(fieldsOf) > 0 ~ { fieldsOf = pop(fieldsOf); };
    while size(types) > saved.typeCount && size(types) > 0 ~ { types = pop(types); };
    while size(generics) > saved.genericCount && size(generics) > 0 ~ { generics = pop(generics); };
    return St { nodes: nodes, ctors: ctors, fieldsOf: fieldsOf, types: types, generics: generics, ..saved.state };
};

fn probeState(st: &St) -> St ~ {
    base = checkpoint(st).state;
    return St { ctors: clone(st.ctors), fieldsOf: clone(st.fieldsOf), types: clone(st.types), generics: clone(st.generics), ..base };
};

struct Res<T> { st: St, v: T, ok: Bool };
impl<T> Clone for Res<T> { };
struct LitOut { name: String, ctorArgs: List<ArgV>, declared: List<String>, isVariant: Bool };
impl Clone for LitOut { };
struct Arm { name: String, fields: List<String>, vars: List<String>, body: List<Int> };
struct IdPair { a: Int, b: Int };
impl Clone for IdPair { };
impl Clone for Arm { };
struct MatchHead { scrutinee: Int };
impl Clone for MatchHead { };
struct HeaderOut { names: List<String>, types: List<Type>, ret: Type, ins: List<Int>, outs: List<Int>, writes: List<String>, froms: List<String> };
impl Clone for HeaderOut { };
struct ParamOut { names: List<String>, types: List<Type> };
impl Clone for ParamOut { };
struct OneParam { name: String, ty: Type };
impl Clone for OneParam { };
struct GenParam { name: String, boundTraits: List<String>, boundArgs: List<List<Type>> };
impl Clone for GenParam { };
struct FieldOut { name: String, ty: Type };
impl Clone for FieldOut { };


fn newSt() -> St ~ {
    return St { pos: 0, nodes: [], ctors: [], fieldsOf: [], types: [], generics: [],
        selfName: "", hasSelf: false, selfTy: Type::TInt, hasSelfTy: false,
        typeParams: [], implParams: [], ownClone: false, locate: false, err: "", errPos: 0, genLine: 0, genCol: 0 };
};

fn fail<T>(st: St, v: T, msg: &String) -> Res<T> ~ {
    s = st;
    if size(s.err.bytes) = 0 || s.pos > s.errPos { s = St { err: clone(msg), errPos: s.pos, ..s }; };
    return Res<T> { st: s, v: v, ok: false };
};

fn ok<T>(st: St, v: T) -> Res<T> ~ {
    s = st;
    if size(s.err.bytes) > 0 && s.pos >= s.errPos { s = St { err: "", errPos: 0, ..s }; };
    return Res<T> { st: s, v: v, ok: true };
};

fn nameAtOr(xs: &List<String>, i: Int, fallback: &String) -> String ~ {
    if i < 0 || i >= size(xs) { return clone(fallback); };
    return clone(get(xs, i));
};

fn armAt(arms: &List<Arm>, i: Int) -> Arm ~ {
    if i < 0 || i >= size(arms) { return Arm { name: "", fields: [], vars: [], body: [] }; };
    return clone(get(arms, i));
};

fn intAtOr(xs: &List<Int>, i: Int, fallback: Int) -> Int ~ {
    if i < 0 || i >= size(xs) { return fallback; };
    return get(xs, i);
};

fn typeAtOr(xs: &List<Type>, i: Int) -> Type ~ {
    if i < 0 || i >= size(xs) { return Type::TInt; };
    return clone(get(xs, i));
};

fn typesAtOr(xs: &List<List<Type>>, i: Int) -> List<Type> ~ {
    if i < 0 || i >= size(xs) { return []; };
    return clone(get(xs, i));
};

fn nodeAtList(xs: &List<AstNode>, i: Int) -> AstNode ~ {
    if i < 0 || i >= size(xs) { return AstNode::Name { value: AstName::End }; };
    return clone(get(xs, i));
};

fn nodeAt(st: &St, id: Int) -> AstNode ~ {
    if id < 0 || id >= size(st.nodes) { return AstNode::Name { value: AstName::End }; };
    return nodeAtList(&st.nodes, id);
};

fn setNodeAt(st: St, id: Int, node: AstNode) -> St ~ {
    if id < 0 || id >= size(st.nodes) { return st; };
    return St { nodes: set(st.nodes, id, node), ..st };
};

fn emit(st: St, node: AstNode) -> Res<Int> ~ {
    s = st;
    id = size(s.nodes);
    s = St { nodes: push(s.nodes, node), ..s };
    return ok( s, id);
};

// ---- character helpers (source is UTF-8 bytes; a character is a code point) ----

fn srcSlice(sourceText: &Input, st: &St, from: Int, to: Int) -> String ~ {
    if from < 0 || to < from || to > (size(sourceText.columns) - 1) { return ""; };
    return strSlice(&sourceText.text, from, to);
};

fn strSlice(text: &String, from: Int, to: Int) -> String ~ {
    if from < 0 || to < from || to > size(text.bytes) { return ""; };
    bytes = [];
    i = from;
    while i < to [{ affirm i >= from; affirm i <= to; }] ~ {
        bytes = push(bytes, get(&text.bytes, i));
        i = i + 1;
    };
    return String { bytes: bytes };
};

fn byteAt(sourceText: &Input, st: &St, i: Int) -> Int ~ {
    bytes = &sourceText.text.bytes;
    if i < 0 || i >= size(bytes) { return 0 - 1; };
    return toInt(get(bytes, i));
};

fn decodeAt(sourceText: &Input, st: &St, i: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; affirm get(return, 0) >= 0 - 1; affirm get(return, 1) >= 0; affirm get(return, 1) <= 4; }] ~ {
    // [code point, byte length]; an invalid byte is its own value with length 1
    c = byteAt(sourceText, st, i);
    if c < 0 { return push(push([], 0 - 1), 0); };
    if c < 128 { return push(push([], c), 1); };
    if c >= 194 && c <= 223 {
        b = byteAt(sourceText, st, i + 1);
        if b >= 128 && b <= 191 { return push(push([], (c - 192) * 64 + b - 128), 2); };
        return push(push([], c), 1);
    };
    if c >= 224 && c <= 239 {
        b = byteAt(sourceText, st, i + 1);
        d = byteAt(sourceText, st, i + 2);
        if b >= 128 && b <= 191 && d >= 128 && d <= 191 { return push(push([], (c - 224) * 4096 + (b - 128) * 64 + d - 128), 3); };
        return push(push([], c), 1);
    };
    if c >= 240 && c <= 244 {
        b = byteAt(sourceText, st, i + 1);
        d = byteAt(sourceText, st, i + 2);
        e = byteAt(sourceText, st, i + 3);
        if b >= 128 && b <= 191 && d >= 128 && d <= 191 && e >= 128 && e <= 191 { return push(push([], (c - 240) * 262144 + (b - 128) * 4096 + (d - 128) * 64 + e - 128), 4); };
        return push(push([], c), 1);
    };
    return push(push([], c), 1);
};

fn decodeStrAt(name: &String, i: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; affirm get(return, 1) >= 0; affirm get(return, 1) <= 4; }] ~ {
    // [code point, byte length] in a String's bytes; an invalid byte is its own value with length 1
    if i < 0 || i >= size(name.bytes) { return push(push([], 0 - 1), 0); };
    c = toInt(get(&name.bytes, i));
    if c < 128 { return push(push([], c), 1); };
    if c >= 194 && c <= 223 {
        if i + 1 < size(name.bytes) {
            b = toInt(get(&name.bytes, i + 1));
            if b >= 128 && b <= 191 { return push(push([], (c - 192) * 64 + b - 128), 2); };
        };
        return push(push([], c), 1);
    };
    if c >= 224 && c <= 239 {
        if i + 2 < size(name.bytes) {
            b = toInt(get(&name.bytes, i + 1));
            d = toInt(get(&name.bytes, i + 2));
            if b >= 128 && b <= 191 && d >= 128 && d <= 191 { return push(push([], (c - 224) * 4096 + (b - 128) * 64 + d - 128), 3); };
        };
        return push(push([], c), 1);
    };
    if c >= 240 && c <= 244 {
        if i + 3 < size(name.bytes) {
            b = toInt(get(&name.bytes, i + 1));
            d = toInt(get(&name.bytes, i + 2));
            e = toInt(get(&name.bytes, i + 3));
            if b >= 128 && b <= 191 && d >= 128 && d <= 191 && e >= 128 && e <= 191 { return push(push([], (c - 240) * 262144 + (b - 128) * 4096 + (d - 128) * 64 + e - 128), 4); };
        };
        return push(push([], c), 1);
    };
    return push(push([], c), 1);
};

fn isLetterCp(cp: Int) -> Bool ~ {
    if cp >= 128 { return parserUnicodeLetter(cp); };
    return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122);
};

fn isDigitCp(cp: Int) -> Bool ~ { return cp >= 48 && cp <= 57; };

fn isIdentCp(cp: Int) -> Bool ~ { return isLetterCp(cp) || isDigitCp(cp); };

fn isUpperCp(cp: Int) -> Bool ~ {
    if cp >= 65 && cp <= 90 { return true; };
    if cp >= 128 { return parserUnicodeUpper(cp); };
    return false;
};

fn isTypeParamName(name: &String) -> Bool ~ {
    if size(name.bytes) = 0 { return false; };
    first = decodeStrAt(name, 0);
    return isUpperCp(get(first, 0));
};

fn lineCol(src: &String, pos: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; }] ~ {
    line = 1;
    col = 1;
    i = 0;
    while i < pos && i < size(src.bytes) [{ affirm i >= 0; affirm i <= size(src.bytes) + 4; }] ~ {
        c = toInt(get(&src.bytes, i));
        if c = 10 { line = line + 1; col = 1; i = i + 1; }
        else {
            if c = 9 { col = col + 8 - (col - 1) % 8; i = i + 1; }
            else {
                d = decodeStrAt(src, i);
                col = col + 1;
                i = i + get(d, 1);
            };
        };
    };
    return push(push([], line), col);
};

fn srcLineCol(sourceText: &Input, st: &St, pos: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; }] ~ {
    lc = inputLineCol(sourceText, pos);
    if st.genCol > 0 { return push(push([], st.genLine), st.genCol + get(lc, 1) - 1); };
    return lc;
};

fn skipWs(sourceText: &Input, st: St) -> St ~ {
    s = st;
    loop = true;
    while loop ~ {
        c = byteAt(sourceText, s, s.pos);
        if c = 32 || c = 13 || c = 10 || c = 9 { s = St { pos: s.pos + 1, ..s }; }
        else {
            if c = 47 && byteAt(sourceText, s, s.pos + 1) = 47 {
                s = St { pos: s.pos + 2, ..s };
                while s.pos < (size(sourceText.columns) - 1) && byteAt(sourceText, s, s.pos) != 10 ~ { s = St { pos: s.pos + 1, ..s }; };
            } else { loop = false; };
        };
    };
    return s;
};

fn atEnd(sourceText: &Input, st: &St) -> Bool ~ { return st.pos >= (size(sourceText.columns) - 1); };

fn peekIs(sourceText: &Input, st: &St, text: &String) -> Bool ~ {
    if st.pos + size(text.bytes) > (size(sourceText.columns) - 1) { return false; };
    i = 0;
    while i < size(text.bytes) [{ affirm i >= 0; affirm i <= size(text.bytes); }] ~ {
        if byteAt(sourceText, st, st.pos + i) != toInt(get(&text.bytes, i)) { return false; };
        i = i + 1;
    };
    return true;
};

fn eat(sourceText: &Input, st: St, text: &String) -> Res<Bool> ~ {
    if peekIs(sourceText, st, text) { s = st; s = St { pos: s.pos + size(text.bytes), ..s }; return ok( s, true); };
    return ok( st, false);
};

fn keywordAt(sourceText: &Input, st: &St, kw: &String) -> Bool ~ {
    if !peekIs(sourceText, st, kw) { return false; };
    after = st.pos + size(kw.bytes);
    if after >= (size(sourceText.columns) - 1) { return true; };
    d = decodeAt(sourceText, st, after);
    return !isIdentCp(get(d, 0));
};

fn eatKeyword(sourceText: &Input, st: St, kw: &String) -> Res<Bool> ~ {
    if keywordAt(sourceText, st, kw) { s = st; s = St { pos: s.pos + size(kw.bytes), ..s }; return ok( s, true); };
    return ok( st, false);
};

fn expectText(sourceText: &Input, st: St, text: &String, what: &String) -> Res<Bool> ~ {
    r = eat(sourceText, st, text); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    if resultPartsrValue { return Res<Bool> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
    return fail( resultPartsrState, false, catStrings("expected ", clone(what)));
};

fn parseVariable(sourceText: &Input, st: St) -> Res<String> ~ {
    d = decodeAt(sourceText, st, st.pos);
    cp = get(d, 0);
    if cp < 0 || !isLetterCp(cp) { return fail( st, "", "expected a name"); };
    s = st;
    start = s.pos;
    s = St { pos: s.pos + get(d, 1), ..s };
    loop = true;
    while loop ~ {
        d2 = decodeAt(sourceText, s, s.pos);
        cp2 = get(d2, 0);
        if cp2 >= 0 && isIdentCp(cp2) { s = St { pos: s.pos + get(d2, 1), ..s }; } else { loop = false; };
    };
    return ok( s, srcSlice(sourceText, s, start, s.pos));
};

fn containsName(xs: &List<String>, x: &String) -> Bool ~ {
    for v in &xs { if v = x { return true; }; };
    return false;
};

fn indexOfName(xs: &List<String>, x: &String) -> Int [{ }] [{ affirm return < size(xs); affirm return >= 0 - 1; }] ~ {
    i = 0;
    for v in &xs { if v = x { return i; }; i = i + 1; };
    return 0 - 1;
};

fn reversedStrings(xs: &List<String>) -> List<String> ~ {
    out = [];
    i = size(xs) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(xs); }] ~ { out = push(out, clone(get(xs, i))); i = i - 1; };
    return out;
};

fn reversedInts(xs: &List<Int>) -> List<Int> ~ {
    out = [];
    i = size(xs) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(xs); }] ~ { out = push(out, get(xs, i)); i = i - 1; };
    return out;
};

fn cat3(a: &String, b: &String, c: &String) -> String ~ { return catStrings(catStrings(a, b), c); };

// ---- arena builders, in AstData's emission order ----

fn putName(st: St, name: &String) -> Res<Int> ~ {
    // split at '.' boundaries into chunks of at most 512 name characters, as Haskell's AstData name encoding does
    chunks = [];
    start = 0;
    count = 0;
    i = 0;
    while i < size(name.bytes) ~ {
        d = decodeStrAt(name, i);
        len = get(d, 1);
        if len <= 0 { len = 1; };
        if count = 512 { chunks = push(chunks, strSlice(name, start, i)); start = i; count = 0; };
        count = count + 1;
        i = i + len;
    };
    chunks = push(chunks, strSlice(name, start, size(name.bytes)));
    if size(name.bytes) = 0 { chunks = []; };
    r = emit( st, AstNode::Name { value: AstName::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return putNameGo( resultPartsrState, reversedStrings(chunks), 0, resultPartsrValue);
};

fn putNameGo(st: St, rev: &List<String>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        e = emit( state, AstNode::Name { value: AstName::Part { text: clone(get(rev, cursor)), tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};
fn putTypeNode(st: St, t: Type) -> Res<Int> ~ { return emit( st, AstNode::Type { value: t }); };

fn putSizeNode(st: St, s: Size) -> Res<Int> ~ { return emit( st, AstNode::Size { value: s }); };

fn namesList(st: St, xs: &List<String>) -> Res<Int> ~ {
    r = emit( st, AstNode::Names { value: AstNames::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return namesListGo( resultPartsrState, reversedStrings(xs), 0, resultPartsrValue);
};

fn namesListGo(st: St, rev: &List<String>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        h = putName( state, get(rev, cursor));
        Res { st: namedState, v: head, ok: namedOk } = h;
        if !namedOk { return Res<Int> { st: namedState, v: 0, ok: false }; };
        e = emit( namedState, AstNode::Names { value: AstNames::Cons { head: head, tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};

fn statementsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit( st, AstNode::Statements { value: AstStatements::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return statementsListGo( resultPartsrState, reversedInts(xs), 0, resultPartsrValue);
};

fn statementsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        e = emit( state, AstNode::Statements { value: AstStatements::Cons { head: get(rev, cursor), tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};

fn expressionsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit( st, AstNode::Expressions { value: AstExpressions::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return expressionsListGo( resultPartsrState, reversedInts(xs), 0, resultPartsrValue);
};

fn expressionsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        e = emit( state, AstNode::Expressions { value: AstExpressions::Cons { head: get(rev, cursor), tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};

fn validationsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit( st, AstNode::Validations { value: AstValidations::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return validationsListGo( resultPartsrState, reversedInts(xs), 0, resultPartsrValue);
};

fn validationsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        e = emit( state, AstNode::Validations { value: AstValidations::Cons { head: get(rev, cursor), tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};

fn proofsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit( st, AstNode::Proofs { value: AstProofs::End }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return proofsListGo( resultPartsrState, reversedInts(xs), 0, resultPartsrValue);
};

fn proofsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    state = st;
    cursor = i;
    result = tail;
    while cursor < size(rev) [{ affirm cursor >= i; affirm cursor >= 0; }] ~ {
        e = emit( state, AstNode::Proofs { value: AstProofs::Cons { head: get(rev, cursor), tail: result } });
        Res { st: nextState, v: nextId, ok: nextOk } = e;
        state = nextState;
        result = nextId;
        cursor = cursor + 1;
    };
    return ok( state, result);
};

