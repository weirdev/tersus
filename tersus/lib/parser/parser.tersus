fn putArgNode(st: St, a: ArgV) -> Res<Int> ~ {
    if a.isSize {
        s = putSizeNode( st, a.size); Res { st: resultPartssState, v: resultPartssValue, ok: resultPartssOk } = s;
        if !resultPartssOk { return Res<Int> { st: resultPartssState, v: resultPartssValue, ok: resultPartssOk }; };
        return emit( resultPartssState, AstNode::Arg { value: AstArg::ArgSize { s: resultPartssValue } });
    };
    t = putTypeNode( st, a.ty); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
    if !resultPartstOk { return Res<Int> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk }; };
    return emit( resultPartstState, AstNode::Arg { value: AstArg::ArgType { t: resultPartstValue } });
};

fn putArgsNodes(st: St, xs: &List<ArgV>) -> Res<Int> ~ {
    ids = [];
    s = st;
    for a in &xs {
        r = putArgNode( s, clone(a)); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
        if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
        s = resultPartsrState;
        ids = push(ids, resultPartsrValue);
    };
    return argsList( s, ids);
};

fn putTypesNodes(st: St, xs: &List<Type>) -> Res<Int> ~ {
    ids = [];
    s = st;
    for t in &xs {
        r = putTypeNode( s, clone(t)); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
        if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
        s = resultPartsrState;
        ids = push(ids, resultPartsrValue);
    };
    return typesList( s, ids);
};

fn optNameNode(st: St, has: Bool, name: &String) -> Res<Int> ~ {
    if !has { return emit( st, AstNode::OptName { value: AstOptName::NoName }); };
    n = putName( st, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    return emit( resultPartsnState, AstNode::OptName { value: AstOptName::SomeName { n: resultPartsnValue } });
};

fn emptyValidations(st: St) -> Res<Int> ~ { return emit( st, AstNode::Validations { value: AstValidations::End }); };

fn emptyProofs(st: St) -> Res<Int> ~ { return emit( st, AstNode::Proofs { value: AstProofs::End }); };

// ---- builtins: primitive name -> parameter names (BuiltinRegistry.entryParams via builtinSymbol) ----

fn primParams(name: &String) -> List<String> ~ {
    if name = "Size" || name = "First" || name = "Last" || name = "Pop" { return push([], "list"); };
    if name = "Get" { return push(push([], "list"), "index"); };
    if name = "Push" { return push(push([], "list"), "x"); };
    if name = "Set" || name = "Replace" { return push(push(push([], "list"), "index"), "x"); };
    if name = "Plus" || name = "Minus" || name = "Times" || name = "Div" || name = "Mod" || name = "And" || name = "Or" || name = "Within" { return push(push([], "a"), "b"); };
    if name = "Not" { return push([], "a"); };
    if name = "NewArray" || name = "NewBoxedArray" { return push(push([], "n"), "x"); };
    if name = "ArrayFrom" || name = "ArrayFromList" || name = "BytesFrom" { return push([], "list"); };
    if name = "NewEmptyArray" || name = "ReadByte" || name = "ArgCount" || name = "FileLoad" || name = "FileStore" || name = "AddrNull" || name = "UninitEmpty" { return []; };
    if name = "WriteByte" || name = "WriteError" || name = "PathByte" || name = "StoreByte" { return push([], "b"); };
    if name = "ArgByte" { return push(push([], "i"), "j"); };
    if name = "FileByte" { return push([], "i"); };
    if name = "ToByte" { return push([], "x"); };
    if name = "FromByte" { return push([], "b"); };
    if name = "Unsize" || name = "UnBox" { return push([], "box"); };
    if name = "NewBox" || name = "CloneOf" { return push([], "value"); };
    if name = "BorrowOf" || name = "BorrowMutOf" || name = "OldOf" { return push([], "place"); };
    if name = "DerefOf" { return push([], "reference"); };
    if name = "AddrOffset" { return push(push([], "p"), "i"); };
    if name = "AddrCast" || name = "AddrToInt" { return push([], "p"); };
    if name = "AddrFromInt" || name = "AddrAlloc" { return push([], "n"); };
    if name = "AddrGet" || name = "AddrTake" || name = "AddrDropValue" { return push(push(push([], "p"), "i"), "b"); };
    if name = "AddrWrite" { return push(push(push(push([], "p"), "i"), "x"), "b"); };
    if name = "AddrDropRange" { return push(push(push(push([], "p"), "i"), "n"), "b"); };
    if name = "AddrResize" { return push(push(push([], "p"), "n"), "b"); };
    if name = "AddrFree" { return push(push([], "p"), "b"); };
    if name = "AllocPair" { return push([], "a1"); };
    if name = "TakePair" || name = "ResizePair" { return push(push(push([], "a1"), "a2"), "a3"); };
    if name = "SplitPair" { return push(push([], "a1"), "a2"); };
    if name = "BlockNew" || name = "BlockAssume" { return push(push([], "p"), "n"); };
    if name = "BlockTaken" || name = "BlockSplitLo" || name = "BlockSplitHi" { return push(push([], "b"), "i"); };
    if name = "BlockResized" { return push(push(push([], "b"), "q"), "n"); };
    if name = "BlockJoin" { return push(push([], "lo"), "hi"); };
    if name = "BlockCast" { return push([], "b"); };
    if name = "BlockBase" || name = "BlockCap" || name = "BlockFilled" || name = "BlockContents" || name = "BlockOrigin" || name = "BlockStart" || name = "BlockExtent" || name = "BlockCount" { return push([], "a1"); };
    if name = "UninitNew" { return push([], "x"); };
    if name = "UninitGet" || name = "UninitTake" || name = "UninitDiscard" || name = "UninitFilled" || name = "UninitAt" { return push([], "u"); };
    return [];
};

fn builtinValue(st: St, b: AstBuiltin, params: &List<String>) -> Res<Int> ~ {
    // VFunct params [] [] (BuiltinFunct b) []
    ps = namesList( st, params); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    ins = emptyValidations( resultPartspsState); Res { st: resultPartsinsState, v: resultPartsinsValue, ok: resultPartsinsOk } = ins;
    outs = emptyValidations( resultPartsinsState); Res { st: resultPartsoutsState, v: resultPartsoutsValue, ok: resultPartsoutsOk } = outs;
    bn = emit( resultPartsoutsState, AstNode::Builtin { value: b }); Res { st: resultPartsbnState, v: resultPartsbnValue, ok: resultPartsbnOk } = bn;
    body = emit( resultPartsbnState, AstNode::Body { value: AstBody::BuiltinFunct { b: resultPartsbnValue } }); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    ex = emptyProofs( resultPartsbodyState); Res { st: resultPartsexState, v: resultPartsexValue, ok: resultPartsexOk } = ex;
    return emit( resultPartsexState, AstNode::Value { value: AstValue::VFunct { ps: resultPartspsValue, ins: resultPartsinsValue, outs: resultPartsoutsValue, body: resultPartsbodyValue, exports: resultPartsexValue } });
};

fn primValue(st: St, name: &String) -> Res<Int> ~ {
    return builtinValue( st, AstBuiltin::Primitive { name: clone(name) }, primParams(name));
};

fn relValue(st: St, r: Int) -> Res<Int> ~ {
    return builtinValue( st, AstBuiltin::Rel { r: r }, push(push([], "a"), "b"));
};

fn relIndexOf(op: &String) -> Int ~ {
    if op = "=" { return 0; };
    if op = "!=" { return 1; };
    if op = "<" { return 2; };
    if op = ">" { return 3; };
    if op = "<=" { return 4; };
    if op = ">=" { return 5; };
    return 0 - 1;
};

// the builtin a name in a proof stands for (BuiltinRegistry.proofBuiltinByName), as a primitive name; "" for none
fn proofPrimName(name: &String) -> String ~ {
    if name = "size" { return "Size"; };
    if name = "first" { return "First"; };
    if name = "last" { return "Last"; };
    if name = "get" { return "Get"; };
    if name = "push" { return "Push"; };
    if name = "pop" { return "Pop"; };
    if name = "set" { return "Set"; };
    if name = "array" { return "NewArray"; };
    return "";
};

// the builtin `builtin fn name` declares (BuiltinRegistry.builtinDecls): primitive name; "" for none
fn declPrimName(name: &String) -> String ~ {
    if name = "size" { return "Size"; };
    if name = "first" { return "First"; };
    if name = "last" { return "Last"; };
    if name = "get" { return "Get"; };
    if name = "push" { return "Push"; };
    if name = "pop" { return "Pop"; };
    if name = "set" { return "Set"; };
    if name = "plus" { return "Plus"; };
    if name = "minus" { return "Minus"; };
    if name = "times" { return "Times"; };
    if name = "div" { return "Div"; };
    if name = "mod" { return "Mod"; };
    if name = "array" { return "NewArray"; };
    if name = "arrayFrom" { return "ArrayFrom"; };
    if name = "arrayFromList" { return "ArrayFromList"; };
    if name = "arrayBoxed" { return "NewBoxedArray"; };
    if name = "arrayEmpty" { return "NewEmptyArray"; };
    if name = "writeByte" { return "WriteByte"; };
    if name = "writeError" { return "WriteError"; };
    if name = "readByte" { return "ReadByte"; };
    if name = "argCount" { return "ArgCount"; };
    if name = "argByte" { return "ArgByte"; };
    if name = "pathByte" { return "PathByte"; };
    if name = "fileLoad" { return "FileLoad"; };
    if name = "fileByte" { return "FileByte"; };
    if name = "storeByte" { return "StoreByte"; };
    if name = "fileStore" { return "FileStore"; };
    if name = "toByte" { return "ToByte"; };
    if name = "toInt" { return "FromByte"; };
    if name = "bytesFrom" { return "BytesFrom"; };
    if name = "unsize" { return "Unsize"; };
    if name = "boxNew" { return "NewBox"; };
    if name = "boxUnbox" { return "UnBox"; };
    if name = "cloneOf" { return "CloneOf"; };
    return "";
};

// ---- type tokens and rendered names (DataCodec.typeTokens, Types.renderTypeForName) ----

fn wordTok(w: &String) -> Token ~ { return Token { quoted: false, text: clone(w) }; };

fn nameTok(w: &String) -> Token ~ { return Token { quoted: true, text: clone(w) }; };

fn sizeTokensOf(s: Size) -> List<Token> ~ {
    return match s {
        Size::SConst { n: n } => push(push([], wordTok("c")), wordTok(String::fromInt(n))),
        Size::SAny => push([], wordTok("any")),
        Size::SParam { name: name } => push(push([], wordTok("p")), nameTok(name)),
        Size::SVar { n: n } => push(push([], wordTok("v")), wordTok(String::fromInt(n))),
    };
};

fn argTokensOf(a: ArgV) -> List<Token> ~ {
    if a.isSize { out = push([], wordTok("size")); for t in sizeTokensOf(a.size) { out = push(out, clone(t)); }; return out; };
    out = push([], wordTok("type"));
    for t in typeTokensOf(a.ty) { out = push(out, clone(t)); };
    return out;
};

fn typeTokensOf(t: Type) -> List<Token> ~ {
    out = [];
    match t {
        Type::TInt => { out = push([], wordTok("int")); },
        Type::TByte => { out = push([], wordTok("byte")); },
        Type::TBool => { out = push([], wordTok("bool")); },
        Type::TWord { signed: signed, bits: bits } => {
            w = "u32";
            if signed && bits = 8 { w = "i8"; };
            if signed && bits = 16 { w = "i16"; };
            if signed && bits = 32 { w = "i32"; };
            if !signed && bits = 16 { w = "u16"; };
            out = push([], wordTok(w));
        },
        Type::TList { elem: e } => { out = push(push(push(push([], wordTok("named")), nameTok("List")), wordTok("1")), wordTok("type")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TArray { elem: e, size: s } => { out = push([], wordTok("array")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; for x in sizeTokensOf(s) { out = push(out, clone(x)); }; },
        Type::TBox { inner: e } => { out = push(push(push(push([], wordTok("named")), nameTok("Box")), wordTok("1")), wordTok("type")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TAddr { inner: e } => { out = push([], wordTok("addr")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TBlock { inner: e } => { out = push([], wordTok("block")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TUninit { inner: e } => { out = push([], wordTok("uninit")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TRef { inner: e } => { out = push([], wordTok("ref")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TMutRef { inner: e } => { out = push([], wordTok("mutref")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TFn { args: args, ret: r } => {
            out = push(push([], wordTok("fn")), wordTok(String::fromInt(size(args))));
            for a in args { for x in typeTokensOf(clone(a)) { out = push(out, clone(x)); }; };
            for x in typeTokensOf(Box::unbox(r)) { out = push(out, clone(x)); };
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            out = push(push(push([], wordTok("named")), nameTok(base)), wordTok(String::fromInt(argc)));
            for x in argTokens { out = push(out, clone(x)); };
        },
        Type::TVariant { name: name } => { out = push(push([], wordTok("variant")), nameTok(name)); },
        Type::TVar { n: n } => { out = push(push([], wordTok("var")), wordTok(String::fromInt(n))); },
        Type::TParam { name: name } => { out = push(push([], wordTok("param")), nameTok(name)); },
        Type::TForall { sizes: sizes, types: types, body: body } => {
            out = push(push([], wordTok("forall")), wordTok(String::fromInt(size(sizes))));
            for s in sizes { out = push(out, nameTok(s)); };
            out = push(out, wordTok(String::fromInt(size(types))));
            for s in types { out = push(out, nameTok(s)); };
            for x in typeTokensOf(Box::unbox(body)) { out = push(out, clone(x)); };
        },
    };
    return out;
};

fn renderSizeName(s: Size) -> String ~ {
    return match s {
        Size::SConst { n: n } => String::fromInt(n),
        Size::SAny => "?",
        Size::SParam { name: name } => clone(name),
        Size::SVar { n: n } => catStrings("_", String::fromInt(n)),
    };
};

fn renderTypeName(t: Type) -> String ~ {
    r = "";
    match t {
        Type::TInt => { r = "Int"; },
        Type::TByte => { r = "Byte"; },
        Type::TBool => { r = "Bool"; },
        Type::TWord { signed: signed, bits: bits } => { if signed { r = catStrings("I", String::fromInt(bits)); } else { r = catStrings("U", String::fromInt(bits)); }; },
        Type::TList { elem: e } => { r = cat3("List<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TBox { inner: e } => { r = cat3("Box<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TAddr { inner: e } => { r = cat3("Addr<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TBlock { inner: e } => { r = cat3("Block<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TUninit { inner: e } => { r = cat3("Uninit<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TRef { inner: e } => { r = catStrings("&", renderTypeName(Box::unbox(e))); },
        Type::TMutRef { inner: e } => { r = catStrings("&mut ", renderTypeName(Box::unbox(e))); },
        Type::TArray { elem: e, size: s } => { r = catStrings(cat3("Array<", renderTypeName(Box::unbox(e)), ", "), catStrings(renderSizeName(s), ">")); },
        Type::TFn { args: args, ret: ret } => {
            parts = "fn(";
            i = 0;
            for a in args { if i > 0 { parts = catStrings(parts, ", "); }; parts = catStrings(parts, renderTypeName(clone(a))); i = i + 1; };
            r = cat3(catStrings(parts, ") -> "), renderTypeName(Box::unbox(ret)), "");
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => { r = clone(name); },
        Type::TVariant { name: name } => { r = clone(name); },
        Type::TVar { n: n } => { r = catStrings("?", String::fromInt(n)); },
        Type::TParam { name: name } => { r = catStrings("'", clone(name)); },
        Type::TForall { sizes: sizes, types: types, body: body } => { r = renderTypeName(Box::unbox(body)); },
    };
    return r;
};

fn renderArgName(a: ArgV) -> String ~ {
    if a.isSize { return renderSizeName(a.size); };
    return renderTypeName(a.ty);
};

fn instanceNameOf(base: &String, args: &List<ArgV>) -> String ~ {
    if size(args) = 0 { return clone(base); };
    joined = "";
    i = 0;
    for a in &args { if i > 0 { joined = catStrings(joined, ", "); }; joined = catStrings(joined, renderArgName(clone(a))); i = i + 1; };
    return cat3(cat3(base, "<", joined), ">", "");
};

fn namedTypeOf(base: &String, args: &List<ArgV>) -> Type ~ {
    tokens = [];
    for a in &args { for t in argTokensOf(clone(a)) { tokens = push(tokens, clone(t)); }; };
    // Haskell renderTypeForName gives a bare lowercase name a leading `; the instance name stored is that rendering
    name = instanceNameOf(base, args);
    if size(args) = 0 && isBareLower(base) { name = catStrings("`", clone(base)); };
    return Type::TNamed { name: name, base: clone(base), argc: size(args), argTokens: tokens };
};

fn isLowerCp(cp: Int) -> Bool ~ {
    if cp >= 128 { return parserUnicodeLower(cp); };
    return cp >= 97 && cp <= 122;
};

fn isAlphaNumCp(cp: Int) -> Bool ~ {
    if cp >= 128 { return parserUnicodeAlphaNum(cp); };
    return isIdentCp(cp);
};

fn isBareLower(name: &String) -> Bool ~ {
    if size(name.bytes) = 0 { return false; };
    first = decodeStrAt(name, 0);
    if !isLowerCp(get(first, 0)) { return false; };
    i = 0;
    while i < size(name.bytes) [{ affirm i >= 0; }] ~ {
        decoded = decodeStrAt(name, i);
        width = get(decoded, 1);
        if width <= 0 || i + width > size(name.bytes) { return false; };
        if !isAlphaNumCp(get(decoded, 0)) { return false; };
        i = i + width;
    };
    return true;
};

fn baseNameOf(name: &String) -> String ~ {
    i = 0;
    while i < size(name.bytes) && get(&name.bytes, i) != toByte(60) ~ { i = i + 1; };
    return strSlice(name, 0, i);
};

fn containsText(s: &String, needle: &String) -> Bool ~ {
    if size(needle.bytes) > size(s.bytes) { return false; };
    i = 0;
    while i + size(needle.bytes) <= size(s.bytes) ~ {
        same = true;
        j = 0;
        while j < size(needle.bytes) ~ { if get(&s.bytes, i + j) != get(&needle.bytes, j) { same = false; }; j = j + 1; };
        if same { return true; };
        i = i + 1;
    };
    return false;
};

fn splitPath(name: &String) -> List<String> ~ {
    out = [];
    start = 0;
    i = 0;
    while i + 1 < size(name.bytes) [{ affirm i >= 0; affirm start >= 0; }] ~ {
        if get(&name.bytes, i) = toByte(58) && get(&name.bytes, i + 1) = toByte(58) { out = push(out, strSlice(name, start, i)); i = i + 2; start = i; } else { i = i + 1; };
    };
    out = push(out, strSlice(name, start, size(name.bytes)));
    return out;
};

fn joinFrom(segs: &List<String>, i: Int) -> String [{ affirm i >= 0; }] [{ }] ~ {
    out = "";
    j = i;
    while j < size(segs) [{ affirm j >= i; }] ~ { if j > i { out = catStrings(out, "::"); }; out = catStrings(out, clone(get(segs, j))); j = j + 1; };
    return out;
};

fn isSuffixPath(short: &String, long: &String) -> Bool ~ {
    ss = splitPath(short);
    ls = splitPath(long);
    if size(ss) > size(ls) { return false; };
    off = size(ls) - size(ss);
    i = 0;
    while i < size(ss) ~ { if get(ss, i) != get(ls, off + i) { return false; }; i = i + 1; };
    return true;
};

fn samePath(a: &String, b: &String) -> Bool ~ {
    return a = b || isSuffixPath(a, b) || isSuffixPath(b, a);
};

// ---- declaration lookups ----

fn findCtor(st: &St, name: &String) -> List<String> ~ {
    i = size(st.ctors) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.ctors); }] ~ {
        entry = get(&st.ctors, i);
        if entry.name = name { if !entry.active { return []; }; return clone(entry.fields); };
        i = i - 1;
    };
    return [];
};

fn hasCtor(st: &St, name: &String) -> Bool ~ {
    i = size(st.ctors) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.ctors); }] ~ {
        entry = get(&st.ctors, i);
        if entry.name = name { return entry.active; };
        i = i - 1;
    };
    return false;
};

fn matchedCtorName(st: &St, name: &String) -> String ~ {
    segs = splitPath(name);
    i = 0;
    while i < size(segs) ~ {
        cand = joinFrom(segs, i);
        if hasCtor( st, cand) { return cand; };
        i = i + 1;
    };
    return "";
};

fn findCtorPath(st: &St, name: &String) -> List<String> ~ {
    m = matchedCtorName( st, name);
    if size(m.bytes) = 0 { return []; };
    return findCtor( st, m);
};

fn genericsForPath(st: &St, name: &String) -> List<String> ~ {
    segs = splitPath(name);
    i = 0;
    while i < size(segs) ~ {
        cand = joinFrom(segs, i);
        ps = findGenerics( st, cand);
        if size(ps) > 0 { return ps; };
        i = i + 1;
    };
    return [];
};

fn findFields(st: &St, name: &String) -> List<FieldInfo> ~ {
    i = size(st.fieldsOf) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.fieldsOf); }] ~ {
        entry = get(&st.fieldsOf, i);
        if entry.name = name { return clone(entry.fields); };
        i = i - 1;
    };
    return [];
};

fn findGenerics(st: &St, name: &String) -> List<String> ~ {
    i = size(st.generics) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.generics); }] ~ {
        entry = get(&st.generics, i);
        if entry.name = name { if !entry.active { return []; }; return clone(entry.params); };
        i = i - 1;
    };
    return [];
};

fn hasGenerics(st: &St, name: &String) -> Bool ~ {
    i = size(st.generics) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.generics); }] ~ {
        entry = get(&st.generics, i);
        if entry.name = name { return entry.active; };
        i = i - 1;
    };
    return false;
};

fn currentTypes(st: &St) -> List<TypeInfo> ~ {
    seen = [];
    out = [];
    i = size(st.types) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.types); }] ~ {
        entry = get(&st.types, i);
        if !containsName(seen, &entry.name) {
            seen = push(seen, clone(entry.name));
            if entry.active { out = push(out, clone(entry)); };
        };
        i = i - 1;
    };
    reversed = [];
    for entry in out { reversed = push(reversed, clone(entry)); };
    // Restore declaration order: lookup tie-breaking depends on it.
    result = [];
    i = size(reversed) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(reversed); }] ~ { result = push(result, clone(get(reversed, i))); i = i - 1; };
    return result;
};

fn findTypeVariants(st: &St, variant: &String) -> List<String> ~ {
    // [typeName, variant1, ...] for the type that has this variant; [] when unknown
    for c in currentTypes(st) {
        for v in c.variants { if v = variant { out = push([], clone(c.name)); for w in c.variants { out = push(out, clone(w)); }; return out; }; };
    };
    return [];
};

fn hasTypeNamed(st: &St, name: &String) -> Bool ~ {
    i = size(st.types) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.types); }] ~ {
        entry = get(&st.types, i);
        if entry.name = name { return entry.active; };
        i = i - 1;
    };
    return false;
};

fn setCtor(st: St, name: &String, fields: &List<String>) -> St ~ {
    entry = CtorInfo { name: clone(name), fields: clone(fields), active: true };
    return St { ctors: push(st.ctors, entry), ..st };
};

fn setFields(st: St, name: &String, fields: &List<FieldInfo>) -> St ~ {
    entry = FieldsInfo { name: clone(name), fields: clone(fields) };
    return St { fieldsOf: push(st.fieldsOf, entry), ..st };
};

fn setTypeInfo(st: St, name: &String, variants: &List<String>) -> St ~ {
    entry = TypeInfo { name: clone(name), variants: clone(variants), active: true };
    return St { types: push(st.types, entry), ..st };
};

fn setGenerics(st: St, name: &String, params: &List<String>) -> St ~ {
    if size(params) = 0 { return st; };
    entry = GenInfo { name: clone(name), params: clone(params), active: true };
    return St { generics: push(st.generics, entry), ..st };
};

fn deleteCtor(st: St, name: &String) -> St ~ {
    entry = CtorInfo { name: clone(name), fields: [], active: false };
    return St { ctors: push(st.ctors, entry), ..st };
};

fn removeGenerics(st: St, name: &String) -> St ~ {
    entry = GenInfo { name: clone(name), params: [], active: false };
    return St { generics: push(st.generics, entry), ..st };
};

fn removeTypeInfo(st: St, name: &String) -> St ~ {
    entry = TypeInfo { name: clone(name), variants: [], active: false };
    return St { types: push(st.types, entry), ..st };
};

fn sourceVariants(owner: &String, variants: &List<String>) -> List<String> ~ {
    out = [];
    for variant in variants {
        if containsText(variant, "$") {
            i = 0;
            while i < size(variant.bytes) && get(variant.bytes, i) != toByte(58) ~ { i = i + 1; };
            out = push(out, catStrings(owner, strSlice(variant, i, size(variant.bytes))));
        } else { out = push(out, clone(variant)); };
    };
    return out;
};

fn typeVariantsNamed(st: &St, name: &String) -> List<String> ~ {
    i = size(st.types) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(st.types); }] ~ {
        entry = get(&st.types, i);
        if entry.name = name { if !entry.active { return []; }; return sourceVariants(name, entry.variants); };
        i = i - 1;
    };
    return [];
};

fn shadowCtors(st: St, name: &String) -> St ~ {
    s = deleteCtor( st, name);
    for v in typeVariantsNamed( s, name) { s = deleteCtor( s, v); };
    return s;
};

fn resolveSelfName(st: &St, name: &String) -> String ~ {
    if name = "Self" && st.hasSelf { return clone(st.selfName); };
    return clone(name);
};

fn namePathOf(sourceText: &Input, st: St) -> Res<List<String>> ~ {
    v = parseVariable(sourceText, st); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<List<String>> { st: resultPartsvState, v: [], ok: false }; };
    first = resultPartsvValue;
    s = resultPartsvState;
    return namePathRest(sourceText, s, push([], first));
};

fn namePathRest(sourceText: &Input, st: St, segs: List<String>) -> Res<List<String>> ~ {
    s = st;
    if !peekIs(sourceText, s, "::") { return ok( s, segs); };
    s = St { pos: s.pos + 2, ..s };
    w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
    if !resultPartswOk { return Res<List<String>> { st: resultPartswState, v: [], ok: false }; };
    next = resultPartswValue;
    s2 = resultPartswState;
    return namePathRest(sourceText, s2, push(segs, next));
};

fn qualifiedName(sourceText: &Input, st: St) -> Res<String> ~ {
    p = namePathOf(sourceText, st); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
    if !resultPartspOk { return Res<String> { st: resultPartspState, v: "", ok: false }; };
    s = resultPartspState;
    first = "";
    out = "";
    i = 0;
    for seg in resultPartspValue {
        if i = 0 { first = clone(seg); out = baseNameOf(resolveSelfName( s, seg)); } else { out = cat3(out, "::", seg); };
        i = i + 1;
    };
    if size(resultPartspValue) = 1 { return ok( s, resolveSelfName( s, first)); };
    return ok( s, out);
};

// ---- values ----

fn digitsValue(st: St, text: &String, negative: Bool) -> Res<Int> ~ {
    // a VInt value node; the magnitude must fit Int (Parse.vint: Int is 64 bits)
    acc = 0;
    i = 0;
    n = size(text.bytes);
    if n = 0 { return fail( st, 0, "expected an integer"); };
    while i < n ~ {
        c = toInt(get(&text.bytes, i));
        d = c - 48;
        if d < 0 || d > 9 { return fail( st, 0, "expected an integer"); };
        if acc < 0 - 922337203685477580 || (acc = 0 - 922337203685477580 && d > 8) { return fail( st, 0, "Integer literal out of range (Int is 64 bits)"); };
        acc = acc * 10 - d;
        i = i + 1;
    };
    value = acc;
    if !negative {
        if acc = 0 - 9223372036854775807 - 1 { return fail( st, 0, "Integer literal out of range (Int is 64 bits)"); };
        value = 0 - acc;
    };
    nm = putName( st, String::fromInt(value)); Res { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk } = nm;
    if !resultPartsnmOk { return Res<Int> { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk }; };
    return emit( resultPartsnmState, AstNode::Value { value: AstValue::VInt { n: resultPartsnmValue } });
};

fn valueNode(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if keywordAt(sourceText, s, "true") { s = St { pos: s.pos + 4, ..s }; s = skipWs(sourceText, s); return emit( s, AstNode::Value { value: AstValue::VBool { b: true } }); };
    if keywordAt(sourceText, s, "false") { s = St { pos: s.pos + 5, ..s }; s = skipWs(sourceText, s); return emit( s, AstNode::Value { value: AstValue::VBool { b: false } }); };
    c = byteAt(sourceText, s, s.pos);
    if c = 91 {
        // [ value, ... ]
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        vals = [];
        if byteAt(sourceText, s, s.pos) != 93 {
            loop = true;
            while loop ~ {
                v = valueNode(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
                s = resultPartsvState;
                vals = push(vals, resultPartsvValue);
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
            };
        };
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) != 93 { return fail( s, 0, "expected ]"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        lst = valuesList( s, vals); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
        if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
        return emit( resultPartslstState, AstNode::Value { value: AstValue::VList { xs: resultPartslstValue } });
    };
    negative = false;
    if c = 45 { negative = true; s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
    start = s.pos;
    while byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
    if s.pos = start { return fail( s, 0, "expected a value"); };
    text = srcSlice(sourceText, s, start, s.pos);
    s = skipWs(sourceText, s);
    r = digitsValue( s, text, negative); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk };
};

fn utf8Encode(cp: Int) -> List<Int> ~ {
    if cp < 128 { return push([], cp); };
    if cp < 2048 { return push(push([], 192 + cp / 64), 128 + cp % 64); };
    if cp < 65536 { return push(push(push([], 224 + cp / 4096), 128 + (cp / 64) % 64), 128 + cp % 64); };
    return push(push(push(push([], 240 + cp / 262144), 128 + (cp / 4096) % 64), 128 + (cp / 64) % 64), 128 + cp % 64);
};

// the bytes of a string literal, or a failure; state is past the closing quote and whitespace
fn stringBytes(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    if byteAt(sourceText, s, s.pos) != 34 { return fail( s, [], "expected a string"); };
    s = St { pos: s.pos + 1, ..s };
    bytes = [];
    loop = true;
    while loop ~ {
        c = byteAt(sourceText, s, s.pos);
        if c < 0 || c = 10 { return fail( s, [], "the end of the string"); };
        if c = 34 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            if c = 92 {
                s = St { pos: s.pos + 1, ..s };
                esc = escapeBytes(sourceText, s); Res { st: resultPartsescState, v: resultPartsescValue, ok: resultPartsescOk } = esc;
                if !resultPartsescOk { return Res<List<Int>> { st: resultPartsescState, v: resultPartsescValue, ok: resultPartsescOk }; };
                s = resultPartsescState;
                for b in resultPartsescValue { bytes = push(bytes, b); };
            } else {
                d = decodeAt(sourceText, s, s.pos);
                cp = get(d, 0);
                len = get(d, 1);
                if len <= 0 { len = 1; };
                for b in utf8Encode(cp) { bytes = push(bytes, b); };
                s = St { pos: s.pos + len, ..s };
            };
        };
    };
    s = skipWs(sourceText, s);
    return ok( s, bytes);
};

fn sourceHexValue(c: Int) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return <= 15; }] {
    if c >= 97 && c <= 102 { return c - 87; };
    return hexValue(c);
};

fn escapeBytes(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    e = byteAt(sourceText, s, s.pos);
    if e = 110 { return ok( St { pos: s.pos + 1, ..s }, push([], 10)); };
    if e = 114 { return ok( St { pos: s.pos + 1, ..s }, push([], 13)); };
    if e = 116 { return ok( St { pos: s.pos + 1, ..s }, push([], 9)); };
    if e = 48 { return ok( St { pos: s.pos + 1, ..s }, push([], 0)); };
    if e = 34 { return ok( St { pos: s.pos + 1, ..s }, push([], 34)); };
    if e = 92 { return ok( St { pos: s.pos + 1, ..s }, push([], 92)); };
    if e != 117 { return fail( s, [], "a character of the string"); };
    s = St { pos: s.pos + 1, ..s };
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, [], "a \\u escape"); };
    s = St { pos: s.pos + 1, ..s };
    value = 0;
    digits = 0;
    loop = true;
    while loop ~ {
        h = sourceHexValue(byteAt(sourceText, s, s.pos));
        if h < 0 { loop = false; }
        else {
            value = value * 16 + h;
            digits = digits + 1;
            s = St { pos: s.pos + 1, ..s };
            if digits > 6 { return fail( s, [], "a \\u escape of a character that does not exist"); };
        };
    };
    if digits = 0 { return fail( s, [], "a \\u escape"); };
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, [], "a \\u escape"); };
    s = St { pos: s.pos + 1, ..s };
    if value > 1114111 || (value >= 55296 && value < 57344) { return fail( s, [], "a \\u escape of a character that does not exist"); };
    return ok( s, utf8Encode(value));
};

fn stringCtorCheck(st: &St) -> Bool ~ {
    f = findCtor( st, "String");
    return size(f) = 1 && get(f, 0) = "bytes";
};

// ---- types ----

fn sizeArgument(sourceText: &Input, st: St) -> Res<Size> ~ {
    s = skipWs(sourceText, st);
    c = byteAt(sourceText, s, s.pos);
    if c >= 48 && c <= 57 {
        start = s.pos;
        while byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
        p = parseDigitsText( s, srcSlice(sourceText, s, start, s.pos)); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if !resultPartspOk { return fail( resultPartspState, Size::SAny, "a size that does not fit"); };
        return ok( resultPartspState, Size::SConst { n: resultPartspValue });
    };
    if c = 63 { s = St { pos: s.pos + 1, ..s }; return ok( s, Size::SAny); };
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Size> { st: resultPartsvState, v: Size::SAny, ok: false }; };
    return ok( resultPartsvState, Size::SParam { name: resultPartsvValue });
};

fn parseDigitsText(st: St, text: &String) -> Res<Int> ~ {
    acc = 0;
    i = 0;
    while i < size(text.bytes) ~ {
        d = toInt(get(&text.bytes, i)) - 48;
        if d < 0 || d > 9 { return fail( st, 0, "expected a number"); };
        if acc > 922337203685477580 || (acc = 922337203685477580 && d > 7) { return fail( st, 0, "a number that does not fit"); };
        acc = acc * 10 + d;
        i = i + 1;
    };
    return ok( st, acc);
};

fn noArgs() -> List<ArgV> ~ { return []; };

fn genericArguments(sourceText: &Input, st: St, params: &List<String>) -> Res<List<ArgV>> ~ {
    // at '<'
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    args = noArgs();
    i = 0;
    for p in &params {
        if i > 0 {
            if byteAt(sourceText, s, s.pos) != 44 { return fail( s, args, "expected ,"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
        };
        if isTypeParamName(p) {
            t = typeAnnotation(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
            if !resultPartstOk { return Res<List<ArgV>> { st: resultPartstState, v: noArgs(), ok: false }; };
            s = resultPartstState;
            args = push(args, ArgV { isSize: false, size: Size::SAny, ty: resultPartstValue });
        } else {
            z = sizeArgument(sourceText, s); Res { st: resultPartszState, v: resultPartszValue, ok: resultPartszOk } = z;
            if !resultPartszOk { return Res<List<ArgV>> { st: resultPartszState, v: noArgs(), ok: false }; };
            s = resultPartszState;
            s = skipWs(sourceText, s);
            args = push(args, ArgV { isSize: true, size: resultPartszValue, ty: Type::TInt });
        };
        i = i + 1;
    };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 62 { return fail( s, args, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    return ok( s, args);
};

fn tryGenericArguments(sourceText: &Input, st: St, params: &List<String>) -> Res<List<ArgV>> ~ {
    save = checkpoint(st);
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) != 60 { return ok( restore(s, save), noArgs()); };
    r = genericArguments(sourceText, s, params); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    if !resultPartsrOk { return ok( restore(resultPartsrState, save), noArgs()); };
    // signal "present" by a wrapper: caller distinguishes by position; here failure also means absent in Haskell (optionMaybe), but a malformed list after < is then a later failure anyway
    return Res<List<ArgV>> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk };
};

fn hasGenericArguments(sourceText: &Input, st: &St, params: &List<String>) -> Bool ~ {
    s = skipWs(sourceText, probeState(st));
    if byteAt(sourceText, s, s.pos) != 60 { return false; };
    r = genericArguments(sourceText, s, params); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return resultPartsrOk;
};

fn wordTypeOf(name: &String) -> Type ~ {
    if name = "I8" { return Type::TWord { signed: true, bits: 8 }; };
    if name = "I16" { return Type::TWord { signed: true, bits: 16 }; };
    if name = "I32" { return Type::TWord { signed: true, bits: 32 }; };
    if name = "I64" { return Type::TInt; };
    if name = "U8" { return Type::TByte; };
    if name = "U16" { return Type::TWord { signed: false, bits: 16 }; };
    if name = "U32" { return Type::TWord { signed: false, bits: 32 }; };
    return Type::TInt;
};

fn isWordTypeName(name: &String) -> Bool ~ {
    return name = "I8" || name = "I16" || name = "I32" || name = "I64" || name = "U8" || name = "U16" || name = "U32";
};

fn typeAnnotation(sourceText: &Input, st: St) -> Res<Type> ~ {
    s = skipWs(sourceText, st);
    r = typeInner(sourceText, s); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    if !resultPartsrOk { return Res<Type> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
    return ok( skipWs(sourceText, resultPartsrState), resultPartsrValue);
};

fn typeInner(sourceText: &Input, st: St) -> Res<Type> ~ {
    s = st;
    // borrowed
    if peekIs(sourceText, s, "&mut") {
        after = s.pos + 4;
        // &mut must not be followed by an identifier character is not required by Haskell (string "&mut" then whitespace)
        s2 = s;
        s2 = St { pos: after, ..s2 };
        s2 = skipWs(sourceText, s2);
        inner = namedOrFunctionType(sourceText, s2); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if resultPartsinnerOk { return ok( resultPartsinnerState, Type::TMutRef { inner: Box::new(resultPartsinnerValue) }); };
        return Res<Type> { st: resultPartsinnerState, v: Type::TInt, ok: false };
    };
    if byteAt(sourceText, s, s.pos) = 38 && byteAt(sourceText, s, s.pos + 1) != 38 {
        s2 = s;
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(sourceText, s2);
        inner = namedOrFunctionType(sourceText, s2); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if resultPartsinnerOk { return ok( resultPartsinnerState, Type::TRef { inner: Box::new(resultPartsinnerValue) }); };
        return Res<Type> { st: resultPartsinnerState, v: Type::TInt, ok: false };
    };
    f = tryFunctionType(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
    if resultPartsfOk { return Res<Type> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk }; };
    s = resultPartsfState;
    if byteAt(sourceText, s, s.pos) = 40 {
        // tuple type
        s2 = s;
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(sourceText, s2);
        parts = [];
        loop = true;
        while loop ~ {
            part = tuplePartType(sourceText, s2); Res { st: resultPartspartState, v: resultPartspartValue, ok: resultPartspartOk } = part;
            if !resultPartspartOk { return Res<Type> { st: resultPartspartState, v: resultPartspartValue, ok: resultPartspartOk }; };
            s2 = resultPartspartState;
            parts = push(parts, resultPartspartValue);
            s2 = skipWs(sourceText, s2);
            if byteAt(sourceText, s2, s2.pos) = 44 { s2 = St { pos: s2.pos + 1, ..s2 }; s2 = skipWs(sourceText, s2); } else { loop = false; };
        };
        if byteAt(sourceText, s2, s2.pos) != 41 { return fail( s2, Type::TInt, "expected )"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        if size(parts) < 2 { return fail( s2, Type::TInt, "a tuple type has two parts or more"); };
        args = [];
        for p in parts { args = push(args, ArgV { isSize: false, size: Size::SAny, ty: clone(p) }); };
        return ok( s2, namedTypeOf(catStrings("Tuple", String::fromInt(size(parts))), args));
    };
    return namedType(sourceText, s);
};

fn tuplePartType(sourceText: &Input, st: St) -> Res<Type> ~ {
    s = skipWs(sourceText, st);
    ghostly = false;
    g = eatKeyword(sourceText, s, "ghost"); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
    if resultPartsgValue { ghostly = true; s = skipWs(sourceText, resultPartsgState); } else { s = resultPartsgState; };
    t = typeAnnotation(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
    if !resultPartstOk { return Res<Type> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk }; };
    if ghostly && !ghostTypeOf(clone(resultPartstValue)) { return fail( resultPartstState, Type::TInt, "ghost is written before a type that is a permission, Block<T>"); };
    return Res<Type> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk };
};

fn ghostTypeOf(t: Type) -> Bool ~ {
    okGhost = false;
    match t {
        Type::TBlock { inner: e } => { okGhost = true; },
        Type::TRef { inner: e } => { okGhost = ghostTypeOf(Box::unbox(e)); },
        Type::TMutRef { inner: e } => { okGhost = false; },
        Type::TInt => { okGhost = false; },
        Type::TByte => { okGhost = false; },
        Type::TBool => { okGhost = false; },
        Type::TList { elem: e } => { okGhost = false; },
        Type::TArray { elem: e, size: s } => { okGhost = false; },
        Type::TBox { inner: e } => { okGhost = false; },
        Type::TFn { args: a, ret: r } => { okGhost = false; },
        Type::TNamed { name: n, base: b, argc: c, argTokens: ts } => { okGhost = false; },
        Type::TVariant { name: n } => { okGhost = false; },
        Type::TVar { n: n } => { okGhost = false; },
        Type::TForall { sizes: a, types: b, body: c } => { okGhost = false; },
        Type::TParam { name: n } => { okGhost = false; },
        Type::TAddr { inner: e } => { okGhost = false; },
        Type::TUninit { inner: e } => { okGhost = false; },
        Type::TWord { signed: a, bits: b } => { okGhost = false; },
    };
    return okGhost;
};

fn tryFunctionType(sourceText: &Input, st: St) -> Res<Type> ~ {
    saved = checkpoint(st);
    parsed = functionType(sourceText, st);
    Res { st: parsedState, v: parsedValue, ok: parsedOk } = parsed;
    if !parsedOk { return Res<Type> { st: restore(parsedState, saved), v: Type::TInt, ok: false }; };
    return ok(parsedState, parsedValue);
};

fn functionType(sourceText: &Input, st: St) -> Res<Type> ~ {
    s = st;
    k = eatKeyword(sourceText, s, "fn"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if !resultPartskValue { return Res<Type> { st: resultPartskState, v: Type::TInt, ok: false }; };
    kSt = resultPartskState;
    s = skipWs(sourceText, kSt);
    if byteAt(sourceText, s, s.pos) != 40 { return Res<Type> { st: s, v: Type::TInt, ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    args = [];
    if byteAt(sourceText, s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            t = typeAnnotation(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
            if !resultPartstOk { return Res<Type> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk }; };
            s = resultPartstState;
            args = push(args, resultPartstValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, Type::TInt, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if !peekIs(sourceText, s, "->") { return fail( s, Type::TInt, "expected ->"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(sourceText, s);
    r = typeAnnotation(sourceText, s); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    if !resultPartsrOk { return Res<Type> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
    return ok( resultPartsrState, Type::TFn { args: args, ret: Box::new(resultPartsrValue) });
};

fn namedOrFunctionType(sourceText: &Input, st: St) -> Res<Type> ~ {
    f = tryFunctionType(sourceText, st); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
    if resultPartsfOk { return Res<Type> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk }; };
    return namedType(sourceText, resultPartsfState);
};

fn namedType(sourceText: &Input, st: St) -> Res<Type> ~ {
    s = st;
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Type> { st: resultPartsvState, v: Type::TInt, ok: false }; };
    raw = resultPartsvValue;
    s = resultPartsvState;
    if raw = "Self" && s.hasSelfTy {
        // optional ::Variant
        if peekIs(sourceText, s, "::") {
            save = checkpoint(s);
            s = St { pos: s.pos + 2, ..s };
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if resultPartswOk {
                s = resultPartswState;
                selfTyCopy = clone(s.selfTy);
                match s.selfTy {
                    Type::TNamed { name: n, base: b, argc: c, argTokens: ts } => { return ok( s, Type::TVariant { name: cat3(b, "::", resultPartswValue) }); },
                    Type::TInt => { return ok( s, selfTyCopy); },
                    Type::TByte => { return ok( s, selfTyCopy); },
                    Type::TBool => { return ok( s, selfTyCopy); },
                    Type::TList { elem: e } => { return ok( s, selfTyCopy); },
                    Type::TArray { elem: e, size: z } => { return ok( s, selfTyCopy); },
                    Type::TBox { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TFn { args: a, ret: r } => { return ok( s, selfTyCopy); },
                    Type::TVariant { name: n } => { return ok( s, selfTyCopy); },
                    Type::TVar { n: n } => { return ok( s, selfTyCopy); },
                    Type::TForall { sizes: a, types: b, body: c } => { return ok( s, selfTyCopy); },
                    Type::TParam { name: n } => { return ok( s, selfTyCopy); },
                    Type::TRef { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TMutRef { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TAddr { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TBlock { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TUninit { inner: e } => { return ok( s, selfTyCopy); },
                    Type::TWord { signed: a, bits: b } => { return ok( s, selfTyCopy); },
                };
            };
            s = restore(resultPartswState, save);
        };
        stc = clone(s.selfTy);
        return ok( s, stc);
    };
    name = resolveSelfName( s, raw);
    s2 = s;
    // a path of several segments is a variant when it has two and a generic named type otherwise
    extraSegs = [];
    s3 = s2;
    segLoop = true;
    while segLoop ~ {
        if peekIs(sourceText, s3, "::") {
            saveSeg = checkpoint(s3);
            s3 = St { pos: s3.pos + 2, ..s3 };
            w = parseVariable(sourceText, s3); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if resultPartswOk { extraSegs = push(extraSegs, resultPartswValue); s3 = resultPartswState; } else { s3 = restore(resultPartswState, saveSeg); segLoop = false; };
        } else { segLoop = false; };
    };
    if size(extraSegs) > 0 {
        full = clone(name);
        for seg in extraSegs { full = cat3(full, "::", seg); };
        pparams = genericsForPath( s3, full);
        if size(pparams) > 0 && hasGenericArguments(sourceText, s3, pparams) {
            g = genericArguments(sourceText, skipWs(sourceText, s3), pparams); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
            if resultPartsgOk { return ok( resultPartsgState, namedTypeOf(full, resultPartsgValue)); }; s3 = resultPartsgState;
        };
        if size(extraSegs) = 1 { return ok( s3, Type::TVariant { name: full }); };
        return ok( s3, namedTypeOf(full, []));
    };
    s2 = s3;
    if containsName(&s2.typeParams, name) { return ok( s2, Type::TParam { name: clone(name) }); };
    if name = "Int" { return ok( s2, Type::TInt); };
    if name = "Byte" { return ok( s2, Type::TByte); };
    if name = "Bool" { return ok( s2, Type::TBool); };
    if isWordTypeName(name) { return ok( s2, wordTypeOf(name)); };
    if name = "List" || name = "Box" || name = "Addr" || name = "Block" || name = "Uninit" {
        s2 = skipWs(sourceText, s2);
        if byteAt(sourceText, s2, s2.pos) != 60 { return fail( s2, Type::TInt, "expected <"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(sourceText, s2);
        e = typeAnnotation(sourceText, s2); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Type> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s2 = skipWs(sourceText, resultPartseState);
        if byteAt(sourceText, s2, s2.pos) != 62 { return fail( s2, Type::TInt, "expected >"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        if name = "List" { return ok( s2, Type::TList { elem: Box::new(resultPartseValue) }); };
        if name = "Box" { return ok( s2, Type::TBox { inner: Box::new(resultPartseValue) }); };
        if name = "Addr" { return ok( s2, Type::TAddr { inner: Box::new(resultPartseValue) }); };
        if name = "Block" { return ok( s2, Type::TBlock { inner: Box::new(resultPartseValue) }); };
        return ok( s2, Type::TUninit { inner: Box::new(resultPartseValue) });
    };
    if name = "Array" {
        s2 = skipWs(sourceText, s2);
        if byteAt(sourceText, s2, s2.pos) != 60 { return fail( s2, Type::TInt, "expected <"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(sourceText, s2);
        e = typeAnnotation(sourceText, s2); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Type> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s2 = resultPartseState;
        size = Size::SAny;
        s2 = skipWs(sourceText, s2);
        if byteAt(sourceText, s2, s2.pos) = 44 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            z = sizeArgument(sourceText, s2); Res { st: resultPartszState, v: resultPartszValue, ok: resultPartszOk } = z;
            if !resultPartszOk { return Res<Type> { st: resultPartszState, v: Type::TInt, ok: false }; };
            s2 = resultPartszState;
            size = resultPartszValue;
        };
        s2 = skipWs(sourceText, s2);
        if byteAt(sourceText, s2, s2.pos) != 62 { return fail( s2, Type::TInt, "expected >"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        return ok( s2, Type::TArray { elem: Box::new(resultPartseValue), size: size });
    };
    // variant?
    if peekIs(sourceText, s2, "::") {
        save = checkpoint(s2);
        s2 = St { pos: s2.pos + 2, ..s2 };
        w = parseVariable(sourceText, s2); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
        if resultPartswOk { return ok( resultPartswState, Type::TVariant { name: cat3(name, "::", resultPartswValue) }); };
        s2 = restore(resultPartswState, save);
    };
    params = findGenerics( s2, name);
    if size(params) > 0 {
        if hasGenericArguments(sourceText, s2, params) {
            g = genericArguments(sourceText, skipWs(sourceText, s2), params); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
            if resultPartsgOk { return ok( resultPartsgState, namedTypeOf(name, resultPartsgValue)); }; s2 = resultPartsgState;
        };
        return ok( s2, namedTypeOf(name, []));
    };
    return ok( s2, namedTypeOf(name, []));
};

// ---- expressions ----

fn exprNode(st: St, node: AstExpression) -> Res<Int> ~ { return emit( st, AstNode::Expression { value: node }); };

fn valExpr(st: St, valueNode: Int) -> Res<Int> ~ { return exprNode( st, AstExpression::Val { v: valueNode }); };

fn builtinExpr(st: St, b: AstBuiltin, params: &List<String>, args: &List<Int>) -> Res<Int> ~ {
    bv = builtinValue( st, b, params); Res { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk } = bv;
    if !resultPartsbvOk { return Res<Int> { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk }; };
    ve = valExpr( resultPartsbvState, resultPartsbvValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
    xs = expressionsList( resultPartsveState, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
};

fn primExpr(st: St, name: &String, args: &List<Int>) -> Res<Int> ~ {
    return builtinExpr( st, AstBuiltin::Primitive { name: clone(name) }, primParams(name), args);
};

fn varExprNode(st: St, name: &String) -> Res<Int> ~ {
    n = putName( st, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    return exprNode( resultPartsnState, AstExpression::Var { n: resultPartsnValue });
};

fn expression(sourceText: &Input, st: St) -> Res<Int> ~ { return exprLevel0(sourceText, st); };

fn exprLevel0(sourceText: &Input, st: St) -> Res<Int> ~ {
    // ||
    l = exprLevel1(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "||") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = exprLevel1(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = primExpr( s, "Or", push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn exprLevel1(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = exprRelations(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "&&") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = exprRelations(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = primExpr( s, "And", push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn exprRelations(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = exprAdditive(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        op = relationOpAt(sourceText, s2);
        if size(op.bytes) > 0 {
            s2 = St { pos: s2.pos + size(op.bytes), ..s2 };
            s2 = skipWs(sourceText, s2);
            r = exprAdditive(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = relExprOf( s, op, left, resultPartsrValue); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { loop = false; s = s2; };
    };
    // is Variant
    s2 = skipWs(sourceText, s);
    k = eatKeyword(sourceText, s2, "is"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if resultPartskValue {
        s3 = skipWs(sourceText, resultPartskState);
        dc = declaredCtorNode(sourceText, s3); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
        if !resultPartsdcOk { return Res<Int> { st: resultPartsdcState, v: 0, ok: false }; };
        s = resultPartsdcState;
        b = isExprOf( s, resultPartsdcValue, left); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
        if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
        s = resultPartsbState;
        left = resultPartsbValue;
        s = skipWs(sourceText, s);
    } else { s = resultPartskState; };
    return ok( s, left);
};

fn relationOpAt(sourceText: &Input, st: &St) -> String ~ {
    // many1 of =<>! , classified
    i = st.pos;
    going = true;
    while going && i < (size(sourceText.columns) - 1) ~ {
        c = byteAt(sourceText, st, i);
        if c = 61 || c = 60 || c = 62 || c = 33 { i = i + 1; } else { going = false; };
    };
    if i = st.pos { return ""; };
    op = srcSlice(sourceText, st, st.pos, i);
    if op = "=" || op = "!=" || op = "<" || op = ">" || op = "<=" || op = ">=" { return op; };
    return "";
};

fn relExprOf(st: St, op: &String, l: Int, r: Int) -> Res<Int> ~ {
    idx = relIndexOf(op);
    bv = relValue( st, idx); Res { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk } = bv;
    if !resultPartsbvOk { return Res<Int> { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk }; };
    ve = valExpr( resultPartsbvState, resultPartsbvValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
    xs = expressionsList( resultPartsveState, push(push([], l), r)); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
};

fn isExprOf(st: St, variantName: &String, e: Int) -> Res<Int> ~ {
    n = putName( st, variantName); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    return builtinExpr( resultPartsnState, AstBuiltin::Is { n: resultPartsnValue }, push([], "value"), push([], e));
};

fn exprAdditive(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = exprMultiplicative(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        c = byteAt(sourceText, s2, s2.pos);
        if c = 43 || c = 45 {
            // a '-' that starts a negative literal in operand position is not an operator here (Haskell: op then whitespace then operand; '-' is consumed as operator)
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = exprMultiplicative(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            name = "Plus";
            if c = 45 { name = "Minus"; };
            b = primExpr( s, name, push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn exprMultiplicative(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = nonInfixExpr(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        c = byteAt(sourceText, s2, s2.pos);
        if c = 42 || c = 47 || c = 37 {
            // '//' is a comment, handled by whitespace; a single '/' here is Div (a comment would have been eaten as whitespace before)
            if c = 47 && byteAt(sourceText, s2, s2.pos + 1) = 47 { s = s2; loop = false; }
            else {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(sourceText, s2);
                r = nonInfixExpr(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
                if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
                s = resultPartsrState;
                name = "Times";
                if c = 47 { name = "Div"; };
                if c = 37 { name = "Mod"; };
                b = primExpr( s, name, push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
                if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
                s = resultPartsbState;
                left = resultPartsbValue;
            };
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn declaredCtorNode(sourceText: &Input, st: St) -> Res<String> ~ {
    q = qualifiedName(sourceText, st); Res { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk } = q;
    if !resultPartsqOk { return Res<String> { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk }; };
    if size(matchedCtorName( resultPartsqState, resultPartsqValue).bytes) = 0 { return fail( resultPartsqState, "", cat3("Unknown struct or variant ", resultPartsqValue, "")); };
    return Res<String> { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk };
};

fn nonInfixExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    c = byteAt(sourceText, s, s.pos);
    // borrow
    if c = 38 {
        if peekIs(sourceText, s, "&mut") {
            s = St { pos: s.pos + 4, ..s };
            s = skipWs(sourceText, s);
            inner = nonInfixExpr(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
            if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
            return primExpr( resultPartsinnerState, "BorrowMutOf", push([], resultPartsinnerValue));
        };
        if byteAt(sourceText, s, s.pos + 1) != 38 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            inner = nonInfixExpr(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
            if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
            return primExpr( resultPartsinnerState, "BorrowOf", push([], resultPartsinnerValue));
        };
    };
    if c = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = nonInfixExpr(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        return primExpr( resultPartsinnerState, "DerefOf", push([], resultPartsinnerValue));
    };
    if c = 33 && byteAt(sourceText, s, s.pos + 1) != 61 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = nonInfixExpr(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        return primExpr( resultPartsinnerState, "Not", push([], resultPartsinnerValue));
    };
    if c = 34 {
        lit = stringLiteralExpr(sourceText, s); Res { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk } = lit;
        if !resultPartslitOk { return Res<Int> { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk }; };
        return withFieldsExpr(sourceText, resultPartslitState, resultPartslitValue);
    };
    if c = 35 {
        // #[ ... ] array literal of values
        s = St { pos: s.pos + 1, ..s };
        v = valueNode(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
        ve = valExpr( resultPartsvState, resultPartsvValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
        if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
        return primExpr( resultPartsveState, "ArrayFrom", push([], resultPartsveValue));
    };
    if c = 60 {
        qc = qualifiedCallExpr(sourceText, s); Res { st: resultPartsqcState, v: resultPartsqcValue, ok: resultPartsqcOk } = qc;
        if !resultPartsqcOk { return Res<Int> { st: resultPartsqcState, v: resultPartsqcValue, ok: resultPartsqcOk }; };
        return withFieldsExpr(sourceText, resultPartsqcState, resultPartsqcValue);
    };
    if c = 40 {
        pe = parensExpr(sourceText, s); Res { st: resultPartspeState, v: resultPartspeValue, ok: resultPartspeOk } = pe;
        if !resultPartspeOk { return Res<Int> { st: resultPartspeState, v: resultPartspeValue, ok: resultPartspeOk }; };
        return withFieldsExpr(sourceText, resultPartspeState, resultPartspeValue);
    };
    // struct literal / call / variable, string handled above, value (number, bool, list)
    if isDigitCp(c) || c = 45 || c = 91 || keywordAt(sourceText, s, "true") || keywordAt(sourceText, s, "false") {
        v = valueNode(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
        ve = valExpr( resultPartsvState, resultPartsvValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
        if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
        return withFieldsExpr(sourceText, resultPartsveState, resultPartsveValue);
    };
    // name-led
    base = nameLedExpr(sourceText, s); Res { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk } = base;
    if !resultPartsbaseOk { return Res<Int> { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk }; };
    return withFieldsExpr(sourceText, resultPartsbaseState, resultPartsbaseValue);
};

fn stringLiteralExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    if !stringCtorCheck( st) { return fail( st, 0, "a string literal needs the library String, which this program declares differently"); };
    sb = stringBytes(sourceText, st); Res { st: resultPartssbState, v: resultPartssbValue, ok: resultPartssbOk } = sb;
    if !resultPartssbOk { return Res<Int> { st: resultPartssbState, v: 0, ok: false }; };
    s = resultPartssbState;
    vals = [];
    for b in resultPartssbValue {
        nm = putName( s, String::fromInt(b)); Res { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk } = nm;
        if !resultPartsnmOk { return Res<Int> { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk }; };
        s = resultPartsnmState;
        vn = emit( s, AstNode::Value { value: AstValue::VInt { n: resultPartsnmValue } }); Res { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk } = vn;
        s = resultPartsvnState;
        vals = push(vals, resultPartsvnValue);
    };
    lst = valuesList( s, vals); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    lv = emit( resultPartslstState, AstNode::Value { value: AstValue::VList { xs: resultPartslstValue } }); Res { st: resultPartslvState, v: resultPartslvValue, ok: resultPartslvOk } = lv;
    bytesFrom = primValue( resultPartslvState, "BytesFrom"); Res { st: resultPartsbytesFromState, v: resultPartsbytesFromValue, ok: resultPartsbytesFromOk } = bytesFrom;
    if !resultPartsbytesFromOk { return Res<Int> { st: resultPartsbytesFromState, v: resultPartsbytesFromValue, ok: resultPartsbytesFromOk }; };
    ve1 = valExpr( resultPartsbytesFromState, resultPartsbytesFromValue); Res { st: resultPartsve1State, v: resultPartsve1Value, ok: resultPartsve1Ok } = ve1;
    lvExpr = valExpr( resultPartsve1State, resultPartslvValue); Res { st: resultPartslvExprState, v: resultPartslvExprValue, ok: resultPartslvExprOk } = lvExpr;
    argList2 = expressionsList( resultPartslvExprState, push([], resultPartslvExprValue)); Res { st: resultPartsargList2State, v: resultPartsargList2Value, ok: resultPartsargList2Ok } = argList2;
    f1 = exprNode( resultPartsargList2State, AstExpression::F { f: resultPartsve1Value, xs: resultPartsargList2Value }); Res { st: resultPartsf1State, v: resultPartsf1Value, ok: resultPartsf1Ok } = f1;
    ctor = ctorValue( resultPartsf1State, "String", [], push([], "bytes")); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
    if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
    ve2 = valExpr( resultPartsctorState, resultPartsctorValue); Res { st: resultPartsve2State, v: resultPartsve2Value, ok: resultPartsve2Ok } = ve2;
    args2 = expressionsList( resultPartsve2State, push([], resultPartsf1Value)); Res { st: resultPartsargs2State, v: resultPartsargs2Value, ok: resultPartsargs2Ok } = args2;
    if !resultPartsargs2Ok { return Res<Int> { st: resultPartsargs2State, v: resultPartsargs2Value, ok: resultPartsargs2Ok }; };
    return exprNode( resultPartsargs2State, AstExpression::F { f: resultPartsve2Value, xs: resultPartsargs2Value });
};

fn ctorValue(st: St, name: &String, args: &List<ArgV>, fields: &List<String>) -> Res<Int> ~ {
    n = putName( st, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    a = putArgsNodes( resultPartsnState, args); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
    if !resultPartsaOk { return Res<Int> { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk }; };
    f = namesList( resultPartsaState, fields); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
    if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk }; };
    return builtinValue( resultPartsfState, AstBuiltin::Ctor { n: resultPartsnValue, args: resultPartsaValue, fs: resultPartsfValue }, fields);
};

fn parensExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    parts = [];
    loop = true;
    while loop ~ {
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s = resultPartseState;
        parts = push(parts, resultPartseValue);
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if size(parts) = 1 { return ok( s, get(parts, 0)); };
    fields = [];
    i = 0;
    while i < size(parts) ~ { fields = push(fields, String::fromInt(i)); i = i + 1; };
    ctor = ctorValue( s, catStrings("Tuple", String::fromInt(size(parts))), [], fields); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
    if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
    ve = valExpr( resultPartsctorState, resultPartsctorValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    xs = expressionsList( resultPartsveState, parts); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    r = exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
    return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk };
};

fn qualifiedCallExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    v = qualifiedName(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    owner = baseNameOf(resultPartsvValue);
    s = skipWs(sourceText, resultPartsvState);
    trt = "";
    hasTrait = false;
    k = eatKeyword(sourceText, s, "as"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if resultPartskValue {
        s = skipWs(sourceText, resultPartskState);
        w = qualifiedName(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
        if !resultPartswOk { return Res<Int> { st: resultPartswState, v: 0, ok: false }; };
        trt = resultPartswValue;
        hasTrait = true;
        s = skipWs(sourceText, resultPartswState);
    } else { s = resultPartskState; };
    if byteAt(sourceText, s, s.pos) != 62 { return fail( s, 0, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    if !peekIs(sourceText, s, "::") { return fail( s, 0, "expected ::"); };
    s = St { pos: s.pos + 2, ..s };
    f = parseVariable(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
    if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: 0, ok: false }; };
    s = resultPartsfState;
    full = implName(owner, hasTrait, trt, resultPartsfValue);
    if byteAt(sourceText, s, s.pos) != 40 { return fail( s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    args = exprArgs(sourceText, s); Res { st: resultPartsargsState, v: resultPartsargsValue, ok: resultPartsargsOk } = args;
    if !resultPartsargsOk { return Res<Int> { st: resultPartsargsState, v: 0, ok: false }; };
    s = resultPartsargsState;
    ve = varExprNode( s, full); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
    xs = expressionsList( resultPartsveState, resultPartsargsValue); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
};

fn implName(owner: &String, hasTrait: Bool, trt: &String, f: &String) -> String ~ {
    if hasTrait { return catStrings(cat3(cat3("<", owner, " as "), trt, ">"), cat3("::", f, "")); };
    return cat3(cat3("<", owner, ">"), "::", f);
};

fn exprArgs(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    // just past '('; consumes through ')'
    s = st;
    args = [];
    if byteAt(sourceText, s, s.pos) = 41 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); return ok( s, args); };
    loop = true;
    while loop ~ {
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<List<Int>> { st: resultPartseState, v: [], ok: false }; };
        s = resultPartseState;
        args = push(args, resultPartseValue);
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, [], "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, args);
};

fn errorText(st: &St) -> String ~ { return clone(st.err); };
fn errorPosition(st: &St) -> Int ~ { return st.errPos; };

fn nameLedExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = st;
    save = checkpoint(s);
    // struct literal attempt
    lit = tryStructLiteralExpr(sourceText, s); Res { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk } = lit;
    if resultPartslitOk { return Res<Int> { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk }; };
    literalError = errorText(resultPartslitState);
    literalPos = errorPosition(resultPartslitState);
    s = restore(resultPartslitState, save);
    if size(literalError.bytes) > 0 && (size(s.err.bytes) = 0 || literalPos > s.errPos) {
        s = St { err: literalError, errPos: literalPos, ..s };
    };
    // call or variable
    q = qualifiedName(sourceText, s); Res { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk } = q;
    if !resultPartsqOk { return Res<Int> { st: resultPartsqState, v: 0, ok: false }; };
    s = resultPartsqState;
    name = resultPartsqValue;
    if byteAt(sourceText, s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        args = exprArgs(sourceText, s); Res { st: resultPartsargsState, v: resultPartsargsValue, ok: resultPartsargsOk } = args;
        if !resultPartsargsOk { return Res<Int> { st: resultPartsargsState, v: 0, ok: false }; };
        s = resultPartsargsState;
        ve = varExprNode( s, name); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
        if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
        xs = expressionsList( resultPartsveState, resultPartsargsValue); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
        if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
        return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
    };
    if containsText(name, "::") { return fail( s, 0, "expected ("); };
    return varExprNode( s, name);
};

fn withFieldsExpr(sourceText: &Input, st: St, base: Int) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    k = eatKeyword(sourceText, s, "as"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if resultPartskValue {
        s2 = skipWs(sourceText, resultPartskState);
        dc = declaredCtorNode(sourceText, s2); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
        if !resultPartsdcOk { return Res<Int> { st: resultPartsdcState, v: 0, ok: false }; };
        cast = castExprOf( resultPartsdcState, resultPartsdcValue, base); Res { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk } = cast;
        if !resultPartscastOk { return Res<Int> { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk }; };
        return withFieldsExpr(sourceText, resultPartscastState, resultPartscastValue);
    };
    s = resultPartskState;
    if byteAt(sourceText, s, s.pos) = 46 && byteAt(sourceText, s, s.pos + 1) != 46 {
        s = St { pos: s.pos + 1, ..s };
        fname = "";
        if byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 {
            start = s.pos;
            while byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
            fname = srcSlice(sourceText, s, start, s.pos);
        } else {
            v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
            if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
            fname = resultPartsvValue;
            s = resultPartsvState;
        };
        if byteAt(sourceText, s, s.pos) = 40 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            args = exprArgs(sourceText, s); Res { st: resultPartsargsState, v: resultPartsargsValue, ok: resultPartsargsOk } = args;
            if !resultPartsargsOk { return Res<Int> { st: resultPartsargsState, v: 0, ok: false }; };
            s = resultPartsargsState;
            ve = varExprNode( s, catStrings(".", fname)); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
            if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
            all = push([], base);
            for a in resultPartsargsValue { all = push(all, a); };
            xs = expressionsList( resultPartsveState, all); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
            if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
            r = exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue }); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            return withFieldsExpr(sourceText, resultPartsrState, resultPartsrValue);
        };
        fe = fieldExprOf( s, fname, base); Res { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk } = fe;
        if !resultPartsfeOk { return Res<Int> { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk }; };
        return withFieldsExpr(sourceText, resultPartsfeState, resultPartsfeValue);
    };
    return ok( s, base);
};
fn fieldExprOf(st: St, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName( st, fname); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    on = optNameNode( resultPartsnState, false, ""); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
    if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
    return builtinExpr( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsnValue }, push([], "struct"), push([], of));
};

fn fieldExprOwned(st: St, owner: &String, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName( st, fname); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    on = optNameNode( resultPartsnState, true, owner); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
    if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
    return builtinExpr( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsnValue }, push([], "struct"), push([], of));
};

fn castExprOf(st: St, variant: &String, of: Int) -> Res<Int> ~ {
    n = putName( st, variant); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    return builtinExpr( resultPartsnState, AstBuiltin::Cast { n: resultPartsnValue }, push([], "value"), push([], of));
};

fn projectExprOf(st: St, variant: &String, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName( st, variant); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    fn2 = putName( resultPartsnState, fname); Res { st: resultPartsfn2State, v: resultPartsfn2Value, ok: resultPartsfn2Ok } = fn2;
    if !resultPartsfn2Ok { return Res<Int> { st: resultPartsfn2State, v: resultPartsfn2Value, ok: resultPartsfn2Ok }; };
    return builtinExpr( resultPartsfn2State, AstBuiltin::Project { n: resultPartsnValue, f: resultPartsfn2Value }, push([], "value"), push([], of));
};

// arena inspection helpers

fn nodeIs(st: &St, id: Int, kind: Int) -> Bool ~ {
    // kind: 1 Name, 4 Value, 6 Expression, 9 Proof
    n = nodeAt( st, id);
    if kind = 1 && n is AstNode::Name { return true; };
    if kind = 4 && n is AstNode::Value { return true; };
    if kind = 6 && n is AstNode::Expression { return true; };
    if kind = 9 && n is AstNode::Proof { return true; };
    return false;
};

fn nameText(st: &St, id: Int) -> String ~ {
    n = nodeAt( st, id);
    if n is AstNode::Name {
        v = (n as AstNode::Name).value;
        return match v {
            AstName::End => "",
            AstName::Part { text: t, tail: tail } => catStrings(t, nameText( st, tail)),
        };
    };
    return "";
};

fn exprParts(st: &St, id: Int) -> List<Int> ~ {
    // [f, xs] when id is Expression F, else []
    n = nodeAt( st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        return match v {
            AstExpression::F { f: f, xs: xs } => push(push([], f), xs),
            AstExpression::Val { v: vv } => [],
            AstExpression::Var { n: nn } => [],
        };
    };
    return [];
};

fn exprVarName(st: &St, id: Int) -> String ~ {
    n = nodeAt( st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        return match v {
            AstExpression::Var { n: nn } => nameText( st, nn),
            AstExpression::Val { v: vv } => "",
            AstExpression::F { f: f, xs: xs } => "",
        };
    };
    return "";
};

fn exprListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Expressions {
            v = (n as AstNode::Expressions).value;
            match v {
                AstExpressions::End => { loop = false; },
                AstExpressions::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn clonedBaseOf(st: &St, e: Int) -> List<Int> ~ {
    parts = exprParts( st, e);
    if size(parts) != 2 { return []; };
    fname = exprVarName( st, get(parts, 0));
    if fname != "clone" && fname != ".clone" { return []; };
    args = exprListIds( st, get(parts, 1));
    if size(args) != 1 { return []; };
    return push([], get(args, 0));
};

// ---- struct literals, in expression and in proof form ----


fn litHead(sourceText: &Input, st: St) -> Res<LitOut> ~ {
    // qualified name known to ctors, with generic arguments and an opening brace consumed (or a fieldless variant)
    q = qualifiedName(sourceText, st); Res { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk } = q;
    if !resultPartsqOk { return Res<LitOut> { st: resultPartsqState, v: LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, ok: false }; };
    s = resultPartsqState;
    base = resultPartsqValue;
    matched = matchedCtorName( s, base);
    declared = findCtor( s, matched);
    if size(matched.bytes) = 0 { return fail( s, LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, "not a struct or variant"); };
    isVar = !hasTypeNamed(s, baseNameOf(matched));
    ctorArgs = [];
    candidate = clone(base);
    params = findGenerics( s, matched);
    if size(params) > 0 && !isVar {
        if hasGenericArguments(sourceText, s, params) {
            g = genericArguments(sourceText, skipWs(sourceText, s), params); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
            if !resultPartsgOk { return Res<LitOut> { st: resultPartsgState, v: LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, ok: false }; };
            s = resultPartsgState;
            ctorArgs = resultPartsgValue;
            candidate = instanceNameOf(base, ctorArgs);
            // a candidate instance is not itself declared; Haskell keeps the matched name's fields
        };
    };
    if size(declared) = 0 && isVar {
        s = skipWs(sourceText, s);
        return ok( s, LitOut { name: candidate, ctorArgs: ctorArgs, declared: declared, isVariant: true });
    };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    return ok( s, LitOut { name: candidate, ctorArgs: ctorArgs, declared: declared, isVariant: isVar });
};

fn tryStructLiteralExpr(sourceText: &Input, st: St) -> Res<Int> ~ {
    save = checkpoint(st);
    head = litHead(sourceText, st); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<Int> { st: restore(resultPartsheadState, save), v: 0, ok: false }; };
    s = resultPartsheadState;
    h = resultPartsheadValue;
    if size(h.declared) = 0 && h.isVariant {
        ctor = ctorValue( s, &h.name, [], []); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
        if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
        ve = valExpr( resultPartsctorState, resultPartsctorValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
        if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
        xs = expressionsList( resultPartsveState, []); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
        if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
        return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
    };
    return structFieldsExpr(sourceText, s, h);
};

fn structFieldsExpr(sourceText: &Input, st: St, h: LitOut) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    initNames = [];
    initVals = [];
    hasBase = false;
    base = 0;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "..") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            b = expression(sourceText, s2); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            hasBase = true;
            base = resultPartsbValue;
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            loop = false;
        } else {
            if byteAt(sourceText, s2, s2.pos) = 125 { s = s2; loop = false; }
            else {
                f = parseVariable(sourceText, s2); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
                if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: 0, ok: false }; };
                s = skipWs(sourceText, resultPartsfState);
                if byteAt(sourceText, s, s.pos) != 58 { return fail( s, 0, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                v = expression(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
                s = resultPartsvState;
                initNames = push(initNames, resultPartsfValue);
                initVals = push(initVals, resultPartsvValue);
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            };
        };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    for n in initNames { if !containsName(&h.declared, n) { return fail( s, 0, cat3(cat3("Struct ", &h.name, " has no field "), n, "")); }; };
    if hasDupStrings(initNames) { return fail( s, 0, cat3("Struct ", &h.name, " literal repeats a field")); };
    if hasBase {
        allGiven = true;
        for d in h.declared { if !containsName(initNames, d) { allGiven = false; }; };
        if allGiven { return fail( s, 0, cat3("Struct ", &h.name, " literal gives every field, so ..base copies nothing")); };
    };
    args = [];
    for field in h.declared {
        idx = indexOfName(initNames, field);
        if idx >= 0 { args = push(args, get(initVals, idx)); }
        else {
            if !hasBase { return fail( s, 0, cat3(cat3("Struct ", &h.name, " literal lacks field "), field, "")); };
            cloned = clonedBaseOf( s, base);
            if !s.ownClone && size(cloned) = 1 {
                fv = fieldFromExpr( s, &h.name, get(cloned, 0), field); Res { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk } = fv;
                if !resultPartsfvOk { return Res<Int> { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk }; };
                s = resultPartsfvState;
                cv = primExpr( s, "CloneOf", push([], resultPartsfvValue)); Res { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk } = cv;
                if !resultPartscvOk { return Res<Int> { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk }; };
                s = resultPartscvState;
                args = push(args, resultPartscvValue);
            } else {
                fv = fieldFromExpr( s, &h.name, base, field); Res { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk } = fv;
                if !resultPartsfvOk { return Res<Int> { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk }; };
                s = resultPartsfvState;
                args = push(args, resultPartsfvValue);
            };
        };
    };
    ctor = ctorValue( s, &h.name, &h.ctorArgs, &h.declared); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
    if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
    ve = valExpr( resultPartsctorState, resultPartsctorValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    xs = expressionsList( resultPartsveState, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return exprNode( resultPartsxsState, AstExpression::F { f: resultPartsveValue, xs: resultPartsxsValue });
};

fn fieldFromExpr(st: St, litName: &String, from: Int, field: &String) -> Res<Int> ~ {
    if containsText(litName, "::") {
        cast = castExprOf( st, litName, from); Res { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk } = cast;
        if !resultPartscastOk { return Res<Int> { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk }; };
        return fieldExprOf( resultPartscastState, field, resultPartscastValue);
    };
    return fieldExprOwned( st, litName, field, from);
};

fn hasDupStrings(xs: &List<String>) -> Bool ~ {
    i = 0;
    for x in &xs {
        j = 0;
        for y in &xs { if j > i && y = x { return true; }; j = j + 1; };
        i = i + 1;
    };
    return false;
};

// ---- proofs ----

fn proofNode(st: St, node: AstProof) -> Res<Int> ~ { return emit( st, AstNode::Proof { value: node }); };

fn ctermProof(st: St, valueNode: Int) -> Res<Int> ~ { return proofNode( st, AstProof::CTerm { v: valueNode }); };

fn atermProof(st: St, name: &String) -> Res<Int> ~ {
    n = putName( st, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    return proofNode( resultPartsnState, AstProof::ATerm { n: resultPartsnValue });
};

fn builtinProof(st: St, b: AstBuiltin, params: &List<String>, args: &List<Int>) -> Res<Int> ~ {
    bv = builtinValue( st, b, params); Res { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk } = bv;
    if !resultPartsbvOk { return Res<Int> { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk }; };
    ct = ctermProof( resultPartsbvState, resultPartsbvValue); Res { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk } = ct;
    if !resultPartsctOk { return Res<Int> { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk }; };
    xs = proofsList( resultPartsctState, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return proofNode( resultPartsxsState, AstProof::FApp { f: resultPartsctValue, xs: resultPartsxsValue });
};

fn primProof(st: St, name: &String, args: &List<Int>) -> Res<Int> ~ {
    return builtinProof( st, AstBuiltin::Primitive { name: clone(name) }, primParams(name), args);
};

fn proof(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if keywordAt(sourceText, s, "forall") {
        f = forallProof(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
        if resultPartsfOk { return Res<Int> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk }; };
        return Res<Int> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk };
    };
    return proofOr(sourceText, s);
};

fn proofOr(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = proofAnd(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "||") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = proofAnd(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = primProof( s, "Or", push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn proofAnd(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = proofRel(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "&&") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = proofRel(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = primProof( s, "And", push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn proofRel(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = proofAdd(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        op = relationOpAt(sourceText, s2);
        if size(op.bytes) > 0 {
            s2 = St { pos: s2.pos + size(op.bytes), ..s2 };
            s2 = skipWs(sourceText, s2);
            r = proofAdd(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            b = relProofOf( s, relIndexOf(op), left, resultPartsrValue); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { loop = false; s = s2; };
    };
    s2 = skipWs(sourceText, s);
    k = eatKeyword(sourceText, s2, "is"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if resultPartskValue {
        s3 = skipWs(sourceText, resultPartskState);
        dc = declaredCtorNode(sourceText, s3); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
        if !resultPartsdcOk { return Res<Int> { st: resultPartsdcState, v: 0, ok: false }; };
        s = resultPartsdcState;
        n = putName( s, resultPartsdcValue); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
        if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
        b = builtinProof( resultPartsnState, AstBuiltin::Is { n: resultPartsnValue }, push([], "value"), push([], left)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
        if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
        s = resultPartsbState;
        left = resultPartsbValue;
        s = skipWs(sourceText, s);
    } else { s = resultPartskState; };
    return ok( s, left);
};

fn proofAdd(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = proofMul(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        c = byteAt(sourceText, s2, s2.pos);
        if c = 43 || c = 45 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            r = proofMul(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            s = resultPartsrState;
            name = "Plus";
            if c = 45 { name = "Minus"; };
            b = primProof( s, name, push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            left = resultPartsbValue;
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn proofMul(sourceText: &Input, st: St) -> Res<Int> ~ {
    l = nonInfixProof(sourceText, st); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
    if !resultPartslOk { return Res<Int> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
    s = resultPartslState;
    left = resultPartslValue;
    loop = true;
    while loop ~ {

        s2 = skipWs(sourceText, s);
        c = byteAt(sourceText, s2, s2.pos);
        if c = 42 || c = 47 || c = 37 {
            if c = 47 && byteAt(sourceText, s2, s2.pos + 1) = 47 { s = s2; loop = false; }
            else {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(sourceText, s2);
                r = nonInfixProof(sourceText, s2); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
                if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
                s = resultPartsrState;
                name = "Times";
                if c = 47 { name = "Div"; };
                if c = 37 { name = "Mod"; };
                b = primProof( s, name, push(push([], left), resultPartsrValue)); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
                if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
                s = resultPartsbState;
                left = resultPartsbValue;
            };
        } else { s = s2; loop = false; };
    };
    return ok( s, left);
};

fn forallProof(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = st;
    k = eatKeyword(sourceText, s, "forall"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if !resultPartskValue { return fail( resultPartskState, 0, "expected forall"); };
    s = skipWs(sourceText, resultPartskState);
    idx = parseVariable(sourceText, s); Res { st: resultPartsidxState, v: resultPartsidxValue, ok: resultPartsidxOk } = idx;
    if !resultPartsidxOk { return Res<Int> { st: resultPartsidxState, v: 0, ok: false }; };
    index = resultPartsidxValue;
    s = skipWs(sourceText, resultPartsidxState);
    guards = [];
    body = 0;
    if keywordAt(sourceText, s, "in") {
        k2 = eatKeyword(sourceText, s, "in"); Res { st: resultPartsk2State, v: resultPartsk2Value, ok: resultPartsk2Ok } = k2;
        s = skipWs(sourceText, resultPartsk2State);
        lower = proof(sourceText, s); Res { st: resultPartslowerState, v: resultPartslowerValue, ok: resultPartslowerOk } = lower;
        if !resultPartslowerOk { return Res<Int> { st: resultPartslowerState, v: resultPartslowerValue, ok: resultPartslowerOk }; };
        s = resultPartslowerState;
        s = skipWs(sourceText, s);
        if !peekIs(sourceText, s, "..") { return fail( s, 0, "expected .."); };
        s = St { pos: s.pos + 2, ..s };
        s = skipWs(sourceText, s);
        upper = proof(sourceText, s); Res { st: resultPartsupperState, v: resultPartsupperValue, ok: resultPartsupperOk } = upper;
        if !resultPartsupperOk { return Res<Int> { st: resultPartsupperState, v: resultPartsupperValue, ok: resultPartsupperOk }; };
        s = skipWs(sourceText, resultPartsupperState);
        if byteAt(sourceText, s, s.pos) != 58 { return fail( s, 0, "expected :"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        b = proof(sourceText, s); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
        if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
        s = resultPartsbState;
        body = resultPartsbValue;
        ai = atermProof( s, index); Res { st: resultPartsaiState, v: resultPartsaiValue, ok: resultPartsaiOk } = ai;
        if !resultPartsaiOk { return Res<Int> { st: resultPartsaiState, v: resultPartsaiValue, ok: resultPartsaiOk }; };
        s = resultPartsaiState;
        ge = relProofOf( s, 5, resultPartsaiValue, resultPartslowerValue); Res { st: resultPartsgeState, v: resultPartsgeValue, ok: resultPartsgeOk } = ge;
        if !resultPartsgeOk { return Res<Int> { st: resultPartsgeState, v: resultPartsgeValue, ok: resultPartsgeOk }; };
        s = resultPartsgeState;
        ai2 = atermProof( s, index); Res { st: resultPartsai2State, v: resultPartsai2Value, ok: resultPartsai2Ok } = ai2;
        if !resultPartsai2Ok { return Res<Int> { st: resultPartsai2State, v: resultPartsai2Value, ok: resultPartsai2Ok }; };
        s = resultPartsai2State;
        lt = relProofOf( s, 2, resultPartsai2Value, resultPartsupperValue); Res { st: resultPartsltState, v: resultPartsltValue, ok: resultPartsltOk } = lt;
        if !resultPartsltOk { return Res<Int> { st: resultPartsltState, v: resultPartsltValue, ok: resultPartsltOk }; };
        s = resultPartsltState;
        guards = push(push([], resultPartsgeValue), resultPartsltValue);
    } else {
        k2 = eatKeyword(sourceText, s, "where"); Res { st: resultPartsk2State, v: resultPartsk2Value, ok: resultPartsk2Ok } = k2;
        if !resultPartsk2Value { return fail( resultPartsk2State, 0, "expected where or in"); };
        s = skipWs(sourceText, resultPartsk2State);
        loop = true;
        while loop ~ {
            g = proof(sourceText, s); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
            if !resultPartsgOk { return Res<Int> { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk }; };
            s = resultPartsgState;
            guards = push(guards, resultPartsgValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
        if byteAt(sourceText, s, s.pos) != 58 { return fail( s, 0, "expected :"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        b = proof(sourceText, s); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
        if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
        s = resultPartsbState;
        body = resultPartsbValue;
    };
    if proofHasForall( s, body) { return fail( s, 0, "forall does not nest"); };
    for g in guards { if proofHasForall( s, g) { return fail( s, 0, "forall does not nest"); }; };
    boundGuards = [];
    for g in guards {
        bg = bindIndex( s, g, index);
        s = bg;
        boundGuards = push(boundGuards, g);
        // bindIndex mutates nodes in place; the id is unchanged
    };
    s2 = bindIndex( s, body, index);
    n = putName( s2, index); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    s = resultPartsnState;
    gl = proofsList( s, boundGuards); Res { st: resultPartsglState, v: resultPartsglValue, ok: resultPartsglOk } = gl;
    if !resultPartsglOk { return Res<Int> { st: resultPartsglState, v: resultPartsglValue, ok: resultPartsglOk }; };
    return proofNode( resultPartsglState, AstProof::Forall { n: resultPartsnValue, gs: resultPartsglValue, b: body });
};

fn relProofOf(st: St, r: Int, l: Int, rr: Int) -> Res<Int> ~ {
    bv = relValue( st, r); Res { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk } = bv;
    if !resultPartsbvOk { return Res<Int> { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk }; };
    ct = ctermProof( resultPartsbvState, resultPartsbvValue); Res { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk } = ct;
    if !resultPartsctOk { return Res<Int> { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk }; };
    xs = proofsList( resultPartsctState, push(push([], l), rr)); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return proofNode( resultPartsxsState, AstProof::FApp { f: resultPartsctValue, xs: resultPartsxsValue });
};

fn proofHasForall(st: &St, id: Int) -> Bool ~ {
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        exists = false;
        match v {
            AstProof::Forall { n: a, gs: b, b: c } => { exists = true; },
            AstProof::FApp { f: f, xs: xs } => {
                exists = proofHasForall( st, f);
                for x in proofListIds( st, xs) { if proofHasForall( st, x) { exists = true; }; };
            },
            AstProof::ATerm { n: a } => { exists = false; },
            AstProof::CTerm { v: a } => { exists = false; },
            AstProof::BVar { n: a } => { exists = false; },
        };
        return exists;
    };
    return false;
};

fn proofListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Proofs {
            v = (n as AstNode::Proofs).value;
            match v {
                AstProofs::End => { loop = false; },
                AstProofs::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn bindIndex(st: St, id: Int, index: &String) -> St ~ {
    s = st;
    n = nodeAt( s, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        match v {
            AstProof::ATerm { n: a } => {
                if nameText( s, a) = index {
                    s = setNodeAt( s, id, AstNode::Proof { value: AstProof::BVar { n: a } });
                };
            },
            AstProof::FApp { f: f, xs: xs } => {
                s = bindIndex( s, f, index);
                for x in proofListIds( s, xs) { s = bindIndex( s, x, index); };
            },
            AstProof::CTerm { v: a } => { },
            AstProof::Forall { n: a, gs: b, b: c } => { },
            AstProof::BVar { n: a } => { },
        };
    };
    return s;
};

fn nonInfixProof(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if keywordAt(sourceText, s, "old") {
        save = checkpoint(s);
        k = eatKeyword(sourceText, s, "old"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        s2 = skipWs(sourceText, resultPartskState);
        if byteAt(sourceText, s2, s2.pos) = 40 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            inner = proof(sourceText, s2); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
            if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
            s2 = skipWs(sourceText, resultPartsinnerState);
            if byteAt(sourceText, s2, s2.pos) != 41 { return fail( s2, 0, "expected )"); };
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            return primProof( s2, "OldOf", push([], resultPartsinnerValue));
        };
        s = restore(s2, save);
    };
    c = byteAt(sourceText, s, s.pos);
    if c = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = nonInfixProof(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        return primProof( resultPartsinnerState, "DerefOf", push([], resultPartsinnerValue));
    };
    if c = 34 {
        lit = stringLiteralProof(sourceText, s); Res { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk } = lit;
        if !resultPartslitOk { return Res<Int> { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk }; };
        return withFieldsProof(sourceText, resultPartslitState, resultPartslitValue);
    };
    if c = 35 {
        s = St { pos: s.pos + 1, ..s };
        v = valueNode(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
        ct = ctermProof( resultPartsvState, resultPartsvValue); Res { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk } = ct;
        if !resultPartsctOk { return Res<Int> { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk }; };
        return builtinProof( resultPartsctState, AstBuiltin::Primitive { name: "ArrayFrom" }, push([], "list"), push([], resultPartsctValue));
        // Haskell: FApp (CTerm ArrayFromSym) [CTerm items]; the argument is the value itself as CTerm
    };
    base = proofBase(sourceText, s); Res { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk } = base;
    if !resultPartsbaseOk { return Res<Int> { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk }; };
    return withFieldsProof(sourceText, resultPartsbaseState, resultPartsbaseValue);
};

fn stringLiteralProof(sourceText: &Input, st: St) -> Res<Int> ~ {
    if !stringCtorCheck( st) { return fail( st, 0, "a string literal needs the library String, which this program declares differently"); };
    sb = stringBytes(sourceText, st); Res { st: resultPartssbState, v: resultPartssbValue, ok: resultPartssbOk } = sb;
    if !resultPartssbOk { return Res<Int> { st: resultPartssbState, v: 0, ok: false }; };
    s = resultPartssbState;
    vals = [];
    for b in resultPartssbValue {
        nm = putName( s, String::fromInt(b)); Res { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk } = nm;
        if !resultPartsnmOk { return Res<Int> { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk }; };
        s = resultPartsnmState;
        vn = emit( s, AstNode::Value { value: AstValue::VInt { n: resultPartsnmValue } }); Res { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk } = vn;
        s = resultPartsvnState;
        vals = push(vals, resultPartsvnValue);
    };
    lst = valuesList( s, vals); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    lv = emit( resultPartslstState, AstNode::Value { value: AstValue::VList { xs: resultPartslstValue } }); Res { st: resultPartslvState, v: resultPartslvValue, ok: resultPartslvOk } = lv;
    ctLv = ctermProof( resultPartslvState, resultPartslvValue); Res { st: resultPartsctLvState, v: resultPartsctLvValue, ok: resultPartsctLvOk } = ctLv;
    bytesFrom = primProof( resultPartsctLvState, "BytesFrom", push([], resultPartsctLvValue)); Res { st: resultPartsbytesFromState, v: resultPartsbytesFromValue, ok: resultPartsbytesFromOk } = bytesFrom;
    if !resultPartsbytesFromOk { return Res<Int> { st: resultPartsbytesFromState, v: resultPartsbytesFromValue, ok: resultPartsbytesFromOk }; };
    ctor = ctorSymbolProof( resultPartsbytesFromState, "String", [], push([], "bytes")); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
    if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
    xs = proofsList( resultPartsctorState, push([], resultPartsbytesFromValue)); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return proofNode( resultPartsxsState, AstProof::FApp { f: resultPartsctorValue, xs: resultPartsxsValue });
};

fn proofBase(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = st;
    c = byteAt(sourceText, s, s.pos);
    if c = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = proof(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        s = skipWs(sourceText, resultPartsinnerState);
        if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        return ok( s, resultPartsinnerValue);
    };
    // value (concrete)
    if isDigitCp(c) || c = 45 || c = 91 || keywordAt(sourceText, s, "true") || keywordAt(sourceText, s, "false") {
        v = valueNode(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
        return ctermProof( resultPartsvState, resultPartsvValue);
    };
    // struct literal in proof form
    lit = tryStructLiteralProof(sourceText, s); Res { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk } = lit;
    if resultPartslitOk { return Res<Int> { st: resultPartslitState, v: resultPartslitValue, ok: resultPartslitOk }; };
    s = resultPartslitState;
    // function proof or abstract term
    q = qualifiedName(sourceText, s); Res { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk } = q;
    if !resultPartsqOk { return Res<Int> { st: resultPartsqState, v: 0, ok: false }; };
    s = resultPartsqState;
    if byteAt(sourceText, s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        args = [];
        if byteAt(sourceText, s, s.pos) != 41 {
            loop = true;
            while loop ~ {
                a = proof(sourceText, s); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
                if !resultPartsaOk { return Res<Int> { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk }; };
                s = resultPartsaState;
                args = push(args, resultPartsaValue);
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
            };
        };
        if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        prim = proofPrimName(resultPartsqValue);
        funct = 0;
        if size(prim.bytes) > 0 {
            bv = primValue( s, prim); Res { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk } = bv;
            if !resultPartsbvOk { return Res<Int> { st: resultPartsbvState, v: resultPartsbvValue, ok: resultPartsbvOk }; };
            ct = ctermProof( resultPartsbvState, resultPartsbvValue); Res { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk } = ct;
            if !resultPartsctOk { return Res<Int> { st: resultPartsctState, v: resultPartsctValue, ok: resultPartsctOk }; };
            s = resultPartsctState;
            funct = resultPartsctValue;
        } else {
            at = atermProof( s, resultPartsqValue); Res { st: resultPartsatState, v: resultPartsatValue, ok: resultPartsatOk } = at;
            if !resultPartsatOk { return Res<Int> { st: resultPartsatState, v: resultPartsatValue, ok: resultPartsatOk }; };
            s = resultPartsatState;
            funct = resultPartsatValue;
        };
        xs = proofsList( s, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
        if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
        return proofNode( resultPartsxsState, AstProof::FApp { f: funct, xs: resultPartsxsValue });
    };
    if containsText(resultPartsqValue, "::") { return fail( s, 0, "expected ("); };
    return atermProof( s, resultPartsqValue);
};

fn withFieldsProof(sourceText: &Input, st: St, base: Int) -> Res<Int> ~ {
    s = st;
    acc = base;
    loop = true;
    while loop ~ {
        s = skipWs(sourceText, s);
        k = eatKeyword(sourceText, s, "as"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        if resultPartskValue {
            s2 = skipWs(sourceText, resultPartskState);
            dc = declaredCtorNode(sourceText, s2); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
            if !resultPartsdcOk { return Res<Int> { st: resultPartsdcState, v: 0, ok: false }; };
            s = resultPartsdcState;
            n = putName( s, resultPartsdcValue); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
            if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
            cast = builtinProof( resultPartsnState, AstBuiltin::Cast { n: resultPartsnValue }, push([], "value"), push([], acc)); Res { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk } = cast;
            if !resultPartscastOk { return Res<Int> { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk }; };
            s = resultPartscastState;
            acc = resultPartscastValue;
            s = skipWs(sourceText, s);
        } else {
            s = resultPartskState;
            if byteAt(sourceText, s, s.pos) = 46 && byteAt(sourceText, s, s.pos + 1) != 46 {
                s = St { pos: s.pos + 1, ..s };
                fname = "";
                if byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 {
                    start = s.pos;
                    while byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
                    fname = srcSlice(sourceText, s, start, s.pos);
                } else {
                    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
                    fname = resultPartsvValue;
                    s = resultPartsvState;
                };
                n = putName( s, fname); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
                if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
                on = optNameNode( resultPartsnState, false, ""); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
                if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
                fe = builtinProof( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsnValue }, push([], "struct"), push([], acc)); Res { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk } = fe;
                if !resultPartsfeOk { return Res<Int> { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk }; };
                s = resultPartsfeState;
                acc = resultPartsfeValue;
                s = skipWs(sourceText, s);
            } else { loop = false; };
        };
    };
    return ok( s, acc);
};

fn tryStructLiteralProof(sourceText: &Input, st: St) -> Res<Int> ~ {
    save = checkpoint(st);
    head = litHead(sourceText, st); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<Int> { st: restore(resultPartsheadState, save), v: 0, ok: false }; };
    s = resultPartsheadState;
    h = resultPartsheadValue;
    if size(h.declared) = 0 && h.isVariant {
        ctor = ctorSymbolProof( s, &h.name, [], []); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
        if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
        xs = proofsList( resultPartsctorState, []); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
        if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
        return proofNode( resultPartsxsState, AstProof::FApp { f: resultPartsctorValue, xs: resultPartsxsValue });
    };
    return structFieldsProof(sourceText, s, h);
};

fn ctorSymbolProof(st: St, name: &String, args: &List<ArgV>, fields: &List<String>) -> Res<Int> ~ {
    cv = ctorValue( st, name, args, fields); Res { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk } = cv;
    if !resultPartscvOk { return Res<Int> { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk }; };
    return ctermProof( resultPartscvState, resultPartscvValue);
};

fn structFieldsProof(sourceText: &Input, st: St, h: LitOut) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    initNames = [];
    initVals = [];
    hasBase = false;
    base = 0;
    loop = true;
    while loop ~ {
        s2 = skipWs(sourceText, s);
        if peekIs(sourceText, s2, "..") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(sourceText, s2);
            b = proof(sourceText, s2); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
            s = resultPartsbState;
            hasBase = true;
            base = resultPartsbValue;
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            loop = false;
        } else {
            if byteAt(sourceText, s2, s2.pos) = 125 { s = s2; loop = false; }
            else {
                f = parseVariable(sourceText, s2); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
                if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: 0, ok: false }; };
                s = skipWs(sourceText, resultPartsfState);
                if byteAt(sourceText, s, s.pos) != 58 { return fail( s, 0, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                v = proof(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
                s = resultPartsvState;
                initNames = push(initNames, resultPartsfValue);
                initVals = push(initVals, resultPartsvValue);
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            };
        };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    for n in initNames { if !containsName(&h.declared, n) { return fail( s, 0, cat3(cat3("Struct ", &h.name, " has no field "), n, "")); }; };
    if hasDupStrings(initNames) { return fail( s, 0, cat3("Struct ", &h.name, " literal repeats a field")); };
    if hasBase {
        allGiven = true;
        for d in h.declared { if !containsName(initNames, d) { allGiven = false; }; };
        if allGiven { return fail( s, 0, cat3("Struct ", &h.name, " literal gives every field, so ..base copies nothing")); };
    };
    args = [];
    for field in h.declared {
        idx = indexOfName(initNames, field);
        if idx >= 0 { args = push(args, get(initVals, idx)); }
        else {
            if !hasBase { return fail( s, 0, cat3(cat3("Struct ", &h.name, " literal lacks field "), field, "")); };
            fv = fieldFromProof( s, &h.name, base, field); Res { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk } = fv;
            if !resultPartsfvOk { return Res<Int> { st: resultPartsfvState, v: resultPartsfvValue, ok: resultPartsfvOk }; };
            s = resultPartsfvState;
            args = push(args, resultPartsfvValue);
        };
    };
    ctor = ctorSymbolProof( s, &h.name, &h.ctorArgs, &h.declared); Res { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk } = ctor;
    if !resultPartsctorOk { return Res<Int> { st: resultPartsctorState, v: resultPartsctorValue, ok: resultPartsctorOk }; };
    xs = proofsList( resultPartsctorState, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return proofNode( resultPartsxsState, AstProof::FApp { f: resultPartsctorValue, xs: resultPartsxsValue });
};

fn fieldFromProof(st: St, litName: &String, from: Int, field: &String) -> Res<Int> ~ {
    if containsText(litName, "::") {
        n = putName( st, litName); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
        if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
        cast = builtinProof( resultPartsnState, AstBuiltin::Cast { n: resultPartsnValue }, push([], "value"), push([], from)); Res { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk } = cast;
        if !resultPartscastOk { return Res<Int> { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk }; };
        fn2 = putName( resultPartscastState, field); Res { st: resultPartsfn2State, v: resultPartsfn2Value, ok: resultPartsfn2Ok } = fn2;
        if !resultPartsfn2Ok { return Res<Int> { st: resultPartsfn2State, v: resultPartsfn2Value, ok: resultPartsfn2Ok }; };
        on = optNameNode( resultPartsfn2State, false, ""); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
        if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
        return builtinProof( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsfn2Value }, push([], "struct"), push([], resultPartscastValue));
    };
    n = putName( st, field); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    on = optNameNode( resultPartsnState, true, litName); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
    if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
    return builtinProof( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsnValue }, push([], "struct"), push([], from));
};

// ---- validation statements ----

fn validationNode(st: St, node: AstValidation) -> Res<Int> ~ { return emit( st, AstNode::Validation { value: node }); };

fn stmtNode(st: St, node: AstStatement) -> Res<Int> ~ { return emit( st, AstNode::Statement { value: node }); };

fn proofBuiltinKind(st: &St, id: Int) -> String ~ {
    // the primitive name of a CTerm builtin proof, or ""
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = "";
        match v {
            AstProof::CTerm { v: vv } => { out = valueBuiltinPrim( st, vv); },
            AstProof::FApp { f: a, xs: b } => { out = ""; },
            AstProof::ATerm { n: a } => { out = ""; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = ""; },
            AstProof::BVar { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn valueBuiltinPrim(st: &St, valueId: Int) -> String ~ {
    n = nodeAt( st, valueId);
    if n is AstNode::Value {
        v = (n as AstNode::Value).value;
        out = "";
        match v {
            AstValue::VFunct { ps: a, ins: b, outs: c, body: d, exports: e } => { out = bodyPrimName( st, d); },
            AstValue::VInt { n: a } => { out = ""; },
            AstValue::VList { xs: a } => { out = ""; },
            AstValue::VBool { b: a } => { out = ""; },
            AstValue::VData { n: a, xs: b } => { out = ""; },
            AstValue::VFnRef { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn bodyPrimName(st: &St, bodyId: Int) -> String ~ {
    n = nodeAt( st, bodyId);
    if n is AstNode::Body {
        v = (n as AstNode::Body).value;
        out = "";
        match v {
            AstBody::BuiltinFunct { b: b } => { out = builtinPrimName( st, b); },
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn builtinPrimName(st: &St, builtinId: Int) -> String ~ {
    n = nodeAt( st, builtinId);
    if n is AstNode::Builtin {
        v = (n as AstNode::Builtin).value;
        out = "";
        match v {
            AstBuiltin::Primitive { name: nm } => { out = clone(nm); },
            AstBuiltin::Ctor { n: a, args: b, fs: c } => { out = ""; },
            AstBuiltin::FieldBuiltin { owner: a, n: b } => { out = ""; },
            AstBuiltin::Is { n: a } => { out = ""; },
            AstBuiltin::Project { n: a, f: b } => { out = ""; },
            AstBuiltin::Cast { n: a } => { out = ""; },
            AstBuiltin::ToWord { signed: a, bits: b } => { out = ""; },
            AstBuiltin::Rel { r: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn proofFAppParts(st: &St, id: Int) -> List<Int> ~ {
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = [];
        match v {
            AstProof::FApp { f: f, xs: xs } => { out = push(push([], f), xs); },
            AstProof::ATerm { n: a } => { out = []; },
            AstProof::CTerm { v: a } => { out = []; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = []; },
            AstProof::BVar { n: a } => { out = []; },
        };
        return out;
    };
    return [];
};

fn proofATermName(st: &St, id: Int) -> String ~ {
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = "";
        match v {
            AstProof::ATerm { n: a } => { out = nameText( st, a); },
            AstProof::FApp { f: a, xs: b } => { out = ""; },
            AstProof::CTerm { v: a } => { out = ""; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = ""; },
            AstProof::BVar { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn conjunctsOf(st: St, id: Int) -> Res<List<Int>> ~ {
    parts = proofFAppParts( st, id);
    if size(parts) = 2 && proofBuiltinKind( st, get(parts, 0)) = "And" {
        args = proofListIds( st, get(parts, 1));
        if size(args) = 2 {
            l = conjunctsOf( st, get(args, 0)); Res { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk } = l;
            if !resultPartslOk { return Res<List<Int>> { st: resultPartslState, v: resultPartslValue, ok: resultPartslOk }; };
            r = conjunctsOf( resultPartslState, get(args, 1)); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
            if !resultPartsrOk { return Res<List<Int>> { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk }; };
            out = clone(resultPartslValue);
            for x in resultPartsrValue { out = push(out, x); };
            return ok( resultPartsrState, out);
        };
    };
    return ok( st, push([], id));
};

fn mentionsConnective(st: &St, id: Int) -> Bool ~ {
    k = proofBuiltinKind( st, id);
    if k = "And" || k = "Or" || k = "Not" { return true; };
    parts = proofFAppParts( st, id);
    if size(parts) = 2 {
        if mentionsConnective( st, get(parts, 0)) { return true; };
        for x in proofListIds( st, get(parts, 1)) { if mentionsConnective( st, x) { return true; }; };
        return false;
    };
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = false;
        match v {
            AstProof::Forall { n: a, gs: gs, b: b } => {
                out = mentionsConnective( st, b);
                for g in proofListIds( st, gs) { if mentionsConnective( st, g) { out = true; }; };
            },
            AstProof::FApp { f: a, xs: b } => { out = false; },
            AstProof::ATerm { n: a } => { out = false; },
            AstProof::CTerm { v: a } => { out = false; },
            AstProof::BVar { n: a } => { out = false; },
        };
        return out;
    };
    return false;
};

fn copyProof(st: St, id: Int) -> Res<Int> ~ {
    n = nodeAt( st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        return match v {
            AstProof::ATerm { n: a } => copyATerm( st, a),
            AstProof::BVar { n: a } => copyBVar( st, a),
            AstProof::CTerm { v: a } => copyCTerm( st, a),
            AstProof::FApp { f: f, xs: xs } => copyFApp( st, f, xs),
            AstProof::Forall { n: a, gs: b, b: c } => copyForall( st, a, b, c),
        };
    };
    return fail( st, 0, "internal: not a proof");
};

fn copyNameId(st: St, id: Int) -> Res<Int> ~ {
    // a fresh copy of a name node chain
    text = nameText( st, id);
    return putName( st, text);
};

fn copyATerm(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return proofNode( resultPartsnnState, AstProof::ATerm { n: resultPartsnnValue });
};

fn copyBVar(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return proofNode( resultPartsnnState, AstProof::BVar { n: resultPartsnnValue });
};

fn copyCTerm(st: St, valueId: Int) -> Res<Int> ~ {
    cv = copyValue( st, valueId); Res { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk } = cv;
    if !resultPartscvOk { return Res<Int> { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk }; };
    return proofNode( resultPartscvState, AstProof::CTerm { v: resultPartscvValue });
};

fn copyFApp(st: St, f: Int, xs: Int) -> Res<Int> ~ {
    cf = copyProof( st, f); Res { st: resultPartscfState, v: resultPartscfValue, ok: resultPartscfOk } = cf;
    if !resultPartscfOk { return Res<Int> { st: resultPartscfState, v: resultPartscfValue, ok: resultPartscfOk }; };
    s = resultPartscfState;
    ids = [];
    for x in proofListIds( s, xs) {
        cx = copyProof( s, x); Res { st: resultPartscxState, v: resultPartscxValue, ok: resultPartscxOk } = cx;
        if !resultPartscxOk { return Res<Int> { st: resultPartscxState, v: resultPartscxValue, ok: resultPartscxOk }; };
        s = resultPartscxState;
        ids = push(ids, resultPartscxValue);
    };
    lst = proofsList( s, ids); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    return proofNode( resultPartslstState, AstProof::FApp { f: resultPartscfValue, xs: resultPartslstValue });
};

fn copyForall(st: St, nameId: Int, gs: Int, b: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    ids = [];
    for g in proofListIds( s, gs) {
        cg = copyProof( s, g); Res { st: resultPartscgState, v: resultPartscgValue, ok: resultPartscgOk } = cg;
        if !resultPartscgOk { return Res<Int> { st: resultPartscgState, v: resultPartscgValue, ok: resultPartscgOk }; };
        s = resultPartscgState;
        ids = push(ids, resultPartscgValue);
    };
    cb = copyProof( s, b); Res { st: resultPartscbState, v: resultPartscbValue, ok: resultPartscbOk } = cb;
    if !resultPartscbOk { return Res<Int> { st: resultPartscbState, v: resultPartscbValue, ok: resultPartscbOk }; };
    lst = proofsList( resultPartscbState, ids); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    return proofNode( resultPartslstState, AstProof::Forall { n: resultPartsnnValue, gs: resultPartslstValue, b: resultPartscbValue });
};

fn copyValue(st: St, id: Int) -> Res<Int> ~ {
    // values in proofs are literals and builtin symbols; copy the node kinds that occur
    n = nodeAt( st, id);
    if n is AstNode::Value {
        v = (n as AstNode::Value).value;
        return match v {
            AstValue::VInt { n: a } => copyVInt( st, a),
            AstValue::VBool { b: b } => emit( st, AstNode::Value { value: AstValue::VBool { b: b } }),
            AstValue::VList { xs: xs } => copyVList( st, xs),
            AstValue::VData { n: a, xs: b } => copyVData( st, a, b),
            AstValue::VFnRef { n: a } => copyVFnRef( st, a),
            AstValue::VFunct { ps: a, ins: b, outs: c, body: d, exports: e } => copyVFunct( st, a, b, c, d, e),
        };
    };
    return fail( st, 0, "internal: not a value");
};

fn copyVInt(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return emit( resultPartsnnState, AstNode::Value { value: AstValue::VInt { n: resultPartsnnValue } });
};

fn copyVFnRef(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return emit( resultPartsnnState, AstNode::Value { value: AstValue::VFnRef { n: resultPartsnnValue } });
};

fn valuesListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Values {
            v = (n as AstNode::Values).value;
            match v {
                AstValues::End => { loop = false; },
                AstValues::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyVList(st: St, xs: Int) -> Res<Int> ~ {
    s = st;
    ids = [];
    for x in valuesListIds( s, xs) {
        cx = copyValue( s, x); Res { st: resultPartscxState, v: resultPartscxValue, ok: resultPartscxOk } = cx;
        if !resultPartscxOk { return Res<Int> { st: resultPartscxState, v: resultPartscxValue, ok: resultPartscxOk }; };
        s = resultPartscxState;
        ids = push(ids, resultPartscxValue);
    };
    lst = valuesList( s, ids); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    return emit( resultPartslstState, AstNode::Value { value: AstValue::VList { xs: resultPartslstValue } });
};

fn valueFieldsListIds(st: &St, id: Int) -> List<IdPair> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::ValueFields {
            v = (n as AstNode::ValueFields).value;
            match v {
                AstValueFields::End => { loop = false; },
                AstValueFields::Cons { head: h, tail: t } => {
                    hn = nodeAt( st, h);
                    if hn is AstNode::ValueField {
                        hv = (hn as AstNode::ValueField).value;
                        out = push(out, IdPair { a: hv.n, b: hv.v });
                    };
                    cur = t;
                },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyVData(st: St, nameId: Int, xs: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    ids = [];
    for pair in valueFieldsListIds( s, xs) {
        fnn = copyNameId( s, pair.a); Res { st: resultPartsfnnState, v: resultPartsfnnValue, ok: resultPartsfnnOk } = fnn;
        if !resultPartsfnnOk { return Res<Int> { st: resultPartsfnnState, v: resultPartsfnnValue, ok: resultPartsfnnOk }; };
        s = resultPartsfnnState;
        cv = copyValue( s, pair.b); Res { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk } = cv;
        if !resultPartscvOk { return Res<Int> { st: resultPartscvState, v: resultPartscvValue, ok: resultPartscvOk }; };
        s = resultPartscvState;
        vf = emit( s, AstNode::ValueField { value: AstValueField { n: resultPartsfnnValue, v: resultPartscvValue } }); Res { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk } = vf;
        s = resultPartsvfState;
        ids = push(ids, resultPartsvfValue);
    };
    lst = valueFieldsList( s, ids); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
    return emit( resultPartslstState, AstNode::Value { value: AstValue::VData { n: resultPartsnnValue, xs: resultPartslstValue } });
};

fn copyVFunct(st: St, ps: Int, ins: Int, outs: Int, body: Int, exports: Int) -> Res<Int> ~ {
    // only builtin symbols occur in proofs: params names, two empty validation lists, a Builtin body, empty proofs
    bn = nodeAt( st, body);
    prim = "";
    if bn is AstNode::Body {
        bv = (bn as AstNode::Body).value;
        match bv {
            AstBody::BuiltinFunct { b: b } => { prim = builtinPrimName( st, b); },
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => { prim = ""; },
        };
    };
    if size(prim.bytes) = 0 {
        // a Ctor/Field/etc symbol: rebuild from the builtin node copy
        return copyVFunctGeneric( st, ps, ins, outs, body, exports);
    };
    names = namesListIds( st, ps);
    texts = [];
    for nid in names { texts = push(texts, nameText( st, nid)); };
    return primValue( st, prim);
};

fn copyVFunctGeneric(st: St, ps: Int, ins: Int, outs: Int, body: Int, exports: Int) -> Res<Int> ~ {
    bn = nodeAt( st, body);
    if bn is AstNode::Body {
        bv = (bn as AstNode::Body).value;
        return match bv {
            AstBody::BuiltinFunct { b: b } => copyBuiltinSymbolValue( st, b, ps),
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => fail( st, 0, "internal: cannot copy function value"),
        };
    };
    return fail( st, 0, "internal: cannot copy function value");
};
fn copyBuiltinSymbolValue(st: St, builtinId: Int, ps: Int) -> Res<Int> ~ {
    n = nodeAt( st, builtinId);
    if n is AstNode::Builtin {
        v = (n as AstNode::Builtin).value;
        return match v {
            AstBuiltin::Primitive { name: nm } => primValue( st, nm),
            AstBuiltin::Rel { r: r } => relValue( st, r),
            AstBuiltin::ToWord { signed: a, bits: b } => builtinValue( st, AstBuiltin::ToWord { signed: a, bits: b }, push([], "x")),
            AstBuiltin::Ctor { n: a, args: b, fs: c } => copyCtorSymbol( st, a, b, c),
            AstBuiltin::FieldBuiltin { owner: a, n: b } => copyFieldSymbol( st, a, b),
            AstBuiltin::Is { n: a } => copyIsSymbol( st, a),
            AstBuiltin::Project { n: a, f: b } => copyProjectSymbol( st, a, b),
            AstBuiltin::Cast { n: a } => copyCastSymbol( st, a),
        };
    };
    return fail( st, 0, "internal: cannot copy builtin");
};
fn namesListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Names {
            v = (n as AstNode::Names).value;
            match v {
                AstNames::End => { loop = false; },
                AstNames::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn argsListValues(st: &St, id: Int) -> List<ArgV> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Args {
            v = (n as AstNode::Args).value;
            match v {
                AstArgs::End => { loop = false; },
                AstArgs::Cons { head: h, tail: t } => {
                    hn = nodeAt( st, h);
                    if hn is AstNode::Arg {
                        hv = (hn as AstNode::Arg).value;
                        match hv {
                            AstArg::ArgSize { s: s } => { sn = nodeAt( st, s); if sn is AstNode::Size { out = push(out, ArgV { isSize: true, size: (sn as AstNode::Size).value, ty: Type::TInt }); }; },
                            AstArg::ArgType { t: t } => { tn = nodeAt( st, t); if tn is AstNode::Type { out = push(out, ArgV { isSize: false, size: Size::SAny, ty: (tn as AstNode::Type).value }); }; },
                        };
                    };
                    cur = t;
                },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyCtorSymbol(st: St, nameId: Int, argsId: Int, fsId: Int) -> Res<Int> ~ {
    name = nameText( st, nameId);
    args = argsListValues( st, argsId);
    fields = [];
    for nid in namesListIds( st, fsId) { fields = push(fields, nameText( st, nid)); };
    return ctorValue( st, name, args, fields);
};

fn copyFieldSymbol(st: St, ownerId: Int, nameId: Int) -> Res<Int> ~ {
    name = nameText( st, nameId);
    on = nodeAt( st, ownerId);
    has = false;
    owner = "";
    if on is AstNode::OptName {
        ov = (on as AstNode::OptName).value;
        match ov {
            AstOptName::NoName => { has = false; },
            AstOptName::SomeName { n: a } => { has = true; owner = nameText( st, a); },
        };
    };
    nn = putName( st, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    onn = optNameNode( resultPartsnnState, has, owner); Res { st: resultPartsonnState, v: resultPartsonnValue, ok: resultPartsonnOk } = onn;
    if !resultPartsonnOk { return Res<Int> { st: resultPartsonnState, v: resultPartsonnValue, ok: resultPartsonnOk }; };
    return builtinValue( resultPartsonnState, AstBuiltin::FieldBuiltin { owner: resultPartsonnValue, n: resultPartsnnValue }, push([], "struct"));
};

fn copyIsSymbol(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return builtinValue( resultPartsnnState, AstBuiltin::Is { n: resultPartsnnValue }, push([], "value"));
};

fn copyCastSymbol(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return builtinValue( resultPartsnnState, AstBuiltin::Cast { n: resultPartsnnValue }, push([], "value"));
};

fn copyProjectSymbol(st: St, nameId: Int, fieldId: Int) -> Res<Int> ~ {
    nn = copyNameId( st, nameId); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    ff = copyNameId( resultPartsnnState, fieldId); Res { st: resultPartsffState, v: resultPartsffValue, ok: resultPartsffOk } = ff;
    if !resultPartsffOk { return Res<Int> { st: resultPartsffState, v: resultPartsffValue, ok: resultPartsffOk }; };
    return builtinValue( resultPartsffState, AstBuiltin::Project { n: resultPartsnnValue, f: resultPartsffValue }, push([], "value"));
};

// `affirm a && b;` is two statements, and `affirm whole(b);` is two facts
fn splitAffirm(st: St, validationId: Int) -> Res<List<Int>> ~ {
    n = nodeAt( st, validationId);
    isAssert = false;
    proofId = 0;
    if n is AstNode::Validation {
        v = (n as AstNode::Validation).value;
        match v {
            AstValidation::ProofAssert { p: p } => { isAssert = true; proofId = p; },
            AstValidation::Rewrite { r: a } => { isAssert = false; },
            AstValidation::AssignProofVar { n: a, e: b } => { isAssert = false; },
            AstValidation::Assume { p: a } => { isAssert = false; },
        };
    };
    if !isAssert { return ok( st, push([], validationId)); };
    cs = conjunctsOf( st, proofId); Res { st: resultPartscsState, v: resultPartscsValue, ok: resultPartscsOk } = cs;
    if !resultPartscsOk { return Res<List<Int>> { st: resultPartscsState, v: resultPartscsValue, ok: resultPartscsOk }; };
    s = resultPartscsState;
    out = [];
    for q in resultPartscsValue {
        if mentionsConnective( s, q) { return fail( s, [], "a proof is not made of || or !: `affirm a && b;` is two statements, and a condition that is not a conjunction is not provable by this validator"); };
        facts = wholeFacts( s, q); Res { st: resultPartsfactsState, v: resultPartsfactsValue, ok: resultPartsfactsOk } = facts;
        if !resultPartsfactsOk { return Res<List<Int>> { st: resultPartsfactsState, v: resultPartsfactsValue, ok: resultPartsfactsOk }; };
        s = resultPartsfactsState;
        for f in resultPartsfactsValue { out = push(out, f); };
    };
    return ok( s, out);
};

fn wholeFacts(st: St, q: Int) -> Res<List<Int>> ~ {
    // [validationId] normally; the two facts of whole(b) as ProofAssert validation nodes
    parts = proofFAppParts( st, q);
    if size(parts) = 2 && proofATermName( st, get(parts, 0)) = "whole" {
        args = proofListIds( st, get(parts, 1));
        if size(args) = 1 {
            b = get(args, 0);
            s = st;
            b1 = copyProof( s, b); Res { st: resultPartsb1State, v: resultPartsb1Value, ok: resultPartsb1Ok } = b1;
            if !resultPartsb1Ok { return Res<List<Int>> { st: resultPartsb1State, v: [], ok: false }; };
            s = resultPartsb1State;
            startP = atermProof( s, "start"); Res { st: resultPartsstartPState, v: resultPartsstartPValue, ok: resultPartsstartPOk } = startP;
            if !resultPartsstartPOk { return Res<List<Int>> { st: resultPartsstartPState, v: [], ok: false }; };
            s = resultPartsstartPState;
            f1 = fappProofRaw( s, resultPartsstartPValue, push([], resultPartsb1Value)); Res { st: resultPartsf1State, v: resultPartsf1Value, ok: resultPartsf1Ok } = f1;
            if !resultPartsf1Ok { return Res<List<Int>> { st: resultPartsf1State, v: [], ok: false }; };
            s = resultPartsf1State;
            zero = intValueProof( s, 0); Res { st: resultPartszeroState, v: resultPartszeroValue, ok: resultPartszeroOk } = zero;
            if !resultPartszeroOk { return Res<List<Int>> { st: resultPartszeroState, v: [], ok: false }; };
            s = resultPartszeroState;
            eq1 = relProofOf( s, 0, resultPartsf1Value, resultPartszeroValue); Res { st: resultPartseq1State, v: resultPartseq1Value, ok: resultPartseq1Ok } = eq1;
            if !resultPartseq1Ok { return Res<List<Int>> { st: resultPartseq1State, v: [], ok: false }; };
            s = resultPartseq1State;
            v1 = validationNode( s, AstValidation::ProofAssert { p: resultPartseq1Value }); Res { st: resultPartsv1State, v: resultPartsv1Value, ok: resultPartsv1Ok } = v1;
            if !resultPartsv1Ok { return Res<List<Int>> { st: resultPartsv1State, v: [], ok: false }; };
            s = resultPartsv1State;
            b2 = copyProof( s, b); Res { st: resultPartsb2State, v: resultPartsb2Value, ok: resultPartsb2Ok } = b2;
            if !resultPartsb2Ok { return Res<List<Int>> { st: resultPartsb2State, v: [], ok: false }; };
            s = resultPartsb2State;
            capP = atermProof( s, "cap"); Res { st: resultPartscapPState, v: resultPartscapPValue, ok: resultPartscapPOk } = capP;
            if !resultPartscapPOk { return Res<List<Int>> { st: resultPartscapPState, v: [], ok: false }; };
            s = resultPartscapPState;
            f2 = fappProofRaw( s, resultPartscapPValue, push([], resultPartsb2Value)); Res { st: resultPartsf2State, v: resultPartsf2Value, ok: resultPartsf2Ok } = f2;
            if !resultPartsf2Ok { return Res<List<Int>> { st: resultPartsf2State, v: [], ok: false }; };
            s = resultPartsf2State;
            b3 = copyProof( s, b); Res { st: resultPartsb3State, v: resultPartsb3Value, ok: resultPartsb3Ok } = b3;
            if !resultPartsb3Ok { return Res<List<Int>> { st: resultPartsb3State, v: [], ok: false }; };
            s = resultPartsb3State;
            orgP = atermProof( s, "origin"); Res { st: resultPartsorgPState, v: resultPartsorgPValue, ok: resultPartsorgPOk } = orgP;
            if !resultPartsorgPOk { return Res<List<Int>> { st: resultPartsorgPState, v: [], ok: false }; };
            s = resultPartsorgPState;
            f3 = fappProofRaw( s, resultPartsorgPValue, push([], resultPartsb3Value)); Res { st: resultPartsf3State, v: resultPartsf3Value, ok: resultPartsf3Ok } = f3;
            if !resultPartsf3Ok { return Res<List<Int>> { st: resultPartsf3State, v: [], ok: false }; };
            s = resultPartsf3State;
            extP = atermProof( s, "extent"); Res { st: resultPartsextPState, v: resultPartsextPValue, ok: resultPartsextPOk } = extP;
            if !resultPartsextPOk { return Res<List<Int>> { st: resultPartsextPState, v: [], ok: false }; };
            s = resultPartsextPState;
            f4 = fappProofRaw( s, resultPartsextPValue, push([], resultPartsf3Value)); Res { st: resultPartsf4State, v: resultPartsf4Value, ok: resultPartsf4Ok } = f4;
            if !resultPartsf4Ok { return Res<List<Int>> { st: resultPartsf4State, v: [], ok: false }; };
            s = resultPartsf4State;
            eq2 = relProofOf( s, 0, resultPartsf2Value, resultPartsf4Value); Res { st: resultPartseq2State, v: resultPartseq2Value, ok: resultPartseq2Ok } = eq2;
            if !resultPartseq2Ok { return Res<List<Int>> { st: resultPartseq2State, v: [], ok: false }; };
            s = resultPartseq2State;
            v2 = validationNode( s, AstValidation::ProofAssert { p: resultPartseq2Value }); Res { st: resultPartsv2State, v: resultPartsv2Value, ok: resultPartsv2Ok } = v2;
            if !resultPartsv2Ok { return Res<List<Int>> { st: resultPartsv2State, v: [], ok: false }; };
            return ok( resultPartsv2State, push(push([], resultPartsv1Value), resultPartsv2Value));
        };
    };
    single = validationNode( st, AstValidation::ProofAssert { p: q }); Res { st: resultPartssingleState, v: resultPartssingleValue, ok: resultPartssingleOk } = single;
    if !resultPartssingleOk { return Res<List<Int>> { st: resultPartssingleState, v: [], ok: false }; };
    return ok( resultPartssingleState, push([], resultPartssingleValue));
};

fn fappProofRaw(st: St, f: Int, args: &List<Int>) -> Res<Int> ~ {
    xs = proofsList( st, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return proofNode( resultPartsxsState, AstProof::FApp { f: f, xs: resultPartsxsValue });
};

fn intValueProof(st: St, n: Int) -> Res<Int> ~ {
    nm = putName( st, String::fromInt(n)); Res { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk } = nm;
    if !resultPartsnmOk { return Res<Int> { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk }; };
    vn = emit( resultPartsnmState, AstNode::Value { value: AstValue::VInt { n: resultPartsnmValue } }); Res { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk } = vn;
    if !resultPartsvnOk { return Res<Int> { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk }; };
    return ctermProof( resultPartsvnState, resultPartsvnValue);
};

fn validationStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if keywordAt(sourceText, s, "rewrite") {
        k = eatKeyword(sourceText, s, "rewrite"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        s = skipWs(sourceText, resultPartskState);
        r = rwRule(sourceText, s); Res { st: resultPartsrState, v: resultPartsrValue, ok: resultPartsrOk } = r;
        if !resultPartsrOk { return Res<Int> { st: resultPartsrState, v: 0, ok: false }; };
        s = skipWs(sourceText, resultPartsrState);
        rn = emit( s, AstNode::Rule { value: resultPartsrValue }); Res { st: resultPartsrnState, v: resultPartsrnValue, ok: resultPartsrnOk } = rn;
        // rwRule returns a rule value wrapped: see rwRule
        return validationNode( resultPartsrnState, AstValidation::Rewrite { r: resultPartsrnValue });
    };
    if keywordAt(sourceText, s, "affirm") {
        k = eatKeyword(sourceText, s, "affirm"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        s = skipWs(sourceText, resultPartskState);
        p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if !resultPartspOk { return Res<Int> { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk }; };
        s = skipWs(sourceText, resultPartspState);
        return validationNode( s, AstValidation::ProofAssert { p: resultPartspValue });
    };
    if keywordAt(sourceText, s, "define") {
        k = eatKeyword(sourceText, s, "define"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        s = skipWs(sourceText, resultPartskState);
        v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
        s = skipWs(sourceText, resultPartsvState);
        if byteAt(sourceText, s, s.pos) != 61 { return fail( s, 0, "expected ="); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s = skipWs(sourceText, resultPartseState);
        n = putName( s, resultPartsvValue); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
        if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
        return validationNode( resultPartsnState, AstValidation::AssignProofVar { n: resultPartsnValue, e: resultPartseValue });
    };
    return fail( s, 0, "expected a validation statement");
};

fn rwRule(sourceText: &Input, st: St) -> Res<AstRule> ~ {
    v = parseVariable(sourceText, st); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<AstRule> { st: resultPartsvState, v: AstRule::EvalAll, ok: false }; };
    s = skipWs(sourceText, resultPartsvState);
    name = resultPartsvValue;
    if name = "refl" {
        p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if !resultPartspOk { return Res<AstRule> { st: resultPartspState, v: AstRule::EvalAll, ok: false }; };
        return ok( resultPartspState, AstRule::Refl { p: resultPartspValue });
    };
    if name = "eval" {
        w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
        if !resultPartswOk { return Res<AstRule> { st: resultPartswState, v: AstRule::EvalAll, ok: false }; };
        n = putName( resultPartswState, resultPartswValue); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
        if !resultPartsnOk { return Res<AstRule> { st: resultPartsnState, v: AstRule::EvalAll, ok: false }; };
        return ok( resultPartsnState, AstRule::Eval { n: resultPartsnValue });
    };
    if name = "evalAll" { return ok( s, AstRule::EvalAll); };
    if name = "checkGtZero" {
        p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if !resultPartspOk { return Res<AstRule> { st: resultPartspState, v: AstRule::EvalAll, ok: false }; };
        return ok( resultPartspState, AstRule::CheckGtZero { p: resultPartspValue });
    };
    if name = "checkRel" {
        p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if !resultPartspOk { return Res<AstRule> { st: resultPartspState, v: AstRule::EvalAll, ok: false }; };
        return ok( resultPartspState, AstRule::CheckRel { p: resultPartspValue });
    };
    args = [];
    loop = true;
    while loop ~ {
        save = checkpoint(s);
        p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
        if resultPartspOk { s = resultPartspState; args = push(args, resultPartspValue); s = skipWs(sourceText, s); } else { s = restore(resultPartspState, save); loop = false; };
    };
    n = putName( s, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<AstRule> { st: resultPartsnState, v: AstRule::EvalAll, ok: false }; };
    xs = proofsList( resultPartsnState, args); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<AstRule> { st: resultPartsxsState, v: AstRule::EvalAll, ok: false }; };
    return ok( resultPartsxsState, AstRule::UserRewrite { n: resultPartsnValue, xs: resultPartsxsValue });
};

fn validationBlock(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    // [{ affirm ...; ... }] -> validations; st is at '['
    s = st;
    if byteAt(sourceText, s, s.pos) != 91 { return fail( s, [], "expected ["); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, [], "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    out = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            v = validationStatement(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
            if !resultPartsvOk { return Res<List<Int>> { st: resultPartsvState, v: [], ok: false }; };
            s = resultPartsvState;
            parts = splitAffirm( s, resultPartsvValue); Res { st: resultPartspartsState, v: resultPartspartsValue, ok: resultPartspartsOk } = parts;
            if !resultPartspartsOk { return Res<List<Int>> { st: resultPartspartsState, v: resultPartspartsValue, ok: resultPartspartsOk }; };
            s = resultPartspartsState;
            for x in resultPartspartsValue { out = push(out, x); };
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 59 {
                while byteAt(sourceText, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            };
        };
    };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 93 { return fail( s, [], "expected ]"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, out);
};

fn optContract(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) = 91 { return validationBlock(sourceText, s); };
    return ok( s, []);
};

// ---- function headers ----

fn oneParameter(sourceText: &Input, st: St) -> Res<OneParam> ~ {
    s = skipWs(sourceText, st);
    ghostly = false;
    g = eatKeyword(sourceText, s, "ghost"); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
    if resultPartsgValue { ghostly = true; s = skipWs(sourceText, resultPartsgState); } else { s = resultPartsgState; };
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<OneParam> { st: resultPartsvState, v: OneParam { name: "", ty: Type::TInt }, ok: false }; };
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 58 { return fail( s, OneParam { name: "", ty: Type::TInt }, "expected :"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    t = typeAnnotation(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
    if !resultPartstOk { return Res<OneParam> { st: resultPartstState, v: OneParam { name: "", ty: Type::TInt }, ok: false }; };
    if ghostly && !ghostTypeOf(clone(resultPartstValue)) { return fail( resultPartstState, OneParam { name: "", ty: Type::TInt }, "ghost is written before a type that is a permission, Block<T>"); };
    return ok( resultPartstState, OneParam { name: resultPartsvValue, ty: resultPartstValue });
};

fn parameters(sourceText: &Input, st: St) -> Res<ParamOut> ~ {
    // at '('
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    names = [];
    tys = [];
    if byteAt(sourceText, s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            p = oneParameter(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
            if !resultPartspOk { return Res<ParamOut> { st: resultPartspState, v: ParamOut { names: [], types: [] }, ok: false }; };
            s = resultPartspState;
            names = push(names, clone(resultPartspValue.name));
            tys = push(tys, resultPartspValue.ty);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, ParamOut { names: [], types: [] }, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, ParamOut { names: names, types: tys });
};

fn functHeader(sourceText: &Input, st: St) -> Res<HeaderOut> ~ {
    empty = HeaderOut { names: [], types: [], ret: Type::TInt, ins: [], outs: [], writes: [], froms: [] };
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) != 40 { return fail( s, empty, "expected ("); };
    ps = parameters(sourceText, s); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<HeaderOut> { st: resultPartspsState, v: empty, ok: false }; };
    s = resultPartspsState;
    if !peekIs(sourceText, s, "->") { return fail( s, empty, "expected ->"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(sourceText, s);
    rt = typeAnnotation(sourceText, s); Res { st: resultPartsrtState, v: resultPartsrtValue, ok: resultPartsrtOk } = rt;
    if !resultPartsrtOk { return Res<HeaderOut> { st: resultPartsrtState, v: empty, ok: false }; };
    s = skipWs(sourceText, resultPartsrtState);
    writes = [];
    wk = eatKeyword(sourceText, s, "writes"); Res { st: resultPartswkState, v: resultPartswkValue, ok: resultPartswkOk } = wk;
    if resultPartswkValue {
        s = skipWs(sourceText, resultPartswkState);
        if byteAt(sourceText, s, s.pos) != 40 { return fail( s, empty, "expected ("); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        loop = true;
        while loop ~ {
            place = writePlace(sourceText, s); Res { st: resultPartsplaceState, v: resultPartsplaceValue, ok: resultPartsplaceOk } = place;
            if !resultPartsplaceOk { return Res<HeaderOut> { st: resultPartsplaceState, v: empty, ok: false }; };
            s = resultPartsplaceState;
            writes = push(writes, resultPartsplaceValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
        if byteAt(sourceText, s, s.pos) != 41 { return fail( s, empty, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
    } else { s = resultPartswkState; };
    froms = [];
    fk = eatKeyword(sourceText, s, "from"); Res { st: resultPartsfkState, v: resultPartsfkValue, ok: resultPartsfkOk } = fk;
    if resultPartsfkValue {
        s = skipWs(sourceText, resultPartsfkState);
        if byteAt(sourceText, s, s.pos) = 40 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            loop = true;
            while loop ~ {
                v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<HeaderOut> { st: resultPartsvState, v: empty, ok: false }; };
                s = resultPartsvState;
                froms = push(froms, resultPartsvValue);
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
            };
            if byteAt(sourceText, s, s.pos) != 41 { return fail( s, empty, "expected )"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
        } else {
            v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
            if !resultPartsvOk { return Res<HeaderOut> { st: resultPartsvState, v: empty, ok: false }; };
            s = skipWs(sourceText, resultPartsvState);
            froms = push([], resultPartsvValue);
        };
    } else { s = resultPartsfkState; };
    ins = optContract(sourceText, s); Res { st: resultPartsinsState, v: resultPartsinsValue, ok: resultPartsinsOk } = ins;
    if !resultPartsinsOk { return Res<HeaderOut> { st: resultPartsinsState, v: empty, ok: false }; };
    s = resultPartsinsState;
    outs = optContract(sourceText, s); Res { st: resultPartsoutsState, v: resultPartsoutsValue, ok: resultPartsoutsOk } = outs;
    if !resultPartsoutsOk { return Res<HeaderOut> { st: resultPartsoutsState, v: empty, ok: false }; };
    s = resultPartsoutsState;
    return ok( s, HeaderOut { names: resultPartspsValue.names, types: resultPartspsValue.types, ret: resultPartsrtValue, ins: resultPartsinsValue, outs: resultPartsoutsValue, writes: writes, froms: froms });
};

fn writePlace(sourceText: &Input, st: St) -> Res<String> ~ {
    v = parseVariable(sourceText, st); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<String> { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk }; };
    s = resultPartsvState;
    out = resultPartsvValue;
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 46 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { return Res<String> { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk }; };
            s = resultPartswState;
            out = cat3(out, ".", resultPartswValue);
            s = skipWs(sourceText, s);
        } else { loop = false; };
    };
    return ok( s, out);
};

fn terminationClause(sourceText: &Input, st: St) -> Res<Int> ~ {
    // an OptTermination node
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) = 126 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        t = emit( s, AstNode::Termination { value: AstTermination::MayDiverge }); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
        if !resultPartstOk { return Res<Int> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk }; };
        return emit( resultPartstState, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: resultPartstValue } });
    };
    k = eatKeyword(sourceText, s, "shrinks"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if resultPartskValue {
        s = skipWs(sourceText, resultPartskState);
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s = skipWs(sourceText, resultPartseState);
        t = emit( s, AstNode::Termination { value: AstTermination::Shrinks { e: resultPartseValue } }); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
        if !resultPartstOk { return Res<Int> { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk }; };
        return emit( resultPartstState, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: resultPartstValue } });
    };
    return emit( resultPartskState, AstNode::OptTermination { value: AstOptTermination::NoTermination });
};

fn signatureNode(st: St, types: &List<Type>, ret: Type, sizes: &List<String>, tps: &List<String>, writes: &List<String>, froms: &List<String>) -> Res<Int> ~ {
    ts = putTypesNodes( st, types); Res { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk } = ts;
    if !resultPartstsOk { return Res<Int> { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk }; };
    rt = putTypeNode( resultPartstsState, ret); Res { st: resultPartsrtState, v: resultPartsrtValue, ok: resultPartsrtOk } = rt;
    if !resultPartsrtOk { return Res<Int> { st: resultPartsrtState, v: resultPartsrtValue, ok: resultPartsrtOk }; };
    ss = namesList( resultPartsrtState, sizes); Res { st: resultPartsssState, v: resultPartsssValue, ok: resultPartsssOk } = ss;
    if !resultPartsssOk { return Res<Int> { st: resultPartsssState, v: resultPartsssValue, ok: resultPartsssOk }; };
    ps = namesList( resultPartsssState, tps); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    ws = namesList( resultPartspsState, writes); Res { st: resultPartswsState, v: resultPartswsValue, ok: resultPartswsOk } = ws;
    if !resultPartswsOk { return Res<Int> { st: resultPartswsState, v: resultPartswsValue, ok: resultPartswsOk }; };
    fs = namesList( resultPartswsState, froms); Res { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk } = fs;
    if !resultPartsfsOk { return Res<Int> { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk }; };
    return emit( resultPartsfsState, AstNode::Signature { value: AstSignature { ts: resultPartstsValue, ret: resultPartsrtValue, ss: resultPartsssValue, ps: resultPartspsValue, ws: resultPartswsValue, fs: resultPartsfsValue } });
};

// ---- statement blocks ----

fn statementBlock(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    // statements separated by ';', with Marks when locating
    s = st;
    out = [];
    loop = true;
    while loop ~ {
        s = skipWs(sourceText, s);
        if atEnd(sourceText, s) || byteAt(sourceText, s, s.pos) = 125 { loop = false; }
        else {
            startPos = s.pos;
            group = statements(sourceText, s); Res { st: resultPartsgroupState, v: resultPartsgroupValue, ok: resultPartsgroupOk } = group;
            if !resultPartsgroupOk { return Res<List<Int>> { st: resultPartsgroupState, v: resultPartsgroupValue, ok: resultPartsgroupOk }; };
            s = resultPartsgroupState;
            if s.locate {
                lc = srcLineCol(sourceText, s, startPos);
                m = emit( s, AstNode::Statement { value: AstStatement::Mark { line: get(lc, 0), col: get(lc, 1) } }); Res { st: resultPartsmState, v: resultPartsmValue, ok: resultPartsmOk } = m;
                if !resultPartsmOk { return Res<List<Int>> { st: resultPartsmState, v: [], ok: false }; };
                s = resultPartsmState;
                // the Mark must precede the group in the final list, but nodes are emitted in AstData order:
                // Haskell's Mark is a statement in the list; its record has no children, so emission order is list order.
                out = push(out, resultPartsmValue);
            };
            for x in resultPartsgroupValue { out = push(out, x); };
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 59 {
                while byteAt(sourceText, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
            } else { loop = false; };
        };
    };
    return ok( s, out);
};

fn curlyBlock(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, [], "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    inner = statementBlock(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
    if !resultPartsinnerOk { return Res<List<Int>> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
    s = resultPartsinnerState;
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, [], "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, resultPartsinnerValue);
};

fn atImportKeyword(sourceText: &Input, st: &St) -> Bool ~ {
    return keywordAt(sourceText, st, "import");
};

fn statements(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = skipWs(sourceText, st);
    if atImportKeyword(sourceText, s) { return fail( s, [], "import statements must come before any declaration in a file"); };
    ma = tryMatchAssign(sourceText, s); Res { st: resultPartsmaState, v: resultPartsmaValue, ok: resultPartsmaOk } = ma;
    if resultPartsmaOk { return Res<List<Int>> { st: resultPartsmaState, v: resultPartsmaValue, ok: resultPartsmaOk }; };
    return statementsAfterMatch(sourceText, resultPartsmaState);
};

fn statementsAfterMatch(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(sourceText, s, "return") {
        mr = tryMatchReturn(sourceText, s); Res { st: resultPartsmrState, v: resultPartsmrValue, ok: resultPartsmrOk } = mr;
        if resultPartsmrOk { return Res<List<Int>> { st: resultPartsmrState, v: resultPartsmrValue, ok: resultPartsmrOk }; };
        return statementsAfterReturn(sourceText, resultPartsmrState);
    };
    return statementsAfterReturn(sourceText, s);
};

fn statementsAfterReturn(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(sourceText, s, "match") {
        return matchStatement(sourceText, s);
    };
    if keywordAt(sourceText, s, "for") {
        return forStatement(sourceText, s);
    };
    ta = tryTupleAssign(sourceText, s); Res { st: resultPartstaState, v: resultPartstaValue, ok: resultPartstaOk } = ta;
    if resultPartstaOk { return Res<List<Int>> { st: resultPartstaState, v: resultPartstaValue, ok: resultPartstaOk }; };
    return statementsAfterTuple(sourceText, resultPartstaState);
};

fn statementsAfterTuple(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    sa = tryStructAssign(sourceText, s); Res { st: resultPartssaState, v: resultPartssaValue, ok: resultPartssaOk } = sa;
    if resultPartssaOk { return Res<List<Int>> { st: resultPartssaState, v: resultPartssaValue, ok: resultPartssaOk }; };
    return statementsFinal(sourceText, resultPartssaState);
};

fn statementsFinal(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(sourceText, s, "assume") {
        return assumeStatements(sourceText, s);
    };
    if keywordAt(sourceText, s, "linear") {
        return linearStatements(sourceText, s);
    };
    if keywordAt(sourceText, s, "extern") {
        return externStatements(sourceText, s);
    };
    if keywordAt(sourceText, s, "builtin") {
        return builtinStatements(sourceText, s);
    };
    if keywordAt(sourceText, s, "affirm") {
        v = validationStatement(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<List<Int>> { st: resultPartsvState, v: [], ok: false }; };
        sp = splitAffirm( resultPartsvState, resultPartsvValue); Res { st: resultPartsspState, v: resultPartsspValue, ok: resultPartsspOk } = sp;
        if !resultPartsspOk { return Res<List<Int>> { st: resultPartsspState, v: resultPartsspValue, ok: resultPartsspOk }; };
        s = resultPartsspState;
        out = [];
        for x in resultPartsspValue {
            w = emit( s, AstNode::Statement { value: AstStatement::ValidationStatement { v: x } }); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { return Res<List<Int>> { st: resultPartswState, v: [], ok: false }; };
            s = resultPartswState;
            out = push(out, resultPartswValue);
        };
        return ok( s, out);
    };
    one = statement(sourceText, s); Res { st: resultPartsoneState, v: resultPartsoneValue, ok: resultPartsoneOk } = one;
    if !resultPartsoneOk { return Res<List<Int>> { st: resultPartsoneState, v: [], ok: false }; };
    return ok( resultPartsoneState, push([], resultPartsoneValue));
};
fn assumeStatements(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(sourceText, st, "assume"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    p = proof(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
    if !resultPartspOk { return Res<List<Int>> { st: resultPartspState, v: [], ok: false }; };
    s = skipWs(sourceText, resultPartspState);
    pa = validationNode( s, AstValidation::ProofAssert { p: resultPartspValue }); Res { st: resultPartspaState, v: resultPartspaValue, ok: resultPartspaOk } = pa;
    if !resultPartspaOk { return Res<List<Int>> { st: resultPartspaState, v: [], ok: false }; };
    sp = splitAffirm( resultPartspaState, resultPartspaValue); Res { st: resultPartsspState, v: resultPartsspValue, ok: resultPartsspOk } = sp;
    if !resultPartsspOk { return Res<List<Int>> { st: resultPartsspState, v: resultPartsspValue, ok: resultPartsspOk }; };
    s = resultPartsspState;
    out = [];
    for x in resultPartsspValue {
        // ProofAssert becomes Assume; other split results stay as they are (wholeFacts gives ProofAsserts, which become Assume too in Haskell)
        nx = nodeAt( s, x);
        vid = x;
        if nx is AstNode::Validation {
            vv = (nx as AstNode::Validation).value;
            match vv {
                AstValidation::ProofAssert { p: pp } => {
                    a = validationNode( s, AstValidation::Assume { p: pp }); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
                    if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
                    s = resultPartsaState;
                    vid = resultPartsaValue;
                },
                AstValidation::Rewrite { r: a } => { vid = x; },
                AstValidation::AssignProofVar { n: a, e: b } => { vid = x; },
                AstValidation::Assume { p: a } => { vid = x; },
            };
        };
        w = stmtNode( s, AstStatement::ValidationStatement { v: vid }); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
        if !resultPartswOk { return Res<List<Int>> { st: resultPartswState, v: [], ok: false }; };
        s = resultPartswState;
        out = push(out, resultPartswValue);
    };
    return ok( s, out);
};

fn linearStatements(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(sourceText, st, "linear"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    declared = statement(sourceText, s); Res { st: resultPartsdeclaredState, v: resultPartsdeclaredValue, ok: resultPartsdeclaredOk } = declared;
    if !resultPartsdeclaredOk { return Res<List<Int>> { st: resultPartsdeclaredState, v: [], ok: false }; };
    s = resultPartsdeclaredState;
    n = nodeAt( s, resultPartsdeclaredValue);
    name = "";
    isStruct = false;
    if n is AstNode::Statement {
        v = (n as AstNode::Statement).value;
        match v {
            AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { name = nameText( s, a); isStruct = true; },
            AstStatement::EnumDef { n: a, vs: b } => { name = nameText( s, a); isStruct = true; },
            AstStatement::Assign { n: a, e: b } => { isStruct = false; },
            AstStatement::AssignDeref { a: a, b: b } => { isStruct = false; },
            AstStatement::Let { n: a, e: b } => { isStruct = false; },
            AstStatement::Return { e: a } => { isStruct = false; },
            AstStatement::ValidationStatement { v: a } => { isStruct = false; },
            AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { isStruct = false; },
            AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { isStruct = false; },
            AstStatement::Block { xs: a } => { isStruct = false; },
            AstStatement::If { e: a, a: b, b: c } => { isStruct = false; },
            AstStatement::While { e: a, vs: b, t: c, xs: d } => { isStruct = false; },
            AstStatement::TraitDef { n: a, ps: b, fs: c } => { isStruct = false; },
            AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { isStruct = false; },
            AstStatement::BoundedDef { bs: a, s: b } => { isStruct = false; },
            AstStatement::Mark { line: a, col: b } => { isStruct = false; },
            AstStatement::CopyDef { n: a } => { isStruct = false; },
            AstStatement::LinearDef { n: a } => { isStruct = false; },
            AstStatement::ExternDef { n: a } => { isStruct = false; },
            AstStatement::DropDef { n: a } => { isStruct = false; },
            AstStatement::Dissolve { n: a } => { isStruct = false; },
        };
    };
    if !isStruct { return fail( s, [], "linear is written before a struct or an enum"); };
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<List<Int>> { st: resultPartsnnState, v: [], ok: false }; };
    ld = stmtNode( resultPartsnnState, AstStatement::LinearDef { n: resultPartsnnValue }); Res { st: resultPartsldState, v: resultPartsldValue, ok: resultPartsldOk } = ld;
    if !resultPartsldOk { return Res<List<Int>> { st: resultPartsldState, v: [], ok: false }; };
    return ok( resultPartsldState, push(push([], resultPartsdeclaredValue), resultPartsldValue));
};

fn cWordType(t: Type) -> Bool ~ {
    out = false;
    match t {
        Type::TInt => { out = true; },
        Type::TByte => { out = true; },
        Type::TBool => { out = true; },
        Type::TAddr { inner: e } => { out = true; },
        Type::TBlock { inner: e } => { out = true; },
        Type::TRef { inner: e } => { out = matchRefBlock(Box::unbox(e)); },
        Type::TList { elem: e } => { out = false; },
        Type::TArray { elem: e, size: s } => { out = false; },
        Type::TBox { inner: e } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn matchRefBlock(inner: Type) -> Bool ~ {
    out = false;
    match inner {
        Type::TBlock { inner: x } => { out = true; },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TList { elem: x } => { out = false; },
        Type::TArray { elem: x, size: s } => { out = false; },
        Type::TBox { inner: x } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: x } => { out = false; },
        Type::TMutRef { inner: x } => { out = false; },
        Type::TAddr { inner: x } => { out = false; },
        Type::TUninit { inner: x } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn externStatements(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(sourceText, st, "extern"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    k2 = eatKeyword(sourceText, s, "fn"); Res { st: resultPartsk2State, v: resultPartsk2Value, ok: resultPartsk2Ok } = k2;
    if !resultPartsk2Value { return fail( resultPartsk2State, [], "expected fn"); };
    s = skipWs(sourceText, resultPartsk2State);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<List<Int>> { st: resultPartsvState, v: [], ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    h = functHeader(sourceText, s); Res { st: resultPartshState, v: resultPartshValue, ok: resultPartshOk } = h;
    if !resultPartshOk { return Res<List<Int>> { st: resultPartshState, v: [], ok: false }; };
    s = resultPartshState;
    term = terminationClause(sourceText, s); Res { st: resultPartstermState, v: resultPartstermValue, ok: resultPartstermOk } = term;
    if !resultPartstermOk { return Res<List<Int>> { st: resultPartstermState, v: [], ok: false }; };
    s = resultPartstermState;
    i = 0;
    for t in resultPartshValue.types {
        if !cWordType(clone(t)) { return fail( s, [], cat3(cat3("the parameter ", nameAtOr(&resultPartshValue.names, i, ""), " of extern fn "), cat3(name, " is not an Int, a Byte, a Bool, an address or a permission", ""), "")); };
        i = i + 1;
    };
    if !cWordType(clone(resultPartshValue.ret)) { return fail( s, [], cat3("extern fn ", name, " gives a value that is not an Int, a Byte, a Bool, an address or a permission")); };
    ed = stmtNameNode( s, 2, name); Res { st: resultPartsedState, v: resultPartsedValue, ok: resultPartsedOk } = ed;
    if !resultPartsedOk { return Res<List<Int>> { st: resultPartsedState, v: [], ok: false }; };
    s = resultPartsedState;
    fnAssign = functAssign( s, name, resultPartshValue, resultPartstermValue, []); Res { st: resultPartsfnAssignState, v: resultPartsfnAssignValue, ok: resultPartsfnAssignOk } = fnAssign;
    if !resultPartsfnAssignOk { return Res<List<Int>> { st: resultPartsfnAssignState, v: [], ok: false }; };
    return ok( resultPartsfnAssignState, push(push([], resultPartsedValue), resultPartsfnAssignValue));
};

fn stmtNameNode(st: St, kind: Int, name: &String) -> Res<Int> ~ {
    // kind: 0 CopyDef, 1 LinearDef, 2 ExternDef, 3 DropDef (LinearDef built elsewhere)
    n = putName( st, name); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    if kind = 0 { return stmtNode( resultPartsnState, AstStatement::CopyDef { n: resultPartsnValue }); };
    if kind = 2 { return stmtNode( resultPartsnState, AstStatement::ExternDef { n: resultPartsnValue }); };
    if kind = 3 { return stmtNode( resultPartsnState, AstStatement::DropDef { n: resultPartsnValue }); };
    return stmtNode( resultPartsnState, AstStatement::LinearDef { n: resultPartsnValue });
};

fn functAssign(st: St, name: &String, h: HeaderOut, termNode: Int, body: &List<Int>) -> Res<Int> ~ {
    // Assign name (Val (VFunct names ins outs (NativeFunct sig term body) []))
    sig = signatureNode( st, &h.types, h.ret, [], [], &h.writes, &h.froms); Res { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk } = sig;
    if !resultPartssigOk { return Res<Int> { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk }; };
    s = resultPartssigState;
    stmts = statementsList( s, body); Res { st: resultPartsstmtsState, v: resultPartsstmtsValue, ok: resultPartsstmtsOk } = stmts;
    if !resultPartsstmtsOk { return Res<Int> { st: resultPartsstmtsState, v: resultPartsstmtsValue, ok: resultPartsstmtsOk }; };
    s = resultPartsstmtsState;
    bodyNode = emit( s, AstNode::Body { value: AstBody::NativeFunct { sig: resultPartssigValue, term: termNode, stmts: resultPartsstmtsValue } }); Res { st: resultPartsbodyNodeState, v: resultPartsbodyNodeValue, ok: resultPartsbodyNodeOk } = bodyNode;
    if !resultPartsbodyNodeOk { return Res<Int> { st: resultPartsbodyNodeState, v: resultPartsbodyNodeValue, ok: resultPartsbodyNodeOk }; };
    s = resultPartsbodyNodeState;
    ps = namesList( s, &h.names); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    s = resultPartspsState;
    insL = validationsList( s, &h.ins); Res { st: resultPartsinsLState, v: resultPartsinsLValue, ok: resultPartsinsLOk } = insL;
    if !resultPartsinsLOk { return Res<Int> { st: resultPartsinsLState, v: resultPartsinsLValue, ok: resultPartsinsLOk }; };
    s = resultPartsinsLState;
    outsL = validationsList( s, &h.outs); Res { st: resultPartsoutsLState, v: resultPartsoutsLValue, ok: resultPartsoutsLOk } = outsL;
    if !resultPartsoutsLOk { return Res<Int> { st: resultPartsoutsLState, v: resultPartsoutsLValue, ok: resultPartsoutsLOk }; };
    s = resultPartsoutsLState;
    ex = emptyProofs( s); Res { st: resultPartsexState, v: resultPartsexValue, ok: resultPartsexOk } = ex;
    if !resultPartsexOk { return Res<Int> { st: resultPartsexState, v: resultPartsexValue, ok: resultPartsexOk }; };
    s = resultPartsexState;
    vf = emit( s, AstNode::Value { value: AstValue::VFunct { ps: resultPartspsValue, ins: resultPartsinsLValue, outs: resultPartsoutsLValue, body: resultPartsbodyNodeValue, exports: resultPartsexValue } }); Res { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk } = vf;
    if !resultPartsvfOk { return Res<Int> { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk }; };
    s = resultPartsvfState;
    ve = valExpr( s, resultPartsvfValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
    s = resultPartsveState;
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: resultPartsveValue });
};

fn builtinStatements(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(sourceText, st, "builtin"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    k2 = eatKeyword(sourceText, s, "fn"); Res { st: resultPartsk2State, v: resultPartsk2Value, ok: resultPartsk2Ok } = k2;
    if !resultPartsk2Value { return fail( resultPartsk2State, [], "expected fn"); };
    s = skipWs(sourceText, resultPartsk2State);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<List<Int>> { st: resultPartsvState, v: [], ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    h = functHeader(sourceText, s); Res { st: resultPartshState, v: resultPartshValue, ok: resultPartshOk } = h;
    if !resultPartshOk { return Res<List<Int>> { st: resultPartshState, v: [], ok: false }; };
    s = resultPartshState;
    prim = declPrimName(name);
    if size(prim.bytes) = 0 { return fail( s, [], cat3("builtin fn ", name, " is not a builtin of the standard library (BuiltinRegistry.builtinDecls)")); };
    exported = [];
    for o in resultPartshValue.outs {
        on = nodeAt( s, o);
        isA = false;
        pid = 0;
        if on is AstNode::Validation {
            ov = (on as AstNode::Validation).value;
            match ov {
                AstValidation::ProofAssert { p: pp } => { isA = true; pid = pp; },
                AstValidation::Rewrite { r: a } => { isA = false; },
                AstValidation::AssignProofVar { n: a, e: b } => { isA = false; },
                AstValidation::Assume { p: a } => { isA = false; },
            };
        };
        if !isA { return fail( s, [], cat3("builtin fn ", name, " promises only affirmations in its output contract")); };
        exported = push(exported, pid);
    };
    // Assign name (Val (VFunct params ins [] (BuiltinFunct b) exported))
    ps = namesList( s, &resultPartshValue.names); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<List<Int>> { st: resultPartspsState, v: [], ok: false }; };
    s = resultPartspsState;
    insL = validationsList( s, &resultPartshValue.ins); Res { st: resultPartsinsLState, v: resultPartsinsLValue, ok: resultPartsinsLOk } = insL;
    if !resultPartsinsLOk { return Res<List<Int>> { st: resultPartsinsLState, v: [], ok: false }; };
    s = resultPartsinsLState;
    outsL = emptyValidations( s); Res { st: resultPartsoutsLState, v: resultPartsoutsLValue, ok: resultPartsoutsLOk } = outsL;
    if !resultPartsoutsLOk { return Res<List<Int>> { st: resultPartsoutsLState, v: [], ok: false }; };
    s = resultPartsoutsLState;
    bn = primBuiltinNode( s, prim); Res { st: resultPartsbnState, v: resultPartsbnValue, ok: resultPartsbnOk } = bn;
    if !resultPartsbnOk { return Res<List<Int>> { st: resultPartsbnState, v: [], ok: false }; };
    s = resultPartsbnState;
    bodyNode = emit( s, AstNode::Body { value: AstBody::BuiltinFunct { b: resultPartsbnValue } }); Res { st: resultPartsbodyNodeState, v: resultPartsbodyNodeValue, ok: resultPartsbodyNodeOk } = bodyNode;
    if !resultPartsbodyNodeOk { return Res<List<Int>> { st: resultPartsbodyNodeState, v: [], ok: false }; };
    s = resultPartsbodyNodeState;
    exL = proofsList( s, exported); Res { st: resultPartsexLState, v: resultPartsexLValue, ok: resultPartsexLOk } = exL;
    if !resultPartsexLOk { return Res<List<Int>> { st: resultPartsexLState, v: [], ok: false }; };
    s = resultPartsexLState;
    vf = emit( s, AstNode::Value { value: AstValue::VFunct { ps: resultPartspsValue, ins: resultPartsinsLValue, outs: resultPartsoutsLValue, body: resultPartsbodyNodeValue, exports: resultPartsexLValue } }); Res { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk } = vf;
    if !resultPartsvfOk { return Res<List<Int>> { st: resultPartsvfState, v: [], ok: false }; };
    s = resultPartsvfState;
    ve = valExpr( s, resultPartsvfValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<List<Int>> { st: resultPartsveState, v: [], ok: false }; };
    s = resultPartsveState;
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<List<Int>> { st: resultPartsnnState, v: [], ok: false }; };
    a = stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: resultPartsveValue }); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
    if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
    return ok( resultPartsaState, push([], resultPartsaValue));
};

fn primBuiltinNode(st: St, prim: &String) -> Res<Int> ~ {
    return emit( st, AstNode::Builtin { value: AstBuiltin::Primitive { name: clone(prim) } });
};

fn statement(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if keywordAt(sourceText, s, "return") {
        k = eatKeyword(sourceText, s, "return"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        s2 = skipWs(sourceText, resultPartskState);
        e = expression(sourceText, s2); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s = skipWs(sourceText, resultPartseState);
        return stmtNode( s, AstStatement::Return { e: resultPartseValue });
    };
    if keywordAt(sourceText, s, "if") { return ifStatement(sourceText, s); };
    if keywordAt(sourceText, s, "while") { return whileStatement(sourceText, s); };
    if keywordAt(sourceText, s, "axiom") { return axiomStatement(sourceText, s); };
    if keywordAt(sourceText, s, "proof") { return proofDefStatement(sourceText, s); };
    if keywordAt(sourceText, s, "rewrite") || keywordAt(sourceText, s, "affirm") || keywordAt(sourceText, s, "define") {
        v = validationStatement(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
        return stmtNode( resultPartsvState, AstStatement::ValidationStatement { v: resultPartsvValue });
    };
    if keywordAt(sourceText, s, "struct") { return structStatement(sourceText, s); };
    if keywordAt(sourceText, s, "enum") { return enumStatement(sourceText, s); };
    if keywordAt(sourceText, s, "trait") { return traitStatement(sourceText, s); };
    if keywordAt(sourceText, s, "impl") { return implStatement(sourceText, s); };
    if keywordAt(sourceText, s, "fn") { return functStatement(sourceText, s); };
    if byteAt(sourceText, s, s.pos) = 123 {
        inner = curlyBlock(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: 0, ok: false }; };
        lst = statementsList( resultPartsinnerState, resultPartsinnerValue); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
        if !resultPartslstOk { return Res<Int> { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk }; };
        return stmtNode( resultPartslstState, AstStatement::Block { xs: resultPartslstValue });
    };
    // deref assignment, then call/assign
    da = tryDerefAssign(sourceText, s); Res { st: resultPartsdaState, v: resultPartsdaValue, ok: resultPartsdaOk } = da;
    if resultPartsdaOk { return Res<Int> { st: resultPartsdaState, v: resultPartsdaValue, ok: resultPartsdaOk }; };
    s = resultPartsdaState;
    // assign: variable = (not ==)
    save = checkpoint(s);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if resultPartsvOk {
        s2 = skipWs(sourceText, resultPartsvState);
        if byteAt(sourceText, s2, s2.pos) = 61 && byteAt(sourceText, s2, s2.pos + 1) != 61 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(sourceText, s2);
            e = expression(sourceText, s2); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
            if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
            s = skipWs(sourceText, resultPartseState);
            nn = putName( s, resultPartsvValue); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
            if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
            return stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: resultPartseValue });
        };
        s = s2;
    } else { s = resultPartsvState; };
    s = restore(s, save);
    // call statement
    startPos = s.pos;
    e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
    if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
    s = skipWs(sourceText, resultPartseState);
    parts = exprParts( s, resultPartseValue);
    if size(parts) = 2 {
        fname = exprVarName( s, get(parts, 0));
        if size(fname.bytes) > 0 || nodeIsVar( s, get(parts, 0)) {
            lc = srcLineCol(sourceText, s, startPos);
            held = cat3("$call ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
            nn = putName( s, held); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
            if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
            return stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: resultPartseValue });
        };
    };
    return fail( s, 0, "a statement that is a call, or an assignment");
};

fn nodeIsVar(st: &St, id: Int) -> Bool ~ {
    n = nodeAt( st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        out = false;
        match v {
            AstExpression::Var { n: a } => { out = true; },
            AstExpression::Val { v: a } => { out = false; },
            AstExpression::F { f: a, xs: b } => { out = false; },
        };
        return out;
    };
    return false;
};

fn ifStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "if"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    cond = expression(sourceText, s); Res { st: resultPartscondState, v: resultPartscondValue, ok: resultPartscondOk } = cond;
    if !resultPartscondOk { return Res<Int> { st: resultPartscondState, v: resultPartscondValue, ok: resultPartscondOk }; };
    s = skipWs(sourceText, resultPartscondState);
    thenB = curlyBlock(sourceText, s); Res { st: resultPartsthenBState, v: resultPartsthenBValue, ok: resultPartsthenBOk } = thenB;
    if !resultPartsthenBOk { return Res<Int> { st: resultPartsthenBState, v: 0, ok: false }; };
    s = resultPartsthenBState;
    elseStmts = [];
    ek = eatKeyword(sourceText, s, "else"); Res { st: resultPartsekState, v: resultPartsekValue, ok: resultPartsekOk } = ek;
    ekSt = resultPartsekState;
    if resultPartsekValue {
        s = skipWs(sourceText, ekSt);
        if keywordAt(sourceText, s, "if") {
            nested = ifStatement(sourceText, s); Res { st: resultPartsnestedState, v: resultPartsnestedValue, ok: resultPartsnestedOk } = nested;
            if !resultPartsnestedOk { return Res<Int> { st: resultPartsnestedState, v: resultPartsnestedValue, ok: resultPartsnestedOk }; };
            s = resultPartsnestedState;
            elseStmts = push([], resultPartsnestedValue);
        } else {
            eb = curlyBlock(sourceText, s); Res { st: resultPartsebState, v: resultPartsebValue, ok: resultPartsebOk } = eb;
            if !resultPartsebOk { return Res<Int> { st: resultPartsebState, v: 0, ok: false }; };
            s = resultPartsebState;
            elseStmts = resultPartsebValue;
        };
    } else { s = ekSt; };
    a = statementsList( s, resultPartsthenBValue); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
    if !resultPartsaOk { return Res<Int> { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk }; };
    b = statementsList( resultPartsaState, elseStmts); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
    if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
    return stmtNode( resultPartsbState, AstStatement::If { e: resultPartscondValue, a: resultPartsaValue, b: resultPartsbValue });
};

fn whileStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "while"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    cond = expression(sourceText, s); Res { st: resultPartscondState, v: resultPartscondValue, ok: resultPartscondOk } = cond;
    if !resultPartscondOk { return Res<Int> { st: resultPartscondState, v: resultPartscondValue, ok: resultPartscondOk }; };
    s = skipWs(sourceText, resultPartscondState);
    inv = optContract(sourceText, s); Res { st: resultPartsinvState, v: resultPartsinvValue, ok: resultPartsinvOk } = inv;
    if !resultPartsinvOk { return Res<Int> { st: resultPartsinvState, v: 0, ok: false }; };
    s = skipWs(sourceText, resultPartsinvState);
    term = terminationClause(sourceText, s); Res { st: resultPartstermState, v: resultPartstermValue, ok: resultPartstermOk } = term;
    if !resultPartstermOk { return Res<Int> { st: resultPartstermState, v: resultPartstermValue, ok: resultPartstermOk }; };
    s = resultPartstermState;
    body = curlyBlock(sourceText, s); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<Int> { st: resultPartsbodyState, v: 0, ok: false }; };
    s = resultPartsbodyState;
    vs = validationsList( s, resultPartsinvValue); Res { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk } = vs;
    if !resultPartsvsOk { return Res<Int> { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk }; };
    xs = statementsList( resultPartsvsState, resultPartsbodyValue); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return stmtNode( resultPartsxsState, AstStatement::While { e: resultPartscondValue, vs: resultPartsvsValue, t: resultPartstermValue, xs: resultPartsxsValue });
};

fn axiomStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "axiom"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 40 { return fail( s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    args = [];
    if byteAt(sourceText, s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { return Res<Int> { st: resultPartswState, v: 0, ok: false }; };
            s = resultPartswState;
            args = push(args, resultPartswValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    ins = validationBlock(sourceText, s); Res { st: resultPartsinsState, v: resultPartsinsValue, ok: resultPartsinsOk } = ins;
    if !resultPartsinsOk { return Res<Int> { st: resultPartsinsState, v: 0, ok: false }; };
    s = resultPartsinsState;
    outs = validationBlock(sourceText, s); Res { st: resultPartsoutsState, v: resultPartsoutsValue, ok: resultPartsoutsOk } = outs;
    if !resultPartsoutsOk { return Res<Int> { st: resultPartsoutsState, v: 0, ok: false }; };
    s = resultPartsoutsState;
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    ps = namesList( resultPartsnnState, args); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    il = validationsList( resultPartspsState, resultPartsinsValue); Res { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk } = il;
    if !resultPartsilOk { return Res<Int> { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk }; };
    ol = validationsList( resultPartsilState, resultPartsoutsValue); Res { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk } = ol;
    if !resultPartsolOk { return Res<Int> { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk }; };
    return stmtNode( resultPartsolState, AstStatement::AxiomDef { n: resultPartsnnValue, ps: resultPartspsValue, ins: resultPartsilValue, outs: resultPartsolValue });
};

fn proofDefStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "proof"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 40 { return fail( s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    args = [];
    if byteAt(sourceText, s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { return Res<Int> { st: resultPartswState, v: 0, ok: false }; };
            s = resultPartswState;
            args = push(args, resultPartswValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    ins = validationBlock(sourceText, s); Res { st: resultPartsinsState, v: resultPartsinsValue, ok: resultPartsinsOk } = ins;
    if !resultPartsinsOk { return Res<Int> { st: resultPartsinsState, v: 0, ok: false }; };
    s = resultPartsinsState;
    outs = validationBlock(sourceText, s); Res { st: resultPartsoutsState, v: resultPartsoutsValue, ok: resultPartsoutsOk } = outs;
    if !resultPartsoutsOk { return Res<Int> { st: resultPartsoutsState, v: 0, ok: false }; };
    s = resultPartsoutsState;
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    bodyVals = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            vv = validationStatement(sourceText, s); Res { st: resultPartsvvState, v: resultPartsvvValue, ok: resultPartsvvOk } = vv;
            if !resultPartsvvOk { return Res<Int> { st: resultPartsvvState, v: 0, ok: false }; };
            s = resultPartsvvState;
            sp = splitAffirm( s, resultPartsvvValue); Res { st: resultPartsspState, v: resultPartsspValue, ok: resultPartsspOk } = sp;
            if !resultPartsspOk { return Res<Int> { st: resultPartsspState, v: 0, ok: false }; };
            s = resultPartsspState;
            for x in resultPartsspValue { bodyVals = push(bodyVals, x); };
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 59 { while byteAt(sourceText, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); }; };
        };
    };
    s = skipWs(sourceText, s);
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    ps = namesList( resultPartsnnState, args); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    il = validationsList( resultPartspsState, resultPartsinsValue); Res { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk } = il;
    if !resultPartsilOk { return Res<Int> { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk }; };
    ol = validationsList( resultPartsilState, resultPartsoutsValue); Res { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk } = ol;
    if !resultPartsolOk { return Res<Int> { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk }; };
    bl = validationsList( resultPartsolState, bodyVals); Res { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk } = bl;
    if !resultPartsblOk { return Res<Int> { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk }; };
    return stmtNode( resultPartsblState, AstStatement::ProofDef { n: resultPartsnnValue, ps: resultPartspsValue, ins: resultPartsilValue, outs: resultPartsolValue, body: resultPartsblValue });
};

fn tryDerefAssign(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    save = checkpoint(s);
    lhs = derefPlace(sourceText, s); Res { st: resultPartslhsState, v: resultPartslhsValue, ok: resultPartslhsOk } = lhs;
    if !resultPartslhsOk { return Res<Int> { st: restore(resultPartslhsState, save), v: 0, ok: false }; };
    s = skipWs(sourceText, resultPartslhsState);
    if byteAt(sourceText, s, s.pos) = 61 && byteAt(sourceText, s, s.pos + 1) != 61 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<Int> { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk }; };
        s = skipWs(sourceText, resultPartseState);
        return stmtNode( s, AstStatement::AssignDeref { a: resultPartslhsValue, b: resultPartseValue });
    };
    return Res<Int> { st: restore(s, save), v: 0, ok: false };
};

fn derefPlace(sourceText: &Input, st: St) -> Res<Int> ~ {
    // withFields over (derefExpression | parens derefExpression), no method calls
    s = st;
    base = derefBase(sourceText, s); Res { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk } = base;
    if !resultPartsbaseOk { return Res<Int> { st: resultPartsbaseState, v: resultPartsbaseValue, ok: resultPartsbaseOk }; };
    acc = resultPartsbaseValue;
    s = resultPartsbaseState;
    loop = true;
    while loop ~ {
        s = skipWs(sourceText, s);
        k = eatKeyword(sourceText, s, "as"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
        if resultPartskValue {
            s2 = skipWs(sourceText, resultPartskState);
            dc = declaredCtorNode(sourceText, s2); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
            if !resultPartsdcOk { return Res<Int> { st: resultPartsdcState, v: 0, ok: false }; };
            s = resultPartsdcState;
            cast = castExprOf( s, resultPartsdcValue, acc); Res { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk } = cast;
            if !resultPartscastOk { return Res<Int> { st: resultPartscastState, v: resultPartscastValue, ok: resultPartscastOk }; };
            s = resultPartscastState;
            acc = resultPartscastValue;
            s = skipWs(sourceText, s);
        } else {
            s = resultPartskState;
            if byteAt(sourceText, s, s.pos) = 46 && byteAt(sourceText, s, s.pos + 1) != 46 {
                s = St { pos: s.pos + 1, ..s };
                fname = "";
                if byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 {
                    start = s.pos;
                    while byteAt(sourceText, s, s.pos) >= 48 && byteAt(sourceText, s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
                    fname = srcSlice(sourceText, s, start, s.pos);
                } else {
                    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
                    fname = resultPartsvValue;
                    s = resultPartsvState;
                };
                fe = fieldExprOf( s, fname, acc); Res { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk } = fe;
                if !resultPartsfeOk { return Res<Int> { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk }; };
                s = resultPartsfeState;
                acc = resultPartsfeValue;
                s = skipWs(sourceText, s);
            } else { loop = false; };
        };
    };
    return ok( s, acc);
};

fn derefBase(sourceText: &Input, st: St) -> Res<Int> ~ {
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = nonInfixExpr(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        return primExpr( resultPartsinnerState, "DerefOf", push([], resultPartsinnerValue));
    };
    if byteAt(sourceText, s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        inner = derefBase(sourceText, s); Res { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk } = inner;
        if !resultPartsinnerOk { return Res<Int> { st: resultPartsinnerState, v: resultPartsinnerValue, ok: resultPartsinnerOk }; };
        s = skipWs(sourceText, resultPartsinnerState);
        if byteAt(sourceText, s, s.pos) != 41 { return fail( s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        return ok( s, resultPartsinnerValue);
    };
    return fail( s, 0, "expected a dereference");
};

// ---- match ----


fn matchArmsHead(st: St) -> Res<Int> ~ {
    // consumes `match scrutinee {`; returns the scrutinee expression node; arms parsed by matchArmsRest
    return ok( st, 0);
};


fn matchHead(sourceText: &Input, st: St) -> Res<MatchHead> ~ {
    k = eatKeyword(sourceText, st, "match"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if !resultPartskValue { return fail( resultPartskState, MatchHead { scrutinee: 0 }, "expected match"); };
    s = skipWs(sourceText, resultPartskState);
    sc = expression(sourceText, s); Res { st: resultPartsscState, v: resultPartsscValue, ok: resultPartsscOk } = sc;
    if !resultPartsscOk { return Res<MatchHead> { st: resultPartsscState, v: MatchHead { scrutinee: 0 }, ok: false }; };
    s = skipWs(sourceText, resultPartsscState);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, MatchHead { scrutinee: 0 }, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, MatchHead { scrutinee: resultPartsscValue });
};

fn matchArmBlock(sourceText: &Input, st: St) -> Res<Arm> ~ {
    // Variant { field: var, ... } => { statements }
    dc = declaredCtorNode(sourceText, st); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
    if !resultPartsdcOk { return Res<Arm> { st: resultPartsdcState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(sourceText, resultPartsdcState);
    fields = [];
    vars = [];
    if byteAt(sourceText, s, s.pos) = 123 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) != 125 {
            loop = true;
            while loop ~ {
                f = parseVariable(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
                if !resultPartsfOk { return Res<Arm> { st: resultPartsfState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(sourceText, resultPartsfState);
                if byteAt(sourceText, s, s.pos) != 58 { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<Arm> { st: resultPartsvState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(sourceText, resultPartsvState);
                fields = push(fields, resultPartsfValue);
                vars = push(vars, resultPartsvValue);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop = false; }; } else { loop = false; };
            };
        };
        if byteAt(sourceText, s, s.pos) != 125 { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected }"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
    };
    declared = findCtorPath( s, resultPartsdcValue);
    for f in fields { if !containsName(declared, f) { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, cat3(cat3("Variant ", resultPartsdcValue, " has no field "), f, "")); }; };
    if hasDupStrings(fields) { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, cat3("Pattern ", resultPartsdcValue, " repeats a field")); };
    if !peekIs(sourceText, s, "=>") { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected =>"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(sourceText, s);
    body = curlyBlock(sourceText, s); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<Arm> { st: resultPartsbodyState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = resultPartsbodyState;
    if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
    return ok( s, Arm { name: resultPartsdcValue, fields: fields, vars: vars, body: resultPartsbodyValue });
};

fn matchStatement(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    head = matchHead(sourceText, st); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<List<Int>> { st: resultPartsheadState, v: [], ok: false }; };
    s = resultPartsheadState;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); loop = false; }
        else {
            a = matchArmBlock(sourceText, s); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
            if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
            s = resultPartsaState;
            arms = push(arms, resultPartsaValue);
        };
    };
    return desugarMatch( s, resultPartsheadValue.scrutinee, arms);
};

fn variantIdentity(st: &St, name: &String) -> String ~ {
    matched = matchedCtorName(st, name);
    if size(matched.bytes) = 0 { return ""; };
    if hasTypeNamed(st, baseNameOf(matched)) {
        variants = typeVariantsOf(st, baseNameOf(matched));
        if size(variants) = 1 {
            identity = clone(get(variants, 0));
            if matched != name && containsText(identity, "$") { return ""; };
            return identity;
        };
    };
    parts = splitPath(matched);
    if size(parts) < 2 { return ""; };
    ownerParts = [];
    for i in 0..(size(parts) - 1) { ownerParts = push(ownerParts, clone(get(parts, i))); };
    owner = joinFrom(ownerParts, 0);
    variant = clone(get(parts, size(parts) - 1));
    for identity in typeVariantsOf(st, owner) {
        identityParts = splitPath(identity);
        if size(identityParts) > 0 && get(identityParts, size(identityParts) - 1) = variant {
            if matched != name && containsText(identity, "$" ) { return ""; };
            return clone(identity);
        };
    };
    return "";
};

fn desugarMatch(st: St, scrutinee: Int, arms: &List<Arm>) -> Res<List<Int>> ~ {
    if size(arms) = 0 { return fail( st, [], "A match needs at least one arm"); };
    first = clone(get(arms, 0).name);
    identities = [];
    for a in arms { identities = push(identities, variantIdentity(st, a.name)); };
    firstIdentity = clone(get(identities, 0));
    typeName = "";
    variants = [];
    for c in currentTypes(st) {
        for v in c.variants {
            if firstIdentity = v { typeName = clone(c.name); variants = clone(c.variants); };
        };
    };
    if size(typeName.bytes) = 0 { return fail(st, [], cat3("Unknown variant ", first, "")); };
    for identity in identities {
        if !containsName(variants, identity) { return fail(st, [], cat3("A match over ", typeName, " has an arm of another type")); };
    };
    if hasDupStrings(identities) { return fail(st, [], cat3("A match over ", typeName, " repeats a variant")); };
    missing = [];
    for v in variants { if !containsName(identities, v) { missing = push(missing, clone(v)); }; };
    if size(missing) > 0 {
        joined = "";
        j = 0;
        for m in missing { if j > 0 { joined = catStrings(joined, " "); }; joined = catStrings(joined, m); j = j + 1; };
        return fail(st, [], cat3(cat3("A match over ", typeName, " does not cover "), joined, ""));
    };
    s = st;
    if size(arms) = 1 {
        a = clone(get(arms, 0));
        return desugarSingle( s, scrutinee, a);
    };
    hidden = putName( s, "$match"); Res { st: resultPartshiddenState, v: resultPartshiddenValue, ok: resultPartshiddenOk } = hidden;
    if !resultPartshiddenOk { return Res<List<Int>> { st: resultPartshiddenState, v: [], ok: false }; };
    s = resultPartshiddenState;
    chain = matchChainRest( s, arms, 0); Res { st: resultPartschainState, v: resultPartschainValue, ok: resultPartschainOk } = chain;
    if !resultPartschainOk { return Res<List<Int>> { st: resultPartschainState, v: resultPartschainValue, ok: resultPartschainOk }; };
    s = resultPartschainState;
    // the chain was built against a subject variable node built inside matchChain; rebuild the Let now
    letNode = stmtNode( s, AstStatement::Let { n: resultPartshiddenValue, e: scrutinee }); Res { st: resultPartsletNodeState, v: resultPartsletNodeValue, ok: resultPartsletNodeOk } = letNode;
    if !resultPartsletNodeOk { return Res<List<Int>> { st: resultPartsletNodeState, v: [], ok: false }; };
    s = resultPartsletNodeState;
    out = push([], resultPartsletNodeValue);
    for x in resultPartschainValue { out = push(out, x); };
    return ok( s, out);
};

fn desugarSingle(st: St, scrutinee: Int, a: Arm) -> Res<List<Int>> ~ {
    s = st;
    binds = matchBindings( s, clone(a)); Res { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk } = binds;
    if !resultPartsbindsOk { return Res<List<Int>> { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk }; };
    s = resultPartsbindsState;
    inner = clone(resultPartsbindsValue);
    for x in a.body { inner = push(inner, x); };
    // Block(Let $match scrutinee : bindings ++ body); the Let name node
    hidden = putName( s, "$match"); Res { st: resultPartshiddenState, v: resultPartshiddenValue, ok: resultPartshiddenOk } = hidden;
    if !resultPartshiddenOk { return Res<List<Int>> { st: resultPartshiddenState, v: [], ok: false }; };
    s = resultPartshiddenState;
    letNode = stmtNode( s, AstStatement::Let { n: resultPartshiddenValue, e: scrutinee }); Res { st: resultPartsletNodeState, v: resultPartsletNodeValue, ok: resultPartsletNodeOk } = letNode;
    if !resultPartsletNodeOk { return Res<List<Int>> { st: resultPartsletNodeState, v: [], ok: false }; };
    s = resultPartsletNodeState;
    all = push([], resultPartsletNodeValue);
    for x in inner { all = push(all, x); };
    lst = statementsList( s, all); Res { st: resultPartslstState, v: resultPartslstValue, ok: resultPartslstOk } = lst;
    if !resultPartslstOk { return Res<List<Int>> { st: resultPartslstState, v: [], ok: false }; };
    blk = stmtNode( resultPartslstState, AstStatement::Block { xs: resultPartslstValue }); Res { st: resultPartsblkState, v: resultPartsblkValue, ok: resultPartsblkOk } = blk;
    if !resultPartsblkOk { return Res<List<Int>> { st: resultPartsblkState, v: [], ok: false }; };
    return ok( resultPartsblkState, push([], resultPartsblkValue));
};

fn matchBindings(st: St, a: Arm) -> Res<List<Int>> ~ {
    s = st;
    out = [];
    i = 0;
    for field in a.fields {
        var = nameAtOr(&a.vars, i, "");
        subj = varExprNode( s, "$match"); Res { st: resultPartssubjState, v: resultPartssubjValue, ok: resultPartssubjOk } = subj;
        if !resultPartssubjOk { return Res<List<Int>> { st: resultPartssubjState, v: [], ok: false }; };
        s = resultPartssubjState;
        proj = projectExprOf( s, &a.name, field, resultPartssubjValue); Res { st: resultPartsprojState, v: resultPartsprojValue, ok: resultPartsprojOk } = proj;
        if !resultPartsprojOk { return Res<List<Int>> { st: resultPartsprojState, v: [], ok: false }; };
        s = resultPartsprojState;
        nn = putName( s, var); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
        if !resultPartsnnOk { return Res<List<Int>> { st: resultPartsnnState, v: [], ok: false }; };
        s = resultPartsnnState;
        letNode = stmtNode( s, AstStatement::Let { n: resultPartsnnValue, e: resultPartsprojValue }); Res { st: resultPartsletNodeState, v: resultPartsletNodeValue, ok: resultPartsletNodeOk } = letNode;
        if !resultPartsletNodeOk { return Res<List<Int>> { st: resultPartsletNodeState, v: [], ok: false }; };
        s = resultPartsletNodeState;
        out = push(out, resultPartsletNodeValue);
        i = i + 1;
    };
    return ok( s, out);
};

fn matchChain(st: St, arms: &List<Arm>, index: Int) -> Res<List<Int>> ~ {
    a = armAt(arms, index);
    if index = size(arms) - 1 {
        return matchBindings( st, a);
        // plus body appended by caller? Haskell chain last = bindings ++ body
    };
    return matchChainRest( st, arms, index);
};

fn matchChainRest(st: St, arms: &List<Arm>, index: Int) -> Res<List<Int>> ~ {
    a = armAt(arms, index);
    s = st;
    if index = size(arms) - 1 {
        binds = matchBindings( s, clone(a)); Res { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk } = binds;
        if !resultPartsbindsOk { return Res<List<Int>> { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk }; };
        s = resultPartsbindsState;
        out = clone(resultPartsbindsValue);
        for x in a.body { out = push(out, x); };
        return ok( s, out);
    };
    binds = matchBindings( s, clone(a)); Res { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk } = binds;
    if !resultPartsbindsOk { return Res<List<Int>> { st: resultPartsbindsState, v: resultPartsbindsValue, ok: resultPartsbindsOk }; };
    s = resultPartsbindsState;
    thenStmts = clone(resultPartsbindsValue);
    for x in a.body { thenStmts = push(thenStmts, x); };
    rest = matchChainRest( s, arms, index + 1); Res { st: resultPartsrestState, v: resultPartsrestValue, ok: resultPartsrestOk } = rest;
    if !resultPartsrestOk { return Res<List<Int>> { st: resultPartsrestState, v: resultPartsrestValue, ok: resultPartsrestOk }; };
    s = resultPartsrestState;
    subj = varExprNode( s, "$match"); Res { st: resultPartssubjState, v: resultPartssubjValue, ok: resultPartssubjOk } = subj;
    if !resultPartssubjOk { return Res<List<Int>> { st: resultPartssubjState, v: [], ok: false }; };
    s = resultPartssubjState;
    isN = isExprOf( s, &a.name, resultPartssubjValue); Res { st: resultPartsisNState, v: resultPartsisNValue, ok: resultPartsisNOk } = isN;
    if !resultPartsisNOk { return Res<List<Int>> { st: resultPartsisNState, v: [], ok: false }; };
    s = resultPartsisNState;
    aL = statementsList( s, thenStmts); Res { st: resultPartsaLState, v: resultPartsaLValue, ok: resultPartsaLOk } = aL;
    if !resultPartsaLOk { return Res<List<Int>> { st: resultPartsaLState, v: [], ok: false }; };
    s = resultPartsaLState;
    bL = statementsList( s, resultPartsrestValue); Res { st: resultPartsbLState, v: resultPartsbLValue, ok: resultPartsbLOk } = bL;
    if !resultPartsbLOk { return Res<List<Int>> { st: resultPartsbLState, v: [], ok: false }; };
    s = resultPartsbLState;
    ifNode = stmtNode( s, AstStatement::If { e: resultPartsisNValue, a: resultPartsaLValue, b: resultPartsbLValue }); Res { st: resultPartsifNodeState, v: resultPartsifNodeValue, ok: resultPartsifNodeOk } = ifNode;
    if !resultPartsifNodeOk { return Res<List<Int>> { st: resultPartsifNodeState, v: [], ok: false }; };
    return ok( resultPartsifNodeState, push([], resultPartsifNodeValue));
};

fn tryMatchAssign(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    save = checkpoint(st);
    v = parseVariable(sourceText, st); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<List<Int>> { st: restore(resultPartsvState, save), v: [], ok: false }; };
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 61 || byteAt(sourceText, s, s.pos + 1) = 61 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if !keywordAt(sourceText, s, "match") { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    head = matchHead(sourceText, s); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<List<Int>> { st: resultPartsheadState, v: [], ok: false }; };
    s = resultPartsheadState;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); loop = false; }
        else {
            a = matchArmExpr(sourceText, s); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
            if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
            s = resultPartsaState;
            // body becomes [Assign var body]
            bodyExpr = intAtOr(&resultPartsaValue.body, 0, 0);
            an = putName( s, resultPartsvValue); Res { st: resultPartsanState, v: resultPartsanValue, ok: resultPartsanOk } = an;
            if !resultPartsanOk { return Res<List<Int>> { st: resultPartsanState, v: [], ok: false }; };
            s = resultPartsanState;
            assign = stmtNode( s, AstStatement::Assign { n: resultPartsanValue, e: bodyExpr }); Res { st: resultPartsassignState, v: resultPartsassignValue, ok: resultPartsassignOk } = assign;
            if !resultPartsassignOk { return Res<List<Int>> { st: resultPartsassignState, v: [], ok: false }; };
            s = resultPartsassignState;
            arms = push(arms, Arm { name: resultPartsaValue.name, fields: resultPartsaValue.fields, vars: resultPartsaValue.vars, body: push([], resultPartsassignValue) });
        };
    };
    return desugarMatch( s, resultPartsheadValue.scrutinee, arms);
};

fn matchArmExpr(sourceText: &Input, st: St) -> Res<Arm> ~ {
    dc = declaredCtorNode(sourceText, st); Res { st: resultPartsdcState, v: resultPartsdcValue, ok: resultPartsdcOk } = dc;
    if !resultPartsdcOk { return Res<Arm> { st: resultPartsdcState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(sourceText, resultPartsdcState);
    fields = [];
    vars = [];
    if byteAt(sourceText, s, s.pos) = 123 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) != 125 {
            loop = true;
            while loop ~ {
                f = parseVariable(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
                if !resultPartsfOk { return Res<Arm> { st: resultPartsfState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(sourceText, resultPartsfState);
                if byteAt(sourceText, s, s.pos) != 58 { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { return Res<Arm> { st: resultPartsvState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(sourceText, resultPartsvState);
                fields = push(fields, resultPartsfValue);
                vars = push(vars, resultPartsvValue);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop = false; }; } else { loop = false; };
            };
        };
        if byteAt(sourceText, s, s.pos) != 125 { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected }"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
    };
    declared = findCtorPath( s, resultPartsdcValue);
    for f in fields { if !containsName(declared, f) { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, cat3(cat3("Variant ", resultPartsdcValue, " has no field "), f, "")); }; };
    if hasDupStrings(fields) { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, cat3("Pattern ", resultPartsdcValue, " repeats a field")); };
    if !peekIs(sourceText, s, "=>") { return fail( s, Arm { name: "", fields: [], vars: [], body: [] }, "expected =>"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(sourceText, s);
    body = expression(sourceText, s); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<Arm> { st: resultPartsbodyState, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(sourceText, resultPartsbodyState);
    if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); };
    return ok( s, Arm { name: resultPartsdcValue, fields: fields, vars: vars, body: push([], resultPartsbodyValue) });
};

fn tryMatchReturn(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    save = checkpoint(st);
    k = eatKeyword(sourceText, st, "return"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if !resultPartskValue { return Res<List<Int>> { st: restore(resultPartskState, save), v: [], ok: false }; };
    s = skipWs(sourceText, resultPartskState);
    if !keywordAt(sourceText, s, "match") { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    head = matchHead(sourceText, s); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<List<Int>> { st: resultPartsheadState, v: [], ok: false }; };
    s = resultPartsheadState;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); loop = false; }
        else {
            a = matchArmExpr(sourceText, s); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
            if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
            s = resultPartsaState;
            bodyExpr = intAtOr(&resultPartsaValue.body, 0, 0);
            rn = stmtNode( s, AstStatement::Return { e: bodyExpr }); Res { st: resultPartsrnState, v: resultPartsrnValue, ok: resultPartsrnOk } = rn;
            if !resultPartsrnOk { return Res<List<Int>> { st: resultPartsrnState, v: [], ok: false }; };
            s = resultPartsrnState;
            arms = push(arms, Arm { name: resultPartsaValue.name, fields: resultPartsaValue.fields, vars: resultPartsaValue.vars, body: push([], resultPartsrnValue) });
        };
    };
    return desugarMatch( s, resultPartsheadValue.scrutinee, arms);
};

// ---- for loops ----

fn assignsVar(st: &St, var: &String, stmts: &List<Int>) -> Bool ~ {
    for id in &stmts {
        n = nodeAt( st, id);
        if n is AstNode::Statement {
            v = (n as AstNode::Statement).value;
            found = false;
            match v {
                AstStatement::Assign { n: a, e: b } => { found = nameText( st, a) = var; },
                AstStatement::Block { xs: xs } => { found = assignsVar( st, var, statementsListIds( st, xs)); },
                AstStatement::If { e: a, a: b, b: c } => { found = assignsVar( st, var, statementsListIds( st, b)) || assignsVar( st, var, statementsListIds( st, c)); },
                AstStatement::While { e: a, vs: b, t: c, xs: xs } => { found = assignsVar( st, var, statementsListIds( st, xs)); },
                AstStatement::AssignDeref { a: a, b: b } => { found = false; },
                AstStatement::Let { n: a, e: b } => { found = false; },
                AstStatement::Return { e: a } => { found = false; },
                AstStatement::ValidationStatement { v: a } => { found = false; },
                AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { found = false; },
                AstStatement::EnumDef { n: a, vs: b } => { found = false; },
                AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { found = false; },
                AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { found = false; },
                AstStatement::TraitDef { n: a, ps: b, fs: c } => { found = false; },
                AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { found = false; },
                AstStatement::BoundedDef { bs: a, s: b } => { found = false; },
                AstStatement::Mark { line: a, col: b } => { found = false; },
                AstStatement::CopyDef { n: a } => { found = false; },
                AstStatement::LinearDef { n: a } => { found = false; },
                AstStatement::ExternDef { n: a } => { found = false; },
                AstStatement::DropDef { n: a } => { found = false; },
                AstStatement::Dissolve { n: a } => { found = false; },
            };
            if found { return true; };
        };
    };
    return false;
};

fn statementsListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt( st, cur);
        if n is AstNode::Statements {
            v = (n as AstNode::Statements).value;
            match v {
                AstStatements::End => { loop = false; },
                AstStatements::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn forStatement(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    startPos = st.pos;
    k = eatKeyword(sourceText, st, "for"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    first = parseVariable(sourceText, s); Res { st: resultPartsfirstState, v: resultPartsfirstValue, ok: resultPartsfirstOk } = first;
    if !resultPartsfirstOk { return Res<List<Int>> { st: resultPartsfirstState, v: [], ok: false }; };
    s = skipWs(sourceText, resultPartsfirstState);
    second = "";
    hasSecond = false;
    if byteAt(sourceText, s, s.pos) = 44 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
        if !resultPartswOk { return Res<List<Int>> { st: resultPartswState, v: [], ok: false }; };
        second = resultPartswValue;
        hasSecond = true;
        s = skipWs(sourceText, resultPartswState);
    };
    ik = eatKeyword(sourceText, s, "in"); Res { st: resultPartsikState, v: resultPartsikValue, ok: resultPartsikOk } = ik;
    if !resultPartsikValue { return fail( resultPartsikState, [], "expected in"); };
    s = skipWs(sourceText, resultPartsikState);
    start = expression(sourceText, s); Res { st: resultPartsstartState, v: resultPartsstartValue, ok: resultPartsstartOk } = start;
    if !resultPartsstartOk { return Res<List<Int>> { st: resultPartsstartState, v: [], ok: false }; };
    s = skipWs(sourceText, resultPartsstartState);
    hasEnd = false;
    endExpr = 0;
    if peekIs(sourceText, s, "..") {
        s = St { pos: s.pos + 2, ..s };
        s = skipWs(sourceText, s);
        e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
        if !resultPartseOk { return Res<List<Int>> { st: resultPartseState, v: [], ok: false }; };
        endExpr = resultPartseValue;
        hasEnd = true;
        s = skipWs(sourceText, resultPartseState);
    };
    inv = optContract(sourceText, s); Res { st: resultPartsinvState, v: resultPartsinvValue, ok: resultPartsinvOk } = inv;
    if !resultPartsinvOk { return Res<List<Int>> { st: resultPartsinvState, v: [], ok: false }; };
    s = resultPartsinvState;
    body = curlyBlock(sourceText, s); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<List<Int>> { st: resultPartsbodyState, v: [], ok: false }; };
    s = resultPartsbodyState;
    lc = srcLineCol(sourceText, s, startPos);
    place = catStrings(String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    if hasSecond && hasEnd { return fail( s, [], "A for loop over a range has one variable, as in for i in 0..n"); };
    if hasEnd {
        return countingLoop( s, resultPartsfirstValue, resultPartsstartValue, endExpr, resultPartsinvValue, resultPartsbodyValue);
    };
    if hasSecond {
        indexName = resultPartsfirstValue;
        element = second;
        listName = catStrings("$list ", place);
        an = putName( s, listName); Res { st: resultPartsanState, v: resultPartsanValue, ok: resultPartsanOk } = an;
        if !resultPartsanOk { return Res<List<Int>> { st: resultPartsanState, v: [], ok: false }; };
        s = resultPartsanState;
        assignList = stmtNode( s, AstStatement::Assign { n: resultPartsanValue, e: resultPartsstartValue }); Res { st: resultPartsassignListState, v: resultPartsassignListValue, ok: resultPartsassignListOk } = assignList;
        if !resultPartsassignListOk { return Res<List<Int>> { st: resultPartsassignListState, v: [], ok: false }; };
        s = resultPartsassignListState;
        loopStmts = elementLoopBody( s, place, indexName, element, listName, resultPartsinvValue, resultPartsbodyValue); Res { st: resultPartsloopStmtsState, v: resultPartsloopStmtsValue, ok: resultPartsloopStmtsOk } = loopStmts;
        if !resultPartsloopStmtsOk { return Res<List<Int>> { st: resultPartsloopStmtsState, v: resultPartsloopStmtsValue, ok: resultPartsloopStmtsOk }; };
        s = resultPartsloopStmtsState;
        out = push([], resultPartsassignListValue);
        for x in resultPartsloopStmtsValue { out = push(out, x); };
        return ok( s, out);
    };
    indexName = catStrings("$index ", place);
    element = resultPartsfirstValue;
    listName = catStrings("$list ", place);
    an = putName( s, listName); Res { st: resultPartsanState, v: resultPartsanValue, ok: resultPartsanOk } = an;
    if !resultPartsanOk { return Res<List<Int>> { st: resultPartsanState, v: [], ok: false }; };
    s = resultPartsanState;
    assignList = stmtNode( s, AstStatement::Assign { n: resultPartsanValue, e: resultPartsstartValue }); Res { st: resultPartsassignListState, v: resultPartsassignListValue, ok: resultPartsassignListOk } = assignList;
    if !resultPartsassignListOk { return Res<List<Int>> { st: resultPartsassignListState, v: [], ok: false }; };
    s = resultPartsassignListState;
    loopStmts = elementLoopBody( s, place, indexName, element, listName, resultPartsinvValue, resultPartsbodyValue); Res { st: resultPartsloopStmtsState, v: resultPartsloopStmtsValue, ok: resultPartsloopStmtsOk } = loopStmts;
    if !resultPartsloopStmtsOk { return Res<List<Int>> { st: resultPartsloopStmtsState, v: resultPartsloopStmtsValue, ok: resultPartsloopStmtsOk }; };
    s = resultPartsloopStmtsState;
    out = push([], resultPartsassignListValue);
    for x in resultPartsloopStmtsValue { out = push(out, x); };
    return ok( s, out);
};

fn elementLoopBody(st: St, place: &String, indexName: &String, element: &String, listName: &String, inv: &List<Int>, body: &List<Int>) -> Res<List<Int>> ~ {
    s = st;
    listVar = varExprNode( s, listName); Res { st: resultPartslistVarState, v: resultPartslistVarValue, ok: resultPartslistVarOk } = listVar;
    if !resultPartslistVarOk { return Res<List<Int>> { st: resultPartslistVarState, v: [], ok: false }; };
    s = resultPartslistVarState;
    sizeE = primExpr( s, "Size", push([], resultPartslistVarValue)); Res { st: resultPartssizeEState, v: resultPartssizeEValue, ok: resultPartssizeEOk } = sizeE;
    if !resultPartssizeEOk { return Res<List<Int>> { st: resultPartssizeEState, v: [], ok: false }; };
    s = resultPartssizeEState;
    listVar2 = varExprNode( s, listName); Res { st: resultPartslistVar2State, v: resultPartslistVar2Value, ok: resultPartslistVar2Ok } = listVar2;
    if !resultPartslistVar2Ok { return Res<List<Int>> { st: resultPartslistVar2State, v: [], ok: false }; };
    s = resultPartslistVar2State;
    idxVar = varExprNode( s, indexName); Res { st: resultPartsidxVarState, v: resultPartsidxVarValue, ok: resultPartsidxVarOk } = idxVar;
    if !resultPartsidxVarOk { return Res<List<Int>> { st: resultPartsidxVarState, v: [], ok: false }; };
    s = resultPartsidxVarState;
    getE = primExpr( s, "Get", push(push([], resultPartslistVar2Value), resultPartsidxVarValue)); Res { st: resultPartsgetEState, v: resultPartsgetEValue, ok: resultPartsgetEOk } = getE;
    if !resultPartsgetEOk { return Res<List<Int>> { st: resultPartsgetEState, v: [], ok: false }; };
    s = resultPartsgetEState;
    en = putName( s, element); Res { st: resultPartsenState, v: resultPartsenValue, ok: resultPartsenOk } = en;
    if !resultPartsenOk { return Res<List<Int>> { st: resultPartsenState, v: [], ok: false }; };
    s = resultPartsenState;
    letNode = stmtNode( s, AstStatement::Let { n: resultPartsenValue, e: resultPartsgetEValue }); Res { st: resultPartsletNodeState, v: resultPartsletNodeValue, ok: resultPartsletNodeOk } = letNode;
    if !resultPartsletNodeOk { return Res<List<Int>> { st: resultPartsletNodeState, v: [], ok: false }; };
    s = resultPartsletNodeState;
    innerBody = push([], resultPartsletNodeValue);
    for x in &body { innerBody = push(innerBody, x); };
    zero = intExpr( s, 0); Res { st: resultPartszeroState, v: resultPartszeroValue, ok: resultPartszeroOk } = zero;
    if !resultPartszeroOk { return Res<List<Int>> { st: resultPartszeroState, v: [], ok: false }; };
    s = resultPartszeroState;
    return countingLoop( s, indexName, resultPartszeroValue, resultPartssizeEValue, inv, innerBody);
};

fn intExpr(st: St, n: Int) -> Res<Int> ~ {
    nm = putName( st, String::fromInt(n)); Res { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk } = nm;
    if !resultPartsnmOk { return Res<Int> { st: resultPartsnmState, v: resultPartsnmValue, ok: resultPartsnmOk }; };
    vn = emit( resultPartsnmState, AstNode::Value { value: AstValue::VInt { n: resultPartsnmValue } }); Res { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk } = vn;
    if !resultPartsvnOk { return Res<Int> { st: resultPartsvnState, v: resultPartsvnValue, ok: resultPartsvnOk }; };
    return valExpr( resultPartsvnState, resultPartsvnValue);
};

fn countingLoop(st: St, var: &String, lo: Int, hi: Int, inv: &List<Int>, body: &List<Int>) -> Res<List<Int>> ~ {
    if assignsVar( st, var, body) { return fail( st, [], cat3("The body of a for loop cannot assign its loop variable ", var, "")); };
    s = st;
    loName = catStrings("$lo ", var);
    hiName = catStrings("$hi ", var);
    an1 = putName( s, loName); Res { st: resultPartsan1State, v: resultPartsan1Value, ok: resultPartsan1Ok } = an1;
    if !resultPartsan1Ok { return Res<List<Int>> { st: resultPartsan1State, v: [], ok: false }; };
    s = resultPartsan1State;
    a1 = stmtNode( s, AstStatement::Assign { n: resultPartsan1Value, e: lo }); Res { st: resultPartsa1State, v: resultPartsa1Value, ok: resultPartsa1Ok } = a1;
    if !resultPartsa1Ok { return Res<List<Int>> { st: resultPartsa1State, v: [], ok: false }; };
    s = resultPartsa1State;
    an2 = putName( s, hiName); Res { st: resultPartsan2State, v: resultPartsan2Value, ok: resultPartsan2Ok } = an2;
    if !resultPartsan2Ok { return Res<List<Int>> { st: resultPartsan2State, v: [], ok: false }; };
    s = resultPartsan2State;
    a2 = stmtNode( s, AstStatement::Assign { n: resultPartsan2Value, e: hi }); Res { st: resultPartsa2State, v: resultPartsa2Value, ok: resultPartsa2Ok } = a2;
    if !resultPartsa2Ok { return Res<List<Int>> { st: resultPartsa2State, v: [], ok: false }; };
    s = resultPartsa2State;
    an3 = putName( s, var); Res { st: resultPartsan3State, v: resultPartsan3Value, ok: resultPartsan3Ok } = an3;
    if !resultPartsan3Ok { return Res<List<Int>> { st: resultPartsan3State, v: [], ok: false }; };
    s = resultPartsan3State;
    loVar = varExprNode( s, loName); Res { st: resultPartsloVarState, v: resultPartsloVarValue, ok: resultPartsloVarOk } = loVar;
    if !resultPartsloVarOk { return Res<List<Int>> { st: resultPartsloVarState, v: [], ok: false }; };
    s = resultPartsloVarState;
    a3 = stmtNode( s, AstStatement::Assign { n: resultPartsan3Value, e: resultPartsloVarValue }); Res { st: resultPartsa3State, v: resultPartsa3Value, ok: resultPartsa3Ok } = a3;
    if !resultPartsa3Ok { return Res<List<Int>> { st: resultPartsa3State, v: [], ok: false }; };
    s = resultPartsa3State;
    // invariant facts
    v1 = varProofAtom( s, var); Res { st: resultPartsv1State, v: resultPartsv1Value, ok: resultPartsv1Ok } = v1;
    if !resultPartsv1Ok { return Res<List<Int>> { st: resultPartsv1State, v: [], ok: false }; };
    s = resultPartsv1State;
    n1 = atermProof( s, loName); Res { st: resultPartsn1State, v: resultPartsn1Value, ok: resultPartsn1Ok } = n1;
    if !resultPartsn1Ok { return Res<List<Int>> { st: resultPartsn1State, v: [], ok: false }; };
    s = resultPartsn1State;
    ge = relProofOf( s, 5, resultPartsv1Value, resultPartsn1Value); Res { st: resultPartsgeState, v: resultPartsgeValue, ok: resultPartsgeOk } = ge;
    if !resultPartsgeOk { return Res<List<Int>> { st: resultPartsgeState, v: [], ok: false }; };
    s = resultPartsgeState;
    geV = validationNode( s, AstValidation::ProofAssert { p: resultPartsgeValue }); Res { st: resultPartsgeVState, v: resultPartsgeVValue, ok: resultPartsgeVOk } = geV;
    if !resultPartsgeVOk { return Res<List<Int>> { st: resultPartsgeVState, v: [], ok: false }; };
    s = resultPartsgeVState;
    v2 = varProofAtom( s, var); Res { st: resultPartsv2State, v: resultPartsv2Value, ok: resultPartsv2Ok } = v2;
    if !resultPartsv2Ok { return Res<List<Int>> { st: resultPartsv2State, v: [], ok: false }; };
    s = resultPartsv2State;
    n2 = atermProof( s, hiName); Res { st: resultPartsn2State, v: resultPartsn2Value, ok: resultPartsn2Ok } = n2;
    if !resultPartsn2Ok { return Res<List<Int>> { st: resultPartsn2State, v: [], ok: false }; };
    s = resultPartsn2State;
    le = relProofOf( s, 4, resultPartsv2Value, resultPartsn2Value); Res { st: resultPartsleState, v: resultPartsleValue, ok: resultPartsleOk } = le;
    // Haskell uses GtEq for lo and LtEq for hi; rel indices: Eq0 NotEq1 Lt2 Gt3 LtEq4 GtEq5
    if !resultPartsleOk { return Res<List<Int>> { st: resultPartsleState, v: [], ok: false }; };
    s = resultPartsleState;
    leV = validationNode( s, AstValidation::ProofAssert { p: resultPartsleValue }); Res { st: resultPartsleVState, v: resultPartsleVValue, ok: resultPartsleVOk } = leV;
    if !resultPartsleVOk { return Res<List<Int>> { st: resultPartsleVState, v: [], ok: false }; };
    s = resultPartsleVState;
    allInv = push(push([], resultPartsgeVValue), resultPartsleVValue);
    for x in &inv { allInv = push(allInv, x); };
    // condition var < hi
    c1 = varExprNode( s, var); Res { st: resultPartsc1State, v: resultPartsc1Value, ok: resultPartsc1Ok } = c1;
    if !resultPartsc1Ok { return Res<List<Int>> { st: resultPartsc1State, v: [], ok: false }; };
    s = resultPartsc1State;
    c2 = varExprNode( s, hiName); Res { st: resultPartsc2State, v: resultPartsc2Value, ok: resultPartsc2Ok } = c2;
    if !resultPartsc2Ok { return Res<List<Int>> { st: resultPartsc2State, v: [], ok: false }; };
    s = resultPartsc2State;
    cond = relExprOf( s, "<", resultPartsc1Value, resultPartsc2Value); Res { st: resultPartscondState, v: resultPartscondValue, ok: resultPartscondOk } = cond;
    if !resultPartscondOk { return Res<List<Int>> { st: resultPartscondState, v: [], ok: false }; };
    s = resultPartscondState;
    // shrinks hi - var
    t1 = varExprNode( s, hiName); Res { st: resultPartst1State, v: resultPartst1Value, ok: resultPartst1Ok } = t1;
    if !resultPartst1Ok { return Res<List<Int>> { st: resultPartst1State, v: [], ok: false }; };
    s = resultPartst1State;
    t2 = varExprNode( s, var); Res { st: resultPartst2State, v: resultPartst2Value, ok: resultPartst2Ok } = t2;
    if !resultPartst2Ok { return Res<List<Int>> { st: resultPartst2State, v: [], ok: false }; };
    s = resultPartst2State;
    rem = primExpr( s, "Minus", push(push([], resultPartst1Value), resultPartst2Value)); Res { st: resultPartsremState, v: resultPartsremValue, ok: resultPartsremOk } = rem;
    if !resultPartsremOk { return Res<List<Int>> { st: resultPartsremState, v: [], ok: false }; };
    s = resultPartsremState;
    termNode = emit( s, AstNode::Termination { value: AstTermination::Shrinks { e: resultPartsremValue } }); Res { st: resultPartstermNodeState, v: resultPartstermNodeValue, ok: resultPartstermNodeOk } = termNode;
    if !resultPartstermNodeOk { return Res<List<Int>> { st: resultPartstermNodeState, v: [], ok: false }; };
    s = resultPartstermNodeState;
    optTerm = emit( s, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: resultPartstermNodeValue } }); Res { st: resultPartsoptTermState, v: resultPartsoptTermValue, ok: resultPartsoptTermOk } = optTerm;
    if !resultPartsoptTermOk { return Res<List<Int>> { st: resultPartsoptTermState, v: [], ok: false }; };
    s = resultPartsoptTermState;
    // step var = var + 1
    sv = varExprNode( s, var); Res { st: resultPartssvState, v: resultPartssvValue, ok: resultPartssvOk } = sv;
    if !resultPartssvOk { return Res<List<Int>> { st: resultPartssvState, v: [], ok: false }; };
    s = resultPartssvState;
    one = intExpr( s, 1); Res { st: resultPartsoneState, v: resultPartsoneValue, ok: resultPartsoneOk } = one;
    if !resultPartsoneOk { return Res<List<Int>> { st: resultPartsoneState, v: [], ok: false }; };
    s = resultPartsoneState;
    plus = primExpr( s, "Plus", push(push([], resultPartssvValue), resultPartsoneValue)); Res { st: resultPartsplusState, v: resultPartsplusValue, ok: resultPartsplusOk } = plus;
    if !resultPartsplusOk { return Res<List<Int>> { st: resultPartsplusState, v: [], ok: false }; };
    s = resultPartsplusState;
    an4 = putName( s, var); Res { st: resultPartsan4State, v: resultPartsan4Value, ok: resultPartsan4Ok } = an4;
    if !resultPartsan4Ok { return Res<List<Int>> { st: resultPartsan4State, v: [], ok: false }; };
    s = resultPartsan4State;
    step = stmtNode( s, AstStatement::Assign { n: resultPartsan4Value, e: resultPartsplusValue }); Res { st: resultPartsstepState, v: resultPartsstepValue, ok: resultPartsstepOk } = step;
    if !resultPartsstepOk { return Res<List<Int>> { st: resultPartsstepState, v: [], ok: false }; };
    s = resultPartsstepState;
    loopBody = clone(body);
    loopBody = push(loopBody, resultPartsstepValue);
    vs = validationsList( s, allInv); Res { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk } = vs;
    if !resultPartsvsOk { return Res<List<Int>> { st: resultPartsvsState, v: [], ok: false }; };
    s = resultPartsvsState;
    xs = statementsList( s, loopBody); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<List<Int>> { st: resultPartsxsState, v: [], ok: false }; };
    s = resultPartsxsState;
    w = stmtNode( s, AstStatement::While { e: resultPartscondValue, vs: resultPartsvsValue, t: resultPartsoptTermValue, xs: resultPartsxsValue }); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
    if !resultPartswOk { return Res<List<Int>> { st: resultPartswState, v: [], ok: false }; };
    return ok( resultPartswState, push(push(push(push([], resultPartsa1Value), resultPartsa2Value), resultPartsa3Value), resultPartswValue));
};

fn varProofAtom(st: St, name: &String) -> Res<Int> ~ { return atermProof( st, name); };

fn tryTupleAssign(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    save = checkpoint(st);
    startPos = st.pos;
    s = skipWs(sourceText, st);
    if byteAt(sourceText, s, s.pos) != 40 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    names = [];
    loop = true;
    while loop ~ {
        v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
        if !resultPartsvOk { return Res<List<Int>> { st: restore(resultPartsvState, save), v: [], ok: false }; };
        s = resultPartsvState;
        names = push(names, resultPartsvValue);
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
    };
    if byteAt(sourceText, s, s.pos) != 41 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 61 || byteAt(sourceText, s, s.pos + 1) = 61 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if size(names) < 2 { return fail( s, [], "a tuple is taken apart into two names or more"); };
    if hasDupStrings(names) { return fail( s, [], "a tuple is taken apart into a name twice"); };
    e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
    if !resultPartseOk { return Res<List<Int>> { st: resultPartseState, v: [], ok: false }; };
    s = skipWs(sourceText, resultPartseState);
    lc = srcLineCol(sourceText, s, startPos);
    held = cat3("$tuple ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    hn = putName( s, held); Res { st: resultPartshnState, v: resultPartshnValue, ok: resultPartshnOk } = hn;
    if !resultPartshnOk { return Res<List<Int>> { st: resultPartshnState, v: [], ok: false }; };
    s = resultPartshnState;
    first = stmtNode( s, AstStatement::Assign { n: resultPartshnValue, e: resultPartseValue }); Res { st: resultPartsfirstState, v: resultPartsfirstValue, ok: resultPartsfirstOk } = first;
    if !resultPartsfirstOk { return Res<List<Int>> { st: resultPartsfirstState, v: [], ok: false }; };
    s = resultPartsfirstState;
    out = push([], resultPartsfirstValue);
    i = 0;
    for name in names {
        hv = varExprNode( s, held); Res { st: resultPartshvState, v: resultPartshvValue, ok: resultPartshvOk } = hv;
        if !resultPartshvOk { return Res<List<Int>> { st: resultPartshvState, v: [], ok: false }; };
        s = resultPartshvState;
        fe = tupleFieldExpr( s, i, resultPartshvValue); Res { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk } = fe;
        if !resultPartsfeOk { return Res<List<Int>> { st: resultPartsfeState, v: [], ok: false }; };
        s = resultPartsfeState;
        nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
        if !resultPartsnnOk { return Res<List<Int>> { st: resultPartsnnState, v: [], ok: false }; };
        s = resultPartsnnState;
        a = stmtNode( s, AstStatement::Assign { n: resultPartsnnValue, e: resultPartsfeValue }); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
        if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
        s = resultPartsaState;
        out = push(out, resultPartsaValue);
        i = i + 1;
    };
    return ok( s, out);
};

fn tupleFieldExpr(st: St, i: Int, of: Int) -> Res<Int> ~ {
    n = putName( st, String::fromInt(i)); Res { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk } = n;
    if !resultPartsnOk { return Res<Int> { st: resultPartsnState, v: resultPartsnValue, ok: resultPartsnOk }; };
    on = optNameNode( resultPartsnState, false, ""); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
    if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
    return builtinExpr( resultPartsonState, AstBuiltin::FieldBuiltin { owner: resultPartsonValue, n: resultPartsnValue }, push([], "struct"), push([], of));
};

fn tryStructAssign(sourceText: &Input, st: St) -> Res<List<Int>> ~ {
    save = checkpoint(st);
    startPos = st.pos;
    s = skipWs(sourceText, st);
    q = qualifiedName(sourceText, s); Res { st: resultPartsqState, v: resultPartsqValue, ok: resultPartsqOk } = q;
    if !resultPartsqOk { return Res<List<Int>> { st: restore(resultPartsqState, save), v: [], ok: false }; };
    if !hasCtor( resultPartsqState, resultPartsqValue) { return Res<List<Int>> { st: restore(resultPartsqState, save), v: [], ok: false }; };
    declared = findCtorPath( resultPartsqState, resultPartsqValue);
    name = resultPartsqValue;
    s = skipWs(sourceText, resultPartsqState);
    if byteAt(sourceText, s, s.pos) != 123 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    fields = [];
    vars = [];
    if byteAt(sourceText, s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            f = parseVariable(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
            if !resultPartsfOk { return Res<List<Int>> { st: restore(resultPartsfState, save), v: [], ok: false }; };
            s = skipWs(sourceText, resultPartsfState);
            if byteAt(sourceText, s, s.pos) != 58 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
            if !resultPartsvOk { return Res<List<Int>> { st: restore(resultPartsvState, save), v: [], ok: false }; };
            s = skipWs(sourceText, resultPartsvState);
            fields = push(fields, resultPartsfValue);
            vars = push(vars, resultPartsvValue);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 61 || byteAt(sourceText, s, s.pos + 1) = 61 { return Res<List<Int>> { st: restore(s, save), v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if containsText(name, "::") { return fail( s, [], "a variant is taken apart with match, which says what to do with the other variants"); };
    same = size(fields) = size(declared);
    if same {
        i = 0;
        for f in fields { if f != get(declared, i) { same = false; }; i = i + 1; };
    };
    if !same {
        joined = "";
        j = 0;
        for d in declared { if j > 0 { joined = catStrings(joined, ", "); }; joined = catStrings(joined, d); j = j + 1; };
        return fail( s, [], cat3(cat3(cat3("Struct ", name, " is taken apart into every one of its fields, in the order it declares them ("), joined, ")"), "", ""));
    };
    if hasDupStrings(vars) { return fail( s, [], "a struct is taken apart into a name twice"); };
    e = expression(sourceText, s); Res { st: resultPartseState, v: resultPartseValue, ok: resultPartseOk } = e;
    if !resultPartseOk { return Res<List<Int>> { st: resultPartseState, v: [], ok: false }; };
    s = skipWs(sourceText, resultPartseState);
    lc = srcLineCol(sourceText, s, startPos);
    held = cat3("$struct ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    hn = putName( s, held); Res { st: resultPartshnState, v: resultPartshnValue, ok: resultPartshnOk } = hn;
    if !resultPartshnOk { return Res<List<Int>> { st: resultPartshnState, v: [], ok: false }; };
    s = resultPartshnState;
    first = stmtNode( s, AstStatement::Assign { n: resultPartshnValue, e: resultPartseValue }); Res { st: resultPartsfirstState, v: resultPartsfirstValue, ok: resultPartsfirstOk } = first;
    if !resultPartsfirstOk { return Res<List<Int>> { st: resultPartsfirstState, v: [], ok: false }; };
    s = resultPartsfirstState;
    out = push([], resultPartsfirstValue);
    i = 0;
    for field in fields {
        var = get(vars, i);
        hv = varExprNode( s, held); Res { st: resultPartshvState, v: resultPartshvValue, ok: resultPartshvOk } = hv;
        if !resultPartshvOk { return Res<List<Int>> { st: resultPartshvState, v: [], ok: false }; };
        s = resultPartshvState;
        fe = fieldExprOf( s, field, resultPartshvValue); Res { st: resultPartsfeState, v: resultPartsfeValue, ok: resultPartsfeOk } = fe;
        if !resultPartsfeOk { return Res<List<Int>> { st: resultPartsfeState, v: [], ok: false }; };
        s = resultPartsfeState;
        nn = putName( s, var); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
        if !resultPartsnnOk { return Res<List<Int>> { st: resultPartsnnState, v: [], ok: false }; };
        s = resultPartsnnState;
        a = stmtNode( s, AstStatement::Assign { n: resultPartsnnValue, e: resultPartsfeValue }); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
        if !resultPartsaOk { return Res<List<Int>> { st: resultPartsaState, v: [], ok: false }; };
        s = resultPartsaState;
        out = push(out, resultPartsaValue);
        i = i + 1;
    };
    dn = putName( s, held); Res { st: resultPartsdnState, v: resultPartsdnValue, ok: resultPartsdnOk } = dn;
    if !resultPartsdnOk { return Res<List<Int>> { st: resultPartsdnState, v: [], ok: false }; };
    s = resultPartsdnState;
    d = stmtNode( s, AstStatement::Dissolve { n: resultPartsdnValue }); Res { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk } = d;
    if !resultPartsdOk { return Res<List<Int>> { st: resultPartsdState, v: [], ok: false }; };
    out = push(out, resultPartsdValue);
    return ok( resultPartsdState, out);
};

// ---- declarations ----

fn structStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "struct"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    params = [];
    // try < params >
    save = checkpoint(s);
    if byteAt(sourceText, s, s.pos) = 60 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        loop = true;
        okParams = true;
        while loop ~ {
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { okParams = false; s = resultPartswState; loop = false; }
            else {
                s = skipWs(sourceText, resultPartswState);
                params = push(params, resultPartswValue);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
            };
        };
        if okParams && byteAt(sourceText, s, s.pos) = 62 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { s = restore(s, save); params = []; };
    };
    outerParams = s.typeParams;
    tps = [];
    for p in params { if isTypeParamName(p) { tps = push(tps, clone(p)); }; };
    s = St { typeParams: tps, ..s };
    if size(params) > 0 { s = setGenerics( s, name, params); } else { s = removeGenerics( s, name); };
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    fieldNames = [];
    fieldTypes = [];
    if byteAt(sourceText, s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            f = structField(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
            if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: 0, ok: false }; };
            s = resultPartsfState;
            fieldNames = push(fieldNames, clone(resultPartsfValue.name));
            fieldTypes = push(fieldTypes, resultPartsfValue.ty);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    inv = [];
    ik = eatKeyword(sourceText, s, "invariant"); Res { st: resultPartsikState, v: resultPartsikValue, ok: resultPartsikOk } = ik;
    ikSt = resultPartsikState;
    if resultPartsikValue {
        s = skipWs(sourceText, ikSt);
        c = optContract(sourceText, s); Res { st: resultPartscState, v: resultPartscValue, ok: resultPartscOk } = c;
        if !resultPartscOk { return Res<Int> { st: resultPartscState, v: 0, ok: false }; };
        // invariant is written with the contract syntax directly (functContractReqs), optContract already handles [{...}]
        inv = resultPartscValue;
        s = resultPartscState;
    } else { s = ikSt; };
    s = St { typeParams: outerParams, ..s };
    if hasDupStrings(fieldNames) { return fail( s, 0, cat3("Struct ", name, " repeats a field")); };
    if isBuiltinTypeName(name) { return fail( s, 0, cat3(name, " is a builtin type and cannot be a struct name", "")); };
    s = shadowCtors( s, name);
    s = setCtor( s, clone(name), clone(fieldNames));
    s = setTypeInfo( s, clone(name), push([], clone(name)));
    finfos = [];
    i = 0;
    for fn2 in fieldNames { finfos = push(finfos, FieldInfo { name: clone(fn2), ty: clone(get(fieldTypes, i)) }); i = i + 1; };
    s = setFields( s, name, finfos);
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    ps = namesList( s, params); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    s = resultPartspsState;
    fs = fieldsNodes( s, fieldNames, fieldTypes); Res { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk } = fs;
    if !resultPartsfsOk { return Res<Int> { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk }; };
    s = resultPartsfsState;
    vs = validationsList( s, inv); Res { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk } = vs;
    if !resultPartsvsOk { return Res<Int> { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk }; };
    return stmtNode( resultPartsvsState, AstStatement::StructDef { n: resultPartsnnValue, ps: resultPartspsValue, fs: resultPartsfsValue, vs: resultPartsvsValue });
};

fn isBuiltinTypeName(name: &String) -> Bool ~ {
    if name = "Int" || name = "Bool" || name = "Array" || name = "Self" || name = "Addr" || name = "Block" || name = "Uninit" { return true; };
    if name = "I8" || name = "I16" || name = "I32" || name = "I64" || name = "U8" || name = "U16" || name = "U32" { return true; };
    if isTupleBase(name) { return true; };
    return false;
};

fn isTupleBase(name: &String) -> Bool ~ {
    // TupleN for 2 <= N <= 16, no leading zero
    if size(name.bytes) <= 5 { return false; };
    if strSlice(name, 0, 5) != "Tuple" { return false; };
    digits = strSlice(name, 5, size(name.bytes));
    if size(digits.bytes) = 0 { return false; };
    if get(&digits.bytes, 0) = toByte(48) { return false; };
    n = 0;
    for i in 0..size(digits.bytes) {
        c = toInt(get(&digits.bytes, i));
        if c < 48 || c > 57 { return false; };
        n = n * 10 + c - 48;
    };
    return n >= 2 && n <= 16;
};

fn fieldsNodes(st: St, names: &List<String>, tys: &List<Type>) -> Res<Int> ~ {
    s = st;
    ids = [];
    i = 0;
    for nm in &names {
        nn = putName( s, nm); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
        if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
        s = resultPartsnnState;
        tn = putTypeNode( s, typeAtOr(tys, i)); Res { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk } = tn;
        if !resultPartstnOk { return Res<Int> { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk }; };
        s = resultPartstnState;
        f = emit( s, AstNode::Field { value: AstField { n: resultPartsnnValue, ty: resultPartstnValue } }); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
        if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk }; };
        s = resultPartsfState;
        ids = push(ids, resultPartsfValue);
        i = i + 1;
    };
    return fieldsList( s, ids);
};


fn structField(sourceText: &Input, st: St) -> Res<FieldOut> ~ {
    s = skipWs(sourceText, st);
    ghostly = false;
    g = eatKeyword(sourceText, s, "ghost"); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
    if resultPartsgValue { ghostly = true; s = skipWs(sourceText, resultPartsgState); } else { s = resultPartsgState; };
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<FieldOut> { st: resultPartsvState, v: FieldOut { name: "", ty: Type::TInt }, ok: false }; };
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 58 { return fail( s, FieldOut { name: "", ty: Type::TInt }, "expected :"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    t = typeAnnotation(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
    if !resultPartstOk { return Res<FieldOut> { st: resultPartstState, v: FieldOut { name: "", ty: Type::TInt }, ok: false }; };
    if ghostly && !ghostTypeOf(clone(resultPartstValue)) { return fail( resultPartstState, FieldOut { name: "", ty: Type::TInt }, "ghost is written before a type that is a permission, Block<T>"); };
    return ok( resultPartstState, FieldOut { name: resultPartsvValue, ty: resultPartstValue });
};

fn enumStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "enum"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    variantNames = [];
    variantFields = [];
    if byteAt(sourceText, s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { return Res<Int> { st: resultPartswState, v: 0, ok: false }; };
            s = skipWs(sourceText, resultPartswState);
            full = cat3(name, "::", resultPartswValue);
            fnames = [];
            ftys = [];
            if byteAt(sourceText, s, s.pos) = 123 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) != 125 {
                    loop2 = true;
                    while loop2 ~ {
                        f = structField(sourceText, s); Res { st: resultPartsfState, v: resultPartsfValue, ok: resultPartsfOk } = f;
                        if !resultPartsfOk { return Res<Int> { st: resultPartsfState, v: 0, ok: false }; };
                        s = resultPartsfState;
                        fnames = push(fnames, clone(resultPartsfValue.name));
                        ftys = push(ftys, resultPartsfValue.ty);
                        s = skipWs(sourceText, s);
                        if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop2 = false; }; } else { loop2 = false; };
                    };
                };
                if byteAt(sourceText, s, s.pos) != 125 { return fail( s, 0, "expected }"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
            };
            if hasDupStrings(fnames) { return fail( s, 0, cat3("Variant ", resultPartswValue, " repeats a field")); };
            variantNames = push(variantNames, clone(full));
            variantFields = push(variantFields, clone(fnames));
            // store field types under the variant name
            finfos = [];
            i = 0;
            for fn2 in fnames { finfos = push(finfos, FieldInfo { name: clone(fn2), ty: clone(get(ftys, i)) }); i = i + 1; };
            s = setFields( s, full, finfos);
            if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); if byteAt(sourceText, s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return fail( s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    if name = "Int" || name = "Bool" || name = "List" || name = "Array" || name = "Box" || name = "Self" { return fail( s, 0, cat3(name, " is a builtin type and cannot be an enum name", "")); };
    if size(variantNames) = 0 { return fail( s, 0, cat3("Enum ", name, " has no variants")); };
    if hasDupStrings(variantNames) { return fail( s, 0, cat3("Enum ", name, " repeats a variant")); };
    s = shadowCtors( s, name);
    for fieldIndex in 0..size(variantNames) {
        if fieldIndex >= size(variantFields) { return fail( s, 0, "internal enum field count mismatch"); };
        s = setCtor( s, get(variantNames, fieldIndex), get(variantFields, fieldIndex));
    };
    s = removeGenerics( s, name);
    s = setTypeInfo( s, name, variantNames);
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    // variants nodes need field types: recompute from fieldsOf
    ids = [];

    for vn in variantNames {
        vnNode = putName( s, vn); Res { st: resultPartsvnNodeState, v: resultPartsvnNodeValue, ok: resultPartsvnNodeOk } = vnNode;
        if !resultPartsvnNodeOk { return Res<Int> { st: resultPartsvnNodeState, v: resultPartsvnNodeValue, ok: resultPartsvnNodeOk }; };
        s = resultPartsvnNodeState;
        finfos = findFields( s, vn);
        fnames2 = [];
        ftys2 = [];
        for fi in finfos { fnames2 = push(fnames2, clone(fi.name)); ftys2 = push(ftys2, clone(fi.ty)); };
        fs = fieldsNodes( s, fnames2, ftys2); Res { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk } = fs;
        if !resultPartsfsOk { return Res<Int> { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk }; };
        s = resultPartsfsState;
        varNode = emit( s, AstNode::Variant { value: AstVariant { n: resultPartsvnNodeValue, fs: resultPartsfsValue } }); Res { st: resultPartsvarNodeState, v: resultPartsvarNodeValue, ok: resultPartsvarNodeOk } = varNode;
        if !resultPartsvarNodeOk { return Res<Int> { st: resultPartsvarNodeState, v: resultPartsvarNodeValue, ok: resultPartsvarNodeOk }; };
        s = resultPartsvarNodeState;
        ids = push(ids, resultPartsvarNodeValue);
    };
    vs = variantsList( s, ids); Res { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk } = vs;
    if !resultPartsvsOk { return Res<Int> { st: resultPartsvsState, v: resultPartsvsValue, ok: resultPartsvsOk }; };
    return stmtNode( resultPartsvsState, AstStatement::EnumDef { n: resultPartsnnValue, vs: resultPartsvsValue });
};

fn traitStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "trait"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    name = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    params = [];
    save = checkpoint(s);
    if byteAt(sourceText, s, s.pos) = 60 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        loop = true;
        okParams = true;
        tmp = [];
        while loop ~ {
            w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
            if !resultPartswOk { okParams = false; s = resultPartswState; loop = false; }
            else {
                s = skipWs(sourceText, resultPartswState);
                tmp = push(tmp, resultPartswValue);
                if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
            };
        };
        if okParams && byteAt(sourceText, s, s.pos) = 62 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); params = tmp; } else { s = restore(s, save); };
    };
    if name = "Int" || name = "Bool" || name = "List" || name = "Array" || name = "Box" || name = "Self" { return fail( s, 0, cat3(name, " is a builtin type and cannot be a trait name", "")); };
    for p in params { if !isTypeParamName(p) { return fail( s, 0, cat3(cat3("trait ", name, " has a size parameter: a trait has types only"), "", "")); }; };
    outerParams = s.typeParams;
    s = St { typeParams: clone(params), ..s };
    s = shadowCtors( s, name);
    s = removeTypeInfo( s, name);
    if size(params) > 0 { s = setGenerics( s, name, params); } else { s = removeGenerics( s, name); };
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    fns = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            tf = traitFunction(sourceText, s); Res { st: resultPartstfState, v: resultPartstfValue, ok: resultPartstfOk } = tf;
            if !resultPartstfOk { return Res<Int> { st: resultPartstfState, v: 0, ok: false }; };
            s = resultPartstfState;
            fns = push(fns, resultPartstfValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 59 { while byteAt(sourceText, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); }; };
        };
    };
    s = skipWs(sourceText, s);
    s = St { typeParams: outerParams, ..s };
    // repeat check on trait fn names
    tnames = [];
    for fid in fns { tnames = push(tnames, traitFnNameOf( s, fid)); };
    if hasDupStrings(tnames) { return fail( s, 0, cat3("Trait ", name, " repeats a function")); };
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    ps = namesList( s, params); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    s = resultPartspsState;
    fs = traitFnsList( s, fns); Res { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk } = fs;
    if !resultPartsfsOk { return Res<Int> { st: resultPartsfsState, v: resultPartsfsValue, ok: resultPartsfsOk }; };
    return stmtNode( resultPartsfsState, AstStatement::TraitDef { n: resultPartsnnValue, ps: resultPartspsValue, fs: resultPartsfsValue });
};

fn traitFnNameOf(st: &St, id: Int) -> String ~ {
    n = nodeAt( st, id);
    if n is AstNode::TraitFn {
        v = (n as AstNode::TraitFn).value;
        return nameText( st, v.n);
    };
    return "";
};

fn traitFunction(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "fn"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    if !resultPartskValue { return fail( resultPartskState, 0, "expected fn"); };
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    fname = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    h = functHeader(sourceText, s); Res { st: resultPartshState, v: resultPartshValue, ok: resultPartshOk } = h;
    if !resultPartshOk { return Res<Int> { st: resultPartshState, v: 0, ok: false }; };
    s = resultPartshState;
    hnames = resultPartshValue.names;
    hins = resultPartshValue.ins;
    houts = resultPartshValue.outs;
    sig = signatureNode( s, &resultPartshValue.types, resultPartshValue.ret, [], [], [], []); Res { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk } = sig;
    if !resultPartssigOk { return Res<Int> { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk }; };
    s = resultPartssigState;
    nn = putName( s, fname); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    ps = namesList( s, hnames); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    s = resultPartspsState;
    il = validationsList( s, hins); Res { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk } = il;
    if !resultPartsilOk { return Res<Int> { st: resultPartsilState, v: resultPartsilValue, ok: resultPartsilOk }; };
    s = resultPartsilState;
    ol = validationsList( s, houts); Res { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk } = ol;
    if !resultPartsolOk { return Res<Int> { st: resultPartsolState, v: resultPartsolValue, ok: resultPartsolOk }; };
    return emit( resultPartsolState, AstNode::TraitFn { value: AstTraitFn { n: resultPartsnnValue, ps: resultPartspsValue, sig: resultPartssigValue, ins: resultPartsilValue, outs: resultPartsolValue } });
};

// generic parameters of fn/impl: [name, [(trait, [types])]] encoded as parallel lists

fn noGenParams() -> List<GenParam> ~ { return []; };

fn genericParamList(sourceText: &Input, st: St) -> Res<List<GenParam>> ~ {
    // at '<'; consumes through '>'
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    out = noGenParams();
    loop = true;
    while loop ~ {
        gp = oneGenericParam(sourceText, s); Res { st: resultPartsgpState, v: resultPartsgpValue, ok: resultPartsgpOk } = gp;
        if !resultPartsgpOk { return Res<List<GenParam>> { st: resultPartsgpState, v: noGenParams(), ok: false }; };
        s = resultPartsgpState;
        out = push(out, resultPartsgpValue);
        s = skipWs(sourceText, s);
        if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
    };
    if byteAt(sourceText, s, s.pos) != 62 { return fail( s, out, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    return ok( s, out);
};

fn oneGenericParam(sourceText: &Input, st: St) -> Res<GenParam> ~ {
    empty = GenParam { name: "", boundTraits: [], boundArgs: [] };
    v = parseVariable(sourceText, st); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<GenParam> { st: resultPartsvState, v: empty, ok: false }; };
    s = skipWs(sourceText, resultPartsvState);
    traits = [];
    argss = [];
    if byteAt(sourceText, s, s.pos) = 58 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(sourceText, s);
        loop = true;
        while loop ~ {
            t = qualifiedName(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
            if !resultPartstOk { return Res<GenParam> { st: resultPartstState, v: empty, ok: false }; };
            s = skipWs(sourceText, resultPartstState);
            args = [];
            if byteAt(sourceText, s, s.pos) = 60 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                loop2 = true;
                while loop2 ~ {
                    ty = typeAnnotation(sourceText, s); Res { st: resultPartstyState, v: resultPartstyValue, ok: resultPartstyOk } = ty;
                    if !resultPartstyOk { return Res<GenParam> { st: resultPartstyState, v: empty, ok: false }; };
                    s = resultPartstyState;
                    args = push(args, resultPartstyValue);
                    s = skipWs(sourceText, s);
                    if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop2 = false; };
                };
                if byteAt(sourceText, s, s.pos) != 62 { return fail( s, empty, "expected >"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
            };
            traits = push(traits, resultPartstValue);
            argss = push(argss, args);
            if byteAt(sourceText, s, s.pos) = 43 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { loop = false; };
        };
    };
    return ok( s, GenParam { name: resultPartsvValue, boundTraits: traits, boundArgs: argss });
};

fn boundsNodes(st: St, gps: &List<GenParam>) -> Res<List<Int>> ~ {
    s = st;
    ids = [];
    for gp in &gps {
        i = 0;
        for tr in gp.boundTraits {
            pn = putName( s, &gp.name); Res { st: resultPartspnState, v: resultPartspnValue, ok: resultPartspnOk } = pn;
            if !resultPartspnOk { return Res<List<Int>> { st: resultPartspnState, v: [], ok: false }; };
            s = resultPartspnState;
            tn = putName( s, tr); Res { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk } = tn;
            if !resultPartstnOk { return Res<List<Int>> { st: resultPartstnState, v: [], ok: false }; };
            s = resultPartstnState;
            ts = putTypesNodes( s, typesAtOr(&gp.boundArgs, i)); Res { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk } = ts;
            if !resultPartstsOk { return Res<List<Int>> { st: resultPartstsState, v: [], ok: false }; };
            s = resultPartstsState;
            b = emit( s, AstNode::Bound { value: AstBound { p: resultPartspnValue, n: resultPartstnValue, ts: resultPartstsValue } }); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<List<Int>> { st: resultPartsbState, v: [], ok: false }; };
            s = resultPartsbState;
            ids = push(ids, resultPartsbValue);
            i = i + 1;
        };
    };
    return ok( s, ids);
};

fn functStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "fn"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
    if !resultPartsvOk { return Res<Int> { st: resultPartsvState, v: 0, ok: false }; };
    var = resultPartsvValue;
    s = skipWs(sourceText, resultPartsvState);
    if var = "clone" && !s.hasSelf { s = St { ownClone: true, ..s }; };
    outerParams = s.typeParams;
    // generic parameters
    gps = [];
    save = checkpoint(s);
    if byteAt(sourceText, s, s.pos) = 60 {
        scanned = scanGenericNames(sourceText, s);
        tpsScan = [];
        for n in scanned { if isTypeParamName(n) { tpsScan = push(tpsScan, clone(n)); }; };
        for p in s.implParams { if isTypeParamName(p) { tpsScan = push(tpsScan, clone(p)); }; };
        s = St { typeParams: tpsScan, ..s };
        g = genericParamList(sourceText, s); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
        if resultPartsgOk { gps = resultPartsgValue; s = resultPartsgState; } else { s = restore(resultPartsgState, save); };
    };
    generics = [];
    for gp in gps { generics = push(generics, clone(gp.name)); };
    for gp in gps {
        for tr in gp.boundTraits { };
    };
    // a bound on a size parameter is refused
    bi = 0;
    for gp in gps {
        if size(gp.boundTraits) > 0 && !isTypeParamName(&gp.name) { return fail( s, 0, "a bound on a size"); };
        bi = bi + 1;
    };
    typeParams = [];
    sizes = [];
    for gname in generics { if isTypeParamName(gname) { typeParams = push(typeParams, clone(gname)); } else { sizes = push(sizes, clone(gname)); }; };
    implTypeParams = [];
    implSizes = [];
    for p in s.implParams { if isTypeParamName(p) { implTypeParams = push(implTypeParams, clone(p)); } else { implSizes = push(implSizes, clone(p)); }; };
    allTypes = clone(typeParams);
    for p in implTypeParams { allTypes = push(allTypes, clone(p)); };
    allSizes = clone(sizes);
    for p in implSizes { allSizes = push(allSizes, clone(p)); };
    s = St { typeParams: clone(allTypes), ..s };
    h = functHeader(sourceText, s); Res { st: resultPartshState, v: resultPartshValue, ok: resultPartshOk } = h;
    if !resultPartshOk { return Res<Int> { st: resultPartshState, v: 0, ok: false }; };
    s = resultPartshState;
    term = terminationClause(sourceText, s); Res { st: resultPartstermState, v: resultPartstermValue, ok: resultPartstermOk } = term;
    if !resultPartstermOk { return Res<Int> { st: resultPartstermState, v: 0, ok: false }; };
    s = resultPartstermState;
    body = curlyBlock(sourceText, s); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<Int> { st: resultPartsbodyState, v: 0, ok: false }; };
    s = resultPartsbodyState;
    s = St { typeParams: outerParams, ..s };
    allNames = clone(resultPartshValue.names);
    allTypesList = clone(resultPartshValue.types);
    for sz in allSizes { allNames = push(allNames, clone(sz)); allTypesList = push(allTypesList, Type::TInt); };
    header2 = HeaderOut { names: allNames, types: allTypesList, ret: resultPartshValue.ret, ins: resultPartshValue.ins, outs: resultPartshValue.outs, writes: resultPartshValue.writes, froms: resultPartshValue.froms };
    assign = functAssignFull( s, var, header2, resultPartstermValue, resultPartsbodyValue, allSizes, allTypes); Res { st: resultPartsassignState, v: resultPartsassignValue, ok: resultPartsassignOk } = assign;
    if !resultPartsassignOk { return Res<Int> { st: resultPartsassignState, v: resultPartsassignValue, ok: resultPartsassignOk }; };
    s = resultPartsassignState;
    hasBounds = false;
    for gp in gps { if size(gp.boundTraits) > 0 { hasBounds = true; }; };
    if !hasBounds { return ok( s, resultPartsassignValue); };
    bIds = boundsNodes( s, gps); Res { st: resultPartsbIdsState, v: resultPartsbIdsValue, ok: resultPartsbIdsOk } = bIds;
    if !resultPartsbIdsOk { return Res<Int> { st: resultPartsbIdsState, v: 0, ok: false }; };
    s = resultPartsbIdsState;
    bl = boundsList( s, resultPartsbIdsValue); Res { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk } = bl;
    if !resultPartsblOk { return Res<Int> { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk }; };
    return stmtNode( resultPartsblState, AstStatement::BoundedDef { bs: resultPartsblValue, s: resultPartsassignValue });
};

fn functAssignFull(st: St, name: &String, h: HeaderOut, termNode: Int, body: &List<Int>, sizes: &List<String>, tps: &List<String>) -> Res<Int> ~ {
    sig = signatureNode( st, &h.types, h.ret, sizes, tps, &h.writes, &h.froms); Res { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk } = sig;
    if !resultPartssigOk { return Res<Int> { st: resultPartssigState, v: resultPartssigValue, ok: resultPartssigOk }; };
    s = resultPartssigState;
    stmts = statementsList( s, body); Res { st: resultPartsstmtsState, v: resultPartsstmtsValue, ok: resultPartsstmtsOk } = stmts;
    if !resultPartsstmtsOk { return Res<Int> { st: resultPartsstmtsState, v: resultPartsstmtsValue, ok: resultPartsstmtsOk }; };
    s = resultPartsstmtsState;
    bodyNode = emit( s, AstNode::Body { value: AstBody::NativeFunct { sig: resultPartssigValue, term: termNode, stmts: resultPartsstmtsValue } }); Res { st: resultPartsbodyNodeState, v: resultPartsbodyNodeValue, ok: resultPartsbodyNodeOk } = bodyNode;
    if !resultPartsbodyNodeOk { return Res<Int> { st: resultPartsbodyNodeState, v: resultPartsbodyNodeValue, ok: resultPartsbodyNodeOk }; };
    s = resultPartsbodyNodeState;
    ps = namesList( s, &h.names); Res { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk } = ps;
    if !resultPartspsOk { return Res<Int> { st: resultPartspsState, v: resultPartspsValue, ok: resultPartspsOk }; };
    s = resultPartspsState;
    insL = validationsList( s, &h.ins); Res { st: resultPartsinsLState, v: resultPartsinsLValue, ok: resultPartsinsLOk } = insL;
    if !resultPartsinsLOk { return Res<Int> { st: resultPartsinsLState, v: resultPartsinsLValue, ok: resultPartsinsLOk }; };
    s = resultPartsinsLState;
    outsL = validationsList( s, &h.outs); Res { st: resultPartsoutsLState, v: resultPartsoutsLValue, ok: resultPartsoutsLOk } = outsL;
    if !resultPartsoutsLOk { return Res<Int> { st: resultPartsoutsLState, v: resultPartsoutsLValue, ok: resultPartsoutsLOk }; };
    s = resultPartsoutsLState;
    ex = emptyProofs( s); Res { st: resultPartsexState, v: resultPartsexValue, ok: resultPartsexOk } = ex;
    if !resultPartsexOk { return Res<Int> { st: resultPartsexState, v: resultPartsexValue, ok: resultPartsexOk }; };
    s = resultPartsexState;
    vf = emit( s, AstNode::Value { value: AstValue::VFunct { ps: resultPartspsValue, ins: resultPartsinsLValue, outs: resultPartsoutsLValue, body: resultPartsbodyNodeValue, exports: resultPartsexValue } }); Res { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk } = vf;
    if !resultPartsvfOk { return Res<Int> { st: resultPartsvfState, v: resultPartsvfValue, ok: resultPartsvfOk }; };
    s = resultPartsvfState;
    ve = valExpr( s, resultPartsvfValue); Res { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk } = ve;
    if !resultPartsveOk { return Res<Int> { st: resultPartsveState, v: resultPartsveValue, ok: resultPartsveOk }; };
    s = resultPartsveState;
    nn = putName( s, name); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    return stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: resultPartsveValue });
};

fn scanGenericNames(sourceText: &Input, st: &St) -> List<String> ~ {
    // the parameter names after '<', without consuming
    s = probeState(st);
    names = [];
    if byteAt(sourceText, s, s.pos) != 60 { return names; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    depth = 1;
    loop = true;
    expectName = true;
    while loop ~ {
        if atEnd(sourceText, s) { loop = false; }
        else {
            if expectName {
                v = parseVariable(sourceText, s); Res { st: resultPartsvState, v: resultPartsvValue, ok: resultPartsvOk } = v;
                if !resultPartsvOk { s = resultPartsvState; loop = false; }
                else {
                    names = push(names, resultPartsvValue);
                    s = resultPartsvState;
                    expectName = false;
                };
            } else {
                c = byteAt(sourceText, s, s.pos);
                if c = 60 { depth = depth + 1; s = St { pos: s.pos + 1, ..s }; }
                else { if c = 62 { depth = depth - 1; s = St { pos: s.pos + 1, ..s }; if depth = 0 { loop = false; }; }
                else { if c = 44 && depth = 1 { expectName = true; s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { s = St { pos: s.pos + 1, ..s }; }; }; };
            };
        };
    };
    return names;
};

fn implStatement(sourceText: &Input, st: St) -> Res<Int> ~ {
    k = eatKeyword(sourceText, st, "impl"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
    s = skipWs(sourceText, resultPartskState);
    outerParams0 = s.typeParams;
    // impl parameters
    implParamList = [];
    implBoundsGps = [];
    save0 = checkpoint(s);
    if byteAt(sourceText, s, s.pos) = 60 {
        scanned = scanGenericNames(sourceText, s);
        tps = [];
        for n in scanned { if isTypeParamName(n) { tps = push(tps, clone(n)); }; };
        s = St { typeParams: tps, ..s };
        g = genericParamList(sourceText, s); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
        if resultPartsgOk { implParamList = resultPartsgValue; s = resultPartsgState; } else { s = restore(resultPartsgState, save0); };
    };
    s = St { typeParams: outerParams0, ..s };
    implParams = [];
    for gp in implParamList { implParams = push(implParams, clone(gp.name)); };
    outerParams = s.typeParams;
    tpsOnly = [];
    for n in implParams { if isTypeParamName(n) { tpsOnly = push(tpsOnly, clone(n)); }; };
    s = St { typeParams: tpsOnly, ..s };
    first = qualifiedName(sourceText, s); Res { st: resultPartsfirstState, v: resultPartsfirstValue, ok: resultPartsfirstOk } = first;
    if !resultPartsfirstOk { return Res<Int> { st: resultPartsfirstState, v: 0, ok: false }; };
    s = skipWs(sourceText, resultPartsfirstState);
    firstArgs = [];
    hasFirstArgs = false;
    fp = findGenerics( s, resultPartsfirstValue);
    if size(fp) > 0 && hasGenericArguments(sourceText, s, fp) {
        g = genericArguments(sourceText, skipWs(sourceText, s), fp); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
        if resultPartsgOk { firstArgs = resultPartsgValue; hasFirstArgs = true; s = resultPartsgState; } else { s = resultPartsgState; };
    };
    trt = "";
    hasTrait = false;
    traitArgs = [];
    typeName = clone(resultPartsfirstValue);
    typeArgs = clone(firstArgs);
    hasTypeArgs = hasFirstArgs;
    s = skipWs(sourceText, s);
    fk = eatKeyword(sourceText, s, "for"); Res { st: resultPartsfkState, v: resultPartsfkValue, ok: resultPartsfkOk } = fk;
    if resultPartsfkValue {
        s = skipWs(sourceText, resultPartsfkState);
        t = qualifiedName(sourceText, s); Res { st: resultPartstState, v: resultPartstValue, ok: resultPartstOk } = t;
        if !resultPartstOk { return Res<Int> { st: resultPartstState, v: 0, ok: false }; };
        trt = resultPartsfirstValue;
        hasTrait = true;
        traitArgs = firstArgs;
        typeName = resultPartstValue;
        s = skipWs(sourceText, resultPartstState);
        typeArgs = [];
        hasTypeArgs = false;
        if typeName = "List" || typeName = "Box" {
            s2 = skipWs(sourceText, s);
            if byteAt(sourceText, s2, s2.pos) = 60 {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(sourceText, s2);
                ty = typeAnnotation(sourceText, s2); Res { st: resultPartstyState, v: resultPartstyValue, ok: resultPartstyOk } = ty;
                if !resultPartstyOk { return Res<Int> { st: resultPartstyState, v: 0, ok: false }; };
                s = skipWs(sourceText, resultPartstyState);
                if byteAt(sourceText, s, s.pos) != 62 { return fail( s, 0, "expected >"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                typeArgs = push([], ArgV { isSize: false, size: Size::SAny, ty: resultPartstyValue });
                hasTypeArgs = true;
            } else { s = s2; };
        } else {
            if typeName = "Array" {
                s2 = skipWs(sourceText, s);
                if byteAt(sourceText, s2, s2.pos) = 60 {
                    s2 = St { pos: s2.pos + 1, ..s2 };
                    s2 = skipWs(sourceText, s2);
                    ty = typeAnnotation(sourceText, s2); Res { st: resultPartstyState, v: resultPartstyValue, ok: resultPartstyOk } = ty;
                    if !resultPartstyOk { return Res<Int> { st: resultPartstyState, v: 0, ok: false }; };
                    s = resultPartstyState;
                    size = Size::SAny;
                    s = skipWs(sourceText, s);
                    if byteAt(sourceText, s, s.pos) = 44 {
                        s = St { pos: s.pos + 1, ..s };
                        s = skipWs(sourceText, s);
                        z = sizeArgument(sourceText, s); Res { st: resultPartszState, v: resultPartszValue, ok: resultPartszOk } = z;
                        if !resultPartszOk { return Res<Int> { st: resultPartszState, v: 0, ok: false }; };
                        s = resultPartszState;
                        size = resultPartszValue;
                    };
                    s = skipWs(sourceText, s);
                    if byteAt(sourceText, s, s.pos) != 62 { return fail( s, 0, "expected >"); };
                    s = St { pos: s.pos + 1, ..s };
                    s = skipWs(sourceText, s);
                    typeArgs = push(push([], ArgV { isSize: false, size: Size::SAny, ty: resultPartstyValue }), ArgV { isSize: true, size: size, ty: Type::TInt });
                    hasTypeArgs = true;
                } else { s = s2; };
            } else {
                tp2 = findGenerics( s, typeName);
                if size(tp2) > 0 && hasGenericArguments(sourceText, s, tp2) {
                    g = genericArguments(sourceText, skipWs(sourceText, s), tp2); Res { st: resultPartsgState, v: resultPartsgValue, ok: resultPartsgOk } = g;
                    if resultPartsgOk { typeArgs = resultPartsgValue; hasTypeArgs = true; s = resultPartsgState; } else { s = resultPartsgState; };
                };
            };
        };
    } else { s = resultPartsfkState; };
    s = St { typeParams: outerParams, ..s };
    isBuiltinType = typeName = "List" || typeName = "Box" || typeName = "Array" || typeName = "Int" || typeName = "Byte" || typeName = "Bool";
    if !isBuiltinType && !containsText(typeName, "::") && !hasTypeNamed( s, typeName) { return fail( s, 0, cat3(cat3("impl for ", typeName, ", which is not a struct or enum declared before"), "", "")); };
    // trait parameter checks
    if hasTrait {
        tp3 = findGenerics( s, trt);
        if size(tp3) > 0 && !hasFirstArgs {
            joined = joinNames(tp3);
            return fail( s, 0, cat3(catStrings(cat3(cat3("trait ", trt, " has parameters <"), joined, ">: write impl "), cat3(trt, "<", joined)), cat3("> for ", typeName, ""), ""));
        };
        if size(tp3) = 0 && hasFirstArgs { return fail( s, 0, cat3("trait ", trt, " has no parameters")); };
    };
    // self name and type
    selfName = clone(typeName);
    selfTy = namedTypeOf(typeName, typeArgs);
    if typeName = "List" || typeName = "Box" || typeName = "Array" {
        if !hasTypeArgs && typeName = "List" { return fail( s, 0, "impl for List names its types, so it is written impl<T> Trait<T> for List<T>"); };
        selfName = instanceNameOf(typeName, typeArgs);
        selfTy = namedTypeOf(typeName, typeArgs);
    } else {
        tp4 = findGenerics( s, typeName);
        if size(tp4) > 0 {
            if !hasTypeArgs {
                return fail( s, 0, cat3(catStrings(cat3(cat3("impl for ", typeName, ", which has parameters <"), joinNames(tp4), ">: write impl<"), joinNames(tp4)), cat3("> ", typeName, ""), cat3("<", joinNames(tp4), ">")));
            };
            if size(implParams) = 0 { return fail( s, 0, cat3("impl for ", typeName, " names its types, so it is written impl<...>")); };
            selfName = instanceNameOf(typeName, typeArgs);
            selfTy = namedTypeOf(typeName, typeArgs);
        } else {
            if size(implParams) > 0 { return fail( s, 0, cat3(cat3(cat3("impl<", joinNames(implParams), "> for "), typeName, ", which has no parameters"), "", "")); };
            selfName = clone(typeName);
            selfTy = namedTypeOf(typeName, []);
        };
    };
    s = St { selfName: clone(selfName), ..s };
    s = St { hasSelf: true, ..s };
    s = St { selfTy: clone(selfTy), ..s };
    s = St { hasSelfTy: true, ..s };
    s = St { implParams: clone(implParams), ..s };
    if hasCtor( s, typeName) { s = setCtor( s, selfName, findCtor( s, typeName)); };
    s = skipWs(sourceText, s);
    if byteAt(sourceText, s, s.pos) != 123 { return fail( s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    written = [];
    loop = true;
    while loop ~ {
        if byteAt(sourceText, s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            d = implFunction(sourceText, s, typeName, hasTrait, trt); Res { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk } = d;
            if !resultPartsdOk { return Res<Int> { st: resultPartsdState, v: 0, ok: false }; };
            s = resultPartsdState;
            written = push(written, resultPartsdValue);
            s = skipWs(sourceText, s);
            if byteAt(sourceText, s, s.pos) = 59 { while byteAt(sourceText, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); }; };
        };
    };
    s = skipWs(sourceText, s);
    standardEq = hasTrait && trt = "Eq" && size(written) = 0 && !isBuiltinType;
    standardClone = hasTrait && trt = "Clone" && size(written) = 0 && !isBuiltinType;
    functions = written;
    if standardEq || standardClone {
        text = "";
        if standardEq { text = standardEqText( s, typeName); } else { text = standardCloneText( s, typeName); };
        gen = parseGenerated(sourceText, s, text, typeName, hasTrait, trt); Res { st: resultPartsgenState, v: resultPartsgenValue, ok: resultPartsgenOk } = gen;
        if !resultPartsgenOk { return Res<Int> { st: resultPartsgenState, v: 0, ok: false }; };
        s = resultPartsgenState;
        functions = resultPartsgenValue;
    };
    implBoundsIds = [];
    implBounds = boundsNodesList( s, implParamList); Res { st: resultPartsimplBoundsState, v: resultPartsimplBoundsValue, ok: resultPartsimplBoundsOk } = implBounds;
    if !resultPartsimplBoundsOk { return Res<Int> { st: resultPartsimplBoundsState, v: 0, ok: false }; };
    s = resultPartsimplBoundsState;
    extraTrait = "";
    if standardEq { extraTrait = "Eq"; };
    if standardClone { extraTrait = "Clone"; };
    if size(extraTrait.bytes) > 0 {

        for p in implParams {
            if isTypeParamName(p) && !genHasBound(implParamList, p, extraTrait) {
                pn = putName( s, p); Res { st: resultPartspnState, v: resultPartspnValue, ok: resultPartspnOk } = pn;
                if !resultPartspnOk { return Res<Int> { st: resultPartspnState, v: resultPartspnValue, ok: resultPartspnOk }; };
                s = resultPartspnState;
                tn = putName( s, extraTrait); Res { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk } = tn;
                if !resultPartstnOk { return Res<Int> { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk }; };
                s = resultPartstnState;
                ts = typesList( s, []); Res { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk } = ts;
                if !resultPartstsOk { return Res<Int> { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk }; };
                s = resultPartstsState;
                b = emit( s, AstNode::Bound { value: AstBound { p: resultPartspnValue, n: resultPartstnValue, ts: resultPartstsValue } }); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
                if !resultPartsbOk { return Res<Int> { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk }; };
                s = resultPartsbState;
                // bounds are a list node built later; keep ids in a side list via a second pass: store in implBoundsIds
                implBoundsIds = push(implBoundsIds, resultPartsbValue);
            };
        };
    };
    s = St { selfName: "", hasSelf: false, selfTy: Type::TInt, hasSelfTy: false, implParams: [], ..s };
    if selfName != typeName { s = deleteCtor( s, selfName); };
    on = optNameNode( s, hasTrait, trt); Res { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk } = on;
    if !resultPartsonOk { return Res<Int> { st: resultPartsonState, v: resultPartsonValue, ok: resultPartsonOk }; };
    s = resultPartsonState;
    aa = putArgsNodes( s, traitArgs); Res { st: resultPartsaaState, v: resultPartsaaValue, ok: resultPartsaaOk } = aa;
    if !resultPartsaaOk { return Res<Int> { st: resultPartsaaState, v: resultPartsaaValue, ok: resultPartsaaOk }; };
    s = resultPartsaaState;
    nn = putName( s, typeName); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk }; };
    s = resultPartsnnState;
    tyNode = putTypeNode( s, selfTy); Res { st: resultPartstyNodeState, v: resultPartstyNodeValue, ok: resultPartstyNodeOk } = tyNode;
    if !resultPartstyNodeOk { return Res<Int> { st: resultPartstyNodeState, v: resultPartstyNodeValue, ok: resultPartstyNodeOk }; };
    s = resultPartstyNodeState;
    allBounds = clone(resultPartsimplBoundsValue);
    for x in implBoundsIds { allBounds = push(allBounds, x); };
    bl = boundsList( s, allBounds); Res { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk } = bl;
    if !resultPartsblOk { return Res<Int> { st: resultPartsblState, v: resultPartsblValue, ok: resultPartsblOk }; };
    s = resultPartsblState;
    xs = statementsList( s, functions); Res { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk } = xs;
    if !resultPartsxsOk { return Res<Int> { st: resultPartsxsState, v: resultPartsxsValue, ok: resultPartsxsOk }; };
    return stmtNode( resultPartsxsState, AstStatement::ImplDef { traitName: resultPartsonValue, args: resultPartsaaValue, n: resultPartsnnValue, ty: resultPartstyNodeValue, bs: resultPartsblValue, xs: resultPartsxsValue });
};

fn joinNames(xs: &List<String>) -> String ~ {
    out = "";
    i = 0;
    for x in &xs { if i > 0 { out = catStrings(out, ", "); }; out = catStrings(out, x); i = i + 1; };
    return out;
};

fn genHasBound(gps: &List<GenParam>, p: &String, trt: &String) -> Bool ~ {
    for gp in &gps { if gp.name = p { for t in gp.boundTraits { if t = trt { return true; }; }; }; };
    return false;
};

fn boundsNodesList(st: St, gps: &List<GenParam>) -> Res<List<Int>> ~ {
    s = st;
    ids = [];
    for gp in &gps {
        i = 0;
        for tr in gp.boundTraits {
            pn = putName( s, &gp.name); Res { st: resultPartspnState, v: resultPartspnValue, ok: resultPartspnOk } = pn;
            if !resultPartspnOk { return Res<List<Int>> { st: resultPartspnState, v: [], ok: false }; };
            s = resultPartspnState;
            tn = putName( s, tr); Res { st: resultPartstnState, v: resultPartstnValue, ok: resultPartstnOk } = tn;
            if !resultPartstnOk { return Res<List<Int>> { st: resultPartstnState, v: [], ok: false }; };
            s = resultPartstnState;
            ts = putTypesNodes( s, typesAtOr(&gp.boundArgs, i)); Res { st: resultPartstsState, v: resultPartstsValue, ok: resultPartstsOk } = ts;
            if !resultPartstsOk { return Res<List<Int>> { st: resultPartstsState, v: [], ok: false }; };
            s = resultPartstsState;
            b = emit( s, AstNode::Bound { value: AstBound { p: resultPartspnValue, n: resultPartstnValue, ts: resultPartstsValue } }); Res { st: resultPartsbState, v: resultPartsbValue, ok: resultPartsbOk } = b;
            if !resultPartsbOk { return Res<List<Int>> { st: resultPartsbState, v: [], ok: false }; };
            s = resultPartsbState;
            ids = push(ids, resultPartsbValue);
            i = i + 1;
        };
    };
    return ok( s, ids);
};

fn implFunction(sourceText: &Input, st: St, typeName: &String, hasTrait: Bool, trt: &String) -> Res<Int> ~ {
    d = functStatement(sourceText, st); Res { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk } = d;
    if !resultPartsdOk { return Res<Int> { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk }; };
    assignParts = statementAssignParts( resultPartsdState, resultPartsdValue);
    if size(assignParts) != 2 { return Res<Int> { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk }; };
    s = resultPartsdState;
    var = nameText( s, get(assignParts, 0));
    variantName = cat3(typeName, "::", var);
    if hasCtor( s, variantName) { return fail( s, 0, cat3(variantName, " is a variant, and cannot also be a function", "")); };
    full = implName(typeName, hasTrait, trt, var);
    nn = putName( s, full); Res { st: resultPartsnnState, v: resultPartsnnValue, ok: resultPartsnnOk } = nn;
    if !resultPartsnnOk { return Res<Int> { st: resultPartsnnState, v: 0, ok: false }; };
    return stmtNode( resultPartsnnState, AstStatement::Assign { n: resultPartsnnValue, e: get(assignParts, 1) });
};

fn statementAssignParts(st: &St, id: Int) -> List<Int> ~ {
    n = nodeAt( st, id);
    if n is AstNode::Statement {
        v = (n as AstNode::Statement).value;
        out = [];
        match v {
            AstStatement::Assign { n: a, e: b } => { out = push(push([], a), b); },
            AstStatement::AssignDeref { a: a, b: b } => { out = []; },
            AstStatement::Let { n: a, e: b } => { out = []; },
            AstStatement::Return { e: a } => { out = []; },
            AstStatement::ValidationStatement { v: a } => { out = []; },
            AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { out = []; },
            AstStatement::EnumDef { n: a, vs: b } => { out = []; },
            AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { out = []; },
            AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { out = []; },
            AstStatement::Block { xs: a } => { out = []; },
            AstStatement::If { e: a, a: b, b: c } => { out = []; },
            AstStatement::While { e: a, vs: b, t: c, xs: d } => { out = []; },
            AstStatement::TraitDef { n: a, ps: b, fs: c } => { out = []; },
            AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { out = []; },
            AstStatement::BoundedDef { bs: a, s: b } => { out = []; },
            AstStatement::Mark { line: a, col: b } => { out = []; },
            AstStatement::CopyDef { n: a } => { out = []; },
            AstStatement::LinearDef { n: a } => { out = []; },
            AstStatement::ExternDef { n: a } => { out = []; },
            AstStatement::DropDef { n: a } => { out = []; },
            AstStatement::Dissolve { n: a } => { out = []; },
        };
        return out;
    };
    return [];
};
fn parseGenerated(sourceText: &Input, st: St, text: &String, typeName: &String, hasTrait: Bool, trt: &String) -> Res<List<Int>> ~ {

    savedPos = st.pos;
    savedGenLine = st.genLine;
    savedGenCol = st.genCol;
    base = inputLineCol(sourceText, savedPos);
    generatedInput = newInput(clone(text));
    s = st;

    s = St { pos: 0, ..s };
    s = St { genLine: get(base, 0), ..s };
    s = St { genCol: get(base, 1), ..s };
    out = [];
    loop = true;
    while loop ~ {
        s = skipWs(generatedInput, s);
        if atEnd(generatedInput, s) { loop = false; }
        else {
            d = implFunction(generatedInput, s, typeName, hasTrait, trt); Res { st: resultPartsdState, v: resultPartsdValue, ok: resultPartsdOk } = d;
            if !resultPartsdOk { return Res<List<Int>> { st: resultPartsdState, v: [], ok: false }; };
            s = resultPartsdState;
            out = push(out, resultPartsdValue);
            s = skipWs(generatedInput, s);
            if byteAt(generatedInput, s, s.pos) = 59 { while byteAt(generatedInput, s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(generatedInput, s); }; };
        };
    };

    s = St { pos: savedPos, ..s };
    s = St { genLine: savedGenLine, ..s };
    s = St { genCol: savedGenCol, ..s };
    return ok( s, out);
};

// ---- generated Eq and Clone (Parse.standardEqFunction, Parse.standardCloneFunction) ----

fn fieldsOfVariant(st: &St, v: &String) -> List<FieldInfo> ~ { return findFields( st, v); };

fn typeMentionsSelf(t: Type, self: &String) -> Bool ~ {
    out = false;
    match t {
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = b = self; },
        Type::TList { elem: e } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TBox { inner: e } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TArray { elem: e, size: s } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: e } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TAddr { inner: e } => { out = false; },
        Type::TBlock { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn isSelfType(t: Type, self: &String) -> Bool ~ {
    out = false;
    match t {
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = b = self; },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TList { elem: e } => { out = false; },
        Type::TArray { elem: e, size: s } => { out = false; },
        Type::TBox { inner: e } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: e } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TAddr { inner: e } => { out = false; },
        Type::TBlock { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn differsText(a: &String, b: &String) -> String ~ {
    return cat3(cat3("if ", a, " != "), b, " { return false; }; ");
};

fn standardEqText(st: &St, typeName: &String) -> String ~ {
    variants = sourceVariants(typeName, typeVariantsOf(st, typeName));
    body = "";
    if size(variants) = 1 && nameAtOr(variants, 0, "") = typeName {
        fields = fieldsOfVariant( st, nameAtOr(variants, 0, ""));
        i = 0;
        for f in fields {
            body = body.concat(compareFieldText( st, typeName, i, clone(f), "self", "other"));
            i = i + 1;
        };
        body = body.concat("return true;");
    } else {
        for v in variants {
            fields = fieldsOfVariant( st, v);
            inner = "";
            i = 0;
            for f in fields {
                inner = inner.concat(compareFieldText( st, typeName, i, clone(f), cat3("(self as ", v, ")"), cat3("(other as ", v, ")")));
                i = i + 1;
            };
            body = body.concat(catStrings(cat3(cat3("if self is ", v, " { if other is "), v, " { "), inner.concat("return true; }; return false; }; ")));
        };
        body = body.concat("return false;");
    };
    return cat3("fn eq(self: &Self, other: &Self) -> Bool [{ }] [{ affirm return = (self = other); }] shrinks self { ", body, " };");
};

fn typeVariantsOf(st: &St, typeName: &String) -> List<String> ~ {
    for c in currentTypes(st) { if c.name = typeName { return clone(c.variants); }; };
    return [];
};

fn compareFieldText(st: &St, typeName: &String, n: Int, f: FieldInfo, a: &String, b: &String) -> String ~ {
    isListSelf = false;
    match f.ty {
        Type::TList { elem: e } => { isListSelf = typeMentionsSelf(Box::unbox(e), typeName); },
        Type::TInt => { isListSelf = false; },
        Type::TByte => { isListSelf = false; },
        Type::TBool => { isListSelf = false; },
        Type::TArray { elem: e, size: s } => { isListSelf = false; },
        Type::TBox { inner: e } => { isListSelf = false; },
        Type::TFn { args: x, ret: r } => { isListSelf = false; },
        Type::TNamed { name: x, base: y, argc: c, argTokens: d } => { isListSelf = false; },
        Type::TVariant { name: x } => { isListSelf = false; },
        Type::TVar { n: x } => { isListSelf = false; },
        Type::TForall { sizes: x, types: y, body: c } => { isListSelf = false; },
        Type::TParam { name: x } => { isListSelf = false; },
        Type::TRef { inner: e } => { isListSelf = false; },
        Type::TMutRef { inner: e } => { isListSelf = false; },
        Type::TAddr { inner: e } => { isListSelf = false; },
        Type::TBlock { inner: e } => { isListSelf = false; },
        Type::TUninit { inner: e } => { isListSelf = false; },
        Type::TWord { signed: x, bits: y } => { isListSelf = false; },
    };
    if isListSelf {
        i = catStrings("i", String::fromInt(n));
        l = cat3(a, ".", &f.name);
        r = cat3(b, ".", &f.name);
        out = differsText(cat3("size(", l, ")"), cat3("size(", r, ")"));
        out = catStrings(out, cat3(cat3(catStrings(i, " = 0; while "), i, " < size("), l, ")"));
        out = catStrings(out, cat3(cat3(cat3(cat3(" [{ affirm ", i, " >= 0; affirm "), i, " <= size("), l, "); affirm forall j in 0.."), i, ": get("));
        out = catStrings(out, cat3(cat3(catStrings(l, ", j) = get("), r, ", j); }] shrinks size("), l, ") - "));
        out = catStrings(out, catStrings(i, " { "));
        out = catStrings(out, differsText(cat3(cat3("get(", l, ", "), i, ")"), cat3(cat3("get(", r, ", "), i, ")")));
        out = catStrings(out, cat3(catStrings(i, " = "), i, " + 1; }; "));
        return out;
    };
    return differsText(cat3(a, ".", &f.name), cat3(b, ".", &f.name));
};

fn standardCloneText(st: &St, typeName: &String) -> String ~ {
    variants = sourceVariants(typeName, typeVariantsOf(st, typeName));
    body = "";
    if size(variants) = 1 && nameAtOr(variants, 0, "") = typeName {
        fields = fieldsOfVariant( st, nameAtOr(variants, 0, ""));
        parts = cloneParts( st, typeName, fields, "self.");
        body = catStrings(nameAtOr(parts, 0, ""), cat3("return Self { ", nameAtOr(parts, 1, ""), " };"));
    } else {
        vi = 0;
        for v in variants {
            fields = fieldsOfVariant( st, v);
            src = cat3("(self as ", v, ")");
            parts = clonePartsPrefixed( st, typeName, fields, src);
            built = clone(v);
            if size(fields) > 0 { built = cat3(catStrings(v, " { "), nameAtOr(parts, 1, ""), " }"); };
            if vi < size(variants) - 1 {
                body = body.concat(catStrings(catStrings(cat3("if self is ", v, " { "), nameAtOr(parts, 0, "")), cat3("return ", built, "; }; ")));
            } else {
                body = body.concat(catStrings(nameAtOr(parts, 0, ""), cat3("return ", built, ";")));
            };
            vi = vi + 1;
        };
    };
    return cat3("fn clone(self: &Self) -> Self [{ }] [{ affirm return = self; }] shrinks self { ", body, " };");
};

fn cloneParts(st: &St, typeName: &String, fields: &List<FieldInfo>, prefix: &String) -> List<String> ~ {
    pre = "";
    assigns = "";
    i = 0;
    for f in &fields {
        src = cat3(prefix, &f.name, "");
        part = fieldCloneText( st, typeName, i, clone(f), src);
        pre = pre.concat(nameAtOr(part, 0, ""));
        if i > 0 { assigns = assigns.concat(", "); };
        assigns = assigns.concat(cat3(cat3(&f.name, ": ", nameAtOr(part, 1, "")), "", ""));
        i = i + 1;
    };
    return push(push([], pre), assigns);
};

fn clonePartsPrefixed(st: &St, typeName: &String, fields: &List<FieldInfo>, srcBase: &String) -> List<String> ~ {
    pre = "";
    assigns = "";
    i = 0;
    for f in &fields {
        src = cat3(srcBase, ".", &f.name);
        part = fieldCloneText( st, typeName, i, clone(f), src);
        pre = pre.concat(nameAtOr(part, 0, ""));
        if i > 0 { assigns = assigns.concat(", "); };
        assigns = assigns.concat(cat3(&f.name, ": ", nameAtOr(part, 1, "")));
        i = i + 1;
    };
    return push(push([], pre), assigns);
};

fn fieldCloneText(st: &St, typeName: &String, n: Int, f: FieldInfo, src: &String) -> List<String> ~ {
    kind = 0; // 0 clone(x), 1 list loop, 2 array loop, 3 box self
    match f.ty {
        Type::TList { elem: e } => { if typeMentionsSelf(Box::unbox(e), typeName) { kind = 1; }; },
        Type::TArray { elem: e, size: s } => { if typeMentionsSelf(Box::unbox(e), typeName) { kind = 2; }; },
        Type::TBox { inner: e } => { if isSelfType(Box::unbox(e), typeName) { kind = 3; }; },
        Type::TInt => { kind = 0; },
        Type::TByte => { kind = 0; },
        Type::TBool => { kind = 0; },
        Type::TFn { args: a, ret: r } => { kind = 0; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { kind = 0; },
        Type::TVariant { name: a } => { kind = 0; },
        Type::TVar { n: a } => { kind = 0; },
        Type::TForall { sizes: a, types: b, body: c } => { kind = 0; },
        Type::TParam { name: a } => { kind = 0; },
        Type::TRef { inner: e } => { kind = 0; },
        Type::TMutRef { inner: e } => { kind = 0; },
        Type::TAddr { inner: e } => { kind = 0; },
        Type::TBlock { inner: e } => { kind = 0; },
        Type::TUninit { inner: e } => { kind = 0; },
        Type::TWord { signed: a, bits: b } => { kind = 0; },
    };
    if kind = 3 { return push(push([], ""), cat3("Box::new(clone(Box::unbox(", src, ")))")); };
    if kind = 1 || kind = 2 {
        c = catStrings("cloneField", String::fromInt(n));
        i = catStrings("cloneIndex", String::fromInt(n));
        out = cat3(catStrings(c, " = []; "), i, " = 0; while ");
        out = catStrings(out, cat3(catStrings(i, " < size("), src, ") [{ affirm "));
        out = catStrings(out, cat3(catStrings(i, " >= 0; affirm "), i, " <= size("));
        out = catStrings(out, cat3(catStrings(src, "); affirm size("), c, ") = "));
        out = catStrings(out, cat3(catStrings(i, "; affirm forall j in 0.."), i, ": get("));
        out = catStrings(out, cat3(cat3(catStrings(c, ", j) = get("), src, ", j); }] shrinks size("), src, ") - "));
        out = catStrings(out, cat3(catStrings(i, " { "), c, " = push("));
        out = catStrings(out, cat3(cat3(catStrings(c, ", clone(get("), src, ", "), i, "))); "));
        out = catStrings(out, cat3(catStrings(i, " = "), i, " + 1; }; "));
        if kind = 2 { return push(push([], out), cat3("Array::fromList(", c, ")")); };
        return push(push([], out), c);
    };
    return push(push([], ""), cat3("clone(", src, ")"));
};
fn hasTextPrefix(text: &String, prefix: &String) -> Bool ~ {
    if size(prefix.bytes) > size(text.bytes) { return false; };
    i = 0;
    while i < size(prefix.bytes) ~ { if get(&text.bytes, i) != get(&prefix.bytes, i) { return false; }; i = i + 1; };
    return true;
};

fn joinComma(xs: &List<String>) -> String ~ {
    out = "";
    i = 0;
    for x in &xs { if i > 0 { out = catStrings(out, ", "); }; out = catStrings(out, x); i = i + 1; };
    return out;
};

// The import declarations at the head of the file segment (Parse.fileParser): their paths,
// rendered. A file with imports is parsed whole, and only then refused as not linked.
fn fileHead(sourceText: &Input, st: St) -> Res<List<String>> ~ {
    s = skipWs(sourceText, st);
    out = [];
    loop = true;
    while loop ~ {
        if atImportKeyword(sourceText, s) {
            s = St { pos: s.pos + 6, ..s };
            s = skipWs(sourceText, s);
            p = namePathOf(sourceText, s); Res { st: resultPartspState, v: resultPartspValue, ok: resultPartspOk } = p;
            if !resultPartspOk { return Res<List<String>> { st: resultPartspState, v: [], ok: false }; };
            rendered = joinFrom(resultPartspValue, 0);
            s = skipWs(sourceText, resultPartspState);
            k = eatKeyword(sourceText, s, "as"); Res { st: resultPartskState, v: resultPartskValue, ok: resultPartskOk } = k;
            if resultPartskValue {
                s = skipWs(sourceText, resultPartskState);
                a = parseVariable(sourceText, s); Res { st: resultPartsaState, v: resultPartsaValue, ok: resultPartsaOk } = a;
                if !resultPartsaOk { return Res<List<String>> { st: resultPartsaState, v: [], ok: false }; };
                s = skipWs(sourceText, resultPartsaState);
            } else { s = resultPartskState; };
            if byteAt(sourceText, s, s.pos) = 123 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 125 { return fail( s, out, "an import name list must not be empty"); };
                namesLoop = true;
                while namesLoop ~ {
                    w = parseVariable(sourceText, s); Res { st: resultPartswState, v: resultPartswValue, ok: resultPartswOk } = w;
                    if !resultPartswOk { return Res<List<String>> { st: resultPartswState, v: [], ok: false }; };
                    s = skipWs(sourceText, resultPartswState);
                    if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { namesLoop = false; };
                };
                if byteAt(sourceText, s, s.pos) != 125 { return fail( s, out, "expected }"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
            };
            if byteAt(sourceText, s, s.pos) != 59 { return fail( s, out, "expected ;"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            out = push(out, rendered);
        } else { loop = false; };
    };
    return ok( s, out);
};

// One segment of the file the pipeline reads: the last segment is a file, with its import
// declarations; the libraries in front of it are statement blocks
fn parseSegment(sourceText: &Input, state: St, isFile: Bool) -> Res<List<Int>> ~ {
    if !isFile { return statementBlock(sourceText, state); };
    head = fileHead(sourceText, state); Res { st: resultPartsheadState, v: resultPartsheadValue, ok: resultPartsheadOk } = head;
    if !resultPartsheadOk { return Res<List<Int>> { st: resultPartsheadState, v: [], ok: false }; };
    body = statementBlock(sourceText, resultPartsheadState); Res { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk } = body;
    if !resultPartsbodyOk { return Res<List<Int>> { st: resultPartsbodyState, v: resultPartsbodyValue, ok: resultPartsbodyOk }; };
    bv = resultPartsbodyValue;
    bs = resultPartsbodyState;
    if size(resultPartsheadValue) > 0 {
        bs = skipWs(sourceText, bs);
        if atEnd(sourceText, bs) { return fail( bs, [], catStrings("imports are not linked yet: ", joinComma(resultPartsheadValue))); };
    };
    return Res<List<Int>> { st: bs, v: bv, ok: true };
};

// ---- driver ----

fn parseNonNegative(text: &String) -> Int ~ {
    if size(text.bytes) = 0 { return 0 - 1; };
    n = 0;
    for i in 0..size(text.bytes) {
        c = toInt(get(&text.bytes, i));
        if c < 48 || c > 57 { return 0 - 1; };
        digit = c - 48;
        if n > 922337203685477580 || (n = 922337203685477580 && digit > 7) { return 0 - 1; };
        n = n * 10 + digit;
    };
    return n;
};

fn splitTwoSpaces(line: &String) -> List<String> ~ {
    out = [];
    start = 0;
    i = 0;
    while i < size(line.bytes) ~ {
        if get(&line.bytes, i) = toByte(32) { out = push(out, strSlice(line, start, i)); start = i + 1; };
        i = i + 1;
    };
    out = push(out, strSlice(line, start, size(line.bytes)));
    return out;
};

fn readSegmentBytes(count: Int) -> List<Int> ~ {
    bytes = [];
    i = 0;
    while i < count ~ {
        c = readByte();
        if c < 0 { return []; };
        bytes = push(bytes, c);
        i = i + 1;
    };
    if count = 0 { return push([], 0 - 1); };
    return bytes;
};

fn bytesToString(bytes: &List<Int>) -> String ~ {
    bs = [];
    for b in &bytes { if b >= 0 && b < 256 { bs = push(bs, toByte(b)); } else { bs = push(bs, toByte(0)); }; };
    return String { bytes: bs };
};


fn fileFailed<T>(dummy: T, ts: &List<Token>) -> Parsed<T> [{ }] [{ affirm return.pos = size(ts); affirm return.ok = false; }] ~ {
    return Parsed<T> { value: dummy, pos: size(ts), ok: false };
};

fn fileDone<T>(value: T, pos: Int) -> Parsed<T> [{ }] [{ affirm return.pos = pos; affirm return.ok = true; }] ~ {
    return Parsed<T> { value: value, pos: pos, ok: true };
};

fn fileNoNames() -> List<String> [{ }] [{ }] ~ {
    return [];
};

fn fileHexValue(c: Int) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return <= 15; }] ~ {
    if c >= 48 && c <= 57 { return c - 48; };
    if c >= 65 && c <= 70 { return c - 55; };
    return 0 - 1;
};

fn fileQuoted(line: &String, start: Int) -> Parsed<String> [{ affirm start >= 0; affirm start <= size(line.bytes); }] [{ affirm return.pos >= start; affirm return.pos <= size(line.bytes); }] ~ {
    bytes = [];
    i = start;
    while i < size(line.bytes) [{ affirm i >= start; affirm i <= size(line.bytes); }] shrinks size(line.bytes) - i {
        c = toInt(get(&line.bytes, i));
        if c = 34 {
            text = String { bytes: bytes };
            if !fileValidUtf8(text) { return Parsed<String> { value: "", pos: size(line.bytes), ok: false }; };
            return fileDone(text, i + 1);
        };
        if c = 92 {
            if size(line.bytes) - i < 4 { return Parsed<String> { value: "", pos: size(line.bytes), ok: false }; };
            h = fileHexValue(toInt(get(&line.bytes, i + 2)));
            l = fileHexValue(toInt(get(&line.bytes, i + 3)));
            if get(&line.bytes, i + 1) != toByte(120) || h < 0 || l < 0 { return Parsed<String> { value: "", pos: size(line.bytes), ok: false }; };
            bytes = push(bytes, toByte(16 * h + l));
            i = i + 4;
        } else {
            bytes = push(bytes, toByte(c));
            i = i + 1;
        };
    };
    return Parsed<String> { value: "", pos: size(line.bytes), ok: false };
};

fn fileParseInt(text: &String) -> Parsed<Int> [{ }] [{ }] ~ {
    n = size(text.bytes);
    negative = n > 0 && get(&text.bytes, 0) = toByte(45);
    i = 0;
    if negative { i = 1; };
    if i >= n { return Parsed<Int> { value: 0, pos: 0, ok: false }; };

    acc = 0;
    while i < n [{ affirm i >= 0; affirm i <= n; affirm acc <= 0; }] shrinks n - i {
        c = toInt(get(&text.bytes, i));
        d = c - 48;
        if d < 0 || d > 9 { return Parsed<Int> { value: 0, pos: 0, ok: false }; };
        if acc < 0 - 922337203685477580 || (acc = 0 - 922337203685477580 && d > 8) { return Parsed<Int> { value: 0, pos: 0, ok: false }; };
        acc = acc * 10 - d;
        i = i + 1;
    };
    if negative { return Parsed<Int> { value: acc, pos: 0, ok: true }; };
    if acc = 0 - 9223372036854775807 - 1 { return Parsed<Int> { value: 0, pos: 0, ok: false }; };
    return Parsed<Int> { value: 0 - acc, pos: 0, ok: true };
};

fn fileWordAt(ts: &List<Token>, pos: Int) -> Parsed<String> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos = pos + 1; }] ~ {
    t = get(ts, pos);
    if t.quoted { return Parsed<String> { value: "", pos: pos + 1, ok: false }; };
    return fileDone(clone(t.text), pos + 1);
};

fn fileNameAt(ts: &List<Token>, pos: Int) -> Parsed<String> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos = pos + 1; }] ~ {
    t = get(ts, pos);
    if !t.quoted { return Parsed<String> { value: "", pos: pos + 1, ok: false }; };
    return fileDone(clone(t.text), pos + 1);
};

fn fileIntAt(ts: &List<Token>, pos: Int) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos = pos + 1; }] ~ {
    w = fileWordAt(ts, pos);
    if !w.ok { return Parsed<Int> { value: 0, pos: pos + 1, ok: false }; };
    n = fileParseInt(&w.value);
    return Parsed<Int> { value: n.value, pos: pos + 1, ok: n.ok };
};

fn fileCountAt(ts: &List<Token>, pos: Int) -> Parsed<Int> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos = pos + 1; affirm return.value >= 0; affirm return.value <= size(ts); }] ~ {
    n = fileIntAt(ts, pos);
    if !n.ok || n.value < 0 || n.value > size(ts) - pos - 1 { return Parsed<Int> { value: 0, pos: pos + 1, ok: false }; };
    return Parsed<Int> { value: n.value, pos: pos + 1, ok: true };
};

fn fileNamesAt(ts: &List<Token>, pos: Int, n: Int) -> Parsed<List<String>> [{ affirm pos >= 0; affirm pos <= size(ts); affirm n >= 0; }] [{ affirm return.pos >= pos; affirm return.pos <= size(ts); }] ~ {
    names = fileNoNames();
    if n > size(ts) - pos { return fileFailed(fileNoNames(), ts); };
    p = pos;
    for i in 0..n [{ affirm p >= pos; affirm p <= size(ts); }] {
        if p >= size(ts) { return fileFailed(fileNoNames(), ts); };
        s = fileNameAt(ts, p);
        if !s.ok { return fileFailed(fileNoNames(), ts); };
        names = push(names, s.value);
        p = s.pos;
    };
    return fileDone(names, p);
};

fn fileSizeAt(ts: &List<Token>, pos: Int) -> Parsed<Size> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos > pos; affirm return.pos <= size(ts); }] ~ {
    bad = fileFailed(Size::SAny, ts);
    w = fileWordAt(ts, pos);
    if !w.ok { return bad; };
    next = w.pos;
    if w.value = "any" { return fileDone(Size::SAny, next); };
    if next >= size(ts) { return bad; };
    if w.value = "c" || w.value = "v" {
        n = fileIntAt(ts, next);
        if !n.ok || (w.value = "v" && n.value < 0) { return bad; };
        if w.value = "c" { return fileDone(Size::SConst { n: n.value }, n.pos); };
        return fileDone(Size::SVar { n: n.value }, n.pos);
    };
    if w.value = "p" {
        s = fileNameAt(ts, next);
        if !s.ok { return bad; };
        return fileDone(Size::SParam { name: s.value }, s.pos);
    };
    return bad;
};

fn fileCatStrings(a: &String, b: &String) -> String [{ }] [{ }] ~ {
    out = clone(a);
    for i in 0..size(b.bytes) {
        out = push(out, get(&b.bytes, i));
    };
    return out;
};

fn fileRenderSizeForName(s: &Size) -> String [{ }] [{ }] ~ {
    return match s {
        Size::SConst { n: n } => String::fromInt(n),
        Size::SAny => "?",
        Size::SParam { name: name } => clone(name),
        Size::SVar { n: n } => fileCatStrings("_", String::fromInt(n)),
    };
};

fn fileRenderTypeForName(t: &Type, fuel: Int) -> String [{ affirm fuel >= 0; }] [{ }] ~ {
    if fuel <= 0 { return ""; };
    r = "";
    match t {
        Type::TInt => { r = "Int"; },
        Type::TByte => { r = "Byte"; },
        Type::TBool => { r = "Bool"; },
        Type::TList { elem: e } => { r = fileCatStrings(fileCatStrings("List<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ">"); },
        Type::TBox { inner: e } => { r = fileCatStrings(fileCatStrings("Box<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ">"); },
        Type::TArray { elem: e, size: s } => { r = fileCatStrings(fileCatStrings(fileCatStrings(fileCatStrings("Array<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ", "), fileRenderSizeForName(s)), ">"); },
        Type::TRef { inner: e } => { r = fileCatStrings("&", fileRenderTypeForName(Box::unbox(e), fuel - 1)); },
        Type::TMutRef { inner: e } => { r = fileCatStrings("&mut ", fileRenderTypeForName(Box::unbox(e), fuel - 1)); },
        Type::TAddr { inner: e } => { r = fileCatStrings(fileCatStrings("Addr<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ">"); },
        Type::TBlock { inner: e } => { r = fileCatStrings(fileCatStrings("Block<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ">"); },
        Type::TUninit { inner: e } => { r = fileCatStrings(fileCatStrings("Uninit<", fileRenderTypeForName(Box::unbox(e), fuel - 1)), ">"); },
        Type::TWord { signed: signed, bits: bits } => {
            if signed { r = fileCatStrings("I", String::fromInt(bits)); } else { r = fileCatStrings("U", String::fromInt(bits)); };
        },
        Type::TParam { name: name } => { r = fileCatStrings("'", clone(name)); },
        Type::TForall { sizes: sizes, types: types, body: body } => { r = fileRenderTypeForName(Box::unbox(body), fuel - 1); },
        Type::TFn { args: args, ret: ret } => {
            parts = "fn(";
            for i in 0..size(args) {
                if i > 0 { parts = fileCatStrings(parts, ", "); };
                parts = fileCatStrings(parts, fileRenderTypeForName(get(args, i), fuel - 1));
            };
            r = fileCatStrings(fileCatStrings(parts, ") -> "), fileRenderTypeForName(Box::unbox(ret), fuel - 1));
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            if isBareLower(name) { r = fileCatStrings("`", clone(name)); } else { r = clone(name); };
        },
        Type::TVariant { name: name } => { r = clone(name); },
        Type::TVar { n: n } => { r = fileCatStrings("?", String::fromInt(n)); },
    };
    return r;
};

fn fileTypeAt(ts: &List<Token>, pos: Int) -> Parsed<Type> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ affirm return.pos > pos; affirm return.pos <= size(ts); }] ~ {
    bad = fileFailed(Type::TInt, ts);
    w = fileWordAt(ts, pos);
    if !w.ok { return bad; };
    next = w.pos;
    kw = w.value;
    if kw = "int" { return fileDone(Type::TInt, next); };
    if kw = "byte" { return fileDone(Type::TByte, next); };
    if kw = "bool" { return fileDone(Type::TBool, next); };
    if kw = "i8" { return fileDone(Type::TWord { signed: true, bits: 8 }, next); };
    if kw = "i16" { return fileDone(Type::TWord { signed: true, bits: 16 }, next); };
    if kw = "i32" { return fileDone(Type::TWord { signed: true, bits: 32 }, next); };
    if kw = "u16" { return fileDone(Type::TWord { signed: false, bits: 16 }, next); };
    if kw = "u32" { return fileDone(Type::TWord { signed: false, bits: 32 }, next); };
    if next >= size(ts) { return bad; };
    if kw = "list" || kw = "box" || kw = "ref" || kw = "mutref" || kw = "addr" || kw = "block" || kw = "uninit" {
        e = fileTypeAt(ts, next);
        if !e.ok { return bad; };
        if kw = "addr" { return fileDone(Type::TAddr { inner: Box::new(e.value) }, e.pos); };
        if kw = "list" { return fileDone(Type::TList { elem: Box::new(e.value) }, e.pos); };
        if kw = "box" { return fileDone(Type::TBox { inner: Box::new(e.value) }, e.pos); };
        if kw = "mutref" { return fileDone(Type::TMutRef { inner: Box::new(e.value) }, e.pos); };
        if kw = "block" { return fileDone(Type::TBlock { inner: Box::new(e.value) }, e.pos); };
        if kw = "uninit" { return fileDone(Type::TUninit { inner: Box::new(e.value) }, e.pos); };
        return fileDone(Type::TRef { inner: Box::new(e.value) }, e.pos);
    };
    if kw = "array" {
        e = fileTypeAt(ts, next);
        if !e.ok || e.pos >= size(ts) { return bad; };
        s = fileSizeAt(ts, e.pos);
        if !s.ok { return bad; };
        return fileDone(Type::TArray { elem: Box::new(e.value), size: s.value }, s.pos);
    };
    if kw = "named" {
        s = fileNameAt(ts, next);
        if !s.ok { return bad; };
        if s.pos >= size(ts) { return bad; };
        c = fileCountAt(ts, s.pos);
        if !c.ok { return bad; };
        if c.value = 1 && (s.value = "List" || s.value = "Box") {
            if c.pos >= size(ts) { return bad; };
            kind = fileWordAt(ts, c.pos);
            if kind.ok && kind.value = "type" {
                if kind.pos >= size(ts) { return bad; };
                element = fileTypeAt(ts, kind.pos);
                if !element.ok { return bad; };
                if s.value = "List" { return fileDone(Type::TList { elem: Box::new(element.value) }, element.pos); };
                return fileDone(Type::TBox { inner: Box::new(element.value) }, element.pos);
            };
        };
        parts = [];
        argTokens = [];
        p = c.pos;
        for i in 0..c.value [{ affirm p >= next; affirm p <= size(ts); }] {
            if p >= size(ts) { return bad; };
            argStart = p;
            w2 = fileWordAt(ts, p);
            if !w2.ok { return bad; };
            if w2.pos >= size(ts) { return bad; };
            if w2.value = "size" {
                sz = fileSizeAt(ts, w2.pos);
                if !sz.ok { return bad; };
                parts = push(parts, fileRenderSizeForName(&sz.value));
                p = sz.pos;
            } else {
                if w2.value != "type" { return bad; };
                a = fileTypeAt(ts, w2.pos);
                if !a.ok { return bad; };
                parts = push(parts, fileRenderTypeForName(&a.value, size(ts)));
                p = a.pos;
            };
            affirm argStart <= p;
            j = argStart;
            while j < p [{ affirm j >= argStart; affirm j <= p; affirm p <= size(ts); }] shrinks p - j {
                tok = clone(get(ts, j));
                if !tok.quoted {
                    number = fileParseInt(&tok.text);
                    if number.ok { tok = Token { quoted: false, text: String::fromInt(number.value) }; };
                };
                argTokens = push(argTokens, tok);
                j = j + 1;
            };
        };
        if c.value = 0 { return fileDone(Type::TNamed { name: clone(s.value), base: s.value, argc: 0, argTokens: argTokens }, p); };
        joined = "";
        for i in 0..size(parts) {
            if i > 0 { joined = fileCatStrings(joined, ", "); };
            joined = fileCatStrings(joined, get(parts, i));
        };
        return fileDone(Type::TNamed { name: fileCatStrings(fileCatStrings(fileCatStrings(&s.value, "<"), joined), ">"), base: s.value, argc: c.value, argTokens: argTokens }, p);
    };
    if kw = "variant" || kw = "param" {
        s = fileNameAt(ts, next);
        if !s.ok { return bad; };
        if kw = "variant" { return fileDone(Type::TVariant { name: s.value }, s.pos); };
        return fileDone(Type::TParam { name: s.value }, s.pos);
    };
    if kw = "var" {
        n = fileIntAt(ts, next);
        if !n.ok || n.value < 0 { return bad; };
        return fileDone(Type::TVar { n: n.value }, n.pos);
    };
    if kw = "fn" {
        c = fileCountAt(ts, next);
        if !c.ok { return bad; };
        args = [];
        p = c.pos;
        count = c.value;
        for i in 0..count [{ affirm p >= pos + 1; affirm p <= size(ts); }] {
            if p >= size(ts) { return bad; };
            a = fileTypeAt(ts, p);
            if !a.ok { return bad; };
            args = push(args, a.value);
            p = a.pos;
        };
        if p >= size(ts) { return bad; };
        r = fileTypeAt(ts, p);
        if !r.ok { return bad; };
        return fileDone(Type::TFn { args: args, ret: Box::new(r.value) }, r.pos);
    };
    if kw = "forall" {
        c1 = fileCountAt(ts, next);
        if !c1.ok { return bad; };
        sizes = fileNamesAt(ts, c1.pos, c1.value);
        if !sizes.ok || sizes.pos >= size(ts) { return bad; };
        c2 = fileCountAt(ts, sizes.pos);
        if !c2.ok { return bad; };
        types = fileNamesAt(ts, c2.pos, c2.value);
        if !types.ok || types.pos >= size(ts) { return bad; };
        body = fileTypeAt(ts, types.pos);
        if !body.ok { return bad; };
        return fileDone(Type::TForall { sizes: sizes.value, types: types.value, body: Box::new(body.value) }, body.pos);
    };
    return bad;
};

fn fileIsWord(ts: &List<Token>, pos: Int, w: &String) -> Bool [{ }] [{ }] ~ {
    if pos < 0 || pos >= size(ts) { return false; };
    t = get(ts, pos);
    return !t.quoted && t.text = w;
};

fn fileBoolAt(ts: &List<Token>, pos: Int) -> Parsed<Bool> [{ affirm pos >= 0; affirm pos < size(ts); }] [{ }] ~ {
    w = fileWordAt(ts, pos);
    if w.ok && w.value = "true" { return fileDone(true, w.pos); };
    if w.ok && w.value = "false" { return fileDone(false, w.pos); };
    return Parsed<Bool> { value: false, pos: w.pos, ok: false };
};

fn fileValidUtf8(text: &String) -> Bool ~ {
    i = 0;
    while i < size(text.bytes) [{ affirm i >= 0; affirm i <= size(text.bytes); }] ~ {
        c = toInt(get(&text.bytes, i));
        if c < 128 { i = i + 1; } else {
            width = 0;
            lo = 128;
            hi = 191;
            if c >= 194 && c <= 223 { width = 2; };
            if c >= 224 && c <= 239 { width = 3; };
            if c >= 240 && c <= 244 { width = 4; };
            if c = 224 { lo = 160; };
            if c = 237 { hi = 159; };
            if c = 240 { lo = 144; };
            if c = 244 { hi = 143; };
            if width < 2 || width > 4 || width > size(text.bytes) - i { return false; };
            second = toInt(get(&text.bytes, i + 1));
            if second < lo || second > hi { return false; };
            j = 2;
            while j < width [{ affirm i >= 0; affirm width >= 2; affirm width <= 4; affirm width <= size(text.bytes) - i; affirm j >= 2; affirm j <= width; }] ~ {
                b = toInt(get(&text.bytes, i + j));
                if b < 128 || b > 191 { return false; };
                j = j + 1;
            };
            i = i + width;
        };
    };
    return true;
};

fn fileAlpha(c: Int) -> Bool ~ {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
};

fn fileValidWord(text: &String) -> Bool ~ {
    if size(text.bytes) = 0 { return false; };
    first = toInt(get(&text.bytes, 0));
    if first = 45 || (first >= 48 && first <= 57) { return fileParseInt(text).ok; };
    if !fileAlpha(first) { return false; };
    for c in &text.bytes {
        b = toInt(c);
        if !fileAlpha(b) && !(b >= 48 && b <= 57) { return false; };
    };
    return true;
};

fn fileTokenize(line: &String) -> Parsed<List<Token>> ~ {
    tokens = [];
    for b in &line.bytes { if toInt(b) < 32 || toInt(b) > 126 { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; }; };
    i = 0;
    while i < size(line.bytes) [{ affirm i >= 0; affirm i <= size(line.bytes); }] ~ {
        c = toInt(get(&line.bytes, i));
        if c = 32 { i = i + 1; } else {
            if c = 34 {
                q = fileQuoted(line, i + 1);
                if !q.ok { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; };
                if q.pos < size(line.bytes) && get(&line.bytes, q.pos) != toByte(32) { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; };
                tokens = push(tokens, Token { quoted: true, text: q.value });
                i = q.pos;
            } else {
                j = i + 1;
                while j < size(line.bytes) && get(&line.bytes, j) != toByte(32) [{ affirm i >= 0; affirm j >= i + 1; affirm j <= size(line.bytes); }] ~ { j = j + 1; };
                text = line.slice(i, j);
                if !fileValidWord(text) { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; };
                tokens = push(tokens, Token { quoted: false, text: text });
                i = j;
            };
        };
    };
    return fileDone(tokens, size(line.bytes));
};

fn fileReadLine() -> Parsed<String> ~ {
    bytes = [];
    while size(bytes) <= 1000000 ~ {
        b = readByte();
        if b < 0 { return Parsed<String> { value: "", pos: 0, ok: false }; };
        if b = 10 {
            if size(bytes) = 0 { return Parsed<String> { value: "", pos: 0, ok: false }; };
            return fileDone(String { bytes: bytes }, 0);
        };
        if b < 32 || b > 126 || size(bytes) = 1000000 { return Parsed<String> { value: "", pos: 0, ok: false }; };
        bytes = push(bytes, toByte(b));
    };
    return Parsed<String> { value: "", pos: 0, ok: false };
};

fn fileReadLiteral(expected: &String) -> Bool ~ {
    line = fileReadLine();
    return line.ok && line.value = expected;
};

fn fileReadRecord(tag: &String) -> Parsed<List<Token>> ~ {
    line = fileReadLine();
    if !line.ok { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; };
    tokens = fileTokenize(&line.value);
    if !tokens.ok || !fileIsWord(&tokens.value, 0, tag) { return Parsed<List<Token>> { value: [], pos: 0, ok: false }; };
    return tokens;
};

fn fileReadSection(tag: &String) -> Parsed<Int> [{ }] [{ affirm return.value >= 0; }] ~ {
    record = fileReadRecord(tag);
    if !record.ok || size(record.value) != 2 { return Parsed<Int> { value: 0, pos: 0, ok: false }; };
    n = fileIntAt(&record.value, 1);
    if !n.ok || n.value < 0 { return Parsed<Int> { value: 0, pos: 0, ok: false }; };
    return n;
};

fn fileNameListAt(ts: &List<Token>, pos: Int) -> Parsed<List<String>> ~ {
    if pos < 0 || pos >= size(ts) { return fileFailed(fileNoNames(), ts); };
    n = fileCountAt(ts, pos);
    if !n.ok { return fileFailed(fileNoNames(), ts); };
    return fileNamesAt(ts, n.pos, n.value);
};

fn fileBadDecls() -> Parsed<St> ~ {
    return Parsed<St> { value: newSt(), pos: 0, ok: false };
};

fn readFileDecls() -> Parsed<St> ~ {
    if !fileReadLiteral("decls") { return fileBadDecls(); };
    st = newSt();
    n = fileReadSection("ctors");
    if !n.ok { return fileBadDecls(); };
    for i in 0..n.value {
        rec = fileReadRecord("ctor");
        if !rec.ok || size(rec.value) < 3 { return fileBadDecls(); };
        key = fileNameAt(&rec.value, 1);
        fields = fileNameListAt(&rec.value, 2);
        if !key.ok || !fields.ok || fields.pos != size(rec.value) { return fileBadDecls(); };
        for entry in st.ctors { if entry.name = key.value { return fileBadDecls(); }; };
        st = St { ctors: push(st.ctors, CtorInfo { name: key.value, fields: fields.value, active: true }), ..st };
    };
    n = fileReadSection("types");
    if !n.ok { return fileBadDecls(); };
    for i in 0..n.value {
        rec = fileReadRecord("type");
        if !rec.ok || size(rec.value) < 3 { return fileBadDecls(); };
        key = fileNameAt(&rec.value, 1);
        variants = fileNameListAt(&rec.value, 2);
        if !key.ok || !variants.ok || variants.pos != size(rec.value) { return fileBadDecls(); };
        for entry in st.types { if entry.name = key.value { return fileBadDecls(); }; };
        st = St { types: push(st.types, TypeInfo { name: key.value, variants: variants.value, active: true }), ..st };
    };
    rec = fileReadRecord("self");
    if !rec.ok || size(rec.value) < 2 { return fileBadDecls(); };
    if fileIsWord(&rec.value, 1, "none") {
        if size(rec.value) != 2 { return fileBadDecls(); };
    } else {
        if !fileIsWord(&rec.value, 1, "some") || size(rec.value) != 3 { return fileBadDecls(); };
        name = fileNameAt(&rec.value, 2);
        if !name.ok { return fileBadDecls(); };
        st = St { selfName: name.value, hasSelf: true, ..st };
    };
    rec = fileReadRecord("selfType");
    if !rec.ok || size(rec.value) < 2 { return fileBadDecls(); };
    if fileIsWord(&rec.value, 1, "none") {
        if size(rec.value) != 2 { return fileBadDecls(); };
    } else {
        if !fileIsWord(&rec.value, 1, "some") || size(rec.value) < 3 { return fileBadDecls(); };
        ty = fileTypeAt(&rec.value, 2);
        if !ty.ok || ty.pos != size(rec.value) { return fileBadDecls(); };
        st = St { selfTy: ty.value, hasSelfTy: true, ..st };
    };
    rec = fileReadRecord("typeParams");
    if !rec.ok { return fileBadDecls(); };
    params = fileNameListAt(&rec.value, 1);
    if !params.ok || params.pos != size(rec.value) { return fileBadDecls(); };
    st = St { typeParams: params.value, ..st };
    n = fileReadSection("generics");
    if !n.ok { return fileBadDecls(); };
    for i in 0..n.value {
        rec = fileReadRecord("generic");
        if !rec.ok || size(rec.value) < 3 { return fileBadDecls(); };
        key = fileNameAt(&rec.value, 1);
        params = fileNameListAt(&rec.value, 2);
        if !key.ok || !params.ok || params.pos != size(rec.value) { return fileBadDecls(); };
        for entry in st.generics { if entry.name = key.value { return fileBadDecls(); }; };
        st = St { generics: push(st.generics, GenInfo { name: key.value, params: params.value, active: true }), ..st };
    };
    rec = fileReadRecord("implParams");
    if !rec.ok { return fileBadDecls(); };
    params = fileNameListAt(&rec.value, 1);
    if !params.ok || params.pos != size(rec.value) { return fileBadDecls(); };
    st = St { implParams: params.value, ..st };
    rec = fileReadRecord("ownClone");
    if !rec.ok || size(rec.value) != 2 { return fileBadDecls(); };
    b = fileBoolAt(&rec.value, 1);
    if !b.ok { return fileBadDecls(); };
    st = St { ownClone: b.value, ..st };
    rec = fileReadRecord("locate");
    if !rec.ok || size(rec.value) != 2 { return fileBadDecls(); };
    b = fileBoolAt(&rec.value, 1);
    if !b.ok { return fileBadDecls(); };
    st = St { locate: b.value, ..st };
    n = fileReadSection("fieldTypes");
    if !n.ok { return fileBadDecls(); };
    for i in 0..n.value {
        rec = fileReadRecord("fields");
        if !rec.ok || size(rec.value) < 3 { return fileBadDecls(); };
        key = fileNameAt(&rec.value, 1);
        count = fileCountAt(&rec.value, 2);
        if !key.ok || !count.ok || count.value > (size(rec.value) - count.pos) / 2 { return fileBadDecls(); };
        fields = [];
        pos = count.pos;
        for j in 0..count.value [{ affirm pos >= count.pos; affirm pos <= size(rec.value); }] {
            if size(rec.value) - pos < 2 { return fileBadDecls(); };
            name = fileNameAt(&rec.value, pos);
            ty = fileTypeAt(&rec.value, pos + 1);
            if !name.ok || !ty.ok { return fileBadDecls(); };
            fields = push(fields, FieldInfo { name: name.value, ty: ty.value });
            pos = ty.pos;
        };
        if pos != size(rec.value) { return fileBadDecls(); };
        for entry in st.fieldsOf { if entry.name = key.value { return fileBadDecls(); }; };
        st = St { fieldsOf: push(st.fieldsOf, FieldsInfo { name: key.value, fields: fields }), ..st };
    };
    if !fileReadLiteral("endDecls") { return fileBadDecls(); };
    return fileDone(st, 0);
};

fn fileNameLess(a: &String, b: &String) -> Bool ~ {
    i = 0;
    while i < size(a.bytes) && i < size(b.bytes) [{ affirm i >= 0; affirm i <= size(a.bytes); affirm i <= size(b.bytes); }] ~ {
        x = toInt(get(&a.bytes, i));
        y = toInt(get(&b.bytes, i));
        if x != y { return x < y; };
        i = i + 1;
    };
    return size(a.bytes) < size(b.bytes);
};

fn fileOrderLess(keys: &List<String>, order: &List<Int>, p: Int) -> Bool ~ {
    if p <= 0 || p >= size(order) { return false; };
    a = get(order, p);
    b = get(order, p - 1);
    if a < 0 || a >= size(keys) || b < 0 || b >= size(keys) { return false; };
    return fileNameLess(get(keys, a), get(keys, b));
};

fn fileSortedLatest(keys: &List<String>, active: &List<Bool>) -> List<Int> ~ {
    order = [];
    if size(keys) != size(active) { return order; };
    for i in 0..size(keys) [{ affirm size(keys) = size(active); }] {
        latest = get(active, i);
        j = i + 1;
        while latest && j < size(keys) [{ affirm i >= 0; affirm i < size(keys); affirm j >= i + 1; affirm j <= size(keys); }] ~ {
            if get(keys, i) = get(keys, j) { latest = false; };
            j = j + 1;
        };
        if latest {
            order = push(order, i);
            p = size(order) - 1;
            while p > 0 && fileOrderLess(keys, order, p) [{ affirm p >= 0; affirm p < size(order); }] ~ {
                prev = get(order, p - 1);
                order = set(order, p - 1, get(order, p));
                order = set(order, p, prev);
                p = p - 1;
            };
        };
    };
    return order;
};

fn printFileDecls(st: &St) -> Int ~ {
    n = "decls\n".print();
    keys = [];
    active = [];
    for entry in &st.ctors { keys = push(keys, clone(entry.name)); active = push(active, entry.active); };
    order = fileSortedLatest(keys, active);
    n = n + "ctors".print() + printInt(size(order)) + newLine();
    for i in order {
        if i < 0 || i >= size(st.ctors) { return 0; };
        entry = get(&st.ctors, i);
        n = n + "ctor".print() + printName(&entry.name) + printNames(&entry.fields) + newLine();
    };
    keys = [];
    active = [];
    for entry in &st.types { keys = push(keys, clone(entry.name)); active = push(active, entry.active); };
    order = fileSortedLatest(keys, active);
    n = n + "types".print() + printInt(size(order)) + newLine();
    for i in order {
        if i < 0 || i >= size(st.types) { return 0; };
        entry = get(&st.types, i);
        n = n + "type".print() + printName(&entry.name) + printNames(&entry.variants) + newLine();
    };
    n = n + "self".print();
    if st.hasSelf { n = n + " some".print() + printName(&st.selfName); } else { n = n + " none".print(); };
    n = n + newLine() + "selfType".print();
    if st.hasSelfTy { n = n + " some".print() + printType(&st.selfTy); } else { n = n + " none".print(); };
    n = n + newLine() + "typeParams".print() + printNames(&st.typeParams) + newLine();
    keys = [];
    active = [];
    for entry in &st.generics { keys = push(keys, clone(entry.name)); active = push(active, entry.active); };
    order = fileSortedLatest(keys, active);
    n = n + "generics".print() + printInt(size(order)) + newLine();
    for i in order {
        if i < 0 || i >= size(st.generics) { return 0; };
        entry = get(&st.generics, i);
        n = n + "generic".print() + printName(&entry.name) + printNames(&entry.params) + newLine();
    };
    n = n + "implParams".print() + printNames(&st.implParams) + newLine();
    n = n + "ownClone".print() + printBool(st.ownClone) + newLine();
    n = n + "locate".print() + printBool(st.locate) + newLine();
    keys = [];
    active = [];
    for entry in &st.fieldsOf { keys = push(keys, clone(entry.name)); active = push(active, true); };
    order = fileSortedLatest(keys, active);
    n = n + "fieldTypes".print() + printInt(size(order)) + newLine();
    for i in order {
        if i < 0 || i >= size(st.fieldsOf) { return 0; };
        entry = get(&st.fieldsOf, i);
        n = n + "fields".print() + printName(&entry.name) + printInt(size(entry.fields));
        for field in entry.fields { n = n + printName(&field.name) + printType(&field.ty); };
        n = n + newLine();
    };
    return n + "endDecls\n".print();
};

struct FileImport { path: List<String>, hasAlias: Bool, alias: String, hasNames: Bool, names: List<String>, line: Int, column: Int };

fn fileHeadDetailed(sourceText: &Input, st: St) -> Res<List<FileImport>> ~ {
    s = skipWs(sourceText, st);
    imports = [];
    loop = true;
    while loop ~ {
        if atImportKeyword(sourceText, s) {
            lc = inputLineCol(sourceText, s.pos);
            s = St { pos: s.pos + 6, ..s };
            s = skipWs(sourceText, s);
            p = namePathOf(sourceText, s);
            Res { st: pathState, v: pathValue, ok: pathOk } = p;
            if !pathOk { return Res<List<FileImport>> { st: pathState, v: [], ok: false }; };
            s = skipWs(sourceText, pathState);
            hasAlias = false;
            alias = "";
            k = eatKeyword(sourceText, s, "as");
            Res { st: keywordState, v: keywordValue, ok: keywordOk } = k;
            s = keywordState;
            if keywordValue {
                s = skipWs(sourceText, s);
                a = parseVariable(sourceText, s);
                Res { st: aliasState, v: aliasValue, ok: aliasOk } = a;
                if !aliasOk { return Res<List<FileImport>> { st: aliasState, v: [], ok: false }; };
                alias = aliasValue;
                hasAlias = true;
                s = skipWs(sourceText, aliasState);
            };
            hasNames = false;
            names = [];
            if byteAt(sourceText, s, s.pos) = 123 {
                hasNames = true;
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
                if byteAt(sourceText, s, s.pos) = 125 { return fail( s, imports, "an import name list must not be empty"); };
                namesLoop = true;
                while namesLoop ~ {
                    w = parseVariable(sourceText, s);
                    Res { st: nameState, v: nameValue, ok: nameOk } = w;
                    if !nameOk { return Res<List<FileImport>> { st: nameState, v: [], ok: false }; };
                    names = push(names, nameValue);
                    s = skipWs(sourceText, nameState);
                    if byteAt(sourceText, s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(sourceText, s); } else { namesLoop = false; };
                };
                if byteAt(sourceText, s, s.pos) != 125 { return fail( s, imports, "expected }"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(sourceText, s);
            };
            if byteAt(sourceText, s, s.pos) != 59 { return fail( s, imports, "expected ;"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            imp = FileImport { path: pathValue, hasAlias: hasAlias, alias: alias, hasNames: hasNames, names: names, line: get(lc, 0), column: get(lc, 1) };
            imports = push(imports, imp);
        } else { loop = false; };
    };
    return ok( s, imports);
};

fn printFileImports(imports: &List<FileImport>) -> Int ~ {
    count = "imports".print() + printInt(size(imports)) + newLine();
    for imp in &imports {
        count = count + "import".print() + printInt(imp.line) + printInt(imp.column) + printNames(&imp.path);
        if imp.hasAlias { count = count + " some".print() + printName(&imp.alias); } else { count = count + " none".print(); };
        if imp.hasNames { count = count + " some".print() + printNames(&imp.names); } else { count = count + " none".print(); };
        count = count + newLine();
    };
    return count;
};

fn scanMetadataTail(sourceText: &Input, st: St, groupOnly: Bool) -> Res<Bool> ~ {
    s = st;
    depth = 0;
    if groupOnly { depth = 1; s = St { pos: s.pos + 1, ..s }; };
    quotedText = false;
    scanning = true;
    while scanning && !atEnd(sourceText, s) ~ {
        c = byteAt(sourceText, s, s.pos);
        if quotedText {
            if c = 92 {
                s = St { pos: s.pos + 1, ..s };
                if atEnd(sourceText, s) { return fail(s, false, "expected an escaped character"); };
            } else { if c = 34 { quotedText = false; }; };
            s = St { pos: s.pos + 1, ..s };
        } else {
            oldPos = s.pos;
            s = skipWs(sourceText, s);
            if s.pos = oldPos {
                if c = 59 && depth = 0 { scanning = false; }
                else {
                    if c = 34 { quotedText = true; };
                    if c = 123 { depth = depth + 1; };
                    if c = 125 && depth > 0 {
                        depth = depth - 1;
                        if groupOnly && depth = 0 { scanning = false; };
                    };
                    s = St { pos: s.pos + 1, ..s };
                };
            };
        };
    };
    if quotedText { return fail(s, false, "expected closing quote"); };
    if depth > 0 { return fail(s, false, "expected }"); };
    return ok(s, true);
};

fn metadataHeaderStart(sourceText: &Input, st: St) -> St ~ {
    s = st;
    if keywordAt(sourceText, s, "linear") { s = St { pos: s.pos + 6, ..s }; s = skipWs(sourceText, s); };
    return s;
};

fn metadataEnumHeader(sourceText: &Input, st: St) -> Res<List<String>> ~ {
    s = metadataHeaderStart(sourceText, st);
    if !keywordAt(sourceText, s, "enum") { return fail(s, [], "expected enum"); };
    s = St { pos: s.pos + 4, ..s };
    owner = parseVariable(sourceText, skipWs(sourceText, s));
    Res { st: ownerState, v: ownerName, ok: ownerOk } = owner;
    if !ownerOk { return Res<List<String>> { st: ownerState, v: [], ok: false }; };
    s = skipWs(sourceText, ownerState);
    if byteAt(sourceText, s, s.pos) != 123 { return fail(s, [], "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(sourceText, s);
    names = push([], clone(ownerName));
    variantsLoop = byteAt(sourceText, s, s.pos) != 125;
    while variantsLoop ~ {
        variant = parseVariable(sourceText, s);
        Res { st: variantState, v: variantName, ok: variantOk } = variant;
        if !variantOk { return Res<List<String>> { st: variantState, v: [], ok: false }; };
        names = push(names, cat3(ownerName, "::", variantName));
        s = skipWs(sourceText, variantState);
        if byteAt(sourceText, s, s.pos) = 123 {
            group = scanMetadataTail(sourceText, s, true);
            Res { st: groupState, v: groupValue, ok: groupOk } = group;
            if !groupOk { return Res<List<String>> { st: groupState, v: [], ok: false }; };
            s = skipWs(sourceText, groupState);
        };
        if byteAt(sourceText, s, s.pos) = 44 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(sourceText, s);
            variantsLoop = byteAt(sourceText, s, s.pos) != 125;
        } else { variantsLoop = false; };
    };
    if byteAt(sourceText, s, s.pos) != 125 { return fail(s, [], "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    return ok(s, names);
};

fn metadataNamedHeader(sourceText: &Input, st: St) -> Res<List<String>> ~ {
    s = metadataHeaderStart(sourceText, st);
    if keywordAt(sourceText, s, "extern") || keywordAt(sourceText, s, "builtin") {
        width = 6;
        if keywordAt(sourceText, s, "builtin") { width = 7; };
        s = St { pos: s.pos + width, ..s };
        s = skipWs(sourceText, s);
        if !keywordAt(sourceText, s, "fn") { return fail(s, [], "expected fn"); };
        s = St { pos: s.pos + 2, ..s };
    } else {
        width = 0;
        if keywordAt(sourceText, s, "fn") { width = 2; };
        if keywordAt(sourceText, s, "struct") { width = 6; };
        if keywordAt(sourceText, s, "trait") { width = 5; };
        if keywordAt(sourceText, s, "axiom") { width = 5; };
        if keywordAt(sourceText, s, "proof") { width = 5; };
        if width = 0 { return fail(s, [], "expected a named declaration"); };
        s = St { pos: s.pos + width, ..s };
    };
    named = parseVariable(sourceText, skipWs(sourceText, s));
    Res { st: namedState, v: name, ok: namedOk } = named;
    if !namedOk { return Res<List<String>> { st: namedState, v: [], ok: false }; };
    return ok(namedState, push([], name));
};

fn metadataDeclarationNames(sourceText: &Input, st: St) -> Res<List<String>> ~ {
    s = skipWs(sourceText, st);
    names = [];
    while !atEnd(sourceText, s) ~ {
        header = metadataEnumHeader(sourceText, clone(s));
        Res { st: headerState, v: headerNames, ok: headerOk } = header;
        if !headerOk {
            named = metadataNamedHeader(sourceText, clone(s));
            Res { st: namedState, v: namedNames, ok: namedOk } = named;
            headerState = namedState;
            headerNames = namedNames;
            headerOk = namedOk;
        };
        if headerOk {
            s = headerState;
            for name in headerNames { names = push(names, clone(name)); };
        };
        tail = scanMetadataTail(sourceText, s, false);
        Res { st: tailState, v: tailValue, ok: tailOk } = tail;
        if !tailOk { return Res<List<String>> { st: tailState, v: [], ok: false }; };
        s = tailState;
        if byteAt(sourceText, s, s.pos) = 59 { s = St { pos: s.pos + 1, ..s }; };
        s = skipWs(sourceText, s);
    };
    return ok(s, names);
};

fn fileProtocolByte(text: &String, index: Int) -> Int ~ {
    if index < 0 || index >= size(text.bytes) { return 0 - 1; };
    return toInt(get(&text.bytes, index));
};

fn fileProtocolContinuation(b: Int) -> Bool ~ { return b >= 128 && b <= 191; };

fn fileProtocolUtf8(text: &String) -> Bool ~ {
    i = 0;
    while i < size(text.bytes) ~ {
        a = fileProtocolByte(text, i);
        width = 1;
        if a < 128 { width = 1; }
        else {
            b = fileProtocolByte(text, i + 1);
            if a >= 194 && a <= 223 {
                if !fileProtocolContinuation(b) { return false; };
                width = 2;
            } else {
                c = fileProtocolByte(text, i + 2);
                if a >= 224 && a <= 239 {
                    if !fileProtocolContinuation(b) || !fileProtocolContinuation(c) { return false; };
                    if a = 224 && b < 160 { return false; };
                    if a = 237 && b >= 160 { return false; };
                    width = 3;
                } else {
                    d = fileProtocolByte(text, i + 3);
                    if a < 240 || a > 244 || !fileProtocolContinuation(b) || !fileProtocolContinuation(c) || !fileProtocolContinuation(d) { return false; };
                    if a = 240 && b < 144 { return false; };
                    if a = 244 && b >= 144 { return false; };
                    width = 4;
                };
            };
        };
        i = i + width;
    };
    return true;
};

fn fileParseError(input: &Input, st: &St) -> Int ~ {
    lc = inputLineCol(input, st.errPos);
    reason = clone(st.err);
    if size(reason.bytes) = 0 { reason = "parse error"; };
    msg = cat3(cat3("line ", String::fromInt(get(lc, 0)), ":"), String::fromInt(get(lc, 1)), ": ");
    msg = catStrings(catStrings(msg, reason), "\n");
    return msg.printError();
};

fn runFileRequest(mode: Int) -> Int ~ {
    seeded = readFileDecls();
    Parsed { value: initial, pos: ignored, ok: seedOk } = seeded;
    if !seedOk { "tersus parser: invalid declaration seed\n".printError(); return 1; };
    sourceRecord = fileReadRecord("source");
    Parsed { value: sourceTokens, pos: ignoredSourcePos, ok: sourceRecordOk } = sourceRecord;
    if !sourceRecordOk || size(sourceTokens) != 2 { "tersus parser: bad source record\n".printError(); return 1; };
    counted = fileIntAt(sourceTokens, 1);
    Parsed { value: count, pos: ignoredCountPos, ok: countOk } = counted;
    if !countOk || count < 0 { "tersus parser: bad source count\n".printError(); return 1; };
    raw = readSegmentBytes(count);
    if count > 0 && size(raw) != count { "tersus parser: short source\n".printError(); return 1; };
    if count = 0 { raw = []; };
    text = bytesToString(raw);
    if readByte() >= 0 { "tersus parser: trailing input\n".printError(); return 1; };
    if !fileProtocolUtf8(text) { "tersus parser: invalid source UTF8\n".printError(); return 1; };
    input = newInput(text);
    if mode = 2 {
        scanned = metadataDeclarationNames(input, initial);
        Res { st: scannedState, v: names, ok: scannedOk } = scanned;
        if !scannedOk { fileParseError(input, scannedState); return 1; };
        "tersus-names 1\n".print();
        "names".print(); printInt(size(names)); newLine();
        for name in names { "name".print(); printName(name); newLine(); };
        return 0;
    };
    state = skipWs(input, initial);
    imports = [];
    body = [];
    if mode <= 1 {
        head = fileHeadDetailed(input, state);
        Res { st: headState, v: foundImports, ok: headOk } = head;
        if !headOk { fileParseError(input, headState); return 1; };
        if mode = 1 {
            "tersus-imports 1\n".print();
            printFileImports(foundImports);
            return 0;
        };
        imports = foundImports;
        parsed = statementBlock(input, headState);
        Res { st: parsedState, v: foundBody, ok: parsedOk } = parsed;
        if !parsedOk { fileParseError(input, parsedState); return 1; };
        state = parsedState;
        body = foundBody;
    } else if mode = 3 {
        value = expression(input, state);
        Res { st: valueState, v: valueId, ok: valueOk } = value;
        if !valueOk { fileParseError(input, valueState); return 1; };
        wrapped = stmtNode(valueState, AstStatement::Return { e: valueId });
        Res { st: wrappedState, v: wrappedId, ok: wrappedOk } = wrapped;
        if !wrappedOk { "tersus parser: internal arena failure\n".printError(); return 1; };
        state = wrappedState;
        body = push(body, wrappedId);
    } else {
        parsed = statement(input, state);
        Res { st: parsedState, v: statementId, ok: parsedOk } = parsed;
        if !parsedOk { fileParseError(input, parsedState); return 1; };
        state = parsedState;
        body = push(body, statementId);
    };
    s = skipWs(input, state);
    if !atEnd(input, s) {
        ended = fail(s, 0, "expected the end of the input");
        Res { st: endState, v: ignoredEndValue, ok: ignoredEndOk } = ended;
        fileParseError(input, endState);
        return 1;
    };
    root = statementsList( s, body);
    Res { st: finalState, v: rootId, ok: rootOk } = root;
    if !rootOk { "tersus parser: internal arena failure\n".printError(); return 1; };
    "tersus-file 1\n".print();
    printFileImports(imports);
    printFileDecls(finalState);
    "ast\n".print();
    printAst(reorderArena(&finalState.nodes, rootId, "parsed"));
    return 0;
};

headerLine = String::readLine(64);
if headerLine = "tersus-file-parse 1" || headerLine = "tersus-import-prefix 1" || headerLine = "tersus-declaration-names 1" {
    mode = 0;
    if headerLine = "tersus-import-prefix 1" { mode = 1; };
    if headerLine = "tersus-declaration-names 1" { mode = 2; };
    fileStatus = runFileRequest(mode);
    if fileStatus != 0 { return 1; };
} else if headerLine = "tersus-fragment-parse 1" {
    fragmentRecord = fileReadRecord("fragment");
    Parsed { value: fragmentTokens, pos: ignoredFragmentPos, ok: fragmentOk } = fragmentRecord;
    if !fragmentOk || size(fragmentTokens) != 2 { "tersus parser: bad fragment record\n".printError(); return 1; };
    kind = fileWordAt(fragmentTokens, 1);
    if !kind.ok { "tersus parser: unknown fragment kind\n".printError(); return 1; };
    mode = 0;
    if kind.value = "expression" { mode = 3; }
    else if kind.value = "statement" { mode = 4; }
    else { "tersus parser: unknown fragment kind\n".printError(); return 1; };
    fragmentStatus = runFileRequest(mode);
    if fragmentStatus != 0 { return 1; };
} else {
if headerLine != "tersus-parse 1" { "tersus parser: bad header, expected tersus-parse 1\n".printError(); return 1; };
metaLine = String::readLine(64);
meta = splitTwoSpaces(metaLine);
if size(meta) != 2 { "tersus parser: bad segment line\n".printError(); return 1; };
locatingFlag = parseNonNegative(get(meta, 0));
segmentCount = parseNonNegative(get(meta, 1));
if locatingFlag < 0 || locatingFlag > 1 || segmentCount < 0 { "tersus parser: bad segment line\n".printError(); return 1; };
sourceText = newInput("");
state = newSt();
allStatements = [];
parseFailed = false;
failMessage = "";
failSource = "";
failPos = 0;
si = 0;
while si < segmentCount && !parseFailed ~ {
    countLine = String::readLine(64);
    byteCount = parseNonNegative(countLine);
    if byteCount < 0 { parseFailed = true; failMessage = "bad byte count"; }
    else {
        seg = readSegmentBytes(byteCount);
        if byteCount > 0 && size(seg) != byteCount { parseFailed = true; failMessage = "short input"; }
        else {
            if byteCount = 0 && size(seg) = 1 && get(seg, 0) = 0 - 1 { seg = []; };
            source = bytesToString(seg);
            sourceText = newInput(source);
            state = St { pos: 0, ..state };
            state = St { locate: locatingFlag = 1 && si = segmentCount - 1, ..state };
            state = St { err: "", ..state };
            parsed = parseSegment(sourceText, state, si = segmentCount - 1); Res { st: resultPartsparsedState, v: resultPartsparsedValue, ok: resultPartsparsedOk } = parsed;
            if !resultPartsparsedOk {
                parseFailed = true;
                failMessage = resultPartsparsedState.err;
                if size(failMessage.bytes) = 0 { failMessage = "parse error"; };
                failSource = clone(sourceText.text);
                failPos = resultPartsparsedState.errPos;
                state = resultPartsparsedState;
            } else {
                s = skipWs(sourceText, resultPartsparsedState);
                if !atEnd(sourceText, s) {
                    ended = fail(s, 0, "expected the end of the input");
                    Res { st: endState, v: ignoredEndValue, ok: ignoredEndOk } = ended;
                    parseFailed = true;
                    failMessage = clone(endState.err);
                    failSource = clone(sourceText.text);
                    failPos = endState.errPos;
                    state = endState;
                } else {
                    state = s;
                    for x in resultPartsparsedValue { allStatements = push(allStatements, x); };
                };
            };
        };
    };
    si = si + 1;
};
if parseFailed {
    if hasTextPrefix(failMessage, "imports are not linked yet: ") {
        msg = catStrings(clone(failMessage), "\n");
        msg.printError();
        return 1;
    };
    lc = lineCol(failSource, failPos);
    msg = cat3(cat3("line ", String::fromInt(get(lc, 0)), ":"), String::fromInt(get(lc, 1)), ": ");
    msg = catStrings(catStrings(msg, failMessage), "\n");
    msg.printError();
    return 1;
};
rootResult = statementsList( state, allStatements); Res { st: resultPartsrootResultState, v: resultPartsrootResultValue, ok: resultPartsrootResultOk } = rootResult;
if !resultPartsrootResultOk { "tersus parser: internal arena failure\n".printError(); return 1; };
written = printAst(reorderArena(&resultPartsrootResultState.nodes, resultPartsrootResultValue, "parsed"));
};
