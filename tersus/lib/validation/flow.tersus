import validation::execution { assumeBooleanFact, assumeRelation, checkNear, contextSizes, entailsIn, executeIndexed, goalInSlices, indexTo, localGoal, maxScopeDepth, quietStep };
import validation::joins { commonContext, emptyContext, leastTermInUse, linkAppend, linkedItems, mergeArrivals, noLinks };
import validation::loopInference { inferLoopCandidateGoals, loopMentions };
import validation::model { Arrival, CandidateSteps, EqualityFact, ExecutionBlock, ExecutionEnd, ExecutionFlowResult, ExecutionResult, ExecutionState, ExecutionStep, HullLinks, InferGoal, IntegerLookup, LoopEntryTerms, LoopFrame, LoopIteration, LoopRound, LoopSplit, LoopTest, StepsRun, SweepOrder, SweepResult, TrailEntry, Trunk, TrunkAnswer, TrunkRun, ValidatorContext, ValidatorGoal, ValueLookup, ValueRef, VariantFact };
import validation::relations { containsValue, emptyIntMap, intAt, minInt };
import validation::state { assumesForall, countPast, localEntry, localsUndone, stateLocalsBefore, negateRelation, noTemplates, resolveValue };
import validation::validation { Truncated, clampedStart, factsBetween, indexFacts, noFactIndex, truncatedState, valueNear, withFacts };


fn executionTable(blocks: &List<ExecutionBlock>) -> HashMap<Int, ExecutionBlock> {
    table = HashMap::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        table = table.insert(block.id, clone(block));
    };
    return table;
};

// (an id below -1 is refused because the outermost sweep's header is -2)
fn uniqueExecutionBlocks(blocks: &List<ExecutionBlock>) -> Bool {
    seen = HashSet::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        if block.id < -1 { return false; };
        if seen.contains(block.id) { return false; };
        seen = seen.insert(block.id);
    };
    return true;
};

fn containsBlock(blocks: &List<Int>, id: Int) -> Bool {
    for block in blocks {
        if block = id { return true; };
    };
    return false;
};

fn blockSet(blocks: &List<Int>) -> HashSet<Int> {
    out = HashSet::new();
    for block in blocks { out = out.insert(block); };
    return out;
};

fn stepRange(steps: &List<ExecutionStep>, from: Int, to: Int) -> List<ExecutionStep> {
    out = [];
    for position in 0..size(steps) {
        if position >= from {
            if position < to { out = push(out, clone(get(steps, position))); };
        };
    };
    return out;
};

fn addVariantFact(context: ValidatorContext, state: &ExecutionState, object: ValueRef, family: Int, constructor: Int, matches: Bool) -> ValidatorContext {
    if family < 0 { return context; };
    found = resolveValue(state, object);
    if found is ValueLookup::Found {
        return ValidatorContext { variants: push(clone(context.variants), VariantFact { object: (found as ValueLookup::Found).term, family: family, constructor: constructor, matches: matches }), ..context };
    };
    return context;
};

// A sweep runs every block on one state, its trunk, and keeps a state that
// waits at a block as a mark on the trunk and what it has beyond it (an
// Arrival). Steps only append facts and rebind locals, so a fork costs what
// its arms add, and running an arm is cutting the trunk back to the arm's mark
// and appending the arm's own facts. A state waiting above a mark the trunk is
// cut back to first takes the trunk's facts between the two into its own
// (rebased), so it never depends on facts that are gone. The marks of the
// states waiting are prefixes of the trunk, each at or below the next (live
// holds them in that order), and a sweep never cuts the trunk below the mark
// it started from, which keeps the states a caller holds intact.

fn emptyState() -> ExecutionState {
    return ExecutionState { context: emptyContext(), locals: emptyIntMap(), templates: noTemplates(), floor: 0 };
};

fn trunkMark(trunk: &Trunk) -> List<Int> {
    return push(contextSizes(trunk.state), size(trunk.trail));
};

fn trailTo(trail: List<TrailEntry>, length: Int) -> List<TrailEntry> {
    out = trail;
    while size(out) > length && size(out) > 0 [{ affirm size(out) >= 0; }] shrinks size(out) { out = pop(out); };
    return out;
};

fn positionsTo(positions: List<Int>, length: Int) -> List<Int> {
    out = positions;
    while size(out) > length && size(out) > 0 [{ affirm size(out) >= 0; }] shrinks size(out) { out = pop(out); };
    return out;
};

fn markAtMost(a: &List<Int>, b: &List<Int>) -> Bool {
    if size(a) != size(b) { return false; };
    for k in 0..size(a) { if intAt(a, k, 0) > intAt(b, k, 0) { return false; }; };
    return true;
};

fn markMin(a: &List<Int>, b: &List<Int>) -> List<Int> {
    out = [];
    for k in 0..size(a) { out = push(out, minInt(intAt(a, k, 0), intAt(b, k, 0))); };
    return out;
};

// An arrival that is the trunk's state as it is
fn arrivalAtTop(trunk: &Trunk) -> Arrival {
    return Arrival { mark: trunkMark(trunk), suffix: emptyContext(), overlay: emptyIntMap(), ownTemplates: false, templates: noTemplates(), floor: trunk.state.floor };
};

fn templatesEntry() -> TrailEntry {
    return TrailEntry { local: 0, had: false, term: 0, isTemplates: true };
};

// The steps run on the trunk, with what they rebind on the trail
fn runOnTrunk(trunk: Trunk, steps: &List<ExecutionStep>) -> TrunkRun {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    trail = stateLocalsBefore(trail, state, steps);
    if assumesForall(steps) {
        trail = push(trail, templatesEntry());
        saved = push(saved, clone(state.templates));
    };
    StepsRun { result: result, index: after } = executeIndexed(state, index, steps);
    ExecutionResult { status: status, failedAt: failedAt, state: ran } = result;
    return TrunkRun { trunk: Trunk { state: ran, index: after, trail: trail, saved: saved }, status: status, failedAt: failedAt };
};

// The trunk cut back to a mark: its facts with their links, and its trail
// undone newest first
fn rewindTrunk(trunk: Trunk, mark: &List<Int>) -> Trunk {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    Truncated { state: cut, index: cutIndex } = truncatedState(state, index, mark);
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = cut;
    length = intAt(mark, 7, 0);
    locals = localsUndone(locals, trail, length);
    for back in 0..countPast(size(trail), length) {
        k = size(trail) - 1 - back;
        if k >= 0 && k < size(trail) {
            if get(trail, k).isTemplates && size(saved) > 0 {
                templates = clone(last(saved));
                saved = pop(saved);
            };
        };
    };
    return Trunk { state: ExecutionState { context: context, locals: locals, templates: templates, floor: floor }, index: cutIndex, trail: trailTo(trail, length), saved: saved };
};

// The locals the trail binds from position from to position to, as they
// are bound now, and whether it changes the templates there
struct TrailSpan { overlay: HashMap<Int, Int>, templates: Bool };

fn trailSpan(trunk: &Trunk, from: Int, to: Int) -> TrailSpan {
    overlay = emptyIntMap();
    changed = false;
    end = clampedStart(to, size(trunk.trail));
    for k in clampedStart(from, end)..end {
        entry = get(trunk.trail, k);
        if entry.isTemplates { changed = true; } else if trunk.state.locals.contains(entry.local) { overlay = overlay.insert(entry.local, trunk.state.locals.lookup(entry.local, 0)); };
    };
    return TrailSpan { overlay: overlay, templates: changed };
};

// The trunk's state as an arrival at a mark below its top
fn capture(trunk: &Trunk, mark: &List<Int>) -> Arrival {
    span = trailSpan(trunk, intAt(mark, 7, 0), size(trunk.trail));
    templates = noTemplates();
    if span.templates { templates = clone(trunk.state.templates); };
    return Arrival { mark: clone(mark), suffix: factsBetween(trunk.state.context, mark, contextSizes(trunk.state), emptyContext()), overlay: span.overlay, ownTemplates: span.templates, templates: templates, floor: trunk.state.floor };
};

// An arrival rebased to a lower mark: the trunk is at the arrival's own mark,
// and what lies between the two marks becomes the arrival's
fn rebased(trunk: &Trunk, arrival: Arrival, target: &List<Int>) -> Arrival {
    Arrival { mark: mark, suffix: suffix, overlay: overlay, ownTemplates: ownTemplates, templates: templates, floor: floor } = arrival;
    span = trailSpan(trunk, intAt(target, 7, 0), intAt(mark, 7, 0));
    TrailSpan { overlay: lower, templates: changed } = span;
    for binding in overlay.entries() { lower = lower.insert(binding.key, binding.value); };
    if ownTemplates = false && changed {
        ownTemplates = true;
        templates = clone(trunk.state.templates);
    };
    return Arrival { mark: clone(target), suffix: factsBetween(trunk.state.context, target, mark, suffix), overlay: lower, ownTemplates: ownTemplates, templates: templates, floor: floor };
};

// The arrival made the trunk's state, at its mark: its facts appended and
// indexed, its locals and templates set on the trail, its floor taken
fn restore(trunk: Trunk, arrival: Arrival) -> Trunk {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    Arrival { mark: mark, suffix: suffix, overlay: overlay, ownTemplates: ownTemplates, templates: own, floor: floor } = arrival;
    ExecutionState { context: context, locals: locals, templates: templates, floor: old } = state;
    context = withFacts(context, suffix);
    for binding in overlay.entries() {
        trail = push(trail, localEntry(locals, binding.key));
        locals = locals.insert(binding.key, binding.value);
    };
    if ownTemplates {
        trail = push(trail, templatesEntry());
        saved = push(saved, templates);
        templates = own;
    };
    index = indexFacts(index, context);
    return Trunk { state: ExecutionState { context: context, locals: locals, templates: templates, floor: floor }, index: index, trail: trail, saved: saved };
};

fn extendedTrunk(trunk: Trunk) -> Trunk {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    return Trunk { index: indexTo(index, state), state: state, trail: trail, saved: saved };
};

fn resolveOn(trunk: &Trunk, value: ValueRef) -> ValueLookup {
    return resolveValue(trunk.state, value);
};

fn holdsOn(trunk: &Trunk, goal: ValidatorGoal) -> Bool {
    return entailsIn(trunk.state.context, trunk.index, goal);
};

// Whether a goal holds on the trunk's state
fn trunkHolds(trunk: Trunk, goal: ValidatorGoal) -> TrunkAnswer {
    extended = extendedTrunk(trunk);
    holds = holdsOn(extended, goal);
    return TrunkAnswer { trunk: extended, holds: holds };
};

fn contradictoryOn(trunk: &Trunk, seeds: &List<Int>) -> Bool {
    if size(seeds) = 0 { return false; };
    probe = get(seeds, 0);
    return goalInSlices(trunk.state.context, trunk.index, seeds, ValidatorGoal::Less { left: probe, right: probe }, -1).holds;
};

// The trunk with facts appended above its top, for a question, then cut back
fn withFactsAbove(trunk: Trunk, facts: &ValidatorContext) -> Trunk {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    context = withFacts(context, facts);
    index = indexFacts(index, context);
    return Trunk { state: ExecutionState { context: context, locals: locals, templates: templates, floor: floor }, index: index, trail: trail, saved: saved };
};

fn contradictoryAbove(trunk: Trunk, facts: &ValidatorContext, seeds: &List<Int>) -> TrunkAnswer {
    mark = trunkMark(trunk);
    above = withFactsAbove(trunk, facts);
    holds = contradictoryOn(above, seeds);
    return TrunkAnswer { trunk: rewindTrunk(above, mark), holds: holds };
};

fn holdsAbove(trunk: Trunk, facts: &ValidatorContext, goal: ValidatorGoal) -> TrunkAnswer {
    mark = trunkMark(trunk);
    above = withFactsAbove(trunk, facts);
    holds = holdsOn(above, goal);
    return TrunkAnswer { trunk: rewindTrunk(above, mark), holds: holds };
};

// What a region round holds while it runs: the trunk, the mark it started
// from, every state delivered (its mark kept beside it), the states still
// waiting in mark order (consumed ones are skipped), the pending chain of
// positions per block, the positions delivered to the loop's own exit, and
// how the round stands.
struct SweepWork { trunk: Trunk, base: List<Int>, waiting: List<Arrival>, marks: List<List<Int>>, live: List<Int>, consumed: HashSet<Int>, pending: HullLinks, exits: List<Int>, dropped: List<Int>, status: Int, block: Int, step: Int, settled: Bool, arrivals: Int, merges: Int };

fn sweepFailure(status: Int, id: Int, step: Int, trunk: Trunk) -> SweepResult {
    return SweepResult { result: ExecutionFlowResult { status: status, block: id, step: step, state: emptyState() }, dropped: [], exits: [], arrivals: 0, merges: 0, trunk: trunk };
};

fn settleAt(work: SweepWork, status: Int, block: Int, step: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: oldStatus, block: oldBlock, step: oldStep, settled: settled, arrivals: arrivals, merges: merges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: true, arrivals: arrivals, merges: merges };
};

// A return block that ran: the round stands at it
fn ranAt(work: SweepWork, block: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: oldBlock, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: 0, block: block, step: -1, settled: settled, arrivals: arrivals, merges: merges };
};

fn counted(work: SweepWork, arrivals: Int, merges: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: oldArrivals, merges: oldMerges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: oldArrivals + arrivals, merges: oldMerges + merges };
};

fn withTrunk(work: SweepWork, trunk: Trunk) -> SweepWork {
    SweepWork { trunk: old, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges };
};

// A round's work and its trunk, taken apart
struct Opened { work: SweepWork, trunk: Trunk };

fn opened(work: SweepWork) -> Opened {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    empty = Trunk { state: emptyState(), index: noFactIndex(), trail: [], saved: [] };
    return Opened { work: SweepWork { trunk: empty, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges }, trunk: trunk };
};

// A state stored as waiting (at the top of the live order); its position is
// the number of states stored before it. rewindWork stops at the first state
// at or below its target, so the live order must be the order of the marks: a
// state below the top one is refused rather than stored out of order.
fn stored(work: SweepWork, arrival: Arrival) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    top = intAt(live, size(live) - 1, -1);
    if top >= 0 && top < size(marks) && markAtMost(get(marks, top), arrival.mark) = false {
        return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: 3, block: block, step: -1, settled: true, arrivals: arrivals, merges: merges };
    };
    live = push(live, size(waiting));
    marks = push(marks, clone(arrival.mark));
    waiting = push(waiting, arrival);
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges };
};

fn markOf(work: &SweepWork, position: Int) -> List<Int> {
    if position >= 0 && position < size(work.marks) { return clone(get(work.marks, position)); };
    return [];
};

struct TakenArrival { work: SweepWork, arrival: Arrival };

// A waiting state taken out to run: it waits no longer
fn takeArrival(work: SweepWork, position: Int) -> TakenArrival {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    arrival = arrivalAtTop(trunk);
    if position >= 0 && position < size(waiting) {
        arrival = clone(get(waiting, position));
        waiting = set(waiting, position, Arrival { mark: [], suffix: emptyContext(), overlay: emptyIntMap(), ownTemplates: false, templates: noTemplates(), floor: 0 });
    } else { settled = true; status = 3; };
    consumed = consumed.insert(position);
    return TakenArrival { work: SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges }, arrival: arrival };
};

// The trunk cut back to target, each waiting state above it rebased first,
// highest first so that the trunk is at that state's own mark when it is
fn rewindWork(work: SweepWork, target: &List<Int>) -> SweepWork {
    if work.settled { return work; };
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    broken = markAtMost(base, target) = false || markAtMost(target, trunkMark(trunk)) = false;
    // (from the top down to the first state waiting at or below target: the
    // ones under it are too, so the scan costs what it lifts or drops)
    cut = size(live);
    scan = size(live);
    stop = false;
    while scan > 0 && stop = false [{ affirm scan >= 0; }] shrinks scan {
        scan = scan - 1;
        p = intAt(live, scan, -1);
        if consumed.contains(p) {
            cut = scan;
        } else {
            at = [];
            if p >= 0 && p < size(marks) { at = clone(get(marks, p)); };
            if markAtMost(at, target) { stop = true; } else {
                if markAtMost(target, at) = false { broken = true; };
                cut = scan;
            };
        };
    };
    if broken {
        return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: 3, block: block, step: -1, settled: true, arrivals: arrivals, merges: merges };
    };
    lifted = [];
    for k in clampedStart(cut, size(live))..size(live) {
        p = get(live, k);
        if consumed.contains(p) = false { lifted = push(lifted, p); };
    };
    live = positionsTo(live, cut);
    for back in 0..size(lifted) {
        p = intAt(lifted, size(lifted) - 1 - back, -1);
        if p >= 0 && p < size(waiting) && p < size(marks) {
            trunk = rewindTrunk(trunk, get(marks, p));
            arrival = clone(get(waiting, p));
            waiting = set(waiting, p, rebased(trunk, arrival, target));
            marks = set(marks, p, clone(target));
        };
    };
    trunk = rewindTrunk(trunk, target);
    for p in lifted { live = push(live, p); };
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges };
};

// The states waiting at a block, merged in the order they were delivered,
// made the trunk's state. Only soundness, not precision, is independent of
// that order.
fn mergeTaken(work: SweepWork, taken: &List<Int>) -> SweepWork {
    if size(taken) = 0 { return settleAt(work, 2, -1, -1); };
    common = markOf(work, get(taken, 0));
    for position in 1..size(taken) { common = markMin(common, markOf(work, get(taken, position))); };
    rewound = rewindWork(work, common);
    if rewound.settled { return rewound; };
    TakenArrival { work: first, arrival: folded } = takeArrival(rewound, get(taken, 0));
    Opened { work: rest, trunk: trunk } = opened(first);
    trunk = extendedTrunk(trunk);
    for position in 1..size(taken) {
        TakenArrival { work: next, arrival: arrival } = takeArrival(rest, get(taken, position));
        rest = next;
        folded = mergeArrivals(trunk, folded, arrival);
    };
    return withTrunk(rest, restore(trunk, folded));
};

// A waiting state made the trunk's state on its own
fn materialized(work: SweepWork, position: Int) -> SweepWork {
    rewound = rewindWork(work, markOf(work, position));
    if rewound.settled { return rewound; };
    TakenArrival { work: taken, arrival: arrival } = takeArrival(rewound, position);
    Opened { work: rest, trunk: trunk } = opened(taken);
    return withTrunk(rest, restore(trunk, arrival));
};

struct TrunkRunWork { work: SweepWork, status: Int, failedAt: Int };

// What the last block's steps did to the round
fn runOnWork(work: SweepWork, steps: &List<ExecutionStep>) -> TrunkRunWork {
    Opened { work: rest, trunk: trunk } = opened(work);
    TrunkRun { trunk: ran, status: status, failedAt: failedAt } = runOnTrunk(trunk, steps);
    return TrunkRunWork { work: withTrunk(rest, ran), status: status, failedAt: failedAt };
};

// The back edge's checks, its candidates and the variant, on the trunk
struct BackEdge { trunk: Trunk, status: Int, step: Int, dropped: List<Int> };

// What the variant has to show at an edge back to the header: it is smaller
// than it was when the iteration started, in whichever of the four senses the
// loop was written with.
fn checkLoopVariant(trunk: Trunk, frame: &LoopFrame) -> BackEdge {
    next = resolveOn(trunk, frame.variant);
    if next is ValueLookup::Found {
        nextTerm = (next as ValueLookup::Found).term;
        if frame.variantMode = 0 {
            TrunkAnswer { trunk: t0, holds: smaller } = trunkHolds(trunk, ValidatorGoal::Less { left: nextTerm, right: frame.prior });
            if smaller = false { return BackEdge { trunk: t0, status: 1, step: -1, dropped: [] }; };
            return BackEdge { trunk: t0, status: 0, step: -1, dropped: [] };
        };
        if frame.variantMode = 1 {
            otherAfter = resolveOn(trunk, frame.variantOther);
            if otherAfter is ValueLookup::Found {
                TrunkAnswer { trunk: t1, holds: same } = trunkHolds(trunk, ValidatorGoal::Equal { left: (otherAfter as ValueLookup::Found).term, right: frame.priorOther });
                if same = false { return BackEdge { trunk: t1, status: 1, step: -1, dropped: [] }; };
                TrunkAnswer { trunk: t2, holds: closer } = trunkHolds(t1, ValidatorGoal::Less { left: frame.prior, right: nextTerm });
                if closer = false { return BackEdge { trunk: t2, status: 1, step: -1, dropped: [] }; };
                return BackEdge { trunk: t2, status: 0, step: -1, dropped: [] };
            };
            return BackEdge { trunk: trunk, status: 2, step: -1, dropped: [] };
        };
        if frame.variantMode = 3 {
            TrunkAnswer { trunk: t3, holds: within } = trunkHolds(trunk, ValidatorGoal::Within { inner: nextTerm, outer: frame.prior });
            if within = false { return BackEdge { trunk: t3, status: 1, step: -1, dropped: [] }; };
            TrunkAnswer { trunk: t4, holds: other } = trunkHolds(t3, ValidatorGoal::Different { left: nextTerm, right: frame.prior });
            if other = false { return BackEdge { trunk: t4, status: 1, step: -1, dropped: [] }; };
            return BackEdge { trunk: t4, status: 0, step: -1, dropped: [] };
        };
        return BackEdge { trunk: trunk, status: 0, step: -1, dropped: [] };
    };
    return BackEdge { trunk: trunk, status: 2, step: -1, dropped: [] };
};

// An edge back to the header. The user's invariant and the variant are the
// function's to prove; an inferred candidate is only a guess, so each is tried
// on its own and quietly, and every one that fails is reported (and its
// facts cut off the trunk again). The caller sweeps the region again without
// them and believes nothing this round produced, because the round's other
// proofs may have used a candidate that turned out not to hold here.
fn sweepBackEdge(trunk: Trunk, frame: &LoopFrame) -> BackEdge {
    TrunkRun { trunk: checked, status: status, failedAt: failedAt } = runOnTrunk(trunk, frame.checks);
    if status != 0 { return BackEdge { trunk: checked, status: status, step: failedAt, dropped: [] }; };
    dropped = [];
    from = 0;
    for candidate in 0..size(frame.candEnds) {
        to = get(frame.candEnds, candidate);
        before = trunkMark(checked);
        TrunkRun { trunk: tried, status: triedStatus, failedAt: triedAt } = runOnTrunk(checked, stepRange(frame.candChecks, from, to));
        if triedStatus != 0 {
            dropped = push(dropped, candidate);
            checked = rewindTrunk(tried, before);
        } else { checked = tried; };
        from = to;
    };
    if size(dropped) > 0 { return BackEdge { trunk: checked, status: 1, step: -1, dropped: dropped }; };
    return checkLoopVariant(checked, frame);
};

fn backEdge(frame: &LoopFrame, work: SweepWork) -> SweepWork {
    Opened { work: rest, trunk: trunk } = opened(work);
    BackEdge { trunk: after, status: status, step: step, dropped: back } = sweepBackEdge(trunk, frame);
    SweepWork { trunk: none, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: oldStatus, block: oldBlock, step: oldStep, settled: settled, arrivals: arrivals, merges: merges } = rest;
    for candidate in back {
        if containsValue(dropped, candidate) = false { dropped = push(dropped, candidate); };
    };
    if size(back) = 0 && status != 0 {
        return SweepWork { trunk: after, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: frame.header, step: step, settled: true, arrivals: arrivals, merges: merges };
    };
    return SweepWork { trunk: after, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: oldStatus, block: oldBlock, step: oldStep, settled: settled, arrivals: arrivals, merges: merges };
};

fn activeHeader(header: Int, target: Int) -> Bool {
    if header < 0 { return false; };
    return target = header;
};

fn withPending(work: SweepWork, block: Int, position: Int, arrived: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: oldBlock, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: linkAppend(pending, block, position), exits: exits, dropped: dropped, status: status, block: oldBlock, step: step, settled: settled, arrivals: arrivals + arrived, merges: merges };
};

fn withExit(work: SweepWork, position: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: push(exits, position), dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges };
};

// Where a stored state goes: the back edge at once, the loop's own exit, or
// a block of the region to wait for its turn
fn routeStored(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, target: Int, position: Int, work: SweepWork) -> SweepWork {
    if work.settled { return work; };
    if activeHeader(frame.header, target) { return backEdge(frame, materialized(work, position)); };
    if frame.header >= 0 && target = frame.exit { return withExit(work, position); };
    if blocks.contains(target) = false { return settleAt(work, 3, target, -1); };
    return withPending(work, target, position, 1);
};

fn routeNew(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, target: Int, arrival: Arrival, work: SweepWork) -> SweepWork {
    position = size(work.waiting);
    return routeStored(blocks, frame, target, position, stored(work, arrival));
};

// The two arms of a test, each run on the trunk from the block's state: the
// first is kept as its own facts and the trunk cut back, the second stays on
// the trunk. Both are stored before either is routed, since routing one to
// the back edge runs it at once.
fn forkArms(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, work: SweepWork, id: Int, yes: Int, yesSteps: &List<ExecutionStep>, no: Int, noSteps: &List<ExecutionStep>, failStep: Bool) -> SweepWork {
    Opened { work: rest, trunk: trunk } = opened(work);
    fork = trunkMark(trunk);
    TrunkRun { trunk: afterYes, status: yesStatus, failedAt: yesAt } = runOnTrunk(trunk, yesSteps);
    if yesStatus != 0 {
        step = -1;
        if failStep { step = yesAt; };
        return settleAt(withTrunk(rest, afterYes), yesStatus, id, step);
    };
    yesArrival = arrivalAtTop(afterYes);
    if yesAt != -2 { yesArrival = capture(afterYes, fork); };
    TrunkRun { trunk: afterNo, status: noStatus, failedAt: noAt } = runOnTrunk(rewindTrunk(afterYes, fork), noSteps);
    if noStatus != 0 {
        step = -1;
        if failStep { step = noAt; };
        return settleAt(withTrunk(rest, afterNo), noStatus, id, step);
    };
    if noAt = -2 { afterNo = rewindTrunk(afterNo, fork); };
    noArrival = arrivalAtTop(afterNo);
    routed = withTrunk(rest, afterNo);
    yesAt0 = size(routed.waiting);
    if yesAt != -2 { routed = stored(routed, yesArrival); };
    noAt0 = size(routed.waiting);
    if noAt != -2 { routed = stored(routed, noArrival); };
    if yesAt != -2 { routed = routeStored(blocks, frame, yes, yesAt0, routed); };
    if noAt != -2 { routed = routeStored(blocks, frame, no, noAt0, routed); };
    return routed;
};

fn topOf(work: &SweepWork) -> Arrival {
    return arrivalAtTop(work.trunk);
};

fn resolveIn(work: &SweepWork, value: ValueRef) -> ValueLookup {
    return resolveOn(work.trunk, value);
};

fn assumeStep(term: Int, literal: Int) -> List<ExecutionStep> {
    return push([], ExecutionStep::Assume { relation: 0, left: ValueRef::Term { term: term }, right: ValueRef::Term { term: literal } });
};

// The trunk with term = literal assumed, and the comparisons that decides
fn decidedTrunk(trunk: Trunk, term: Int, literal: Int) -> Trunk {
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    decided = assumeBooleanFact(assumeRelation(context, 0, term, literal), index, term, literal);
    return Trunk { state: ExecutionState { context: decided, locals: locals, templates: templates, floor: floor }, index: index, trail: trail, saved: saved };
};

fn decides(trunk: &Trunk, term: Int, literal: Int) -> Bool {
    return checkNear(trunk.state.context, trunk.index, 0, term, literal);
};

// Where a block's end sends the trunk's state. A test the facts already
// answer takes one edge only, which is what keeps an arm the program cannot
// reach from being checked.
fn deliverEnd(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, end: &ExecutionEnd, id: Int, work: SweepWork) -> SweepWork {
    if end is ExecutionEnd::Jump {
        top = topOf(work);
        return routeNew(blocks, frame, (end as ExecutionEnd::Jump).target, top, work);
    };
    if end is ExecutionEnd::Branch {
        branch = end as ExecutionEnd::Branch;
        return forkArms(blocks, frame, work, id, branch.yes, branch.yesSteps, branch.no, branch.noSteps, true);
    };
    if end is ExecutionEnd::BooleanBranch {
        branch = end as ExecutionEnd::BooleanBranch;
        value = resolveIn(work, branch.value);
        trueValue = resolveIn(work, branch.trueValue);
        falseValue = resolveIn(work, branch.falseValue);
        if value is ValueLookup::Found {
            if trueValue is ValueLookup::Found {
                if falseValue is ValueLookup::Found {
                    term = (value as ValueLookup::Found).term;
                    yesLiteral = (trueValue as ValueLookup::Found).term;
                    noLiteral = (falseValue as ValueLookup::Found).term;
                    Opened { work: rest, trunk: trunk } = opened(work);
                    trunk = extendedTrunk(trunk);
                    if decides(trunk, term, yesLiteral) {
                        yesTrunk = decidedTrunk(trunk, term, yesLiteral);
                        top = arrivalAtTop(yesTrunk);
                        return routeNew(blocks, frame, branch.yes, top, withTrunk(rest, yesTrunk));
                    };
                    if decides(trunk, term, noLiteral) {
                        noTrunk = decidedTrunk(trunk, term, noLiteral);
                        top = arrivalAtTop(noTrunk);
                        return routeNew(blocks, frame, branch.no, top, withTrunk(rest, noTrunk));
                    };
                    return forkArms(blocks, frame, withTrunk(rest, trunk), id, branch.yes, assumeStep(term, yesLiteral), branch.no, assumeStep(term, noLiteral), false);
                };
            };
        };
        return settleAt(work, 2, id, -1);
    };
    return settleAt(work, 2, id, -1);
};

// A return block, or a latch (a jump to the header being swept), runs once
// per arrival. Neither delivers into the region: a return delivers nothing
// and a latch goes only to the back edge, so a host-numbered id one of their
// runs makes never meets another run's at a merge.
fn runEachArrival(frame: &LoopFrame, block: &ExecutionBlock, taken: &List<Int>, work: SweepWork, latch: Bool) -> SweepWork {
    id = (*block).id;
    ran = work;
    for position in 0..size(taken) {
        if ran.settled = false {
            ready = materialized(ran, get(taken, position));
            if ready.settled { ran = ready; } else {
                TrunkRunWork { work: after, status: status, failedAt: failedAt } = runOnWork(ready, (*block).steps);
                if status != 0 {
                    ran = settleAt(after, status, id, failedAt);
                } else if failedAt != -2 {
                    if latch { ran = backEdge(frame, after); } else { ran = ranAt(after, id); };
                } else { ran = after; };
            };
        };
    };
    return ran;
};

// A block with no steps that only jumps on (the join an if leaves) hands each
// arrival to its target as it is: it runs nothing and merges nothing.
fn forwardArrivals(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, target: Int, taken: &List<Int>, work: SweepWork) -> SweepWork {
    if frame.header >= 0 && target = frame.exit {
        leaving = work;
        for position in taken { leaving = withExit(leaving, position); };
        return leaving;
    };
    if blocks.contains(target) = false { return settleAt(work, 3, target, -1); };
    moved = work;
    for position in taken { moved = withPending(moved, target, position, 0); };
    return moved;
};

// Every other block, a branch with an edge to the header included, runs once
// on the merge of everything that arrived.
fn runOnce(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, block: &ExecutionBlock, taken: &List<Int>, work: SweepWork) -> SweepWork {
    id = (*block).id;
    merged = mergeTaken(counted(work, 0, size(taken) - 1), taken);
    if merged.settled { return merged; };
    TrunkRunWork { work: after, status: status, failedAt: failedAt } = runOnWork(merged, (*block).steps);
    if status != 0 { return settleAt(after, status, id, failedAt); };
    if failedAt = -2 { return after; };
    return deliverEnd(blocks, frame, (*block).end, id, after);
};

fn sweepPlain(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, block: &ExecutionBlock, taken: &List<Int>, work: SweepWork) -> SweepWork {
    if (*block).end is ExecutionEnd::Done { return runEachArrival(frame, block, taken, work, false); };
    if (*block).end is ExecutionEnd::Jump {
        target = ((*block).end as ExecutionEnd::Jump).target;
        if activeHeader(frame.header, target) { return runEachArrival(frame, block, taken, work, true); };
        if size((*block).steps) = 0 { return forwardArrivals(blocks, frame, target, taken, work); };
    };
    return runOnce(blocks, frame, block, taken, work);
};

// Where an iteration starts the variant must be at least the zero (a count)
// or below its other end (a gap closing from below).
fn variantStartGoal(mode: Int, terms: LoopEntryTerms) -> ValidatorGoal {
    if mode = 0 { return ValidatorGoal::AtMost { left: terms.zero, right: terms.prior }; };
    return ValidatorGoal::AtMost { left: terms.prior, right: terms.priorOther };
};

struct TestTerms { found: Bool, left: Int, right: Int };

fn testTermsOf(trunk: &Trunk, test: &LoopTest) -> TestTerms {
    left = resolveOn(trunk, test.left);
    right = resolveOn(trunk, test.right);
    if left is ValueLookup::Found {
        if right is ValueLookup::Found { return TestTerms { found: true, left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term }; };
    };
    return TestTerms { found: false, left: 0, right: 0 };
};

fn splitFailure(trunk: Trunk) -> LoopSplit {
    return LoopSplit { status: 2, trunk: trunk, yes: emptyContext(), no: emptyContext() };
};

// The two ways out of the loop's test, as facts above the header state. An
// iteration runs with the test true: where the loop has several tests any one
// of them may be the reason, so it has what they have in common, plus the
// relations every one of them entails. The exit edge has all of them false.
fn loopSplit(trunk: Trunk, tests: &List<LoopTest>, prior: Int, priorOther: Int) -> LoopSplit {
    negated = emptyContext();
    joinedYes = emptyContext();
    haveYes = false;
    yesFeasible = false;
    paths = [];
    testRelations = [];
    testLefts = [];
    testRights = [];
    for testPosition in 0..size(tests) [{ affirm size(testLefts) = size(testRelations); affirm size(testRights) = size(testRelations); }] {
        test = get(tests, testPosition);
        terms = testTermsOf(trunk, test);
        if terms.found = false { return splitFailure(trunk); };
        ta = terms.left;
        tb = terms.right;
        pathFacts = assumeRelation(clone(negated), test.relation, ta, tb);
        ValidatorContext { equalities: pathEqualities, applications: pathApplications, constants: pathConstants, orders: pathOrders, different: pathDifferent, variants: pathVariants, fieldFunctions: pathFields, constructorFunctions: pathConstructors, constructorFields: pathConstructorFields, differences: pathDifferences } = pathFacts;
        pathEqualities = push(push(pathEqualities, EqualityFact { left: prior, right: prior }), EqualityFact { left: priorOther, right: priorOther });
        path = ValidatorContext { equalities: pathEqualities, applications: pathApplications, constants: pathConstants, orders: pathOrders, different: pathDifferent, variants: pathVariants, fieldFunctions: pathFields, constructorFunctions: pathConstructors, constructorFields: pathConstructorFields, differences: pathDifferences };
        TrunkAnswer { trunk: asked, holds: contradictory } = contradictoryAbove(trunk, path, push(push([], ta), tb));
        trunk = asked;
        feasible = contradictory = false;
        if feasible { paths = push(paths, clone(path)); };
        testRelations = push(testRelations, test.relation);
        testLefts = push(testLefts, ta);
        testRights = push(testRights, tb);
        if haveYes = false {
            joinedYes = path;
            haveYes = true;
            yesFeasible = feasible;
        } else {
            if feasible {
                if yesFeasible = false {
                    joinedYes = path;
                    yesFeasible = true;
                } else {
                    joinedYes = commonContext(joinedYes, path);
                };
            };
        };
        inverse = negateRelation(test.relation, ta, tb);
        negated = assumeRelation(negated, inverse.relation, inverse.left, inverse.right);
    };
    if haveYes = false { return splitFailure(trunk); };
    if size(tests) > 1 {
        for testPosition in 0..size(testRelations) {
            relation = get(testRelations, testPosition);
            ta = intAt(testLefts, testPosition, 0);
            tb = intAt(testRights, testPosition, 0);
            everyPath = size(paths) > 0;
            for pathPosition in 0..size(paths) {
                if everyPath {
                    TrunkAnswer { trunk: asked, holds: entailed } = holdsAbove(trunk, get(paths, pathPosition), localGoal(relation, ta, tb));
                    trunk = asked;
                    if entailed = false { everyPath = false; };
                };
            };
            if everyPath { joinedYes = assumeRelation(joinedYes, relation, ta, tb); };
        };
    };
    return LoopSplit { status: 0, trunk: trunk, yes: joinedYes, no: negated };
};

fn variantFactOn(facts: ValidatorContext, trunk: &Trunk, object: ValueRef, family: Int, constructor: Int, matches: Bool) -> ValidatorContext {
    return addVariantFact(facts, trunk.state, object, family, constructor, matches);
};

fn testTermsOn(trunk: &Trunk, tests: &List<LoopTest>) -> List<Int> {
    return testTerms(trunk.state, tests);
};

fn candidatesFor(trunk: &Trunk, havoc: &List<Int>, mentions: &HashSet<Int>) -> List<InferGoal> {
    return inferLoopCandidateGoals(trunk.state, havoc, mentions);
};

fn trunkFloor(trunk: &Trunk) -> Int {
    return trunk.state.floor;
};

fn iterationFailure(status: Int, step: Int, trunk: Trunk) -> LoopIteration {
    floor = trunkFloor(trunk);
    none = Arrival { mark: [], suffix: emptyContext(), overlay: emptyIntMap(), ownTemplates: false, templates: noTemplates(), floor: floor };
    return LoopIteration { status: status, step: step, trunk: trunk, yes: clone(none), no: none, noFeasible: false, prior: 0, priorOther: 0 };
};

fn withEqualities(context: ValidatorContext, a: Int, b: Int) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    equalities = push(push(equalities, EqualityFact { left: a, right: a }), EqualityFact { left: b, right: b });
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

// An iteration: the header state on the trunk with the region's locals
// arbitrary, then what the loop assumes, the candidates still standing and
// the header's own steps; the state the body starts in (the test true, the
// variant's start value pinned), and the exit edge's state.
fn loopIteration(block: &ExecutionBlock, trunk: Trunk, cands: &CandidateSteps) -> LoopIteration {
    if (*block).end is ExecutionEnd::Loop {
        loop = (*block).end as ExecutionEnd::Loop;
        havocSteps = [];
        for position in 0..size(loop.havoc) { havocSteps = push(havocSteps, ExecutionStep::Havoc { local: get(loop.havoc, position) }); };
        TrunkRun { trunk: changed, status: changedStatus, failedAt: changedAt } = runOnTrunk(trunk, havocSteps);
        if changedStatus != 0 { return iterationFailure(changedStatus, -1, changed); };
        TrunkRun { trunk: assumed, status: assumedStatus, failedAt: assumedAt } = runOnTrunk(changed, loop.assumptions);
        if assumedStatus != 0 { return iterationFailure(assumedStatus, assumedAt, assumed); };
        TrunkRun { trunk: guessed, status: guessedStatus, failedAt: guessedAt } = runOnTrunk(assumed, cands.assumes);
        if guessedStatus != 0 { return iterationFailure(guessedStatus, guessedAt, guessed); };
        TrunkRun { trunk: header, status: headerStatus, failedAt: headerAt } = runOnTrunk(guessed, (*block).steps);
        if headerStatus != 0 { return iterationFailure(headerStatus, headerAt, header); };
        header = extendedTrunk(header);
        terms = loopEntryTerms(header, loop.left, loop.right, loop.variant, loop.variantOther, loop.zero);
        if terms.found = false { return iterationFailure(2, -1, header); };
        tests = loopTests(loop.relation, loop.left, loop.right, loop.orTests);
        LoopSplit { status: splitStatus, trunk: split, yes: yesFacts, no: noFacts } = loopSplit(header, tests, terms.prior, terms.priorOther);
        if splitStatus != 0 { return iterationFailure(splitStatus, -1, split); };
        yesFacts = variantFactOn(yesFacts, split, loop.variantObject, loop.variantFamily, loop.variantConstructor, true);
        starts = true;
        if loop.variantMode = 0 || loop.variantMode = 1 {
            TrunkAnswer { trunk: asked, holds: holds } = holdsAbove(split, yesFacts, variantStartGoal(loop.variantMode, terms));
            split = asked;
            starts = holds;
        };
        if starts = false { return iterationFailure(1, -1, split); };
        yesFacts = withEqualities(yesFacts, terms.prior, terms.priorOther);
        noFacts = variantFactOn(noFacts, split, loop.variantObject, loop.variantFamily, loop.variantConstructor, false);
        seeds = testTermsOn(split, tests);
        TrunkAnswer { trunk: asked, holds: noContradictory } = contradictoryAbove(split, noFacts, seeds);
        mark = trunkMark(asked);
        floor = trunkFloor(asked);
        yes = Arrival { mark: clone(mark), suffix: yesFacts, overlay: emptyIntMap(), ownTemplates: false, templates: noTemplates(), floor: floor };
        no = Arrival { mark: mark, suffix: noFacts, overlay: emptyIntMap(), ownTemplates: false, templates: noTemplates(), floor: floor };
        return LoopIteration { status: 0, step: -1, trunk: asked, yes: yes, no: no, noFeasible: noContradictory = false, prior: terms.prior, priorOther: terms.priorOther };
    };
    return iterationFailure(2, -1, trunk);
};

fn loopBodyUnreachable(trunk: Trunk, tests: &List<LoopTest>) -> TrunkAnswer {
    mark = trunkMark(trunk);
    for test in tests {
        TrunkRun { trunk: ran, status: status, failedAt: failedAt } = runOnTrunk(trunk, push([], ExecutionStep::Assume { relation: test.relation, left: test.left, right: test.right }));
        trunk = rewindTrunk(ran, mark);
        if status != 0 || failedAt != -2 { return TrunkAnswer { trunk: trunk, holds: false }; };
    };
    return TrunkAnswer { trunk: trunk, holds: size(tests) > 0 };
};

// One round of a loop: sweep the region from the body under the candidates
// still standing. It leaves the loop with the header state under the failed
// test, and with each state the body delivered to the loop's own exit (the
// false edge of a later conjunct of the test), as it was delivered.
fn loopRound(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, block: &ExecutionBlock, trunk: Trunk, cands: &CandidateSteps, total: Int, measure: Int) -> LoopRound [{ affirm total >= 0; affirm measure >= 0; }] [{ }] shrinks measure {
    id = (*block).id;
    LoopIteration { status: status, step: step, trunk: header, yes: yes, no: no, noFeasible: noFeasible, prior: prior, priorOther: priorOther } = loopIteration(block, trunk, cands);
    if status != 0 { return LoopRound { swept: sweepFailure(status, id, step, header), exits: [] }; };
    if measure <= 0 { return LoopRound { swept: sweepFailure(3, id, -1, header), exits: [] }; };
    if (*block).end is ExecutionEnd::Loop {
        loop = (*block).end as ExecutionEnd::Loop;
        inner = LoopFrame { header: id, exit: loop.exit, active: push(clone(frame.active), id), region: clone(loop.region), checks: clone(loop.checks), candChecks: clone(cands.checks), candEnds: clone(cands.ends), variant: loop.variant, variantMode: loop.variantMode, variantOther: loop.variantOther, prior: prior, priorOther: priorOther };
        tests = loopTests(loop.relation, loop.left, loop.right, loop.orTests);
        exits = [];
        if noFeasible { exits = push(exits, no); };
        TrunkAnswer { trunk: asked, holds: unreachable } = loopBodyUnreachable(header, tests);
        if unreachable {
            // (an empty successful sweep: a body no test lets execution into delivers nothing)
            return LoopRound { swept: SweepResult { result: ExecutionFlowResult { status: 0, block: id, step: -1, state: emptyState() }, dropped: [], exits: [], arrivals: 0, merges: 0, trunk: asked }, exits: exits };
        };
        SweepResult { result: result, dropped: dropped, exits: bodyExits, arrivals: arrivals, merges: merges, trunk: after } = sweep(blocks, inner, loop.body, restore(asked, yes), total, measure - 1);
        if result.status != 0 || size(dropped) > 0 { exits = []; } else {
            for leaving in bodyExits { exits = push(exits, clone(leaving)); };
        };
        return LoopRound { swept: SweepResult { result: result, dropped: dropped, exits: [], arrivals: arrivals, merges: merges, trunk: after }, exits: exits };
    };
    return LoopRound { swept: sweepFailure(2, id, -1, header), exits: [] };
};

// A nested loop's header: its arrivals merged, its entry checks, then rounds
// until one drops no candidate, each from the merged state (the trunk is cut
// back to it). A round that failed for another reason is tried once more with
// no candidates; running out of rounds refuses.
fn sweepLoop(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, block: &ExecutionBlock, taken: &List<Int>, work: SweepWork, total: Int, measure: Int) -> SweepWork [{ affirm total >= 0; affirm measure >= 0; }] [{ }] shrinks measure {
    id = (*block).id;
    merged = mergeTaken(counted(work, 0, size(taken) - 1), taken);
    if merged.settled { return merged; };
    if (*block).end is ExecutionEnd::Loop {
        loop = (*block).end as ExecutionEnd::Loop;
        if loopFieldsValid(loop.relation, loop.variantMode) = false { return settleAt(merged, 2, id, -1); };
        Opened { work: looping, trunk: trunk } = opened(merged);
        entry = trunkMark(trunk);
        TrunkRun { trunk: checked, status: entryStatus, failedAt: entryAt } = runOnTrunk(trunk, loop.checks);
        if entryStatus != 0 { return settleAt(withTrunk(looping, checked), entryStatus, id, entryAt); };
        TrunkRun { trunk: before, status: beforeStatus, failedAt: beforeAt } = runOnTrunk(rewindTrunk(checked, entry), (*block).steps);
        if beforeStatus != 0 { return settleAt(withTrunk(looping, before), beforeStatus, id, beforeAt); };
        trunk = rewindTrunk(before, entry);
        if measure <= 0 { return settleAt(withTrunk(looping, trunk), 3, id, -1); };
        mentions = loopMentions(blocks, loop.region);
        inferred = candidatesFor(trunk, loop.havoc, mentions);
        survivors = clone(inferred);
        finished = false;
        failed = false;
        failure = ExecutionFlowResult { status: 2, block: id, step: -1, state: emptyState() };
        for attempt in 0..size(inferred) + 2 {
            if finished = false && failed = false {
                LoopRound { swept: swept, exits: exits } = loopRound(blocks, frame, block, rewindTrunk(trunk, entry), candidateSteps(survivors), total, measure - 1);
                SweepResult { result: result, dropped: dropped, exits: none, arrivals: arrivals, merges: merges, trunk: after } = swept;
                trunk = after;
                looping = counted(looping, arrivals, merges);
                if size(dropped) > 0 {
                    survivors = withoutCandidates(survivors, dropped);
                } else {
                    if result.status = 0 {
                        leaving = withTrunk(looping, trunk);
                        first = size(leaving.waiting);
                        for exit in exits { leaving = stored(leaving, clone(exit)); };
                        for k in 0..size(exits) { leaving = routeStored(blocks, frame, loop.exit, first + k, leaving); };
                        return leaving;
                    } else {
                        if size(survivors) = 0 {
                            failed = true;
                            failure = result;
                        };
                        survivors = [];
                    };
                };
            };
        };
        if failed { return settleAt(withTrunk(looping, trunk), failure.status, failure.block, failure.step); };
        return settleAt(withTrunk(looping, trunk), 2, id, -1);
    };
    return settleAt(merged, 2, id, -1);
};

fn leftoverArrivals(work: SweepWork) -> SweepWork {
    entries = work.pending.first.entries();
    if size(entries) > 0 { return settleAt(work, 3, get(entries, 0).key, -1); };
    return work;
};

fn withoutWaiting(work: SweepWork, block: Int) -> SweepWork {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: oldBlock, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    HullLinks { first: first, last: last, next: next, prev: prev, items: items } = pending;
    return SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: HullLinks { first: first.remove(block), last: last.remove(block), next: next, prev: prev, items: items }, exits: exits, dropped: dropped, status: status, block: oldBlock, step: step, settled: settled, arrivals: arrivals, merges: merges };
};

fn sweepWorkStart(start: Int, trunk: Trunk) -> SweepWork {
    base = trunkMark(trunk);
    first = arrivalAtTop(trunk);
    return SweepWork { trunk: trunk, base: clone(base), waiting: push([], first), marks: push([], base), live: push([], 0), consumed: HashSet::new(), pending: linkAppend(noLinks(), start, 0), exits: [], dropped: [], status: 0, block: start, step: -1, settled: false, arrivals: 1, merges: 0 };
};

// The round's verdict, the states it left at the loop's exit, and the trunk
fn sweepFinished(work: SweepWork) -> SweepResult {
    SweepWork { trunk: trunk, base: base, waiting: waiting, marks: marks, live: live, consumed: consumed, pending: pending, exits: exits, dropped: dropped, status: status, block: block, step: step, settled: settled, arrivals: arrivals, merges: merges } = work;
    leaving = [];
    for position in exits {
        if position >= 0 && position < size(waiting) { leaving = push(leaving, clone(get(waiting, position))); };
    };
    return SweepResult { result: ExecutionFlowResult { status: status, block: block, step: step, state: emptyState() }, dropped: dropped, exits: leaving, arrivals: arrivals, merges: merges, trunk: trunk };
};

// One visit per block. The blocks of the region are put in an order where a
// block follows everything that delivers to it, and the states that arrive at
// a block are merged into one before it runs, so a branch costs its two arms
// and not the paths through them. Facts only one arm has are lost at the
// merge.
//
// With N blocks run once in a region round, and B states the nested loops it
// runs delivered to their own exits, at most 2N + 1 + B states arrive anywhere
// but a forwarder and at most 2N + B merges are made. A nested loop delivers at
// most twice the blocks it runs once, so one round's count is linear in the
// blocks of the nest, while rounds still multiply with the nesting depth;
// forwarding moves each arrival along a chain of forwarders at most as long as
// the nesting.
//
// `measure` falls by one on each call around sweep, sweepLoop and loopRound.
// A nested loop is entered under a header no enclosing sweep holds, so the
// depth is bounded by the blocks; a sweep that would run out refuses.
fn sweep(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, start: Int, trunk: Trunk, total: Int, measure: Int) -> SweepResult [{ affirm total >= 0; affirm measure >= 0; }] [{ }] shrinks measure {
    if activeHeader(frame.header, start) {
        BackEdge { trunk: after, status: status, step: step, dropped: dropped } = sweepBackEdge(trunk, frame);
        return SweepResult { result: ExecutionFlowResult { status: status, block: frame.header, step: step, state: emptyState() }, dropped: dropped, exits: [], arrivals: 1, merges: 0, trunk: after };
    };
    reached = sweepReached(blocks, start, frame.header, frame.exit, total + 1);
    if sweepGraphFault(blocks, frame, reached) != 0 { return sweepFailure(3, start, -1, trunk); };
    ordering = sweepTopologicalOrder(blocks, frame.header, reached);
    if ordering.status != 0 { return sweepFailure(ordering.status, start, -1, trunk); };
    work = sweepWorkStart(start, trunk);
    for position in 0..size(ordering.order) {
        if work.settled = false {
            id = get(ordering.order, position);
            taken = linkedItems(work.pending, id);
            if size(taken) > 0 {
                work = withoutWaiting(work, id);
                if blocks.contains(id) {
                    block = blocks.lookupRef(id);
                    if (*block).end is ExecutionEnd::Loop {
                        if measure <= 0 { work = settleAt(work, 3, id, -1); } else { work = sweepLoop(blocks, frame, block, taken, work, total, measure - 1); };
                    } else { work = sweepPlain(blocks, frame, block, taken, work); };
                } else { work = settleAt(work, 3, id, -1); };
            };
        };
    };
    if work.settled = false { work = leftoverArrivals(work); };
    return sweepFinished(work);
};

// A test the state decides takes one arm only, so an arm naming a block the
// function does not have is left out here and refused if a state is ever
// delivered to it. Every other end's targets must exist.
fn testTargets(blocks: &HashMap<Int, ExecutionBlock>, yes: Int, no: Int) -> List<Int> {
    out = [];
    if blocks.contains(yes) { out = push(out, yes); };
    if blocks.contains(no) { out = push(out, no); };
    return out;
};

// Every block an end can deliver to, once each. A nested loop gives its exit
// alone: the blocks of its own region, and the blocks outside it that only
// lead to returns, belong to the sweep of that region.
fn sweepSuccessors(blocks: &HashMap<Int, ExecutionBlock>, id: Int) -> List<Int> {
    raw = [];
    if blocks.contains(id) {
        block = blocks.lookupRef(id);
        end = (*block).end;
        if end is ExecutionEnd::Jump { raw = push(raw, (end as ExecutionEnd::Jump).target); };
        if end is ExecutionEnd::Branch {
            branch = end as ExecutionEnd::Branch;
            raw = push(push(raw, branch.yes), branch.no);
        };
        if end is ExecutionEnd::BooleanBranch {
            branch = end as ExecutionEnd::BooleanBranch;
            raw = testTargets(blocks, branch.yes, branch.no);
        };
        if end is ExecutionEnd::Loop { raw = push(raw, (end as ExecutionEnd::Loop).exit); };
    };
    out = [];
    for position in 0..size(raw) {
        target = get(raw, position);
        if containsValue(out, target) = false { out = push(out, target); };
    };
    return out;
};

// The blocks this sweep is responsible for: what the start reaches without
// taking a back edge to the header or the loop's own exit.
fn sweepReached(blocks: &HashMap<Int, ExecutionBlock>, start: Int, header: Int, exit: Int, limit: Int) -> List<Int> [{ affirm limit >= 0; }] [{ }] {
    reached = push([], start);
    seen = HashSet::new();
    seen = seen.insert(start);
    at = 0;
    for round in 0..limit {
        if at < size(reached) {
            id = get(reached, at);
            at = at + 1;
            successors = sweepSuccessors(blocks, id);
            for position in 0..size(successors) {
                target = get(successors, position);
                if target != header && target != exit {
                    if seen.contains(target) = false {
                        seen = seen.insert(target);
                        reached = push(reached, target);
                    };
                };
            };
        };
    };
    if at < size(reached) { return []; };
    return reached;
};

// A graph this sweep can be trusted with. Everything it reaches is a block it
// has; a nested loop is entered at its header alone; neither that header nor
// any block of its region is a header already being swept, so the recursion
// cannot re-enter a header and its depth is bounded by the block count; and a
// block outside this region, which the language can only reach on the way to
// a return, never leads back into it.
//
// A region is the blocks that reach its header, so a nested loop whose body
// always returns adds nothing to the enclosing region and its own region is
// legitimately no part of it. Membership is checked against the block table
// and against what this sweep reached, never against the enclosing region.
fn sweepGraphFault(blocks: &HashMap<Int, ExecutionBlock>, frame: &LoopFrame, reached: &List<Int>) -> Int {
    if size(reached) = 0 { return 9; };
    active = blockSet(frame.active);
    reachedSet = blockSet(reached);
    for position in 0..size(reached) {
        id = get(reached, position);
        if blocks.contains(id) {
            block = blocks.lookupRef(id);
            end = (*block).end;
            if end is ExecutionEnd::Loop {
                inner = (end as ExecutionEnd::Loop).region;
                if active.contains(id) { return 2; };
                if containsBlock(inner, id) = false { return 4; };
                for innerPosition in 0..size(inner) {
                    member = get(inner, innerPosition);
                    if blocks.contains(member) = false { return 5; };
                    if active.contains(member) { return 3; };
                    if member != id {
                        if reachedSet.contains(member) { return 6; };
                    };
                };
            };
        } else { return 1; };
    };
    if frame.header < 0 { return 0; };
    region = blockSet(frame.region);
    for position in 0..size(reached) {
        id = get(reached, position);
        if region.contains(id) = false {
            successors = sweepSuccessors(blocks, id);
            for successorPosition in 0..size(successors) {
                target = get(successors, successorPosition);
                if target = frame.header { return 7; };
                if region.contains(target) { return 8; };
            };
        };
    };
    return 0;
};

// The reached blocks in an order where a block follows every block that can
// deliver to it, so its arrivals are all known when it is reached. A block
// left over is in a cycle the region's back edges do not account for.
fn sweepTopologicalOrder(blocks: &HashMap<Int, ExecutionBlock>, header: Int, reached: &List<Int>) -> SweepOrder {
    arriving = HashMap::new();
    for position in 0..size(reached) { arriving = arriving.insert(get(reached, position), 0); };
    for position in 0..size(reached) {
        successors = sweepSuccessors(blocks, get(reached, position));
        for successorPosition in 0..size(successors) {
            target = get(successors, successorPosition);
            if target != header {
                if arriving.contains(target) { arriving = arriving.insert(target, arriving.lookup(target, 0) + 1); };
            };
        };
    };
    ready = [];
    for position in 0..size(reached) {
        id = get(reached, position);
        if arriving.lookup(id, 0) = 0 { ready = push(ready, id); };
    };
    order = [];
    at = 0;
    for round in 0..size(reached) {
        if at < size(ready) {
            id = get(ready, at);
            at = at + 1;
            order = push(order, id);
            successors = sweepSuccessors(blocks, id);
            for successorPosition in 0..size(successors) {
                target = get(successors, successorPosition);
                if target != header {
                    if arriving.contains(target) {
                        left = arriving.lookup(target, 0) - 1;
                        arriving = arriving.insert(target, left);
                        if left = 0 { ready = push(ready, target); };
                    };
                };
            };
        };
    };
    if size(order) != size(reached) { return SweepOrder { status: 3, order: [] }; };
    return SweepOrder { status: 0, order: order };
};

fn loopEntryTerms(trunk: &Trunk, left: ValueRef, right: ValueRef, variant: ValueRef, variantOther: ValueRef, zero: ValueRef) -> LoopEntryTerms {
    missing = LoopEntryTerms { found: false, left: 0, right: 0, prior: 0, priorOther: 0, zero: 0 };
    leftValue = resolveOn(trunk, left);
    rightValue = resolveOn(trunk, right);
    old = resolveOn(trunk, variant);
    other = resolveOn(trunk, variantOther);
    zeroValue = resolveOn(trunk, zero);
    if leftValue is ValueLookup::Found {
        if rightValue is ValueLookup::Found {
            if old is ValueLookup::Found {
                if other is ValueLookup::Found {
                    if zeroValue is ValueLookup::Found {
                        zeroTerm = (zeroValue as ValueLookup::Found).term;
                        known = valueNear(trunk.state.context, trunk.index, zeroTerm);
                        if known is IntegerLookup::Found {
                            if (known as IntegerLookup::Found).value != 0 { return missing; };
                            return LoopEntryTerms { found: true, left: (leftValue as ValueLookup::Found).term, right: (rightValue as ValueLookup::Found).term, prior: (old as ValueLookup::Found).term, priorOther: (other as ValueLookup::Found).term, zero: zeroTerm };
                        };
                    };
                };
            };
        };
    };
    return missing;
};

fn loopFieldsValid(relation: Int, variantMode: Int) -> Bool {
    if relation < 0 { return false; };
    if relation > 3 { return false; };
    if variantMode < 0 { return false; };
    return variantMode <= 3;
};

fn loopTests(relation: Int, left: ValueRef, right: ValueRef, orTests: &List<LoopTest>) -> List<LoopTest> {
    tests = push([], LoopTest { relation: relation, left: left, right: right });
    for extra in orTests { tests = push(tests, clone(extra)); };
    return tests;
};

fn candidateSteps(survivors: &List<InferGoal>) -> CandidateSteps {
    assumes = [];
    checks = [];
    ends = [];
    for goalPosition in 0..size(survivors) {
        goal = get(survivors, goalPosition);
        for stepPosition in 0..size(goal.assumes) { assumes = push(assumes, clone(get(goal.assumes, stepPosition))); };
        for stepPosition in 0..size(goal.checks) { checks = push(checks, quietStep(get(goal.checks, stepPosition))); };
        ends = push(ends, size(checks));
    };
    return CandidateSteps { assumes: assumes, checks: checks, ends: ends };
};

fn withoutCandidates(survivors: &List<InferGoal>, dropped: &List<Int>) -> List<InferGoal> {
    kept = [];
    for position in 0..size(survivors) {
        if containsValue(dropped, position) = false { kept = push(kept, clone(get(survivors, position))); };
    };
    return kept;
};

fn testTerms(state: &ExecutionState, tests: &List<LoopTest>) -> List<Int> {
    terms = [];
    for test in tests {
        left = resolveValue(state, test.left);
        if left is ValueLookup::Found { terms = push(terms, (left as ValueLookup::Found).term); };
        right = resolveValue(state, test.right);
        if right is ValueLookup::Found { terms = push(terms, (right as ValueLookup::Found).term); };
    };
    return terms;
};

fn refFloor(ref: &ValueRef, least: Int) -> Int {
    if ref is ValueRef::Term {
        term = (ref as ValueRef::Term).term;
        if term < least { return term; };
    };
    return least;
};

fn refsFloor(refs: &List<ValueRef>, least: Int) -> Int {
    low = least;
    for r in refs { low = refFloor(r, low); };
    return low;
};

fn stepsFloor(steps: &List<ExecutionStep>, least: Int, depth: Int) -> Int [{ affirm depth >= 0; }] [{ }] shrinks depth {
    low = least;
    for step in steps {
        if step is ExecutionStep::Assign { low = refFloor((step as ExecutionStep::Assign).value, low); };
        if step is ExecutionStep::Apply {
            apply = step as ExecutionStep::Apply;
            low = refsFloor(apply.arguments, minInt(minInt(apply.result, apply.function), low));
        };
        if step is ExecutionStep::ApplyFresh {
            fresh = step as ExecutionStep::ApplyFresh;
            low = refsFloor(fresh.arguments, minInt(fresh.function, low));
        };
        if step is ExecutionStep::Literal {
            literal = step as ExecutionStep::Literal;
            low = refsFloor(literal.arguments, minInt(minInt(literal.result, literal.function), low));
        };
        if step is ExecutionStep::Push { pushed = step as ExecutionStep::Push; low = refFloor(pushed.list, refFloor(pushed.value, refFloor(pushed.zero, low))); };
        if step is ExecutionStep::Last { last = step as ExecutionStep::Last; low = refFloor(last.list, refFloor(last.zero, low)); };
        if step is ExecutionStep::Set { update = step as ExecutionStep::Set; low = refFloor(update.list, refFloor(update.index, refFloor(update.value, low))); };
        if step is ExecutionStep::Pop { low = refFloor((step as ExecutionStep::Pop).list, low); };
        if step is ExecutionStep::NewArray { array = step as ExecutionStep::NewArray; low = refFloor(array.length, refFloor(array.value, low)); };
        if step is ExecutionStep::RequireDefined { low = refFloor((step as ExecutionStep::RequireDefined).value, low); };
        if step is ExecutionStep::Check { check = step as ExecutionStep::Check; low = refFloor(check.left, refFloor(check.right, low)); };
        if step is ExecutionStep::Assume { assumed = step as ExecutionStep::Assume; low = refFloor(assumed.left, refFloor(assumed.right, low)); };
        if step is ExecutionStep::AssumeVariant { low = refFloor((step as ExecutionStep::AssumeVariant).object, low); };
        if step is ExecutionStep::RequireVariant { low = refFloor((step as ExecutionStep::RequireVariant).object, low); };
        if step is ExecutionStep::CheckWithin { within = step as ExecutionStep::CheckWithin; low = refFloor(within.inner, refFloor(within.outer, low)); };
        if step is ExecutionStep::AssumeForall {
            for node in (step as ExecutionStep::AssumeForall).template.nodes { low = refFloor(node.value, minInt(node.function, low)); };
        };
        if step is ExecutionStep::Scoped && depth > 0 { low = stepsFloor((step as ExecutionStep::Scoped).steps, low, depth - 1); };
    };
    return low;
};

fn endFloor(end: &ExecutionEnd, least: Int) -> Int {
    low = least;
    if end is ExecutionEnd::Branch {
        branch = end as ExecutionEnd::Branch;
        low = stepsFloor(branch.noSteps, stepsFloor(branch.yesSteps, low, maxScopeDepth()), maxScopeDepth());
    };
    if end is ExecutionEnd::BooleanBranch {
        branch = end as ExecutionEnd::BooleanBranch;
        low = refFloor(branch.value, refFloor(branch.trueValue, refFloor(branch.falseValue, low)));
    };
    if end is ExecutionEnd::Loop {
        header = end as ExecutionEnd::Loop;
        low = stepsFloor(header.assumptions, stepsFloor(header.checks, low, maxScopeDepth()), maxScopeDepth());
        low = refFloor(header.left, refFloor(header.right, refFloor(header.variant, refFloor(header.variantOther, low))));
        low = refFloor(header.zero, refFloor(header.variantObject, low));
        for orTest in header.orTests { low = refFloor(orTest.left, refFloor(orTest.right, low)); };
    };
    return low;
};

// The least id the blocks name, below which every term made while they run is new
fn blocksFloor(blocks: &List<ExecutionBlock>, least: Int) -> Int {
    low = least;
    for block in blocks { low = endFloor(block.end, stepsFloor(block.steps, low, maxScopeDepth())); };
    return low;
};

fn sweepExecution(blocks: &List<ExecutionBlock>, entry: Int, initial: &ExecutionState) -> SweepResult {
    if uniqueExecutionBlocks(blocks) = false { return withFinalState(sweepFailure(3, entry, -1, Trunk { state: clone(initial), index: noFactIndex(), trail: [], saved: [] })); };
    whole = [];
    for blockPosition in 0..size(blocks) { whole = push(whole, get(blocks, blockPosition).id); };
    outer = LoopFrame { header: -2, exit: -2, active: [], region: whole, checks: [], candChecks: [], candEnds: [], variant: ValueRef::Term { term: 0 }, variantMode: 0, variantOther: ValueRef::Term { term: 0 }, prior: 0, priorOther: 0 };
    // (the floor a caller states is trusted only as far as the scan bears it
    // out, and an id the blocks name enters the state when its step runs)
    start = ExecutionState { floor: blocksFloor(blocks, minInt(initial.floor, leastTermInUse(initial))), ..clone(initial) };
    return withFinalState(sweep(executionTable(blocks), outer, entry, Trunk { state: start, index: noFactIndex(), trail: [], saved: [] }, size(blocks), 3 * size(blocks) + 3));
};

// The verdict with the trunk's state, the state the sweep stopped in
fn withFinalState(swept: SweepResult) -> SweepResult {
    SweepResult { result: result, dropped: dropped, exits: exits, arrivals: arrivals, merges: merges, trunk: trunk } = swept;
    Trunk { state: state, index: index, trail: trail, saved: saved } = trunk;
    ExecutionFlowResult { status: status, block: block, step: step, state: none } = result;
    return SweepResult { result: ExecutionFlowResult { status: status, block: block, step: step, state: state }, dropped: dropped, exits: exits, arrivals: arrivals, merges: merges, trunk: Trunk { state: emptyState(), index: index, trail: trail, saved: saved } };
};

fn validateExecution(blocks: &List<ExecutionBlock>, entry: Int, initial: &ExecutionState) -> ExecutionFlowResult {
    return sweepExecution(blocks, entry, initial).result;
};
