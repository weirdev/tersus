import validation::context { analyzeContext, contextDifferent, contextEqual, contextWithin, contextWithinUnder, deriveSumOrders, entailsConstructorDisequality, entailsPartDisequality, entailsVariantDisequality, hasOrderFact, integerValue, integerValueIn };
import validation::differences { isSizeTerm, semanticFacts };
import validation::execution { firstRung, lastRung, sliceBudgets };
import validation::linear { linearEntailsIn };
import validation::joins { linkAppend, linkPop, linkedItems, noLinks };
import validation::model { AnalysisLookup, ApplicationTerm, CachedAnswer, ContextAnalysis, EntailmentCache, EqualityFact, ExecutionState, FactIndex, GetFact, HullLinks, IntegerLookup, NearApplications, OrderFact, RelationFact, ValidatorContext, ValidatorGoal, ValueLookup };
import validation::relations { closedDisequality, containsValue, emptyIntMap, hasDifferenceIn, intAt, leastClasses, minInt, sameIn };
import validation::sequenceFacts { finiteGetEqual, forallConstant, forallEqual, forallShift, getFactsTranslated, modDifferent, modIsSelf, setGetEqual };



// Two values of the same constructor with a pair of arguments that are
// known to differ are themselves different: constructors are free.
fn entailsConstructorArgumentDisequality(context: &ValidatorContext, classes: &HashMap<Int, Int>, left: Int, right: Int) -> Bool {
    for aPosition in 0..size(context.applications) {
        a = get(context.applications, aPosition);
        if containsValue(context.constructorFunctions, a.function) {
            for bPosition in 0..size(context.applications) {
                b = get(context.applications, bPosition);
                if sameIn(classes, a.function, b.function) {
                    if sameIn(classes, left, a.id) {
                        if sameIn(classes, right, b.id) {
                            if size(a.arguments) = size(b.arguments) {
                                for i in 0..size(a.arguments) {
                                    x = get(a.arguments, i);
                                    y = get(b.arguments, i);
                                    xv = integerValue(context, x);
                                    yv = integerValue(context, y);
                                    if xv is IntegerLookup::Found {
                                        if yv is IntegerLookup::Found {
                                            if (xv as IntegerLookup::Found).value != (yv as IntegerLookup::Found).value { return true; };
                                        };
                                    };
                                    for dPosition in 0..size(context.different) {
                                        d = get(context.different, dPosition);
                                        if sameIn(classes, d.left, x) {
                                            if sameIn(classes, d.right, y) { return true; };
                                        };
                                        if sameIn(classes, d.left, y) {
                                            if sameIn(classes, d.right, x) { return true; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn recognizedGoal(goal: ValidatorGoal) -> Bool {
    if goal is ValidatorGoal::Equal { return true; };
    if goal is ValidatorGoal::Different { return true; };
    if goal is ValidatorGoal::Less { return true; };
    if goal is ValidatorGoal::AtMost { return true; };
    if goal is ValidatorGoal::Difference { return true; };
    if goal is ValidatorGoal::Within { return true; };
    return false;
};

// What a goal needs no closure of the context for.
fn entailsGoalDirectly(context: &ValidatorContext, goal: ValidatorGoal) -> Bool {
    return entailsGoalDirectlyIn(context, leastClasses(semanticFacts(context.equalities, context.applications, context.constants)), goal);
};

// The same, given the classes of the context's semantic facts (a caller that
// asks several goals of one context makes them once)
fn entailsGoalDirectlyIn(context: &ValidatorContext, classes: &HashMap<Int, Int>, goal: ValidatorGoal) -> Bool {
    if goal is ValidatorGoal::Equal {
        g = goal as ValidatorGoal::Equal;
        if sameIn(classes, g.left, g.right) { return true; };
    };
    // A concrete comparison that already holds needs no graph closure.
    if goal is ValidatorGoal::Less {
        g = goal as ValidatorGoal::Less;
        a = integerValueIn(classes, context.constants, g.left);
        b = integerValueIn(classes, context.constants, g.right);
        if a is IntegerLookup::Found {
            if b is IntegerLookup::Found {
                if (a as IntegerLookup::Found).value < (b as IntegerLookup::Found).value { return true; };
            };
        };
    };
    if goal is ValidatorGoal::AtMost {
        g = goal as ValidatorGoal::AtMost;
        a = integerValueIn(classes, context.constants, g.left);
        b = integerValueIn(classes, context.constants, g.right);
        if a is IntegerLookup::Found {
            av = (a as IntegerLookup::Found).value;
            if b is IntegerLookup::Found {
                if av <= (b as IntegerLookup::Found).value { return true; };
            };
            // A size is never negative, whether or not the program said so.
            if av = 0 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
    };
    return false;
};

fn relationFactOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int) -> RelationFact {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function >= -11 {
            if app.function <= -6 {
                if size(app.arguments) = 2 {
                    if sameIn(classes, app.id, term) {
                        return RelationFact { function: app.function, left: get(app.arguments, 0), right: get(app.arguments, 1), found: true };
                    };
                };
            };
        };
    };
    return RelationFact { function: 0, left: 0, right: 0, found: false };
};

fn entailsUnderEquality(context: &ValidatorContext, x: Int, y: Int, u: Int, v: Int) -> Bool {
    widened = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: x, right: y }), ..clone(context) };
    analysis = analyzeContext(widened);
    if analysis.contradictory { return true; };
    return contextEqual(analysis.classes, analysis.differences, u, v);
};

// Two applications of Eq are the same boolean when their arguments match,
// when both equalities fail, or when each equality gives the other (the
// parts of a constructed value against the value itself).
// The bridge records `forall j in lo..hi: get(a, base + j) != c` as an
// application of function -31 to (a, lo, hi, base, c).
fn forallDifferentSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int) -> Bool {
    for gf in getFactsTranslated(context, analysis.classes, getTerm) {
        if forallDifferentSideFor(context, analysis, getTerm, otherTerm, gf, 2) { return true; };
    };
    return false;
};

fn forallDifferentSideFor(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int, gf: &GetFact, fuel: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks fuel {
    equalities = analysis.equalities;
    differences = analysis.differences;
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -31 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                lo = get(app.arguments, 1);
                hi = get(app.arguments, 2);
                base = get(app.arguments, 3);
                c = get(app.arguments, 4);
                if sameIn(analysis.classes, gf.seq, a) {
                    if sameIn(analysis.classes, otherTerm, c) {
                        j = gf.at;
                        jFound = false;
                        bv = integerValueIn(analysis.classes, context.constants, base);
                        if bv is IntegerLookup::Found {
                            if (bv as IntegerLookup::Found).value = 0 { jFound = true; };
                        };
                        if jFound = false {
                            for sumPosition in 0..size(context.applications) {
                                sum = get(context.applications, sumPosition);
                                if sum.function = -1 {
                                    if size(sum.arguments) = 2 {
                                        if sameIn(analysis.classes, sum.id, gf.at) {
                                            if sameIn(analysis.classes, get(sum.arguments, 0), base) { j = get(sum.arguments, 1); jFound = true; };
                                            if sameIn(analysis.classes, get(sum.arguments, 1), base) { j = get(sum.arguments, 0); jFound = true; };
                                        };
                                    };
                                };
                            };
                        };
                        if jFound {
                            if hasDifferenceIn(analysis.classes, differences, lo, j, 0) {
                                belowD = hasDifferenceIn(analysis.classes, differences, j, hi, -1);
                                if belowD = false { belowD = linearEntailsIn(context, analysis.classes, j, hi, -1); };
                                if belowD { return true; };
                                atMostD = hasDifferenceIn(analysis.classes, differences, j, hi, 0);
                                if atMostD = false { atMostD = linearEntailsIn(context, analysis.classes, j, hi, 0); };
                                if atMostD {
                                    strictContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: j, greater: hi, strict: true }), ..clone(context) };
                                    strictAnalysis = analyzeContext(strictContext);
                                    deeper = false;
                                    if fuel > 0 {
                                        for gfDeeper in getFactsTranslated(strictContext, strictAnalysis.classes, getTerm) {
                                            if deeper = false { deeper = forallDifferentSideFor(strictContext, strictAnalysis, getTerm, otherTerm, gfDeeper, fuel - 1); };
                                        };
                                    };
                                    if deeper {
                                        eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: j, right: hi }), ..clone(context) };
                                        eqAnalysis = analyzeContext(eqContext);
                                        if eqAnalysis.contradictory { return true; };
                                        if contextDifferent(eqAnalysis.equalities, eqContext.applications, eqAnalysis.orders, eqContext.different, eqAnalysis.differences, getTerm, otherTerm) { return true; };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn forallDifferent(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if forallDifferentSide(context, analysis, left, right) { return true; };
    return forallDifferentSide(context, analysis, right, left);
};

fn differentByParts(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    equalities = analysis.equalities;
    if entailsConstructorDisequality(analysis.classes, context.applications, context.constructorFunctions, left, right) { return true; };
    if entailsVariantDisequality(analysis.classes, context.variants, left, right) { return true; };
    if entailsConstructorArgumentDisequality(context, analysis.classes, left, right) { return true; };
    if contextWithinUnder(context, analysis.classes, left, right) { return true; };
    if contextWithinUnder(context, analysis.classes, right, left) { return true; };
    if entailsPartDisequality(context, analysis.classes, analysis.orders, left, right) { return true; };
    // (the analysis's equalities are closed and do not contradict its facts)
    if hasDifferenceIn(analysis.classes, analysis.differences, left, right, -1) { return true; };
    if hasDifferenceIn(analysis.classes, analysis.differences, right, left, -1) { return true; };
    return closedDisequality(analysis.classes, analysis.orders, context.different, left, right);
};

fn booleanConstantTerm(context: &ValidatorContext, term: Int) -> Bool {
    for cPosition in 0..size(context.constants) {
        if get(context.constants, cPosition).id = term && get(context.constants, cPosition).kind = 1 { return true; };
    };
    return false;
};

fn relationAppsEqual(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    // (a literal is the class of every comparison known to have its value,
    // and the classes alone decide a comparison against it)
    if booleanConstantTerm(context, left) || booleanConstantTerm(context, right) { return false; };
    equalities = analysis.equalities;
    differences = analysis.differences;
    a = relationFactOf(context, analysis.classes, left);
    b = relationFactOf(context, analysis.classes, right);
    if a.found = false { return false; };
    if b.found = false { return false; };
    if a.function != b.function { return false; };
    if a.function != -6 { return false; };
    if contextEqual(analysis.classes, differences, a.left, b.left) {
        if contextEqual(analysis.classes, differences, a.right, b.right) { return true; };
    };
    if contextEqual(analysis.classes, differences, a.left, b.right) {
        if contextEqual(analysis.classes, differences, a.right, b.left) { return true; };
    };
    if differentByParts(context, analysis, a.left, a.right) {
        if differentByParts(context, analysis, b.left, b.right) { return true; };
    };
    // (one side the same and the other two different: the two cannot both
    // hold, and they are equal only where neither can, which the case above
    // is; the search under an equality below costs a closure of the whole
    // context, and a chain of string comparisons asks it for every pair)
    if contextEqual(analysis.classes, differences, a.left, b.left) && differentByParts(context, analysis, a.right, b.right) { return false; };
    if contextEqual(analysis.classes, differences, a.right, b.right) && differentByParts(context, analysis, a.left, b.left) { return false; };
    if contextEqual(analysis.classes, differences, a.left, b.right) && differentByParts(context, analysis, a.right, b.left) { return false; };
    if contextEqual(analysis.classes, differences, a.right, b.left) && differentByParts(context, analysis, a.left, b.right) { return false; };
    if entailsUnderEquality(context, a.left, a.right, b.left, b.right) {
        if entailsUnderEquality(context, b.left, b.right, a.left, a.right) { return true; };
    };
    return false;
};

// Two lists whose elements a forall fact says are equal over the whole of
// both (get(a, j) = get(b, j) for j from 0 to at least size(a), and the
// sizes equal) are equal: a list is its size and its elements.
fn extensionalEqualities(context: &ValidatorContext, analysis: &ContextAnalysis) -> List<EqualityFact> {
    found = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -30 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                lo = integerValueIn(analysis.classes, context.constants, get(app.arguments, 2));
                base = integerValueIn(analysis.classes, context.constants, get(app.arguments, 4));
                fromZero = false;
                if lo is IntegerLookup::Found {
                    if base is IntegerLookup::Found {
                        loValue = (lo as IntegerLookup::Found).value;
                        baseValue = (base as IntegerLookup::Found).value;
                        if loValue = 0 {
                            if baseValue = 0 { fromZero = true; };
                        };
                    };
                };
                if fromZero {
                    sa = 0;
                    sb = 0;
                    haveA = false;
                    haveB = false;
                    for sizeAppPosition in 0..size(context.applications) {
                        sizeApp = get(context.applications, sizeAppPosition);
                        if sizeApp.function = -13 {
                            if size(sizeApp.arguments) = 1 {
                                if sameIn(analysis.classes, get(sizeApp.arguments, 0), a) { sa = sizeApp.id; haveA = true; };
                                if sameIn(analysis.classes, get(sizeApp.arguments, 0), b) { sb = sizeApp.id; haveB = true; };
                            };
                        };
                    };
                    if haveA {
                        if haveB {
                            if linearEntailsIn(context, analysis.classes, sa, get(app.arguments, 3), 0) {
                                if linearEntailsIn(context, analysis.classes, sa, sb, 0) && linearEntailsIn(context, analysis.classes, sb, sa, 0) {
                                    found = push(found, EqualityFact { left: a, right: b });
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return found;
};

// The equalities the forall facts give between elements the context
// already reads: get(a, k) = get(b, k) for a fact get(a, j) = get(b, j) over
// a range that holds k (only facts with no offset, and only elements both
// lists are read at)
fn forallInstanceEqualities(context: &ValidatorContext, analysis: &ContextAnalysis) -> List<EqualityFact> {
    found = [];
    gets = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -14 { if size(app.arguments) = 2 { gets = push(gets, clone(app)); }; };
    };
    for factPosition in 0..size(context.applications) {
        fact = get(context.applications, factPosition);
        if fact.function = -30 {
            if size(fact.arguments) = 5 {
                a = get(fact.arguments, 0);
                b = get(fact.arguments, 1);
                lo = get(fact.arguments, 2);
                hi = get(fact.arguments, 3);
                baseValue = integerValueIn(analysis.classes, context.constants, get(fact.arguments, 4));
                noOffset = false;
                if baseValue is IntegerLookup::Found { if (baseValue as IntegerLookup::Found).value = 0 { noOffset = true; }; };
                if noOffset {
                    onA = [];
                    onB = [];
                    for gPosition in 0..size(gets) {
                        g = get(gets, gPosition);
                        if size(g.arguments) = 2 {
                            if sameIn(analysis.classes, get(g.arguments, 0), a) { onA = push(onA, clone(g)); };
                            if sameIn(analysis.classes, get(g.arguments, 0), b) { onB = push(onB, clone(g)); };
                        };
                    };
                    for g1Position in 0..size(onA) {
                        g1 = get(onA, g1Position);
                        k = intAt(g1.arguments, 1, 0);
                        for g2Position in 0..size(onB) {
                            g2 = get(onB, g2Position);
                            if size(found) < 8 {
                                if size(g2.arguments) = 2 && sameIn(analysis.classes, get(g2.arguments, 1), k) {
                                    if sameIn(analysis.classes, g1.id, g2.id) = false {
                                        if linearEntailsIn(context, analysis.classes, lo, k, 0) {
                                            if linearEntailsIn(context, analysis.classes, k, hi, -1) {
                                                found = push(found, EqualityFact { left: g1.id, right: g2.id });
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return found;
};

fn entailsGoalAnalyzed(context: &ValidatorContext, analysis: &ContextAnalysis, goal: ValidatorGoal) -> Bool {
    if analysis.contradictory { return true; };
    if goal is ValidatorGoal::Equal {
        g = goal as ValidatorGoal::Equal;
        // (the analysis's classes hold what congruence gives and what orders
        // imply: a <= b and b <= a)
        if contextEqual(analysis.classes, analysis.differences, g.left, g.right) { return true; };
        if forallEqual(context, analysis, g.left, g.right) { return true; };
        if forallConstant(context, analysis, g.left, g.right) { return true; };
        if forallShift(context, analysis, g.left, g.right) { return true; };
        if modIsSelf(context, analysis, g.left, g.right) { return true; };
        if finiteGetEqual(context, analysis, g.left, g.right) { return true; };
        if setGetEqual(context, analysis, g.left, g.right) { return true; };
        if relationAppsEqual(context, analysis, g.left, g.right) { return true; };
        derived = extensionalEqualities(context, analysis);
        for instance in forallInstanceEqualities(context, analysis) { derived = push(derived, instance); };
        if size(derived) > 0 {
            widerEqualities = clone(context.equalities);
            for d in derived { widerEqualities = push(widerEqualities, d); };
            wider = ValidatorContext { equalities: widerEqualities, ..clone(context) };
            widerAnalysis = analyzeContext(wider);
            if widerAnalysis.contradictory { return true; };
            if contextEqual(widerAnalysis.classes, widerAnalysis.differences, g.left, g.right) { return true; };
        };
        if linearEntailsIn(context, analysis.classes, g.left, g.right, 0) { return linearEntailsIn(context, analysis.classes, g.right, g.left, 0); };
        return false;
    };
    if goal is ValidatorGoal::Different {
        g = goal as ValidatorGoal::Different;
        if entailsConstructorDisequality(analysis.classes, context.applications, context.constructorFunctions, g.left, g.right) { return true; };
        if entailsVariantDisequality(analysis.classes, context.variants, g.left, g.right) { return true; };
        if entailsConstructorArgumentDisequality(context, analysis.classes, g.left, g.right) { return true; };
        // (the analysis's equalities are closed and do not contradict its facts)
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, -1) { return true; };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.right, g.left, -1) { return true; };
        if closedDisequality(analysis.classes, analysis.orders, context.different, g.left, g.right) { return true; };
        if contextWithinUnder(context, analysis.classes, g.left, g.right) { return true; };
        if contextWithinUnder(context, analysis.classes, g.right, g.left) { return true; };
        if entailsPartDisequality(context, analysis.classes, analysis.orders, g.left, g.right) { return true; };
        if forallDifferent(context, analysis, g.left, g.right) { return true; };
        return modDifferent(context, analysis, g.left, g.right);
    };
    if goal is ValidatorGoal::Less {
        g = goal as ValidatorGoal::Less;
        lv = integerValueIn(analysis.classes, context.constants, g.left);
        if lv is IntegerLookup::Found {
            if (lv as IntegerLookup::Found).value <= -1 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, -1) { return true; };
        return linearEntailsIn(context, analysis.classes, g.left, g.right, -1);
    };
    if goal is ValidatorGoal::AtMost {
        g = goal as ValidatorGoal::AtMost;
        lv = integerValueIn(analysis.classes, context.constants, g.left);
        if lv is IntegerLookup::Found {
            if (lv as IntegerLookup::Found).value <= 0 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, 0) { return true; };
        return linearEntailsIn(context, analysis.classes, g.left, g.right, 0);
    };
    if goal is ValidatorGoal::Difference {
        g = goal as ValidatorGoal::Difference;
        return hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, g.bound);
    };
    if goal is ValidatorGoal::Within {
        g = goal as ValidatorGoal::Within;
        return contextWithin(context, g.inner, g.outer);
    };
    return false;
};

// Return the first unproved obligation; -1 means that every check succeeded.
// Assumptions made later in the list cannot justify an earlier assertion.
fn deriveRefinedOrders(context: &ValidatorContext) -> ValidatorContext {
    facts = clone(context.orders);
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    for orderPosition in 0..size(context.orders) {
        order = get(context.orders, orderPosition);
        if order.strict = false {
            refined = false;
            for dPosition in 0..size(context.different) {
                d = get(context.different, dPosition);
                if sameIn(equalitiesClasses, d.left, order.smaller) && sameIn(equalitiesClasses, d.right, order.greater) { refined = true; };
                if sameIn(equalitiesClasses, d.left, order.greater) && sameIn(equalitiesClasses, d.right, order.smaller) { refined = true; };
            };
            if refined {
                if hasOrderFact(facts, order.smaller, order.greater) = false || true {
                    facts = push(facts, OrderFact { smaller: order.smaller, greater: order.greater, strict: true });
                };
            };
        };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

fn entailmentCache(context: &ValidatorContext) -> EntailmentCache {
    return EntailmentCache { plain: clone(context), plainClassesMade: false, plainClasses: emptyIntMap(), plainAnalysis: AnalysisLookup::Missing, derivedMade: false, derived: clone(context), derivedAnalysis: AnalysisLookup::Missing };
};

// The cache with its analysis made, and the contract that says so. Making it
// inline leaves the cast on the far side of the join of that test, where one
// arm states Found and the other states not-Missing: two different facts, and
// a merge keeps only what both arms state. A return path states it once.
fn withPlainAnalysis(cache: EntailmentCache) -> EntailmentCache [{ }] [{ affirm return.plainAnalysis is AnalysisLookup::Found; }] {
    if cache.plainAnalysis is AnalysisLookup::Missing {
        return EntailmentCache { plainAnalysis: AnalysisLookup::Found { analysis: analyzeContext(cache.plain) }, ..cache };
    };
    return cache;
};

fn withDerivedAnalysis(cache: EntailmentCache) -> EntailmentCache [{ }] [{ affirm return.derivedAnalysis is AnalysisLookup::Found; }] {
    if cache.derivedAnalysis is AnalysisLookup::Missing {
        return EntailmentCache { derivedAnalysis: AnalysisLookup::Found { analysis: analyzeContext(cache.derived) }, ..cache };
    };
    return cache;
};

// Whether any of the goals holds: each is tried on the context, then each on
// the derived context, which is made only when none held on the first.
fn entailsAnyCached(cache: EntailmentCache, goals: &List<ValidatorGoal>) -> CachedAnswer {
    c = cache;
    recognized = false;
    for gPosition in 0..size(goals) {
        if recognizedGoal(get(goals, gPosition)) { recognized = true; };
    };
    if recognized = false { return CachedAnswer { holds: false, cache: c }; };
    if c.plainClassesMade = false {
        c = EntailmentCache { plainClasses: leastClasses(semanticFacts(c.plain.equalities, c.plain.applications, c.plain.constants)), plainClassesMade: true, ..c };
    };
    for gPosition in 0..size(goals) {
        g = get(goals, gPosition);
        if recognizedGoal(g) {
            if entailsGoalDirectlyIn(c.plain, c.plainClasses, g) { return CachedAnswer { holds: true, cache: c }; };
        };
    };
    if recognized {
        c = withPlainAnalysis(c);
        plainAnalysis = (clone(c.plainAnalysis) as AnalysisLookup::Found).analysis;
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalAnalyzed(c.plain, plainAnalysis, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
    };
    if recognized {
        if c.derivedMade = false {
            c = EntailmentCache { derived: deriveRefinedOrders(deriveSumOrders(c.plain)), derivedMade: true, ..c };
        };
        // (the derived context has more orders only: the classes of its
        // equalities, applications and constants are the plain one's)
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalDirectlyIn(c.derived, c.plainClasses, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
        c = withDerivedAnalysis(c);
        derivedAnalysis = (clone(c.derivedAnalysis) as AnalysisLookup::Found).analysis;
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalAnalyzed(c.derived, derivedAnalysis, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
    };
    return CachedAnswer { holds: false, cache: c };
};

fn entailsGoalCached(cache: EntailmentCache, goal: ValidatorGoal) -> CachedAnswer {
    return entailsAnyCached(cache, push([], goal));
};

fn entailsGoal(context: &ValidatorContext, goal: ValidatorGoal) -> Bool {
    return entailsGoalCached(entailmentCache(context), goal).holds;
};

fn noFactIndex() -> FactIndex {
    return FactIndex { equalities: noLinks(), applications: noLinks(), orders: noLinks(), different: noLinks(), variants: noLinks(), differences: noLinks(), weights: emptyIntMap(), constantAt: emptyIntMap(), valueAt: emptyIntMap(), counts: push(push(push(push(push(push(push([], 0), 0), 0), 0), 0), 0), 0), work: 0 };
};

// A fact costs 1, plus 2 per term it mentions: reaching the term and copying
// the one constant fact a reached term brings with it. A term's weight sums
// that over its links, so it bounds what expanding the term is charged.
fn termCost() -> Int { return 2; };

fn addWeight(weights: HashMap<Int, Int>, term: Int, cost: Int) -> HashMap<Int, Int> {
    w = weights.lookup(term, 0);
    return weights.insert(term, w + cost);
};

// (a count past the list's size, which a step that drops facts leaves, starts
// at the end: those positions are not indexed)
fn indexedFrom(counts: &List<Int>, k: Int, limit: Int) -> Int [{ affirm limit >= 0; }] [{ affirm return >= 0; affirm return <= limit; }] {
    start = intAt(counts, k, 0);
    if start < 0 { return 0; };
    if start > limit { return limit; };
    return start;
};

// The index extended with the facts appended since it was last extended
fn indexFacts(index: FactIndex, context: &ValidatorContext) -> FactIndex {
    FactIndex { equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, weights: weights, constantAt: constantAt, valueAt: valueAt, counts: counts, work: work } = index;
    binary = 1 + 2 * termCost();
    for p in indexedFrom(counts, 0, size(context.equalities))..size(context.equalities) {
        f = get(context.equalities, p);
        equalities = linkAppend(linkAppend(equalities, f.left, p), f.right, p);
        weights = addWeight(addWeight(weights, f.left, binary), f.right, binary);
        work = work + 3;
    };
    for p in indexedFrom(counts, 1, size(context.applications))..size(context.applications) {
        a = get(context.applications, p);
        cost = 1 + (1 + size(a.arguments)) * termCost();
        applications = linkAppend(applications, a.id, p);
        weights = addWeight(weights, a.id, cost);
        // (a function id is entered with no weight, so that every id the facts
        // mention is a key: termInUse asks the weights whether an id is taken)
        if weights.contains(a.function) = false { weights = weights.insert(a.function, 0); };
        for k in 0..size(a.arguments) {
            applications = linkAppend(applications, get(a.arguments, k), p);
            weights = addWeight(weights, get(a.arguments, k), cost);
        };
        work = work + 2 + size(a.arguments);
    };
    for p in indexedFrom(counts, 2, size(context.constants))..size(context.constants) {
        c = get(context.constants, p);
        if constantAt.contains(c.id) = false { constantAt = constantAt.insert(c.id, p); };
        // (the first term stated to have an integer value, for a step that needs a term of that value)
        if c.kind = 0 && valueAt.contains(c.value) = false { valueAt = valueAt.insert(c.value, c.id); };
        work = work + 1;
    };
    for p in indexedFrom(counts, 3, size(context.orders))..size(context.orders) {
        f = get(context.orders, p);
        orders = linkAppend(linkAppend(orders, f.smaller, p), f.greater, p);
        weights = addWeight(addWeight(weights, f.smaller, binary), f.greater, binary);
        work = work + 3;
    };
    for p in indexedFrom(counts, 4, size(context.different))..size(context.different) {
        f = get(context.different, p);
        different = linkAppend(linkAppend(different, f.left, p), f.right, p);
        weights = addWeight(addWeight(weights, f.left, binary), f.right, binary);
        work = work + 3;
    };
    for p in indexedFrom(counts, 5, size(context.variants))..size(context.variants) {
        f = get(context.variants, p);
        variants = linkAppend(variants, f.object, p);
        weights = addWeight(weights, f.object, 1 + termCost());
        work = work + 2;
    };
    for p in indexedFrom(counts, 6, size(context.differences))..size(context.differences) {
        f = get(context.differences, p);
        differences = linkAppend(linkAppend(differences, f.left, p), f.right, p);
        weights = addWeight(addWeight(weights, f.left, binary), f.right, binary);
        work = work + 3;
    };
    sizes = push(push(push(push(push(push(push([], size(context.equalities)), size(context.applications)), size(context.constants)), size(context.orders)), size(context.different)), size(context.variants)), size(context.differences));
    return FactIndex { equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, weights: weights, constantAt: constantAt, valueAt: valueAt, counts: sizes, work: work };
};

fn clampedStart(from: Int, limit: Int) -> Int [{ affirm limit >= 0; }] [{ affirm return >= 0; affirm return <= limit; }] {
    if from < 0 { return 0; };
    if from > limit { return limit; };
    return from;
};

// The facts of a list from position from up to position to, then rest
fn spanThen<T: Clone>(facts: &List<T>, from: Int, to: Int, rest: &List<T>) -> List<T> {
    out = [];
    end = clampedStart(to, size(facts));
    for p in clampedStart(from, end)..end { out = push(out, clone(get(facts, p))); };
    for f in rest { out = push(out, clone(f)); };
    return out;
};

fn truncatedTo<T>(facts: List<T>, length: Int) -> List<T> {
    out = facts;
    while size(out) > length && size(out) > 0 [{ affirm size(out) >= 0; }] shrinks size(out) { out = pop(out); };
    return out;
};

fn appended<T: Clone>(facts: List<T>, more: &List<T>) -> List<T> {
    out = facts;
    for f in more { out = push(out, clone(f)); };
    return out;
};

// The facts of a context from one size of each list (in the order of
// contextSizes) to another, then those of rest; no metadata
fn factsBetween(context: &ValidatorContext, from: &List<Int>, to: &List<Int>, rest: &ValidatorContext) -> ValidatorContext {
    return ValidatorContext {
        equalities: spanThen(context.equalities, intAt(from, 0, 0), intAt(to, 0, 0), rest.equalities),
        applications: spanThen(context.applications, intAt(from, 1, 0), intAt(to, 1, 0), rest.applications),
        constants: spanThen(context.constants, intAt(from, 2, 0), intAt(to, 2, 0), rest.constants),
        orders: spanThen(context.orders, intAt(from, 3, 0), intAt(to, 3, 0), rest.orders),
        different: spanThen(context.different, intAt(from, 4, 0), intAt(to, 4, 0), rest.different),
        variants: spanThen(context.variants, intAt(from, 5, 0), intAt(to, 5, 0), rest.variants),
        fieldFunctions: [], constructorFunctions: [], constructorFields: [],
        differences: spanThen(context.differences, intAt(from, 6, 0), intAt(to, 6, 0), rest.differences) };
};

// The context with the facts of more appended to each list
fn withFacts(context: ValidatorContext, more: &ValidatorContext) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    return ValidatorContext { equalities: appended(equalities, more.equalities), applications: appended(applications, more.applications), constants: appended(constants, more.constants), orders: appended(orders, more.orders), different: appended(different, more.different), variants: appended(variants, more.variants), fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: appended(differences, more.differences) };
};

fn truncatedContext(context: ValidatorContext, sizes: &List<Int>) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    return ValidatorContext { equalities: truncatedTo(equalities, intAt(sizes, 0, 0)), applications: truncatedTo(applications, intAt(sizes, 1, 0)), constants: truncatedTo(constants, intAt(sizes, 2, 0)), orders: truncatedTo(orders, intAt(sizes, 3, 0)), different: truncatedTo(different, intAt(sizes, 4, 0)), variants: truncatedTo(variants, intAt(sizes, 5, 0)), fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: truncatedTo(differences, intAt(sizes, 6, 0)) };
};

fn lessWeight(weights: HashMap<Int, Int>, term: Int, cost: Int) -> HashMap<Int, Int> {
    return weights.insert(term, weights.lookup(term, 0) - cost);
};

// Links of two-term facts from one position down to another, newest first,
// the right term's link before the left's (the reverse of indexFacts)
struct PairsPopped { links: HullLinks, weights: HashMap<Int, Int>, ok: Bool };

fn popPairLinks(links: HullLinks, weights: HashMap<Int, Int>, lefts: &List<Int>, rights: &List<Int>, from: Int) -> PairsPopped {
    ok = size(lefts) = size(rights);
    binary = 1 + 2 * termCost();
    for back in 0..size(rights) {
        k = size(rights) - 1 - back;
        right = linkPop(links, intAt(rights, k, 0), from + k);
        left = linkPop(right.links, intAt(lefts, k, 0), from + k);
        links = left.links;
        ok = ok && right.ok && left.ok;
        weights = lessWeight(lessWeight(weights, intAt(rights, k, 0), binary), intAt(lefts, k, 0), binary);
    };
    return PairsPopped { links: links, weights: weights, ok: ok };
};

fn endFor(counts: &List<Int>, sizes: &List<Int>, k: Int, limit: Int) -> Int [{ affirm limit >= 0; }] [{ affirm return >= 0; affirm return <= limit; }] {
    return clampedStart(minInt(intAt(counts, k, 0), intAt(sizes, k, 0)), limit);
};

struct IndexPop { index: FactIndex, ok: Bool };

// The index without the links of the facts at and past sizes (the context is
// the one they were indexed from), taken off in the reverse of the order
// indexFacts made them. ok is false when a link is not where that order puts
// it, which would mean the index is not this context's.
fn unindexed(index: FactIndex, context: &ValidatorContext, sizes: &List<Int>) -> IndexPop {
    FactIndex { equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, weights: weights, constantAt: constantAt, valueAt: valueAt, counts: counts, work: work } = index;
    ok = true;
    lefts = [];
    rights = [];
    to0 = indexedFrom(counts, 0, size(context.equalities));
    from0 = endFor(counts, sizes, 0, to0);
    for p in from0..to0 { lefts = push(lefts, get(context.equalities, p).left); rights = push(rights, get(context.equalities, p).right); };
    popped = popPairLinks(equalities, weights, lefts, rights, from0);
    PairsPopped { links: equalities, weights: weights, ok: okEqualities } = popped;
    ok = ok && okEqualities;
    appTo = indexedFrom(counts, 1, size(context.applications));
    appFrom = endFor(counts, sizes, 1, appTo);
    for back in 0..appTo - appFrom {
        p = appTo - 1 - back;
        if p >= 0 && p < size(context.applications) {
            a = get(context.applications, p);
            cost = 1 + (1 + size(a.arguments)) * termCost();
            for k in 0..size(a.arguments) {
                argument = intAt(a.arguments, size(a.arguments) - 1 - k, 0);
                took = linkPop(applications, argument, p);
                applications = took.links;
                ok = ok && took.ok;
                weights = lessWeight(weights, argument, cost);
            };
            took = linkPop(applications, a.id, p);
            applications = took.links;
            ok = ok && took.ok;
            weights = lessWeight(weights, a.id, cost);
        } else { ok = false; };
    };
    constTo = indexedFrom(counts, 2, size(context.constants));
    constFrom = endFor(counts, sizes, 2, constTo);
    for back in 0..constTo - constFrom {
        p = constTo - 1 - back;
        if p >= 0 && p < size(context.constants) {
            c = get(context.constants, p);
            if constantAt.lookup(c.id, -1) = p { constantAt = constantAt.remove(c.id); };
            // (a value whose first term was this one's is forgotten even when
            // an earlier fact of the same term states it too: a miss, never a
            // stale term)
            if c.kind = 0 && valueAt.contains(c.value) && valueAt.lookup(c.value, 0) = c.id { valueAt = valueAt.remove(c.value); };
        } else { ok = false; };
    };
    lefts = [];
    rights = [];
    to3 = indexedFrom(counts, 3, size(context.orders));
    from3 = endFor(counts, sizes, 3, to3);
    for p in from3..to3 { lefts = push(lefts, get(context.orders, p).smaller); rights = push(rights, get(context.orders, p).greater); };
    poppedOrders = popPairLinks(orders, weights, lefts, rights, from3);
    PairsPopped { links: orders, weights: weights, ok: okOrders } = poppedOrders;
    ok = ok && okOrders;
    lefts = [];
    rights = [];
    to4 = indexedFrom(counts, 4, size(context.different));
    from4 = endFor(counts, sizes, 4, to4);
    for p in from4..to4 { lefts = push(lefts, get(context.different, p).left); rights = push(rights, get(context.different, p).right); };
    poppedDifferent = popPairLinks(different, weights, lefts, rights, from4);
    PairsPopped { links: different, weights: weights, ok: okDifferent } = poppedDifferent;
    ok = ok && okDifferent;
    varTo = indexedFrom(counts, 5, size(context.variants));
    varFrom = endFor(counts, sizes, 5, varTo);
    for back in 0..varTo - varFrom {
        p = varTo - 1 - back;
        if p >= 0 && p < size(context.variants) {
            object = get(context.variants, p).object;
            took = linkPop(variants, object, p);
            variants = took.links;
            ok = ok && took.ok;
            weights = lessWeight(weights, object, 1 + termCost());
        } else { ok = false; };
    };
    lefts = [];
    rights = [];
    to6 = indexedFrom(counts, 6, size(context.differences));
    from6 = endFor(counts, sizes, 6, to6);
    for p in from6..to6 { lefts = push(lefts, get(context.differences, p).left); rights = push(rights, get(context.differences, p).right); };
    poppedDifferences = popPairLinks(differences, weights, lefts, rights, from6);
    PairsPopped { links: differences, weights: weights, ok: okDifferences } = poppedDifferences;
    ok = ok && okDifferences;
    kept = [];
    for k in 0..7 { kept = push(kept, minInt(intAt(counts, k, 0), intAt(sizes, k, 0))); };
    return IndexPop { index: FactIndex { equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, weights: weights, constantAt: constantAt, valueAt: valueAt, counts: kept, work: work }, ok: ok };
};

struct Truncated { state: ExecutionState, index: FactIndex };

// The state with each fact list cut back to sizes, and its index with them
// (built again should the index turn out not to be the state's)
fn truncatedState(state: ExecutionState, index: FactIndex, sizes: &List<Int>) -> Truncated {
    popped = unindexedState(index, state, sizes);
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    cut = truncatedContext(context, sizes);
    IndexPop { index: kept, ok: ok } = popped;
    if ok = false { kept = indexFacts(noFactIndex(), cut); };
    return Truncated { state: ExecutionState { context: cut, locals: locals, templates: templates, floor: floor }, index: kept };
};

fn unindexedState(index: FactIndex, state: &ExecutionState, sizes: &List<Int>) -> IndexPop {
    return unindexed(index, state.context, sizes);
};

fn goalTerms(goal: &ValidatorGoal) -> List<Int> {
    if goal is ValidatorGoal::Equal { g = goal as ValidatorGoal::Equal; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Different { g = goal as ValidatorGoal::Different; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Less { g = goal as ValidatorGoal::Less; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::AtMost { g = goal as ValidatorGoal::AtMost; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Difference { g = goal as ValidatorGoal::Difference; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Within { g = goal as ValidatorGoal::Within; return push(push([], g.inner), g.outer); };
    return [];
};

// The facts a budgeted walk from the goal terms admits; admitted is the work
// charged, operations the work done, and capped whether a term was left
// unexpanded for the budget (with none, a larger budget walks the same slice).
struct GoalSlice { slice: ValidatorContext, reached: HashSet<Int>, next: List<Int>, equalities: HashSet<Int>, applications: HashSet<Int>, orders: HashSet<Int>, different: HashSet<Int>, variants: HashSet<Int>, differences: HashSet<Int>, admitted: Int, operations: Int, capped: Bool };

// A constant is copied in with what reached it but links nothing further.
fn sliceReach(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    if walk.reached.contains(term) { return walk; };
    GoalSlice { slice: slice, reached: reached, next: next, equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, admitted: admitted, operations: operations, capped: capped } = walk;
    reached = reached.insert(term);
    operations = operations + 1;
    at = index.constantAt.lookup(term, -1);
    if at >= 0 {
        if at < size(context.constants) {
            slice = ValidatorContext { constants: push(slice.constants, clone(get(context.constants, at))), ..slice };
            operations = operations + 1;
        };
    } else {
        next = push(next, term);
    };
    return GoalSlice { slice: slice, reached: reached, next: next, equalities: equalities, applications: applications, orders: orders, different: different, variants: variants, differences: differences, admitted: admitted, operations: operations, capped: capped };
};

fn expandEqualities(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.equalities, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.equalities) && w.equalities.contains(p) = false {
            f = get(context.equalities, p);
            slice = w.slice;
            w = GoalSlice { equalities: w.equalities.insert(p), slice: ValidatorContext { equalities: push(slice.equalities, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            w = sliceReach(sliceReach(w, context, index, f.left), context, index, f.right);
        };
    };
    return w;
};

fn expandApplications(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.applications, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.applications) && w.applications.contains(p) = false {
            a = get(context.applications, p);
            slice = w.slice;
            w = GoalSlice { applications: w.applications.insert(p), slice: ValidatorContext { applications: push(slice.applications, clone(a)), ..slice }, admitted: w.admitted + (1 + size(a.arguments)) * termCost(), ..w };
            w = sliceReach(w, context, index, a.id);
            for j in 0..size(a.arguments) { w = sliceReach(w, context, index, get(a.arguments, j)); };
        };
    };
    return w;
};

fn expandOrders(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.orders, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.orders) && w.orders.contains(p) = false {
            f = get(context.orders, p);
            slice = w.slice;
            w = GoalSlice { orders: w.orders.insert(p), slice: ValidatorContext { orders: push(slice.orders, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            w = sliceReach(sliceReach(w, context, index, f.smaller), context, index, f.greater);
        };
    };
    return w;
};

fn expandDifferent(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.different, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.different) && w.different.contains(p) = false {
            f = get(context.different, p);
            slice = w.slice;
            w = GoalSlice { different: w.different.insert(p), slice: ValidatorContext { different: push(slice.different, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            w = sliceReach(sliceReach(w, context, index, f.left), context, index, f.right);
        };
    };
    return w;
};

fn expandVariants(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.variants, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.variants) && w.variants.contains(p) = false {
            f = get(context.variants, p);
            slice = w.slice;
            w = GoalSlice { variants: w.variants.insert(p), slice: ValidatorContext { variants: push(slice.variants, clone(f)), ..slice }, admitted: w.admitted + termCost(), ..w };
            w = sliceReach(w, context, index, f.object);
        };
    };
    return w;
};

fn expandDifferences(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.differences, term);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.differences) && w.differences.contains(p) = false {
            f = get(context.differences, p);
            slice = w.slice;
            w = GoalSlice { differences: w.differences.insert(p), slice: ValidatorContext { differences: push(slice.differences, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            w = sliceReach(sliceReach(w, context, index, f.left), context, index, f.right);
        };
    };
    return w;
};

fn expandTerm(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, term: Int) -> GoalSlice {
    w = expandApplications(expandEqualities(walk, context, index, term), context, index, term);
    w = expandDifferent(expandOrders(w, context, index, term), context, index, term);
    return expandDifferences(expandVariants(w, context, index, term), context, index, term);
};

// Two constants are never expanded, so a fact between them is admitted only
// here, from the lighter one's links, when both are the seeds (or a fact of
// one with itself, when it is both: c != c from a loop's exit edge).
fn linkConstants(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, light: Int, other: Int) -> GoalSlice {
    w = walk;
    positions = linkedItems(index.equalities, light);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.equalities) && w.equalities.contains(p) = false {
            f = get(context.equalities, p);
            if (f.left = light && f.right = other) || (f.left = other && f.right = light) {
                slice = w.slice;
                w = GoalSlice { equalities: w.equalities.insert(p), slice: ValidatorContext { equalities: push(slice.equalities, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            };
        };
    };
    positions = linkedItems(index.orders, light);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.orders) && w.orders.contains(p) = false {
            f = get(context.orders, p);
            if (f.smaller = light && f.greater = other) || (f.smaller = other && f.greater = light) {
                slice = w.slice;
                w = GoalSlice { orders: w.orders.insert(p), slice: ValidatorContext { orders: push(slice.orders, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            };
        };
    };
    positions = linkedItems(index.different, light);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.different) && w.different.contains(p) = false {
            f = get(context.different, p);
            if (f.left = light && f.right = other) || (f.left = other && f.right = light) {
                slice = w.slice;
                w = GoalSlice { different: w.different.insert(p), slice: ValidatorContext { different: push(slice.different, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            };
        };
    };
    positions = linkedItems(index.differences, light);
    for k in 0..size(positions) {
        p = get(positions, k);
        w = GoalSlice { operations: w.operations + 1, admitted: w.admitted + 1, ..w };
        if p >= 0 && p < size(context.differences) && w.differences.contains(p) = false {
            f = get(context.differences, p);
            if (f.left = light && f.right = other) || (f.left = other && f.right = light) {
                slice = w.slice;
                w = GoalSlice { differences: w.differences.insert(p), slice: ValidatorContext { differences: push(slice.differences, clone(f)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
            };
        };
    };
    return w;
};

struct ChainSeeds { walk: GoalSlice, fs: List<Int>, bs: List<Int> };

// The facts along the chain of blocks a goal's accessor reads through. For
// each f(b) the goal is made of (or reads a list of), the walk goes back from
// b to the terms it was made from (the arguments of b's application) and to
// the terms it equals, and at each takes f of that term with the facts on it.
// The blocks are hubs: they are searched for those links, never expanded.
// Every link it looks at is charged, and it stops at budget units.
fn chainSlice(context: &ValidatorContext, index: &FactIndex, seeds: &List<Int>, budget: Int, walk: GoalSlice) -> ValidatorContext {
    limit = walk.admitted + budget;
    chain = ChainSeeds { walk: walk, fs: [], bs: [] };
    for s in 0..size(seeds) { chain = chainPairs(chain, context, index, get(seeds, s), limit, 1); };
    ChainSeeds { walk: w, fs: fs, bs: bs } = chain;
    for c in 0..size(fs) {
        w = followChain(w, context, index, intAt(fs, c, 0), intAt(bs, c, 0), limit);
    };
    return inContextOrder(context, w);
};

// The (f, b) of each f(b) that makes the term, and (one level down) that makes
// an argument of what makes it: the list a read reads, the origin an extent is of
fn chainPairs(given: ChainSeeds, context: &ValidatorContext, index: &FactIndex, term: Int, limit: Int, depth: Int) -> ChainSeeds [{ affirm depth >= 0; }] [{ }] shrinks depth {
    ChainSeeds { walk: w, fs: fs, bs: bs } = given;
    made = [];
    at = index.applications.first.lookup(term, -1);
    walked = 0;
    linkCount = size(index.applications.items);
    room = w.admitted < limit;
    while at >= 0 && at < size(index.applications.items) && walked < linkCount && room [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
        w = GoalSlice { admitted: w.admitted + 1, operations: w.operations + 1, ..w };
        p = get(index.applications.items, at);
        if p >= 0 && p < size(context.applications) {
            if get(context.applications, p).id = term { made = push(made, clone(get(context.applications, p))); };
        };
        at = intAt(index.applications.next, at, -1);
        walked = walked + 1;
        room = w.admitted < limit;
    };
    chain = ChainSeeds { walk: w, fs: fs, bs: bs };
    for m in 0..size(made) {
        a = get(made, m);
        if size(a.arguments) = 1 { chain = withPair(chain, a.function, get(a.arguments, 0)); };
        if depth > 0 {
            for x in a.arguments { chain = chainPairs(chain, context, index, x, limit, depth - 1); };
        };
    };
    return chain;
};

fn withPair(given: ChainSeeds, f: Int, b: Int) -> ChainSeeds {
    for k in 0..size(given.fs) {
        if intAt(given.fs, k, 0) = f && intAt(given.bs, k, 0) = b { return given; };
    };
    ChainSeeds { walk: w, fs: fs, bs: bs } = given;
    return ChainSeeds { walk: w, fs: push(fs, f), bs: push(bs, b) };
};

fn smaller(a: Int, b: Int, lo: Int) -> Int [{ affirm a > lo; affirm b > lo; }] [{ affirm return > lo; affirm return <= a; affirm return <= b; }] {
    if a < b { return a; };
    return b;
};

fn mergeRuns(xs: &List<Int>, width: Int) -> List<Int> [{ affirm width >= 1; }] [{ }] {
    n = size(xs);
    out = [];
    i = 0;
    while i < n [{ affirm i >= 0; affirm i <= n; }] shrinks n - i {
        mid = smaller(i + width, n, i);
        hi = smaller(mid + width, n, mid - 1);
        a = i;
        b = mid;
        while a < mid && b < hi [{ affirm a >= i; affirm a <= mid; affirm b >= mid; affirm b <= hi; }] shrinks mid - a + hi - b {
            if get(xs, a) <= get(xs, b) { out = push(out, get(xs, a)); a = a + 1; } else { out = push(out, get(xs, b)); b = b + 1; };
        };
        while a < mid [{ affirm a >= i; }] shrinks mid - a { out = push(out, get(xs, a)); a = a + 1; };
        while b < hi [{ affirm b >= mid; }] shrinks hi - b { out = push(out, get(xs, b)); b = b + 1; };
        i = hi;
    };
    return out;
};

// The integers in increasing order: merge passes over runs of width 1, 2, 4, ...
fn sortedPositions(given: List<Int>) -> List<Int> {
    sorted = given;
    n = size(sorted);
    width = 1;
    while width < n [{ affirm width >= 1; }] shrinks n - width {
        sorted = mergeRuns(sorted, width);
        width = width * 2;
    };
    return sorted;
};

// The slice's facts in the order the context has them: the read-over-write
// split tries the newest reads first, and the order a walk admits facts in
// would put the goal's own read among the oldest. Only the slice's positions
// are sorted, so the cost is that of the slice, not of the context.
fn inContextOrder(context: &ValidatorContext, w: &GoalSlice) -> ValidatorContext {
    out = ValidatorContext { equalities: [], applications: [], constants: clone(w.slice.constants), orders: [], different: [], variants: [], fieldFunctions: clone(context.fieldFunctions), constructorFunctions: clone(context.constructorFunctions), constructorFields: clone(context.constructorFields), differences: [] };
    for p in sortedPositions(w.equalities.elements()) { if p >= 0 && p < size(context.equalities) { out = ValidatorContext { equalities: push(out.equalities, clone(get(context.equalities, p))), ..out }; }; };
    for p in sortedPositions(w.applications.elements()) { if p >= 0 && p < size(context.applications) { out = ValidatorContext { applications: push(out.applications, clone(get(context.applications, p))), ..out }; }; };
    for p in sortedPositions(w.orders.elements()) { if p >= 0 && p < size(context.orders) { out = ValidatorContext { orders: push(out.orders, clone(get(context.orders, p))), ..out }; }; };
    for p in sortedPositions(w.different.elements()) { if p >= 0 && p < size(context.different) { out = ValidatorContext { different: push(out.different, clone(get(context.different, p))), ..out }; }; };
    for p in sortedPositions(w.variants.elements()) { if p >= 0 && p < size(context.variants) { out = ValidatorContext { variants: push(out.variants, clone(get(context.variants, p))), ..out }; }; };
    for p in sortedPositions(w.differences.elements()) { if p >= 0 && p < size(context.differences) { out = ValidatorContext { differences: push(out.differences, clone(get(context.differences, p))), ..out }; }; };
    return out;
};

fn followChain(walk: GoalSlice, context: &ValidatorContext, index: &FactIndex, f: Int, start: Int, limit: Int) -> GoalSlice {
    w = walk;
    queue = push([], start);
    seen = HashSet::new();
    seen = seen.insert(start);
    head = 0;
    bound = lastRung();
    room = w.admitted < limit;
    while head < size(queue) && head < bound && room [{ affirm head >= 0; affirm head <= bound; }] shrinks bound - head {
        b = intAt(queue, head, start);
        at = index.applications.first.lookup(b, -1);
        walked = 0;
        linkCount = size(index.applications.items);
        while at >= 0 && at < size(index.applications.items) && walked < linkCount && room [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
            w = GoalSlice { admitted: w.admitted + 1, operations: w.operations + 1, ..w };
            p = get(index.applications.items, at);
            if p >= 0 && p < size(context.applications) {
                a = get(context.applications, p);
                if a.function = f && size(a.arguments) = 1 && a.id != b {
                    if w.admitted + index.weights.lookup(a.id, 0) <= limit { w = expandTerm(w, context, index, a.id); };
                };
                if a.id = b {
                    for x in a.arguments {
                        if seen.contains(x) = false && index.constantAt.contains(x) = false { seen = seen.insert(x); queue = push(queue, x); };
                    };
                };
            };
            at = intAt(index.applications.next, at, -1);
            walked = walked + 1;
            room = w.admitted < limit;
        };
        at = index.equalities.first.lookup(b, -1);
        walked = 0;
        linkCount = size(index.equalities.items);
        while at >= 0 && at < size(index.equalities.items) && walked < linkCount && room [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
            w = GoalSlice { admitted: w.admitted + 1, operations: w.operations + 1, ..w };
            p = get(index.equalities.items, at);
            if p >= 0 && p < size(context.equalities) && w.admitted + 2 * termCost() <= limit && w.equalities.contains(p) = false {
                e = get(context.equalities, p);
                slice = w.slice;
                w = GoalSlice { equalities: w.equalities.insert(p), slice: ValidatorContext { equalities: push(slice.equalities, clone(e)), ..slice }, admitted: w.admitted + 2 * termCost(), ..w };
                other = e.left;
                if other = b { other = e.right; };
                if seen.contains(other) = false { seen = seen.insert(other); queue = push(queue, other); };
            };
            at = intAt(index.equalities.next, at, -1);
            walked = walked + 1;
            room = w.admitted < limit;
        };
        head = head + 1;
    };
    return w;
};

// What a step asks of the facts is answered on a slice from its terms, climbing
// the rungs while a walk is cut short, so an answer costs at most the whole
// ladder, never the context.
fn nearFacts(context: &ValidatorContext, index: &FactIndex, seeds: &List<Int>) -> ValidatorContext {
    budgets = sliceBudgets();
    walk = goalSlice(context, index, seeds, firstRung());
    for r in 0..size(budgets) {
        if r > 0 && walk.capped { walk = goalSlice(context, index, seeds, intAt(budgets, r, lastRung())); };
    };
    return walk.slice;
};

// The first rung's slice alone, for a question its seeds' own facts answer
fn rungFacts(context: &ValidatorContext, index: &FactIndex, seeds: &List<Int>) -> ValidatorContext {
    return goalSlice(context, index, seeds, firstRung()).slice;
};

fn termOfValue(index: &FactIndex, value: Int) -> ValueLookup {
    if index.valueAt.contains(value) { return ValueLookup::Found { term: index.valueAt.lookup(value, 0) }; };
    return ValueLookup::Missing;
};

fn valueNear(context: &ValidatorContext, index: &FactIndex, term: Int) -> IntegerLookup {
    budgets = sliceBudgets();
    for r in 0..size(budgets) {
        walk = goalSlice(context, index, push([], term), intAt(budgets, r, lastRung()));
        value = integerValue(walk.slice, term);
        if value is IntegerLookup::Found { return value; };
        if walk.capped = false { return value; };
    };
    return IntegerLookup::Missing;
};

// The items on the first links of a key, at most cap of them, oldest first
fn linkedWithin(links: &HullLinks, key: Int, cap: Int) -> List<Int> {
    taken = [];
    at = links.first.lookup(key, -1);
    walked = 0;
    linkCount = size(links.items);
    while at >= 0 && at < size(links.items) && walked < linkCount && walked < cap [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
        taken = push(taken, get(links.items, at));
        at = intAt(links.next, at, -1);
        walked = walked + 1;
    };
    return taken;
};

// The applications on the first links of a term and of the terms its first
// equality links make it equal to (the terms), a rung of links in all: a step
// finds what a term is made of, or what is read of it, at the cost of a leaf
// even when the term is a hub. One a cap leaves out is not seen.
fn nearApplications(context: &ValidatorContext, index: &FactIndex, term: Int) -> NearApplications {
    terms = HashSet::new();
    terms = terms.insert(term);
    order = push([], term);
    for p in linkedWithin(index.equalities, term, firstRung()) {
        if p >= 0 && p < size(context.equalities) {
            e = get(context.equalities, p);
            other = e.left;
            if other = term { other = e.right; };
            if terms.contains(other) = false { terms = terms.insert(other); order = push(order, other); };
        };
    };
    applications = [];
    seen = HashSet::new();
    room = firstRung();
    for t in order {
        if room > 0 {
            positions = linkedWithin(index.applications, t, room);
            room = room - size(positions);
            for p in positions {
                if p >= 0 && p < size(context.applications) && seen.contains(p) = false {
                    seen = seen.insert(p);
                    applications = push(applications, clone(get(context.applications, p)));
                };
            };
        };
    };
    return NearApplications { terms: terms, applications: applications };
};

// The facts within the radius of the goal terms whose terms' weights fit the
// budget, each tested before it is expanded. Every fact is one of the
// context's, so whatever the slice entails the context entails.
fn goalSlice(context: &ValidatorContext, index: &FactIndex, seeds: &List<Int>, budget: Int) -> GoalSlice {
    metadata = ValidatorContext { equalities: [], applications: [], constants: [], orders: [], different: [], variants: [], fieldFunctions: clone(context.fieldFunctions), constructorFunctions: clone(context.constructorFunctions), constructorFields: clone(context.constructorFields), differences: [] };
    w = GoalSlice { slice: metadata, reached: HashSet::new(), next: [], equalities: HashSet::new(), applications: HashSet::new(), orders: HashSet::new(), different: HashSet::new(), variants: HashSet::new(), differences: HashSet::new(), admitted: 0, operations: 0, capped: false };
    for s in 0..size(seeds) {
        w = sliceReach(GoalSlice { admitted: w.admitted + termCost(), ..w }, context, index, get(seeds, s));
    };
    if size(seeds) = 2 {
        a = get(seeds, 0);
        b = get(seeds, 1);
        if index.constantAt.contains(a) && index.constantAt.contains(b) {
            light = a;
            other = b;
            if index.weights.lookup(b, 0) < index.weights.lookup(a, 0) { light = b; other = a; };
            if w.admitted + index.weights.lookup(light, 0) <= budget {
                w = linkConstants(w, context, index, light, other);
            } else {
                w = GoalSlice { capped: true, ..w };
            };
        };
    };
    radius = 8;
    for hop in 0..radius {
        frontier = w.next;
        w = GoalSlice { next: [], ..w };
        for t in 0..size(frontier) {
            term = get(frontier, t);
            weight = index.weights.lookup(term, 0);
            if w.admitted + weight <= budget {
                w = expandTerm(w, context, index, term);
            } else {
                w = GoalSlice { capped: true, ..w };
            };
        };
    };
    return w;
};
