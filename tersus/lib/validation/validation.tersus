// An equality proof query for the Tersus validator under development. The
// integers are symbolic value identifiers, not the values they stand for.
struct EqualityFact { left: Int, right: Int };

impl Clone for EqualityFact { };

impl Copy for EqualityFact { };

struct ConstantTerm { id: Int, kind: Int, value: Int };

impl Clone for ConstantTerm { };

fn emptyIntMap() -> HashMap<Int, Int> { return HashMap::new(); };

fn containsValue(values: &List<Int>, value: Int) -> Bool {
    for item in values {
        if item = value {
            return true;
        };
    };
    return false;
};

// Equalities form an undirected graph. Starting at left, each pass visits every
// edge and adds its other endpoint when one endpoint is already reachable.
// A path never needs more edges than there are facts, so this many passes are
// sufficient, including when the facts are ordered against the path; a pass
// that adds nothing has reached the fixpoint, and reaching right decides the
// question. Equivalence classes are small, so the reachable values are a list.
fn hasEquality(facts: &List<EqualityFact>, left: Int, right: Int) -> Bool {
    if left = right { return true; };
    reachable = push([], left);
    changed = true;
    for round in 0..size(facts) {
        if changed {
            changed = false;
            for factPosition in 0..size(facts) {
                fact = get(facts, factPosition);
                if containsValue(reachable, fact.left) {
                    if containsValue(reachable, fact.right) = false {
                        if fact.right = right { return true; };
                        reachable = push(reachable, fact.right);
                        changed = true;
                    };
                };
                if containsValue(reachable, fact.right) {
                    if containsValue(reachable, fact.left) = false {
                        if fact.left = right { return true; };
                        reachable = push(reachable, fact.left);
                        changed = true;
                    };
                };
            };
        };
    };
    return containsValue(reachable, right);
};

// The equivalence class of a term under the equalities (the values hasEquality
// reaches from it), and each class named by its least member, so a search
// that asks many times whether two terms are equal compares two integers.
fn equalityClass(facts: &List<EqualityFact>, start: Int) -> List<Int> {
    reachable = push([], start);
    changed = true;
    for round in 0..size(facts) {
        if changed {
            changed = false;
            for factPosition in 0..size(facts) {
                fact = get(facts, factPosition);
                if containsValue(reachable, fact.left) {
                    if containsValue(reachable, fact.right) = false {
                        reachable = push(reachable, fact.right);
                        changed = true;
                    };
                };
                if containsValue(reachable, fact.right) {
                    if containsValue(reachable, fact.left) = false {
                        reachable = push(reachable, fact.left);
                        changed = true;
                    };
                };
            };
        };
    };
    return reachable;
};

struct Representative { term: Int, rep: Int };

impl Clone for Representative { };

impl Copy for Representative { };

fn representativeOf(reps: &List<Representative>, term: Int) -> Int {
    for rPosition in 0..size(reps) {
        r = get(reps, rPosition);
        if r.term = term { return r.rep; };
    };
    return term;
};

fn withRepresentative(facts: &List<EqualityFact>, reps: List<Representative>, term: Int) -> List<Representative> {
    for rPosition in 0..size(reps) {
        r = get(reps, rPosition);
        if r.term = term { return reps; };
    };
    members = equalityClass(facts, term);
    least = term;
    for mPosition in 0..size(members) {
        m = get(members, mPosition);
        if m < least { least = m; };
    };
    result = reps;
    for mPosition in 0..size(members) {
        m = get(members, mPosition);
        result = push(result, Representative { term: m, rep: least });
    };
    return result;
};

// A term no equality mentions is its own representative.
fn equalityRepresentatives(facts: &List<EqualityFact>) -> List<Representative> {
    classes = leastClasses(facts);
    reps = [];
    seen = HashSet::new();
    for factPosition in 0..size(facts) {
        fact = get(facts, factPosition);
        if seen.contains(fact.left) = false {
            seen = seen.insert(fact.left);
            reps = push(reps, Representative { term: fact.left, rep: canonicalIn(classes, fact.left) });
        };
        if seen.contains(fact.right) = false {
            seen = seen.insert(fact.right);
            reps = push(reps, Representative { term: fact.right, rep: canonicalIn(classes, fact.right) });
        };
    };
    return reps;
};

// The representatives after an equality between a and b: their two classes
// become one.
fn mergeRepresentatives(reps: &List<Representative>, a: Int, b: Int) -> List<Representative> {
    ra = representativeOf(reps, a);
    rb = representativeOf(reps, b);
    if ra = rb { return clone(reps); };
    least = ra;
    if rb < least { least = rb; };
    result = [];
    seenA = false;
    seenB = false;
    for rPosition in 0..size(reps) {
        r = get(reps, rPosition);
        if r.term = a { seenA = true; };
        if r.term = b { seenB = true; };
        if r.rep = ra || r.rep = rb {
            result = push(result, Representative { term: r.term, rep: least });
        } else {
            result = push(result, r);
        };
    };
    if seenA = false { result = push(result, Representative { term: a, rep: least }); };
    if seenB = false { result = push(result, Representative { term: b, rep: least }); };
    return result;
};

// A binary application of an uninterpreted operator to two term identifiers.
// Every identifier must name one term, and operator identifiers must distinguish
// different operators. Equalities may mention identifiers without an application.
struct BinaryTerm { id: Int, op: Int, left: Int, right: Int };

impl Clone for BinaryTerm { };

impl Copy for BinaryTerm { };

// Close equalities under congruence as well as symmetry and transitivity. Each
// round adds equal applications whose operands were equal at the start of the
// comparison. At most size(terms) rounds are needed to propagate equality
// through a finite term graph. A malformed graph is the caller's responsibility.
fn congruenceFacts(facts: &List<EqualityFact>, terms: &List<BinaryTerm>) -> List<EqualityFact> {
    known = clone(facts);
    for round in 0..size(terms) {
        for aPosition in 0..size(terms) {
            a = get(terms, aPosition);
            for bPosition in 0..size(terms) {
                b = get(terms, bPosition);
                if a.op = b.op {
                    if hasEquality(known, a.left, b.left) {
                        if hasEquality(known, a.right, b.right) {
                            if hasEquality(known, a.id, b.id) = false {
                                known = push(known, EqualityFact { left: a.id, right: b.id });
                            };
                        };
                    };
                };
            };
        };
    };
    return known;
};

fn hasCongruence(facts: &List<EqualityFact>, terms: &List<BinaryTerm>, left: Int, right: Int) -> Bool {
    return hasEquality(congruenceFacts(facts, terms), left, right);
};

// A strict comparison between symbolic value identifiers.
struct StrictOrderFact { smaller: Int, greater: Int };

impl Clone for StrictOrderFact { };

impl Copy for StrictOrderFact { };

fn containsEquivalent(classes: &HashMap<Int, Int>, values: &List<Int>, value: Int) -> Bool {
    for itemPosition in 0..size(values) {
        item = get(values, itemPosition);
        if sameIn(classes, item, value) {
            return true;
        };
    };
    return false;
};

// Follow strict-order edges, allowing equality at either end of each edge.
// Every discovered value has a path from left containing at least one strict
// edge. A false answer means that these facts did not establish the goal.
fn hasStrictOrder(classes: &HashMap<Int, Int>, orders: &List<StrictOrderFact>, left: Int, right: Int) -> Bool {
    reached = [];
    for round in 0..size(orders) {
        for edgePosition in 0..size(orders) {
            edge = get(orders, edgePosition);
            connected = sameIn(classes, left, edge.smaller);
            if containsEquivalent(classes, reached, edge.smaller) {
                connected = true;
            };
            if connected {
                if containsEquivalent(classes, reached, edge.greater) = false {
                    reached = push(reached, edge.greater);
                };
            };
        };
    };
    return containsEquivalent(classes, reached, right);
};

// A comparison smaller <= greater; strict means smaller < greater.
struct OrderFact { smaller: Int, greater: Int, strict: Bool };

impl Clone for OrderFact { };

impl Copy for OrderFact { };

// Reachability keeps separate sets for paths with and without a strict edge.
// Equalities act as zero-length edges. A path of at most twice the number of
// comparisons suffices in the two-state graph, so two complete scans per round
// reach a fixed point without trusting a program-supplied termination bound.
fn hasOrder(equalities: &List<EqualityFact>, orders: &List<OrderFact>, left: Int, right: Int, strict: Bool) -> Bool {
    return hasOrderIn(leastClasses(equalities), orders, left, right, strict);
};

fn hasOrderIn(classes: &HashMap<Int, Int>, orders: &List<OrderFact>, left: Int, right: Int, strict: Bool) -> Bool {
    // Each term is named by the least member of its class under the
    // equalities (what hasEquality relates), once; the reached terms are
    // sets of those names, and the walk stops when a pass adds nothing.
    smaller = [];
    greater = [];
    for edgePosition in 0..size(orders) {
        edge = get(orders, edgePosition);
        smaller = push(smaller, canonicalIn(classes, edge.smaller));
        greater = push(greater, canonicalIn(classes, edge.greater));
    };
    weak = HashSet::new();
    weak = weak.insert(canonicalIn(classes, left));
    strong = HashSet::new();
    changed = true;
    // (each pass that changes anything adds a name to one of the two sets)
    for round in 0..4 * size(orders) + 4 {
        if changed {
            changed = false;
            for i in 0..size(orders) {
                s = get(smaller, i);
                g = get(greater, i);
                if weak.contains(s) {
                    if get(orders, i).strict {
                        if strong.contains(g) = false { strong = strong.insert(g); changed = true; };
                    } else {
                        if weak.contains(g) = false { weak = weak.insert(g); changed = true; };
                    };
                };
                if strong.contains(s) {
                    if strong.contains(g) = false { strong = strong.insert(g); changed = true; };
                };
            };
        };
    };
    target = canonicalIn(classes, right);
    if strong.contains(target) { return true; };
    if strict { return false; };
    return weak.contains(target);
};

// A comparison may mention applications as well as atomic identifiers.
fn hasOrderWithTerms(equalities: &List<EqualityFact>, terms: &List<BinaryTerm>, orders: &List<OrderFact>, left: Int, right: Int, strict: Bool) -> Bool {
    return hasOrder(congruenceFacts(equalities, terms), orders, left, right, strict);
};

// An application is identified separately from its function and arguments.
// Function identifiers are terms too, so equal functions applied to equal
// argument lists produce equal results. Zero-argument applications are valid.
struct ApplicationTerm { id: Int, function: Int, arguments: List<Int> };

impl Clone for ApplicationTerm { };

fn equalArguments(classes: &HashMap<Int, Int>, a: &List<Int>, b: &List<Int>) -> Bool {
    if size(a) != size(b) {
        return false;
    };
    for i in 0..size(a) {
        if sameIn(classes, get(a, i), get(b, i)) = false {
            return false;
        };
    };
    return true;
};

struct ConstructorField { constructor: Int, field: Int, index: Int };

impl Clone for ConstructorField { };

// Saturation is bounded by the finite terms in the facts and applications.
// Constructor injectivity can merge argument classes, which can then make
// additional application results equal.
// The congruence closure of equalities over application terms, by union
// and find: equal functions of equal arguments are equal; a constructor
// application equal to another of the same constructor has equal
// arguments; a field of a value equal to a constructor application is that
// argument; and x - s = r where x = l + r and s = l (or s = r and the other
// part). The result names each term of a class by the class's root (each
// equality is a term and its root), which hasEquality reads in two passes.
struct UnionFind { parent: HashMap<Int, Int>, weight: HashMap<Int, Int> };

impl Clone for UnionFind { };

fn ufFind(parent: &HashMap<Int, Int>, term: Int) -> Int {
    current = term;
    for step in 0..64 {
        if parent.contains(current) {
            next = parent.lookup(current, current);
            if next = current { return current; };
            current = next;
        } else { return current; };
    };
    return current;
};

fn ufUnion(given: HashMap<Int, Int>, weights: HashMap<Int, Int>, a: Int, b: Int) -> UnionFind {
    parent = given;
    weight = weights;
    ra = ufFind(parent, a);
    rb = ufFind(parent, b);
    if ra = rb { return UnionFind { parent: parent, weight: weight }; };
    wa = 1;
    if weight.contains(ra) { wa = weight.lookup(ra, 1); };
    wb = 1;
    if weight.contains(rb) { wb = weight.lookup(rb, 1); };
    if wa < wb {
        parent = parent.insert(ra, rb);
        if parent.contains(rb) = false { parent = parent.insert(rb, rb); };
        weight = weight.insert(rb, wa + wb);
    } else {
        parent = parent.insert(rb, ra);
        if parent.contains(ra) = false { parent = parent.insert(ra, ra); };
        weight = weight.insert(ra, wa + wb);
    };
    return UnionFind { parent: parent, weight: weight };
};

fn hashStep(h: Int, x: Int) -> Int {
    p = 2147483629;
    y = x % p;
    if y < 0 { y = y + p; };
    return (h * 1000003 + y) % p;
};

fn termSignature(uf: &HashMap<Int, Int>, term: &ApplicationTerm) -> Int {
    h = hashStep(7, ufFind(uf, term.function));
    h = hashStep(h, size(term.arguments));
    for a in term.arguments { h = hashStep(h, ufFind(uf, a)); };
    return h;
};

fn sameSignature(uf: &HashMap<Int, Int>, a: &ApplicationTerm, b: &ApplicationTerm) -> Bool {
    if size(a.arguments) != size(b.arguments) { return false; };
    if ufFind(uf, a.function) != ufFind(uf, b.function) { return false; };
    for i in 0..size(a.arguments) {
        if ufFind(uf, get(a.arguments, i)) != ufFind(uf, get(b.arguments, i)) { return false; };
    };
    return true;
};

// The union-find of a congruence closure after one pass of a rule, and whether the pass joined two classes
struct ClosureRound { parent: HashMap<Int, Int>, weight: HashMap<Int, Int>, changed: Bool };

impl Clone for ClosureRound { };

fn signatureRound(parent: HashMap<Int, Int>, weights: HashMap<Int, Int>, terms: &List<ApplicationTerm>) -> ClosureRound {
    uf = parent;
    weight = weights;
    changed = false;
    // (equal functions of equal arguments)
    signatures = emptyIntMap();
    for i in 0..size(terms) {
        a = get(terms, i);
        h = termSignature(uf, a);
        if signatures.contains(h) {
            j = signatures.lookup(h, 0);
            b = applicationAt(terms, j);
            if sameSignature(uf, a, b) {
                if ufFind(uf, a.id) != ufFind(uf, b.id) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, a.id, b.id); changed = true; };
            } else {
                for k in 0..i {
                    c = get(terms, k);
                    if sameSignature(uf, a, c) {
                        if ufFind(uf, a.id) != ufFind(uf, c.id) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, a.id, c.id); changed = true; };
                    };
                };
            };
        } else { signatures = signatures.insert(h, i); };
    };
    return ClosureRound { parent: uf, weight: weight, changed: changed };
};

fn constructorRound(parent: HashMap<Int, Int>, weights: HashMap<Int, Int>, terms: &List<ApplicationTerm>, constructors: &List<Int>, constructorSet: &HashSet<Int>, constructorFields: &List<ConstructorField>) -> ClosureRound {
    uf = parent;
    weight = weights;
    changed = false;
    // (a constructor application of each class)
    byClass = emptyIntMap();
    if size(constructors) > 0 {
        for i in 0..size(terms) {
            a = get(terms, i);
            if constructorSet.contains(a.function) {
                r = ufFind(uf, a.id);
                if byClass.contains(r) {
                    b = applicationAt(terms, byClass.lookup(r, 0));
                    if ufFind(uf, a.function) = ufFind(uf, b.function) && size(a.arguments) = size(b.arguments) {
                        for k in 0..size(a.arguments) {
                            x = get(a.arguments, k);
                            y = get(b.arguments, k);
                            if ufFind(uf, x) != ufFind(uf, y) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, x, y); changed = true; };
                        };
                    };
                } else { byClass = byClass.insert(r, i); };
            };
        };
        for fieldAppPosition in 0..size(terms) {
            fieldApp = get(terms, fieldAppPosition);
            if size(fieldApp.arguments) = 1 {
                r = ufFind(uf, get(fieldApp.arguments, 0));
                if byClass.contains(r) {
                    a = applicationAt(terms, byClass.lookup(r, 0));
                    for selectionPosition in 0..size(constructorFields) {
                        selection = get(constructorFields, selectionPosition);
                        if selection.constructor = a.function && selection.field = fieldApp.function {
                            if selection.index >= 0 && selection.index < size(a.arguments) {
                                value = get(a.arguments, selection.index);
                                if ufFind(uf, fieldApp.id) != ufFind(uf, value) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, fieldApp.id, value); changed = true; };
                            };
                        };
                    };
                };
            };
        };
    };
    return ClosureRound { parent: uf, weight: weight, changed: changed };
};

fn differenceRound(parent: HashMap<Int, Int>, weights: HashMap<Int, Int>, terms: &List<ApplicationTerm>) -> ClosureRound {
    uf = parent;
    weight = weights;
    changed = false;
    // (the sums of each class, so that a difference finds the sums it undoes)
    sumsOfClass = emptyPositions();
    for bPosition in 0..size(terms) {
        if get(terms, bPosition).function = -1 && size(get(terms, bPosition).arguments) = 2 {
            rb = ufFind(uf, get(terms, bPosition).id);
            sumsOfClass = sumsOfClass.insert(rb, push(sumsOfClass.lookup(rb, []), bPosition));
        };
    };
    for aPosition in 0..size(terms) {
        a = get(terms, aPosition);
        if a.function = -2 && size(a.arguments) = 2 {
            r = ufFind(uf, get(a.arguments, 0));
            subtrahend = ufFind(uf, get(a.arguments, 1));
            for bPosition in sumsOfClass.lookup(r, []) {
                if bPosition >= 0 && bPosition < size(terms) && get(terms, bPosition).function = -1 && size(get(terms, bPosition).arguments) = 2 {
                    b = get(terms, bPosition);
                    if ufFind(uf, b.id) = r {
                        leftPart = get(b.arguments, 0);
                        rightPart = get(b.arguments, 1);
                        if subtrahend = ufFind(uf, leftPart) {
                            if ufFind(uf, a.id) != ufFind(uf, rightPart) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, a.id, rightPart); changed = true; };
                        };
                        if subtrahend = ufFind(uf, rightPart) {
                            if ufFind(uf, a.id) != ufFind(uf, leftPart) { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, a.id, leftPart); changed = true; };
                        };
                    };
                };
            };
        };
    };
    return ClosureRound { parent: uf, weight: weight, changed: changed };
};

fn congruenceClosure(facts: &List<EqualityFact>, terms: &List<ApplicationTerm>, constants: &List<ConstantTerm>, constructors: &List<Int>, constructorFields: &List<ConstructorField>) -> List<EqualityFact> {
    constructorSet = HashSet::new();
    for constructor in constructors { constructorSet = constructorSet.insert(constructor); };
    uf = emptyIntMap();
    weight = emptyIntMap();
    for f in facts { UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, f.left, f.right); };
    // (constants of one kind and value are one: each is joined to the first of its value)
    byValue = emptyPositions();
    for i in 0..size(constants) {
        v = get(constants, i).value;
        joined = false;
        for j in byValue.lookup(v, []) {
            if joined = false && j >= 0 && j < size(constants) {
                if get(constants, j).kind = get(constants, i).kind {
                    UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, get(constants, i).id, get(constants, j).id);
                    joined = true;
                };
            };
        };
        if joined = false { byValue = byValue.insert(v, push(byValue.lookup(v, []), i)); };
    };
    changed = true;
    for round in 0..size(terms) + 2 {
        if changed {
            ClosureRound { parent: uf, weight: weight, changed: bySignature } = signatureRound(uf, weight, terms);
            ClosureRound { parent: uf, weight: weight, changed: byConstructor } = constructorRound(uf, weight, terms, constructors, constructorSet, constructorFields);
            ClosureRound { parent: uf, weight: weight, changed: byDifference } = differenceRound(uf, weight, terms);
            changed = bySignature || byConstructor || byDifference;
        };
    };
    result = [];
    for entry in uf.entries() {
        root = ufFind(uf, entry.key);
        if root != entry.key { result = push(result, EqualityFact { left: entry.key, right: root }); };
    };
    return result;
};

fn applicationFactsWithConstructors(facts: &List<EqualityFact>, terms: &List<ApplicationTerm>, constructors: &List<Int>, constructorFields: &List<ConstructorField>) -> List<EqualityFact> {
    return congruenceClosure(facts, terms, [], constructors, constructorFields);
};

fn applicationFacts(facts: &List<EqualityFact>, terms: &List<ApplicationTerm>) -> List<EqualityFact> {
    return applicationFactsWithConstructors(facts, terms, [], []);
};

// The element at an index that data gives (a node of a template, an entry
// a map holds), or a value of none where the index is not in the list: the
// data is made so that it always is, which nothing here proves
fn emptyPositions() -> HashMap<Int, List<Int>> { return HashMap::new(); };

fn minInt(a: Int, b: Int) -> Int {
    if a < b { return a; };
    return b;
};

fn intAt(xs: &List<Int>, i: Int, fallback: Int) -> Int {
    if i >= 0 && i < size(xs) { return get(xs, i); };
    return fallback;
};

fn boolAt(xs: &List<Bool>, i: Int, fallback: Bool) -> Bool {
    if i >= 0 && i < size(xs) { return get(xs, i); };
    return fallback;
};

fn applicationAt(apps: &List<ApplicationTerm>, i: Int) -> ApplicationTerm {
    if i >= 0 && i < size(apps) { return clone(get(apps, i)); };
    return ApplicationTerm { id: 0, function: 0 - 999999, arguments: [] };
};

fn hasApplicationEquality(facts: &List<EqualityFact>, terms: &List<ApplicationTerm>, left: Int, right: Int) -> Bool {
    return hasEquality(applicationFacts(facts, terms), left, right);
};

fn hasApplicationOrder(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, orders: &List<OrderFact>, left: Int, right: Int, strict: Bool) -> Bool {
    return hasOrder(applicationFacts(equalities, terms), orders, left, right, strict);
};

// A strict path from an identifier back to itself contradicts the premises.
// Every such cycle passes through an endpoint of one of the comparisons.
fn contradictoryOrders(equalities: &List<EqualityFact>, orders: &List<OrderFact>) -> Bool {
    for edgePosition in 0..size(orders) {
        edge = get(orders, edgePosition);
        if hasOrder(equalities, orders, edge.smaller, edge.smaller, true) {
            return true;
        };
    };
    return false;
};

// In an inconsistent context every comparison follows. The contradiction
// check is deliberately limited to equality and strict/non-strict order facts.
fn entailsApplicationOrder(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, orders: &List<OrderFact>, left: Int, right: Int, strict: Bool) -> Bool {
    closed = applicationFacts(equalities, terms);
    closedClasses = leastClasses(closed);
    if contradictoryOrders(closed, orders) {
        return true;
    };
    return hasOrderIn(closedClasses, orders, left, right, strict);
};

struct DisequalityFact { left: Int, right: Int };

impl Clone for DisequalityFact { };

impl Copy for DisequalityFact { };

// Values built with different variants of the same enum cannot be equal.
// The host emits these facts only for actual enum constructors.
struct VariantFact { object: Int, family: Int, constructor: Int, matches: Bool };

impl Clone for VariantFact { };

impl Copy for VariantFact { };


fn contradictoryDisequalities(classes: &HashMap<Int, Int>, different: &List<DisequalityFact>) -> Bool {
    for factPosition in 0..size(different) {
        fact = get(different, factPosition);
        if sameIn(classes, fact.left, fact.right) {
            return true;
        };
    };
    return false;
};

// Disequalities are symmetric and may be transported through equality. A
// strict ordering also establishes disequality. Contradictory explicit facts
// or a strict cycle make every relation follow.
// (as entailsApplicationDisequality, for equalities already closed, as an
// analysis's are, in a context already found not contradictory)
fn closedDisequality(classes: &HashMap<Int, Int>, orders: &List<OrderFact>, different: &List<DisequalityFact>, left: Int, right: Int) -> Bool {
    if hasOrderIn(classes, orders, left, right, true) { return true; };
    if hasOrderIn(classes, orders, right, left, true) { return true; };
    for factPosition in 0..size(different) {
        fact = get(different, factPosition);
        if sameIn(classes, left, fact.left) && sameIn(classes, right, fact.right) { return true; };
        if sameIn(classes, left, fact.right) && sameIn(classes, right, fact.left) { return true; };
    };
    return false;
};

fn entailsApplicationDisequality(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, orders: &List<OrderFact>, different: &List<DisequalityFact>, left: Int, right: Int) -> Bool {
    closed = applicationFacts(equalities, terms);
    closedClasses = leastClasses(closed);
    if contradictoryDisequalities(closedClasses, different) {
        return true;
    };
    if contradictoryOrders(closed, orders) {
        return true;
    };
    if hasOrderIn(closedClasses, orders, left, right, true) {
        return true;
    };
    if hasOrderIn(closedClasses, orders, right, left, true) {
        return true;
    };
    for factPosition in 0..size(different) {
        fact = get(different, factPosition);
        if sameIn(closedClasses, left, fact.left) {
            if sameIn(closedClasses, right, fact.right) {
                return true;
            };
        };
        if sameIn(closedClasses, left, fact.right) {
            if sameIn(closedClasses, right, fact.left) {
                return true;
            };
        };
    };
    return false;
};

// A difference constraint left - right <= bound. It is an edge from right to
// left whose weight is bound. Paths compose constraints by adding weights.
struct DifferenceFact { left: Int, right: Int, bound: Int };

impl Clone for DifferenceFact { };

impl Copy for DifferenceFact { };
enum SumResult { Overflow, Sum { value: Int } };

impl Clone for SumResult { };

impl Copy for SumResult { };

// The proof engine uses mathematical integers, while a running Tersus program
// uses checked 64-bit integers. Reject an unrepresentable intermediate path
// instead of overflowing or silently changing the bound.
fn safeBoundSum(a: Int, b: Int) -> SumResult {
    if b > 0 {
        if a > 9223372036854775807 - b {
            return SumResult::Overflow;
        };
    };
    if b < 0 {
        if a < -9223372036854775808 - b {
            return SumResult::Overflow;
        };
    };
    return SumResult::Sum { value: a + b };
};

// The difference facts with each term named by its class's least member
fn canonicalDifferencesIn(classes: &HashMap<Int, Int>, facts: &List<DifferenceFact>) -> List<DifferenceFact> {
    result = [];
    for factPosition in 0..size(facts) {
        fact = get(facts, factPosition);
        result = push(result, DifferenceFact { left: canonicalIn(classes, fact.left), right: canonicalIn(classes, fact.right), bound: fact.bound });
    };
    return result;
};

// A potential of the difference graph: p(left) <= p(right) + bound for every
// edge, found from a source joined to every node by an edge of bound 0. It is
// valid when the search settles and no sum it needs overflows; a valid
// potential means the graph has no negative cycle, and two nodes are at
// distance at most 0 from each other, both ways, exactly when they have one
// potential and are in one strongly connected component of the edges it
// makes tight (p(left) = p(right) + bound).
struct DifferencePotential { valid: Bool, potential: HashMap<Int, Int> };

impl Clone for DifferencePotential { };

fn differencePotential(edges: &List<DifferenceFact>) -> DifferencePotential {
    nodes = edgeNodes(edges);
    p = emptyIntMap();
    for node in nodes { p = p.insert(node, 0); };
    changed = true;
    for round in 0..size(nodes) + 1 {
        if changed {
            changed = false;
            for edgePosition in 0..size(edges) {
                edge = get(edges, edgePosition);
                sum = safeBoundSum(p.lookup(edge.right, 0), edge.bound);
                if sum is SumResult::Sum {
                    if (sum as SumResult::Sum).value < p.lookup(edge.left, 0) {
                        p = p.insert(edge.left, (sum as SumResult::Sum).value);
                        changed = true;
                    };
                };
            };
        };
    };
    if changed { return DifferencePotential { valid: false, potential: p }; };
    for edgePosition in 0..size(edges) {
        edge = get(edges, edgePosition);
        if safeBoundSum(p.lookup(edge.right, 0), edge.bound) is SumResult::Overflow {
            return DifferencePotential { valid: false, potential: p };
        };
    };
    return DifferencePotential { valid: true, potential: p };
};

fn tightEdges(edges: &List<DifferenceFact>, p: &HashMap<Int, Int>) -> List<DifferenceFact> {
    tight = [];
    for edgePosition in 0..size(edges) {
        edge = get(edges, edgePosition);
        sum = safeBoundSum(p.lookup(edge.right, 0), edge.bound);
        if sum is SumResult::Sum {
            if (sum as SumResult::Sum).value = p.lookup(edge.left, 0) { tight = push(tight, edge); };
        };
    };
    return tight;
};

fn canonicalDifferences(reps: &List<Representative>, facts: &List<DifferenceFact>) -> List<DifferenceFact> {
    result = [];
    for factPosition in 0..size(facts) {
        fact = get(facts, factPosition);
        result = push(result, DifferenceFact { left: representativeOf(reps, fact.left), right: representativeOf(reps, fact.right), bound: fact.bound });
    };
    return result;
};

// Search paths from right to left. A simple path has at most size(facts)
// edges; omitting overflowed paths can lose a proof but cannot invent one.
// Negative cycles are not yet used to prove unrelated goals. Equal terms are
// one node, named by its class representative.
// hasDifference over edges whose nodes are already class representatives.
fn canonicalHasDifference(edges: &List<DifferenceFact>, target: Int, source: Int, bound: Int) -> Bool {
    if bound >= 0 && target = source { return true; };
    distances = emptyIntMap();
    distances = distances.insert(source, 0);
    changed = true;
    for round in 0..size(edges) {
        if changed {
            changed = false;
            for edgePosition in 0..size(edges) {
                edge = get(edges, edgePosition);
                if distances.contains(edge.right) {
                    sum = safeBoundSum(distances.lookup(edge.right, 0), edge.bound);
                    if sum is SumResult::Sum {
                        candidate = (sum as SumResult::Sum).value;
                        if candidate <= bound && edge.left = target { return true; };
                        if distances.contains(edge.left) = false || candidate < distances.lookup(edge.left, 0) {
                            distances = distances.insert(edge.left, candidate);
                            changed = true;
                        };
                    };
                };
            };
        };
    };
    if distances.contains(target) { return distances.lookup(target, 0) <= bound; };
    return false;
};

fn hasDifference(equalities: &List<EqualityFact>, facts: &List<DifferenceFact>, left: Int, right: Int, bound: Int) -> Bool {
    classes = leastClasses(equalities);
    return canonicalHasDifference(canonicalDifferencesIn(classes, facts), canonicalIn(classes, left), canonicalIn(classes, right), bound);
};

struct DistanceTable { source: Int, distances: HashMap<Int, Int> };

impl Clone for DistanceTable { };

// The shortest distances from a source over edges whose nodes are class
// representatives, as hasDifference finds them.
fn canonicalDistances(edges: &List<DifferenceFact>, source: Int) -> HashMap<Int, Int> {
    distances = emptyIntMap();
    distances = distances.insert(source, 0);
    changed = true;
    for round in 0..size(edges) {
        if changed {
            changed = false;
            for edgePosition in 0..size(edges) {
                edge = get(edges, edgePosition);
                if distances.contains(edge.right) {
                    sum = safeBoundSum(distances.lookup(edge.right, 0), edge.bound);
                    if sum is SumResult::Sum {
                        candidate = (sum as SumResult::Sum).value;
                        if distances.contains(edge.left) = false || candidate < distances.lookup(edge.left, 0) {
                            distances = distances.insert(edge.left, candidate);
                            changed = true;
                        };
                    };
                };
            };
        };
    };
    return distances;
};

fn hasDistanceTable(tables: &List<DistanceTable>, source: Int) -> Bool {
    for tablePosition in 0..size(tables) {
        table = get(tables, tablePosition);
        if table.source = source { return true; };
    };
    return false;
};

fn tableDistanceAtMost(tables: &List<DistanceTable>, from: Int, to: Int, bound: Int) -> Bool {
    for tablePosition in 0..size(tables) {
        if get(tables, tablePosition).source = from {
            if get(tables, tablePosition).distances.contains(to) {
                return get(tables, tablePosition).distances.lookup(to, 0) <= bound;
            };
            return false;
        };
    };
    return false;
};

fn hasApplicationDifference(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, facts: &List<DifferenceFact>, left: Int, right: Int, bound: Int) -> Bool {
    return hasDifference(applicationFacts(equalities, terms), facts, left, right, bound);
};

// A non-strict bound between values known to differ is strict. This rule can
// use an order path rather than requiring the bound to be a single input edge.
fn refinedOrders(classes: &HashMap<Int, Int>, orders: &List<OrderFact>, different: &List<DisequalityFact>) -> List<OrderFact> {
    known = clone(orders);
    for factPosition in 0..size(different) {
        fact = get(different, factPosition);
        if hasOrderIn(classes, known, fact.left, fact.right, false) {
            if hasOrderIn(classes, known, fact.left, fact.right, true) = false {
                known = push(known, OrderFact { smaller: fact.left, greater: fact.right, strict: true });
            };
        };
        if hasOrderIn(classes, known, fact.right, fact.left, false) {
            if hasOrderIn(classes, known, fact.right, fact.left, true) = false {
                known = push(known, OrderFact { smaller: fact.right, greater: fact.left, strict: true });
            };
        };
    };
    return known;
};

fn entailsRefinedOrder(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, orders: &List<OrderFact>, different: &List<DisequalityFact>, left: Int, right: Int, strict: Bool) -> Bool {
    closed = applicationFacts(equalities, terms);
    closedClasses = leastClasses(closed);
    if contradictoryDisequalities(closedClasses, different) {
        return true;
    };
    refined = refinedOrders(closedClasses, orders, different);
    if contradictoryOrders(closed, refined) {
        return true;
    };
    return hasOrderIn(closedClasses, refined, left, right, strict);
};

// Concrete terms use kind 0 for Int and kind 1 for Bool (value 0 or 1).
// Identifiers refer to terms, so repeated literals are registered as equal.

impl Copy for ConstantTerm { };

fn constantEqualities(equalities: &List<EqualityFact>, constants: &List<ConstantTerm>) -> List<EqualityFact> {
    known = clone(equalities);
    for aPosition in 0..size(constants) {
        a = get(constants, aPosition);
        for bPosition in 0..size(constants) {
            b = get(constants, bPosition);
            if a.kind = b.kind {
                if a.value = b.value {
                    if hasEquality(known, a.id, b.id) = false {
                        known = push(known, EqualityFact { left: a.id, right: b.id });
                    };
                };
            };
        };
    };
    return known;
};

// Two different literal values cannot occupy the same equality class.
fn contradictoryConstants(classes: &HashMap<Int, Int>, constants: &List<ConstantTerm>) -> Bool {
    for aPosition in 0..size(constants) {
        a = get(constants, aPosition);
        for bPosition in 0..size(constants) {
            b = get(constants, bPosition);
            if sameIn(classes, a.id, b.id) {
                if a.kind != b.kind {
                    return true;
                };
                if a.value != b.value {
                    return true;
                };
            };
        };
    };
    return false;
};

fn semanticFacts(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, constants: &List<ConstantTerm>) -> List<EqualityFact> {
    return congruenceClosure(equalities, terms, constants, [], []);
};

fn entailsSemanticEquality(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, constants: &List<ConstantTerm>, left: Int, right: Int) -> Bool {
    known = semanticFacts(equalities, terms, constants);
    knownClasses = leastClasses(known);
    if contradictoryConstants(knownClasses, constants) {
        return true;
    };
    return sameIn(knownClasses, left, right);
};

// Concrete integer values also provide their exact order. Booleans do not
// provide integer-order edges, even though their encoding uses an integer.
// The integer constants in order of value, each below the next larger one:
// a chain, which orders every pair as the transitive closure does, with one
// fact per constant rather than one per pair.
fn constantOrders(orders: &List<OrderFact>, constants: &List<ConstantTerm>) -> List<OrderFact> {
    known = clone(orders);
    for aPosition in 0..size(constants) {
        a = get(constants, aPosition);
        if a.kind = 0 {
            next = 0;
            nextValue = 0;
            found = false;
            for bPosition in 0..size(constants) {
                b = get(constants, bPosition);
                if b.kind = 0 {
                    if b.value > a.value {
                        if found = false || b.value < nextValue {
                            next = b.id;
                            nextValue = b.value;
                            found = true;
                        };
                    };
                };
            };
            if found { known = push(known, OrderFact { smaller: a.id, greater: next, strict: true }); };
        };
    };
    return known;
};

fn entailsSemanticOrder(equalities: &List<EqualityFact>, terms: &List<ApplicationTerm>, constants: &List<ConstantTerm>, orders: &List<OrderFact>, different: &List<DisequalityFact>, left: Int, right: Int, strict: Bool) -> Bool {
    closed = semanticFacts(equalities, terms, constants);
    closedClasses = leastClasses(closed);
    if contradictoryConstants(closedClasses, constants) {
        return true;
    };
    if contradictoryDisequalities(closedClasses, different) {
        return true;
    };
    refined = refinedOrders(closedClasses, constantOrders(orders, constants), different);
    if contradictoryOrders(closed, refined) {
        return true;
    };
    return hasOrderIn(closedClasses, refined, left, right, strict);
};

// A checked difference, using bounds that do not themselves overflow.
fn safeBoundDifference(a: Int, b: Int) -> SumResult {
    if b > 0 {
        if a < -9223372036854775808 + b {
            return SumResult::Overflow;
        };
    };
    if b < 0 {
        if a > 9223372036854775807 + b {
            return SumResult::Overflow;
        };
    };
    return SumResult::Sum { value: a - b };
};

fn comparisonDifferences(orders: &List<OrderFact>, facts: &List<DifferenceFact>) -> List<DifferenceFact> {
    result = clone(facts);
    for orderPosition in 0..size(orders) {
        order = get(orders, orderPosition);
        if order.strict {
            result = push(result, DifferenceFact { left: order.smaller, right: order.greater, bound: -1 });
        } else {
            result = push(result, DifferenceFact { left: order.smaller, right: order.greater, bound: 0 });
        };
    };
    return result;
};

// A size is never negative, whether or not the program said so. The reference
// validator adds the same constraint for every size term it sees; here it is
// checked directly so that a goal like 0 <= size(l) does not need the full
// difference graph to be rebuilt for every size term.
fn isSizeTerm(applications: &List<ApplicationTerm>, term: Int) -> Bool {
    for applicationPosition in 0..size(applications) {
        application = get(applications, applicationPosition);
        if application.id = term {
            if application.function = -13 {
                if size(application.arguments) = 1 { return true; };
            };
        };
    };
    return false;
};

fn constantDifferences(constants: &List<ConstantTerm>, facts: &List<DifferenceFact>) -> List<DifferenceFact> {
    result = clone(facts);
    for aPosition in 0..size(constants) {
        a = get(constants, aPosition);
        for bPosition in 0..size(constants) {
            b = get(constants, bPosition);
            if a.kind = 0 {
                if b.kind = 0 {
                    redundant = false;
                    if a.id = b.id {
                        if a.value = b.value { redundant = true; };
                    };
                    if redundant = false {
                        d = safeBoundDifference(a.value, b.value);
                        if d is SumResult::Sum {
                            result = push(result, DifferenceFact { left: a.id, right: b.id, bound: (d as SumResult::Sum).value });
                        };
                    };
                };
            };
        };
    };
    return result;
};

// A representable negative cycle contradicts the premises. If a path needs an
// unrepresentable intermediate, hasDifference declines it and this check may
// miss the contradiction, but never reports one without a proof.
fn contradictoryDifferences(classes: &HashMap<Int, Int>, facts: &List<DifferenceFact>) -> Bool {
    negative = false;
    for factPosition in 0..size(facts) {
        fact = get(facts, factPosition);
        if fact.bound < 0 { negative = true; };
    };
    if negative = false { return false; };
    edges = canonicalDifferencesIn(classes, facts);
    if differencePotential(edges).valid { return false; };
    // Every negative cycle contains a negative edge. Checking only its
    // endpoints avoids repeating the same search for nonnegative edges, and
    // the endpoints of one class are one search.
    searched = [];
    for edgePosition in 0..size(edges) {
        edge = get(edges, edgePosition);
        if edge.bound < 0 {
            if containsValue(searched, edge.left) = false {
                searched = push(searched, edge.left);
                if canonicalHasDifference(edges, edge.left, edge.left, -1) {
                    return true;
                };
            };
        };
    };
    return false;
};

struct ValidatorContext {
    equalities: List<EqualityFact>,
    applications: List<ApplicationTerm>,
    constants: List<ConstantTerm>,
    orders: List<OrderFact>,
    different: List<DisequalityFact>,
    variants: List<VariantFact>,
    fieldFunctions: List<Int>,
    constructorFunctions: List<Int>,
    constructorFields: List<ConstructorField>,
    differences: List<DifferenceFact>,
};

impl Clone for ValidatorContext { };

// Any equality obtained from bounds relates endpoints of comparisons,
// differences, constants or disequalities. Equalities to other identifiers
// are already represented in the equality closure.
fn contextNodes(context: &ValidatorContext) -> List<Int> {
    candidates = [];
    for orderPosition in 0..size(context.orders) {
        order = get(context.orders, orderPosition);
        candidates = push(candidates, order.smaller);
        candidates = push(candidates, order.greater);
    };
    for factPosition in 0..size(context.differences) {
        fact = get(context.differences, factPosition);
        candidates = push(candidates, fact.left);
        candidates = push(candidates, fact.right);
    };
    for factPosition in 0..size(context.different) {
        fact = get(context.different, factPosition);
        candidates = push(candidates, fact.left);
        candidates = push(candidates, fact.right);
    };
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        candidates = push(candidates, constant.id);
    };
    nodes = [];
    seen = HashSet::new();
    for nodePosition in 0..size(candidates) {
        node = get(candidates, nodePosition);
        if seen.contains(node) = false {
            seen = seen.insert(node);
            nodes = push(nodes, node);
        };
    };
    return nodes;
};

fn representativeMap(reps: &List<Representative>) -> HashMap<Int, Int> {
    m = emptyIntMap();
    for rPosition in 0..size(reps) {
        r = get(reps, rPosition);
        m = m.insert(r.term, r.rep);
    };
    return m;
};

fn mappedRepresentative(m: &HashMap<Int, Int>, term: Int) -> Int {
    if m.contains(term) { return m.lookup(term, term); };
    return term;
};

// (as mergeRepresentatives, for a map)
fn mergeRepresentativeMap(m: HashMap<Int, Int>, a: Int, b: Int) -> HashMap<Int, Int> {
    ra = mappedRepresentative(m, a);
    rb = mappedRepresentative(m, b);
    if ra = rb { return m; };
    least = ra;
    if rb < least { least = rb; };
    result = m;
    for entry in result.entries() {
        if entry.value = ra || entry.value = rb { result = result.insert(entry.key, least); };
    };
    result = result.insert(a, least);
    result = result.insert(b, least);
    return result;
};

fn pairKey(a: Int, b: Int) -> Int {
    return hashStep(hashStep(11, a), b);
};

fn edgeNodes(edges: &List<DifferenceFact>) -> List<Int> {
    nodes = [];
    seen = HashSet::new();
    for ePosition in 0..size(edges) {
        a = get(edges, ePosition).left;
        b = get(edges, ePosition).right;
        if seen.contains(a) = false { seen = seen.insert(a); nodes = push(nodes, a); };
        if seen.contains(b) = false { seen = seen.insert(b); nodes = push(nodes, b); };
    };
    return nodes;
};

// The edges as lists of node indexes: the edges out of node n are the
// targets from starts(n) to starts(n + 1), from right to left (or left to
// right, reversed)
struct EdgeGraph { starts: List<Int>, targets: List<Int> };

impl Clone for EdgeGraph { };

fn edgeGraph(edges: &List<DifferenceFact>, index: &HashMap<Int, Int>, count: Int, reversed: Bool) -> EdgeGraph [{ affirm count >= 0; }] [{ }] {
    starts = [];
    for k in 0..count + 1 { starts = push(starts, 0); };
    for ePosition in 0..size(edges) {
        from = index.lookup(get(edges, ePosition).right, -1);
        if reversed { from = index.lookup(get(edges, ePosition).left, -1); };
        if from >= 0 && from + 1 < size(starts) { starts = set(starts, from + 1, get(starts, from + 1) + 1); };
    };
    for k in 0..count {
        if k + 1 < size(starts) { starts = set(starts, k + 1, get(starts, k + 1) + get(starts, k)); };
    };
    targets = [];
    for ePosition in 0..size(edges) { targets = push(targets, -1); };
    fill = clone(starts);
    for ePosition in 0..size(edges) {
        from = index.lookup(get(edges, ePosition).right, -1);
        to = index.lookup(get(edges, ePosition).left, -1);
        if reversed {
            from = index.lookup(get(edges, ePosition).left, -1);
            to = index.lookup(get(edges, ePosition).right, -1);
        };
        if from >= 0 && from < size(fill) {
            place = get(fill, from);
            if place >= 0 && place < size(targets) {
                targets = set(targets, place, to);
                fill = set(fill, from, place + 1);
            };
        };
    };
    return EdgeGraph { starts: starts, targets: targets };
};

// (the node indexes in the order a depth-first walk from each of them in turn
// finishes them)
fn finishOrder(graph: &EdgeGraph, count: Int, steps: Int) -> List<Int> [{ affirm count >= 0; affirm steps >= 0; }] [{ }] {
    order = [];
    visited = [];
    for k in 0..count { visited = push(visited, false); };
    for start in 0..count {
        if start < size(visited) && get(visited, start) = false {
            visited = set(visited, start, true);
            stack = push([], start);
            next = push([], intAt(graph.starts, start, 0));
            for step in 0..steps {
                if size(stack) > 0 && size(next) = size(stack) {
                    top = last(stack);
                    i = last(next);
                    if i < intAt(graph.starts, top + 1, 0) {
                        next = set(next, size(next) - 1, i + 1);
                        to = intAt(graph.targets, i, -1);
                        if to >= 0 && to < size(visited) {
                            if get(visited, to) = false {
                                visited = set(visited, to, true);
                                stack = push(stack, to);
                                next = push(next, intAt(graph.starts, to, 0));
                            };
                        };
                    } else {
                        order = push(order, top);
                        stack = pop(stack);
                        next = pop(next);
                    };
                };
            };
        };
    };
    return order;
};

// The strongly connected components of the difference edges, by Kosaraju's
// two walks: each node the edges name is mapped to the first node of its
// component the second walk finds
fn edgeComponents(edges: &List<DifferenceFact>) -> HashMap<Int, Int> {
    nodes = edgeNodes(edges);
    count = size(nodes);
    index = emptyIntMap();
    for k in 0..count { index = index.insert(get(nodes, k), k); };
    steps = 2 * size(edges) + 2 * count + 2;
    order = finishOrder(edgeGraph(edges, index, count, false), count, steps);
    reversed = edgeGraph(edges, index, count, true);
    component = [];
    for k in 0..count { component = push(component, -1); };
    for back in 0..size(order) {
        start = intAt(order, size(order) - 1 - back, -1);
        if start >= 0 && start < size(component) {
            if get(component, start) < 0 {
                component = set(component, start, start);
                stack = push([], start);
                for step in 0..steps {
                    if size(stack) > 0 {
                        top = last(stack);
                        stack = pop(stack);
                        lo = intAt(reversed.starts, top, 0);
                        hi = intAt(reversed.starts, top + 1, 0);
                        if hi < lo { hi = lo; };
                        for i in lo..hi {
                            to = intAt(reversed.targets, i, -1);
                            if to >= 0 && to < size(component) {
                                if get(component, to) < 0 {
                                    component = set(component, to, start);
                                    stack = push(stack, to);
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    result = emptyIntMap();
    for k in 0..count {
        c = intAt(component, k, -1);
        if c >= 0 && c < count && k < count { result = result.insert(get(nodes, k), get(nodes, c)); };
    };
    return result;
};

fn boundEqualities(equalities: &List<EqualityFact>, classes: &HashMap<Int, Int>, differences: &List<DifferenceFact>, nodes: &List<Int>) -> List<EqualityFact> {
    edges = canonicalDifferencesIn(classes, differences);
    potential = differencePotential(edges);
    if potential.valid = false { return boundEqualitiesByTables(equalities, differences, nodes); };
    // (a tight path from a to b weighs p(b) - p(a), and every other path
    // more: the classes of one tight component with one potential are at
    // distance 0 from each other both ways, and so are one class)
    component = edgeComponents(tightEdges(edges, potential.potential));
    known = clone(equalities);
    first = emptyPositions();
    joined = HashSet::new();
    for nodePosition in 0..size(nodes) {
        r = canonicalIn(classes, get(nodes, nodePosition));
        if component.contains(r) && joined.contains(r) = false {
            joined = joined.insert(r);
            key = pairKey(component.lookup(r, r), potential.potential.lookup(r, 0));
            if first.contains(key) = false {
                first = first.insert(key, push([], r));
            } else {
                // (a key two groups share is told apart by both of its parts)
                matched = false;
                for other in first.lookup(key, []) {
                    if matched = false && component.lookup(other, other) = component.lookup(r, r) && potential.potential.lookup(other, 0) = potential.potential.lookup(r, 0) {
                        known = push(known, EqualityFact { left: other, right: r });
                        matched = true;
                    };
                };
                if matched = false { first = first.insert(key, push(first.lookup(key, []), r)); };
            };
        };
    };
    return known;
};

// (the same, by a table of distances from each class in a component of more
// than one: for a graph with a negative cycle, or sums near the bounds of Int)
fn boundEqualitiesByTables(equalities: &List<EqualityFact>, differences: &List<DifferenceFact>, nodes: &List<Int>) -> List<EqualityFact> {
    known = clone(equalities);
    reps = equalityRepresentatives(equalities);
    repMap = representativeMap(reps);
    edges = canonicalDifferences(reps, differences);
    // (only the classes in a component of more than one can be merged, and the
    // distances between them are read over the edges inside it)
    component = edgeComponents(edges);
    componentSize = emptyIntMap();
    for entry in component.entries() {
        componentSize = componentSize.insert(entry.value, componentSize.lookup(entry.value, 0) + 1);
    };
    inner = [];
    for ePosition in 0..size(edges) {
        e = get(edges, ePosition);
        if component.contains(e.left) && component.lookup(e.left, 0) = component.lookup(e.right, 1) && componentSize.lookup(component.lookup(e.left, 0), 0) > 1 {
            inner = push(inner, clone(e));
        };
    };
    // (nodes of one class have the same distances, so each class gets one
    // table; the pairs at distance at most 0 are kept as keys too, so that most
    // pairs are ruled out without reading a table, and a key that matches is
    // read from the tables before it is believed)
    tables = [];
    sources = HashSet::new();
    zeroPairs = HashSet::new();
    for nodePosition in 0..size(nodes) {
        node = get(nodes, nodePosition);
        r = mappedRepresentative(repMap, node);
        if sources.contains(r) = false && componentSize.lookup(component.lookup(r, r), 0) > 1 {
            sources = sources.insert(r);
            distances = canonicalDistances(inner, r);
            for d in distances.entries() {
                if d.value <= 0 { zeroPairs = zeroPairs.insert(pairKey(r, d.key)); };
            };
            tables = push(tables, DistanceTable { source: r, distances: distances });
        };
    };
    // (two classes at distance at most 0 from each other, both ways, are one)
    knownReps = clone(repMap);
    for tPosition in 0..size(tables) {
        ra = get(tables, tPosition).source;
        ds = get(tables, tPosition).distances;
        for d in ds.entries() {
            rb = d.key;
            if d.value <= 0 && rb != ra && sources.contains(rb) {
                if zeroPairs.contains(pairKey(rb, ra)) {
                    if mappedRepresentative(knownReps, ra) != mappedRepresentative(knownReps, rb) {
                        if tableDistanceAtMost(tables, rb, ra, 0) {
                            known = push(known, EqualityFact { left: ra, right: rb });
                            knownReps = mergeRepresentativeMap(knownReps, ra, rb);
                        };
                    };
                };
            };
        };
    };
    return known;
};

// Repeat because an equality proved by bounds can make applications equal,
// and those equal applications can in turn connect more bounds. Every round
// that changes the result merges at least one of the finite candidate classes.
fn closeContext(context: &ValidatorContext) -> List<EqualityFact> {
    nodes = contextNodes(context);
    known = semanticFacts(context.equalities, context.applications, context.constants);
    for round in 0..size(nodes) + 2 * size(context.equalities) + 8 * size(context.applications) + 8 {
        classes = leastClasses(known);
        orders = refinedOrders(classes, constantOrders(context.orders, context.constants), context.different);
        differences = constantDifferences(context.constants, comparisonDifferences(orders, context.differences));
        next = applicationFactsWithConstructors(boundEqualities(known, classes, differences, nodes), context.applications, context.constructorFunctions, context.constructorFields);
        if size(next) = size(known) { return next; };
        known = next;
    };
    return known;
};

enum ValidatorGoal {
    Equal { left: Int, right: Int },
    Different { left: Int, right: Int },
    Less { left: Int, right: Int },
    AtMost { left: Int, right: Int },
    Difference { left: Int, right: Int, bound: Int },
    Within { inner: Int, outer: Int },
};

impl Clone for ValidatorGoal { };

impl Copy for ValidatorGoal { };

fn contextEqual(classes: &HashMap<Int, Int>, differences: &List<DifferenceFact>, left: Int, right: Int) -> Bool {
    if sameIn(classes, left, right) {
        return true;
    };
    if hasDifferenceIn(classes, differences, left, right, 0) {
        return hasDifferenceIn(classes, differences, right, left, 0);
    };
    return false;
};

fn contextDifferent(equalities: &List<EqualityFact>, applications: &List<ApplicationTerm>, orders: &List<OrderFact>, different: &List<DisequalityFact>, differences: &List<DifferenceFact>, left: Int, right: Int) -> Bool {
    if hasDifference(equalities, differences, left, right, -1) {
        return true;
    };
    if hasDifference(equalities, differences, right, left, -1) {
        return true;
    };
    return entailsApplicationDisequality(equalities, applications, orders, different, left, right);
};

fn contradictoryVariants(classes: &HashMap<Int, Int>, variants: &List<VariantFact>) -> Bool {
    for aPosition in 0..size(variants) {
        a = get(variants, aPosition);
        for bPosition in 0..size(variants) {
            b = get(variants, bPosition);
            if a.family = b.family {
                if sameIn(classes, a.object, b.object) {
                    if a.constructor = b.constructor {
                        if a.matches != b.matches { return true; };
                    } else if a.matches {
                        if b.matches { return true; };
                    };
                };
            };
        };
    };
    return false;
};

fn contradictoryConstructors(classes: &HashMap<Int, Int>, applications: &List<ApplicationTerm>, constructors: &List<Int>) -> Bool {
    // (two constructions in one class whose constructors are not in one class:
    // each is compared with the first construction of its class)
    constructorSet = HashSet::new();
    for constructor in constructors { constructorSet = constructorSet.insert(constructor); };
    constructorOfClass = emptyIntMap();
    for aPosition in 0..size(applications) {
        function = get(applications, aPosition).function;
        if constructorSet.contains(function) {
            r = ufFind(classes, get(applications, aPosition).id);
            f = ufFind(classes, function);
            if constructorOfClass.contains(r) {
                if constructorOfClass.lookup(r, f) != f { return true; };
            } else { constructorOfClass = constructorOfClass.insert(r, f); };
        };
    };
    return false;
};

fn entailsConstructorDisequality(classes: &HashMap<Int, Int>, applications: &List<ApplicationTerm>, constructors: &List<Int>, left: Int, right: Int) -> Bool {
    constructorSet = HashSet::new();
    for constructor in constructors { constructorSet = constructorSet.insert(constructor); };
    for aPosition in 0..size(applications) {
        a = get(applications, aPosition);
        if constructorSet.contains(a.function) {
            for bPosition in 0..size(applications) {
                b = get(applications, bPosition);
                if constructorSet.contains(b.function) {
                    if sameIn(classes, a.function, b.function) = false {
                        if sameIn(classes, left, a.id) {
                            if sameIn(classes, right, b.id) { return true; };
                        };
                        if sameIn(classes, left, b.id) {
                            if sameIn(classes, right, a.id) { return true; };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn entailsVariantDisequality(classes: &HashMap<Int, Int>, variants: &List<VariantFact>, left: Int, right: Int) -> Bool {
    for aPosition in 0..size(variants) {
        a = get(variants, aPosition);
        for bPosition in 0..size(variants) {
            b = get(variants, bPosition);
            if a.family = b.family {
                distinct = (a.constructor != b.constructor && a.matches && b.matches)
                    || (a.constructor = b.constructor && a.matches != b.matches);
                if distinct {
                    if sameIn(classes, left, a.object) {
                        if sameIn(classes, right, b.object) { return true; };
                    };
                    if sameIn(classes, left, b.object) {
                        if sameIn(classes, right, a.object) { return true; };
                    };
                };
            };
        };
    };
    return false;
};

// A positive test for another variant of the same enum makes this test false.
// Negative facts for other tags do not establish a tag without exhaustiveness.
fn knownVariant(classes: &HashMap<Int, Int>, variants: &List<VariantFact>, object: Int, family: Int, constructor: Int) -> Int {
    answer = -1;
    for factPosition in 0..size(variants) {
        fact = get(variants, factPosition);
        if fact.family = family {
            if sameIn(classes, object, fact.object) {
                if fact.constructor = constructor {
                    if fact.matches { answer = 1; } else { answer = 0; };
                } else if fact.matches {
                    answer = 0;
                };
            };
        };
    };
    return answer;
};

fn equivalentTermIn(classes: &HashMap<Int, Int>, terms: &List<Int>, term: Int) -> Bool {
    for candidatePosition in 0..size(terms) {
        candidate = get(terms, candidatePosition);
        if sameIn(classes, candidate, term) { return true; };
    };
    return false;
};

fn contextWithin(context: &ValidatorContext, inner: Int, outer: Int) -> Bool {
    return contextWithinUnder(context, leastClasses(closeContext(context)), inner, outer);
};

// (the classes reached from outer by reading a field or an element, as a set
// that grows until a pass adds nothing)
fn contextWithinUnder(context: &ValidatorContext, classes: &HashMap<Int, Int>, inner: Int, outer: Int) -> Bool {
    fieldSet = HashSet::new();
    for function in context.fieldFunctions { fieldSet = fieldSet.insert(function); };
    innerClass = ufFind(classes, inner);
    outerClass = ufFind(classes, outer);
    if innerClass = outerClass { return false; };
    reached = HashSet::new();
    reached = reached.insert(outerClass);
    changed = true;
    // Each useful round adds a distinct field-result class; the graph is finite.
    // An element of a list that is a part is a part too (a call's argument has
    // the parameter's type, so it is a smaller value of it).
    for round in 0..size(context.applications) {
        if changed {
            changed = false;
            for appPosition in 0..size(context.applications) {
                app = get(context.applications, appPosition);
                step = false;
                if app.function = -14 && size(app.arguments) = 2 { step = true; };
                if size(app.arguments) = 1 && fieldSet.contains(app.function) { step = true; };
                if step {
                    if reached.contains(ufFind(classes, get(app.arguments, 0))) {
                        c = ufFind(classes, app.id);
                        if reached.contains(c) = false { reached = reached.insert(c); changed = true; };
                    };
                };
            };
        };
    };
    return reached.contains(innerClass);
};

enum VariantObjectLookup { Missing, Found { object: Int } };

impl Clone for VariantObjectLookup { };

impl Copy for VariantObjectLookup { };

// Resolve the object from the saved IsVariant application, not from the
// current local value, which may have been reassigned after the test.
fn variantTestObject(context: &ValidatorContext, test: Int, predicate: Int) -> VariantObjectLookup {
    equalities = closeContext(context);
    equalitiesClasses = leastClasses(equalities);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = predicate {
            if size(app.arguments) = 1 {
                if sameIn(equalitiesClasses, app.id, test) {
                    return VariantObjectLookup::Found { object: get(app.arguments, 0) };
                };
            };
        };
    };
    return VariantObjectLookup::Missing;
};

// False means not established, including when a search omitted an overflowed
// path. The context must use distinct identifiers for distinct terms and the
// documented constant kinds; the host is responsible for encoding it.
enum IntegerLookup { Missing, Found { value: Int } };

impl Clone for IntegerLookup { };

impl Copy for IntegerLookup { };

fn integerValue(context: &ValidatorContext, term: Int) -> IntegerLookup {
    return integerValueIn(leastClasses(semanticFacts(context.equalities, context.applications, context.constants)), context.constants, term);
};

// The integer constant in the class of a term, if any (the classes are those
// of facts the context entails)
fn integerValueIn(classes: &HashMap<Int, Int>, constants: &List<ConstantTerm>, term: Int) -> IntegerLookup {
    for constantPosition in 0..size(constants) {
        constant = get(constants, constantPosition);
        if constant.kind = 0 && sameIn(classes, constant.id, term) {
            return IntegerLookup::Found { value: constant.value };
        };
    };
    return IntegerLookup::Missing;
};

// What the signs of terms are read from: the closed equalities, the orders
// over them, and the constant 0 if there is one (they depend on the context
// alone, so a search that asks of many terms makes them once)
struct SignFacts { equalities: List<EqualityFact>, classes: HashMap<Int, Int>, orders: List<OrderFact>, zero: Int, zeroFound: Bool };

impl Clone for SignFacts { };

fn signFacts(context: &ValidatorContext) -> SignFacts {
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    zero = 0;
    zeroFound = false;
    for constantPosition in 0..size(context.constants) {
        if get(context.constants, constantPosition).kind = 0 && get(context.constants, constantPosition).value = 0 {
            zero = get(context.constants, constantPosition).id;
            zeroFound = true;
        };
    };
    return SignFacts { classes: clone(equalitiesClasses), equalities: equalities, orders: orders, zero: zero, zeroFound: zeroFound };
};

fn knownNonnegative(context: &ValidatorContext, term: Int) -> Bool {
    return knownNonnegativeWith(context, signFacts(context), term);
};

fn knownNonnegativeWith(context: &ValidatorContext, signs: &SignFacts, term: Int) -> Bool {
    if isSizeTerm(context.applications, term) { return true; };
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 && hasEquality(signs.equalities, constant.id, term) {
            if constant.value >= 0 { return true; };
            if signs.zeroFound = false { return false; };
            return hasOrderIn(signs.classes, signs.orders, signs.zero, term, false);
        };
    };
    if signs.zeroFound = false { return false; };
    return hasOrderIn(signs.classes, signs.orders, signs.zero, term, false);
};

fn hasOrderFact(facts: &List<OrderFact>, smaller: Int, greater: Int) -> Bool {
    for factPosition in 0..size(facts) {
        fact = get(facts, factPosition);
        if fact.smaller = smaller && fact.greater = greater { return true; };
    };
    return false;
};

// Facts about a sum whose parts are only known nonnegative after the sum was
// formed (a contract may state the sum before the signs) are derived when a
// goal is checked, from whatever signs are known by then.
fn deriveSumOrders(context: &ValidatorContext) -> ValidatorContext {
    signs = signFacts(context);
    facts = clone(context.orders);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -1 {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                if knownNonnegativeWith(context, signs, a) {
                    if hasOrderFact(facts, b, app.id) = false { facts = push(facts, OrderFact { smaller: b, greater: app.id, strict: false }); };
                };
                if knownNonnegativeWith(context, signs, b) {
                    if hasOrderFact(facts, a, app.id) = false { facts = push(facts, OrderFact { smaller: a, greater: app.id, strict: false }); };
                };
            };
        };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};


struct LinTerm { term: Int, coeff: Int };

impl Clone for LinTerm { };

impl Copy for LinTerm { };

struct LinFact { terms: List<LinTerm>, bound: Int };

impl Clone for LinFact { };

fn linCoeff(terms: &List<LinTerm>, term: Int) -> Int {
    for tPosition in 0..size(terms) {
        t = get(terms, tPosition);
        if t.term = term { return t.coeff; };
    };
    return 0;
};

fn linAddTerm(terms: &List<LinTerm>, term: Int, coeff: Int) -> List<LinTerm> {
    if coeff = 0 { return clone(terms); };
    result = [];
    found = false;
    for tPosition in 0..size(terms) {
        t = get(terms, tPosition);
        if t.term = term {
            found = true;
            if t.coeff + coeff != 0 { result = push(result, LinTerm { term: term, coeff: t.coeff + coeff }); };
        } else { result = push(result, clone(t)); };
    };
    if found = false { result = push(result, LinTerm { term: term, coeff: coeff }); };
    return result;
};

fn linScale(terms: &List<LinTerm>, factor: Int) -> List<LinTerm> {
    result = [];
    for t in terms { result = push(result, LinTerm { term: t.term, coeff: t.coeff * factor }); };
    return result;
};

fn linGcdStep(x: Int, y: Int) -> Int [{ affirm x >= 0; affirm y >= 0; }] [{ }] shrinks y {
    if y = 0 { return x; };
    return linGcdStep(y, x % y);
};

fn linGcd(a: Int, b: Int) -> Int {
    x = a;
    if x < 0 { x = 0 - x; };
    y = b;
    if y < 0 { y = 0 - y; };
    return linGcdStep(x, y);
};

fn linFloorDiv(a: Int, g: Int) -> Int {
    if g = 0 { return a; };
    // (/ is floor division, as the division facts say it is)
    return a / g;
};

// Over integers a fact may be divided through by the gcd of its
// coefficients, rounding the bound down: 2i - 2j <= 1 is i - j <= 0.
fn linNormalize(fact: &LinFact) -> LinFact {
    g = 0;
    for t in fact.terms { g = linGcd(g, t.coeff); };
    if g <= 1 { return clone(fact); };
    terms = [];
    for t in fact.terms { terms = push(terms, LinTerm { term: t.term, coeff: t.coeff / g }); };
    return LinFact { terms: terms, bound: linFloorDiv(fact.bound, g) };
};

fn linCombine(a: &LinFact, scaleA: Int, b: &LinFact, scaleB: Int) -> LinFact {
    // The reference reasons over mathematical integers; a running
    // program cannot. A combination whose bound (or a coefficient) is
    // not representable is dropped, by returning a fact that says
    // nothing: 0 <= the greatest integer.
    boundA = safeProduct(scaleA, a.bound);
    if boundA is SumResult::Overflow { return LinFact { terms: [], bound: 9223372036854775807 }; };
    boundB = safeProduct(scaleB, b.bound);
    if boundB is SumResult::Overflow { return LinFact { terms: [], bound: 9223372036854775807 }; };
    bound = safeBoundSum((boundA as SumResult::Sum).value, (boundB as SumResult::Sum).value);
    if bound is SumResult::Overflow { return LinFact { terms: [], bound: 9223372036854775807 }; };
    terms = [];
    for tPosition in 0..size(a.terms) {
        t = get(a.terms, tPosition);
        p = safeProduct(t.coeff, scaleA);
        if p is SumResult::Overflow { return LinFact { terms: [], bound: 9223372036854775807 }; };
        terms = linAddTerm(terms, t.term, (p as SumResult::Sum).value);
    };
    for tPosition in 0..size(b.terms) {
        t = get(b.terms, tPosition);
        p = safeProduct(t.coeff, scaleB);
        if p is SumResult::Overflow { return LinFact { terms: [], bound: 9223372036854775807 }; };
        terms = linAddTerm(terms, t.term, (p as SumResult::Sum).value);
    };
    return linNormalize(LinFact { terms: terms, bound: (bound as SumResult::Sum).value });
};

fn linFact2(t1: Int, c1: Int, t2: Int, c2: Int, bound: Int) -> LinFact {
    terms = linAddTerm([], t1, c1);
    terms = linAddTerm(terms, t2, c2);
    return LinFact { terms: terms, bound: bound };
};

// The facts of a context as linear inequalities over terms: orders and
// differences directly, equalities and the defining identities of sum,
// difference, scale and size applications as equations.
// The representative of a term under the known equalities: arithmetic
// over applications only combines when the same value, reached through
// equal terms (a projection of a pair and the pair's part, say), is one
// variable, so applications and facts are read through representatives.
fn canonicalTerm(known: &List<EqualityFact>, term: Int) -> Int {
    return canonicalIn(leastClasses(known), term);
};

// Each term of the facts, mapped to the least member of its class (a term
// of no fact is its own class)
fn leastClasses(known: &List<EqualityFact>) -> HashMap<Int, Int> {
    uf = unionOf(known);
    least = emptyIntMap();
    for fPosition in 0..size(known) {
        f = get(known, fPosition);
        r = ufFind(uf, f.left);
        m = least.lookup(r, r);
        if f.left < m { m = f.left; };
        if f.right < m { m = f.right; };
        least = least.insert(r, m);
    };
    classes = emptyIntMap();
    for fPosition in 0..size(known) {
        f = get(known, fPosition);
        r = ufFind(uf, f.left);
        m = least.lookup(r, r);
        classes = classes.insert(f.left, m);
        classes = classes.insert(f.right, m);
    };
    return classes;
};

// Whether two terms are in one class of a map from each term to the least
// member of its class (leastClasses): what hasEquality says of the list the
// map was made from, by two lookups
fn sameIn(classes: &HashMap<Int, Int>, left: Int, right: Int) -> Bool {
    if left = right { return true; };
    return canonicalIn(classes, left) = canonicalIn(classes, right);
};

fn hasDifferenceIn(classes: &HashMap<Int, Int>, facts: &List<DifferenceFact>, left: Int, right: Int, bound: Int) -> Bool {
    return canonicalHasDifference(canonicalDifferencesIn(classes, facts), canonicalIn(classes, left), canonicalIn(classes, right), bound);
};

fn canonicalIn(classes: &HashMap<Int, Int>, term: Int) -> Int {
    return classes.lookup(term, term);
};
// Every term the arithmetic reads is replaced by the representative of
// its equality class: the same value reached through equal terms (a
// projection of a pair and the pair's part, say) must be one variable,
// or counts and sizes of it never combine.
fn canonicalFacts(context: &ValidatorContext) -> List<EqualityFact> {
    return applicationFactsWithConstructors(semanticFacts(context.equalities, context.applications, context.constants), context.applications, context.constructorFunctions, context.constructorFields);
};

fn canonicalContext(context: &ValidatorContext, classes: &HashMap<Int, Int>) -> ValidatorContext {
    equalities = [];
    for f in context.equalities { equalities = push(equalities, EqualityFact { left: canonicalIn(classes, f.left), right: canonicalIn(classes, f.right) }); };
    applications = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        args = [];
        for arg in app.arguments { args = push(args, canonicalIn(classes, arg)); };
        applications = push(applications, ApplicationTerm { id: canonicalIn(classes, app.id), function: app.function, arguments: args });
    };
    constants = [];
    for c in context.constants { constants = push(constants, ConstantTerm { id: canonicalIn(classes, c.id), kind: c.kind, value: c.value }); };
    orders = [];
    for o in context.orders { orders = push(orders, OrderFact { smaller: canonicalIn(classes, o.smaller), greater: canonicalIn(classes, o.greater), strict: o.strict }); };
    different = [];
    for d in context.different { different = push(different, DisequalityFact { left: canonicalIn(classes, d.left), right: canonicalIn(classes, d.right) }); };
    variants = [];
    for v in context.variants { variants = push(variants, VariantFact { object: canonicalIn(classes, v.object), family: v.family, constructor: v.constructor, matches: v.matches }); };
    differences = [];
    for d in context.differences { differences = push(differences, DifferenceFact { left: canonicalIn(classes, d.left), right: canonicalIn(classes, d.right), bound: d.bound }); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: clone(context.fieldFunctions), constructorFunctions: clone(context.constructorFunctions), constructorFields: clone(context.constructorFields), differences: differences };
};

fn linFacts(context: &ValidatorContext) -> List<LinFact> {
    valueClasses = leastClasses(semanticFacts(context.equalities, context.applications, context.constants));
    facts = [];
    for orderPosition in 0..size(context.orders) {
        order = get(context.orders, orderPosition);
        bound = 0;
        if order.strict { bound = -1; };
        facts = push(facts, linFact2(order.smaller, 1, order.greater, -1, bound));
    };
    for dPosition in 0..size(context.differences) {
        d = get(context.differences, dPosition);
        facts = push(facts, linFact2(d.left, 1, d.right, -1, d.bound));
    };
    for ePosition in 0..size(context.equalities) {
        e = get(context.equalities, ePosition);
        facts = push(facts, linFact2(e.left, 1, e.right, -1, 0));
        facts = push(facts, linFact2(e.left, -1, e.right, 1, 0));
    };
    for cPosition in 0..size(context.constants) {
        c = get(context.constants, cPosition);
        if c.kind = 0 {
            facts = push(facts, linFact2(c.id, 1, c.id, 0, c.value));
            // (the least integer has no negation a program can write;
            // the fact it would give, that the term is at least that
            // integer, says nothing, so it is left out)
            if c.value > -9223372036854775807 - 1 {
                facts = push(facts, linFact2(c.id, -1, c.id, 0, 0 - c.value));
            };
        };
    };
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -13 {
            if size(app.arguments) = 1 {
                facts = push(facts, linFact2(app.id, -1, app.id, 0, 0));
            };
        };
        if size(app.arguments) = 2 {
            a = get(app.arguments, 0);
            b = get(app.arguments, 1);
            if app.function = -1 {
                t = linAddTerm([], app.id, 1);
                t = linAddTerm(t, a, -1);
                t = linAddTerm(t, b, -1);
                facts = push(facts, LinFact { terms: t, bound: 0 });
                t = linAddTerm([], app.id, -1);
                t = linAddTerm(t, a, 1);
                t = linAddTerm(t, b, 1);
                facts = push(facts, LinFact { terms: t, bound: 0 });
            };
            if app.function = -2 {
                t = linAddTerm([], app.id, 1);
                t = linAddTerm(t, a, -1);
                t = linAddTerm(t, b, 1);
                facts = push(facts, LinFact { terms: t, bound: 0 });
                t = linAddTerm([], app.id, -1);
                t = linAddTerm(t, a, 1);
                t = linAddTerm(t, b, -1);
                facts = push(facts, LinFact { terms: t, bound: 0 });
            };
            if app.function = -4 {
                bv = integerValueIn(valueClasses, context.constants, b);
                if bv is IntegerLookup::Found {
                    divisor = (bv as IntegerLookup::Found).value;
                    if divisor > 0 {
                        t = linAddTerm([], app.id, divisor);
                        t = linAddTerm(t, a, -1);
                        facts = push(facts, LinFact { terms: t, bound: 0 });
                        t = linAddTerm([], a, 1);
                        t = linAddTerm(t, app.id, 0 - divisor);
                        facts = push(facts, LinFact { terms: t, bound: divisor - 1 });
                    };
                    if divisor < 0 {
                        t = linAddTerm([], app.id, divisor);
                        t = linAddTerm(t, a, -1);
                        facts = push(facts, LinFact { terms: t, bound: 0 - divisor - 1 });
                        t = linAddTerm([], a, 1);
                        t = linAddTerm(t, app.id, 0 - divisor);
                        facts = push(facts, LinFact { terms: t, bound: 0 });
                    };
                };
            };
            if app.function = -5 {
                bv = integerValueIn(valueClasses, context.constants, b);
                if bv is IntegerLookup::Found {
                    divisor = (bv as IntegerLookup::Found).value;
                    if divisor > 0 {
                        facts = push(facts, linFact2(app.id, 1, app.id, 0, divisor - 1));
                        facts = push(facts, linFact2(app.id, -1, app.id, 0, 0));
                    };
                    if divisor < 0 {
                        facts = push(facts, linFact2(app.id, 1, app.id, 0, 0));
                        facts = push(facts, linFact2(app.id, -1, app.id, 0, 0 - divisor - 1));
                    };
                    if divisor != 0 {
                        for otherPosition in 0..size(context.applications) {
                            other = get(context.applications, otherPosition);
                            if other.function = -4 {
                                if size(other.arguments) = 2 {
                                    if hasEquality(context.equalities, get(other.arguments, 0), a) {
                                        if hasEquality(context.equalities, get(other.arguments, 1), b) {
                                            t = linAddTerm([], a, 1);
                                            t = linAddTerm(t, other.id, 0 - divisor);
                                            t = linAddTerm(t, app.id, -1);
                                            facts = push(facts, LinFact { terms: t, bound: 0 });
                                            t = linAddTerm([], a, -1);
                                            t = linAddTerm(t, other.id, divisor);
                                            t = linAddTerm(t, app.id, 1);
                                            facts = push(facts, LinFact { terms: t, bound: 0 });
                                        };
                                    };
                                };
                            };
                            if divisor > 0 {
                                if other.function = -5 {
                                    if size(other.arguments) = 2 {
                                        if hasEquality(context.equalities, get(other.arguments, 1), b) {
                                            x = get(other.arguments, 0);
                                            for sumAppPosition in 0..size(context.applications) {
                                                sumApp = get(context.applications, sumAppPosition);
                                                if sumApp.function = -1 {
                                                    if size(sumApp.arguments) = 2 {
                                                        if hasEquality(context.equalities, sumApp.id, a) {
                                                            if hasEquality(context.equalities, get(sumApp.arguments, 0), x) {
                                                                ry = get(sumApp.arguments, 1);
                                                                for modYPosition in 0..size(context.applications) {
                                                                    modY = get(context.applications, modYPosition);
                                                                    if modY.function = -5 {
                                                                        if size(modY.arguments) = 2 {
                                                                            if hasEquality(context.equalities, get(modY.arguments, 0), ry) {
                                                                                if hasEquality(context.equalities, get(modY.arguments, 1), b) {
                                                                                    t = linAddTerm([], app.id, 1);
                                                                                    t = linAddTerm(t, other.id, -1);
                                                                                    t = linAddTerm(t, modY.id, -1);
                                                                                    facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                                    t = linAddTerm([], app.id, -1);
                                                                                    t = linAddTerm(t, other.id, 1);
                                                                                    t = linAddTerm(t, modY.id, 1);
                                                                                    facts = push(facts, LinFact { terms: t, bound: divisor });
                                                                                    kvx = integerValueIn(valueClasses, context.constants, other.id);
                                                                                    kvy = integerValueIn(valueClasses, context.constants, modY.id);
                                                                                    if kvx is IntegerLookup::Found {
                                                                                        if kvy is IntegerLookup::Found {
                                                                                            if (kvx as IntegerLookup::Found).value + (kvy as IntegerLookup::Found).value >= divisor {
                                                                                                t = linAddTerm([], app.id, 1);
                                                                                                t = linAddTerm(t, other.id, -1);
                                                                                                t = linAddTerm(t, modY.id, -1);
                                                                                                facts = push(facts, LinFact { terms: t, bound: 0 - divisor });
                                                                                            };
                                                                                            if (kvx as IntegerLookup::Found).value + (kvy as IntegerLookup::Found).value < divisor {
                                                                                                t = linAddTerm([], app.id, -1);
                                                                                                t = linAddTerm(t, other.id, 1);
                                                                                                t = linAddTerm(t, modY.id, 1);
                                                                                                facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                            if hasEquality(context.equalities, get(sumApp.arguments, 1), x) {
                                                                ry = get(sumApp.arguments, 0);
                                                                for modYPosition in 0..size(context.applications) {
                                                                    modY = get(context.applications, modYPosition);
                                                                    if modY.function = -5 {
                                                                        if size(modY.arguments) = 2 {
                                                                            if hasEquality(context.equalities, get(modY.arguments, 0), ry) {
                                                                                if hasEquality(context.equalities, get(modY.arguments, 1), b) {
                                                                                    t = linAddTerm([], app.id, 1);
                                                                                    t = linAddTerm(t, other.id, -1);
                                                                                    t = linAddTerm(t, modY.id, -1);
                                                                                    facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                                    t = linAddTerm([], app.id, -1);
                                                                                    t = linAddTerm(t, other.id, 1);
                                                                                    t = linAddTerm(t, modY.id, 1);
                                                                                    facts = push(facts, LinFact { terms: t, bound: divisor });
                                                                                    kvx = integerValueIn(valueClasses, context.constants, other.id);
                                                                                    kvy = integerValueIn(valueClasses, context.constants, modY.id);
                                                                                    if kvx is IntegerLookup::Found {
                                                                                        if kvy is IntegerLookup::Found {
                                                                                            if (kvx as IntegerLookup::Found).value + (kvy as IntegerLookup::Found).value >= divisor {
                                                                                                t = linAddTerm([], app.id, 1);
                                                                                                t = linAddTerm(t, other.id, -1);
                                                                                                t = linAddTerm(t, modY.id, -1);
                                                                                                facts = push(facts, LinFact { terms: t, bound: 0 - divisor });
                                                                                            };
                                                                                            if (kvx as IntegerLookup::Found).value + (kvy as IntegerLookup::Found).value < divisor {
                                                                                                t = linAddTerm([], app.id, -1);
                                                                                                t = linAddTerm(t, other.id, 1);
                                                                                                t = linAddTerm(t, modY.id, 1);
                                                                                                facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                                            };
                                                                                        };
                                                                                    };
                                                                                };
                                                                            };
                                                                        };
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                                if sumApp.function = -2 {
                                                    if size(sumApp.arguments) = 2 {
                                                        if hasEquality(context.equalities, sumApp.id, a) {
                                                            kv = integerValueIn(valueClasses, context.constants, get(sumApp.arguments, 1));
                                                            if kv is IntegerLookup::Found {
                                                                if (kv as IntegerLookup::Found).value % divisor = 0 {
                                                                    if hasEquality(context.equalities, get(sumApp.arguments, 0), x) {
                                                                        t = linAddTerm([], app.id, 1);
                                                                        t = linAddTerm(t, other.id, -1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                        t = linAddTerm([], app.id, -1);
                                                                        t = linAddTerm(t, other.id, 1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                            for sumAppPosition in 0..size(context.applications) {
                                                sumApp = get(context.applications, sumAppPosition);
                                                if sumApp.function = -1 {
                                                    if size(sumApp.arguments) = 2 {
                                                        if hasEquality(context.equalities, sumApp.id, a) {
                                                            kv = integerValueIn(valueClasses, context.constants, get(sumApp.arguments, 1));
                                                            if kv is IntegerLookup::Found {
                                                                if (kv as IntegerLookup::Found).value % divisor = 0 {
                                                                    if hasEquality(context.equalities, get(sumApp.arguments, 0), x) {
                                                                        t = linAddTerm([], app.id, 1);
                                                                        t = linAddTerm(t, other.id, -1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                        t = linAddTerm([], app.id, -1);
                                                                        t = linAddTerm(t, other.id, 1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                    };
                                                                };
                                                            };
                                                            kv = integerValueIn(valueClasses, context.constants, get(sumApp.arguments, 0));
                                                            if kv is IntegerLookup::Found {
                                                                if (kv as IntegerLookup::Found).value % divisor = 0 {
                                                                    if hasEquality(context.equalities, get(sumApp.arguments, 1), x) {
                                                                        t = linAddTerm([], app.id, 1);
                                                                        t = linAddTerm(t, other.id, -1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                        t = linAddTerm([], app.id, -1);
                                                                        t = linAddTerm(t, other.id, 1);
                                                                        facts = push(facts, LinFact { terms: t, bound: 0 });
                                                                    };
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
            if app.function = -3 {
                av = integerValueIn(valueClasses, context.constants, a);
                if av is IntegerLookup::Found {
                    c = (av as IntegerLookup::Found).value;
                    t = linAddTerm([], app.id, 1);
                    t = linAddTerm(t, b, 0 - c);
                    facts = push(facts, LinFact { terms: t, bound: 0 });
                    t = linAddTerm([], app.id, -1);
                    t = linAddTerm(t, b, c);
                    facts = push(facts, LinFact { terms: t, bound: 0 });
                };
                bv = integerValueIn(valueClasses, context.constants, b);
                if bv is IntegerLookup::Found {
                    c = (bv as IntegerLookup::Found).value;
                    t = linAddTerm([], app.id, 1);
                    t = linAddTerm(t, a, 0 - c);
                    facts = push(facts, LinFact { terms: t, bound: 0 });
                    t = linAddTerm([], app.id, -1);
                    t = linAddTerm(t, a, c);
                    facts = push(facts, LinFact { terms: t, bound: 0 });
                };
            };
        };
    };
    return facts;
};

fn linSameFact(a: &LinFact, b: &LinFact) -> Bool {
    if a.bound != b.bound { return false; };
    if size(a.terms) != size(b.terms) { return false; };
    for tPosition in 0..size(a.terms) {
        t = get(a.terms, tPosition);
        if linCoeff(b.terms, t.term) != t.coeff { return false; };
    };
    return true;
};

fn linDedup(facts: &List<LinFact>) -> List<LinFact> {
    result = [];
    for fPosition in 0..size(facts) {
        f = get(facts, fPosition);
        seen = false;
        for gPosition in 0..size(result) {
            g = get(result, gPosition);
            if linSameFact(f, g) { seen = true; };
        };
        if seen = false { result = push(result, clone(f)); };
    };
    return result;
};

fn linRemoveTerm(values: &List<Int>, value: Int) -> List<Int> {
    result = [];
    for xPosition in 0..size(values) {
        x = get(values, xPosition);
        if x != value { result = push(result, x); };
    };
    return result;
};

// Fourier-Motzkin elimination over the (small) fact sets a goal produces:
// eliminating every variable either derives 0 <= a negative bound, proving
// the facts inconsistent, or it does not.
fn linContradictionOrdered(facts: &List<LinFact>, vars: &List<Int>) -> Bool {
    current = clone(facts);
    for vPosition in 0..size(vars) {
        v = get(vars, vPosition);
        if size(current) > 600 { return false; };
        pos = [];
        neg = [];
        zero = [];
        for fPosition in 0..size(current) {
            f = get(current, fPosition);
            c = linCoeff(f.terms, v);
            if c > 0 { pos = push(pos, clone(f)); };
            if c < 0 { neg = push(neg, clone(f)); };
            if c = 0 { zero = push(zero, clone(f)); };
        };
        next = zero;
        for fPosition in 0..size(pos) {
            f = get(pos, fPosition);
            for gPosition in 0..size(neg) {
                g = get(neg, gPosition);
                cf = linCoeff(f.terms, v);
                cg = linCoeff(g.terms, v);
                next = push(next, linCombine(f, 0 - cg, g, cf));
            };
        };
        current = next;
        for fPosition in 0..size(current) {
            f = get(current, fPosition);
            if size(f.terms) = 0 {
                if f.bound < 0 { return true; };
            };
        };
    };
    return false;
};

// The same elimination, but each round first removes the variable whose
// positive and negative facts combine into the fewest new facts. The order
// matters to the integer reasoning: a variable that appears only in the
// identity of a scaled term carries a divisibility constraint, and removing
// it first would lose that constraint, so both orders are tried.
fn linContradiction(facts: &List<LinFact>, vars: &List<Int>) -> Bool {
    if linContradictionOrdered(facts, vars) { return true; };
    current = clone(facts);
    remaining = clone(vars);
    for round in 0..size(vars) {
        if size(current) > 600 { return false; };
        best = 0;
        bestCost = 0;
        found = false;
        for vPosition in 0..size(remaining) {
            v = get(remaining, vPosition);
            posCount = 0;
            negCount = 0;
            for fPosition in 0..size(current) {
                f = get(current, fPosition);
                c = linCoeff(f.terms, v);
                if c > 0 { posCount = posCount + 1; };
                if c < 0 { negCount = negCount + 1; };
            };
            if posCount + negCount > 0 {
                cost = posCount * negCount;
                if found = false || cost < bestCost {
                    best = v;
                    bestCost = cost;
                    found = true;
                };
            };
        };
        if found = false { return false; };
        v = best;
        pos = [];
        neg = [];
        zero = [];
        for fPosition in 0..size(current) {
            f = get(current, fPosition);
            c = linCoeff(f.terms, v);
            if c > 0 { pos = push(pos, clone(f)); };
            if c < 0 { neg = push(neg, clone(f)); };
            if c = 0 { zero = push(zero, clone(f)); };
        };
        next = zero;
        for fPosition in 0..size(pos) {
            f = get(pos, fPosition);
            for gPosition in 0..size(neg) {
                g = get(neg, gPosition);
                cf = linCoeff(f.terms, v);
                cg = linCoeff(g.terms, v);
                next = push(next, linCombine(f, 0 - cg, g, cf));
            };
        };
        current = next;
        for fPosition in 0..size(current) {
            f = get(current, fPosition);
            if size(f.terms) = 0 {
                if f.bound < 0 { return true; };
            };
        };
        nextVars = [];
        for t in remaining { if t != v { nextVars = push(nextVars, t); }; };
        remaining = nextVars;
    };
    return false;
};

struct Joined { set: HashSet<Int>, grew: Bool };

impl Clone for Joined { };

// The relevant terms after a fact between a and b: each side joins when the
// other is relevant (and not a constant, unless throughConstants); a fact
// between two constants joins nothing when constantPairsApart
fn joinRelevant(relevant: HashSet<Int>, constantIds: &HashSet<Int>, a: Int, b: Int, throughConstants: Bool, constantPairsApart: Bool) -> Joined {
    set = relevant;
    if constantPairsApart && constantIds.contains(a) && constantIds.contains(b) { return Joined { set: set, grew: false }; };
    grew = false;
    aJoins = set.contains(a) && (throughConstants || constantIds.contains(a) = false);
    bJoins = set.contains(b) && (throughConstants || constantIds.contains(b) = false);
    if bJoins && set.contains(a) = false { set = set.insert(a); grew = true; };
    if aJoins && set.contains(b) = false { set = set.insert(b); grew = true; };
    return Joined { set: set, grew: grew };
};

fn linearEntails(context: &ValidatorContext, left: Int, right: Int, bound: Int) -> Bool {
    return linearEntailsIn(context, leastClasses(canonicalFacts(context)), left, right, bound);
};

// The same, with the terms named by their classes under equalities the
// context entails (the analysis's, which a caller with one has)
fn linearEntailsIn(context: &ValidatorContext, classes: &HashMap<Int, Int>, left: Int, right: Int, bound: Int) -> Bool {
    canon = canonicalContext(context, classes);
    goalLeft = canonicalIn(classes, left);
    goalRight = canonicalIn(classes, right);
    // (an order between two integer constants says nothing their values do
    // not, and the chain of them would join every constant to the goal)
    constantIds = HashSet::new();
    for c in canon.constants { if c.kind = 0 { constantIds = constantIds.insert(c.id); }; };
    wideTerms = linearRelevant(canon, constantIds, goalLeft, goalRight, true);
    wide = linearAttempt(canon, wideTerms, goalLeft, goalRight, bound);
    if wide != 2 { return wide = 1; };
    // (past the budget, the facts are taken again without joining through a
    // constant: x in 0 <= x brings every term with a bound into the goal's
    // component, though only a contradiction there could bear on the goal)
    narrowTerms = linearRelevant(canon, constantIds, goalLeft, goalRight, false);
    if narrowTerms.size() >= wideTerms.size() { return false; };
    return linearAttempt(canon, narrowTerms, goalLeft, goalRight, bound) = 1;
};

// The terms in the goal's own component of the term graph: only the facts
// over them can bear on it, and the rest would spend the variable budget.
// A constant joins the terms it is tied to only when throughConstants.
fn linearRelevant(canon: &ValidatorContext, constantIds: &HashSet<Int>, goalLeft: Int, goalRight: Int, throughConstants: Bool) -> HashSet<Int> {
    relevant = HashSet::new();
    relevant = relevant.insert(goalLeft);
    relevant = relevant.insert(goalRight);
    growing = true;
    // (each round that grows the set adds a term of the context to it)
    for round in 0..2 * (size(canon.equalities) + size(canon.orders) + size(canon.differences)) + 2 * size(canon.applications) + 2 {
        if growing {
            Joined { set: relevant, grew: growing } = relevantRound(canon, constantIds, relevant, throughConstants);
        };
    };
    return relevant;
};

fn relevantRound(canon: &ValidatorContext, constantIds: &HashSet<Int>, given: HashSet<Int>, throughConstants: Bool) -> Joined {
    relevant = given;
    grew = false;
    for fPosition in 0..size(canon.equalities) {
        Joined { set: relevant, grew: g } = joinRelevant(relevant, constantIds, get(canon.equalities, fPosition).left, get(canon.equalities, fPosition).right, throughConstants, false);
        if g { grew = true; };
    };
    for fPosition in 0..size(canon.orders) {
        Joined { set: relevant, grew: g } = joinRelevant(relevant, constantIds, get(canon.orders, fPosition).smaller, get(canon.orders, fPosition).greater, throughConstants, true);
        if g { grew = true; };
    };
    for fPosition in 0..size(canon.differences) {
        Joined { set: relevant, grew: g } = joinRelevant(relevant, constantIds, get(canon.differences, fPosition).left, get(canon.differences, fPosition).right, throughConstants, true);
        if g { grew = true; };
    };
    // (only arithmetic gives linear facts that join a term to its
    // arguments: through a get, every element of a literal would join)
    for appPosition in 0..size(canon.applications) {
        Joined { set: relevant, grew: g } = joinApplication(relevant, constantIds, get(canon.applications, appPosition), throughConstants);
        if g { grew = true; };
    };
    return Joined { set: relevant, grew: grew };
};

fn joinApplication(given: HashSet<Int>, constantIds: &HashSet<Int>, app: &ApplicationTerm, throughConstants: Bool) -> Joined {
    relevant = given;
    if app.function > -1 || app.function < -5 { return Joined { set: relevant, grew: false }; };
    hit = relevant.contains(app.id) && (throughConstants || constantIds.contains(app.id) = false);
    for arg in app.arguments {
        if relevant.contains(arg) && (throughConstants || constantIds.contains(arg) = false) { hit = true; };
    };
    if hit = false { return Joined { set: relevant, grew: false }; };
    grew = false;
    if relevant.contains(app.id) = false { relevant = relevant.insert(app.id); grew = true; };
    for arg in app.arguments { if relevant.contains(arg) = false { relevant = relevant.insert(arg); grew = true; }; };
    return Joined { set: relevant, grew: grew };
};

// 1 when the facts over the relevant terms and the goal's negation are
// contradictory, 0 when they are not, 2 when they are past the budget
fn linearAttempt(canon: &ValidatorContext, relevant: &HashSet<Int>, goalLeft: Int, goalRight: Int, bound: Int) -> Int {
    kept = [];
    for f in linFacts(canon) {
        use = true;
        for t in f.terms { if relevant.contains(t.term) = false { use = false; }; };
        if use { kept = push(kept, clone(f)); };
    };
    facts = linDedup(kept);
    facts = push(facts, linFact2(goalLeft, -1, goalRight, 1, 0 - bound - 1));
    if size(facts) > 160 { return 2; };
    vars = [];
    for fPosition in 0..size(facts) {
        f = get(facts, fPosition);
        for tPosition in 0..size(f.terms) {
            t = get(f.terms, tPosition);
            if containsValue(vars, t.term) = false { vars = push(vars, t.term); };
        };
    };
    if size(vars) > 48 { return 2; };
    if linContradiction(facts, vars) { return 1; };
    return 0;
};

// Two values of the same constructor with a pair of arguments that are
// known to differ are themselves different: constructors are free.
fn entailsConstructorArgumentDisequality(context: &ValidatorContext, classes: &HashMap<Int, Int>, left: Int, right: Int) -> Bool {
    for aPosition in 0..size(context.applications) {
        a = get(context.applications, aPosition);
        if containsValue(context.constructorFunctions, a.function) {
            for bPosition in 0..size(context.applications) {
                b = get(context.applications, bPosition);
                if sameIn(classes, a.function, b.function) {
                    if sameIn(classes, left, a.id) {
                        if sameIn(classes, right, b.id) {
                            if size(a.arguments) = size(b.arguments) {
                                for i in 0..size(a.arguments) {
                                    x = get(a.arguments, i);
                                    y = get(b.arguments, i);
                                    xv = integerValue(context, x);
                                    yv = integerValue(context, y);
                                    if xv is IntegerLookup::Found {
                                        if yv is IntegerLookup::Found {
                                            if (xv as IntegerLookup::Found).value != (yv as IntegerLookup::Found).value { return true; };
                                        };
                                    };
                                    for dPosition in 0..size(context.different) {
                                        d = get(context.different, dPosition);
                                        if sameIn(classes, d.left, x) {
                                            if sameIn(classes, d.right, y) { return true; };
                                        };
                                        if sameIn(classes, d.left, y) {
                                            if sameIn(classes, d.right, x) { return true; };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn recognizedGoal(goal: ValidatorGoal) -> Bool {
    if goal is ValidatorGoal::Equal { return true; };
    if goal is ValidatorGoal::Different { return true; };
    if goal is ValidatorGoal::Less { return true; };
    if goal is ValidatorGoal::AtMost { return true; };
    if goal is ValidatorGoal::Difference { return true; };
    if goal is ValidatorGoal::Within { return true; };
    return false;
};

// What a goal needs no closure of the context for.
fn entailsGoalDirectly(context: &ValidatorContext, goal: ValidatorGoal) -> Bool {
    return entailsGoalDirectlyIn(context, leastClasses(semanticFacts(context.equalities, context.applications, context.constants)), goal);
};

// The same, given the classes of the context's semantic facts (a caller that
// asks several goals of one context makes them once)
fn entailsGoalDirectlyIn(context: &ValidatorContext, classes: &HashMap<Int, Int>, goal: ValidatorGoal) -> Bool {
    if goal is ValidatorGoal::Equal {
        g = goal as ValidatorGoal::Equal;
        if sameIn(classes, g.left, g.right) { return true; };
    };
    // A concrete comparison that already holds needs no graph closure.
    if goal is ValidatorGoal::Less {
        g = goal as ValidatorGoal::Less;
        a = integerValueIn(classes, context.constants, g.left);
        b = integerValueIn(classes, context.constants, g.right);
        if a is IntegerLookup::Found {
            if b is IntegerLookup::Found {
                if (a as IntegerLookup::Found).value < (b as IntegerLookup::Found).value { return true; };
            };
        };
    };
    if goal is ValidatorGoal::AtMost {
        g = goal as ValidatorGoal::AtMost;
        a = integerValueIn(classes, context.constants, g.left);
        b = integerValueIn(classes, context.constants, g.right);
        if a is IntegerLookup::Found {
            av = (a as IntegerLookup::Found).value;
            if b is IntegerLookup::Found {
                if av <= (b as IntegerLookup::Found).value { return true; };
            };
            // A size is never negative, whether or not the program said so.
            if av = 0 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
    };
    return false;
};

// What a context gives every goal asked of it: the closed equalities, the
// orders and differences, and whether the facts contradict each other.
struct ContextAnalysis { equalities: List<EqualityFact>, classes: HashMap<Int, Int>, orders: List<OrderFact>, differences: List<DifferenceFact>, contradictory: Bool };

impl Clone for ContextAnalysis { };

fn analyzeContext(context: &ValidatorContext) -> ContextAnalysis {
    equalities = closeContext(context);
    equalitiesClasses = leastClasses(equalities);
    contradictory = false;
    if contradictoryVariants(equalitiesClasses, context.variants) { contradictory = true; };
    if contradictory = false {
        if contradictoryConstructors(equalitiesClasses, context.applications, context.constructorFunctions) { contradictory = true; };
    };
    if contradictory = false {
        if contradictoryConstants(equalitiesClasses, context.constants) { contradictory = true; };
    };
    if contradictory = false {
        if contradictoryDisequalities(equalitiesClasses, context.different) { contradictory = true; };
    };
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    differences = constantDifferences(context.constants, comparisonDifferences(orders, context.differences));
    if contradictory = false {
        if contradictoryDifferences(equalitiesClasses, differences) { contradictory = true; };
    };
    return ContextAnalysis { classes: equalitiesClasses, equalities: equalities, orders: orders, differences: differences, contradictory: contradictory };
};

// Two values differ when some part of them differs: if f(a) and f(b) are
// known different, a and b are (congruence read backwards).
fn entailsPartDisequality(context: &ValidatorContext, classes: &HashMap<Int, Int>, orders: &List<OrderFact>, left: Int, right: Int) -> Bool {
    return entailsPartDisequalityWithin(context, classes, orders, left, right, 2);
};

// The classes of equalities, as union and find (ufFind names a class by its root)
fn unionOf(equalities: &List<EqualityFact>) -> HashMap<Int, Int> {
    uf = emptyIntMap();
    weight = emptyIntMap();
    for fPosition in 0..size(equalities) {
        f = get(equalities, fPosition);
        UnionFind { parent: uf, weight: weight } = ufUnion(uf, weight, f.left, f.right);
    };
    return uf;
};

// (two applications of one function differ where the arguments they differ
// in differ: only applications with an argument in the class of left or of
// right can be such a pair, so those are found first)
fn entailsPartDisequalityWithin(context: &ValidatorContext, classes: &HashMap<Int, Int>, orders: &List<OrderFact>, left: Int, right: Int, depth: Int) -> Bool [{ affirm depth >= 0; }] [{ }] shrinks depth {
    rl = ufFind(classes, left);
    rr = ufFind(classes, right);
    candidates = [];
    for aPosition in 0..size(context.applications) {
        a = get(context.applications, aPosition);
        near = false;
        for xPosition in 0..size(a.arguments) {
            r = ufFind(classes, get(a.arguments, xPosition));
            if r = rl || r = rr { near = true; };
        };
        if near { candidates = push(candidates, aPosition); };
    };
    for ac in 0..size(candidates) {
        a = applicationAt(context.applications, get(candidates, ac));
        for bc in 0..size(candidates) {
            b = applicationAt(context.applications, get(candidates, bc));
            if a.function = b.function {
                if size(a.arguments) = size(b.arguments) {
                    uses = false;
                    matches = true;
                    for i in 0..size(a.arguments) {
                        x = ufFind(classes, get(a.arguments, i));
                        y = ufFind(classes, get(b.arguments, i));
                        if x = rl {
                            if y = rr { uses = true; } else if x != y { matches = false; };
                        } else if x = rr {
                            if y = rl { uses = true; } else if x != y { matches = false; };
                        } else if x != y { matches = false; };
                    };
                    if uses {
                        if matches {
                            if closedDisequality(classes, orders, context.different, a.id, b.id) { return true; };
                            if depth > 1 && a.id != left && a.id != right {
                                if entailsPartDisequalityWithin(context, classes, orders, a.id, b.id, depth - 1) { return true; };
                            };
                            av = integerValue(context, a.id);
                            bv = integerValue(context, b.id);
                            if av is IntegerLookup::Found {
                                if bv is IntegerLookup::Found {
                                    if (av as IntegerLookup::Found).value != (bv as IntegerLookup::Found).value { return true; };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

struct GetFact { seq: Int, at: Int, found: Bool };

impl Clone for GetFact { };

impl Copy for GetFact { };

fn getFactOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int) -> GetFact {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -14 {
            if size(app.arguments) = 2 {
                if sameIn(classes, app.id, term) {
                    return GetFact { seq: get(app.arguments, 0), at: get(app.arguments, 1), found: true };
                };
            };
        };
    };
    return GetFact { seq: 0, at: 0, found: false };
};

// Every recorded reading of a term: a value produced by a sequence
// operation is also the reading of what it came from (a pushed, set or
// popped list), so one term can be a get of several lists.
fn getFactsOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int) -> List<GetFact> {
    facts = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -14 {
            if size(app.arguments) = 2 {
                if sameIn(classes, app.id, term) {
                    facts = push(facts, GetFact { seq: get(app.arguments, 0), at: get(app.arguments, 1), found: true });
                };
            };
        };
    };
    return facts;
};

struct SizeFact { term: Int, found: Bool };

impl Clone for SizeFact { };

impl Copy for SizeFact { };


// A reading of one list is also a reading of another when a `-30` fact
// relates them (`get(a, base + j) = get(b, j)`): the corresponding index
// in the other list is the sum application, or the index itself when the
// offset is zero, and back the same way through the sum's parts.
fn getFactsTranslated(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int) -> List<GetFact> {
    facts = getFactsOf(context, classes, term);
    extra = [];
    for gfPosition in 0..size(facts) {
        gf = get(facts, gfPosition);
        for appPosition in 0..size(context.applications) {
            app = get(context.applications, appPosition);
            if app.function = -30 {
                if size(app.arguments) = 5 {
                    a = get(app.arguments, 0);
                    b = get(app.arguments, 1);
                    base = get(app.arguments, 4);
                    if sameIn(classes, gf.seq, b) {
                        cand = shiftedIndex(context, classes, base, gf.at);
                        if cand is IntegerLookup::Found {
                            if linearEntails(context, get(app.arguments, 2), gf.at, 0) {
                                if linearEntails(context, gf.at, get(app.arguments, 3), -1) { extra = push(extra, GetFact { seq: a, at: (cand as IntegerLookup::Found).value, found: true }); };
                            };
                        };
                    };
                    if sameIn(classes, gf.seq, a) {
                        bvA = integerValue(context, base);
                        candB = 0;
                        candBFound = false;
                        if bvA is IntegerLookup::Found {
                            if (bvA as IntegerLookup::Found).value = 0 { candB = gf.at; candBFound = true; };
                        };
                        for sumPosition in 0..size(context.applications) {
                            sum = get(context.applications, sumPosition);
                            if sum.function = -1 {
                                if size(sum.arguments) = 2 {
                                    if sameIn(classes, sum.id, gf.at) {
                                        if sameIn(classes, get(sum.arguments, 0), base) { candB = get(sum.arguments, 1); candBFound = true; };
                                        if sameIn(classes, get(sum.arguments, 1), base) { candB = get(sum.arguments, 0); candBFound = true; };
                                    };
                                };
                            };
                        };
                        if candBFound {
                            if linearEntails(context, get(app.arguments, 2), candB, 0) {
                                if linearEntails(context, candB, get(app.arguments, 3), -1) { extra = push(extra, GetFact { seq: b, at: candB, found: true }); };
                            };
                        };
                    };
                };
            };
        };
    };
    for f in extra { facts = push(facts, f); };
    return facts;
};

// The term for `base + j`: the index itself when the offset is zero, the
// constant of the sum when both sides are known, else an application of
// the sum that the context already has.
fn shiftedIndex(context: &ValidatorContext, classes: &HashMap<Int, Int>, base: Int, j: Int) -> IntegerLookup {
    bv = integerValue(context, base);
    if bv is IntegerLookup::Found {
        if (bv as IntegerLookup::Found).value = 0 { return IntegerLookup::Found { value: j }; };
        jv = integerValue(context, j);
        if jv is IntegerLookup::Found {
            want = (bv as IntegerLookup::Found).value + (jv as IntegerLookup::Found).value;
            for constantPosition in 0..size(context.constants) {
                constant = get(context.constants, constantPosition);
                if constant.kind = 0 {
                    if constant.value = want { return IntegerLookup::Found { value: constant.id }; };
                };
            };
            return IntegerLookup::Missing;
        };
    };
    for sumPosition in 0..size(context.applications) {
        sum = get(context.applications, sumPosition);
        if sum.function = -1 {
            if size(sum.arguments) = 2 {
                if sameIn(classes, get(sum.arguments, 0), base) {
                    if sameIn(classes, get(sum.arguments, 1), j) { return IntegerLookup::Found { value: sum.id }; };
                };
                if sameIn(classes, get(sum.arguments, 1), base) {
                    if sameIn(classes, get(sum.arguments, 0), j) { return IntegerLookup::Found { value: sum.id }; };
                };
            };
        };
    };
    return IntegerLookup::Missing;
};
fn sizeTermOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, seq: Int) -> SizeFact {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -13 {
            if size(app.arguments) = 1 {
                if sameIn(classes, get(app.arguments, 0), seq) {
                    return SizeFact { term: app.id, found: true };
                };
            };
        };
    };
    return SizeFact { term: 0, found: false };
};

// Whether the two lists of a forall fact over a range are the lists of two reads (either way round), or the first read
// is of a push onto one of them: which of the fact's lists the push is onto
struct FactLists { same: Bool, pushed: Bool, inner: Int };

impl Clone for FactLists { };

fn listsOfFact(context: &ValidatorContext, classes: &HashMap<Int, Int>, leftSeq: Int, rightSeq: Int, a: Int, b: Int) -> FactLists {
    same = false;
    pushed = false;
    inner = a;
    if sameIn(classes, leftSeq, a) && sameIn(classes, rightSeq, b) { same = true; };
    if sameIn(classes, leftSeq, b) && sameIn(classes, rightSeq, a) { same = true; };
    for pushAppPosition in 0..size(context.applications) {
        pushApp = get(context.applications, pushAppPosition);
        if pushApp.function = -16 && size(pushApp.arguments) = 2 {
            if sameIn(classes, pushApp.id, leftSeq) {
                if sameIn(classes, get(pushApp.arguments, 0), a) && sameIn(classes, rightSeq, b) { same = true; pushed = true; inner = a; };
                if sameIn(classes, get(pushApp.arguments, 0), b) && sameIn(classes, rightSeq, a) { same = true; pushed = true; inner = b; };
            };
        };
    };
    return FactLists { same: same, pushed: pushed, inner: inner };
};

// Whether a term is a sum of base and other, either way round
fn sumOfEqual(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int, base: Int, other: Int) -> Bool {
    for sumPosition in 0..size(context.applications) {
        sum = get(context.applications, sumPosition);
        if sum.function = -1 && size(sum.arguments) = 2 {
            if sameIn(classes, sum.id, term) {
                if sameIn(classes, get(sum.arguments, 0), base) && sameIn(classes, get(sum.arguments, 1), other) { return true; };
                if sameIn(classes, get(sum.arguments, 1), base) && sameIn(classes, get(sum.arguments, 0), other) { return true; };
            };
        };
    };
    return false;
};

fn strictOrderStated(context: &ValidatorContext, classes: &HashMap<Int, Int>, smaller: Int, greater: Int) -> Bool {
    for oPosition in 0..size(context.orders) {
        o = get(context.orders, oPosition);
        if o.strict && sameIn(classes, o.smaller, smaller) && sameIn(classes, o.greater, greater) { return true; };
    };
    return false;
};

// (at the end of the range the element may follow from another forall at that index: get(out, i) = get(a, i), say)
fn endReadsEqual(context: &ValidatorContext, eqContext: &ValidatorContext, classes: &HashMap<Int, Int>, a: Int, b: Int, leftSeq: Int, rightSeq: Int, hi: Int, base: Int, offsetAt: Int) -> Bool {
    for gPosition in 0..size(context.applications) {
        g = get(context.applications, gPosition);
        if g.function = -14 && size(g.arguments) = 2 {
            gList = get(g.arguments, 0);
            if sameIn(classes, gList, a) || sameIn(classes, gList, leftSeq) {
                gIndex = get(g.arguments, 1);
                if sameIn(classes, gIndex, hi) || sumOfEqual(context, classes, gIndex, base, hi) {
                    if endReadOf(context, eqContext, classes, g.id, b, rightSeq, hi, offsetAt) { return true; };
                };
            };
        };
    };
    return false;
};

fn endReadOf(context: &ValidatorContext, eqContext: &ValidatorContext, classes: &HashMap<Int, Int>, read: Int, b: Int, rightSeq: Int, hi: Int, offsetAt: Int) -> Bool {
    for hPosition in 0..size(context.applications) {
        h = get(context.applications, hPosition);
        if h.function = -14 && size(h.arguments) = 2 {
            hList = get(h.arguments, 0);
            if sameIn(classes, hList, b) || sameIn(classes, hList, rightSeq) {
                hIndex = get(h.arguments, 1);
                hIndexOk = sameIn(classes, hIndex, hi);
                if hIndexOk = false {
                    if linearEntails(eqContext, hIndex, offsetAt, 0) {
                        if linearEntails(eqContext, offsetAt, hIndex, 0) { hIndexOk = true; };
                    };
                };
                if hIndexOk && sameIn(classes, read, h.id) { return true; };
            };
        };
    };
    return false;
};

// The bridge records `forall j in lo..hi: get(a, j) = get(b, j)` as an
// application of function -30 to (a, b, lo, hi). It proves an element
// equality inside the range (and at the end point when that element is
// known equal separately), and the equality of the lists themselves when
// the range is the whole of two lists of one size.
fn forallEqualPair(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int, lg: GetFact, rg: GetFact) -> Bool {
    return forallEqualPairWithin(context, analysis, left, right, lg, rg, 2);
};

fn forallEqualPairWithin(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int, lg: GetFact, rg: GetFact, fuel: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks 2 * fuel + 1 {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -30 && size(app.arguments) = 5 {
            a = get(app.arguments, 0);
            b = get(app.arguments, 1);
            lo = get(app.arguments, 2);
            hi = get(app.arguments, 3);
            base = get(app.arguments, 4);
            if lg.found && rg.found {
                if forallPairInRange(context, analysis, left, right, lg, rg, fuel, a, b, lo, hi, base) { return true; };
            };
            if forallPairWhole(context, analysis, left, right, a, b, lo, hi, base) { return true; };
        };
    };
    return false;
};

// Two reads of the lists of a forall fact (or of a push onto one), at indexes the fact relates, inside its range
fn forallPairInRange(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int, lg: GetFact, rg: GetFact, fuel: Int, a: Int, b: Int, lo: Int, hi: Int, base: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks 2 * fuel {
    equalities = analysis.equalities;
    differences = analysis.differences;
    lists = listsOfFact(context, analysis.classes, lg.seq, rg.seq, a, b);
    if lists.same = false { return false; };
    j = rg.at;
    offsetAt = lg.at;
    indexMatches = sameIn(analysis.classes, offsetAt, j) || sumOfEqual(context, analysis.classes, offsetAt, base, j);
    if indexMatches = false {
        j = lg.at;
        offsetAt = rg.at;
        indexMatches = sameIn(analysis.classes, offsetAt, j) || sumOfEqual(context, analysis.classes, offsetAt, base, j);
    };
    if indexMatches = false { return false; };
    if hasDifferenceIn(analysis.classes, differences, lo, j, 0) = false { return false; };
    below = hasDifferenceIn(analysis.classes, differences, j, hi, -1);
    if below = false { below = linearEntailsIn(context, analysis.classes, j, hi, -1); };
    if below {
        if lists.pushed {
            st = sizeTermOf(context, analysis.classes, lists.inner);
            if st.found {
                if hasDifferenceIn(analysis.classes, differences, lg.at, st.term, -1) { return true; };
                if linearEntailsIn(context, analysis.classes, lg.at, st.term, -1) { return true; };
            };
        } else { return true; };
    };
    atMost = hasDifferenceIn(analysis.classes, differences, j, hi, 0);
    if atMost = false { atMost = linearEntailsIn(context, analysis.classes, j, hi, 0); };
    if atMost = false || fuel <= 0 || strictOrderStated(context, analysis.classes, j, hi) { return false; };
    strictContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: j, greater: hi, strict: true }), ..clone(context) };
    strictAnalysis = analyzeContext(strictContext);
    if forallEqualPairWithin(strictContext, strictAnalysis, left, right, lg, rg, fuel - 1) = false { return false; };
    return forallPairAtEnd(context, left, right, lg, rg, a, b, hi, base, j, offsetAt);
};

// The two reads at the end of the range, j = hi, where the fact says nothing
fn forallPairAtEnd(context: &ValidatorContext, left: Int, right: Int, lg: GetFact, rg: GetFact, a: Int, b: Int, hi: Int, base: Int, j: Int, offsetAt: Int) -> Bool {
    eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: j, right: hi }), ..clone(context) };
    eqAnalysis = analyzeContext(eqContext);
    if eqAnalysis.contradictory { return true; };
    if contextEqual(eqAnalysis.classes, eqAnalysis.differences, left, right) { return true; };
    // (at the end of the range the element may follow from another
    // forall at that index: get(out, i) = get(a, i), say)
    instances = forallInstanceEqualities(eqContext, eqAnalysis);
    if size(instances) > 0 {
        widerEqualities = clone(eqContext.equalities);
        for e in instances { widerEqualities = push(widerEqualities, e); };
        wider = ValidatorContext { equalities: widerEqualities, ..clone(eqContext) };
        widerAnalysis = analyzeContext(wider);
        if widerAnalysis.contradictory { return true; };
        if contextEqual(widerAnalysis.classes, widerAnalysis.differences, left, right) { return true; };
    };
    return endReadsEqual(context, eqContext, eqAnalysis.classes, a, b, lg.seq, rg.seq, hi, base, offsetAt);
};

// The two lists of a forall fact over all of both, from 0, of one size: equal lists
fn forallPairWhole(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int, a: Int, b: Int, lo: Int, hi: Int, base: Int) -> Bool {
    equalities = analysis.equalities;
    listPair = (sameIn(analysis.classes, left, a) && sameIn(analysis.classes, right, b)) || (sameIn(analysis.classes, left, b) && sameIn(analysis.classes, right, a));
    if listPair = false { return false; };
    sa = sizeTermOf(context, analysis.classes, a);
    sb = sizeTermOf(context, analysis.classes, b);
    if sa.found = false || sb.found = false { return false; };
    if contextEqual(analysis.classes, analysis.differences, sa.term, sb.term) = false { return false; };
    loValue = integerValueIn(analysis.classes, context.constants, lo);
    baseValue = integerValueIn(analysis.classes, context.constants, base);
    if loValue is IntegerLookup::Found {
        if baseValue is IntegerLookup::Found {
            if (loValue as IntegerLookup::Found).value = 0 && (baseValue as IntegerLookup::Found).value = 0 {
                return sameIn(analysis.classes, hi, sa.term);
            };
        };
    };
    return false;
};

// A term can be recorded as a get of several lists (a read through a push
// or a set is the same term as the get of the list it reads through), so
// try every recorded get of the two sides that a forall fact can speak of.
fn forallEqual(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    equalities = analysis.equalities;
    lg = getFactOf(context, analysis.classes, left);
    rg = getFactOf(context, analysis.classes, right);
    if forallEqualPair(context, analysis, left, right, lg, rg) { return true; };
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -30 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                for lappPosition in 0..size(context.applications) {
                    lapp = get(context.applications, lappPosition);
                    if lapp.function = -14 {
                        if size(lapp.arguments) = 2 {
                            if sameIn(analysis.classes, lapp.id, left) {
                                lseq = get(lapp.arguments, 0);
                                lMatches = false;
                                if sameIn(analysis.classes, lseq, a) { lMatches = true; };
                                if sameIn(analysis.classes, lseq, b) { lMatches = true; };
                                for pushAppPosition in 0..size(context.applications) {
                                    pushApp = get(context.applications, pushAppPosition);
                                    if pushApp.function = -16 {
                                        if size(pushApp.arguments) = 2 {
                                            if sameIn(analysis.classes, pushApp.id, lseq) {
                                                if sameIn(analysis.classes, get(pushApp.arguments, 0), a) { lMatches = true; };
                                                if sameIn(analysis.classes, get(pushApp.arguments, 0), b) { lMatches = true; };
                                            };
                                        };
                                    };
                                };
                                if lMatches {
                                    for rappPosition in 0..size(context.applications) {
                                        rapp = get(context.applications, rappPosition);
                                        if rapp.function = -14 {
                                            if size(rapp.arguments) = 2 {
                                                if sameIn(analysis.classes, rapp.id, right) {
                                                    rseq = get(rapp.arguments, 0);
                                                    rMatches = false;
                                                    if sameIn(analysis.classes, rseq, a) { rMatches = true; };
                                                    if sameIn(analysis.classes, rseq, b) { rMatches = true; };
                                                    for pushApp2Position in 0..size(context.applications) {
                                                        pushApp2 = get(context.applications, pushApp2Position);
                                                        if pushApp2.function = -16 {
                                                            if size(pushApp2.arguments) = 2 {
                                                                if sameIn(analysis.classes, pushApp2.id, rseq) {
                                                                    if sameIn(analysis.classes, get(pushApp2.arguments, 0), a) { rMatches = true; };
                                                                    if sameIn(analysis.classes, get(pushApp2.arguments, 0), b) { rMatches = true; };
                                                                };
                                                            };
                                                        };
                                                    };
                                                    if rMatches {
                                                        lf = GetFact { seq: lseq, at: get(lapp.arguments, 1), found: true };
                                                        rf = GetFact { seq: rseq, at: get(rapp.arguments, 1), found: true };
                                                        if forallEqualPair(context, analysis, left, right, lf, rf) { return true; };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

// A get at a symbolic index of a list of known size is one of its finitely
// many elements: when every element is the goal's other side, the get is too.
fn getCoveredByEqualRange(context: &ValidatorContext, classes: &HashMap<Int, Int>, seq: Int, otherSeq: Int, index: Int) -> Bool {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -30 {
            if size(app.arguments) = 5 {
                bv = integerValue(context, get(app.arguments, 4));
                if bv is IntegerLookup::Found {
                    if (bv as IntegerLookup::Found).value = 0 {
                        aSide = sameIn(classes, seq, get(app.arguments, 0)) && sameIn(classes, otherSeq, get(app.arguments, 1));
                        bSide = sameIn(classes, seq, get(app.arguments, 1)) && sameIn(classes, otherSeq, get(app.arguments, 0));
                        if aSide || bSide {
                            if linearEntails(context, get(app.arguments, 2), index, 0) {
                                if linearEntails(context, index, get(app.arguments, 3), -1) { return true; };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn constantOverList(context: &ValidatorContext, analysis: &ContextAnalysis, seq: Int, at: Int, otherTerm: Int) -> Bool {
    equalities = analysis.equalities;
    differences = analysis.differences;
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -32 {
            if size(app.arguments) = 5 {
                if sameIn(analysis.classes, seq, get(app.arguments, 0)) {
                    if sameIn(analysis.classes, otherTerm, get(app.arguments, 4)) {
                        if hasDifferenceIn(analysis.classes, differences, get(app.arguments, 1), at, 0) {
                            if hasDifferenceIn(analysis.classes, differences, at, get(app.arguments, 2), -1) { return true; };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn setGetEqual(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if setGetSide(context, analysis, left, right) { return true; };
    return setGetSide(context, analysis, right, left);
};

fn setGetSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int) -> Bool {
    equalities = analysis.equalities;
    for gf in getFactsOf(context, analysis.classes, getTerm) {
        for appPosition in 0..size(context.applications) {
            app = get(context.applications, appPosition);
            if app.function = -17 {
                if size(app.arguments) = 3 {
                    if sameIn(analysis.classes, app.id, gf.seq) {
                        inner = get(app.arguments, 0);
                        idx = get(app.arguments, 1);
                        val = get(app.arguments, 2);
                        if linearEntailsIn(context, analysis.classes, gf.at, idx, 0) {
                            eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: gf.at, right: idx }), ..clone(context) };
                            eqAnalysis = analyzeContext(eqContext);
                            eqOk = eqAnalysis.contradictory;
                            if eqOk = false { eqOk = contextEqual(eqAnalysis.classes, eqAnalysis.differences, val, otherTerm); };
                            if eqOk {
                                ltContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: gf.at, greater: idx, strict: true }), ..clone(context) };
                                ltAnalysis = analyzeContext(ltContext);
                                if ltAnalysis.contradictory { return true; };
                                if constantOverList(ltContext, ltAnalysis, inner, gf.at, otherTerm) { return true; };
                                for factPosition in 0..size(ltContext.applications) {
                                    fact = get(ltContext.applications, factPosition);
                                    if fact.function = -30 {
                                        if size(fact.arguments) = 5 {
                                            bv = integerValue(ltContext, get(fact.arguments, 4));
                                            if bv is IntegerLookup::Found {
                                                if (bv as IntegerLookup::Found).value = 0 {
                                                    if linearEntails(ltContext, get(fact.arguments, 2), gf.at, 0) {
                                                        if linearEntails(ltContext, gf.at, get(fact.arguments, 3), -1) {
                                                            if sameIn(ltAnalysis.classes, inner, get(fact.arguments, 0)) {
                                                                if constantOverList(ltContext, ltAnalysis, get(fact.arguments, 1), gf.at, otherTerm) { return true; };
                                                            };
                                                            if sameIn(ltAnalysis.classes, inner, get(fact.arguments, 1)) {
                                                                if constantOverList(ltContext, ltAnalysis, get(fact.arguments, 0), gf.at, otherTerm) { return true; };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn finiteGetSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int) -> Bool {
    for gf in getFactsTranslated(context, analysis.classes, getTerm) {
        if finiteGetSideFor(context, analysis, getTerm, otherTerm, gf) { return true; };
    };
    return false;
};

fn finiteGetSideFor(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int, gf: &GetFact) -> Bool {
    equalities = analysis.equalities;
    differences = analysis.differences;
    sz = sizeTermOf(context, analysis.classes, gf.seq);
    if sz.found = false { return false; };
    nv = integerValueIn(analysis.classes, context.constants, sz.term);
    if nv is IntegerLookup::Found {
        n = (nv as IntegerLookup::Found).value;
        if n < 0 { return false; };
        if n > 64 { return false; };
        zero = 0;
        zeroFound = false;
        for constantPosition in 0..size(context.constants) {
            constant = get(context.constants, constantPosition);
            if constant.kind = 0 {
                if constant.value = 0 { zero = constant.id; zeroFound = true; };
            };
        };
        if zeroFound = false { return false; };
        if hasDifferenceIn(analysis.classes, differences, zero, gf.at, 0) = false { return false; };
        if hasDifferenceIn(analysis.classes, differences, gf.at, sz.term, -1) = false { return false; };
        for k in 0..n {
            kTerm = 0;
            kFound = false;
            for constantPosition in 0..size(context.constants) {
                constant = get(context.constants, constantPosition);
                if constant.kind = 0 {
                    if constant.value = k { kTerm = constant.id; kFound = true; };
                };
            };
            if kFound = false { return false; };
            elemFound = false;
            for appPosition in 0..size(context.applications) {
                app = get(context.applications, appPosition);
                if app.function = -14 {
                    if size(app.arguments) = 2 {
                        if sameIn(analysis.classes, get(app.arguments, 1), kTerm) {
                            if sameIn(analysis.classes, app.id, otherTerm) {
                                if sameIn(analysis.classes, get(app.arguments, 0), gf.seq) { elemFound = true; };
                                if getCoveredByEqualRange(context, analysis.classes, gf.seq, get(app.arguments, 0), kTerm) { elemFound = true; };
                            };
                        };
                    };
                };
            };
            if elemFound = false { return false; };
        };
        return true;
    };
    return false;
};

fn finiteGetEqual(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if finiteGetSide(context, analysis, left, right) { return true; };
    return finiteGetSide(context, analysis, right, left);
};

// The bridge records `forall j in lo..hi: get(a, base + j) = c` as an
// application of function -32 to (a, lo, hi, base, c).
fn forallConstantSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int) -> Bool {
    for gf in getFactsTranslated(context, analysis.classes, getTerm) {
        if forallConstantSideFor(context, analysis, getTerm, otherTerm, gf, 2) { return true; };
    };
    return false;
};

fn forallConstantSideFor(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int, gf: &GetFact, fuel: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks fuel {
    equalities = analysis.equalities;
    differences = analysis.differences;
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -32 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                lo = get(app.arguments, 1);
                hi = get(app.arguments, 2);
                base = get(app.arguments, 3);
                c = get(app.arguments, 4);
                if sameIn(analysis.classes, gf.seq, a) {
                    if sameIn(analysis.classes, otherTerm, c) {
                        j = gf.at;
                        jFound = false;
                        bv = integerValueIn(analysis.classes, context.constants, base);
                        if bv is IntegerLookup::Found {
                            if (bv as IntegerLookup::Found).value = 0 { jFound = true; };
                        };
                        if jFound = false {
                            for sumPosition in 0..size(context.applications) {
                                sum = get(context.applications, sumPosition);
                                if sum.function = -1 {
                                    if size(sum.arguments) = 2 {
                                        if sameIn(analysis.classes, sum.id, gf.at) {
                                            if sameIn(analysis.classes, get(sum.arguments, 0), base) { j = get(sum.arguments, 1); jFound = true; };
                                            if sameIn(analysis.classes, get(sum.arguments, 1), base) { j = get(sum.arguments, 0); jFound = true; };
                                        };
                                    };
                                };
                            };
                        };
                        if jFound {
                            if hasDifferenceIn(analysis.classes, differences, lo, j, 0) {
                                below = hasDifferenceIn(analysis.classes, differences, j, hi, -1);
                                if below = false { below = linearEntailsIn(context, analysis.classes, j, hi, -1); };
                                if below { return true; };
                                atMost = hasDifferenceIn(analysis.classes, differences, j, hi, 0);
                                if atMost = false { atMost = linearEntailsIn(context, analysis.classes, j, hi, 0); };
                                if atMost {
                                    strictContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: j, greater: hi, strict: true }), ..clone(context) };
                                    strictAnalysis = analyzeContext(strictContext);
                                    deeper = false;
                                    if fuel > 0 {
                                        for gfDeeper in getFactsTranslated(strictContext, strictAnalysis.classes, getTerm) {
                                            if deeper = false { deeper = forallConstantSideFor(strictContext, strictAnalysis, getTerm, otherTerm, gfDeeper, fuel - 1); };
                                        };
                                    };
                                    if deeper {
                                        eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: j, right: hi }), ..clone(context) };
                                        eqAnalysis = analyzeContext(eqContext);
                                        if eqAnalysis.contradictory { return true; };
                                        if contextEqual(eqAnalysis.classes, eqAnalysis.differences, getTerm, otherTerm) { return true; };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

// The bridge records `forall j in lo..hi: get(a, base + j) = get(b, j) + d`
// (mode 0) or `get(b, j) - d` (mode 1) as an application of function -33 to
// (a, b, lo, hi, base, d, mode).
fn forallShiftSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, exprTerm: Int) -> Bool {
    for gf in getFactsTranslated(context, analysis.classes, getTerm) {
        if forallShiftSideFor(context, analysis, getTerm, exprTerm, gf, 2) { return true; };
    };
    return false;
};

fn forallShiftSideFor(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, exprTerm: Int, gf: &GetFact, fuel: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks 2 * fuel + 1 {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -33 && size(app.arguments) = 7 {
            if forallShiftFromFact(context, analysis, getTerm, exprTerm, gf, fuel, app.arguments) { return true; };
        };
    };
    return false;
};

// How a read's list is a list a fact is about: 0 when it is not, 1 when it is that list, 2 when it is a push onto it
fn readListOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, seq: Int, list: Int) -> Int {
    if sameIn(classes, seq, list) { return 1; };
    for pushAppPosition in 0..size(context.applications) {
        pushApp = get(context.applications, pushAppPosition);
        if pushApp.function = -16 && size(pushApp.arguments) = 2 {
            if sameIn(classes, pushApp.id, seq) && sameIn(classes, get(pushApp.arguments, 0), list) { return 2; };
        };
    };
    return 0;
};

// The index j that a read at `at` is at past base: at = base + j (j = at when base is 0)
fn indexPastBase(context: &ValidatorContext, classes: &HashMap<Int, Int>, at: Int, base: Int) -> SizeFact {
    bv = integerValue(context, base);
    if bv is IntegerLookup::Found {
        if (bv as IntegerLookup::Found).value = 0 { return SizeFact { term: at, found: true }; };
    };
    result = SizeFact { term: at, found: false };
    for sumPosition in 0..size(context.applications) {
        sum = get(context.applications, sumPosition);
        if sum.function = -1 && size(sum.arguments) = 2 {
            if sameIn(classes, sum.id, at) {
                if sameIn(classes, get(sum.arguments, 0), base) { result = SizeFact { term: get(sum.arguments, 1), found: true }; };
                if sameIn(classes, get(sum.arguments, 1), base) { result = SizeFact { term: get(sum.arguments, 0), found: true }; };
            };
        };
    };
    return result;
};

// A read of a list at an index, as a term (the last one recorded)
fn readTermAt(context: &ValidatorContext, classes: &HashMap<Int, Int>, list: Int, index: Int) -> SizeFact {
    result = SizeFact { term: 0, found: false };
    for gappPosition in 0..size(context.applications) {
        gapp = get(context.applications, gappPosition);
        if gapp.function = -14 && size(gapp.arguments) = 2 {
            if sameIn(classes, get(gapp.arguments, 0), list) && sameIn(classes, get(gapp.arguments, 1), index) { result = SizeFact { term: gapp.id, found: true }; };
        };
    };
    return result;
};

// Whether a term is the read shifted by delta: read + delta in mode 0, read - delta in mode 1
fn shiftedRead(context: &ValidatorContext, classes: &HashMap<Int, Int>, exprTerm: Int, read: Int, delta: Int, mode: Int) -> Bool {
    for eappPosition in 0..size(context.applications) {
        eapp = get(context.applications, eappPosition);
        if sameIn(classes, eapp.id, exprTerm) && size(eapp.arguments) = 2 {
            u = get(eapp.arguments, 0);
            v = get(eapp.arguments, 1);
            if eapp.function = -1 && mode = 0 {
                if sameIn(classes, u, read) && sameIn(classes, v, delta) { return true; };
                if sameIn(classes, v, read) && sameIn(classes, u, delta) { return true; };
            };
            if eapp.function = -2 && mode = 1 {
                if sameIn(classes, u, read) && sameIn(classes, v, delta) { return true; };
            };
        };
    };
    return false;
};

// One shift fact, get(a, base + j) = get(b, j) + delta (or - delta) for lo <= j < hi, at the read and the expression
fn forallShiftFromFact(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, exprTerm: Int, gf: &GetFact, fuel: Int, args: &List<Int>) -> Bool [{ affirm fuel >= 0; affirm size(args) = 7; }] [{ }] shrinks 2 * fuel {
    equalities = analysis.equalities;
    differences = analysis.differences;
    a = get(args, 0);
    b = get(args, 1);
    lo = get(args, 2);
    hi = get(args, 3);
    base = get(args, 4);
    delta = get(args, 5);
    listOf = readListOf(context, analysis.classes, gf.seq, a);
    if listOf = 0 { return false; };
    modeValue = integerValueIn(analysis.classes, context.constants, get(args, 6));
    if modeValue is IntegerLookup::Missing { return false; };
    mode = (modeValue as IntegerLookup::Found).value;
    index = indexPastBase(context, analysis.classes, gf.at, base);
    if index.found = false { return false; };
    j = index.term;
    gb = readTermAt(context, analysis.classes, b, j);
    if gb.found = false { return false; };
    if shiftedRead(context, analysis.classes, exprTerm, gb.term, delta, mode) = false { return false; };
    if hasDifferenceIn(analysis.classes, differences, lo, j, 0) = false { return false; };
    below = hasDifferenceIn(analysis.classes, differences, j, hi, -1);
    if below = false { below = linearEntailsIn(context, analysis.classes, j, hi, -1); };
    if below {
        if listOf = 2 {
            st = sizeTermOf(context, analysis.classes, a);
            if st.found {
                if hasDifferenceIn(analysis.classes, differences, gf.at, st.term, -1) { return true; };
                if linearEntailsIn(context, analysis.classes, gf.at, st.term, -1) { return true; };
            };
        } else { return true; };
    };
    atMost = hasDifferenceIn(analysis.classes, differences, j, hi, 0);
    if atMost = false { atMost = linearEntailsIn(context, analysis.classes, j, hi, 0); };
    if atMost = false || fuel <= 0 { return false; };
    strictContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: j, greater: hi, strict: true }), ..clone(context) };
    strictAnalysis = analyzeContext(strictContext);
    deeper = false;
    for gfDeeper in getFactsTranslated(strictContext, strictAnalysis.classes, getTerm) {
        if deeper = false { deeper = forallShiftSideFor(strictContext, strictAnalysis, getTerm, exprTerm, gfDeeper, fuel - 1); };
    };
    if deeper = false { return false; };
    eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: j, right: hi }), ..clone(context) };
    eqAnalysis = analyzeContext(eqContext);
    if eqAnalysis.contradictory { return true; };
    return contextEqual(eqAnalysis.classes, eqAnalysis.differences, getTerm, exprTerm);
};

// `a % d` is `a` itself when `0 <= a < d`.
fn modIsSelf(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    equalities = analysis.equalities;
    differences = analysis.differences;
    zero = 0;
    zeroFound = false;
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = 0 { zero = constant.id; zeroFound = true; };
        };
    };
    if zeroFound = false { return false; };
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -5 {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                d = get(app.arguments, 1);
                dv = integerValueIn(analysis.classes, context.constants, d);
                if dv is IntegerLookup::Found {
                    if (dv as IntegerLookup::Found).value > 0 {
                        matches = false;
                        if sameIn(analysis.classes, app.id, left) {
                            if sameIn(analysis.classes, a, right) { matches = true; };
                        };
                        if sameIn(analysis.classes, app.id, right) {
                            if sameIn(analysis.classes, a, left) { matches = true; };
                        };
                        if matches {
                            if hasDifferenceIn(analysis.classes, differences, zero, a, 0) {
                                if hasDifferenceIn(analysis.classes, differences, a, d, -1) { return true; };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

// A dividend whose remainder is known differs from any value with another
// remainder.
fn modDifferent(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    equalities = analysis.equalities;
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -5 {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                d = get(app.arguments, 1);
                dv = integerValueIn(analysis.classes, context.constants, d);
                if dv is IntegerLookup::Found {
                    if (dv as IntegerLookup::Found).value > 0 {
                        rv = integerValueIn(analysis.classes, context.constants, app.id);
                        if rv is IntegerLookup::Found {
                            r = (rv as IntegerLookup::Found).value;
                            if sameIn(analysis.classes, a, left) {
                                ov = integerValueIn(analysis.classes, context.constants, right);
                                if ov is IntegerLookup::Found {
                                    if (ov as IntegerLookup::Found).value % (dv as IntegerLookup::Found).value != r { return true; };
                                };
                            };
                            if sameIn(analysis.classes, a, right) {
                                ov = integerValueIn(analysis.classes, context.constants, left);
                                if ov is IntegerLookup::Found {
                                    if (ov as IntegerLookup::Found).value % (dv as IntegerLookup::Found).value != r { return true; };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn forallShift(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if forallShiftSide(context, analysis, left, right) { return true; };
    return forallShiftSide(context, analysis, right, left);
};

fn forallConstant(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if forallConstantSide(context, analysis, left, right) { return true; };
    return forallConstantSide(context, analysis, right, left);
};

struct RelationFact { function: Int, left: Int, right: Int, found: Bool };

impl Clone for RelationFact { };

impl Copy for RelationFact { };

fn relationFactOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int) -> RelationFact {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function >= -11 {
            if app.function <= -6 {
                if size(app.arguments) = 2 {
                    if sameIn(classes, app.id, term) {
                        return RelationFact { function: app.function, left: get(app.arguments, 0), right: get(app.arguments, 1), found: true };
                    };
                };
            };
        };
    };
    return RelationFact { function: 0, left: 0, right: 0, found: false };
};

fn entailsUnderEquality(context: &ValidatorContext, x: Int, y: Int, u: Int, v: Int) -> Bool {
    widened = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: x, right: y }), ..clone(context) };
    analysis = analyzeContext(widened);
    if analysis.contradictory { return true; };
    return contextEqual(analysis.classes, analysis.differences, u, v);
};

// Two applications of Eq are the same boolean when their arguments match,
// when both equalities fail, or when each equality gives the other (the
// parts of a constructed value against the value itself).
// The bridge records `forall j in lo..hi: get(a, base + j) != c` as an
// application of function -31 to (a, lo, hi, base, c).
fn forallDifferentSide(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int) -> Bool {
    for gf in getFactsTranslated(context, analysis.classes, getTerm) {
        if forallDifferentSideFor(context, analysis, getTerm, otherTerm, gf, 2) { return true; };
    };
    return false;
};

fn forallDifferentSideFor(context: &ValidatorContext, analysis: &ContextAnalysis, getTerm: Int, otherTerm: Int, gf: &GetFact, fuel: Int) -> Bool [{ affirm fuel >= 0; }] [{ }] shrinks fuel {
    equalities = analysis.equalities;
    differences = analysis.differences;
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -31 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                lo = get(app.arguments, 1);
                hi = get(app.arguments, 2);
                base = get(app.arguments, 3);
                c = get(app.arguments, 4);
                if sameIn(analysis.classes, gf.seq, a) {
                    if sameIn(analysis.classes, otherTerm, c) {
                        j = gf.at;
                        jFound = false;
                        bv = integerValueIn(analysis.classes, context.constants, base);
                        if bv is IntegerLookup::Found {
                            if (bv as IntegerLookup::Found).value = 0 { jFound = true; };
                        };
                        if jFound = false {
                            for sumPosition in 0..size(context.applications) {
                                sum = get(context.applications, sumPosition);
                                if sum.function = -1 {
                                    if size(sum.arguments) = 2 {
                                        if sameIn(analysis.classes, sum.id, gf.at) {
                                            if sameIn(analysis.classes, get(sum.arguments, 0), base) { j = get(sum.arguments, 1); jFound = true; };
                                            if sameIn(analysis.classes, get(sum.arguments, 1), base) { j = get(sum.arguments, 0); jFound = true; };
                                        };
                                    };
                                };
                            };
                        };
                        if jFound {
                            if hasDifferenceIn(analysis.classes, differences, lo, j, 0) {
                                belowD = hasDifferenceIn(analysis.classes, differences, j, hi, -1);
                                if belowD = false { belowD = linearEntailsIn(context, analysis.classes, j, hi, -1); };
                                if belowD { return true; };
                                atMostD = hasDifferenceIn(analysis.classes, differences, j, hi, 0);
                                if atMostD = false { atMostD = linearEntailsIn(context, analysis.classes, j, hi, 0); };
                                if atMostD {
                                    strictContext = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: j, greater: hi, strict: true }), ..clone(context) };
                                    strictAnalysis = analyzeContext(strictContext);
                                    deeper = false;
                                    if fuel > 0 {
                                        for gfDeeper in getFactsTranslated(strictContext, strictAnalysis.classes, getTerm) {
                                            if deeper = false { deeper = forallDifferentSideFor(strictContext, strictAnalysis, getTerm, otherTerm, gfDeeper, fuel - 1); };
                                        };
                                    };
                                    if deeper {
                                        eqContext = ValidatorContext { equalities: push(clone(context.equalities), EqualityFact { left: j, right: hi }), ..clone(context) };
                                        eqAnalysis = analyzeContext(eqContext);
                                        if eqAnalysis.contradictory { return true; };
                                        if contextDifferent(eqAnalysis.equalities, eqContext.applications, eqAnalysis.orders, eqContext.different, eqAnalysis.differences, getTerm, otherTerm) { return true; };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return false;
};

fn forallDifferent(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    if forallDifferentSide(context, analysis, left, right) { return true; };
    return forallDifferentSide(context, analysis, right, left);
};

fn differentByParts(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    equalities = analysis.equalities;
    if entailsConstructorDisequality(analysis.classes, context.applications, context.constructorFunctions, left, right) { return true; };
    if entailsVariantDisequality(analysis.classes, context.variants, left, right) { return true; };
    if entailsConstructorArgumentDisequality(context, analysis.classes, left, right) { return true; };
    if contextWithinUnder(context, analysis.classes, left, right) { return true; };
    if contextWithinUnder(context, analysis.classes, right, left) { return true; };
    if entailsPartDisequality(context, analysis.classes, analysis.orders, left, right) { return true; };
    // (the analysis's equalities are closed and do not contradict its facts)
    if hasDifferenceIn(analysis.classes, analysis.differences, left, right, -1) { return true; };
    if hasDifferenceIn(analysis.classes, analysis.differences, right, left, -1) { return true; };
    return closedDisequality(analysis.classes, analysis.orders, context.different, left, right);
};

fn booleanConstantTerm(context: &ValidatorContext, term: Int) -> Bool {
    for cPosition in 0..size(context.constants) {
        if get(context.constants, cPosition).id = term && get(context.constants, cPosition).kind = 1 { return true; };
    };
    return false;
};

fn relationAppsEqual(context: &ValidatorContext, analysis: &ContextAnalysis, left: Int, right: Int) -> Bool {
    // (a literal is the class of every comparison known to have its value,
    // and the classes alone decide a comparison against it)
    if booleanConstantTerm(context, left) || booleanConstantTerm(context, right) { return false; };
    equalities = analysis.equalities;
    differences = analysis.differences;
    a = relationFactOf(context, analysis.classes, left);
    b = relationFactOf(context, analysis.classes, right);
    if a.found = false { return false; };
    if b.found = false { return false; };
    if a.function != b.function { return false; };
    if a.function != -6 { return false; };
    if contextEqual(analysis.classes, differences, a.left, b.left) {
        if contextEqual(analysis.classes, differences, a.right, b.right) { return true; };
    };
    if contextEqual(analysis.classes, differences, a.left, b.right) {
        if contextEqual(analysis.classes, differences, a.right, b.left) { return true; };
    };
    if differentByParts(context, analysis, a.left, a.right) {
        if differentByParts(context, analysis, b.left, b.right) { return true; };
    };
    // (one side the same and the other two different: the two cannot both
    // hold, and they are equal only where neither can, which the case above
    // is; the search under an equality below costs a closure of the whole
    // context, and a chain of string comparisons asks it for every pair)
    if contextEqual(analysis.classes, differences, a.left, b.left) && differentByParts(context, analysis, a.right, b.right) { return false; };
    if contextEqual(analysis.classes, differences, a.right, b.right) && differentByParts(context, analysis, a.left, b.left) { return false; };
    if contextEqual(analysis.classes, differences, a.left, b.right) && differentByParts(context, analysis, a.right, b.left) { return false; };
    if contextEqual(analysis.classes, differences, a.right, b.left) && differentByParts(context, analysis, a.left, b.right) { return false; };
    if entailsUnderEquality(context, a.left, a.right, b.left, b.right) {
        if entailsUnderEquality(context, b.left, b.right, a.left, a.right) { return true; };
    };
    return false;
};

// Two lists whose elements a forall fact says are equal over the whole of
// both (get(a, j) = get(b, j) for j from 0 to at least size(a), and the
// sizes equal) are equal: a list is its size and its elements.
fn extensionalEqualities(context: &ValidatorContext, analysis: &ContextAnalysis) -> List<EqualityFact> {
    found = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -30 {
            if size(app.arguments) = 5 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                lo = integerValueIn(analysis.classes, context.constants, get(app.arguments, 2));
                base = integerValueIn(analysis.classes, context.constants, get(app.arguments, 4));
                fromZero = false;
                if lo is IntegerLookup::Found {
                    if base is IntegerLookup::Found {
                        loValue = (lo as IntegerLookup::Found).value;
                        baseValue = (base as IntegerLookup::Found).value;
                        if loValue = 0 {
                            if baseValue = 0 { fromZero = true; };
                        };
                    };
                };
                if fromZero {
                    sa = 0;
                    sb = 0;
                    haveA = false;
                    haveB = false;
                    for sizeAppPosition in 0..size(context.applications) {
                        sizeApp = get(context.applications, sizeAppPosition);
                        if sizeApp.function = -13 {
                            if size(sizeApp.arguments) = 1 {
                                if sameIn(analysis.classes, get(sizeApp.arguments, 0), a) { sa = sizeApp.id; haveA = true; };
                                if sameIn(analysis.classes, get(sizeApp.arguments, 0), b) { sb = sizeApp.id; haveB = true; };
                            };
                        };
                    };
                    if haveA {
                        if haveB {
                            if linearEntailsIn(context, analysis.classes, sa, get(app.arguments, 3), 0) {
                                if linearEntailsIn(context, analysis.classes, sa, sb, 0) && linearEntailsIn(context, analysis.classes, sb, sa, 0) {
                                    found = push(found, EqualityFact { left: a, right: b });
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return found;
};

// The equalities the forall facts give between elements the context
// already reads: get(a, k) = get(b, k) for a fact get(a, j) = get(b, j) over
// a range that holds k (only facts with no offset, and only elements both
// lists are read at)
fn forallInstanceEqualities(context: &ValidatorContext, analysis: &ContextAnalysis) -> List<EqualityFact> {
    found = [];
    gets = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -14 { if size(app.arguments) = 2 { gets = push(gets, clone(app)); }; };
    };
    for factPosition in 0..size(context.applications) {
        fact = get(context.applications, factPosition);
        if fact.function = -30 {
            if size(fact.arguments) = 5 {
                a = get(fact.arguments, 0);
                b = get(fact.arguments, 1);
                lo = get(fact.arguments, 2);
                hi = get(fact.arguments, 3);
                baseValue = integerValueIn(analysis.classes, context.constants, get(fact.arguments, 4));
                noOffset = false;
                if baseValue is IntegerLookup::Found { if (baseValue as IntegerLookup::Found).value = 0 { noOffset = true; }; };
                if noOffset {
                    onA = [];
                    onB = [];
                    for gPosition in 0..size(gets) {
                        g = get(gets, gPosition);
                        if size(g.arguments) = 2 {
                            if sameIn(analysis.classes, get(g.arguments, 0), a) { onA = push(onA, clone(g)); };
                            if sameIn(analysis.classes, get(g.arguments, 0), b) { onB = push(onB, clone(g)); };
                        };
                    };
                    for g1Position in 0..size(onA) {
                        g1 = get(onA, g1Position);
                        k = intAt(g1.arguments, 1, 0);
                        for g2Position in 0..size(onB) {
                            g2 = get(onB, g2Position);
                            if size(found) < 8 {
                                if size(g2.arguments) = 2 && sameIn(analysis.classes, get(g2.arguments, 1), k) {
                                    if sameIn(analysis.classes, g1.id, g2.id) = false {
                                        if linearEntailsIn(context, analysis.classes, lo, k, 0) {
                                            if linearEntailsIn(context, analysis.classes, k, hi, -1) {
                                                found = push(found, EqualityFact { left: g1.id, right: g2.id });
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return found;
};

fn entailsGoalAnalyzed(context: &ValidatorContext, analysis: &ContextAnalysis, goal: ValidatorGoal) -> Bool {
    if analysis.contradictory { return true; };
    if goal is ValidatorGoal::Equal {
        g = goal as ValidatorGoal::Equal;
        // (the analysis's classes hold what congruence gives and what orders
        // imply: a <= b and b <= a)
        if contextEqual(analysis.classes, analysis.differences, g.left, g.right) { return true; };
        if forallEqual(context, analysis, g.left, g.right) { return true; };
        if forallConstant(context, analysis, g.left, g.right) { return true; };
        if forallShift(context, analysis, g.left, g.right) { return true; };
        if modIsSelf(context, analysis, g.left, g.right) { return true; };
        if finiteGetEqual(context, analysis, g.left, g.right) { return true; };
        if setGetEqual(context, analysis, g.left, g.right) { return true; };
        if relationAppsEqual(context, analysis, g.left, g.right) { return true; };
        derived = extensionalEqualities(context, analysis);
        for instance in forallInstanceEqualities(context, analysis) { derived = push(derived, instance); };
        if size(derived) > 0 {
            widerEqualities = clone(context.equalities);
            for d in derived { widerEqualities = push(widerEqualities, d); };
            wider = ValidatorContext { equalities: widerEqualities, ..clone(context) };
            widerAnalysis = analyzeContext(wider);
            if widerAnalysis.contradictory { return true; };
            if contextEqual(widerAnalysis.classes, widerAnalysis.differences, g.left, g.right) { return true; };
        };
        if linearEntailsIn(context, analysis.classes, g.left, g.right, 0) { return linearEntailsIn(context, analysis.classes, g.right, g.left, 0); };
        return false;
    };
    if goal is ValidatorGoal::Different {
        g = goal as ValidatorGoal::Different;
        if entailsConstructorDisequality(analysis.classes, context.applications, context.constructorFunctions, g.left, g.right) { return true; };
        if entailsVariantDisequality(analysis.classes, context.variants, g.left, g.right) { return true; };
        if entailsConstructorArgumentDisequality(context, analysis.classes, g.left, g.right) { return true; };
        // (the analysis's equalities are closed and do not contradict its facts)
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, -1) { return true; };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.right, g.left, -1) { return true; };
        if closedDisequality(analysis.classes, analysis.orders, context.different, g.left, g.right) { return true; };
        if contextWithinUnder(context, analysis.classes, g.left, g.right) { return true; };
        if contextWithinUnder(context, analysis.classes, g.right, g.left) { return true; };
        if entailsPartDisequality(context, analysis.classes, analysis.orders, g.left, g.right) { return true; };
        if forallDifferent(context, analysis, g.left, g.right) { return true; };
        return modDifferent(context, analysis, g.left, g.right);
    };
    if goal is ValidatorGoal::Less {
        g = goal as ValidatorGoal::Less;
        lv = integerValueIn(analysis.classes, context.constants, g.left);
        if lv is IntegerLookup::Found {
            if (lv as IntegerLookup::Found).value <= -1 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, -1) { return true; };
        return linearEntailsIn(context, analysis.classes, g.left, g.right, -1);
    };
    if goal is ValidatorGoal::AtMost {
        g = goal as ValidatorGoal::AtMost;
        lv = integerValueIn(analysis.classes, context.constants, g.left);
        if lv is IntegerLookup::Found {
            if (lv as IntegerLookup::Found).value <= 0 {
                if isSizeTerm(context.applications, g.right) { return true; };
            };
        };
        if hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, 0) { return true; };
        return linearEntailsIn(context, analysis.classes, g.left, g.right, 0);
    };
    if goal is ValidatorGoal::Difference {
        g = goal as ValidatorGoal::Difference;
        return hasDifferenceIn(analysis.classes, analysis.differences, g.left, g.right, g.bound);
    };
    if goal is ValidatorGoal::Within {
        g = goal as ValidatorGoal::Within;
        return contextWithin(context, g.inner, g.outer);
    };
    return false;
};


enum ProofStep {
    KnownEquality { left: Int, right: Int },
    KnownDifferent { left: Int, right: Int },
    KnownOrder { left: Int, right: Int, strict: Bool },
    KnownDifference { left: Int, right: Int, bound: Int },
    Check { goal: ValidatorGoal },
};

impl Clone for ProofStep { };

impl Copy for ProofStep { };

struct ProofResult { valid: Bool, failedAt: Int };

impl Clone for ProofResult { };

impl Copy for ProofResult { };
struct ProofRun { valid: Bool, failedAt: Int, state: ValidatorContext };

impl Clone for ProofRun { };

// Return the first unproved obligation; -1 means that every check succeeded.
// Assumptions made later in the list cannot justify an earlier assertion.
fn deriveRefinedOrders(context: &ValidatorContext) -> ValidatorContext {
    facts = clone(context.orders);
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    for orderPosition in 0..size(context.orders) {
        order = get(context.orders, orderPosition);
        if order.strict = false {
            refined = false;
            for dPosition in 0..size(context.different) {
                d = get(context.different, dPosition);
                if sameIn(equalitiesClasses, d.left, order.smaller) && sameIn(equalitiesClasses, d.right, order.greater) { refined = true; };
                if sameIn(equalitiesClasses, d.left, order.greater) && sameIn(equalitiesClasses, d.right, order.smaller) { refined = true; };
            };
            if refined {
                if hasOrderFact(facts, order.smaller, order.greater) = false || true {
                    facts = push(facts, OrderFact { smaller: order.smaller, greater: order.greater, strict: true });
                };
            };
        };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

// A goal holds of a context when it holds of the context's facts, or of them
// with the sum and refined orders derived. Several goals asked of one context
// share its analysis and its derived context through the cache.
enum AnalysisLookup { Missing, Found { analysis: ContextAnalysis } };

impl Clone for AnalysisLookup { };

struct EntailmentCache { plain: ValidatorContext, plainAnalysis: AnalysisLookup, derivedMade: Bool, derived: ValidatorContext, derivedAnalysis: AnalysisLookup };

impl Clone for EntailmentCache { };

struct CachedAnswer { holds: Bool, cache: EntailmentCache };

impl Clone for CachedAnswer { };

fn entailmentCache(context: &ValidatorContext) -> EntailmentCache {
    return EntailmentCache { plain: clone(context), plainAnalysis: AnalysisLookup::Missing, derivedMade: false, derived: clone(context), derivedAnalysis: AnalysisLookup::Missing };
};

// Whether any of the goals holds: each is tried on the context, then each on
// the derived context, which is made only when none held on the first.
fn entailsAnyCached(cache: EntailmentCache, goals: &List<ValidatorGoal>) -> CachedAnswer {
    c = cache;
    recognized = false;
    for gPosition in 0..size(goals) {
        if recognizedGoal(get(goals, gPosition)) { recognized = true; };
    };
    if recognized = false { return CachedAnswer { holds: false, cache: c }; };
    plainDirect = leastClasses(semanticFacts(c.plain.equalities, c.plain.applications, c.plain.constants));
    for gPosition in 0..size(goals) {
        g = get(goals, gPosition);
        if recognizedGoal(g) {
            if entailsGoalDirectlyIn(c.plain, plainDirect, g) { return CachedAnswer { holds: true, cache: c }; };
        };
    };
    if recognized {
        if c.plainAnalysis is AnalysisLookup::Missing {
            c = EntailmentCache { plainAnalysis: AnalysisLookup::Found { analysis: analyzeContext(c.plain) }, ..c };
        };
        plainAnalysis = (clone(c.plainAnalysis) as AnalysisLookup::Found).analysis;
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalAnalyzed(c.plain, plainAnalysis, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
    };
    if recognized {
        if c.derivedMade = false {
            c = EntailmentCache { derived: deriveRefinedOrders(deriveSumOrders(c.plain)), derivedMade: true, ..c };
        };
        // (the derived context has more orders only: the classes of its
        // equalities, applications and constants are the plain one's)
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalDirectlyIn(c.derived, plainDirect, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
        if c.derivedAnalysis is AnalysisLookup::Missing {
            c = EntailmentCache { derivedAnalysis: AnalysisLookup::Found { analysis: analyzeContext(c.derived) }, ..c };
        };
        derivedAnalysis = (clone(c.derivedAnalysis) as AnalysisLookup::Found).analysis;
        for gPosition in 0..size(goals) {
            g = get(goals, gPosition);
            if recognizedGoal(g) {
                if entailsGoalAnalyzed(c.derived, derivedAnalysis, g) { return CachedAnswer { holds: true, cache: c }; };
            };
        };
    };
    return CachedAnswer { holds: false, cache: c };
};

// Whether the plain closure a cache already holds proves the goal (the
// derived facts, and a closure not made yet, are left to a fresh ask)
fn entailsPlainCached(cache: &EntailmentCache, goal: &ValidatorGoal) -> Bool {
    if recognizedGoal(clone(goal)) = false { return false; };
    if entailsGoalDirectly(cache.plain, clone(goal)) { return true; };
    if cache.plainAnalysis is AnalysisLookup::Found {
        return entailsGoalAnalyzed(cache.plain, (clone(cache.plainAnalysis) as AnalysisLookup::Found).analysis, clone(goal));
    };
    return false;
};

fn entailsGoalCached(cache: EntailmentCache, goal: ValidatorGoal) -> CachedAnswer {
    return entailsAnyCached(cache, push([], goal));
};

fn entailsGoal(context: &ValidatorContext, goal: ValidatorGoal) -> Bool {
    return entailsGoalCached(entailmentCache(context), goal).holds;
};

fn runProofSteps(initial: &ValidatorContext, steps: &List<ProofStep>) -> ProofRun {
    state = clone(initial);
    for i in 0..size(steps) {
        step = get(steps, i);
        handled = false;
        if step is ProofStep::KnownEquality {
            handled = true;
            f = step as ProofStep::KnownEquality;
            facts = push(state.equalities, EqualityFact { left: f.left, right: f.right });
            state = ValidatorContext { equalities: facts, ..state };
        };
        if step is ProofStep::KnownDifferent {
            handled = true;
            f = step as ProofStep::KnownDifferent;
            facts = push(state.different, DisequalityFact { left: f.left, right: f.right });
            state = ValidatorContext { different: facts, ..state };
        };
        if step is ProofStep::KnownOrder {
            handled = true;
            f = step as ProofStep::KnownOrder;
            facts = push(state.orders, OrderFact { smaller: f.left, greater: f.right, strict: f.strict });
            state = ValidatorContext { orders: facts, ..state };
        };
        if step is ProofStep::KnownDifference {
            handled = true;
            f = step as ProofStep::KnownDifference;
            facts = push(state.differences, DifferenceFact { left: f.left, right: f.right, bound: f.bound });
            state = ValidatorContext { differences: facts, ..state };
        };
        if step is ProofStep::Check {
            handled = true;
            f = step as ProofStep::Check;
            if entailsGoal(state, f.goal) = false {
                return ProofRun { valid: false, failedAt: i, state: state };
            };
        };
        if handled = false {
            return ProofRun { valid: false, failedAt: i, state: state };
        };
    };
    return ProofRun { valid: true, failedAt: -1, state: state };
};

fn validateProofSteps(initial: &ValidatorContext, steps: &List<ProofStep>) -> ProofResult {
    result = runProofSteps(initial, steps);
    return ProofResult { valid: result.valid, failedAt: result.failedAt };
};

// A host translates verified MIR blocks to this form. Branch facts are trusted
// consequences of taking that edge, not unchecked source assertions. A path
// that contains an operation the bridge cannot encode ends in Unsupported.
enum FlowEnd {
    Done,
    Jump { target: Int },
    Branch { yes: Int, no: Int, yesFacts: List<ProofStep>, noFacts: List<ProofStep> },
    Unsupported,
};

impl Clone for FlowEnd { };

struct FlowBlock { id: Int, steps: List<ProofStep>, end: FlowEnd };

impl Clone for FlowBlock { };

// status 0: valid; 1: unproved obligation; 2: unsupported operation;
// 3: invalid graph; 4: a cycle needs an invariant and has not been checked.
struct FlowResult { status: Int, block: Int, step: Int };

impl Clone for FlowResult { };

impl Copy for FlowResult { };

fn flowTable(blocks: &List<FlowBlock>) -> HashMap<Int, FlowBlock> {
    table = HashMap::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        table = table.insert(block.id, clone(block));
    };
    return table;
};

fn uniqueFlowBlocks(blocks: &List<FlowBlock>) -> Bool {
    seen = HashSet::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        if seen.contains(block.id) {
            return false;
        };
        seen = seen.insert(block.id);
    };
    return true;
};

fn walkFlow(blocks: &HashMap<Int, FlowBlock>, id: Int, context: &ValidatorContext, fuel: Int) -> FlowResult [{ affirm fuel >= 0; }] [{ }] shrinks fuel {
    if blocks.contains(id) {
        if fuel = 0 {
            return FlowResult { status: 4, block: id, step: -1 };
        };
        block = blocks.lookupRef(id);
        run = runProofSteps(context, (*block).steps);
        if run.valid = false {
            return FlowResult { status: 1, block: id, step: run.failedAt };
        };
        end = (*block).end;
        if end is FlowEnd::Done {
            return FlowResult { status: 0, block: id, step: -1 };
        };
        if end is FlowEnd::Jump {
            jump = end as FlowEnd::Jump;
            return walkFlow(blocks, jump.target, run.state, fuel - 1);
        };
        if end is FlowEnd::Branch {
            branch = end as FlowEnd::Branch;
            yes = runProofSteps(run.state, branch.yesFacts);
            if yes.valid = false {
                return FlowResult { status: 1, block: id, step: yes.failedAt };
            };
            yesResult = walkFlow(blocks, branch.yes, yes.state, fuel - 1);
            if yesResult.status != 0 {
                return yesResult;
            };
            no = runProofSteps(run.state, branch.noFacts);
            if no.valid = false {
                return FlowResult { status: 1, block: id, step: no.failedAt };
            };
            return walkFlow(blocks, branch.no, no.state, fuel - 1);
        };
        return FlowResult { status: 2, block: id, step: -1 };
    };
    return FlowResult { status: 3, block: id, step: -1 };
};

// Each acyclic path visits at most size(blocks) blocks. Running out of fuel
// never accepts a cycle: loops will need invariant and termination checking.
fn validateFlow(blocks: &List<FlowBlock>, entry: Int, initial: &ValidatorContext) -> FlowResult {
    if uniqueFlowBlocks(blocks) = false {
        return FlowResult { status: 3, block: entry, step: -1 };
    };
    return walkFlow(flowTable(blocks), entry, initial, size(blocks));
};

// Locals are names for immutable symbolic terms. A copy changes the binding,
// not the term or the facts that describe it.
enum ValueRef { Local { local: Int }, Term { term: Int } };

impl Clone for ValueRef { };

impl Copy for ValueRef { };
enum ValueLookup { Missing, Found { term: Int } };

impl Clone for ValueLookup { };

impl Copy for ValueLookup { };
enum ArgumentsLookup { Missing, Found { terms: List<Int> } };

impl Clone for ArgumentsLookup { };

// A forall the path has assumed, kept so that it is used at the elements a
// failed check reads (saturate). Its terms are nodes in order: the index
// (kind 0), a value of the path (kind 1: a local or a term), or a function of
// earlier nodes (kind 2). A guard or the body relates two nodes.
struct TemplateNode { kind: Int, function: Int, value: ValueRef, arguments: List<Int> };

impl Clone for TemplateNode { };

struct TemplateRelation { relation: Int, left: Int, right: Int };

impl Clone for TemplateRelation { };

struct ForallTemplate { id: Int, nodes: List<TemplateNode>, guards: List<TemplateRelation>, body: TemplateRelation };

impl Clone for ForallTemplate { };

fn noTemplates() -> List<ForallTemplate> { return []; };

struct ExecutionState { context: ValidatorContext, locals: HashMap<Int, Int>, templates: List<ForallTemplate> };

impl Clone for ExecutionState { };

struct MergePair { left: Int, right: Int, joined: Int, ambiguous: Bool };

impl Clone for MergePair { };

fn emptyMergePairs() -> List<MergePair> { return []; };

enum StateMergeLookup { Missing, Found { state: ExecutionState } };

impl Clone for StateMergeLookup { };

fn lookupLocal(locals: &HashMap<Int, Int>, local: Int) -> ValueLookup {
    if locals.contains(local) {
        return ValueLookup::Found { term: locals.lookup(local, 0) };
    };
    return ValueLookup::Missing;
};

fn bindLocal(locals: HashMap<Int, Int>, local: Int, term: Int) -> HashMap<Int, Int> {
    return locals.insert(local, term);
};

fn forgetLocal(locals: HashMap<Int, Int>, local: Int) -> HashMap<Int, Int> {
    return locals.remove(local);
};

// Term references are supplied by the host's term interner; a Local reference
// must already be bound on this path. Unknown variants and locals fail closed.
fn resolveValue(state: &ExecutionState, value: ValueRef) -> ValueLookup {
    if value is ValueRef::Local {
        return lookupLocal(state.locals, (value as ValueRef::Local).local);
    };
    if value is ValueRef::Term {
        return ValueLookup::Found { term: (value as ValueRef::Term).term };
    };
    return ValueLookup::Missing;
};

fn resolveArguments(state: &ExecutionState, values: &List<ValueRef>) -> ArgumentsLookup {
    terms = [];
    for valuePosition in 0..size(values) {
        value = get(values, valuePosition);
        result = resolveValue(state, value);
        if result is ValueLookup::Found {
            terms = push(terms, (result as ValueLookup::Found).term);
        } else {
            return ArgumentsLookup::Missing;
        };
    };
    return ArgumentsLookup::Found { terms: terms };
};

// A fresh result must not alias any term already present on this path.
fn termInUse(state: &ExecutionState, term: Int) -> Bool {
    for binding in state.locals.entries() { if binding.value = term { return true; }; };
    for factPosition in 0..size(state.context.equalities) {
        fact = get(state.context.equalities, factPosition);
        if fact.left = term { return true; }; if fact.right = term { return true; };
    };
    for factPosition in 0..size(state.context.different) {
        fact = get(state.context.different, factPosition);
        if fact.left = term { return true; }; if fact.right = term { return true; };
    };
    for factPosition in 0..size(state.context.orders) {
        fact = get(state.context.orders, factPosition);
        if fact.smaller = term { return true; }; if fact.greater = term { return true; };
    };
    for factPosition in 0..size(state.context.differences) {
        fact = get(state.context.differences, factPosition);
        if fact.left = term { return true; }; if fact.right = term { return true; };
    };
    for factPosition in 0..size(state.context.variants) {
        fact = get(state.context.variants, factPosition);
        if fact.object = term { return true; };
    };
    for constant in state.context.constants { if constant.id = term { return true; }; };
    for appPosition in 0..size(state.context.applications) {
        app = get(state.context.applications, appPosition);
        if app.id = term { return true; };
        if app.function = term { return true; };
        if containsValue(app.arguments, term) { return true; };
    };
    return false;
};

// The MIR bridge reserves -1 through -19 for builtin functions and uses
// non-negative IDs for input terms. A bounded search supplies path-local
// symbols without aliasing any term still mentioned by the state. Exhaustion
// is reported as unsupported rather than reusing a live identifier.
fn goalSides(goal: &ValidatorGoal) -> List<Int> {
    if goal is ValidatorGoal::Equal { g = goal as ValidatorGoal::Equal; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Different { g = goal as ValidatorGoal::Different; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Less { g = goal as ValidatorGoal::Less; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::AtMost { g = goal as ValidatorGoal::AtMost; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Difference { g = goal as ValidatorGoal::Difference; return push(push([], g.left), g.right); };
    if goal is ValidatorGoal::Within { g = goal as ValidatorGoal::Within; return push(push([], g.inner), g.outer); };
    return [];
};

// A read of set(inner, idx, value) at an index that is neither known to be
// idx nor known not to be: the goal holds if it holds when the index is idx
// (the read is the value) and when it is not (the read is the element of
// inner there, a new read), each case perhaps split again. Only reads the
// goal is about are split (a side, or an argument of one), at most depth
// times along a path.
struct SplitResult { holds: Bool, used: Int };

// A write that a read may read through: a set at its index, or a push at the old size, read at an index known not to
// be past it
struct WriteOf { written: Bool, pushed: Bool, inner: Int, idx: Int, value: Int };

impl Clone for WriteOf { };

fn writeOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, k: Int, setApp: &ApplicationTerm) -> WriteOf {
    if setApp.function = -17 && size(setApp.arguments) = 3 {
        return WriteOf { written: true, pushed: false, inner: get(setApp.arguments, 0), idx: get(setApp.arguments, 1), value: get(setApp.arguments, 2) };
    };
    if setApp.function = -16 && size(setApp.arguments) = 2 {
        st = sizeTermOf(context, classes, get(setApp.arguments, 0));
        if st.found {
            if linearEntails(context, k, st.term, 0) {
                return WriteOf { written: true, pushed: true, inner: get(setApp.arguments, 0), idx: st.term, value: get(setApp.arguments, 1) };
            };
        };
    };
    return WriteOf { written: false, pushed: false, inner: 0, idx: 0, value: 0 };
};

// The terms of the goal's sides and the arguments of the applications they are
fn nearTerms(context: &ValidatorContext, classes: &HashMap<Int, Int>, sides: &List<Int>) -> List<Int> {
    near = clone(sides);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        for sidePosition in 0..size(sides) {
            if sameIn(classes, app.id, get(sides, sidePosition)) {
                for argument in app.arguments { near = push(near, argument); };
            };
        };
    };
    return near;
};

fn equalToAny(classes: &HashMap<Int, Int>, term: Int, terms: &List<Int>) -> Bool {
    for t in terms { if sameIn(classes, term, t) { return true; }; };
    return false;
};

fn splitReadOverWrite(state: &ExecutionState, goal: ValidatorGoal, depth: Int, budget: Int) -> SplitResult [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 1 {
    if depth <= 0 || budget <= 0 { return SplitResult { holds: false, used: 0 }; };
    used = 0;
    analysis = analyzeContext(state.context);
    near = nearTerms(state.context, analysis.classes, goalSides(goal));
    tried = 0;
    // (the newest reads first: a read a split made is the one to split next)
    count = size(state.context.applications);
    for back in 0..count {
        app = applicationAt(state.context.applications, count - 1 - back);
        if app.function = -14 && size(app.arguments) = 2 && tried < 3 && used < budget && size(state.templates) = 0 {
            if equalToAny(analysis.classes, app.id, near) {
                k = get(app.arguments, 1);
                for setAppPosition in 0..size(state.context.applications) {
                    w = writeOf(state.context, analysis.classes, k, get(state.context.applications, setAppPosition));
                    if w.written {
                        if sameIn(analysis.classes, get(state.context.applications, setAppPosition).id, get(app.arguments, 0)) {
                            tried = tried + 1;
                            r = splitAtWrite(state, analysis, goal, depth, budget - used, app.id, k, w);
                            used = used + r.used;
                            if r.holds { return SplitResult { holds: true, used: used }; };
                        };
                    };
                };
            };
        };
    };
    // (a read of a list a forall fact is about, at an index on no known side of
    // the fact's bound: the goal holds below the bound and at or above it)
    rangeTried = 0;
    for back in 0..count {
        app = applicationAt(state.context.applications, count - 1 - back);
        if app.function = -14 && size(app.arguments) = 2 && rangeTried < 2 && used < budget {
            if equalToAny(analysis.classes, app.id, near) {
                k = get(app.arguments, 1);
                list = get(app.arguments, 0);
                for factPosition in 0..size(state.context.applications) {
                    fact = get(state.context.applications, factPosition);
                    if fact.function = -30 && size(fact.arguments) = 5 && rangeTried < 2 && used < budget {
                        if sameIn(analysis.classes, get(fact.arguments, 0), list) || sameIn(analysis.classes, get(fact.arguments, 1), list) {
                            for side in 0..2 {
                                bound = get(fact.arguments, 2 + side);
                                if rangeTried < 2 && used < budget {
                                    if linearEntails(state.context, bound, k, 0) = false && linearEntails(state.context, k, bound, -1) = false {
                                        rangeTried = rangeTried + 1;
                                        r = splitAtBound(state, goal, depth, budget - used, k, bound);
                                        used = used + r.used;
                                        if r.holds { return SplitResult { holds: true, used: used }; };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return SplitResult { holds: false, used: used };
};

// The goal at a read of a write: at the write's index the read is the value written; elsewhere it is a read of the
// list written to, at an index other than the write's (below it, for a push)
fn splitAtWrite(state: &ExecutionState, analysis: &ContextAnalysis, goal: &ValidatorGoal, depth: Int, budget: Int, readId: Int, k: Int, w: &WriteOf) -> SplitResult [{ affirm depth >= 1; }] [{ }] shrinks 2 * depth {
    used = 0;
    context = clone(state.context);
    sameIndex = sameIn(analysis.classes, k, w.idx);
    atOk = contextDifferent(analysis.equalities, context.applications, context.orders, context.different, analysis.differences, k, w.idx);
    if atOk = false {
        atIdx = ValidatorContext { equalities: push(push(clone(context.equalities), EqualityFact { left: k, right: w.idx }), EqualityFact { left: readId, right: w.value }), ..clone(context) };
        atOk = analyzeContext(atIdx).contradictory;
        if atOk = false { used = used + 1; atOk = entailsGoal(atIdx, clone(goal)); };
        // (the value may itself be read from a write: a node set from the node there)
        if atOk = false && used < budget {
            deeper = splitReadOverWrite(ExecutionState { context: clone(atIdx), ..clone(state) }, clone(goal), depth - 1, budget - used);
            used = used + deeper.used;
            atOk = deeper.holds;
        };
    };
    if atOk = false { return SplitResult { holds: false, used: used }; };
    if sameIndex { return SplitResult { holds: true, used: used }; };
    fresh = freshValue(state);
    if fresh is ValueLookup::Missing { return SplitResult { holds: false, used: used }; };
    newRead = (fresh as ValueLookup::Found).term;
    apps = push(clone(context.applications), ApplicationTerm { id: newRead, function: -14, arguments: push(push([], w.inner), k) });
    elsewhere = ValidatorContext { applications: apps, equalities: push(clone(context.equalities), EqualityFact { left: readId, right: newRead }), different: push(clone(context.different), DisequalityFact { left: k, right: w.idx }), ..clone(context) };
    if w.pushed {
        elsewhere = ValidatorContext { orders: push(clone(elsewhere.orders), OrderFact { smaller: k, greater: w.idx, strict: true }), ..clone(elsewhere) };
    };
    elseOk = analyzeContext(elsewhere).contradictory;
    if elseOk = false { used = used + 1; elseOk = entailsGoal(elsewhere, clone(goal)); };
    if elseOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(elsewhere), ..clone(state) }, clone(goal), depth - 1, budget - used);
        used = used + deeper.used;
        elseOk = deeper.holds;
    };
    return SplitResult { holds: elseOk, used: used };
};

// The goal at a read on no known side of a forall fact's bound: below the bound, and at or above it
fn splitAtBound(state: &ExecutionState, goal: &ValidatorGoal, depth: Int, budget: Int, k: Int, bound: Int) -> SplitResult [{ affirm depth >= 1; }] [{ }] shrinks 2 * depth {
    used = 0;
    below = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: k, greater: bound, strict: true }), ..clone(state.context) };
    below = withInstances(state, below);
    belowOk = analyzeContext(below).contradictory;
    if belowOk = false { used = used + 1; belowOk = entailsGoal(below, clone(goal)); };
    if belowOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(below), ..clone(state) }, clone(goal), depth - 1, budget - used);
        used = used + deeper.used;
        belowOk = deeper.holds;
    };
    if belowOk = false { return SplitResult { holds: false, used: used }; };
    above = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: bound, greater: k, strict: false }), ..clone(state.context) };
    above = withInstances(state, above);
    aboveOk = analyzeContext(above).contradictory;
    if aboveOk = false { used = used + 1; aboveOk = entailsGoal(above, clone(goal)); };
    if aboveOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(above), ..clone(state) }, clone(goal), depth - 1, budget - used);
        used = used + deeper.used;
        aboveOk = deeper.holds;
    };
    return SplitResult { holds: aboveOk, used: used };
};

// (below every term the state mentions, found in one pass over it)
fn freshValue(state: &ExecutionState) -> ValueLookup {
    return ValueLookup::Found { term: leastTermInUse(state) - 1 };
};

fn leastTermInUse(state: &ExecutionState) -> Int {
    least = -999;
    for binding in state.locals.entries() { if binding.value < least { least = binding.value; }; };
    for factPosition in 0..size(state.context.equalities) {
        fact = get(state.context.equalities, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    for factPosition in 0..size(state.context.different) {
        fact = get(state.context.different, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    for factPosition in 0..size(state.context.orders) {
        fact = get(state.context.orders, factPosition);
        if fact.smaller < least { least = fact.smaller; };
        if fact.greater < least { least = fact.greater; };
    };
    for factPosition in 0..size(state.context.differences) {
        fact = get(state.context.differences, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    // (an application is read where it is: it holds a list)
    for vPosition in 0..size(state.context.variants) {
        object = get(state.context.variants, vPosition).object;
        if object < least { least = object; };
    };
    for cPosition in 0..size(state.context.constants) {
        id = get(state.context.constants, cPosition).id;
        if id < least { least = id; };
    };
    for appPosition in 0..size(state.context.applications) {
        id = get(state.context.applications, appPosition).id;
        if id < least { least = id; };
        function = get(state.context.applications, appPosition).function;
        if function < least { least = function; };
        count = size(get(state.context.applications, appPosition).arguments);
        for k in 0..count {
            a = intAt(get(state.context.applications, appPosition).arguments, k, 0);
            if a < least { least = a; };
        };
    };
    return least;
};

fn sameConstructorField(a: &ConstructorField, b: &ConstructorField) -> Bool {
    return a.constructor = b.constructor && a.field = b.field && a.index = b.index;
};

fn containsConstructorField(fields: &List<ConstructorField>, field: &ConstructorField) -> Bool {
    for candidatePosition in 0..size(fields) {
        candidate = get(fields, candidatePosition);
        if sameConstructorField(candidate, field) { return true; };
    };
    return false;
};

fn unionContexts(left: &ValidatorContext, right: &ValidatorContext) -> ValidatorContext {
    equalities = clone(left.equalities);
    applications = clone(left.applications);
    constants = clone(left.constants);
    orders = clone(left.orders);
    different = clone(left.different);
    variants = clone(left.variants);
    fieldFunctions = clone(left.fieldFunctions);
    constructorFunctions = clone(left.constructorFunctions);
    constructorFields = clone(left.constructorFields);
    differences = clone(left.differences);
    for fact in right.equalities { equalities = push(equalities, clone(fact)); };
    for fact in right.applications { applications = push(applications, clone(fact)); };
    for fact in right.constants { constants = push(constants, clone(fact)); };
    for fact in right.orders { orders = push(orders, clone(fact)); };
    for fact in right.different { different = push(different, clone(fact)); };
    for fact in right.variants { variants = push(variants, clone(fact)); };
    fieldSeen = HashSet::new();
    for function in fieldFunctions { fieldSeen = fieldSeen.insert(function); };
    for function in right.fieldFunctions { if fieldSeen.contains(function) = false { fieldSeen = fieldSeen.insert(function); fieldFunctions = push(fieldFunctions, function); }; };
    constructorSeen = HashSet::new();
    for function in constructorFunctions { constructorSeen = constructorSeen.insert(function); };
    for function in right.constructorFunctions { if constructorSeen.contains(function) = false { constructorSeen = constructorSeen.insert(function); constructorFunctions = push(constructorFunctions, function); }; };
    for field in right.constructorFields { if containsConstructorField(constructorFields, field) = false { constructorFields = push(constructorFields, clone(field)); }; };
    for fact in right.differences { differences = push(differences, clone(fact)); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn mergeTerm(joined: &HashMap<Int, Int>, ambiguous: &HashSet<Int>, term: Int) -> ValueLookup {
    if ambiguous.contains(term) { return ValueLookup::Missing; };
    if joined.contains(term) { return ValueLookup::Found { term: joined.lookup(term, 0) }; };
    if term >= 0 { return ValueLookup::Found { term: term }; };
    return ValueLookup::Missing;
};

fn normalizedContext(context: &ValidatorContext, pairs: &List<MergePair>, leftSide: Bool) -> ValidatorContext {
    joined = emptyIntMap();
    ambiguous = HashSet::new();
    // (a term a local keeps as itself across the join keeps its facts: a local
    // joined from it on this side is said equal to it here, not renamed into
    // it, or the local that keeps it would lose what is known of it)
    kept = HashSet::new();
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        if pair.joined = pair.left && pair.joined = pair.right && pair.left < 0 {
            kept = kept.insert(pair.left);
            joined = joined.insert(pair.left, pair.left);
        };
    };
    sameAsKept = [];
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        source = pair.right;
        if leftSide { source = pair.left; };
        // (a literal is a term every fact may speak of, not the local's own
        // value: renaming it would turn m >= 1 into m >= c after c = 1 on one
        // side; the joined value gets its range from the bounds instead)
        if source >= 0 {
        } else if kept.contains(source) {
            if pair.joined != source { sameAsKept = push(sameAsKept, EqualityFact { left: pair.joined, right: source }); };
        } else if pair.ambiguous {
            ambiguous = ambiguous.insert(source);
        } else if ambiguous.contains(source) = false {
            if joined.contains(source) {
                if joined.lookup(source, 0) != pair.joined {
                    ambiguous = ambiguous.insert(source);
                };
            } else {
                joined = joined.insert(source, pair.joined);
            };
        };
    };
    equalities = [];
    applications = [];
    constants = [];
    orders = [];
    different = [];
    variants = [];
    fieldFunctions = clone(context.fieldFunctions);
    constructorFunctions = clone(context.constructorFunctions);
    constructorFields = clone(context.constructorFields);
    differences = [];
    for factPosition in 0..size(context.equalities) {
        fact = get(context.equalities, factPosition);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                equalities = push(equalities, EqualityFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term });
            };
        };
    };
    for factPosition in 0..size(context.applications) {
        fact = get(context.applications, factPosition);
        id = mergeTerm(joined, ambiguous, fact.id);
        arguments = [];
        valid = true;
        for argumentPosition in 0..size(fact.arguments) {
            argument = get(fact.arguments, argumentPosition);
            mapped = mergeTerm(joined, ambiguous, argument);
            if mapped is ValueLookup::Found { arguments = push(arguments, (mapped as ValueLookup::Found).term); } else { valid = false; };
        };
        if id is ValueLookup::Found {
            if valid { applications = push(applications, ApplicationTerm { id: (id as ValueLookup::Found).term, function: fact.function, arguments: arguments }); };
        };
    };
    for factPosition in 0..size(context.constants) {
        fact = get(context.constants, factPosition);
        id = mergeTerm(joined, ambiguous, fact.id);
        if id is ValueLookup::Found { constants = push(constants, ConstantTerm { id: (id as ValueLookup::Found).term, kind: fact.kind, value: fact.value }); };
    };
    for factPosition in 0..size(context.orders) {
        fact = get(context.orders, factPosition);
        smaller = mergeTerm(joined, ambiguous, fact.smaller);
        greater = mergeTerm(joined, ambiguous, fact.greater);
        if smaller is ValueLookup::Found {
            if greater is ValueLookup::Found { orders = push(orders, OrderFact { smaller: (smaller as ValueLookup::Found).term, greater: (greater as ValueLookup::Found).term, strict: fact.strict }); };
        };
    };
    for factPosition in 0..size(context.different) {
        fact = get(context.different, factPosition);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found { different = push(different, DisequalityFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term }); };
        };
    };
    for factPosition in 0..size(context.differences) {
        fact = get(context.differences, factPosition);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found { differences = push(differences, DifferenceFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term, bound: fact.bound }); };
        };
    };
    for factPosition in 0..size(context.variants) {
        fact = get(context.variants, factPosition);
        object = mergeTerm(joined, ambiguous, fact.object);
        if object is ValueLookup::Found { variants = push(variants, VariantFact { object: (object as ValueLookup::Found).term, family: fact.family, constructor: fact.constructor, matches: fact.matches }); };
    };
    for fact in sameAsKept { equalities = push(equalities, fact); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn sameEquality(a: &EqualityFact, b: &EqualityFact) -> Bool {
    return (a.left = b.left && a.right = b.right) || (a.left = b.right && a.right = b.left);
};

fn sameDisequality(a: &DisequalityFact, b: &DisequalityFact) -> Bool {
    return (a.left = b.left && a.right = b.right) || (a.left = b.right && a.right = b.left);
};

fn sameVariantFact(a: &VariantFact, b: &VariantFact) -> Bool {
    return a.object = b.object && a.family = b.family && a.constructor = b.constructor && a.matches = b.matches;
};

fn sameApplication(a: &ApplicationTerm, b: &ApplicationTerm) -> Bool {
    return a.id = b.id && a.function = b.function && a.arguments = b.arguments;
};

// A fact a join keeps when both paths hold it: a key that equal facts share,
// and whether two facts are the same
trait JoinedFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }];
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }];
};

impl JoinedFact for EqualityFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return minInt(self.left, self.right); };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameEquality(self, other); };
};

impl JoinedFact for ApplicationTerm {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.id; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameApplication(self, other); };
};

impl JoinedFact for ConstantTerm {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.id; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.id = other.id && self.kind = other.kind && self.value = other.value; };
};

impl JoinedFact for OrderFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.smaller; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.smaller = other.smaller && self.greater = other.greater && self.strict = other.strict; };
};

impl JoinedFact for DisequalityFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return minInt(self.left, self.right); };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameDisequality(self, other); };
};

impl JoinedFact for VariantFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.object; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameVariantFact(self, other); };
};

impl JoinedFact for ConstructorField {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.constructor; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameConstructorField(self, other); };
};

impl JoinedFact for DifferenceFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.left; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.left = other.left && self.right = other.right && self.bound = other.bound; };
};

// The facts of left that right holds too, each once. (A fact held twice on
// each side was kept four times, and the copies multiplied with every join
// after it.) The facts of right are found by their key, not by a walk over
// all of them for each fact of left.
fn commonFacts<T: JoinedFact + Clone>(left: &List<T>, right: &List<T>) -> List<T> {
    common = [];
    byKey = emptyPositions();
    for rPosition in 0..size(right) {
        rKey = JoinedFact::joinKey(get(right, rPosition));
        byKey = byKey.insert(rKey, push(byKey.lookup(rKey, []), rPosition));
    };
    kept = emptyPositions();
    for lPosition in 0..size(left) {
        lKey = JoinedFact::joinKey(get(left, lPosition));
        matched = false;
        for candidate in byKey.lookup(lKey, []) {
            if matched = false && candidate >= 0 && candidate < size(right) {
                if JoinedFact::sameFact(get(left, lPosition), get(right, candidate)) { matched = true; };
            };
        };
        if matched {
            already = false;
            for earlier in kept.lookup(lKey, []) {
                if already = false && earlier >= 0 && earlier < size(left) {
                    if JoinedFact::sameFact(get(left, lPosition), get(left, earlier)) { already = true; };
                };
            };
            if already = false {
                kept = kept.insert(lKey, push(kept.lookup(lKey, []), lPosition));
                common = push(common, clone(get(left, lPosition)));
            };
        };
    };
    return common;
};

fn commonContext(left: &ValidatorContext, right: &ValidatorContext) -> ValidatorContext {
    fieldFunctions = [];
    rightFields = HashSet::new();
    for function in right.fieldFunctions { rightFields = rightFields.insert(function); };
    for function in left.fieldFunctions { if rightFields.contains(function) { fieldFunctions = push(fieldFunctions, function); }; };
    constructorFunctions = [];
    rightConstructors = HashSet::new();
    for function in right.constructorFunctions { rightConstructors = rightConstructors.insert(function); };
    for function in left.constructorFunctions { if rightConstructors.contains(function) { constructorFunctions = push(constructorFunctions, function); }; };
    return ValidatorContext { equalities: commonFacts(left.equalities, right.equalities), applications: commonFacts(left.applications, right.applications), constants: commonFacts(left.constants, right.constants), orders: commonFacts(left.orders, right.orders), different: commonFacts(left.different, right.different), variants: commonFacts(left.variants, right.variants), fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: commonFacts(left.constructorFields, right.constructorFields), differences: commonFacts(left.differences, right.differences) };
};

// One end of the integer range a term is known to lie in: its constant
// value, or the tightest order fact against a constant-valued term.
fn rangeBound(context: &ValidatorContext, term: Int, low: Bool) -> IntegerLookup {
    value = integerValue(context, term);
    if value is IntegerLookup::Found { return value; };
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    best = 0;
    found = false;
    for orderPosition in 0..size(context.orders) {
        order = get(context.orders, orderPosition);
        if low {
            if sameIn(equalitiesClasses, order.greater, term) {
                v = integerValue(context, order.smaller);
                if v is IntegerLookup::Found {
                    cand = (v as IntegerLookup::Found).value;
                    usable = true;
                    if order.strict {
                        if cand < 9223372036854775807 { cand = cand + 1; } else { usable = false; };
                    };
                    if usable {
                        if found = false || cand > best { best = cand; found = true; };
                    };
                };
            };
        } else {
            if sameIn(equalitiesClasses, order.smaller, term) {
                v = integerValue(context, order.greater);
                if v is IntegerLookup::Found {
                    cand = (v as IntegerLookup::Found).value;
                    usable = true;
                    if order.strict {
                        if cand > -9223372036854775808 { cand = cand - 1; } else { usable = false; };
                    };
                    if usable {
                        if found = false || cand < best { best = cand; found = true; };
                    };
                };
            };
        };
    };
    if found { return IntegerLookup::Found { value: best }; };
    return IntegerLookup::Missing;
};

fn addRangeBound(state: &ExecutionState, term: Int, value: Int, low: Bool) -> ExecutionState {
    boundTerm = 0;
    found = false;
    for constantPosition in 0..size(state.context.constants) {
        constant = get(state.context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = value { boundTerm = constant.id; found = true; };
        };
    };
    owned = clone(state);
    context = clone(owned.context);
    if found = false {
        fresh = freshValue(state);
        if fresh is ValueLookup::Found {
            boundTerm = (fresh as ValueLookup::Found).term;
            context = ValidatorContext { constants: push(clone(context.constants), ConstantTerm { id: boundTerm, kind: 0, value: value }), ..context };
        } else { return clone(state); };
    };
    if low {
        context = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: boundTerm, greater: term, strict: false }), ..context };
    } else {
        context = ValidatorContext { orders: push(clone(context.orders), OrderFact { smaller: term, greater: boundTerm, strict: false }), ..context };
    };
    return ExecutionState { context: context, ..owned };
};

fn addOrderToState(state: &ExecutionState, smaller: Int, greater: Int) -> ExecutionState {
    for orderPosition in 0..size(state.context.orders) {
        order = get(state.context.orders, orderPosition);
        if order.smaller = smaller {
            if order.greater = greater { return clone(state); };
        };
    };
    context = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: smaller, greater: greater, strict: false }), ..clone(state.context) };
    return ExecutionState { context: context, ..clone(state) };
};

fn addStrictOrderToState(state: &ExecutionState, smaller: Int, greater: Int) -> ExecutionState {
    for orderPosition in 0..size(state.context.orders) {
        order = get(state.context.orders, orderPosition);
        if order.smaller = smaller {
            if order.greater = greater {
                if order.strict { return clone(state); };
            };
        };
    };
    context = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: smaller, greater: greater, strict: true }), ..clone(state.context) };
    return ExecutionState { context: context, ..clone(state) };
};

// A bound that both branches give the joined term, though neither branch
// states it of that term: on one side it may follow from the value the term
// was before the join (0 <= 0 - n from n < 0), so each side is asked with the
// solver, not matched as a fact. The bounds tried are the constants the join
// keeps and the terms both sides compare against.
fn constantTermWithValue(context: &ValidatorContext, value: Int) -> ValueLookup {
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = value { return ValueLookup::Found { term: constant.id }; };
        };
    };
    return ValueLookup::Missing;
};

// Two locals the paths set to different numbers with the same sum (x = 1,
// y = 0 on one, x = 0, y = 1 on the other) keep that sum after the join
fn addJoinedSums(state: &ExecutionState, pairs: &List<MergePair>, left: &ExecutionState, right: &ExecutionState) -> ExecutionState {
    result = clone(state);
    added = 0;
    for i in 0..size(pairs) {
        for j in 0..size(pairs) {
            if i < j && added < 8 {
                p = get(pairs, i);
                q = get(pairs, j);
                if p.ambiguous = false && q.ambiguous = false {
                    lp = integerValue(left.context, p.left);
                    lq = integerValue(left.context, q.left);
                    rp = integerValue(right.context, p.right);
                    rq = integerValue(right.context, q.right);
                    if lp is IntegerLookup::Found && lq is IntegerLookup::Found && rp is IntegerLookup::Found && rq is IntegerLookup::Found {
                        a = (lp as IntegerLookup::Found).value;
                        b = (lq as IntegerLookup::Found).value;
                        c = (rp as IntegerLookup::Found).value;
                        d = (rq as IntegerLookup::Found).value;
                        if a + b = c + d && a != c {
                            total = constantTermWithValue(result.context, a + b);
                            fresh = freshValue(result);
                            if total is ValueLookup::Found && fresh is ValueLookup::Found {
                                sumTerm = (fresh as ValueLookup::Found).term;
                                apps = push(clone(result.context.applications), ApplicationTerm { id: sumTerm, function: -1, arguments: push(push([], p.joined), q.joined) });
                                facts = push(clone(result.context.equalities), EqualityFact { left: sumTerm, right: (total as ValueLookup::Found).term });
                                result = ExecutionState { context: ValidatorContext { applications: apps, equalities: facts, ..clone(result.context) }, ..clone(result) };
                                added = added + 1;
                            };
                        };
                    };
                };
            };
        };
    };
    return result;
};

fn addJoinedBounds(state: &ExecutionState, pairs: &List<MergePair>, left: &ExecutionState, right: &ExecutionState) -> ExecutionState {
    result = clone(state);
    leftCache = entailmentCache(left.context);
    rightCache = entailmentCache(right.context);
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        mergedCandidates = [];
        leftCandidates = [];
        rightCandidates = [];
        candidateValues = [];
        for constantPosition in 0..size(result.context.constants) {
            constant = get(result.context.constants, constantPosition);
            if constant.kind = 0 {
                lc = constantTermWithValue(left.context, constant.value);
                rc = constantTermWithValue(right.context, constant.value);
                if lc is ValueLookup::Found {
                    if rc is ValueLookup::Found {
                        if containsValue(mergedCandidates, constant.id) = false {
                            mergedCandidates = push(mergedCandidates, constant.id);
                            candidateValues = push(candidateValues, constant.value);
                            leftCandidates = push(leftCandidates, (lc as ValueLookup::Found).term);
                            rightCandidates = push(rightCandidates, (rc as ValueLookup::Found).term);
                        };
                    };
                };
            };
        };
        firstLocal = size(mergedCandidates);
        for binding in result.locals.entries() {
            if binding.value != pair.joined {
                lc = lookupLocal(left.locals, binding.key);
                rc = lookupLocal(right.locals, binding.key);
                if lc is ValueLookup::Found {
                    if rc is ValueLookup::Found {
                        if containsValue(mergedCandidates, binding.value) = false {
                            mergedCandidates = push(mergedCandidates, binding.value);
                            leftCandidates = push(leftCandidates, (lc as ValueLookup::Found).term);
                            rightCandidates = push(rightCandidates, (rc as ValueLookup::Found).term);
                        };
                    };
                };
            };
        };
        haveLower = false;
        lowerValue = 0;
        lowerTerm = 0;
        haveUpper = false;
        upperValue = 0;
        upperTerm = 0;
        for i in 0..size(mergedCandidates) {
            candidate = get(mergedCandidates, i);
            lc = intAt(leftCandidates, i, 0);
            rc = intAt(rightCandidates, i, 0);
            // (a bound both sides keep strictly against a local is kept strictly:
            // r > n after r = n + 1 on one side and r = n + 2 on the other; a
            // constant's own value says as much without the cost)
            lowerLeft = entailsGoalCached(leftCache, ValidatorGoal::AtMost { left: lc, right: pair.left });
            leftCache = lowerLeft.cache;
            if lowerLeft.holds {
                lowerRight = entailsGoalCached(rightCache, ValidatorGoal::AtMost { left: rc, right: pair.right });
                rightCache = lowerRight.cache;
                if lowerRight.holds {
                    strict = false;
                    if i >= firstLocal && entailsGoal(left.context, ValidatorGoal::Less { left: lc, right: pair.left }) {
                        strict = entailsGoal(right.context, ValidatorGoal::Less { left: rc, right: pair.right });
                    };
                    if i < firstLocal {
                        // (of the constants below both sides only the greatest is kept:
                        // the others follow from it, and each would be a fact to carry)
                        v = intAt(candidateValues, i, 0);
                        if haveLower = false || v > lowerValue { haveLower = true; lowerValue = v; lowerTerm = candidate; };
                    } else {
                        if strict { result = addStrictOrderToState(result, candidate, pair.joined); } else { result = addOrderToState(result, candidate, pair.joined); };
                    };
                };
            };
            upperLeft = entailsGoalCached(leftCache, ValidatorGoal::AtMost { left: pair.left, right: lc });
            leftCache = upperLeft.cache;
            if upperLeft.holds {
                upperRight = entailsGoalCached(rightCache, ValidatorGoal::AtMost { left: pair.right, right: rc });
                rightCache = upperRight.cache;
                if upperRight.holds {
                    strict = false;
                    if i >= firstLocal && entailsGoal(left.context, ValidatorGoal::Less { left: pair.left, right: lc }) {
                        strict = entailsGoal(right.context, ValidatorGoal::Less { left: pair.right, right: rc });
                    };
                    if i < firstLocal {
                        v = intAt(candidateValues, i, 0);
                        if haveUpper = false || v < upperValue { haveUpper = true; upperValue = v; upperTerm = candidate; };
                    } else {
                        if strict { result = addStrictOrderToState(result, pair.joined, candidate); } else { result = addOrderToState(result, pair.joined, candidate); };
                    };
                };
            };
        };
        if haveLower { result = addOrderToState(result, lowerTerm, pair.joined); };
        if haveUpper { result = addOrderToState(result, pair.joined, upperTerm); };
    };
    for pPosition in 0..size(pairs) {
        p = get(pairs, pPosition);
        for qPosition in 0..size(pairs) {
            q = get(pairs, qPosition);
            if p.joined != q.joined {
                a = integerValue(left.context, p.left);
                b = integerValue(left.context, q.left);
                c = integerValue(right.context, p.right);
                d = integerValue(right.context, q.right);
                if a is IntegerLookup::Found {
                    if b is IntegerLookup::Found {
                        if c is IntegerLookup::Found {
                            if d is IntegerLookup::Found {
                                av = (a as IntegerLookup::Found).value;
                                bv = (b as IntegerLookup::Found).value;
                                cv = (c as IntegerLookup::Found).value;
                                dv = (d as IntegerLookup::Found).value;
                                if av <= bv {
                                    if cv <= dv { result = addOrderToState(result, p.joined, q.joined); };
                                };
                                if av < bv {
                                    if cv < dv { result = addStrictOrderToState(result, p.joined, q.joined); };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return result;
};

fn mergeStates(fork: &ExecutionState, left: &ExecutionState, right: &ExecutionState) -> StateMergeLookup {
    poolContext = unionContexts(left.context, right.context);
    poolEqualities = clone(poolContext.equalities);
    for binding in left.locals.entries() { poolEqualities = push(poolEqualities, EqualityFact { left: binding.value, right: binding.value }); };
    for binding in right.locals.entries() { poolEqualities = push(poolEqualities, EqualityFact { left: binding.value, right: binding.value }); };
    poolContext = ValidatorContext { equalities: clone(poolEqualities), ..clone(poolContext) };
    pool = ExecutionState { context: clone(poolContext), locals: HashMap::new(), templates: noTemplates() };
    pairs = emptyMergePairs();
    locals = emptyIntMap();
    for binding in left.locals.entries() {
        other = lookupLocal(right.locals, binding.key);
        if other is ValueLookup::Found {
            rightTerm = (other as ValueLookup::Found).term;
            if binding.value >= 0 && binding.value = rightTerm {
                locals = bindLocal(locals, binding.key, binding.value);
            } else if binding.value = rightTerm && termInUse(fork, binding.value) {
                // (a term the checker made before the branch, as size(digits)
                // from a contract, is the same on both sides: it is kept as
                // itself, and the joined state keeps what both sides know of
                // it; the same number made separately on each side after the
                // branch is two values, and is joined)
                locals = bindLocal(locals, binding.key, binding.value);
                known = false;
                for pair in pairs { if pair.left = binding.value && pair.right = binding.value { known = true; }; };
                if known = false { pairs = push(pairs, MergePair { left: binding.value, right: binding.value, joined: binding.value, ambiguous: false }); };
            } else {
                joined = 0;
                found = false;
                for pairPosition in 0..size(pairs) {
                    pair = get(pairs, pairPosition);
                    if pair.left = binding.value && pair.right = rightTerm {
                        joined = pair.joined;
                        found = true;
                    };
                };
                if found = false {
                    fresh = freshValue(pool);
                    if fresh is ValueLookup::Found {
                        joined = (fresh as ValueLookup::Found).term;
                        pairs = push(pairs, MergePair { left: binding.value, right: rightTerm, joined: joined, ambiguous: binding.value < 0 && binding.value = rightTerm });
                        poolEqualities = push(clone(poolEqualities), EqualityFact { left: joined, right: joined });
                        pool = ExecutionState { context: ValidatorContext { equalities: clone(poolEqualities), ..clone(poolContext) }, locals: HashMap::new(), templates: noTemplates() };
                        found = true;
                    } else { return StateMergeLookup::Missing; };
                };
                if found { locals = bindLocal(locals, binding.key, joined); };
            };
        };
    };
    leftContext = normalizedContext(left.context, pairs, true);
    rightContext = normalizedContext(right.context, pairs, false);
    // (a forall both paths assumed holds after the join: its values are locals,
    // which the join gives the joined terms)
    state = ExecutionState { context: commonContext(leftContext, rightContext), locals: locals, templates: commonTemplates(left.templates, right.templates) };
    mergedConstants = clone(state.context.constants);
    for factPosition in 0..size(leftContext.constants) {
        fact = get(leftContext.constants, factPosition);
        if fact.id >= 0 {
            known = false;
            for kept in mergedConstants { if kept.id = fact.id { known = true; }; };
            if known = false { mergedConstants = push(mergedConstants, clone(fact)); };
        };
    };
    for factPosition in 0..size(rightContext.constants) {
        fact = get(rightContext.constants, factPosition);
        if fact.id >= 0 {
            known = false;
            for kept in mergedConstants { if kept.id = fact.id { known = true; }; };
            if known = false { mergedConstants = push(mergedConstants, clone(fact)); };
        };
    };
    state = ExecutionState { context: ValidatorContext { constants: mergedConstants, ..state.context }, ..state };
    joinPairs = emptyMergePairs();
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        if pair.joined != pair.left || pair.joined != pair.right { joinPairs = push(joinPairs, clone(pair)); };
    };
    for pairPosition in 0..size(joinPairs) {
        pair = get(joinPairs, pairPosition);
        loLeft = rangeBound(left.context, pair.left, true);
        loRight = rangeBound(right.context, pair.right, true);
        if loLeft is IntegerLookup::Found {
            if loRight is IntegerLookup::Found {
                lo = (loLeft as IntegerLookup::Found).value;
                if (loRight as IntegerLookup::Found).value < lo { lo = (loRight as IntegerLookup::Found).value; };
                state = addRangeBound(state, pair.joined, lo, true);
            };
        };
        hiLeft = rangeBound(left.context, pair.left, false);
        hiRight = rangeBound(right.context, pair.right, false);
        if hiLeft is IntegerLookup::Found {
            if hiRight is IntegerLookup::Found {
                hi = (hiLeft as IntegerLookup::Found).value;
                if (hiRight as IntegerLookup::Found).value > hi { hi = (hiRight as IntegerLookup::Found).value; };
                state = addRangeBound(state, pair.joined, hi, false);
            };
        };
    };
    state = addJoinedBounds(state, joinPairs, left, right);
    state = addJoinedSums(state, joinPairs, left, right);
    return StateMergeLookup::Found { state: state };
};

// The MIR bridge reserves function -1 for addition and -2 for subtraction.
// For result = base + offset, record both difference bounds if their literal
// weights fit. If negating the offset overflows, retaining one direction is
// sound and merely incomplete.
fn addOffsetFacts(context: &ValidatorContext, result: Int, base: Int, offset: Int) -> ValidatorContext {
    facts = push(clone(context.differences), DifferenceFact { left: result, right: base, bound: offset });
    reverse = safeBoundDifference(0, offset);
    if reverse is SumResult::Sum {
        facts = push(facts, DifferenceFact { left: base, right: result, bound: (reverse as SumResult::Sum).value });
    };
    return ValidatorContext { differences: facts, ..clone(context) };
};

// Compute a product only when it fits the interpreter's signed Int range.
// The divisions below have nonzero denominators and never divide minInt by
// minus one. An unrepresentable product yields no proof fact.
fn safeProduct(a: Int, b: Int) -> SumResult {
    if a > 0 {
        if b > 0 {
            if a > 9223372036854775807 / b { return SumResult::Overflow; };
        };
        if b < 0 {
            bound = -9223372036854775808 / a;
            if b < bound { return SumResult::Overflow; };
            if b = bound {
                if -9223372036854775808 % a != 0 { return SumResult::Overflow; };
            };
        };
    };
    if a < 0 {
        if b > 0 {
            bound = -9223372036854775808 / b;
            if a < bound { return SumResult::Overflow; };
            if a = bound {
                if -9223372036854775808 % b != 0 { return SumResult::Overflow; };
            };
        };
        if b < 0 {
            bound = 9223372036854775807 / b;
            if a < bound { return SumResult::Overflow; };
            if a = bound {
                if 9223372036854775807 % b != 0 { return SumResult::Overflow; };
            };
        };
    };
    return SumResult::Sum { value: a * b };
};

// A checked read can be traced through a sequence operation when its index
// is known to survive. The scan is bounded and omits any case it cannot
// establish, rather than guessing about a symbolic index.
fn readThroughSequence(context: &ValidatorContext, result: Int, list: Int, index: Int) -> ValidatorContext {
    state = clone(context);
    current = list;
    visited = HashSet::new();
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    for round in 0..size(context.applications) {
        if visited.contains(current) { return state; };
        visited = visited.insert(current);
        moved = false;
        for appPosition in 0..size(context.applications) {
            app = get(context.applications, appPosition);
            if moved = false {
                if sameIn(equalitiesClasses, app.id, current) {
                    if app.function = -19 {
                        if size(app.arguments) = 2 {
                            fact = EqualityFact { left: result, right: get(app.arguments, 1) };
                            return ValidatorContext { equalities: push(state.equalities, fact), ..state };
                        };
                    };
                    if app.function = -17 {
                        if size(app.arguments) = 3 {
                            changed = get(app.arguments, 1);
                            if sameIn(equalitiesClasses, index, changed) {
                                fact = EqualityFact { left: result, right: get(app.arguments, 2) };
                                return ValidatorContext { equalities: push(state.equalities, fact), ..state };
                            };
                            a = integerValue(context, index);
                            b = integerValue(context, changed);
                            if a is IntegerLookup::Found {
                                if b is IntegerLookup::Found {
                                    if (a as IntegerLookup::Found).value != (b as IntegerLookup::Found).value {
                                        current = get(app.arguments, 0);
                                        moved = true;
                                    };
                                };
                            };
                            if moved = false {
                                distinct = false;
                                for dPosition in 0..size(context.different) {
                                    d = get(context.different, dPosition);
                                    if sameIn(equalitiesClasses, d.left, index) {
                                        if sameIn(equalitiesClasses, d.right, changed) { distinct = true; };
                                    };
                                    if sameIn(equalitiesClasses, d.left, changed) {
                                        if sameIn(equalitiesClasses, d.right, index) { distinct = true; };
                                    };
                                };
                                if distinct {
                                    current = get(app.arguments, 0);
                                    moved = true;
                                };
                            };
                        };
                    };
                    if app.function = -18 {
                        if size(app.arguments) = 1 {
                            current = get(app.arguments, 0);
                            moved = true;
                        };
                    };
                    if app.function = -16 {
                        if size(app.arguments) = 2 {
                            original = get(app.arguments, 0);
                            for lengthAppPosition in 0..size(context.applications) {
                                lengthApp = get(context.applications, lengthAppPosition);
                                if lengthApp.function = -13 {
                                    if size(lengthApp.arguments) = 1 {
                                        if sameIn(equalitiesClasses, get(lengthApp.arguments, 0), original) {
                                            length = integerValue(context, lengthApp.id);
                                            position = integerValue(context, index);
                                            if length is IntegerLookup::Found {
                                                if position is IntegerLookup::Found {
                                                    n = (length as IntegerLookup::Found).value;
                                                    i = (position as IntegerLookup::Found).value;
                                                    if i = n {
                                                        fact = EqualityFact { left: result, right: get(app.arguments, 1) };
                                                        return ValidatorContext { equalities: push(state.equalities, fact), ..state };
                                                    };
                                                    if i >= 0 {
                                                        if i < n { current = original; moved = true; };
                                                    };
                                                };
                                            };
                                            if sameIn(equalitiesClasses, index, lengthApp.id) {
                                                fact = EqualityFact { left: result, right: get(app.arguments, 1) };
                                                return ValidatorContext { equalities: push(state.equalities, fact), ..state };
                                            };
                                            if moved = false {
                                                orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
                                                differences = constantDifferences(context.constants, comparisonDifferences(orders, context.differences));
                                                if hasDifferenceIn(equalitiesClasses, differences, index, lengthApp.id, -1) {
                                                    current = original;
                                                    moved = true;
                                                };
                                                if moved = false {
                                                    if linearEntails(context, index, lengthApp.id, -1) {
                                                        current = original;
                                                        moved = true;
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        if moved = false { return state; };
        prior = ApplicationTerm { id: result, function: -14, arguments: push(push([], current), index) };
        state = ValidatorContext { applications: push(state.applications, prior), ..state };
    };
    return state;
};

// Scaling preserves or reverses an operand's order around zero according to
// the sign of the known integer factor.

fn addSumOrders(context: &ValidatorContext, result: Int, a: Int, b: Int) -> ValidatorContext {
    signs = signFacts(context);
    aNonnegative = knownNonnegativeWith(context, signs, a);
    bNonnegative = knownNonnegativeWith(context, signs, b);
    facts = clone(context.orders);
    if bNonnegative { facts = push(facts, OrderFact { smaller: a, greater: result, strict: false }); };
    if aNonnegative { facts = push(facts, OrderFact { smaller: b, greater: result, strict: false }); };
    if aNonnegative && bNonnegative {
        for constantPosition in 0..size(context.constants) {
            constant = get(context.constants, constantPosition);
            if constant.kind = 0 {
                if constant.value = 0 { facts = push(facts, OrderFact { smaller: constant.id, greater: result, strict: false }); };
            };
        };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

fn addScaleOrders(context: &ValidatorContext, result: Int, operand: Int, factor: Int) -> ValidatorContext {
    zero = ValueLookup::Missing;
    z = 0;
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = 0 { zero = ValueLookup::Found { term: constant.id }; };
        };
    };
    if zero is ValueLookup::Found {
        z = (zero as ValueLookup::Found).term;
    } else { return clone(context); };
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    nonnegative = hasOrderIn(equalitiesClasses, orders, z, operand, false) || isSizeTerm(context.applications, operand);
    positive = hasOrderIn(equalitiesClasses, orders, z, operand, true);
    nonpositive = hasOrderIn(equalitiesClasses, orders, operand, z, false);
    negative = hasOrderIn(equalitiesClasses, orders, operand, z, true);
    facts = clone(context.orders);
    if factor > 0 {
        if nonnegative { facts = push(facts, OrderFact { smaller: z, greater: result, strict: false }); };
        if positive { facts = push(facts, OrderFact { smaller: z, greater: result, strict: true }); };
        if nonpositive { facts = push(facts, OrderFact { smaller: result, greater: z, strict: false }); };
        if negative { facts = push(facts, OrderFact { smaller: result, greater: z, strict: true }); };
        if factor > 1 {
            if nonnegative { facts = push(facts, OrderFact { smaller: operand, greater: result, strict: false }); };
            if positive { facts = push(facts, OrderFact { smaller: operand, greater: result, strict: true }); };
            if nonpositive { facts = push(facts, OrderFact { smaller: result, greater: operand, strict: false }); };
            if negative { facts = push(facts, OrderFact { smaller: result, greater: operand, strict: true }); };
        };
    } else {
        if nonnegative { facts = push(facts, OrderFact { smaller: result, greater: z, strict: false }); };
        if positive { facts = push(facts, OrderFact { smaller: result, greater: z, strict: true }); };
        if nonpositive { facts = push(facts, OrderFact { smaller: z, greater: result, strict: false }); };
        if negative { facts = push(facts, OrderFact { smaller: z, greater: result, strict: true }); };
        if nonnegative { facts = push(facts, OrderFact { smaller: result, greater: operand, strict: false }); };
        if positive { facts = push(facts, OrderFact { smaller: result, greater: operand, strict: true }); };
        if nonpositive { facts = push(facts, OrderFact { smaller: operand, greater: result, strict: false }); };
        if negative { facts = push(facts, OrderFact { smaller: operand, greater: result, strict: true }); };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

// Integer remainder has the sign of its divisor and is strictly inside its
// magnitude, even when the dividend is symbolic.
fn addRemainderOrders(context: &ValidatorContext, result: Int, divisor: Int) -> ValidatorContext {
    zero = ValueLookup::Missing;
    z = 0;
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = 0 { zero = ValueLookup::Found { term: constant.id }; };
        };
    };
    if zero is ValueLookup::Found {
        z = (zero as ValueLookup::Found).term;
    } else { return clone(context); };
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    positiveDivisor = hasOrderIn(equalitiesClasses, orders, z, divisor, true);
    negativeDivisor = hasOrderIn(equalitiesClasses, orders, divisor, z, true);
    facts = clone(context.orders);
    if positiveDivisor {
        facts = push(facts, OrderFact { smaller: z, greater: result, strict: false });
        facts = push(facts, OrderFact { smaller: result, greater: divisor, strict: true });
    };
    if negativeDivisor {
        facts = push(facts, OrderFact { smaller: result, greater: z, strict: false });
        facts = push(facts, OrderFact { smaller: divisor, greater: result, strict: true });
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

// Integer division by a proved positive divisor stays between the dividend
// and zero. A negative divisor reverses the result's sign.
fn addDivisionOrders(context: &ValidatorContext, result: Int, dividend: Int, divisor: Int) -> ValidatorContext {
    zero = ValueLookup::Missing;
    z = 0;
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = 0 { zero = ValueLookup::Found { term: constant.id }; };
        };
    };
    if zero is ValueLookup::Found {
        z = (zero as ValueLookup::Found).term;
    } else { return clone(context); };
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    positiveDivisor = hasOrderIn(equalitiesClasses, orders, z, divisor, true);
    negativeDivisor = hasOrderIn(equalitiesClasses, orders, divisor, z, true);
    nonnegativeDividend = hasOrderIn(equalitiesClasses, orders, z, dividend, false);
    nonpositiveDividend = hasOrderIn(equalitiesClasses, orders, dividend, z, false);
    facts = clone(context.orders);
    if positiveDivisor {
        if nonnegativeDividend {
            facts = push(facts, OrderFact { smaller: z, greater: result, strict: false });
            facts = push(facts, OrderFact { smaller: result, greater: dividend, strict: false });
        };
        if nonpositiveDividend {
            facts = push(facts, OrderFact { smaller: dividend, greater: result, strict: false });
            facts = push(facts, OrderFact { smaller: result, greater: z, strict: false });
        };
    };
    if negativeDivisor {
        if nonnegativeDividend { facts = push(facts, OrderFact { smaller: result, greater: z, strict: false }); };
        if nonpositiveDividend { facts = push(facts, OrderFact { smaller: z, greater: result, strict: false }); };
    };
    return ValidatorContext { orders: facts, ..clone(context) };
};

// The value of a term whose parts are all known: arithmetic on known
// values, the size of a list made of known pushes, and an element read
// at a known index of one. This is what the reference engine's constant
// evaluation gives its inference; anything not wholly known is Missing.
fn evalApplication(context: &ValidatorContext, id: Int) -> ApplicationTerm {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.id = id { return clone(app); };
    };
    return ApplicationTerm { id: id, function: 0, arguments: [] };
};

fn evalHasApplication(context: &ValidatorContext, id: Int) -> Bool {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.id = id { return true; };
    };
    return false;
};

// A value the context gives a term directly: a constant, or a term its
// equalities make one (the evaluator asks this of every term it meets, and
// the closure integerValue reads under is too dear for that)
fn directIntegerValue(context: &ValidatorContext, term: Int) -> IntegerLookup {
    return directIntegerValueIn(unionOf(context.equalities), context.constants, term);
};

fn directIntegerValueIn(classes: &HashMap<Int, Int>, constants: &List<ConstantTerm>, term: Int) -> IntegerLookup {
    r = ufFind(classes, term);
    for cPosition in 0..size(constants) {
        if get(constants, cPosition).kind = 0 {
            if ufFind(classes, get(constants, cPosition).id) = r { return IntegerLookup::Found { value: get(constants, cPosition).value }; };
        };
    };
    return IntegerLookup::Missing;
};

fn evalListSize(context: &ValidatorContext, classes: &HashMap<Int, Int>, list: Int, depth: Int) -> IntegerLookup [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 1 {
    if evalHasApplication(context, list) = false { return IntegerLookup::Missing; };
    app = evalApplication(context, list);
    if app.function = -12 { return IntegerLookup::Found { value: size(app.arguments) }; };
    if app.function = -15 { return IntegerLookup::Found { value: size(app.arguments) }; };
    if app.function = -16 {
        if depth <= 0 { return IntegerLookup::Missing; };
        if size(app.arguments) = 2 {
            inner = evalListSize(context, classes, get(app.arguments, 0), depth - 1);
            if inner is IntegerLookup::Found { return IntegerLookup::Found { value: (inner as IntegerLookup::Found).value + 1 }; };
        };
    };
    if app.function = -19 {
        // (an array's length may be the size of that very array: the term
        // graph can be a cycle, which only the depth ends)
        if depth <= 0 { return IntegerLookup::Missing; };
        if size(app.arguments) = 2 { return evalTermValue(context, classes, get(app.arguments, 0), depth - 1); };
    };
    return IntegerLookup::Missing;
};

fn evalListGet(context: &ValidatorContext, classes: &HashMap<Int, Int>, list: Int, index: Int, depth: Int) -> IntegerLookup [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 1 {
    if evalHasApplication(context, list) = false { return IntegerLookup::Missing; };
    app = evalApplication(context, list);
    if app.function = -12 {
        if index >= 0 { if index < size(app.arguments) { return evalTermValue(context, classes, get(app.arguments, index), depth); }; };
        return IntegerLookup::Missing;
    };
    if app.function = -15 {
        if index >= 0 { if index < size(app.arguments) { return evalTermValue(context, classes, get(app.arguments, index), depth); }; };
        return IntegerLookup::Missing;
    };
    if app.function = -16 {
        if depth <= 0 { return IntegerLookup::Missing; };
        if size(app.arguments) = 2 {
            innerSize = evalListSize(context, classes, get(app.arguments, 0), depth - 1);
            if innerSize is IntegerLookup::Found {
                if index = (innerSize as IntegerLookup::Found).value { return evalTermValue(context, classes, get(app.arguments, 1), depth - 1); };
                if index < (innerSize as IntegerLookup::Found).value { return evalListGet(context, classes, get(app.arguments, 0), index, depth - 1); };
            };
        };
    };
    if app.function = -17 {
        if depth <= 0 { return IntegerLookup::Missing; };
        if size(app.arguments) = 3 {
            changed = evalTermValue(context, classes, get(app.arguments, 1), depth - 1);
            if changed is IntegerLookup::Found {
                if index = (changed as IntegerLookup::Found).value { return evalTermValue(context, classes, get(app.arguments, 2), depth - 1); };
                return evalListGet(context, classes, get(app.arguments, 0), index, depth - 1);
            };
        };
    };
    if app.function = -19 {
        if depth <= 0 { return IntegerLookup::Missing; };
        if size(app.arguments) = 2 {
            length = evalTermValue(context, classes, get(app.arguments, 0), depth - 1);
            if length is IntegerLookup::Found {
                if index >= 0 { if index < (length as IntegerLookup::Found).value { return evalTermValue(context, classes, get(app.arguments, 1), depth - 1); }; };
            };
        };
    };
    return IntegerLookup::Missing;
};

fn evalTermValue(context: &ValidatorContext, classes: &HashMap<Int, Int>, term: Int, depth: Int) -> IntegerLookup [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth {
    known = directIntegerValueIn(classes, context.constants, term);
    if known is IntegerLookup::Found { return known; };
    if depth <= 0 { return IntegerLookup::Missing; };
    if evalHasApplication(context, term) = false { return IntegerLookup::Missing; };
    app = evalApplication(context, term);
    if app.function = -13 {
        if size(app.arguments) = 1 { return evalListSize(context, classes, get(app.arguments, 0), depth - 1); };
        return IntegerLookup::Missing;
    };
    if app.function = -14 {
        if size(app.arguments) = 2 {
            index = evalTermValue(context, classes, get(app.arguments, 1), depth - 1);
            if index is IntegerLookup::Found { return evalListGet(context, classes, get(app.arguments, 0), (index as IntegerLookup::Found).value, depth - 1); };
        };
        return IntegerLookup::Missing;
    };
    if size(app.arguments) != 2 { return IntegerLookup::Missing; };
    a = evalTermValue(context, classes, get(app.arguments, 0), depth - 1);
    if a is IntegerLookup::Missing { return IntegerLookup::Missing; };
    b = evalTermValue(context, classes, get(app.arguments, 1), depth - 1);
    if b is IntegerLookup::Missing { return IntegerLookup::Missing; };
    av = (a as IntegerLookup::Found).value;
    bv = (b as IntegerLookup::Found).value;
    if app.function = -1 {
        if av > 0 { if bv > 9223372036854775807 - av { return IntegerLookup::Missing; }; };
        if av < 0 { if bv < -9223372036854775808 - av { return IntegerLookup::Missing; }; };
        return IntegerLookup::Found { value: av + bv };
    };
    if app.function = -2 {
        if bv < 0 { if av > 9223372036854775807 + bv { return IntegerLookup::Missing; }; };
        if bv > 0 { if av < -9223372036854775808 + bv { return IntegerLookup::Missing; }; };
        return IntegerLookup::Found { value: av - bv };
    };
    if app.function = -3 {
        product = safeProduct(av, bv);
        if product is SumResult::Sum { return IntegerLookup::Found { value: (product as SumResult::Sum).value }; };
        return IntegerLookup::Missing;
    };
    if app.function = -4 {
        if bv = 0 { return IntegerLookup::Missing; };
        if av = -9223372036854775808 { if bv = -1 { return IntegerLookup::Missing; }; };
        return IntegerLookup::Found { value: av / bv };
    };
    if app.function = -5 {
        if bv = 0 { return IntegerLookup::Missing; };
        if av = -9223372036854775808 { if bv = -1 { return IntegerLookup::Found { value: 0 }; }; };
        return IntegerLookup::Found { value: av % bv };
    };
    return IntegerLookup::Missing;
};

// A context with one more application (it is taken, not copied)
fn contextWithApplication(context: ValidatorContext, app: ApplicationTerm) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    return ValidatorContext { equalities: equalities, applications: push(applications, app), constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn contextWithConstant(context: ValidatorContext, constant: ConstantTerm) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    return ValidatorContext { equalities: equalities, applications: applications, constants: push(constants, constant), orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn stateWithConstant(state: ExecutionState, constant: ConstantTerm) -> ExecutionState {
    ExecutionState { context: context, locals: locals, templates: templates } = state;
    return ExecutionState { context: contextWithConstant(context, constant), locals: locals, templates: templates };
};

// A term whose value concrete evaluation knows is recorded as a
// constant, so the searches see it like any other known value.
fn recordEvaluatedValue(state: ExecutionState, term: Int) -> ExecutionState {
    // (a constant added on the way leaves the equalities, and so their union, as they are)
    classes = unionOf(state.context.equalities);
    if directIntegerValueIn(classes, state.context.constants, term) is IntegerLookup::Missing {
        value = evalTermValue(state.context, classes, term, 6);
        if value is IntegerLookup::Found {
            return recordEvaluatedSizeIn(stateWithConstant(state, ConstantTerm { id: term, kind: 0, value: (value as IntegerLookup::Found).value }), classes, term);
        };
    };
    return recordEvaluatedSizeIn(state, classes, term);
};

// The size of a list whose elements concrete evaluation can count is
// recorded on the size application of the list, like a known value.
fn recordEvaluatedSize(state: ExecutionState, list: Int) -> ExecutionState {
    classes = unionOf(state.context.equalities);
    return recordEvaluatedSizeIn(state, classes, list);
};

fn recordEvaluatedSizeIn(state: ExecutionState, classes: &HashMap<Int, Int>, list: Int) -> ExecutionState {
    found = evalListSize(state.context, classes, list, 6);
    if found is IntegerLookup::Found {
        value = (found as IntegerLookup::Found).value;
        for appPosition in 0..size(state.context.applications) {
            if get(state.context.applications, appPosition).function = -13 {
                if size(get(state.context.applications, appPosition).arguments) = 1 {
                    if intAt(get(state.context.applications, appPosition).arguments, 0, 0) = list {
                        id = get(state.context.applications, appPosition).id;
                        if integerValue(state.context, id) is IntegerLookup::Missing {
                            return stateWithConstant(state, ConstantTerm { id: id, kind: 0, value: value });
                        };
                        return state;
                    };
                };
            };
        };
        fresh = freshValue(state);
        if fresh is ValueLookup::Found {
            term = (fresh as ValueLookup::Found).term;
            ExecutionState { context: context, locals: locals, templates: templates } = state;
            sized = contextWithConstant(contextWithApplication(context, ApplicationTerm { id: term, function: -13, arguments: push([], list) }), ConstantTerm { id: term, kind: 0, value: value });
            return ExecutionState { context: sized, locals: locals, templates: templates };
        };
    };
    return state;
};

// Every fact that mentions a term is dropped when the term is forgotten.
// Facts learned under an assumption scoped to one term (the havoced index
// of a checked forall, whose guards are assumed for the check) must not
// outlive that assumption: an index whose guards cannot hold would
// otherwise leave the context contradictory and prove everything after.
// Forgetting only removes facts, so it can never prove a new goal.
fn termForgotten(tainted: &List<Int>, term: Int) -> Bool {
    for t in tainted { if t = term { return true; }; };
    return false;
};

fn forgetTerm(context: &ValidatorContext, root: Int) -> ValidatorContext {
    tainted = push([], root);
    for round in 0..size(context.applications) + 1 {
        for appPosition in 0..size(context.applications) {
            app = get(context.applications, appPosition);
            if termForgotten(tainted, app.id) = false {
                hit = false;
                for arg in app.arguments { if termForgotten(tainted, arg) { hit = true; }; };
                if hit { tainted = push(tainted, app.id); };
            };
        };
    };
    applications = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        keep = termForgotten(tainted, app.id) = false;
        for arg in app.arguments { if termForgotten(tainted, arg) { keep = false; }; };
        if keep { applications = push(applications, clone(app)); };
    };
    equalities = [];
    for factPosition in 0..size(context.equalities) {
        fact = get(context.equalities, factPosition);
        if termForgotten(tainted, fact.left) = false { if termForgotten(tainted, fact.right) = false { equalities = push(equalities, clone(fact)); }; };
    };
    orders = [];
    for factPosition in 0..size(context.orders) {
        fact = get(context.orders, factPosition);
        if termForgotten(tainted, fact.smaller) = false { if termForgotten(tainted, fact.greater) = false { orders = push(orders, clone(fact)); }; };
    };
    different = [];
    for factPosition in 0..size(context.different) {
        fact = get(context.different, factPosition);
        if termForgotten(tainted, fact.left) = false { if termForgotten(tainted, fact.right) = false { different = push(different, clone(fact)); }; };
    };
    differences = [];
    for factPosition in 0..size(context.differences) {
        fact = get(context.differences, factPosition);
        if termForgotten(tainted, fact.left) = false { if termForgotten(tainted, fact.right) = false { differences = push(differences, clone(fact)); }; };
    };
    variants = [];
    for factPosition in 0..size(context.variants) {
        fact = get(context.variants, factPosition);
        if termForgotten(tainted, fact.object) = false { variants = push(variants, clone(fact)); };
    };
    constants = [];
    for factPosition in 0..size(context.constants) {
        fact = get(context.constants, factPosition);
        if termForgotten(tainted, fact.id) = false { constants = push(constants, clone(fact)); };
    };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: clone(context.fieldFunctions), constructorFunctions: clone(context.constructorFunctions), constructorFields: clone(context.constructorFields), differences: differences };
};

fn builtinFacts(context: ValidatorContext, function: Int, result: Int, args: &List<Int>) -> ValidatorContext {
    if function = -40 {
        if size(args) = 1 { return forgetTerm(context, get(args, 0)); };
        return context;
    };
    // (a size is at least 0, as an order, so that a size known not to be 0 is
    // more than 0)
    if function = -13 && size(args) = 1 {
        for cPosition in 0..size(context.constants) {
            c = get(context.constants, cPosition);
            if c.kind = 0 && c.value = 0 {
                for oPosition in 0..size(context.orders) {
                    o = get(context.orders, oPosition);
                    if o.smaller = c.id && o.greater = result { return context; };
                };
                return ValidatorContext { orders: push(context.orders, OrderFact { smaller: c.id, greater: result, strict: false }), ..context };
            };
        };
        return context;
    };
    if size(args) != 2 { return context; };
    a = get(args, 0);
    b = get(args, 1);
    if function = -14 {
        return readThroughSequence(context, result, a, b);
    };
    if function = -1 {
        bv = integerValue(context, b);
        if bv is IntegerLookup::Found {
            return addOffsetFacts(context, result, a, (bv as IntegerLookup::Found).value);
        };
        av = integerValue(context, a);
        if av is IntegerLookup::Found {
            return addOffsetFacts(context, result, b, (av as IntegerLookup::Found).value);
        };
        return addSumOrders(context, result, a, b);
    };
    if function = -2 {
        bv = integerValue(context, b);
        if bv is IntegerLookup::Found {
            offset = safeBoundDifference(0, (bv as IntegerLookup::Found).value);
            if offset is SumResult::Sum {
                return addOffsetFacts(context, result, a, (offset as SumResult::Sum).value);
            };
            // result = a - minInt implies a - result <= minInt even though
            // the opposite bound cannot be represented in an Int.
            facts = push(context.differences, DifferenceFact { left: a, right: result, bound: (bv as IntegerLookup::Found).value });
            return ValidatorContext { differences: facts, ..context };
        };
    };
    // Multiplication by zero or one and division by one preserve a known
    // value. The bridge checks the divisor before introducing division.
    if function = -3 {
        av = integerValue(context, a);
        if av is IntegerLookup::Found {
            n = (av as IntegerLookup::Found).value;
            if n = 0 { return ValidatorContext { equalities: push(context.equalities, EqualityFact { left: result, right: a }), ..context }; };
            if n = 1 { return ValidatorContext { equalities: push(context.equalities, EqualityFact { left: result, right: b }), ..context }; };
            bv0 = integerValue(context, b);
            if bv0 is IntegerLookup::Found {
                product = safeProduct(n, (bv0 as IntegerLookup::Found).value);
                if product is SumResult::Sum {
                    constant = ConstantTerm { id: result, kind: 0, value: (product as SumResult::Sum).value };
                    return ValidatorContext { constants: push(context.constants, constant), ..context };
                };
            };
            return addScaleOrders(context, result, b, n);
        };
        bv = integerValue(context, b);
        if bv is IntegerLookup::Found {
            n = (bv as IntegerLookup::Found).value;
            if n = 0 { return ValidatorContext { equalities: push(context.equalities, EqualityFact { left: result, right: b }), ..context }; };
            if n = 1 { return ValidatorContext { equalities: push(context.equalities, EqualityFact { left: result, right: a }), ..context }; };
            if av is IntegerLookup::Found {
                product = safeProduct((av as IntegerLookup::Found).value, n);
                if product is SumResult::Sum {
                    constant = ConstantTerm { id: result, kind: 0, value: (product as SumResult::Sum).value };
                    return ValidatorContext { constants: push(context.constants, constant), ..context };
                };
            };
            return addScaleOrders(context, result, a, n);
        };
    };
    if function = -4 {
        bv = integerValue(context, b);
        if bv is IntegerLookup::Found {
            divisor = (bv as IntegerLookup::Found).value;
            if divisor = 1 {
                return ValidatorContext { equalities: push(context.equalities, EqualityFact { left: result, right: a }), ..context };
            };
            if divisor != 0 {
                av = integerValue(context, a);
                if av is IntegerLookup::Found {
                    dividend = (av as IntegerLookup::Found).value;
                    overflow = false;
                    if dividend = -9223372036854775808 {
                        if divisor = -1 { overflow = true; };
                    };
                    if overflow = false {
                        constant = ConstantTerm { id: result, kind: 0, value: dividend / divisor };
                        return ValidatorContext { constants: push(context.constants, constant), ..context };
                    };
                };
                return addDivisionOrders(context, result, a, b);
            };
        };
        return addDivisionOrders(context, result, a, b);
    };
    if function = -5 {
        bv = integerValue(context, b);
        if bv is IntegerLookup::Found {
            divisor = (bv as IntegerLookup::Found).value;
            if divisor != 0 {
                av = integerValue(context, a);
                if av is IntegerLookup::Found {
                    dividend = (av as IntegerLookup::Found).value;
                    remainder = 0;
                    special = false;
                    if dividend = -9223372036854775808 {
                        if divisor = -1 { special = true; };
                    };
                    if special = false { remainder = dividend % divisor; };
                    constant = ConstantTerm { id: result, kind: 0, value: remainder };
                    return ValidatorContext { constants: push(context.constants, constant), ..context };
                };
                return addRemainderOrders(context, result, b);
            };
        };
        return addRemainderOrders(context, result, b);
    };
    return context;
};

// Apply is restricted to pure functions. The host must encode the operation's
// preconditions as checks before the Apply; unknown or effectful operations
// must be rejected by the host instead of encoded as a pure application.
struct LoopTest { relation: Int, left: ValueRef, right: ValueRef };

impl Clone for LoopTest { };

enum ExecutionStep {
    Assign { local: Int, value: ValueRef },
    Apply { local: Int, result: Int, function: Int, arguments: List<ValueRef> },
    ApplyFresh { local: Int, function: Int, arguments: List<ValueRef> },
    Literal { result: Int, function: Int, arguments: List<ValueRef> },
    Push { local: Int, list: ValueRef, value: ValueRef, zero: ValueRef },
    Last { local: Int, list: ValueRef, zero: ValueRef },
    Set { local: Int, list: ValueRef, index: ValueRef, value: ValueRef },
    Pop { local: Int, list: ValueRef },
    NewArray { local: Int, length: ValueRef, value: ValueRef },
    Havoc { local: Int },
    RequireDefined { value: ValueRef },
    Check { relation: Int, left: ValueRef, right: ValueRef },
    Assume { relation: Int, left: ValueRef, right: ValueRef },
    AssumeVariant { object: ValueRef, family: Int, constructor: Int, matches: Bool },
    RequireVariant { object: ValueRef, family: Int, constructor: Int },
    CheckWithin { inner: ValueRef, outer: ValueRef },
    Proof { step: ProofStep },
    // the path assumes a forall, which saturate uses where a check fails
    AssumeForall { template: ForallTemplate },
};

impl Clone for ExecutionStep { };

// status 0 is success; 1 is an unproved check; 2 is malformed or unsupported.
struct ExecutionResult { status: Int, failedAt: Int, state: ExecutionState };

impl Clone for ExecutionResult { };

fn quietStep(given: &ExecutionStep) -> ExecutionStep {
    if given is ExecutionStep::Check {
        c = given as ExecutionStep::Check;
        if c.relation >= 0 && c.relation <= 3 { return ExecutionStep::Check { relation: c.relation + 10, left: c.left, right: c.right }; };
    };
    return clone(given);
};

fn quietSteps(steps: &List<ExecutionStep>) -> List<ExecutionStep> {
    result = [];
    for s in steps { result = push(result, quietStep(s)); };
    return result;
};

// relation: 0 is equality, 1 disequality, 2 strict less, 3 non-strict less.
// Any other relation code is rejected rather than guessed.
fn localGoal(relation: Int, left: Int, right: Int) -> ValidatorGoal {
    if relation = 0 { return ValidatorGoal::Equal { left: left, right: right }; };
    if relation = 1 { return ValidatorGoal::Different { left: left, right: right }; };
    if relation = 2 { return ValidatorGoal::Less { left: left, right: right }; };
    return ValidatorGoal::AtMost { left: left, right: right };
};

// Only the trusted MIR bridge may add an edge condition as an assumption.
fn assumeRelation(context: ValidatorContext, relation: Int, left: Int, right: Int) -> ValidatorContext {
    if relation = 0 && hasEquality(context.equalities, left, right) { return context; };
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    if relation = 0 { equalities = push(equalities, EqualityFact { left: left, right: right }); };
    if relation = 1 { different = push(different, DisequalityFact { left: left, right: right }); };
    if relation = 2 { orders = push(orders, OrderFact { smaller: left, greater: right, strict: true }); };
    if relation > 2 || relation < 0 { orders = push(orders, OrderFact { smaller: left, greater: right, strict: false }); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

// A comparison result can be copied across blocks before it is branched on.
// Its arguments name the values captured when it was evaluated, so derive the
// relation from those terms rather than from the current local bindings.
fn assumeComparison(context: &ValidatorContext, term: Int, truth: Bool) -> ValidatorContext {
    state = clone(context);
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if sameIn(equalitiesClasses, app.id, term) {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                if app.function = -6 {
                    if truth { state = assumeRelation(state, 0, a, b); } else { state = assumeRelation(state, 1, a, b); };
                };
                if app.function = -7 {
                    if truth { state = assumeRelation(state, 1, a, b); } else { state = assumeRelation(state, 0, a, b); };
                };
                if app.function = -8 {
                    if truth { state = assumeRelation(state, 2, a, b); } else { state = assumeRelation(state, 3, b, a); };
                };
                if app.function = -9 {
                    if truth { state = assumeRelation(state, 3, a, b); } else { state = assumeRelation(state, 2, b, a); };
                };
                if app.function = -10 {
                    if truth { state = assumeRelation(state, 2, b, a); } else { state = assumeRelation(state, 3, a, b); };
                };
                if app.function = -11 {
                    if truth { state = assumeRelation(state, 3, b, a); } else { state = assumeRelation(state, 2, a, b); };
                };
            };
        };
    };
    return state;
};

fn assumeBooleanFact(context: ValidatorContext, left: Int, right: Int) -> ValidatorContext {
    // (the comparisons a literal on either side decides, found before the context changes)
    terms = push([], 0);
    truths = push([], false);
    for cPosition in 0..size(context.constants) {
        if get(context.constants, cPosition).kind = 1 {
            if get(context.constants, cPosition).id = left { terms = push(terms, right); truths = push(truths, get(context.constants, cPosition).value = 1); };
            if get(context.constants, cPosition).id = right { terms = push(terms, left); truths = push(truths, get(context.constants, cPosition).value = 1); };
        };
    };
    state = context;
    for k in 1..size(terms) { state = assumeComparison(state, get(terms, k), boolAt(truths, k, false)); };
    return state;
};

fn sequenceLength(state: &ExecutionState, list: Int) -> ValueLookup {
    equalities = semanticFacts(state.context.equalities, state.context.applications, state.context.constants);
    equalitiesClasses = leastClasses(equalities);
    for appPosition in 0..size(state.context.applications) {
        app = get(state.context.applications, appPosition);
        if app.function = -13 {
            if size(app.arguments) = 1 {
                if sameIn(equalitiesClasses, get(app.arguments, 0), list) {
                    return ValueLookup::Found { term: app.id };
                };
            };
        };
    };
    return ValueLookup::Missing;
};

// Trusted list construction: the new length is the old length plus one,
// and the element at the old length is the appended value. The MIR bridge
// supplies a validated list and a literal zero.
fn pushSequence(initial: &ExecutionState, local: Int, list: Int, value: Int, zero: Int) -> ExecutionResult {
    z = integerValue(initial.context, zero);
    if z is IntegerLookup::Found {
        if (z as IntegerLookup::Found).value != 0 { return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) }; };
    } else { return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) }; };
    state = clone(initial);
    length = sequenceLength(state, list);
    oldLength = zero;
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
    } else {
        new = freshValue(state);
        if new is ValueLookup::Found { oldLength = (new as ValueLookup::Found).term; }
        else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
        app = ApplicationTerm { id: oldLength, function: -13, arguments: push([], list) };
        context = ValidatorContext { applications: push(clone(state.context.applications), app), ..state.context };
        state = ExecutionState { context: context, ..state };
    };
    nonnegative = assumeRelation(state.context, 3, zero, oldLength);
    state = ExecutionState { context: nonnegative, ..state };
    made = freshValue(state);
    result = zero;
    if made is ValueLookup::Found { result = (made as ValueLookup::Found).term; }
    else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
    app = ApplicationTerm { id: result, function: -16, arguments: push(push([], list), value) };
    context = ValidatorContext { applications: push(clone(state.context.applications), app), ..state.context };
    state = ExecutionState { context: context, locals: bindLocal(state.locals, local, result), templates: clone(initial.templates) };
    new = freshValue(state);
    newLength = zero;
    if new is ValueLookup::Found { newLength = (new as ValueLookup::Found).term; }
    else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
    lengthApp = ApplicationTerm { id: newLength, function: -13, arguments: push([], result) };
    elementApp = ApplicationTerm { id: value, function: -14, arguments: push(push([], result), oldLength) };
    apps = push(push(clone(state.context.applications), lengthApp), elementApp);
    // Every recorded read of the old list was checked before it was added.
    // Appending preserves its value at that index.
    equalities = semanticFacts(state.context.equalities, state.context.applications, state.context.constants);
    equalitiesClasses = leastClasses(equalities);
    for previousPosition in 0..size(state.context.applications) {
        previous = get(state.context.applications, previousPosition);
        if previous.function = -14 {
            if size(previous.arguments) = 2 {
                if sameIn(equalitiesClasses, get(previous.arguments, 0), list) {
                    kept = ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), get(previous.arguments, 1)) };
                    apps = push(apps, kept);
                };
            };
        };
    };
    context = ValidatorContext { applications: apps, ..state.context };
    context = addOffsetFacts(context, newLength, oldLength, 1);
    knownLength = integerValue(context, oldLength);
    if knownLength is IntegerLookup::Found {
        increment = safeBoundSum((knownLength as IntegerLookup::Found).value, 1);
        if increment is SumResult::Sum {
            known = ConstantTerm { id: newLength, kind: 0, value: (increment as SumResult::Sum).value };
            context = ValidatorContext { constants: push(context.constants, known), ..context };
        };
    };
    return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: context, ..state } };
};

// Last is translated when the length is known. A nonempty check is still
// required; unknown lengths remain unsupported by this particular encoding.
fn lastSequence(initial: &ExecutionState, local: Int, list: Int, zero: Int) -> ExecutionResult {
    z = integerValue(initial.context, zero);
    if z is IntegerLookup::Found {
        if (z as IntegerLookup::Found).value != 0 { return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) }; };
    } else { return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) }; };
    length = sequenceLength(initial, list);
    if length is ValueLookup::Found {
        lengthTerm = (length as ValueLookup::Found).term;
        if entailsGoal(initial.context, ValidatorGoal::Less { left: zero, right: lengthTerm }) = false {
            return ExecutionResult { status: 1, failedAt: -1, state: clone(initial) };
        };
        value = integerValue(initial.context, lengthTerm);
        if value is IntegerLookup::Found {
            index = safeBoundDifference((value as IntegerLookup::Found).value, 1);
            if index is SumResult::Sum {
                indexValue = (index as SumResult::Sum).value;
                indexTerm = zero;
                known = false;
                for constantPosition in 0..size(initial.context.constants) {
                    constant = get(initial.context.constants, constantPosition);
                    if constant.kind = 0 {
                        if constant.value = indexValue { indexTerm = constant.id; known = true; };
                    };
                };
                state = clone(initial);
                if known = false {
                    symbol = freshValue(state);
                    if symbol is ValueLookup::Found {
                        indexTerm = (symbol as ValueLookup::Found).term;
                        constant = ConstantTerm { id: indexTerm, kind: 0, value: indexValue };
                        context = ValidatorContext { constants: push(clone(state.context.constants), constant), ..state.context };
                        state = ExecutionState { context: context, ..state };
                    } else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
                };
                fresh = freshValue(state);
                if fresh is ValueLookup::Found {
                    result = (fresh as ValueLookup::Found).term;
                    app = ApplicationTerm { id: result, function: -14, arguments: push(push([], list), indexTerm) };
                    withApp = ValidatorContext { applications: push(clone(state.context.applications), app), ..state.context };
                    context = readThroughSequence(withApp, result, list, indexTerm);
                    locals = bindLocal(state.locals, local, result);
                    return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: context, locals: locals, templates: clone(initial.templates) } };
                };
            };
        };
        state = clone(initial);
        oneTerm = zero;
        knownOne = false;
        for constantPosition in 0..size(initial.context.constants) {
            constant = get(initial.context.constants, constantPosition);
            if constant.kind = 0 {
                if constant.value = 1 { oneTerm = constant.id; knownOne = true; };
            };
        };
        if knownOne = false {
            symbol = freshValue(state);
            if symbol is ValueLookup::Found {
                oneTerm = (symbol as ValueLookup::Found).term;
                context = ValidatorContext { constants: push(clone(state.context.constants), ConstantTerm { id: oneTerm, kind: 0, value: 1 }), ..state.context };
                state = ExecutionState { context: context, ..state };
            } else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
        };
        idxFresh = freshValue(state);
        if idxFresh is ValueLookup::Found {
            indexTerm = (idxFresh as ValueLookup::Found).term;
            subApp = ApplicationTerm { id: indexTerm, function: -2, arguments: push(push([], lengthTerm), oneTerm) };
            context = ValidatorContext { applications: push(clone(state.context.applications), subApp), ..state.context };
            context = addOffsetFacts(context, indexTerm, lengthTerm, -1);
            state = ExecutionState { context: context, ..state };
            fresh = freshValue(state);
            if fresh is ValueLookup::Found {
                result = (fresh as ValueLookup::Found).term;
                app = ApplicationTerm { id: result, function: -14, arguments: push(push([], list), indexTerm) };
                withApp = ValidatorContext { applications: push(clone(state.context.applications), app), ..state.context };
                context = readThroughSequence(withApp, result, list, indexTerm);
                locals = bindLocal(state.locals, local, result);
                return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: context, locals: locals, templates: clone(initial.templates) } };
            };
        };
    };
    return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) };
};

// The bridge checks the index first. The update preserves the length and
// known reads at indices that are concretely different from the updated one.
fn setSequence(initial: &ExecutionState, local: Int, list: Int, index: Int, value: Int) -> ExecutionResult {
    length = sequenceLength(initial, list);
    if length is ValueLookup::Found {
        made = freshValue(initial);
        if made is ValueLookup::Found {
            result = (made as ValueLookup::Found).term;
            update = ApplicationTerm { id: result, function: -17, arguments: push(push(push([], list), index), value) };
            sizeApp = ApplicationTerm { id: (length as ValueLookup::Found).term, function: -13, arguments: push([], result) };
            changed = ApplicationTerm { id: value, function: -14, arguments: push(push([], result), index) };
            apps = push(push(push(clone(initial.context.applications), update), sizeApp), changed);
            equalities = semanticFacts(initial.context.equalities, initial.context.applications, initial.context.constants);
            equalitiesClasses = leastClasses(equalities);
            updatedIndex = integerValue(initial.context, index);
            for previousPosition in 0..size(initial.context.applications) {
                previous = get(initial.context.applications, previousPosition);
                if previous.function = -14 {
                    if size(previous.arguments) = 2 {
                        if sameIn(equalitiesClasses, get(previous.arguments, 0), list) {
                            other = integerValue(initial.context, get(previous.arguments, 1));
                            if updatedIndex is IntegerLookup::Found {
                                if other is IntegerLookup::Found {
                                    if (updatedIndex as IntegerLookup::Found).value != (other as IntegerLookup::Found).value {
                                        kept = ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), get(previous.arguments, 1)) };
                                        apps = push(apps, kept);
                                    };
                                };
                            };
                        };
                    };
                };
            };
            context = ValidatorContext { applications: apps, ..clone(initial.context) };
            locals = bindLocal(clone(initial.locals), local, result);
            return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: context, locals: locals, templates: clone(initial.templates) } };
        };
    };
    return ExecutionResult { status: 2, failedAt: -1, state: clone(initial) };
};

// The bridge checks nonemptiness first. For a known length, removing the
// final element preserves every recorded read below the new length.
fn popSequence(initial: &ExecutionState, local: Int, list: Int) -> ExecutionResult {
    length = sequenceLength(initial, list);
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
        value = integerValue(initial.context, oldLength);
        if value is IntegerLookup::Found {
            shortened = safeBoundDifference((value as IntegerLookup::Found).value, 1);
            if shortened is SumResult::Sum {
                newLengthValue = (shortened as SumResult::Sum).value;
                made = freshValue(initial);
                if made is ValueLookup::Found {
                    result = (made as ValueLookup::Found).term;
                    popApp = ApplicationTerm { id: result, function: -18, arguments: push([], list) };
                    context = ValidatorContext { applications: push(clone(initial.context.applications), popApp), ..clone(initial.context) };
                    state = ExecutionState { context: context, locals: bindLocal(clone(initial.locals), local, result), templates: clone(initial.templates) };
                    lengthTerm = oldLength;
                    known = false;
                    for constantPosition in 0..size(state.context.constants) {
                        constant = get(state.context.constants, constantPosition);
                        if constant.kind = 0 {
                            if constant.value = newLengthValue { lengthTerm = constant.id; known = true; };
                        };
                    };
                    if known = false {
                        symbol = freshValue(state);
                        if symbol is ValueLookup::Found {
                            lengthTerm = (symbol as ValueLookup::Found).term;
                            constant = ConstantTerm { id: lengthTerm, kind: 0, value: newLengthValue };
                            context = ValidatorContext { constants: push(clone(state.context.constants), constant), ..state.context };
                            state = ExecutionState { context: context, ..state };
                        } else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
                    };
                    sizeApp = ApplicationTerm { id: lengthTerm, function: -13, arguments: push([], result) };
                    apps = push(clone(state.context.applications), sizeApp);
                    equalities = semanticFacts(initial.context.equalities, initial.context.applications, initial.context.constants);
                    equalitiesClasses = leastClasses(equalities);
                    for previousPosition in 0..size(initial.context.applications) {
                        previous = get(initial.context.applications, previousPosition);
                        if previous.function = -14 {
                            if size(previous.arguments) = 2 {
                                if sameIn(equalitiesClasses, get(previous.arguments, 0), list) {
                                    index = integerValue(initial.context, get(previous.arguments, 1));
                                    if index is IntegerLookup::Found {
                                        i = (index as IntegerLookup::Found).value;
                                        if i >= 0 {
                                            if i < newLengthValue {
                                                kept = ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), get(previous.arguments, 1)) };
                                                apps = push(apps, kept);
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                    context = ValidatorContext { applications: apps, ..state.context };
                    return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: context, ..state } };
                };
            };
        };
    };
    // A length that is not a number: the result is one shorter, as a term
    // (its size is size(list) - 1; the walk has checked size(list) > 0)
    state = clone(initial);
    oldLength = 0;
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
    } else {
        sized = freshValue(state);
        if sized is ValueLookup::Found { oldLength = (sized as ValueLookup::Found).term; } else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
        sizeOfList = ApplicationTerm { id: oldLength, function: -13, arguments: push([], list) };
        state = ExecutionState { context: ValidatorContext { applications: push(clone(state.context.applications), sizeOfList), ..clone(state.context) }, ..state };
    };
    oneTerm = 0;
    haveOne = false;
    for constantPosition in 0..size(state.context.constants) {
        constant = get(state.context.constants, constantPosition);
        if constant.kind = 0 { if constant.value = 1 { oneTerm = constant.id; haveOne = true; }; };
    };
    if haveOne = false {
        symbol = freshValue(state);
        if symbol is ValueLookup::Found {
            oneTerm = (symbol as ValueLookup::Found).term;
            state = ExecutionState { context: ValidatorContext { constants: push(clone(state.context.constants), ConstantTerm { id: oneTerm, kind: 0, value: 1 }), ..clone(state.context) }, ..state };
        } else { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
    };
    made = freshValue(state);
    if made is ValueLookup::Missing { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
    result = (made as ValueLookup::Found).term;
    popApp = ApplicationTerm { id: result, function: -18, arguments: push([], list) };
    state = ExecutionState { context: ValidatorContext { applications: push(clone(state.context.applications), popApp), ..clone(state.context) }, locals: bindLocal(clone(state.locals), local, result), templates: clone(state.templates) };
    shorter = freshValue(state);
    if shorter is ValueLookup::Missing { return ExecutionResult { status: 2, failedAt: -1, state: state }; };
    newLength = (shorter as ValueLookup::Found).term;
    difference = ApplicationTerm { id: newLength, function: -2, arguments: push(push([], oldLength), oneTerm) };
    sizeOfResult = ApplicationTerm { id: newLength, function: -13, arguments: push([], result) };
    apps = push(push(clone(state.context.applications), difference), sizeOfResult);
    return ExecutionResult { status: 0, failedAt: -1, state: ExecutionState { context: ValidatorContext { applications: apps, ..clone(state.context) }, ..state } };
};

// Pure applications with the same function and exact arguments denote the
// same value. Reusing that value avoids growing the context at every read.
fn existingApplication(context: &ValidatorContext, function: Int, args: &List<Int>) -> ValueLookup {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = function {
            if equalArguments(emptyIntMap(), app.arguments, args) {
                return ValueLookup::Found { term: app.id };
            };
        };
    };
    return ValueLookup::Missing;
};

struct NegatedRelation { relation: Int, left: Int, right: Int };

impl Clone for NegatedRelation { };

impl Copy for NegatedRelation { };

fn negateRelation(relation: Int, left: Int, right: Int) -> NegatedRelation {
    if relation = 0 { return NegatedRelation { relation: 1, left: left, right: right }; };
    if relation = 1 { return NegatedRelation { relation: 0, left: left, right: right }; };
    if relation = 2 { return NegatedRelation { relation: 3, left: right, right: left }; };
    return NegatedRelation { relation: 2, left: right, right: left };
};

// The comparison that produced the term, negated when the term has to be
// false. The application keeps the operands from the time of the comparison.
fn relationGoals(context: &ValidatorContext, term: Int, truth: Bool) -> List<ValidatorGoal> {
    goals = [];
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.id = term {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                relation = -1;
                left = a;
                right = b;
                if app.function = -6 { relation = 0; };
                if app.function = -7 { relation = 1; };
                if app.function = -8 { relation = 2; };
                if app.function = -9 { relation = 3; };
                if app.function = -10 { relation = 2; left = b; right = a; };
                if app.function = -11 { relation = 3; left = b; right = a; };
                if relation >= 0 {
                    if truth = false {
                        opposite = negateRelation(relation, left, right);
                        relation = opposite.relation;
                        left = opposite.left;
                        right = opposite.right;
                    };
                    goals = push(goals, localGoal(relation, left, right));
                };
            };
        };
    };
    return goals;
};

// Recognize a boolean directly or through the comparison that produced it.
// The literal is the term for the truth value being asked about, so `truth` and
// `literal` always agree.
fn booleanKnownCached(cache: EntailmentCache, term: Int, literal: Int, truth: Bool) -> CachedAnswer {
    goals = push(relationGoals(cache.plain, term, truth), ValidatorGoal::Equal { left: term, right: literal });
    return entailsAnyCached(cache, goals);
};

fn booleanKnown(context: &ValidatorContext, term: Int, literal: Int, truth: Bool) -> Bool {
    return booleanKnownCached(entailmentCache(context), term, literal, truth).holds;
};

// A boolean term that the context knows to be a literal: kind 1 is a boolean,
// and its value is 0 or 1.
fn booleanLiteral(context: &ValidatorContext, term: Int) -> IntegerLookup {
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.id = term {
            if constant.kind = 1 { return IntegerLookup::Found { value: constant.value }; };
        };
    };
    return IntegerLookup::Missing;
};

// The term for the boolean constant with this value, if the program has one.
// A check against the other value has to name its own literal.
fn booleanConstant(context: &ValidatorContext, value: Int) -> ValueLookup {
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 1 {
            if constant.value = value { return ValueLookup::Found { term: constant.id }; };
        };
    };
    return ValueLookup::Missing;
};

// A disequality asks the term for the opposite of the literal it was compared
// with, so the literal itself cannot answer it. The producing comparison still
// can; a plain constant needs the term for that value, which the program may
// not mention at all.
fn booleanOpposite(context: &ValidatorContext, term: Int, truth: Bool) -> Bool {
    goals = relationGoals(context, term, truth);
    value = 0;
    if truth { value = 1; };
    literal = booleanConstant(context, value);
    if literal is ValueLookup::Found {
        goals = push(goals, ValidatorGoal::Equal { left: term, right: (literal as ValueLookup::Found).term });
    };
    return entailsAnyCached(entailmentCache(context), goals).holds;
};

// `term` has to be the literal `value` when the operands are equal and the
// other value when they differ, so a disequality asks for the opposite
// literal rather than reusing the one it was compared with.
fn booleanAgainstLiteral(context: &ValidatorContext, term: Int, literal: Int, value: Int, relation: Int) -> Bool {
    if value != 0 {
        if value != 1 { return false; };
    };
    if relation = 0 {
        if value = 1 { return booleanKnown(context, term, literal, true); };
        return booleanKnown(context, term, literal, false);
    };
    if value = 0 { return booleanOpposite(context, term, true); };
    return booleanOpposite(context, term, false);
};

// A check of a boolean term against a literal is the comparison that produced
// the term, so `below = true` follows from `below` being `x < 6` with x < 6.
// The relation itself stays with the terms that were compared, not with the
// current values of the locals.
fn booleanCheck(context: &ValidatorContext, relation: Int, left: Int, right: Int) -> Bool {
    if relation != 0 {
        if relation != 1 { return false; };
    };
    a = booleanLiteral(context, left);
    if a is IntegerLookup::Found {
        return booleanAgainstLiteral(context, right, left, (a as IntegerLookup::Found).value, relation);
    };
    b = booleanLiteral(context, right);
    if b is IntegerLookup::Found {
        return booleanAgainstLiteral(context, left, right, (b as IntegerLookup::Found).value, relation);
    };
    return false;
};


fn commonTemplates(left: &List<ForallTemplate>, right: &List<ForallTemplate>) -> List<ForallTemplate> {
    kept = noTemplates();
    for tPosition in 0..size(left) {
        t = get(left, tPosition);
        both = false;
        for u in right { if u.id = t.id { both = true; }; };
        if both { kept = push(kept, clone(t)); };
    };
    return kept;
};

// Saturation: the foralls the path assumed, and the frames of set and push,
// are instantiated at the reads (get(L, k)) of the lists they speak of, and
// the instances whose guards hold become facts, in rounds until none is new.
// A term an instance makes has the generation of its index plus one (the
// terms the state had are 0), and only indexes of generation 1 or less are
// used, so a forall whose instance reads at a new index (the node a link
// leads to) is used there once and does not feed itself. An instance missing
// exactly one guard is blocked on it: a case split on that guard may let it
// be used (proveBySaturation).
struct ClosedFacts { contradictory: Bool, reps: List<Representative>, edges: List<DifferenceFact>, different: List<DisequalityFact> };

impl Clone for ClosedFacts { };

struct DoneKey { kind: Int, owner: Int, index: Int };

impl Clone for DoneKey { };

fn noDoneKeys() -> List<DoneKey> { return []; };

struct TermRelation { relation: Int, left: Int, right: Int };

impl Clone for TermRelation { };

struct BlockedGuard { relation: Int, left: Int, right: Int, index: Int };

impl Clone for BlockedGuard { };

fn noBlocked() -> List<BlockedGuard> { return []; };

fn noClosed() -> List<ClosedFacts> { return []; };


struct SatInstance { key: DoneKey, guards: List<TermRelation>, body: TermRelation };

impl Clone for SatInstance { };

// (closed: the closure of the state's facts, when it is known)
struct Saturation { state: ExecutionState, births: HashMap<Int, Int>, done: List<DoneKey>, blocked: List<BlockedGuard>, closed: List<ClosedFacts> };

impl Clone for Saturation { };

fn knownClosure(given: &Saturation) -> ClosedFacts {
    if size(given.closed) > 0 { return clone(get(given.closed, 0)); };
    return closedFacts(given.state.context);
};

struct RoundResult { saturation: Saturation, accepted: Int };

impl Clone for RoundResult { };

fn generationOf(births: &HashMap<Int, Int>, term: Int) -> Int {
    if births.contains(term) { return births.lookup(term, 0); };
    return 0;
};

fn keyDone(keys: &List<DoneKey>, closed: &ClosedFacts, kind: Int, owner: Int, index: Int) -> Bool {
    for keyPosition in 0..size(keys) {
        key = get(keys, keyPosition);
        if key.kind = kind && key.owner = owner {
            if sameClass(closed, key.index, index) { return true; };
        };
    };
    return false;
};

// Whether each node of a template is made of its index
fn templateDepends(template: &ForallTemplate) -> List<Bool> {
    result = [];
    for nodePosition in 0..size(template.nodes) {
        node = get(template.nodes, nodePosition);
        d = false;
        if node.kind = 0 { d = true; };
        if node.kind = 2 {
            for aPosition in 0..size(node.arguments) {
                a = get(node.arguments, aPosition);
                if a >= 0 && a < size(result) { if get(result, a) { d = true; }; };
            };
        };
        result = push(result, d);
    };
    return result;
};

// The term of an application, made (as the next fresh term) if the state
// has none, with what its builtin is known to give
struct StateTerm { state: ExecutionState, term: Int, created: Bool, next: Int };

impl Clone for StateTerm { };

fn applicationTerm(given: &ExecutionState, function: Int, args: List<Int>, next: Int) -> StateTerm {
    state = clone(given);
    existing = existingApplication(state.context, function, args);
    if existing is ValueLookup::Found {
        return StateTerm { state: state, term: (existing as ValueLookup::Found).term, created: false, next: next };
    };
    apps = push(clone(state.context.applications), ApplicationTerm { id: next, function: function, arguments: clone(args) });
    withApp = ValidatorContext { applications: apps, ..clone(state.context) };
    context = builtinFacts(withApp, function, next, args);
    return StateTerm { state: ExecutionState { context: context, ..state }, term: next, created: true, next: next - 1 };
};

// The terms of a template's nodes at an index: those made of the index
// (dependent) from the others' terms, given; or those not made of it. The
// terms made are of the generation given.
struct NodeTerms { state: ExecutionState, terms: List<Int>, found: Bool, next: Int, births: HashMap<Int, Int> };

impl Clone for NodeTerms { };

fn templateTerms(state: &ExecutionState, template: &ForallTemplate, index: Int, given: &List<Int>, depends: &List<Bool>, dependent: Bool, next: Int, births: &HashMap<Int, Int>, generation: Int) -> NodeTerms {
    current = clone(state);
    counter = next;
    born = clone(births);
    terms = [];
    found = true;
    for i in 0..size(template.nodes) {
        node = get(template.nodes, i);
        term = 0;
        if boolAt(depends, i, false) = dependent {
            if node.kind = 0 { term = index; };
            if node.kind = 1 {
                v = resolveValue(current, node.value);
                if v is ValueLookup::Found { term = (v as ValueLookup::Found).term; } else { found = false; };
            };
            if node.kind = 2 && found {
                args = [];
                for a in node.arguments { if a >= 0 && a < size(terms) { args = push(args, get(terms, a)); } else { found = false; }; };
                if found {
                    made = applicationTerm(current, node.function, args, counter);
                    current = made.state;
                    counter = made.next;
                    term = made.term;
                    if made.created { born = born.insert(term, generation); };
                };
            };
        } else {
            // (the free pass leaves the dependent nodes for the index's pass)
            if dependent {
                if i < size(given) { term = get(given, i); } else { found = false; };
            };
        };
        terms = push(terms, term);
    };
    return NodeTerms { state: current, terms: terms, found: found, next: counter, births: born };
};

// What a round of saturation carries from one of its passes to the next: the state it adds terms to, the generations
// of the terms, the instances made and the keys they are made for, and the next free term
struct SatWork { state: ExecutionState, births: HashMap<Int, Int>, pending: List<DoneKey>, instances: List<SatInstance>, nextTerm: Int };

impl Clone for SatWork { };

fn saturationRound(given: &Saturation) -> RoundResult {
    state = clone(given.state);
    births = clone(given.births);
    done = clone(given.done);
    start = knownClosure(given);
    gets = [];
    writes = [];
    for appPosition in 0..size(state.context.applications) {
        app = get(state.context.applications, appPosition);
        if app.function = -14 && size(app.arguments) = 2 {
            if generationOf(births, get(app.arguments, 1)) <= 1 { gets = push(gets, clone(app)); };
        };
        if app.function = -17 && size(app.arguments) = 3 { writes = push(writes, clone(app)); };
        if app.function = -16 && size(app.arguments) = 2 { writes = push(writes, clone(app)); };
    };
    pending = noDoneKeys();
    instances = [];
    nextTerm = leastTermInUse(state) - 1;
    sat = SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm };
    sat = saturateTemplates(sat, start, gets, writes, done);
    sat = saturateRangeFacts(sat, start, gets, writes, done);
    sat = saturateFrames(sat, start, gets, writes, done);
    SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm } = sat;
    // (a guard is asked of the closure of the facts alone, as a solver would:
    // the slower heuristics of entailsGoal are for the goal)
    closed = clone(start);
    context = clone(state.context);
    accepted = 0;
    blocked = noBlocked();
    for instPosition in 0..size(instances) {
        inst = get(instances, instPosition);
        failing = 0;
        missing = TermRelation { relation: 0, left: 0, right: 0 };
        for grPosition in 0..size(inst.guards) {
            gr = get(inst.guards, grPosition);
            if failing < 2 {
                if closedHolds(closed, gr.relation, gr.left, gr.right) = false { failing = failing + 1; missing = clone(gr); };
            };
        };
        if failing = 0 {
            context = assumeRelation(context, inst.body.relation, inst.body.left, inst.body.right);
            if inst.body.relation = 0 { context = assumeBooleanFact(context, inst.body.left, inst.body.right); };
            done = push(done, clone(inst.key));
            accepted = accepted + 1;
        };
        if failing = 1 && missing.left != missing.right {
            if sameClass(closed, missing.left, missing.right) = false {
                blocked = push(blocked, BlockedGuard { relation: missing.relation, left: missing.left, right: missing.right, index: inst.key.index });
            };
        };
    };
    after = closedFacts(context);
    next = Saturation { state: ExecutionState { context: context, ..state }, births: births, done: done, blocked: blocked, closed: push([], after) };
    return RoundResult { saturation: next, accepted: accepted };
};

fn saturateTemplates(sat: SatWork, start: &ClosedFacts, gets: &List<ApplicationTerm>, writes: &List<ApplicationTerm>, done: &List<DoneKey>) -> SatWork {
    SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm } = sat;
    templates = clone(state.templates);
    count = size(templates);
    for back in 0..count {
        if back < 16 {
            template = clone(get(templates, count - 1 - back));
            depends = templateDepends(template);
            free = templateTerms(state, template, 0, [], depends, false, nextTerm, births, 0);
            freeTerms = clone(free.terms);
            freeFound = free.found;
            nextTerm = free.next;
            state = free.state;
            births = free.births;
            if freeFound {
                for i in 0..size(template.nodes) {
                    node = get(template.nodes, i);
                    if node.kind = 2 && node.function = -14 && size(node.arguments) = 2 {
                        listNode = get(node.arguments, 0);
                        indexNode = get(node.arguments, 1);
                        indexIsTheIndex = false;
                        if indexNode >= 0 && indexNode < size(template.nodes) { indexIsTheIndex = get(template.nodes, indexNode).kind = 0; };
                        if indexIsTheIndex && boolAt(depends, listNode, true) = false {
                            lt = intAt(freeTerms, listNode, 0);
                            for gPosition in 0..size(gets) {
                                g = get(gets, gPosition);
                                onList = intAt(g.arguments, 0, 0) = lt;
                                if onList = false { onList = sameClass(start, intAt(g.arguments, 0, 0), lt); };
                                if onList && size(instances) < 240 {
                                    k = intAt(g.arguments, 1, 0);
                                    if keyDone(done, start, 0, template.id, k) = false && keyDone(pending, start, 0, template.id, k) = false {
                                        pending = push(pending, DoneKey { kind: 0, owner: template.id, index: k });
                                        generation = generationOf(births, k) + 1;
                                        made = templateTerms(state, template, k, freeTerms, depends, true, nextTerm, births, generation);
                                        madeTerms = clone(made.terms);
                                        madeFound = made.found;
                                        nextTerm = made.next;
                                        state = made.state;
                                        births = made.births;
                                        if madeFound {
                                            guards = [];
                                            for grPosition in 0..size(template.guards) {
                                                gr = get(template.guards, grPosition);
                                                guards = push(guards, TermRelation { relation: gr.relation, left: intAt(madeTerms, gr.left, 0), right: intAt(madeTerms, gr.right, 0) });
                                            };
                                            instances = push(instances, SatInstance { key: DoneKey { kind: 0, owner: template.id, index: k }, guards: guards, body: TermRelation { relation: template.body.relation, left: intAt(madeTerms, template.body.left, 0), right: intAt(madeTerms, template.body.right, 0) } });
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm };
};

fn saturateRangeFacts(sat: SatWork, start: &ClosedFacts, gets: &List<ApplicationTerm>, writes: &List<ApplicationTerm>, done: &List<DoneKey>) -> SatWork {
    SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm } = sat;
    // (a fact that two lists agree over a range, get(a, base + j) = get(b, j)
    // for lo <= j < hi, is used at the reads of either list like a forall)
    for fact in state.context.applications {
        if fact.function = -30 && size(fact.arguments) = 5 {
            fa = get(fact.arguments, 0);
            fb = get(fact.arguments, 1);
            lo = get(fact.arguments, 2);
            hi = get(fact.arguments, 3);
            base = get(fact.arguments, 4);
            baseZero = false;
            bv = integerValue(state.context, base);
            if bv is IntegerLookup::Found { if (bv as IntegerLookup::Found).value = 0 { baseZero = true; }; };
            for gPosition in 0..size(gets) {
                g = get(gets, gPosition);
                k = intAt(g.arguments, 1, 0);
                for side in 0..2 {
                    onSide = false;
                    if side = 0 { onSide = sameClass(start, intAt(g.arguments, 0, 0), fb); };
                    if side = 1 { onSide = sameClass(start, intAt(g.arguments, 0, 0), fa); };
                    if onSide && size(instances) < 240 {
                        if keyDone(done, start, 2 + side, fact.id, k) = false && keyDone(pending, start, 2 + side, fact.id, k) = false {
                            pending = push(pending, DoneKey { kind: 2 + side, owner: fact.id, index: k });
                            generation = generationOf(births, k) + 1;
                            // (the index in the other list, and the index of the range)
                            otherIndex = k;
                            rangeIndex = k;
                            if baseZero = false {
                                function = -1;
                                if side = 1 { function = -2; };
                                shifted = applicationTerm(state, function, push(push([], k), base), nextTerm);
                                if shifted.created { births = births.insert(shifted.term, generation); };
                                nextTerm = shifted.next;
                                if side = 0 { otherIndex = shifted.term; } else { rangeIndex = shifted.term; otherIndex = shifted.term; };
                                state = shifted.state;
                                if shifted.created {
                                    offsetContext = state.context;
                                    if side = 0 { offsetContext = addSumOrders(offsetContext, otherIndex, k, base); };
                                    state = ExecutionState { context: offsetContext, ..state };
                                };
                            };
                            otherList = fa;
                            if side = 1 { otherList = fb; };
                            read = applicationTerm(state, -14, push(push([], otherList), otherIndex), nextTerm);
                            readTerm = read.term;
                            if read.created { births = births.insert(readTerm, generation); };
                            nextTerm = read.next;
                            state = read.state;
                            guards = push(push([], TermRelation { relation: 3, left: lo, right: rangeIndex }), TermRelation { relation: 2, left: rangeIndex, right: hi });
                            instances = push(instances, SatInstance { key: DoneKey { kind: 2 + side, owner: fact.id, index: k }, guards: guards, body: TermRelation { relation: 0, left: g.id, right: readTerm } });
                        };
                    };
                };
            };
        };
    };
    return SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm };
};

fn saturateFrames(sat: SatWork, start: &ClosedFacts, gets: &List<ApplicationTerm>, writes: &List<ApplicationTerm>, done: &List<DoneKey>) -> SatWork {
    SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm } = sat;
    // (the frames: a read of set(l, p, v) at k is the read of l at k when
    // 0 <= k < size(l) and k != p; of push(l, x), when 0 <= k < size(l))
    zero = constantTermWithValue(state.context, 0);
    if zero is ValueLookup::Found {
        z = (zero as ValueLookup::Found).term;
        for gPosition in 0..size(gets) {
            g = get(gets, gPosition);
            k = intAt(g.arguments, 1, 0);
            for wPosition in 0..size(writes) {
                w = get(writes, wPosition);
                onWrite = w.id = intAt(g.arguments, 0, 0);
                if onWrite = false { onWrite = sameClass(start, w.id, intAt(g.arguments, 0, 0)); };
                if onWrite && size(instances) < 240 {
                    if keyDone(done, start, 1, w.id, k) = false && keyDone(pending, start, 1, w.id, k) = false {
                        pending = push(pending, DoneKey { kind: 1, owner: w.id, index: k });
                        inner = intAt(w.arguments, 0, 0);
                        generation = generationOf(births, k) + 1;
                        sized = applicationTerm(state, -13, push([], inner), nextTerm);
                        sizeTerm = sized.term;
                        if sized.created { births = births.insert(sizeTerm, generation); };
                        sizedNext = sized.next;
                        read = applicationTerm(sized.state, -14, push(push([], inner), k), sizedNext);
                        readTerm = read.term;
                        if read.created { births = births.insert(readTerm, generation); };
                        nextTerm = read.next;
                        state = read.state;
                        guards = push(push([], TermRelation { relation: 3, left: z, right: k }), TermRelation { relation: 2, left: k, right: sizeTerm });
                        if w.function = -17 { guards = push(guards, TermRelation { relation: 1, left: k, right: intAt(w.arguments, 1, 0) }); };
                        instances = push(instances, SatInstance { key: DoneKey { kind: 1, owner: w.id, index: k }, guards: guards, body: TermRelation { relation: 0, left: g.id, right: readTerm } });
                    };
                };
            };
        };
    };
    return SatWork { state: state, births: births, pending: pending, instances: instances, nextTerm: nextTerm };
};

// The closure of a context's facts, with its classes and its differences
// between them made once, for the many questions a saturation round asks
fn closedFacts(context: &ValidatorContext) -> ClosedFacts {
    analysis = analyzeContext(context);
    reps = equalityRepresentatives(analysis.equalities);
    edges = canonicalDifferences(reps, analysis.differences);
    different = [];
    for d in context.different { different = push(different, DisequalityFact { left: representativeOf(reps, d.left), right: representativeOf(reps, d.right) }); };
    return ClosedFacts { contradictory: analysis.contradictory, reps: reps, edges: edges, different: different };
};

fn sameClass(closed: &ClosedFacts, left: Int, right: Int) -> Bool {
    if left = right { return true; };
    return representativeOf(closed.reps, left) = representativeOf(closed.reps, right);
};

fn closedDifference(closed: &ClosedFacts, left: Int, right: Int, bound: Int) -> Bool {
    return canonicalHasDifference(closed.edges, representativeOf(closed.reps, left), representativeOf(closed.reps, right), bound);
};

fn closedHolds(closed: &ClosedFacts, relation: Int, left: Int, right: Int) -> Bool {
    if closed.contradictory { return true; };
    if relation = 0 {
        if sameClass(closed, left, right) { return true; };
        if closedDifference(closed, left, right, 0) { return closedDifference(closed, right, left, 0); };
        return false;
    };
    if relation = 1 {
        if closedDifference(closed, left, right, -1) { return true; };
        if closedDifference(closed, right, left, -1) { return true; };
        l = representativeOf(closed.reps, left);
        r = representativeOf(closed.reps, right);
        for dPosition in 0..size(closed.different) {
            d = get(closed.different, dPosition);
            if d.left = l && d.right = r { return true; };
            if d.left = r && d.right = l { return true; };
        };
        return false;
    };
    if relation = 2 { return closedDifference(closed, left, right, -1); };
    return closedDifference(closed, left, right, 0);
};

// A case's context with the instances of the path's foralls that hold in it
fn withInstances(state: &ExecutionState, context: ValidatorContext) -> ValidatorContext {
    if size(state.templates) = 0 { return context; };
    saturated = saturate(Saturation { state: ExecutionState { context: context, ..clone(state) }, births: emptyIntMap(), done: noDoneKeys(), blocked: noBlocked(), closed: noClosed() });
    return saturated.state.context;
};

fn saturate(given: &Saturation) -> Saturation {
    current = clone(given);
    going = true;
    for round in 0..12 {
        if going {
            outcome = saturationRound(current);
            current = outcome.saturation;
            if outcome.accepted = 0 { going = false; };
        };
    };
    return current;
};

// The indexes of the reads a goal is made of, four levels down
fn goalReadIndexes(context: &ValidatorContext, closed: &ClosedFacts, left: Int, right: Int) -> List<Int> {
    near = push(push([], left), right);
    indexes = [];
    for level in 0..4 {
        grown = clone(near);
        for appPosition in 0..size(context.applications) {
            app = get(context.applications, appPosition);
            if size(grown) < 96 {
                isNear = false;
                for tPosition in 0..size(near) {
                    t = get(near, tPosition);
                    if isNear = false { if sameClass(closed, app.id, t) { isNear = true; }; };
                };
                if isNear {
                    for a in app.arguments { if containsValue(grown, a) = false { grown = push(grown, a); }; };
                    if app.function = -14 && size(app.arguments) = 2 {
                        if containsValue(indexes, get(app.arguments, 1)) = false { indexes = push(indexes, get(app.arguments, 1)); };
                    };
                };
            };
        };
        near = grown;
    };
    return indexes;
};

// relation(left, right) holds of the saturation, or of each case of a guard
// that blocked an instance (one guard a level, those at the indexes the goal
// reads first), within a depth and a budget of saturations
fn proveBySaturation(given: &Saturation, relation: Int, left: Int, right: Int, depth: Int, budget: Int, splits: &List<BlockedGuard>) -> SplitResult [{ affirm depth >= 0; }] [{ }] shrinks depth {
    if budget <= 0 { return SplitResult { holds: false, used: 0 }; };
    saturated = saturate(given);
    used = 1;
    closed = knownClosure(saturated);
    if closed.contradictory { return SplitResult { holds: true, used: used }; };
    if closedHolds(closed, relation, left, right) { return SplitResult { holds: true, used: used }; };
    indexes = goalReadIndexes(saturated.state.context, closed, left, right);
    chosen = -1;
    firstFresh = -1;
    for i in 0..size(saturated.blocked) {
        bg = get(saturated.blocked, i);
        fresh = true;
        for spPosition in 0..size(splits) {
            sp = get(splits, spPosition);
            if sp.left = bg.left && sp.right = bg.right { fresh = false; };
            if sp.left = bg.right && sp.right = bg.left { fresh = false; };
        };
        if fresh {
            if firstFresh < 0 { firstFresh = i; };
            if chosen < 0 {
                relevant = false;
                for tPosition in 0..size(indexes) {
                    t = get(indexes, tPosition);
                    if relevant = false { if sameClass(closed, t, bg.index) { relevant = true; }; };
                };
                if relevant { chosen = i; };
            };
        };
    };
    if chosen < 0 { chosen = firstFresh; };
    // (where no case is left to split, the goal is asked with every heuristic)
    if chosen < 0 || depth <= 0 {
        if entailsGoal(saturated.state.context, localGoal(relation, left, right)) { return SplitResult { holds: true, used: used }; };
        if relation <= 1 {
            if booleanCheck(saturated.state.context, relation, left, right) { return SplitResult { holds: true, used: used }; };
        };
        return SplitResult { holds: false, used: used };
    };
    if chosen >= size(saturated.blocked) { return SplitResult { holds: false, used: used }; };
    guard = clone(get(saturated.blocked, chosen));
    cases = [];
    if guard.relation = 1 {
        cases = push(push(cases, TermRelation { relation: 0, left: guard.left, right: guard.right }), TermRelation { relation: 1, left: guard.left, right: guard.right });
    } else {
        cases = push(push(push(cases, TermRelation { relation: 2, left: guard.left, right: guard.right }), TermRelation { relation: 0, left: guard.left, right: guard.right }), TermRelation { relation: 2, left: guard.right, right: guard.left });
    };
    deeperSplits = push(clone(splits), clone(guard));
    allHold = true;
    for cPosition in 0..size(cases) {
        c = get(cases, cPosition);
        if allHold {
            caseContext = assumeRelation(clone(saturated.state.context), c.relation, c.left, c.right);
            if c.relation = 0 { caseContext = assumeBooleanFact(caseContext, c.left, c.right); };
            caseSat = Saturation { state: ExecutionState { context: caseContext, ..clone(saturated.state) }, births: clone(saturated.births), done: clone(saturated.done), blocked: noBlocked(), closed: noClosed() };
            r = proveBySaturation(caseSat, relation, left, right, depth - 1, budget - used, deeperSplits);
            used = used + r.used;
            if r.holds = false { allHold = false; };
        };
    };
    return SplitResult { holds: allHold, used: used };
};

// A closure the checks of a block share. It is made from the facts of one
// state, and a later state of the block has those facts and more as long as
// every step between only adds facts and binds locals (addsFactsOnly), so a
// goal it proves holds there too; a goal it cannot prove is asked again of
// the facts there are now. Any other step (a proof step, the application that
// forgets a term) drops it.
enum SharedEntailment { Missing, Found { cache: EntailmentCache } };

impl Clone for SharedEntailment { };

struct CheckedStep { result: ExecutionResult, shared: SharedEntailment };

impl Clone for CheckedStep { };

// The steps of a block in order, as far as the first that fails (a step of a kind not known fails as unsupported)
fn executeSteps(initial: ExecutionState, steps: &List<ExecutionStep>) -> ExecutionResult {
    state = initial;
    shared = SharedEntailment::Missing;
    for i in 0..size(steps) {
        if get(steps, i) is ExecutionStep::Check {
            checked = stepCheckShared(state, get(steps, i), i, shared);
            CheckedStep { result: result, shared: after } = checked;
            if result.status != 0 { return result; };
            state = result.state;
            shared = after;
        } else {
            before = contextSizes(state.context);
            result = executeStep(state, get(steps, i), i);
            if result.status != 0 { return result; };
            state = result.state;
            // (and, should a step ever drop a fact, a list that got shorter drops it too)
            if addsFactsOnly(get(steps, i)) = false || shrank(before, contextSizes(state.context)) { shared = SharedEntailment::Missing; };
        };
    };
    return ExecutionResult { status: 0, failedAt: -1, state: state };
};

fn contextSizes(c: &ValidatorContext) -> List<Int> {
    return push(push(push(push(push(push(push([], size(c.equalities)), size(c.applications)), size(c.constants)), size(c.orders)), size(c.different)), size(c.variants)), size(c.differences));
};

fn shrank(before: &List<Int>, after: &List<Int>) -> Bool {
    for k in 0..size(before) { if intAt(before, k, 0) > intAt(after, k, 0) { return true; }; };
    return false;
};

fn addsFactsOnly(step: &ExecutionStep) -> Bool {
    // (an application of -40 forgets what is known of a term)
    if step is ExecutionStep::Apply { return (step as ExecutionStep::Apply).function != -40; };
    if step is ExecutionStep::ApplyFresh { return (step as ExecutionStep::ApplyFresh).function != -40; };
    if step is ExecutionStep::Literal { return (step as ExecutionStep::Literal).function != -40; };
    if step is ExecutionStep::Assign { return true; };
    if step is ExecutionStep::Push || step is ExecutionStep::Last || step is ExecutionStep::Set || step is ExecutionStep::Pop || step is ExecutionStep::NewArray { return true; };
    if step is ExecutionStep::Havoc || step is ExecutionStep::RequireDefined || step is ExecutionStep::Check || step is ExecutionStep::Assume { return true; };
    if step is ExecutionStep::AssumeVariant || step is ExecutionStep::RequireVariant || step is ExecutionStep::CheckWithin || step is ExecutionStep::AssumeForall { return true; };
    return false;
};

fn executeStep(state: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    if step is ExecutionStep::Assign { return stepAssign(state, step, i); };
    if step is ExecutionStep::Apply { return stepApply(state, step, i); };
    if step is ExecutionStep::Literal { return stepLiteral(state, step, i); };
    if step is ExecutionStep::ApplyFresh { return stepApplyFresh(state, step, i); };
    if step is ExecutionStep::Push { return stepPush(state, step, i); };
    if step is ExecutionStep::Last { return stepLast(state, step, i); };
    if step is ExecutionStep::Set { return stepSet(state, step, i); };
    if step is ExecutionStep::Pop { return stepPop(state, step, i); };
    if step is ExecutionStep::NewArray { return stepNewArray(state, step, i); };
    if step is ExecutionStep::Havoc { return stepHavoc(state, step, i); };
    if step is ExecutionStep::RequireDefined { return stepRequireDefined(state, step, i); };
    if step is ExecutionStep::Check { return stepCheck(state, step, i); };
    if step is ExecutionStep::AssumeForall { return stepAssumeForall(state, step, i); };
    if step is ExecutionStep::Assume { return stepAssume(state, step, i); };
    if step is ExecutionStep::CheckWithin { return stepCheckWithin(state, step, i); };
    if step is ExecutionStep::AssumeVariant { return stepAssumeVariant(state, step, i); };
    if step is ExecutionStep::RequireVariant { return stepRequireVariant(state, step, i); };
    if step is ExecutionStep::Proof { return stepProof(state, step, i); };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepAssign(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Assign {
        assign = step as ExecutionStep::Assign;
        value = resolveValue(state, assign.value);
        if value is ValueLookup::Found {
            locals = bindLocal(state.locals, assign.local, (value as ValueLookup::Found).term);
            state = ExecutionState { locals: locals, ..state };
        } else {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepApply(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Apply {
        apply = step as ExecutionStep::Apply;
        args = resolveArguments(state, apply.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            if termInUse(state, apply.result) { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            if apply.result = apply.function { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            if containsValue(terms, apply.result) { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            ExecutionState { context: applyContext, locals: applyLocals, templates: applyTemplates } = state;
            context = builtinFacts(contextWithApplication(applyContext, ApplicationTerm { id: apply.result, function: apply.function, arguments: clone(terms) }), apply.function, apply.result, terms);
            state = recordEvaluatedValue(ExecutionState { context: context, locals: bindLocal(applyLocals, apply.local, apply.result), templates: applyTemplates }, apply.result);
        } else {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

// (what a list or array literal is, the same term everywhere: known
// again where a block names it, and nothing new where it is known)
fn stepLiteral(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Literal {
        literal = step as ExecutionStep::Literal;
        args = resolveArguments(state, literal.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            known = false;
            for aPosition in 0..size(state.context.applications) {
                a = get(state.context.applications, aPosition);
                if a.id = literal.result && a.function = literal.function && a.arguments = terms { known = true; };
            };
            if known = false {
                ExecutionState { context: literalContext, locals: literalLocals, templates: literalTemplates } = state;
                context = builtinFacts(contextWithApplication(literalContext, ApplicationTerm { id: literal.result, function: literal.function, arguments: clone(terms) }), literal.function, literal.result, terms);
                state = recordEvaluatedValue(ExecutionState { context: context, locals: literalLocals, templates: literalTemplates }, literal.result);
            };
        } else {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepApplyFresh(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::ApplyFresh {
        apply = step as ExecutionStep::ApplyFresh;
        args = resolveArguments(state, apply.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            existing = existingApplication(state.context, apply.function, terms);
            if existing is ValueLookup::Found {
                locals = bindLocal(state.locals, apply.local, (existing as ValueLookup::Found).term);
                state = ExecutionState { locals: locals, ..state };
            } else {
              fresh = freshValue(state);
              if fresh is ValueLookup::Found {
                resultId = (fresh as ValueLookup::Found).term;
                if resultId = apply.function { return ExecutionResult { status: 2, failedAt: i, state: state }; };
                if containsValue(terms, resultId) { return ExecutionResult { status: 2, failedAt: i, state: state }; };
                ExecutionState { context: freshContext, locals: freshLocals, templates: freshTemplates } = state;
                context = builtinFacts(contextWithApplication(freshContext, ApplicationTerm { id: resultId, function: apply.function, arguments: clone(terms) }), apply.function, resultId, terms);
                state = recordEvaluatedValue(ExecutionState { context: context, locals: bindLocal(freshLocals, apply.local, resultId), templates: freshTemplates }, resultId);
              } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepPush(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Push {
        pushStep = step as ExecutionStep::Push;
        list = resolveValue(state, pushStep.list);
        value = resolveValue(state, pushStep.value);
        zero = resolveValue(state, pushStep.zero);
        if list is ValueLookup::Found {
            if value is ValueLookup::Found {
                if zero is ValueLookup::Found {
                    pushed = pushSequence(state, pushStep.local, (list as ValueLookup::Found).term, (value as ValueLookup::Found).term, (zero as ValueLookup::Found).term);
                    if pushed.status != 0 { return ExecutionResult { status: pushed.status, failedAt: i, state: pushed.state }; };
                    state = pushed.state;
                    madeTerm = resolveValue(state, ValueRef::Local { local: pushStep.local });
                    if madeTerm is ValueLookup::Found { state = recordEvaluatedSize(state, (madeTerm as ValueLookup::Found).term); };
                } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepLast(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Last {
        last = step as ExecutionStep::Last;
        list = resolveValue(state, last.list);
        zero = resolveValue(state, last.zero);
        if list is ValueLookup::Found {
            if zero is ValueLookup::Found {
                result = lastSequence(state, last.local, (list as ValueLookup::Found).term, (zero as ValueLookup::Found).term);
                if result.status != 0 { return ExecutionResult { status: result.status, failedAt: i, state: result.state }; };
                state = result.state;
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepSet(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Set {
        setStep = step as ExecutionStep::Set;
        list = resolveValue(state, setStep.list);
        index = resolveValue(state, setStep.index);
        value = resolveValue(state, setStep.value);
        if list is ValueLookup::Found {
            if index is ValueLookup::Found {
                if value is ValueLookup::Found {
                    result = setSequence(state, setStep.local, (list as ValueLookup::Found).term, (index as ValueLookup::Found).term, (value as ValueLookup::Found).term);
                    if result.status != 0 { return ExecutionResult { status: result.status, failedAt: i, state: result.state }; };
                    state = result.state;
                    madeTerm = resolveValue(state, ValueRef::Local { local: setStep.local });
                    if madeTerm is ValueLookup::Found { state = recordEvaluatedSize(state, (madeTerm as ValueLookup::Found).term); };
                } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepPop(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Pop {
        popStep = step as ExecutionStep::Pop;
        list = resolveValue(state, popStep.list);
        if list is ValueLookup::Found {
            result = popSequence(state, popStep.local, (list as ValueLookup::Found).term);
            if result.status != 0 { return ExecutionResult { status: result.status, failedAt: i, state: result.state }; };
            state = result.state;
            madeTerm = resolveValue(state, ValueRef::Local { local: popStep.local });
            if madeTerm is ValueLookup::Found { state = recordEvaluatedSize(state, (madeTerm as ValueLookup::Found).term); };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepNewArray(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::NewArray {
        array = step as ExecutionStep::NewArray;
        length = resolveValue(state, array.length);
        value = resolveValue(state, array.value);
        if length is ValueLookup::Found {
            if value is ValueLookup::Found {
                fresh = freshValue(state);
                if fresh is ValueLookup::Found {
                    result = (fresh as ValueLookup::Found).term;
                    lengthTerm = (length as ValueLookup::Found).term;
                    valueTerm = (value as ValueLookup::Found).term;
                    make = ApplicationTerm { id: result, function: -19, arguments: push(push([], lengthTerm), valueTerm) };
                    sizeApp = ApplicationTerm { id: lengthTerm, function: -13, arguments: push([], result) };
                    apps = push(push(clone(state.context.applications), make), sizeApp);
                    context = ValidatorContext { applications: apps, ..state.context };
                    locals = bindLocal(state.locals, array.local, result);
                    state = ExecutionState { context: context, locals: locals, ..state };
                } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepHavoc(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Havoc {
        havoc = step as ExecutionStep::Havoc;
        fresh = freshValue(state);
        if fresh is ValueLookup::Found {
            locals = bindLocal(state.locals, havoc.local, (fresh as ValueLookup::Found).term);
            state = ExecutionState { locals: locals, ..state };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepRequireDefined(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::RequireDefined {
        required = step as ExecutionStep::RequireDefined;
        value = resolveValue(state, required.value);
        if value is ValueLookup::Missing {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepCheck(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    CheckedStep { result: result, shared: after } = stepCheckShared(initial, step, i, SharedEntailment::Missing);
    return result;
};

fn stepCheckShared(initial: ExecutionState, step: &ExecutionStep, i: Int, given: SharedEntailment) -> CheckedStep {
    shared = given;
    state = initial;
    if step is ExecutionStep::Check {
        check0 = step as ExecutionStep::Check;
        // (a relation code past 10 is a quiet check: a candidate invariant the
        // inference tries, which is not worth case splits when it fails)
        quiet = check0.relation >= 10;
        relation = check0.relation;
        if quiet { relation = relation - 10; };
        if relation < 0 { return CheckedStep { result: ExecutionResult { status: 2, failedAt: i, state: state }, shared: shared }; };
        if relation > 3 { return CheckedStep { result: ExecutionResult { status: 2, failedAt: i, state: state }, shared: shared }; };
        left = resolveValue(state, check0.left);
        right = resolveValue(state, check0.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                a = (left as ValueLookup::Found).term;
                b = (right as ValueLookup::Found).term;
                g = localGoal(relation, a, b);
                ok = false;
                if shared is SharedEntailment::Found {
                    ok = entailsPlainCached((shared as SharedEntailment::Found).cache, g);
                };
                if ok = false {
                    fresh = entailsGoalCached(entailmentCache(state.context), clone(g));
                    ok = fresh.holds;
                    shared = SharedEntailment::Found { cache: fresh.cache };
                };
                if ok = false {
                    if relation = 0 { ok = booleanCheck(state.context, 0, a, b); };
                    if relation = 1 { ok = booleanCheck(state.context, 1, a, b); };
                };
                if ok = false && quiet = false && size(state.templates) > 0 {
                    // (each saturation of a large context is costly: a check it cannot
                    // prove is given up after fewer of them)
                    saturations = 40;
                    if size(state.context.applications) > 150 { saturations = 12; };
                    ok = proveBySaturation(Saturation { state: clone(state), births: emptyIntMap(), done: noDoneKeys(), blocked: noBlocked(), closed: noClosed() }, relation, a, b, 8, saturations, noBlocked()).holds;
                };
                if ok = false && quiet = false {
                    // (a small context affords more cases: each costs about its size)
                    budget = 8;
                    if size(state.context.applications) < 200 { budget = 24; };
                    ok = splitReadOverWrite(state, localGoal(relation, a, b), 3, budget).holds;
                };
                if ok = false {
                    return CheckedStep { result: ExecutionResult { status: 1, failedAt: i, state: state }, shared: shared };
                };
                ExecutionState { context: checkContext, locals: checkLocals, templates: checkTemplates } = state;
                context = assumeRelation(checkContext, relation, a, b);
                if relation = 0 {
                    context = assumeBooleanFact(context, a, b);
                };
                state = ExecutionState { context: context, locals: checkLocals, templates: checkTemplates };
            } else { return CheckedStep { result: ExecutionResult { status: 2, failedAt: i, state: state }, shared: shared }; };
        } else { return CheckedStep { result: ExecutionResult { status: 2, failedAt: i, state: state }, shared: shared }; };
        return CheckedStep { result: ExecutionResult { status: 0, failedAt: -1, state: state }, shared: shared };
    };
    return CheckedStep { result: ExecutionResult { status: 2, failedAt: i, state: state }, shared: shared };
};

fn stepAssumeForall(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::AssumeForall {
        assumed = step as ExecutionStep::AssumeForall;
        newTemplate = clone(assumed.template);
        kept = noTemplates();
        for t in state.templates { if t.id != newTemplate.id { kept = push(kept, clone(t)); }; };
        kept = push(kept, newTemplate);
        state = ExecutionState { templates: kept, ..state };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepAssume(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Assume {
        assumed = step as ExecutionStep::Assume;
        if assumed.relation < 0 { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        if assumed.relation > 3 { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        left = resolveValue(state, assumed.left);
        right = resolveValue(state, assumed.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                ExecutionState { context: assumeContext, locals: assumeLocals, templates: assumeTemplates } = state;
                context = assumeRelation(assumeContext, assumed.relation, (left as ValueLookup::Found).term, (right as ValueLookup::Found).term);
                if assumed.relation = 0 {
                    context = assumeBooleanFact(context, (left as ValueLookup::Found).term, (right as ValueLookup::Found).term);
                };
                state = ExecutionState { context: context, locals: assumeLocals, templates: assumeTemplates };
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepCheckWithin(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::CheckWithin {
        cw = step as ExecutionStep::CheckWithin;
        inner = resolveValue(state, cw.inner);
        outer = resolveValue(state, cw.outer);
        if inner is ValueLookup::Found {
            if outer is ValueLookup::Found {
                if entailsGoal(state.context, ValidatorGoal::Within { inner: (inner as ValueLookup::Found).term, outer: (outer as ValueLookup::Found).term }) = false {
                    return ExecutionResult { status: 1, failedAt: i, state: state };
                };
            } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepAssumeVariant(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::AssumeVariant {
        av = step as ExecutionStep::AssumeVariant;
        object = resolveValue(state, av.object);
        if object is ValueLookup::Found {
            variants = push(clone(state.context.variants), VariantFact { object: (object as ValueLookup::Found).term, family: av.family, constructor: av.constructor, matches: av.matches });
            context = ValidatorContext { variants: variants, ..state.context };
            state = ExecutionState { context: context, ..state };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepRequireVariant(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::RequireVariant {
        rv = step as ExecutionStep::RequireVariant;
        object = resolveValue(state, rv.object);
        if object is ValueLookup::Found {
            term = (object as ValueLookup::Found).term;
            if knownVariant(leastClasses(closeContext(state.context)), state.context.variants, term, rv.family, rv.constructor) = 1 {
                variants = push(clone(state.context.variants), VariantFact { object: term, family: rv.family, constructor: rv.constructor, matches: true });
                context = ValidatorContext { variants: variants, ..state.context };
                state = ExecutionState { context: context, ..state };
            } else { return ExecutionResult { status: 1, failedAt: i, state: state }; };
        } else { return ExecutionResult { status: 2, failedAt: i, state: state }; };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepProof(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Proof {
        p = step as ExecutionStep::Proof;
        result = runProofSteps(state.context, push([], p.step));
        if result.valid = false { return ExecutionResult { status: 1, failedAt: i, state: state }; };
        state = ExecutionState { context: result.state, ..state };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

// A loop being walked: its header, the blocks that can get back to it, what
// has to hold at each back edge, and the value of the variant when the
// iteration started. A stack of frames keeps an exit from a nested loop inside
// the loop that encloses it.

struct LoopFrame {
    header: Int,
    region: List<Int>,
    checks: List<ExecutionStep>,
    variant: ValueRef,
    variantMode: Int,
    variantOther: ValueRef,
    prior: Int,
    priorOther: Int,
};

impl Clone for LoopFrame { };

// An execution graph carries local bindings separately along every path. Its
// edge steps are host-supplied consequences of the branch condition. An
// unsupported MIR operation must be represented by ExecutionEnd::Unsupported.
enum ExecutionEnd {
    Done,
    Jump { target: Int },
    Branch { yes: Int, no: Int, yesSteps: List<ExecutionStep>, noSteps: List<ExecutionStep> },
    BooleanBranch { yes: Int, no: Int, join: Int, value: ValueRef, trueValue: ValueRef, falseValue: ValueRef },
    Condition { yes: Int, no: Int, relation: Int, left: ValueRef, right: ValueRef },
    // body is the block an iteration starts on, and region is the header and
    // every block that can get back to it; a block outside the region leaves
    // the loop and is walked after it.
    Loop { exit: Int, body: Int, region: List<Int>, checks: List<ExecutionStep>, assumptions: List<ExecutionStep>, havoc: List<Int>, relation: Int, left: ValueRef, right: ValueRef, variant: ValueRef, variantMode: Int, variantOther: ValueRef, zero: ValueRef, variantObject: ValueRef, variantFamily: Int, variantConstructor: Int, orTests: List<LoopTest> },
    Unsupported,
};

impl Clone for ExecutionEnd { };

struct ExecutionBlock { id: Int, steps: List<ExecutionStep>, end: ExecutionEnd };

impl Clone for ExecutionBlock { };

// status 0: valid; 1: unproved; 2: unsupported or malformed step;
// 3: invalid graph; 4: cycle whose invariant has not yet been checked.
struct ExecutionFlowResult { status: Int, block: Int, step: Int, state: ExecutionState };

impl Clone for ExecutionFlowResult { };

fn executionTable(blocks: &List<ExecutionBlock>) -> HashMap<Int, ExecutionBlock> {
    table = HashMap::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        table = table.insert(block.id, clone(block));
    };
    return table;
};

fn uniqueExecutionBlocks(blocks: &List<ExecutionBlock>) -> Bool {
    seen = HashSet::new();
    for blockPosition in 0..size(blocks) {
        block = get(blocks, blockPosition);
        if seen.contains(block.id) { return false; };
        seen = seen.insert(block.id);
    };
    return true;
};

fn containsBlock(blocks: &List<Int>, id: Int) -> Bool {
    for block in blocks {
        if block = id { return true; };
    };
    return false;
};

// An edge out of a loop leaves the frames whose region does not contain its
// target, so a nested loop's exit is walked inside the loop that encloses it.
fn popLoopFrames(loops: List<LoopFrame>, target: Int) -> List<LoopFrame> [{ }] [{ }] shrinks size(loops) {
    if size(loops) = 0 { return loops; };
    frame = last(loops);
    if containsBlock(frame.region, target) { return loops; };
    return popLoopFrames(pop(loops), target);
};

// What an edge back to a loop's header has to show: the invariant holds again,
// and the variant is smaller than it was when the iteration started.
fn checkLoopBackEdge(initial: &ExecutionState, frame: &LoopFrame, id: Int) -> ExecutionFlowResult {
    preserved = executeSteps(clone(initial), frame.checks);
    if preserved.status != 0 { return ExecutionFlowResult { status: preserved.status, block: id, step: preserved.failedAt, state: preserved.state }; };
    next = resolveValue(preserved.state, frame.variant);
    if next is ValueLookup::Found {
        nextTerm = (next as ValueLookup::Found).term;
        if frame.variantMode = 0 {
            if entailsGoal(preserved.state.context, ValidatorGoal::Less { left: nextTerm, right: frame.prior }) = false {
                return ExecutionFlowResult { status: 1, block: id, step: -1, state: preserved.state };
            };
        } else {
            if frame.variantMode = 1 {
                otherAfter = resolveValue(preserved.state, frame.variantOther);
                if otherAfter is ValueLookup::Found {
                    if entailsGoal(preserved.state.context, ValidatorGoal::Equal { left: (otherAfter as ValueLookup::Found).term, right: frame.priorOther }) = false {
                        return ExecutionFlowResult { status: 1, block: id, step: -1, state: preserved.state };
                    };
                } else { return ExecutionFlowResult { status: 2, block: id, step: -1, state: preserved.state }; };
                if entailsGoal(preserved.state.context, ValidatorGoal::Less { left: frame.prior, right: nextTerm }) = false {
                    return ExecutionFlowResult { status: 1, block: id, step: -1, state: preserved.state };
                };
            };
            if frame.variantMode = 3 {
                if entailsGoal(preserved.state.context, ValidatorGoal::Within { inner: nextTerm, outer: frame.prior }) = false {
                    return ExecutionFlowResult { status: 1, block: id, step: -1, state: preserved.state };
                };
                if entailsGoal(preserved.state.context, ValidatorGoal::Different { left: nextTerm, right: frame.prior }) = false {
                    return ExecutionFlowResult { status: 1, block: id, step: -1, state: preserved.state };
                };
            };
        };
        return ExecutionFlowResult { status: 0, block: id, step: -1, state: preserved.state };
    };
    return ExecutionFlowResult { status: 2, block: id, step: -1, state: preserved.state };
};

fn stopTableAtJoin(blocks: &HashMap<Int, ExecutionBlock>, join: Int) -> HashMap<Int, ExecutionBlock> {
    table = clone(blocks);
    return table.insert(join, ExecutionBlock { id: join, steps: [], end: ExecutionEnd::Done });
};

fn contextContradictory(context: &ValidatorContext) -> Bool {
    equalities = closeContext(context);
    equalitiesClasses = leastClasses(equalities);
    if contradictoryVariants(equalitiesClasses, context.variants) { return true; };
    if contradictoryConstructors(equalitiesClasses, context.applications, context.constructorFunctions) { return true; };
    if contradictoryConstants(equalitiesClasses, context.constants) { return true; };
    if contradictoryDisequalities(equalitiesClasses, context.different) { return true; };
    orders = refinedOrders(equalitiesClasses, constantOrders(context.orders, context.constants), context.different);
    differences = constantDifferences(context.constants, comparisonDifferences(orders, context.differences));
    if contradictoryDifferences(equalitiesClasses, differences) { return true; };
    return false;
};

struct InferSubject { local: Int, isSize: Bool, temp: Int, term: Int, kind: Int, indexTerm: Int };

impl Clone for InferSubject { };

impl Copy for InferSubject { };

struct InferGoal { relation: Int, left: Int, right: Int, assumes: List<ExecutionStep>, checks: List<ExecutionStep> };

impl Clone for InferGoal { };

struct LoopCandidates { assumes: List<ExecutionStep>, checks: List<ExecutionStep> };

impl Clone for LoopCandidates { };

fn appendSteps(a: &List<ExecutionStep>, b: &List<ExecutionStep>) -> List<ExecutionStep> {
    out = clone(a);
    for i in 0..size(b) { out = push(out, clone(get(b, i))); };
    return out;
};

fn subjectRef(subject: &InferSubject) -> ValueRef {
    if subject.isSize { return ValueRef::Local { local: subject.temp }; };
    if subject.kind = 2 { return ValueRef::Local { local: subject.temp }; };
    return ValueRef::Local { local: subject.local };
};

fn subjectSteps(subject: &InferSubject) -> List<ExecutionStep> {
    if subject.isSize {
        return push([], ExecutionStep::ApplyFresh { local: subject.temp, function: -13, arguments: push([], ValueRef::Local { local: subject.local }) });
    };
    if subject.kind = 2 {
        return push([], ExecutionStep::ApplyFresh { local: subject.temp, function: -14, arguments: push(push([], ValueRef::Local { local: subject.local }), ValueRef::Term { term: subject.indexTerm }) });
    };
    return [];
};

// Relations between the locals a loop assigns and the values it does not
// touch, that hold when the loop is reached: counters keep their distance,
// a list built one element per iteration has the size of its counter, and
// two counters keep the sum they start with. A candidate is assumed at the
// header and checked again at the back edge, so keeping one is sound; the
// ones the body does not keep make the check fail, as the reference's
// inferred invariants do when the program goes on to use them.
// Whether the entry state gives a term a size: only a sequence has one, so a
// size subject is made only of a local that holds one (a size of an Int is
// a term the facts of sizes speak of wrongly, and candidates about it once
// let a loop's exit be taken for unreachable).
fn hasSizeOf(context: &ValidatorContext, term: Int) -> Bool {
    if evalListSize(context, unionOf(context.equalities), term, 6) is IntegerLookup::Found { return true; };
    equalities = semanticFacts(context.equalities, context.applications, context.constants);
    equalitiesClasses = leastClasses(equalities);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = -13 {
            if size(app.arguments) = 1 {
                if sameIn(equalitiesClasses, get(app.arguments, 0), term) { return true; };
            };
        };
    };
    return false;
};

// What the inference of loop candidates carries from one of its passes to the next: the state it adds terms to, the
// numbers of the temporaries it made, the subjects and anchors, and the candidate goals
struct InferState { work: ExecutionState, index: Int, candIndex: Int, assigned: List<InferSubject>, anchors: List<InferSubject>, goals: List<InferGoal> };

impl Clone for InferState { };

fn noInferGoals() -> List<InferGoal> { return []; };

// The locals a candidate invariant may relate a changed local to: those the
// loop reads, and those equal at its entry to a local it changes or to the
// size of a list it changes (n in s = n - i, with i = n at the entry). Ties
// through orders or other applications would bring in most of a large
// function.
fn loopAnchors(initial: &ExecutionState, havoc: &List<Int>, mentioned: &HashSet<Int>) -> HashSet<Int> {
    uf = unionOf(initial.context.equalities);
    constant = HashSet::new();
    for c in initial.context.constants { constant = constant.insert(ufFind(uf, c.id)); };
    roots = HashSet::new();
    for binding in initial.locals.entries() {
        // (a local that starts at a constant ties nothing: every other local
        // that starts at 0 would be an anchor of every counter)
        r = ufFind(uf, binding.value);
        if containsValue(havoc, binding.key) && constant.contains(r) = false { roots = roots.insert(r); };
    };
    // (and so is a local equal to the size of a list the loop changes: i in
    // size(l) = i, for a loop that sets the elements of l)
    for app in initial.context.applications {
        if app.function = -13 && size(app.arguments) = 1 {
            if roots.contains(ufFind(uf, intAt(app.arguments, 0, 0))) { roots = roots.insert(ufFind(uf, app.id)); };
        };
    };
    anchors = HashSet::new();
    for binding in initial.locals.entries() {
        if mentioned.contains(binding.key) || roots.contains(ufFind(uf, binding.value)) { anchors = anchors.insert(binding.key); };
    };
    return anchors;
};

fn inferLoopCandidateGoals(initial: &ExecutionState, havoc: &List<Int>, mentioned: &HashSet<Int>) -> List<InferGoal> {
    work = clone(initial);
    assigned = [];
    anchors = [];
    index = 0;
    related = loopAnchors(initial, havoc, mentioned);
    for binding in initial.locals.entries() {
        if binding.key >= 0 {
            if containsValue(havoc, binding.key) {
                if size(assigned) < 8 {
                    assigned = push(assigned, InferSubject { local: binding.key, isSize: false, temp: 0, term: binding.value, kind: 0, indexTerm: 0 });
                };
            } else {
                if size(anchors) < 12 && related.contains(binding.key) {
                    anchors = push(anchors, InferSubject { local: binding.key, isSize: false, temp: 0, term: binding.value, kind: 0, indexTerm: 0 });
                };
            };
        };
    };
    goals = noInferGoals();
    st = InferState { work: work, index: index, candIndex: 0, assigned: assigned, anchors: anchors, goals: goals };
    st = inferPhase1(st, initial, havoc);
    st = inferPhase2(st, initial, havoc);
    st = inferPhase3(st, initial, havoc);
    st = inferPhase4(st, initial, havoc);
    st = inferPhase5(st, initial, havoc);
    st = inferPhase6(st, initial, havoc);
    st = inferPhase7(st, initial, havoc);
    st = inferPhase8(st, initial, havoc);
    st = inferPhase9(st, initial, havoc);
    st = inferPhase10(st, initial, havoc);
    st = inferPhase11(st, initial, havoc);
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    analysis = analyzeContext(work.context);
    kept = [];
    for gi in 0..size(goals) {
        goal = clone(get(goals, gi));
        holds = false;
        if goal.relation = 0 { holds = entailsGoalAnalyzed(work.context, analysis, ValidatorGoal::Equal { left: goal.left, right: goal.right }); };
        if goal.relation = 3 { holds = entailsGoalAnalyzed(work.context, analysis, ValidatorGoal::AtMost { left: goal.left, right: goal.right }); };
        if holds { if size(kept) < 32 { kept = push(kept, goal); }; };
    };
    return kept;
};

fn inferPhase1(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    extraAssigned = [];
    for subjectPosition in 0..size(assigned) {
        subject = get(assigned, subjectPosition);
        if size(assigned) + size(extraAssigned) < 8 && hasSizeOf(work.context, subject.term) {
            temp = 0 - 7000000 - index * 4;
            index = index + 1;
            made = executeSteps(clone(work), push([], ExecutionStep::ApplyFresh { local: temp, function: -13, arguments: push([], ValueRef::Local { local: subject.local }) }));
            if made.status = 0 {
                work = made.state;
                term = resolveValue(work, ValueRef::Local { local: temp });
                if term is ValueLookup::Found {
                    extraAssigned = push(extraAssigned, InferSubject { local: subject.local, isSize: true, temp: temp, term: (term as ValueLookup::Found).term, kind: 1, indexTerm: 0 });
                };
            };
        };
    };
    for subject in extraAssigned { assigned = push(assigned, subject); };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase2(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    extraAnchors = [];
    for subjectPosition in 0..size(anchors) {
        subject = get(anchors, subjectPosition);
        if size(anchors) + size(extraAnchors) < 12 && hasSizeOf(work.context, subject.term) {
            temp = 0 - 7000000 - index * 4;
            index = index + 1;
            made = executeSteps(clone(work), push([], ExecutionStep::ApplyFresh { local: temp, function: -13, arguments: push([], ValueRef::Local { local: subject.local }) }));
            if made.status = 0 {
                work = made.state;
                term = resolveValue(work, ValueRef::Local { local: temp });
                if term is ValueLookup::Found {
                    extraAnchors = push(extraAnchors, InferSubject { local: subject.local, isSize: true, temp: temp, term: (term as ValueLookup::Found).term, kind: 1, indexTerm: 0 });
                };
            };
        };
    };
    for subject in extraAnchors { anchors = push(anchors, subject); };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase3(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    extraElems = [];
    for subjectPosition in 0..size(assigned) {
        subject = get(assigned, subjectPosition);
        if subject.kind = 0 {
            listSize = evalListSize(work.context, unionOf(work.context.equalities), subject.term, 6);
            if listSize is IntegerLookup::Found {
                count = (listSize as IntegerLookup::Found).value;
                if count > 3 { count = 3; };
                if count < 0 { count = 0; };
                for k in 0..count {
                    if size(assigned) + size(extraElems) < 8 {
                        kTerm = 0;
                        kFound = false;
                        for constantPosition in 0..size(work.context.constants) {
                            constant = get(work.context.constants, constantPosition);
                            if constant.kind = 0 {
                                if kFound = false { if constant.value = k { kTerm = constant.id; kFound = true; }; };
                            };
                        };
                        if kFound {
                            temp = 0 - 7000000 - index * 4;
                            index = index + 1;
                            made = executeSteps(clone(work), push([], ExecutionStep::ApplyFresh { local: temp, function: -14, arguments: push(push([], ValueRef::Local { local: subject.local }), ValueRef::Term { term: kTerm }) }));
                            if made.status = 0 {
                                work = made.state;
                                term = resolveValue(work, ValueRef::Local { local: temp });
                                if term is ValueLookup::Found {
                                    extraElems = push(extraElems, InferSubject { local: subject.local, isSize: false, temp: temp, term: (term as ValueLookup::Found).term, kind: 2, indexTerm: kTerm });
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    for subject in extraElems { assigned = push(assigned, subject); };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase4(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    for subjPosition in 0..size(assigned) {
        subj = get(assigned, subjPosition);
        kv = evalTermValue(work.context, unionOf(work.context.equalities), subj.term, 6);
        if kv is IntegerLookup::Found {
            k = (kv as IntegerLookup::Found).value;
            kTerm = 0;
            kFound = false;
            for constantPosition in 0..size(work.context.constants) {
                constant = get(work.context.constants, constantPosition);
                if constant.kind = 0 {
                    if kFound = false { if constant.value = k { kTerm = constant.id; kFound = true; }; };
                };
            };
            if kFound {
                if size(goals) < 128 {
                    goals = push(goals, InferGoal { relation: 3, left: kTerm, right: subj.term, assumes: appendSteps(subjectSteps(subj), push([], ExecutionStep::Assume { relation: 3, left: ValueRef::Term { term: kTerm }, right: subjectRef(subj) })), checks: appendSteps(subjectSteps(subj), push([], ExecutionStep::Check { relation: 3, left: ValueRef::Term { term: kTerm }, right: subjectRef(subj) })) });
                    goals = push(goals, InferGoal { relation: 3, left: subj.term, right: kTerm, assumes: appendSteps(subjectSteps(subj), push([], ExecutionStep::Assume { relation: 3, left: subjectRef(subj), right: ValueRef::Term { term: kTerm } })), checks: appendSteps(subjectSteps(subj), push([], ExecutionStep::Check { relation: 3, left: subjectRef(subj), right: ValueRef::Term { term: kTerm } })) });
                };
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

// A distance between two subjects as a value: a constant of the program, or, for a small distance the program writes
// no constant for, a sum of ones (a list that starts with two elements and grows with its counter), with the subjects
// swapped when it is negative
struct InferDistance { found: Bool, swapped: Bool, steps: List<ExecutionStep>, value: ValueRef };

impl Clone for InferDistance { };

fn inferPhase5(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    inferring = st;
    count = size(inferring.assigned);
    for i in 0..count {
        for j in 0..count {
            if i < j && j < size(inferring.assigned) && size(inferring.goals) < 128 {
                s1 = clone(get(inferring.assigned, i));
                s2 = clone(get(inferring.assigned, j));
                k1 = evalTermValue(inferring.work.context, unionOf(inferring.work.context.equalities), s1.term, 6);
                k2 = evalTermValue(inferring.work.context, unionOf(inferring.work.context.equalities), s2.term, 6);
                if k1 is IntegerLookup::Found {
                    if k2 is IntegerLookup::Found {
                        inferring = inferPairGoal(inferring, s1, s2, (k1 as IntegerLookup::Found).value, (k2 as IntegerLookup::Found).value);
                    };
                };
            };
        };
    };
    return inferring;
};

// The candidate that two subjects, of values v1 and v2 now, stay that far apart: equal, or one the other plus a
// distance written as a constant or as a sum of ones
fn inferPairGoal(st: InferState, s1: &InferSubject, s2: &InferSubject, v1: Int, v2: Int) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    delta = v1 - v2;
    if delta = 0 {
        goals = push(goals, InferGoal { relation: 0, left: s1.term, right: s2.term, assumes: appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), push([], ExecutionStep::Assume { relation: 0, left: subjectRef(s1), right: subjectRef(s2) })), checks: appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), push([], ExecutionStep::Check { relation: 0, left: subjectRef(s1), right: subjectRef(s2) })) });
        return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
    };
    distance = inferDistance(work.context, delta, candIndex);
    if distance.found = false { return inferPairByConstants(InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals }, s1, s2, v1, v2); };
    lhs = clone(s1);
    rhs = clone(s2);
    if distance.swapped {
        lhs = clone(s2);
        rhs = clone(s1);
    };
    temp = 0 - 7100000 - candIndex * 4;
    candIndex = candIndex + 1;
    addSteps = appendSteps(distance.steps, push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(rhs)), clone(distance.value)) }));
    made = executeSteps(clone(work), addSteps);
    if made.status = 0 {
        work = made.state;
        sumTerm = resolveValue(work, ValueRef::Local { local: temp });
        if sumTerm is ValueLookup::Found {
            goals = push(goals, InferGoal { relation: 0, left: lhs.term, right: (sumTerm as ValueLookup::Found).term, assumes: appendSteps(appendSteps(appendSteps(subjectSteps(lhs), subjectSteps(rhs)), addSteps), push([], ExecutionStep::Assume { relation: 0, left: subjectRef(lhs), right: ValueRef::Local { local: temp } })), checks: appendSteps(appendSteps(appendSteps(subjectSteps(lhs), subjectSteps(rhs)), addSteps), push([], ExecutionStep::Check { relation: 0, left: subjectRef(lhs), right: ValueRef::Local { local: temp } })) });
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferDistance(context: &ValidatorContext, delta: Int, candIndex: Int) -> InferDistance {
    constant = constantTermWithValue(context, delta);
    if constant is ValueLookup::Found {
        return InferDistance { found: true, swapped: false, steps: [], value: ValueRef::Term { term: (constant as ValueLookup::Found).term } };
    };
    swapped = false;
    magnitude = delta;
    if delta <= -2 && delta >= -6 {
        swapped = true;
        magnitude = 0 - delta;
    };
    one = constantTermWithValue(context, 1);
    if magnitude < 2 || magnitude > 6 || one is ValueLookup::Missing {
        return InferDistance { found: false, swapped: false, steps: [], value: ValueRef::Term { term: 0 } };
    };
    oneTerm = (one as ValueLookup::Found).term;
    steps = [];
    previous = ValueRef::Term { term: oneTerm };
    for m in 1..magnitude {
        partial = 0 - 7400000 - candIndex * 8 - m;
        steps = push(steps, ExecutionStep::ApplyFresh { local: partial, function: -1, arguments: push(push([], clone(previous)), ValueRef::Term { term: oneTerm }) });
        previous = ValueRef::Local { local: partial };
    };
    return InferDistance { found: true, swapped: swapped, steps: steps, value: previous };
};

// The candidate s1 = s2 + (c1 - c2), with c1 and c2 the program's constants for the subjects' values now
fn inferPairByConstants(st: InferState, s1: &InferSubject, s2: &InferSubject, v1: Int, v2: Int) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    c1 = constantTermWithValue(work.context, v1);
    c2 = constantTermWithValue(work.context, v2);
    if c1 is ValueLookup::Found {
        if c2 is ValueLookup::Found {
            tempD = 0 - 7200000 - candIndex * 4;
            candIndex = candIndex + 1;
            temp = 0 - 7100000 - candIndex * 4;
            candIndex = candIndex + 1;
            deltaSteps = push(push([], ExecutionStep::ApplyFresh { local: tempD, function: -2, arguments: push(push([], ValueRef::Term { term: (c1 as ValueLookup::Found).term }), ValueRef::Term { term: (c2 as ValueLookup::Found).term }) }), ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(s2)), ValueRef::Local { local: tempD }) });
            madeD = executeSteps(clone(work), deltaSteps);
            if madeD.status = 0 {
                work = madeD.state;
                sumTerm = resolveValue(work, ValueRef::Local { local: temp });
                if sumTerm is ValueLookup::Found {
                    goals = push(goals, InferGoal { relation: 0, left: s1.term, right: (sumTerm as ValueLookup::Found).term, assumes: appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), deltaSteps), push([], ExecutionStep::Assume { relation: 0, left: subjectRef(s1), right: ValueRef::Local { local: temp } })), checks: appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), deltaSteps), push([], ExecutionStep::Check { relation: 0, left: subjectRef(s1), right: ValueRef::Local { local: temp } })) });
                };
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase6(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    // (equalities first: the orders of every pair can fill the candidates up)
    for subjPosition in 0..size(assigned) {
        subj = get(assigned, subjPosition);
        for anchorPosition in 0..size(anchors) {
            anchor = get(anchors, anchorPosition);
            if size(goals) < 128 {
                goals = push(goals, InferGoal { relation: 0, left: subj.term, right: anchor.term, assumes: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Assume { relation: 0, left: subjectRef(subj), right: subjectRef(anchor) })), checks: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Check { relation: 0, left: subjectRef(subj), right: subjectRef(anchor) })) });
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase7(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    for subjPosition in 0..size(assigned) {
        subj = get(assigned, subjPosition);
        for anchorPosition in 0..size(anchors) {
            anchor = get(anchors, anchorPosition);
            if size(goals) < 128 {
                goals = push(goals, InferGoal { relation: 3, left: subj.term, right: anchor.term, assumes: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Assume { relation: 3, left: subjectRef(subj), right: subjectRef(anchor) })), checks: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Check { relation: 3, left: subjectRef(subj), right: subjectRef(anchor) })) });
                goals = push(goals, InferGoal { relation: 3, left: anchor.term, right: subj.term, assumes: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Assume { relation: 3, left: subjectRef(anchor), right: subjectRef(subj) })), checks: appendSteps(appendSteps(subjectSteps(subj), subjectSteps(anchor)), push([], ExecutionStep::Check { relation: 3, left: subjectRef(anchor), right: subjectRef(subj) })) });
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase8(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    for i in 0..size(assigned) {
        for j in 0..size(assigned) {
            if i < j {
                s1 = get(assigned, i);
                s2 = get(assigned, j);
                kv1 = evalTermValue(work.context, unionOf(work.context.equalities), s1.term, 6);
                kv2 = evalTermValue(work.context, unionOf(work.context.equalities), s2.term, 6);
                bothKnown = false;
                if kv1 is IntegerLookup::Found { if kv2 is IntegerLookup::Found { bothKnown = true; }; };
                if bothKnown = false {
                    offset = 0;
                    if kv1 is IntegerLookup::Found { offset = offset + (kv1 as IntegerLookup::Found).value; };
                    if kv2 is IntegerLookup::Found { offset = offset + (kv2 as IntegerLookup::Found).value; };
                    for anchorPosition in 0..size(anchors) {
                        anchor = get(anchors, anchorPosition);
                        if size(goals) < 128 {
                            temp = 0 - 7100000 - candIndex * 4;
                            candIndex = candIndex + 1;
                            made = executeSteps(clone(work), push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(s1)), subjectRef(s2)) }));
                            if made.status = 0 {
                                work = made.state;
                                sumTerm = resolveValue(work, ValueRef::Local { local: temp });
                                if sumTerm is ValueLookup::Found {
                                    rightSteps = subjectSteps(anchor);
                                    rightRef = subjectRef(anchor);
                                    rightTerm = anchor.term;
                                    buildRight = true;
                                    if offset != 0 {
                                        oTerm = 0;
                                        oFound = false;
                                        for constantPosition in 0..size(work.context.constants) {
                                            constant = get(work.context.constants, constantPosition);
                                            if constant.kind = 0 {
                                                if oFound = false { if constant.value = offset { oTerm = constant.id; oFound = true; }; };
                                            };
                                        };
                                        if oFound {
                                            tempR = 0 - 7300000 - candIndex * 4;
                                            candIndex = candIndex + 1;
                                            madeR = executeSteps(work, push([], ExecutionStep::ApplyFresh { local: tempR, function: -1, arguments: push(push([], subjectRef(anchor)), ValueRef::Term { term: oTerm }) }));
                                            if madeR.status = 0 {
                                                work = madeR.state;
                                                rTerm = resolveValue(work, ValueRef::Local { local: tempR });
                                                if rTerm is ValueLookup::Found {
                                                    rightTerm = (rTerm as ValueLookup::Found).term;
                                                    rightSteps = appendSteps(subjectSteps(anchor), push([], ExecutionStep::ApplyFresh { local: tempR, function: -1, arguments: push(push([], subjectRef(anchor)), ValueRef::Term { term: oTerm }) }));
                                                    rightRef = ValueRef::Local { local: tempR };
                                                } else { buildRight = false; };
                                            } else { buildRight = false; };
                                        } else { buildRight = false; };
                                    };
                                    if buildRight {
                                        addSteps = push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(s1)), subjectRef(s2)) });
                                        goals = push(goals, InferGoal { relation: 0, left: (sumTerm as ValueLookup::Found).term, right: rightTerm, assumes: appendSteps(appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), addSteps), rightSteps), push([], ExecutionStep::Assume { relation: 0, left: ValueRef::Local { local: temp }, right: rightRef })), checks: appendSteps(appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), addSteps), rightSteps), push([], ExecutionStep::Check { relation: 0, left: ValueRef::Local { local: temp }, right: rightRef })) });
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase9(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    analysis0 = analyzeContext(work.context);
    trimmed = [];
    for gi in 0..size(goals) {
        goal = clone(get(goals, gi));
        holds = false;
        if goal.relation = 0 { holds = entailsGoalAnalyzed(work.context, analysis0, ValidatorGoal::Equal { left: goal.left, right: goal.right }); };
        if goal.relation = 3 { holds = entailsGoalAnalyzed(work.context, analysis0, ValidatorGoal::AtMost { left: goal.left, right: goal.right }); };
        if holds { trimmed = push(trimmed, goal); };
    };
    goals = trimmed;
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase10(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    analysis = analyzeContext(work.context);
    entailedEqs = [];
    for gi in 0..size(goals) {
        goal = clone(get(goals, gi));
        if goal.relation = 0 {
            if entailsGoalAnalyzed(work.context, analysis, ValidatorGoal::Equal { left: goal.left, right: goal.right }) { entailedEqs = push(entailedEqs, goal); };
        };
    };
    for egPosition in 0..size(entailedEqs) {
        eg = get(entailedEqs, egPosition);
        for subjPosition in 0..size(assigned) {
            subj = get(assigned, subjPosition);
            if subj.term = eg.left {
                if evalTermValue(work.context, unionOf(work.context.equalities), subj.term, 6) is IntegerLookup::Missing {
                for otherPosition in 0..size(assigned) {
                    other = get(assigned, otherPosition);
                    if other.term != subj.term {
                        kv = evalTermValue(work.context, unionOf(work.context.equalities), other.term, 6);
                        if kv is IntegerLookup::Found {
                            k = (kv as IntegerLookup::Found).value;
                            anchorSubject = subj;
                            anchorFound = false;
                            for candPosition in 0..size(anchors) {
                                cand = get(anchors, candPosition);
                                if cand.term = eg.right { anchorSubject = cand; anchorFound = true; };
                            };
                            if anchorFound {
                            if size(goals) < 128 {
                                tempA = 0 - 7400000 - candIndex * 4;
                                candIndex = candIndex + 1;
                                temp = 0 - 7500000 - candIndex * 4;
                                candIndex = candIndex + 1;
                                innerSteps = [];
                                innerRef = subjectRef(anchorSubject);
                                if k != 0 {
                                    negConst = 0;
                                    negFound = false;
                                    for constantPosition in 0..size(work.context.constants) {
                                        constant = get(work.context.constants, constantPosition);
                                        if constant.kind = 0 {
                                            if negFound = false { if constant.value = 0 - k { negConst = constant.id; negFound = true; }; };
                                        };
                                    };
                                    if negFound {
                                        innerSteps = push([], ExecutionStep::ApplyFresh { local: tempA, function: -1, arguments: push(push([], subjectRef(anchorSubject)), ValueRef::Term { term: negConst }) });
                                        innerRef = ValueRef::Local { local: tempA };
                                    };
                                };
                                if k = 0 {
                                    pairSteps = appendSteps(appendSteps(appendSteps(subjectSteps(subj), subjectSteps(other)), subjectSteps(anchorSubject)), push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(other)), innerRef) }));
                                    made = executeSteps(clone(work), pairSteps);
                                    if made.status = 0 {
                                        work = made.state;
                                        sumTerm = resolveValue(work, ValueRef::Local { local: temp });
                                        if sumTerm is ValueLookup::Found {
                                            goals = push(goals, InferGoal { relation: 0, left: subj.term, right: (sumTerm as ValueLookup::Found).term, assumes: appendSteps(pairSteps, push([], ExecutionStep::Assume { relation: 0, left: subjectRef(subj), right: ValueRef::Local { local: temp } })), checks: appendSteps(pairSteps, push([], ExecutionStep::Check { relation: 0, left: subjectRef(subj), right: ValueRef::Local { local: temp } })) });
                                        };
                                    };
                                } else {
                                    if size(innerSteps) > 0 {
                                        pairSteps = appendSteps(appendSteps(appendSteps(appendSteps(subjectSteps(subj), subjectSteps(other)), subjectSteps(anchorSubject)), innerSteps), push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(other)), innerRef) }));
                                        made = executeSteps(clone(work), pairSteps);
                                        if made.status = 0 {
                                            work = made.state;
                                            sumTerm = resolveValue(work, ValueRef::Local { local: temp });
                                            if sumTerm is ValueLookup::Found {
                                                goals = push(goals, InferGoal { relation: 0, left: subj.term, right: (sumTerm as ValueLookup::Found).term, assumes: appendSteps(pairSteps, push([], ExecutionStep::Assume { relation: 0, left: subjectRef(subj), right: ValueRef::Local { local: temp } })), checks: appendSteps(pairSteps, push([], ExecutionStep::Check { relation: 0, left: subjectRef(subj), right: ValueRef::Local { local: temp } })) });
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                };
            };
        };
    };
        };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

fn inferPhase11(st: InferState, initial: &ExecutionState, havoc: &List<Int>) -> InferState {
    InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals } = st;
    for i in 0..size(assigned) {
        for j in 0..size(assigned) {
            if i < j {
                s1 = get(assigned, i);
                s2 = get(assigned, j);
                kv1 = evalTermValue(work.context, unionOf(work.context.equalities), s1.term, 6);
                kv2 = evalTermValue(work.context, unionOf(work.context.equalities), s2.term, 6);
                if kv1 is IntegerLookup::Found {
                    if kv2 is IntegerLookup::Found {
                        if size(goals) < 128 {
                            total = (kv1 as IntegerLookup::Found).value + (kv2 as IntegerLookup::Found).value;
                            sumConst = 0;
                            sumFound = false;
                            for constantPosition in 0..size(work.context.constants) {
                                constant = get(work.context.constants, constantPosition);
                                if constant.kind = 0 {
                                    if sumFound = false { if constant.value = total { sumConst = constant.id; sumFound = true; }; };
                                };
                            };
                            if sumFound {
                                temp = 0 - 7100000 - candIndex * 4;
                                candIndex = candIndex + 1;
                                made = executeSteps(clone(work), push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(s1)), subjectRef(s2)) }));
                                if made.status = 0 {
                                    work = made.state;
                                    sumTerm = resolveValue(work, ValueRef::Local { local: temp });
                                    if sumTerm is ValueLookup::Found {
                                        addSteps = push([], ExecutionStep::ApplyFresh { local: temp, function: -1, arguments: push(push([], subjectRef(s1)), subjectRef(s2)) });
                                        goals = push(goals, InferGoal { relation: 0, left: (sumTerm as ValueLookup::Found).term, right: sumConst, assumes: appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), addSteps), push([], ExecutionStep::Assume { relation: 0, left: ValueRef::Local { local: temp }, right: ValueRef::Term { term: sumConst } })), checks: appendSteps(appendSteps(appendSteps(subjectSteps(s1), subjectSteps(s2)), addSteps), push([], ExecutionStep::Check { relation: 0, left: ValueRef::Local { local: temp }, right: ValueRef::Term { term: sumConst } })) });
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return InferState { work: work, index: index, candIndex: candIndex, assigned: assigned, anchors: anchors, goals: goals };
};

// The locals a loop reads: in the steps and ends of the blocks of its region,
// the header among them. A candidate invariant relates a local the loop
// changes to one of these; a local the loop never reads is left out of them.
fn loopMentions(blocks: &HashMap<Int, ExecutionBlock>, region: &List<Int>) -> HashSet<Int> {
    mentioned = HashSet::new();
    for id in region {
        if blocks.contains(id) {
            block = blocks.lookupRef(id);
            mentioned = stepsMentions((*block).steps, mentioned);
            mentioned = endMentions((*block).end, mentioned);
        };
    };
    return mentioned;
};

fn refMention(r: &ValueRef, into: HashSet<Int>) -> HashSet<Int> {
    if r is ValueRef::Local { return into.insert((r as ValueRef::Local).local); };
    return into;
};

fn refsMentions(refs: &List<ValueRef>, into: HashSet<Int>) -> HashSet<Int> {
    mentioned = into;
    for rPosition in 0..size(refs) { mentioned = refMention(get(refs, rPosition), mentioned); };
    return mentioned;
};

fn stepsMentions(steps: &List<ExecutionStep>, into: HashSet<Int>) -> HashSet<Int> {
    mentioned = into;
    for sPosition in 0..size(steps) { mentioned = stepMentions(get(steps, sPosition), mentioned); };
    return mentioned;
};

fn stepMentions(step: &ExecutionStep, into: HashSet<Int>) -> HashSet<Int> {
    if step is ExecutionStep::Assign { return refMention((step as ExecutionStep::Assign).value, into); };
    if step is ExecutionStep::Apply { return refsMentions((step as ExecutionStep::Apply).arguments, into); };
    if step is ExecutionStep::ApplyFresh { return refsMentions((step as ExecutionStep::ApplyFresh).arguments, into); };
    if step is ExecutionStep::Literal { return refsMentions((step as ExecutionStep::Literal).arguments, into); };
    if step is ExecutionStep::Push { return refMention((step as ExecutionStep::Push).value, refMention((step as ExecutionStep::Push).list, into)); };
    if step is ExecutionStep::Last { return refMention((step as ExecutionStep::Last).list, into); };
    if step is ExecutionStep::Set {
        return refMention((step as ExecutionStep::Set).value, refMention((step as ExecutionStep::Set).index, refMention((step as ExecutionStep::Set).list, into)));
    };
    if step is ExecutionStep::Pop { return refMention((step as ExecutionStep::Pop).list, into); };
    if step is ExecutionStep::NewArray { return refMention((step as ExecutionStep::NewArray).value, refMention((step as ExecutionStep::NewArray).length, into)); };
    if step is ExecutionStep::RequireDefined { return refMention((step as ExecutionStep::RequireDefined).value, into); };
    if step is ExecutionStep::Check { return refMention((step as ExecutionStep::Check).right, refMention((step as ExecutionStep::Check).left, into)); };
    if step is ExecutionStep::Assume { return refMention((step as ExecutionStep::Assume).right, refMention((step as ExecutionStep::Assume).left, into)); };
    if step is ExecutionStep::AssumeVariant { return refMention((step as ExecutionStep::AssumeVariant).object, into); };
    if step is ExecutionStep::RequireVariant { return refMention((step as ExecutionStep::RequireVariant).object, into); };
    if step is ExecutionStep::CheckWithin { return refMention((step as ExecutionStep::CheckWithin).outer, refMention((step as ExecutionStep::CheckWithin).inner, into)); };
    return into;
};

fn endMentions(end: &ExecutionEnd, into: HashSet<Int>) -> HashSet<Int> {
    if end is ExecutionEnd::Branch { return stepsMentions((end as ExecutionEnd::Branch).noSteps, stepsMentions((end as ExecutionEnd::Branch).yesSteps, into)); };
    if end is ExecutionEnd::BooleanBranch { return refMention((end as ExecutionEnd::BooleanBranch).value, into); };
    if end is ExecutionEnd::Condition { return refMention((end as ExecutionEnd::Condition).right, refMention((end as ExecutionEnd::Condition).left, into)); };
    if end is ExecutionEnd::Loop {
        mentioned = refMention((end as ExecutionEnd::Loop).right, refMention((end as ExecutionEnd::Loop).left, into));
        mentioned = stepsMentions((end as ExecutionEnd::Loop).checks, mentioned);
        return stepsMentions((end as ExecutionEnd::Loop).assumptions, mentioned);
    };
    return into;
};

fn walkExecution(blocks: &HashMap<Int, ExecutionBlock>, id: Int, initial: &ExecutionState, fuel: Int, loops: List<LoopFrame>) -> ExecutionFlowResult [{ affirm fuel >= 0; }] [{ }] shrinks fuel {
    if fuel = 0 { return ExecutionFlowResult { status: 4, block: id, step: -1, state: clone(initial) }; };
    if size(loops) > 0 {
        frame = last(loops);
        if id = frame.header { return checkLoopBackEdge(initial, frame, id); };
        if containsBlock(frame.region, id) = false {
            return walkExecution(blocks, id, initial, fuel - 1, popLoopFrames(loops, id));
        };
    };
    if blocks.contains(id) {
        block = blocks.lookupRef(id);
        if (*block).end is ExecutionEnd::Loop {
            loop = (*block).end as ExecutionEnd::Loop;
            entry = executeSteps(clone(initial), loop.checks);
            if entry.status != 0 { return ExecutionFlowResult { status: entry.status, block: id, step: entry.failedAt, state: entry.state }; };
        };
        run = executeSteps(clone(initial), (*block).steps);
        if run.status != 0 { return ExecutionFlowResult { status: run.status, block: id, step: run.failedAt, state: run.state }; };
        end = (*block).end;
        if end is ExecutionEnd::Done { return ExecutionFlowResult { status: 0, block: id, step: -1, state: run.state }; };
        if end is ExecutionEnd::Jump {
            jump = end as ExecutionEnd::Jump;
            return walkExecution(blocks, jump.target, run.state, fuel - 1, loops);
        };
        if end is ExecutionEnd::Loop {
            loop = end as ExecutionEnd::Loop;
            if loop.relation < 0 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) }; };
            if loop.relation > 3 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) }; };
            if loop.variantMode < 0 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) }; };
            if loop.variantMode > 3 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) }; };
            inferredGoals = inferLoopCandidateGoals(initial, loop.havoc, loopMentions(blocks, loop.region));
            survivors = clone(inferredGoals);
            finalResult = ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) };
            done = false;
            for attempt in 0..size(inferredGoals) + 2 {
                if done = false {
                    candAssumes = [];
                    candChecks = [];
                    candCheckPos = [];
                    pos = size(loop.checks);
                    for gi in 0..size(survivors) {
                        g = get(survivors, gi);
                        for si in 0..size(g.assumes) { candAssumes = push(candAssumes, clone(get(g.assumes, si))); };
                        for si in 0..size(g.checks) { candChecks = push(candChecks, quietStep(get(g.checks, si))); };
                        candCheckPos = push(candCheckPos, pos + size(g.checks) - 1);
                        pos = pos + size(g.checks);
                    };
                    arbitrary = clone(initial);
                    for localPosition in 0..size(loop.havoc) {
                        local = get(loop.havoc, localPosition);
                        if done = false {
                            changed = executeSteps(clone(arbitrary), push([], ExecutionStep::Havoc { local: local }));
                            if changed.status != 0 { finalResult = ExecutionFlowResult { status: changed.status, block: id, step: -1, state: clone(changed.state) }; done = true; };
                            if done = false { arbitrary = changed.state; };
                        };
                    };
                    if done = false {
                        assumed = executeSteps(arbitrary, loop.assumptions);
                        if assumed.status != 0 { finalResult = ExecutionFlowResult { status: assumed.status, block: id, step: assumed.failedAt, state: clone(assumed.state) }; done = true; };
                        if done = false {
                            assumed = executeSteps(assumed.state, candAssumes);
                            if assumed.status != 0 { finalResult = ExecutionFlowResult { status: assumed.status, block: id, step: assumed.failedAt, state: clone(assumed.state) }; done = true; };
                            if done = false {
                                header = executeSteps(assumed.state, (*block).steps);
                                if header.status != 0 { finalResult = ExecutionFlowResult { status: header.status, block: id, step: header.failedAt, state: clone(header.state) }; done = true; };
                                if done = false {
                                    headerState = clone(header.state);
                                    left = resolveValue(headerState, loop.left);
                                    right = resolveValue(headerState, loop.right);
                                    old = resolveValue(headerState, loop.variant);
                                    zero = resolveValue(headerState, loop.zero);
                                    other = resolveValue(headerState, loop.variantOther);
                                    if left is ValueLookup::Found {
                                        if right is ValueLookup::Found {
                                            if old is ValueLookup::Found {
                                                if zero is ValueLookup::Found {
                                                    if other is ValueLookup::Found {
                                                        a = (left as ValueLookup::Found).term;
                                                        b = (right as ValueLookup::Found).term;
                                                        prior = (old as ValueLookup::Found).term;
                                                        priorOther = (other as ValueLookup::Found).term;
                                                        z = (zero as ValueLookup::Found).term;
                                                        zeroValue = integerValue(headerState.context, z);
                                                        if zeroValue is IntegerLookup::Found {
                                                            if (zeroValue as IntegerLookup::Found).value != 0 { finalResult = ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(headerState) }; done = true; };
                                                        } else { finalResult = ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(headerState) }; done = true; };
                                                        if done = false {
                                                            tests = push([], LoopTest { relation: loop.relation, left: loop.left, right: loop.right });
                                                            for extra in loop.orTests { tests = push(tests, clone(extra)); };
                                                            negContext = clone(headerState.context);
                                                            joinedYes = clone(headerState);
                                                            haveYes = false;
                                                            pathContexts = [];
                                                            testRelations = [];
                                                            testLefts = [];
                                                            testRights = [];
                                                            for testPosition in 0..size(tests) {
                                                                test = get(tests, testPosition);
                                                                if done = false {
                                                                    ta = a;
                                                                    tb = b;
                                                                    lv = resolveValue(headerState, test.left);
                                                                    rv = resolveValue(headerState, test.right);
                                                                    resolved = false;
                                                                    if lv is ValueLookup::Found { if rv is ValueLookup::Found { ta = (lv as ValueLookup::Found).term; tb = (rv as ValueLookup::Found).term; resolved = true; }; };
                                                                    if resolved = false { finalResult = ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(headerState) }; done = true; };
                                                                    if done = false {
                                                                        pathContext = assumeRelation(clone(negContext), test.relation, ta, tb);
                                                                        pathFacts = push(pathContext.equalities, EqualityFact { left: prior, right: prior });
                                                                        pathFacts = push(pathFacts, EqualityFact { left: priorOther, right: priorOther });
                                                                        pathState = ExecutionState { context: ValidatorContext { equalities: pathFacts, ..pathContext }, ..clone(headerState) };
                                                                        if contextContradictory(pathState.context) = false { pathContexts = push(pathContexts, clone(pathState.context)); };
                                                                        testRelations = push(testRelations, test.relation);
                                                                        testLefts = push(testLefts, ta);
                                                                        testRights = push(testRights, tb);
                                                                        if haveYes = false {
                                                                            joinedYes = pathState;
                                                                            haveYes = true;
                                                                        } else {
                                                                            if contextContradictory(pathState.context) = false {
                                                                                if contextContradictory(joinedYes.context) {
                                                                                    joinedYes = pathState;
                                                                                } else {
                                                                                    joinedYes = ExecutionState { context: commonContext(joinedYes.context, pathState.context), ..clone(joinedYes) };
                                                                                };
                                                                            };
                                                                        };
                                                                        inverse = negateRelation(test.relation, ta, tb);
                                                                        negContext = assumeRelation(negContext, inverse.relation, inverse.left, inverse.right);
                                                                    };
                                                                };
                                                            };
                                                            if done = false {
                                                                if size(tests) > 1 {
                                                                    for ti in 0..size(testRelations) {
                                                                        rel = get(testRelations, ti);
                                                                        tl = get(testLefts, ti);
                                                                        tr = get(testRights, ti);
                                                                        everyPath = size(pathContexts) > 0;
                                                                        for pcPosition in 0..size(pathContexts) {
                                                                            pc = get(pathContexts, pcPosition);
                                                                            if everyPath {
                                                                                if entailsGoal(pc, localGoal(rel, tl, tr)) = false { everyPath = false; };
                                                                            };
                                                                        };
                                                                        if everyPath {
                                                                            joinedYes = ExecutionState { context: assumeRelation(joinedYes.context, rel, tl, tr), ..clone(joinedYes) };
                                                                        };
                                                                    };
                                                                };
                                                                yesContext = clone(joinedYes.context);
                                                                if loop.variantFamily >= 0 {
                                                                    variantObject = resolveValue(joinedYes, loop.variantObject);
                                                                    if variantObject is ValueLookup::Found {
                                                                        yesContext = ValidatorContext { variants: push(clone(yesContext.variants), VariantFact { object: (variantObject as ValueLookup::Found).term, family: loop.variantFamily, constructor: loop.variantConstructor, matches: true }), ..yesContext };
                                                                    };
                                                                };
                                                                if loop.variantMode = 0 {
                                                                    if entailsGoal(yesContext, ValidatorGoal::AtMost { left: z, right: prior }) = false {
                                                                        finalResult = ExecutionFlowResult { status: 1, block: id, step: -1, state: clone(headerState) }; done = true;
                                                                    };
                                                                } else {
                                                                    if loop.variantMode = 1 {
                                                                        if entailsGoal(yesContext, ValidatorGoal::AtMost { left: prior, right: priorOther }) = false {
                                                                            finalResult = ExecutionFlowResult { status: 1, block: id, step: -1, state: clone(headerState) }; done = true;
                                                                        };
                                                                    };
                                                                };
                                                                if done = false {
                                                                    protectedFacts = push(yesContext.equalities, EqualityFact { left: prior, right: prior });
                                                                    protectedFacts = push(protectedFacts, EqualityFact { left: priorOther, right: priorOther });
                                                                    protected = ValidatorContext { equalities: protectedFacts, ..yesContext };
                                                                    yesState = ExecutionState { context: protected, ..clone(joinedYes) };
                                                                    frame = LoopFrame { header: id, region: clone(loop.region), checks: appendSteps(loop.checks, candChecks), variant: loop.variant, variantMode: loop.variantMode, variantOther: loop.variantOther, prior: prior, priorOther: priorOther };
                                                                    bodyResult = walkExecution(blocks, loop.body, yesState, fuel - 1, push(clone(loops), frame));
                                                                    if bodyResult.status != 0 { finalResult = bodyResult; done = true; };
                                                                };
                                                            };
                                                            if done = false {
                                                                noContext = negContext;
                                                                if loop.variantFamily >= 0 {
                                                                    variantObject = resolveValue(headerState, loop.variantObject);
                                                                    if variantObject is ValueLookup::Found {
                                                                        noContext = ValidatorContext { variants: push(clone(noContext.variants), VariantFact { object: (variantObject as ValueLookup::Found).term, family: loop.variantFamily, constructor: loop.variantConstructor, matches: false }), ..noContext };
                                                                    };
                                                                };
                                                                if contextContradictory(noContext) {
                                                                    finalResult = ExecutionFlowResult { status: 0, block: id, step: -1, state: ExecutionState { context: clone(noContext), ..clone(headerState) } }; done = true;
                                                                };
                                                                if done = false {
                                                                    noState = ExecutionState { context: noContext, ..clone(headerState) };
                                                                    finalResult = walkExecution(blocks, loop.exit, noState, fuel - 1, clone(loops)); done = true;
                                                                };
                                                            };
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                    if done = false { finalResult = ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) }; done = true; };
                                };
                            };
                        };
                    };
                    if done {
                        if finalResult.status != 0 {
                            if size(survivors) > 0 {
                                dropIndex = -1;
                                if finalResult.block = id {
                                    for ci in 0..size(candCheckPos) {
                                        if get(candCheckPos, ci) = finalResult.step { dropIndex = ci; };
                                    };
                                };
                                if dropIndex >= 0 {
                                    // Every candidate after the one that failed is tried at the same
                                    // edge, and each that fails there too goes with it: dropping more
                                    // is always sound, and the loop is walked again once, not once
                                    // for each candidate the body breaks.
                                    // (each check after it is tried with what the ones before it
                                    // proved, as the walk itself would have)
                                    nextSurvivors = [];
                                    edgeState = clone(finalResult.state);
                                    for ci in 0..size(survivors) {
                                        keep = ci != dropIndex;
                                        if keep {
                                            if ci > dropIndex {
                                                tried = executeSteps(clone(edgeState), quietSteps(get(survivors, ci).checks));
                                                if tried.status != 0 { keep = false; } else { edgeState = tried.state; };
                                            };
                                        };
                                        if keep { nextSurvivors = push(nextSurvivors, clone(get(survivors, ci))); };
                                    };
                                    survivors = nextSurvivors;
                                    done = false;
                                } else {
                                    survivors = [];
                                    done = false;
                                };
                            };
                        };
                    };
                };
            };
            return finalResult;
            return ExecutionFlowResult { status: 2, block: id, step: -1, state: clone(initial) };
        };
        if end is ExecutionEnd::Condition {
            condition = end as ExecutionEnd::Condition;
            if condition.relation < 0 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state }; };
            if condition.relation > 3 { return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state }; };
            left = resolveValue(run.state, condition.left);
            right = resolveValue(run.state, condition.right);
            if left is ValueLookup::Found {
                if right is ValueLookup::Found {
                    a = (left as ValueLookup::Found).term;
                    b = (right as ValueLookup::Found).term;
                    inverse = negateRelation(condition.relation, a, b);
                    yesAnswer = entailsGoalCached(entailmentCache(run.state.context), localGoal(condition.relation, a, b));
                    yesKnown = yesAnswer.holds;
                    noKnown = entailsGoalCached(yesAnswer.cache, localGoal(inverse.relation, inverse.left, inverse.right)).holds;
                    if noKnown = false {
                        yesContext = assumeRelation(clone(run.state.context), condition.relation, a, b);
                        yesState = ExecutionState { context: yesContext, ..clone(run.state) };
                        yesResult = walkExecution(blocks, condition.yes, yesState, fuel - 1, clone(loops));
                        if yesResult.status != 0 { return yesResult; };
                        if yesKnown { return yesResult; };
                    };
                    noContext = assumeRelation(clone(run.state.context), inverse.relation, inverse.left, inverse.right);
                    noState = ExecutionState { context: noContext, ..run.state };
                    return walkExecution(blocks, condition.no, noState, fuel - 1, loops);
                };
            };
            return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state };
        };
        if end is ExecutionEnd::BooleanBranch {
            branch = end as ExecutionEnd::BooleanBranch;
            value = resolveValue(run.state, branch.value);
            trueValue = resolveValue(run.state, branch.trueValue);
            falseValue = resolveValue(run.state, branch.falseValue);
            if value is ValueLookup::Found {
                if trueValue is ValueLookup::Found {
                    if falseValue is ValueLookup::Found {
                        term = (value as ValueLookup::Found).term;
                        yesLiteral = (trueValue as ValueLookup::Found).term;
                        noLiteral = (falseValue as ValueLookup::Found).term;
                        if branch.join >= 0 {
                            joinYesAnswer = booleanKnownCached(entailmentCache(run.state.context), term, yesLiteral, true);
                            joinYesKnown = joinYesAnswer.holds;
                            if joinYesKnown {
                                yesContext = assumeRelation(run.state.context, 0, term, yesLiteral);
                                yesContext = assumeBooleanFact(yesContext, term, yesLiteral);
                                yesState = ExecutionState { context: yesContext, ..clone(run.state) };
                                return walkExecution(blocks, branch.yes, yesState, fuel - 1, clone(loops));
                            };
                            joinNoKnown = booleanKnownCached(joinYesAnswer.cache, term, noLiteral, false).holds;
                            if joinNoKnown {
                                noContext = assumeRelation(run.state.context, 0, term, noLiteral);
                                noContext = assumeBooleanFact(noContext, term, noLiteral);
                                noState = ExecutionState { context: noContext, ..clone(run.state) };
                                return walkExecution(blocks, branch.no, noState, fuel - 1, clone(loops));
                            };
                            yesContext = assumeRelation(clone(run.state.context), 0, term, yesLiteral);
                            yesContext = assumeBooleanFact(yesContext, term, yesLiteral);
                            yesState = ExecutionState { context: yesContext, ..clone(run.state) };
                            stopped = stopTableAtJoin(blocks, branch.join);
                            yesResult = walkExecution(stopped, branch.yes, yesState, fuel - 1, clone(loops));
                            if yesResult.status != 0 { return yesResult; };
                            noContext = assumeRelation(clone(run.state.context), 0, term, noLiteral);
                            noContext = assumeBooleanFact(noContext, term, noLiteral);
                            noState = ExecutionState { context: noContext, ..clone(run.state) };
                            noResult = walkExecution(stopped, branch.no, noState, fuel - 1, clone(loops));
                            if noResult.status != 0 { return noResult; };
                            merged = mergeStates(run.state, yesResult.state, noResult.state);
                            if merged is StateMergeLookup::Found {
                                return walkExecution(blocks, branch.join, (merged as StateMergeLookup::Found).state, fuel - 1, loops);
                            };
                            return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state };
                        };
                        yesAnswer = booleanKnownCached(entailmentCache(run.state.context), term, yesLiteral, true);
                        yesKnown = yesAnswer.holds;
                        if yesKnown {
                            yesContext = assumeRelation(clone(run.state.context), 0, term, yesLiteral);
                            yesContext = assumeBooleanFact(yesContext, term, yesLiteral);
                            yesState = ExecutionState { context: yesContext, ..run.state };
                            return walkExecution(blocks, branch.yes, yesState, fuel - 1, loops);
                        };
                        noKnown = booleanKnownCached(yesAnswer.cache, term, noLiteral, false).holds;
                        if noKnown = false {
                            yesContext = assumeRelation(clone(run.state.context), 0, term, yesLiteral);
                            yesContext = assumeBooleanFact(yesContext, term, yesLiteral);
                            yesState = ExecutionState { context: yesContext, ..clone(run.state) };
                            yesResult = walkExecution(blocks, branch.yes, yesState, fuel - 1, clone(loops));
                            if yesResult.status != 0 { return yesResult; };
                        };
                        noContext = assumeRelation(clone(run.state.context), 0, term, noLiteral);
                        noContext = assumeBooleanFact(noContext, term, noLiteral);
                        noState = ExecutionState { context: noContext, ..run.state };
                        return walkExecution(blocks, branch.no, noState, fuel - 1, loops);
                    };
                };
            };
            return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state };
        };
        if end is ExecutionEnd::Branch {
            branch = end as ExecutionEnd::Branch;
            yes = executeSteps(clone(run.state), branch.yesSteps);
            if yes.status != 0 { return ExecutionFlowResult { status: yes.status, block: id, step: yes.failedAt, state: yes.state }; };
            yesResult = walkExecution(blocks, branch.yes, yes.state, fuel - 1, clone(loops));
            if yesResult.status != 0 { return yesResult; };
            no = executeSteps(run.state, branch.noSteps);
            if no.status != 0 { return ExecutionFlowResult { status: no.status, block: id, step: no.failedAt, state: no.state }; };
            return walkExecution(blocks, branch.no, no.state, fuel - 1, loops);
        };
        return ExecutionFlowResult { status: 2, block: id, step: -1, state: run.state };
    };
    return ExecutionFlowResult { status: 3, block: id, step: -1, state: clone(initial) };
};

fn validateExecution(blocks: &List<ExecutionBlock>, entry: Int, initial: &ExecutionState) -> ExecutionFlowResult {
    if uniqueExecutionBlocks(blocks) = false {
        return ExecutionFlowResult { status: 3, block: entry, step: -1, state: clone(initial) };
    };
    return walkExecution(executionTable(blocks), entry, initial, 2 * size(blocks) + 2, []);
};
