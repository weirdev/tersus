import validation::context { closeContext, knownVariant };
import validation::differences { safeBoundDifference, safeBoundSum };
import validation::evaluation { addOffsetFacts, builtinFacts, contextWithApplication, readThroughSequence, recordEvaluatedSize, recordEvaluatedValue, stateWithApplication, stateWithConstant };
import validation::joins { mint, splitReadOverWrite };
import validation::model { ApplicationTerm, ArgumentsLookup, ConstantTerm, DisequalityFact, EqualityFact, ExecutionResult, ExecutionState, ExecutionStep, FactIndex, IntegerLookup, Minted, NearApplications, OrderFact, Saturation, Stepped, StepsRun, SumResult, ValidatorContext, ValidatorGoal, ValueLookup, ValueRef, VariantFact };
import validation::relations { boolAt, containsValue, emptyIntMap, equalArguments, hasEquality, intAt, leastClasses };
import validation::saturation { noBlocked, noClosed, noDoneKeys, proveBySaturation };
import validation::state { assumesForall, bindLocal, booleanCheck, localsUndone, stateLocalsBefore, noTemplates, resolveArguments, resolveValue, termInUse };
import validation::validation { GoalSlice, Truncated, chainSlice, entailsGoal, goalSlice, goalTerms, indexFacts, linkedWithin, nearApplications, noFactIndex, termOfValue, truncatedState, valueNear };



fn quietStep(given: &ExecutionStep) -> ExecutionStep {
    if given is ExecutionStep::Check {
        c = given as ExecutionStep::Check;
        if c.relation >= 0 && c.relation <= 3 { return ExecutionStep::Check { relation: c.relation + 10, left: c.left, right: c.right }; };
    };
    return clone(given);
};

// relation: 0 is equality, 1 disequality, 2 strict less, 3 non-strict less.
// Any other relation code is rejected rather than guessed.
fn localGoal(relation: Int, left: Int, right: Int) -> ValidatorGoal {
    if relation = 0 { return ValidatorGoal::Equal { left: left, right: right }; };
    if relation = 1 { return ValidatorGoal::Different { left: left, right: right }; };
    if relation = 2 { return ValidatorGoal::Less { left: left, right: right }; };
    return ValidatorGoal::AtMost { left: left, right: right };
};

// Only the trusted MIR bridge may add an edge condition as an assumption.
fn assumeRelation(context: ValidatorContext, relation: Int, left: Int, right: Int) -> ValidatorContext {
    if relation = 0 && hasEquality(context.equalities, left, right) { return context; };
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    if relation = 0 { equalities = push(equalities, EqualityFact { left: left, right: right }); };
    if relation = 1 { different = push(different, DisequalityFact { left: left, right: right }); };
    if relation = 2 { orders = push(orders, OrderFact { smaller: left, greater: right, strict: true }); };
    if relation > 2 || relation < 0 { orders = push(orders, OrderFact { smaller: left, greater: right, strict: false }); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

// A comparison result can be copied across blocks before it is branched on.
// Its arguments name the values captured when it was evaluated, so derive the
// relation from those terms rather than from the current local bindings.
fn assumeComparison(context: ValidatorContext, index: &FactIndex, term: Int, truth: Bool) -> ValidatorContext {
    state = context;
    made = nearApplications(state, index, term);
    for app in made.applications {
        if made.terms.contains(app.id) {
            if size(app.arguments) = 2 {
                a = get(app.arguments, 0);
                b = get(app.arguments, 1);
                if app.function = -6 {
                    if truth { state = assumeRelation(state, 0, a, b); } else { state = assumeRelation(state, 1, a, b); };
                };
                if app.function = -7 {
                    if truth { state = assumeRelation(state, 1, a, b); } else { state = assumeRelation(state, 0, a, b); };
                };
                if app.function = -8 {
                    if truth { state = assumeRelation(state, 2, a, b); } else { state = assumeRelation(state, 3, b, a); };
                };
                if app.function = -9 {
                    if truth { state = assumeRelation(state, 3, a, b); } else { state = assumeRelation(state, 2, b, a); };
                };
                if app.function = -10 {
                    if truth { state = assumeRelation(state, 2, b, a); } else { state = assumeRelation(state, 3, a, b); };
                };
                if app.function = -11 {
                    if truth { state = assumeRelation(state, 3, b, a); } else { state = assumeRelation(state, 2, a, b); };
                };
            };
        };
    };
    return state;
};

fn assumeBooleanFact(context: ValidatorContext, index: &FactIndex, left: Int, right: Int) -> ValidatorContext {
    // (the comparisons a literal on either side decides, found before the context changes)
    terms = [];
    truths = [];
    leftAt = index.constantAt.lookup(left, -1);
    if leftAt >= 0 && leftAt < size(context.constants) {
        if get(context.constants, leftAt).kind = 1 && get(context.constants, leftAt).id = left { terms = push(terms, right); truths = push(truths, get(context.constants, leftAt).value = 1); };
    };
    rightAt = index.constantAt.lookup(right, -1);
    if rightAt >= 0 && rightAt < size(context.constants) {
        if get(context.constants, rightAt).kind = 1 && get(context.constants, rightAt).id = right { terms = push(terms, left); truths = push(truths, get(context.constants, rightAt).value = 1); };
    };
    state = context;
    for k in 0..size(terms) { state = assumeComparison(state, index, get(terms, k), boolAt(truths, k, false)); };
    return state;
};

// (the state is borrowed whole: a field passed with other arguments that are
// computed is passed as a copy of it)
fn valueOf(state: &ExecutionState, index: &FactIndex, term: Int) -> IntegerLookup {
    return valueNear(state.context, index, term);
};

fn madeOf(state: &ExecutionState, index: &FactIndex, term: Int) -> NearApplications {
    return nearApplications(state.context, index, term);
};

fn holdsIn(state: &ExecutionState, index: &FactIndex, goal: ValidatorGoal) -> Bool {
    return entailsIn(state.context, index, goal);
};

fn indexTo(index: FactIndex, state: &ExecutionState) -> FactIndex {
    return indexFacts(index, state.context);
};

fn stateWithLocal(state: ExecutionState, local: Int, term: Int) -> ExecutionState {
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    return ExecutionState { context: context, locals: bindLocal(locals, local, term), templates: templates, floor: floor };
};

fn readThrough(state: ExecutionState, index: &FactIndex, result: Int, list: Int, at: Int) -> ExecutionState {
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    return ExecutionState { context: readThroughSequence(context, index, result, list, at), locals: locals, templates: templates, floor: floor };
};

fn sequenceLength(state: &ExecutionState, index: &FactIndex, list: Int) -> ValueLookup {
    made = madeOf(state, index, list);
    for app in made.applications {
        if app.function = -13 {
            if size(app.arguments) = 1 {
                if made.terms.contains(get(app.arguments, 0)) {
                    return ValueLookup::Found { term: app.id };
                };
            };
        };
    };
    return ValueLookup::Missing;
};

fn stepped(status: Int, failedAt: Int, state: ExecutionState, index: FactIndex) -> Stepped {
    return Stepped { result: ExecutionResult { status: status, failedAt: failedAt, state: state }, index: index };
};

// Trusted list construction: the new length is the old length plus one,
// and the element at the old length is the appended value. The MIR bridge
// supplies a validated list and a literal zero.
// A recorded read is not known to be in range: a get written in a contract,
// an affirm or a loop invariant is a term with no bounds of its own
// (SelfHostedMir proofOperand), and builtinFacts hands every such get to
// readThroughSequence, so being recorded says nothing about where it came
// from. Four routes therefore require the index to be proved in the old
// list before a read crosses a push: this function, readThroughSequence's
// push case, writeOf for the goal splitter, and forallPairInRange for a
// range fact. The shift fact (-33) reads a push in forallShiftFromFact
// under a bound on the length alone; it was left as it is, with no failing
// program found for it. popSequence keeps a read only at an index it knows
// is in the shortened list.
fn pushSequence(initial: ExecutionState, facts: FactIndex, local: Int, list: Int, value: Int, zero: Int) -> Stepped {
    z = valueOf(initial, facts, zero);
    if z is IntegerLookup::Found {
        if (z as IntegerLookup::Found).value != 0 { return stepped(2, -1, initial, facts); };
    } else { return stepped(2, -1, initial, facts); };
    length = sequenceLength(initial, facts, list);
    state = initial;
    oldLength = zero;
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
    } else {
        Minted { state: sized, term: made } = mint(state);
        oldLength = made;
        state = stateWithApplication(sized, ApplicationTerm { id: oldLength, function: -13, arguments: push([], list) });
    };
    nonnegative = assumeRelation(state.context, 3, zero, oldLength);
    state = ExecutionState { context: nonnegative, ..state };
    Minted { state: pushed, term: result } = mint(state);
    state = stateWithApplication(pushed, ApplicationTerm { id: result, function: -16, arguments: push(push([], list), value) });
    state = stateWithLocal(state, local, result);
    Minted { state: lengthened, term: newLength } = mint(state);
    state = stateWithApplication(stateWithApplication(lengthened, ApplicationTerm { id: newLength, function: -13, arguments: push([], result) }), ApplicationTerm { id: value, function: -14, arguments: push(push([], result), oldLength) });
    // A read of the old list holds of the new one at the same index, but
    // only where that index is in the old list: push defines the element at
    // the old length, so carrying a read at an index the old list did not
    // have would contradict it. An index that is not proved in range drops
    // its read, which can only lose proofs.
    reads = madeOf(state, facts, list);
    for previous in reads.applications {
        if previous.function = -14 {
            if size(previous.arguments) = 2 {
                if reads.terms.contains(get(previous.arguments, 0)) {
                    at = get(previous.arguments, 1);
                    if holdsIn(state, facts, ValidatorGoal::AtMost { left: zero, right: at }) {
                        if holdsIn(state, facts, ValidatorGoal::Less { left: at, right: oldLength }) {
                            state = stateWithApplication(state, ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), at) });
                        };
                    };
                };
            };
        };
    };
    offset = addOffsetFacts(state.context, newLength, oldLength, 1);
    state = ExecutionState { context: offset, ..state };
    knownLength = valueOf(state, facts, oldLength);
    if knownLength is IntegerLookup::Found {
        increment = safeBoundSum((knownLength as IntegerLookup::Found).value, 1);
        if increment is SumResult::Sum {
            state = stateWithConstant(state, ConstantTerm { id: newLength, kind: 0, value: (increment as SumResult::Sum).value });
        };
    };
    return stepped(0, -1, state, facts);
};

// The term the facts state to have the integer value, or a new one stated to have it
fn constantNear(state: ExecutionState, index: &FactIndex, value: Int) -> Minted {
    known = termOfValue(index, value);
    if known is ValueLookup::Found { return Minted { state: state, term: (known as ValueLookup::Found).term }; };
    Minted { state: minted, term: symbol } = mint(state);
    return Minted { state: stateWithConstant(minted, ConstantTerm { id: symbol, kind: 0, value: value }), term: symbol };
};

// Last is translated when the length is known. A nonempty check is still
// required; unknown lengths remain unsupported by this particular encoding.
fn lastSequence(initial: ExecutionState, facts: FactIndex, local: Int, list: Int, zero: Int) -> Stepped {
    z = valueOf(initial, facts, zero);
    if z is IntegerLookup::Found {
        if (z as IntegerLookup::Found).value != 0 { return stepped(2, -1, initial, facts); };
    } else { return stepped(2, -1, initial, facts); };
    length = sequenceLength(initial, facts, list);
    if length is ValueLookup::Found {
        lengthTerm = (length as ValueLookup::Found).term;
        if holdsIn(initial, facts, ValidatorGoal::Less { left: zero, right: lengthTerm }) = false {
            return stepped(1, -1, initial, facts);
        };
        value = valueOf(initial, facts, lengthTerm);
        if value is IntegerLookup::Found {
            last = safeBoundDifference((value as IntegerLookup::Found).value, 1);
            if last is SumResult::Sum {
                Minted { state: indexed, term: indexTerm } = constantNear(initial, facts, (last as SumResult::Sum).value);
                Minted { state: state, term: result } = mint(indexed);
                state = stateWithApplication(state, ApplicationTerm { id: result, function: -14, arguments: push(push([], list), indexTerm) });
                index = indexTo(facts, state);
                return stepped(0, -1, readThrough(stateWithLocal(state, local, result), index, result, list, indexTerm), index);
            };
        };
        Minted { state: state, term: oneTerm } = constantNear(initial, facts, 1);
        Minted { state: subtracted, term: indexTerm } = mint(state);
        state = stateWithApplication(subtracted, ApplicationTerm { id: indexTerm, function: -2, arguments: push(push([], lengthTerm), oneTerm) });
        offset = addOffsetFacts(state.context, indexTerm, lengthTerm, -1);
        state = ExecutionState { context: offset, ..state };
        Minted { state: read, term: result } = mint(state);
        state = stateWithApplication(read, ApplicationTerm { id: result, function: -14, arguments: push(push([], list), indexTerm) });
        index = indexTo(facts, state);
        return stepped(0, -1, readThrough(stateWithLocal(state, local, result), index, result, list, indexTerm), index);
    };
    return stepped(2, -1, initial, facts);
};

// The bridge checks the index first. The update preserves the length and
// known reads at indices that are concretely different from the updated one.
fn setSequence(initial: ExecutionState, facts: FactIndex, local: Int, list: Int, index: Int, value: Int) -> Stepped {
    length = sequenceLength(initial, facts, list);
    if length is ValueLookup::Missing { return stepped(2, -1, initial, facts); };
    updatedIndex = valueOf(initial, facts, index);
    reads = madeOf(initial, facts, list);
    Minted { state: state, term: result } = mint(initial);
    state = stateWithApplication(state, ApplicationTerm { id: result, function: -17, arguments: push(push(push([], list), index), value) });
    state = stateWithApplication(state, ApplicationTerm { id: (length as ValueLookup::Found).term, function: -13, arguments: push([], result) });
    state = stateWithApplication(state, ApplicationTerm { id: value, function: -14, arguments: push(push([], result), index) });
    for previous in reads.applications {
        if previous.function = -14 {
            if size(previous.arguments) = 2 {
                if reads.terms.contains(get(previous.arguments, 0)) {
                    at = get(previous.arguments, 1);
                    other = valueOf(state, facts, at);
                    if updatedIndex is IntegerLookup::Found {
                        if other is IntegerLookup::Found {
                            if (updatedIndex as IntegerLookup::Found).value != (other as IntegerLookup::Found).value {
                                state = stateWithApplication(state, ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), get(previous.arguments, 1)) });
                            };
                        };
                    };
                };
            };
        };
    };
    return stepped(0, -1, stateWithLocal(state, local, result), facts);
};

// The bridge checks nonemptiness first. For a known length, removing the
// final element preserves every recorded read below the new length.
fn popSequence(initial: ExecutionState, facts: FactIndex, local: Int, list: Int) -> Stepped {
    length = sequenceLength(initial, facts, list);
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
        value = valueOf(initial, facts, oldLength);
        if value is IntegerLookup::Found {
            shortened = safeBoundDifference((value as IntegerLookup::Found).value, 1);
            if shortened is SumResult::Sum {
                newLengthValue = (shortened as SumResult::Sum).value;
                reads = madeOf(initial, facts, list);
                Minted { state: state, term: result } = mint(initial);
                state = stateWithApplication(state, ApplicationTerm { id: result, function: -18, arguments: push([], list) });
                state = stateWithLocal(state, local, result);
                Minted { state: lengthened, term: lengthTerm } = constantNear(state, facts, newLengthValue);
                state = stateWithApplication(lengthened, ApplicationTerm { id: lengthTerm, function: -13, arguments: push([], result) });
                for previous in reads.applications {
                    if previous.function = -14 {
                        if size(previous.arguments) = 2 {
                            if reads.terms.contains(get(previous.arguments, 0)) {
                                at = get(previous.arguments, 1);
                                index = valueOf(state, facts, at);
                                if index is IntegerLookup::Found {
                                    i = (index as IntegerLookup::Found).value;
                                    if i >= 0 {
                                        if i < newLengthValue {
                                            state = stateWithApplication(state, ApplicationTerm { id: previous.id, function: -14, arguments: push(push([], result), get(previous.arguments, 1)) });
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
                return stepped(0, -1, state, facts);
            };
        };
    };
    // A length that is not a number: the result is one shorter, as a term
    // (its size is size(list) - 1; the walk has checked size(list) > 0)
    state = initial;
    oldLength = 0;
    if length is ValueLookup::Found {
        oldLength = (length as ValueLookup::Found).term;
    } else {
        Minted { state: sized, term: made } = mint(state);
        oldLength = made;
        state = stateWithApplication(sized, ApplicationTerm { id: oldLength, function: -13, arguments: push([], list) });
    };
    Minted { state: withOne, term: oneTerm } = constantNear(state, facts, 1);
    Minted { state: popped, term: result } = mint(withOne);
    state = stateWithApplication(popped, ApplicationTerm { id: result, function: -18, arguments: push([], list) });
    state = stateWithLocal(state, local, result);
    Minted { state: shorter, term: newLength } = mint(state);
    state = stateWithApplication(shorter, ApplicationTerm { id: newLength, function: -2, arguments: push(push([], oldLength), oneTerm) });
    state = stateWithApplication(state, ApplicationTerm { id: newLength, function: -13, arguments: push([], result) });
    return stepped(0, -1, state, facts);
};

// Pure applications with the same function and exact arguments denote the
// same value. Reusing that value avoids growing the context at every read.
fn existingApplication(context: &ValidatorContext, function: Int, args: &List<Int>) -> ValueLookup {
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        if app.function = function {
            if equalArguments(emptyIntMap(), app.arguments, args) {
                return ValueLookup::Found { term: app.id };
            };
        };
    };
    return ValueLookup::Missing;
};

// The same for a step, found on the first links of its lightest argument; a
// miss makes a new term, which congruence equates with the one missed
// wherever both are in reach.
fn knownApplication(state: &ExecutionState, index: &FactIndex, function: Int, args: &List<Int>) -> ValueLookup {
    if size(args) = 0 { return ValueLookup::Missing; };
    lightest = get(args, 0);
    for a in args { if index.weights.lookup(a, 0) < index.weights.lookup(lightest, 0) { lightest = a; }; };
    for p in linkedWithin(index.applications, lightest, firstRung()) {
        if p >= 0 && p < size(state.context.applications) {
            app = get(state.context.applications, p);
            if app.function = function {
                if equalArguments(emptyIntMap(), app.arguments, args) {
                    return ValueLookup::Found { term: app.id };
                };
            };
        };
    };
    return ValueLookup::Missing;
};

// The steps of a block in order, as far as the first that fails (a step of a kind not known fails as unsupported)
fn executeSteps(initial: ExecutionState, steps: &List<ExecutionStep>) -> ExecutionResult {
    run = executeStepsWithin(initial, noFactIndex(), steps, maxScopeDepth());
    StepsRun { result: result, index: index } = run;
    return result;
};

// The steps on a state and an index of it, which they extend and give back
fn executeIndexed(initial: ExecutionState, index: FactIndex, steps: &List<ExecutionStep>) -> StepsRun {
    run = executeStepsWithin(initial, index, steps, maxScopeDepth());
    StepsRun { result: result, index: after } = run;
    return StepsRun { index: consistentWith(after, result), result: result };
};

// The index unless it indexes a position past the result state's lists (a
// step that failed after extending it for facts it then dropped): a stale
// position could name a term whose fact the state no longer has
fn consistentIndex(index: FactIndex, state: &ExecutionState) -> FactIndex {
    sizes = contextSizes(state);
    for k in 0..size(sizes) {
        if intAt(index.counts, k, 0) > intAt(sizes, k, 0) { return indexFacts(noFactIndex(), state.context); };
    };
    return index;
};

fn consistentWith(index: FactIndex, result: &ExecutionResult) -> FactIndex {
    return consistentIndex(index, result.state);
};

// Scoped steps nested deeper than this are refused as unsupported.
fn maxScopeDepth() -> Int [{ }] [{ affirm return >= 0; }] {
    return 16;
};

fn executeStepsWithin(initial: ExecutionState, given: FactIndex, steps: &List<ExecutionStep>, depth: Int) -> StepsRun [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 1 {
    state = initial;
    index = given;
    for i in 0..size(steps) {
        before = contextSizes(state);
        if asksFacts(get(steps, i)) {
            index = indexTo(index, state);
            Stepped { result: result, index: after } = stepAsking(state, get(steps, i), i, index);
            if result.status != 0 { return StepsRun { result: result, index: after }; };
            state = stateOf(result);
            index = after;
        } else if get(steps, i) is ExecutionStep::Scoped && depth > 0 {
            StepsRun { result: result, index: after } = scopedRun(state, index, (get(steps, i) as ExecutionStep::Scoped).steps, i, depth - 1);
            if result.status != 0 { return StepsRun { result: result, index: after }; };
            state = stateOf(result);
            index = after;
        } else {
            result = executeStep(state, get(steps, i), i);
            if result.status != 0 { return StepsRun { result: result, index: index }; };
            state = stateOf(result);
            if addsFactsOnly(get(steps, i)) = false { index = noFactIndex(); };
        };
        // (and, should a step ever drop a fact, a list that got shorter drops it too)
        if shrank(before, contextSizes(state)) { index = noFactIndex(); };
        seeds = assumedTerms(state, get(steps, i));
        if size(seeds) > 0 {
            index = indexTo(index, state);
            if unreachableAt(state, index, seeds) { return StepsRun { result: ExecutionResult { status: 0, failedAt: -2, state: state }, index: index }; };
        };
    };
    return StepsRun { result: ExecutionResult { status: 0, failedAt: -1, state: state }, index: index };
};

// A scoped body runs on the state itself and is then undone: its facts are
// cut off with their links, its locals and templates put back, and its floor
// restored, so nothing it assumed survives it.
fn scopedRun(state: ExecutionState, index: FactIndex, steps: &List<ExecutionStep>, i: Int, depth: Int) -> StepsRun [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 2 {
    sizes = contextSizes(state);
    undo = stateLocalsBefore([], state, steps);
    keepTemplates = assumesForall(steps);
    saved = noTemplates();
    if keepTemplates { saved = clone(state.templates); };
    floor = state.floor;
    StepsRun { result: result, index: after } = executeStepsWithin(state, index, steps, depth);
    ExecutionResult { status: status, failedAt: failedAt, state: ran } = result;
    checked = consistentIndex(after, ran);
    Truncated { state: cut, index: cutIndex } = truncatedState(ran, checked, sizes);
    ExecutionState { context: context, locals: locals, templates: templates, floor: lowered } = cut;
    if keepTemplates { templates = saved; };
    restored = ExecutionState { context: context, locals: localsUndone(locals, undo, 0), templates: templates, floor: floor };
    if status != 0 { return StepsRun { result: ExecutionResult { status: status, failedAt: i, state: restored }, index: cutIndex }; };
    return StepsRun { result: ExecutionResult { status: 0, failedAt: -1, state: restored }, index: cutIndex };
};

// The steps that ask the facts a question: each is given the trunk's index,
// extended to the state it starts from, and answers on slices of it
fn asksFacts(step: &ExecutionStep) -> Bool {
    if step is ExecutionStep::Check || step is ExecutionStep::Push || step is ExecutionStep::Last || step is ExecutionStep::CheckWithin || step is ExecutionStep::RequireVariant { return true; };
    return step is ExecutionStep::Apply || step is ExecutionStep::ApplyFresh || step is ExecutionStep::Literal || step is ExecutionStep::Set || step is ExecutionStep::Pop || step is ExecutionStep::Assume;
};

fn stepAsking(state: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    if step is ExecutionStep::Check { return stepCheck(state, step, i, facts); };
    if step is ExecutionStep::Push { return stepPush(state, step, i, facts); };
    if step is ExecutionStep::Last { return stepLast(state, step, i, facts); };
    if step is ExecutionStep::CheckWithin { return stepCheckWithin(state, step, i, facts); };
    if step is ExecutionStep::RequireVariant { return stepRequireVariant(state, step, i, facts); };
    if step is ExecutionStep::Apply { return stepApply(state, step, i, facts); };
    if step is ExecutionStep::ApplyFresh { return stepApplyFresh(state, step, i, facts); };
    if step is ExecutionStep::Literal { return stepLiteral(state, step, i, facts); };
    if step is ExecutionStep::Set { return stepSet(state, step, i, facts); };
    if step is ExecutionStep::Pop { return stepPop(state, step, i, facts); };
    if step is ExecutionStep::Assume { return stepAssume(state, step, i, facts); };
    return stepped(2, i, state, facts);
};

// (each of these takes the state whole: an argument that is a field of a value
// the loop moves later is passed as a copy)
fn stateOf(result: ExecutionResult) -> ExecutionState {
    ExecutionResult { status: status, failedAt: failedAt, state: state } = result;
    return state;
};

fn contextSizes(state: &ExecutionState) -> List<Int> {
    return push(push(push(push(push(push(push([], size(state.context.equalities)), size(state.context.applications)), size(state.context.constants)), size(state.context.orders)), size(state.context.different)), size(state.context.variants)), size(state.context.differences));
};

fn shrank(before: &List<Int>, after: &List<Int>) -> Bool {
    for k in 0..size(before) { if intAt(before, k, 0) > intAt(after, k, 0) { return true; }; };
    return false;
};

fn addsFactsOnly(step: &ExecutionStep) -> Bool {
    if step is ExecutionStep::Assign || step is ExecutionStep::Apply || step is ExecutionStep::ApplyFresh || step is ExecutionStep::Literal { return true; };
    if step is ExecutionStep::Push || step is ExecutionStep::Last || step is ExecutionStep::Set || step is ExecutionStep::Pop || step is ExecutionStep::NewArray { return true; };
    if step is ExecutionStep::Havoc || step is ExecutionStep::RequireDefined || step is ExecutionStep::Check || step is ExecutionStep::Assume { return true; };
    if step is ExecutionStep::AssumeVariant || step is ExecutionStep::RequireVariant || step is ExecutionStep::CheckWithin || step is ExecutionStep::AssumeForall { return true; };
    if step is ExecutionStep::Scoped { return true; };
    return false;
};

fn executeStep(state: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    if step is ExecutionStep::Assign { return stepAssign(state, step, i); };
    if step is ExecutionStep::NewArray { return stepNewArray(state, step, i); };
    if step is ExecutionStep::Havoc { return stepHavoc(state, step, i); };
    if step is ExecutionStep::RequireDefined { return stepRequireDefined(state, step, i); };
    if step is ExecutionStep::AssumeForall { return stepAssumeForall(state, step, i); };
    if step is ExecutionStep::AssumeVariant { return stepAssumeVariant(state, step, i); };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepAssign(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Assign {
        assign = step as ExecutionStep::Assign;
        value = resolveValue(state, assign.value);
        if value is ValueLookup::Found {
            locals = bindLocal(state.locals, assign.local, (value as ValueLookup::Found).term);
            state = ExecutionState { locals: locals, ..state };
        } else {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

// The application as a fact, what the builtins know of it, and its value
// where concrete evaluation knows it
fn withApplied(state: ExecutionState, facts: FactIndex, function: Int, result: Int, terms: &List<Int>) -> Stepped {
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    applied = contextWithApplication(context, ApplicationTerm { id: result, function: function, arguments: clone(terms) });
    index = indexFacts(facts, applied);
    built = builtinFacts(applied, index, function, result, terms);
    index = indexFacts(index, built);
    recorded = recordEvaluatedValue(ExecutionState { context: built, locals: locals, templates: templates, floor: floor }, index, result);
    return stepped(0, -1, recorded, index);
};

fn stepApply(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Apply {
        apply = step as ExecutionStep::Apply;
        args = resolveArguments(state, apply.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            if termInUse(state, facts, apply.result) { return stepped(2, i, state, facts); };
            if apply.result = apply.function { return stepped(2, i, state, facts); };
            if containsValue(terms, apply.result) { return stepped(2, i, state, facts); };
            return withApplied(stateWithLocal(state, apply.local, apply.result), facts, apply.function, apply.result, terms);
        };
    };
    return stepped(2, i, state, facts);
};

// (what a list or array literal is, the same term everywhere: known
// again where a block names it, and nothing new where it is known)
fn stepLiteral(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Literal {
        literal = step as ExecutionStep::Literal;
        args = resolveArguments(state, literal.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            known = false;
            made = madeOf(state, facts, literal.result);
            for a in made.applications {
                if a.id = literal.result && a.function = literal.function && a.arguments = terms { known = true; };
            };
            if known { return stepped(0, -1, state, facts); };
            return withApplied(state, facts, literal.function, literal.result, terms);
        };
    };
    return stepped(2, i, state, facts);
};

fn stepApplyFresh(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::ApplyFresh {
        apply = step as ExecutionStep::ApplyFresh;
        args = resolveArguments(state, apply.arguments);
        if args is ArgumentsLookup::Found {
            terms = (args as ArgumentsLookup::Found).terms;
            existing = knownApplication(state, facts, apply.function, terms);
            if existing is ValueLookup::Found {
                return stepped(0, -1, stateWithLocal(state, apply.local, (existing as ValueLookup::Found).term), facts);
            };
            Minted { state: minted, term: resultId } = mint(state);
            if resultId = apply.function { return stepped(2, i, minted, facts); };
            if containsValue(terms, resultId) { return stepped(2, i, minted, facts); };
            return withApplied(stateWithLocal(minted, apply.local, resultId), facts, apply.function, resultId, terms);
        };
    };
    return stepped(2, i, state, facts);
};

// A helper's result as the step's, failing at the step
fn atStep(made: Stepped, i: Int) -> Stepped {
    Stepped { result: result, index: index } = made;
    return resultAt(result, index, i);
};

fn resultAt(result: ExecutionResult, index: FactIndex, i: Int) -> Stepped {
    ExecutionResult { status: status, failedAt: failedAt, state: state } = result;
    if status != 0 { return stepped(status, i, state, index); };
    return stepped(0, -1, state, index);
};

// The same, with the made list's size where concrete evaluation can count it
fn sizedAfter(made: Stepped, i: Int, local: Int) -> Stepped {
    Stepped { result: result, index: index } = made;
    return sizedResult(result, index, i, local);
};

fn sizedResult(result: ExecutionResult, index: FactIndex, i: Int, local: Int) -> Stepped {
    ExecutionResult { status: status, failedAt: failedAt, state: state } = result;
    if status != 0 { return stepped(status, i, state, index); };
    return withEvaluatedSize(state, index, local);
};

fn withEvaluatedSize(state: ExecutionState, facts: FactIndex, local: Int) -> Stepped {
    index = indexTo(facts, state);
    made = resolveValue(state, ValueRef::Local { local: local });
    if made is ValueLookup::Found {
        sized = recordEvaluatedSize(state, index, (made as ValueLookup::Found).term);
        return stepped(0, -1, sized, index);
    };
    return stepped(0, -1, state, index);
};

fn stepPush(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Push {
        pushStep = step as ExecutionStep::Push;
        list = resolveValue(state, pushStep.list);
        value = resolveValue(state, pushStep.value);
        zero = resolveValue(state, pushStep.zero);
        if list is ValueLookup::Found {
            if value is ValueLookup::Found {
                if zero is ValueLookup::Found {
                    return sizedAfter(pushSequence(state, facts, pushStep.local, (list as ValueLookup::Found).term, (value as ValueLookup::Found).term, (zero as ValueLookup::Found).term), i, pushStep.local);
                };
            };
        };
    };
    return stepped(2, i, state, facts);
};

fn stepLast(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Last {
        last = step as ExecutionStep::Last;
        list = resolveValue(state, last.list);
        zero = resolveValue(state, last.zero);
        if list is ValueLookup::Found {
            if zero is ValueLookup::Found {
                return atStep(lastSequence(state, facts, last.local, (list as ValueLookup::Found).term, (zero as ValueLookup::Found).term), i);
            };
        };
    };
    return stepped(2, i, state, facts);
};

fn stepSet(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Set {
        setStep = step as ExecutionStep::Set;
        list = resolveValue(state, setStep.list);
        index = resolveValue(state, setStep.index);
        value = resolveValue(state, setStep.value);
        if list is ValueLookup::Found {
            if index is ValueLookup::Found {
                if value is ValueLookup::Found {
                    return sizedAfter(setSequence(state, facts, setStep.local, (list as ValueLookup::Found).term, (index as ValueLookup::Found).term, (value as ValueLookup::Found).term), i, setStep.local);
                };
            };
        };
    };
    return stepped(2, i, state, facts);
};

fn stepPop(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Pop {
        popStep = step as ExecutionStep::Pop;
        list = resolveValue(state, popStep.list);
        if list is ValueLookup::Found {
            return sizedAfter(popSequence(state, facts, popStep.local, (list as ValueLookup::Found).term), i, popStep.local);
        };
    };
    return stepped(2, i, state, facts);
};

fn stepNewArray(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::NewArray {
        array = step as ExecutionStep::NewArray;
        length = resolveValue(state, array.length);
        value = resolveValue(state, array.value);
        if length is ValueLookup::Found {
            if value is ValueLookup::Found {
                Minted { state: minted, term: result } = mint(state);
                lengthTerm = (length as ValueLookup::Found).term;
                valueTerm = (value as ValueLookup::Found).term;
                made = stateWithApplication(stateWithApplication(minted, ApplicationTerm { id: result, function: -19, arguments: push(push([], lengthTerm), valueTerm) }), ApplicationTerm { id: lengthTerm, function: -13, arguments: push([], result) });
                return ExecutionResult { status: 0, failedAt: -1, state: stateWithLocal(made, array.local, result) };
            };
        };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepHavoc(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::Havoc {
        havoc = step as ExecutionStep::Havoc;
        Minted { state: minted, term: fresh } = mint(state);
        return ExecutionResult { status: 0, failedAt: -1, state: stateWithLocal(minted, havoc.local, fresh) };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepRequireDefined(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::RequireDefined {
        required = step as ExecutionStep::RequireDefined;
        value = resolveValue(state, required.value);
        if value is ValueLookup::Missing {
            return ExecutionResult { status: 2, failedAt: i, state: state };
        };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

// The ladder of budgets a check's slices are taken at: each a fresh walk
// from the goal terms, so a hub too heavy for a cheap rung is expanded only
// after the cheaper rungs have failed.
fn sliceBudgets() -> List<Int> { return push(push(push(push(push([], firstRung()), 128), 256), 512), lastRung()); };

fn firstRung() -> Int [{ }] [{ affirm return >= 0; }] { return 64; };

fn lastRung() -> Int [{ }] [{ affirm return >= 0; }] { return 1024; };

fn assumedTerms(state: &ExecutionState, step: &ExecutionStep) -> List<Int> {
    if step is ExecutionStep::Assume {
        assumed = step as ExecutionStep::Assume;
        left = resolveValue(state, assumed.left);
        right = resolveValue(state, assumed.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found { return push(push([], (left as ValueLookup::Found).term), (right as ValueLookup::Found).term); };
        };
    };
    if step is ExecutionStep::AssumeVariant {
        object = resolveValue(state, (step as ExecutionStep::AssumeVariant).object);
        if object is ValueLookup::Found { return push([], (object as ValueLookup::Found).term); };
    };
    return [];
};

// Whether the facts within the first rung's reach of the seeds contradict each
// other (only a contradiction entails x < x; a walk the budget cut short proves
// nothing about the facts it left out)
fn unreachableAt(state: &ExecutionState, index: &FactIndex, seeds: &List<Int>) -> Bool {
    if size(seeds) = 0 { return false; };
    probe = get(seeds, 0);
    return entailsGoal(goalSlice(state.context, index, seeds, firstRung()).slice, ValidatorGoal::Less { left: probe, right: probe });
};

// A refused answer carries the last walk: the heavier engines are given its facts.
struct SliceAnswer { holds: Bool, budget: Int, admitted: Int, operations: Int, walk: GoalSlice };

fn checkInSlices(context: &ValidatorContext, index: &FactIndex, relation: Int, a: Int, b: Int) -> SliceAnswer {
    g = localGoal(relation, a, b);
    return goalInSlices(context, index, goalTerms(g), g, relation);
};

// The goal on each rung's slice from the seeds; a relation of 0 or 1 also asks
// the Boolean check of the goal's two terms.
fn goalInSlices(context: &ValidatorContext, index: &FactIndex, seeds: &List<Int>, goal: ValidatorGoal, relation: Int) -> SliceAnswer {
    terms = goalTerms(goal);
    a = intAt(terms, 0, 0);
    b = intAt(terms, 1, 0);
    budgets = sliceBudgets();
    answer = rungAnswer(goalSlice(context, index, seeds, firstRung()), clone(goal), relation, a, b, firstRung(), 0, 0);
    for r in 0..size(budgets) {
        if r > 0 && answer.holds = false && answer.walk.capped {
            budget = intAt(budgets, r, lastRung());
            answer = rungAnswer(goalSlice(context, index, seeds, budget), clone(goal), relation, a, b, budget, answer.admitted, answer.operations);
        };
    };
    return answer;
};

fn rungAnswer(walk: GoalSlice, goal: ValidatorGoal, relation: Int, a: Int, b: Int, budget: Int, admitted: Int, operations: Int) -> SliceAnswer {
    proved = entailsGoal(walk.slice, goal) || booleanCheck(walk.slice, relation, a, b);
    rung = -1;
    if proved { rung = budget; };
    return SliceAnswer { holds: proved, budget: rung, admitted: admitted + walk.admitted, operations: operations + walk.operations, walk: walk };
};

fn entailsIn(context: &ValidatorContext, index: &FactIndex, goal: ValidatorGoal) -> Bool {
    return goalInSlices(context, index, goalTerms(goal), goal, -1).holds;
};

fn checkNear(context: &ValidatorContext, index: &FactIndex, relation: Int, a: Int, b: Int) -> Bool {
    return checkInSlices(context, index, relation, a, b).holds;
};

fn variantInSlices(context: &ValidatorContext, index: &FactIndex, term: Int, family: Int, constructor: Int) -> Bool {
    budgets = sliceBudgets();
    for r in 0..size(budgets) {
        walk = goalSlice(context, index, push([], term), get(budgets, r));
        if knownVariant(leastClasses(closeContext(walk.slice)), walk.slice.variants, term, family, constructor) = 1 { return true; };
        if walk.capped = false { return false; };
    };
    return false;
};

fn stepCheck(initial: ExecutionState, step: &ExecutionStep, i: Int, index: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Check {
        check0 = step as ExecutionStep::Check;
        // (a relation code past 10 is a quiet check: a candidate invariant the
        // inference tries, which is not worth case splits when it fails)
        quiet = check0.relation >= 10;
        relation = check0.relation;
        if quiet { relation = relation - 10; };
        if relation < 0 { return stepped(2, i, state, index); };
        if relation > 3 { return stepped(2, i, state, index); };
        left = resolveValue(state, check0.left);
        right = resolveValue(state, check0.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                a = (left as ValueLookup::Found).term;
                b = (right as ValueLookup::Found).term;
                sliced = checkInSlices(state.context, index, relation, a, b);
                SliceAnswer { holds: ok, budget: rung, admitted: admitted, operations: operations, walk: walk } = sliced;
                if ok = false && quiet = false {
                    // (a term the engines make must be new to the whole state, not
                    // only to the slice: the goal's own terms can be ones the slice
                    // holds no fact of)
                    floor = state.floor;
                    near = ExecutionState { context: chainSlice(state.context, index, push(push([], a), b), lastRung(), walk), locals: clone(state.locals), templates: clone(state.templates), floor: floor };
                    ok = entailsGoal(near.context, localGoal(relation, a, b)) || booleanCheck(near.context, relation, a, b);
                    if ok = false && size(near.templates) > 0 {
                        // (each saturation of a large slice is costly: a check it cannot
                        // prove is given up after fewer of them)
                        saturations = 40;
                        if size(near.context.applications) > 150 { saturations = 12; };
                        ok = proveBySaturation(Saturation { state: clone(near), births: emptyIntMap(), done: noDoneKeys(), blocked: noBlocked(), closed: noClosed() }, relation, a, b, 8, saturations, noBlocked(), floor).holds;
                    };
                    if ok = false {
                        // (a small slice affords more cases: each costs about its size)
                        budget = 8;
                        if size(near.context.applications) < 200 { budget = 24; };
                        ok = splitReadOverWrite(near, localGoal(relation, a, b), 3, budget, floor).holds;
                    };
                };
                if ok = false { return stepped(1, i, state, index); };
                checked = assumedState(state, index, relation, a, b);
                return stepped(0, -1, checked, index);
            };
        };
    };
    return stepped(2, i, state, index);
};

// A relation that holds now, and the comparisons a literal on either side of an equality decides
fn assumedState(state: ExecutionState, index: &FactIndex, relation: Int, a: Int, b: Int) -> ExecutionState {
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    assumed = assumeRelation(context, relation, a, b);
    if relation = 0 { assumed = assumeBooleanFact(assumed, index, a, b); };
    return ExecutionState { context: assumed, locals: locals, templates: templates, floor: floor };
};

fn stateWithVariant(state: ExecutionState, fact: VariantFact) -> ExecutionState {
    ExecutionState { context: context, locals: locals, templates: templates, floor: floor } = state;
    return ExecutionState { context: contextWithVariant(context, fact), locals: locals, templates: templates, floor: floor };
};

fn contextWithVariant(context: ValidatorContext, fact: VariantFact) -> ValidatorContext {
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = context;
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: push(variants, fact), fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn stepAssumeForall(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::AssumeForall {
        assumed = step as ExecutionStep::AssumeForall;
        newTemplate = clone(assumed.template);
        kept = noTemplates();
        for t in state.templates { if t.id != newTemplate.id { kept = push(kept, clone(t)); }; };
        kept = push(kept, newTemplate);
        state = ExecutionState { templates: kept, ..state };
        return ExecutionResult { status: 0, failedAt: -1, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepAssume(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::Assume {
        assumed = step as ExecutionStep::Assume;
        if assumed.relation < 0 { return stepped(2, i, state, facts); };
        if assumed.relation > 3 { return stepped(2, i, state, facts); };
        left = resolveValue(state, assumed.left);
        right = resolveValue(state, assumed.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                assumedNow = assumedState(state, facts, assumed.relation, (left as ValueLookup::Found).term, (right as ValueLookup::Found).term);
                return stepped(0, -1, assumedNow, facts);
            };
        };
    };
    return stepped(2, i, state, facts);
};

fn stepCheckWithin(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::CheckWithin {
        cw = step as ExecutionStep::CheckWithin;
        inner = resolveValue(state, cw.inner);
        outer = resolveValue(state, cw.outer);
        if inner is ValueLookup::Found {
            if outer is ValueLookup::Found {
                if holdsIn(state, facts, ValidatorGoal::Within { inner: (inner as ValueLookup::Found).term, outer: (outer as ValueLookup::Found).term }) = false {
                    return stepped(1, i, state, facts);
                };
                return stepped(0, -1, state, facts);
            };
        };
    };
    return stepped(2, i, state, facts);
};

fn stepAssumeVariant(initial: ExecutionState, step: &ExecutionStep, i: Int) -> ExecutionResult {
    state = initial;
    if step is ExecutionStep::AssumeVariant {
        av = step as ExecutionStep::AssumeVariant;
        object = resolveValue(state, av.object);
        if object is ValueLookup::Found {
            return ExecutionResult { status: 0, failedAt: -1, state: stateWithVariant(state, VariantFact { object: (object as ValueLookup::Found).term, family: av.family, constructor: av.constructor, matches: av.matches }) };
        };
        return ExecutionResult { status: 2, failedAt: i, state: state };
    };
    return ExecutionResult { status: 2, failedAt: i, state: state };
};

fn stepRequireVariant(initial: ExecutionState, step: &ExecutionStep, i: Int, facts: FactIndex) -> Stepped {
    state = initial;
    if step is ExecutionStep::RequireVariant {
        rv = step as ExecutionStep::RequireVariant;
        object = resolveValue(state, rv.object);
        if object is ValueLookup::Found {
            term = (object as ValueLookup::Found).term;
            if variantInSlices(state.context, facts, term, rv.family, rv.constructor) {
                required = stateWithVariant(state, VariantFact { object: term, family: rv.family, constructor: rv.constructor, matches: true });
                return stepped(0, -1, required, facts);
            };
            return stepped(1, i, state, facts);
        };
    };
    return stepped(2, i, state, facts);
};
