import validation::context { analyzeContext, contextDifferent, knownNonnegativeWith, signFacts };
import validation::linear { linearEntails };
import validation::model { ApplicationTerm, Arrival, ConstantTerm, ConstructorField, ContextAnalysis, DifferenceFact, DisequalityFact, EqualityFact, ExecutionState, FactIndex, ForallTemplate, HullLinks, MergePair, Minted, NormalizedSide, OrderFact, RawFacts, SignFacts, SplitResult, StateMergeLookup, Trunk, UnionFind, ValidatorContext, ValidatorGoal, ValueLookup, ValueRef, VariantFact, WriteOf };
import validation::relations { applicationAt, emptyIntMap, emptyPositions, intAt, minInt, sameIn, ufFind, ufUnion };
import validation::saturation { withInstances };
import validation::sequenceFacts { sizeTermOf };
import validation::state { bindLocal, commonTemplates, emptyMergePairs, goalSides, lookupLocal, noTemplates };
import validation::validation { entailsGoal, goalSlice, noFactIndex };
import validation::execution { firstRung };



fn writeOf(context: &ValidatorContext, classes: &HashMap<Int, Int>, signs: &SignFacts, k: Int, setApp: &ApplicationTerm) -> WriteOf {
    if setApp.function = -17 && size(setApp.arguments) = 3 {
        return WriteOf { written: true, pushed: false, inner: get(setApp.arguments, 0), idx: get(setApp.arguments, 1), value: get(setApp.arguments, 2) };
    };
    if setApp.function = -16 && size(setApp.arguments) = 2 {
        st = sizeTermOf(context, classes, get(setApp.arguments, 0));
        if st.found {
            if linearEntails(context, k, st.term, 0) {
                // At or below the old length is only half of being in the list
                // pushed to. The read split here can be a get written in a
                // proof, which carries no bounds of its own, so without a lower
                // bound splitAtWrite's elsewhere arm would equate it with a
                // fresh read of the old list at an index that list need not
                // have. At the write index itself there is no such equation.
                if sameIn(classes, k, st.term) || knownNonnegativeWith(context, signs, k) {
                    return WriteOf { written: true, pushed: true, inner: get(setApp.arguments, 0), idx: st.term, value: get(setApp.arguments, 1) };
                };
            };
        };
    };
    return WriteOf { written: false, pushed: false, inner: 0, idx: 0, value: 0 };
};

// The terms of the goal's sides and the arguments of the applications they are
fn nearTerms(context: &ValidatorContext, classes: &HashMap<Int, Int>, sides: &List<Int>) -> List<Int> {
    near = clone(sides);
    for appPosition in 0..size(context.applications) {
        app = get(context.applications, appPosition);
        for sidePosition in 0..size(sides) {
            if sameIn(classes, app.id, get(sides, sidePosition)) {
                for argument in app.arguments { near = push(near, argument); };
            };
        };
    };
    return near;
};

fn equalToAny(classes: &HashMap<Int, Int>, term: Int, terms: &List<Int>) -> Bool {
    for t in terms { if sameIn(classes, term, t) { return true; }; };
    return false;
};

fn splitReadOverWrite(state: &ExecutionState, goal: ValidatorGoal, depth: Int, budget: Int, floor: Int) -> SplitResult [{ affirm depth >= 0; }] [{ }] shrinks 2 * depth + 1 {
    if depth <= 0 || budget <= 0 { return SplitResult { holds: false, used: 0 }; };
    used = 0;
    analysis = analyzeContext(state.context);
    // (writeOf needs the signs; a goal with no read to split never asks)
    signs = SignFacts { classes: emptyIntMap(), equalities: [], orders: [], zero: 0, zeroFound: false };
    signsReady = false;
    near = nearTerms(state.context, analysis.classes, goalSides(goal));
    tried = 0;
    // (the newest reads first: a read a split made is the one to split next)
    count = size(state.context.applications);
    for back in 0..count {
        app = applicationAt(state.context.applications, count - 1 - back);
        if app.function = -14 && size(app.arguments) = 2 && tried < 3 && used < budget && size(state.templates) = 0 {
            if equalToAny(analysis.classes, app.id, near) {
                k = get(app.arguments, 1);
                if signsReady = false { signs = signFacts(state.context); signsReady = true; };
                for setAppPosition in 0..size(state.context.applications) {
                    w = writeOf(state.context, analysis.classes, signs, k, get(state.context.applications, setAppPosition));
                    if w.written {
                        if sameIn(analysis.classes, get(state.context.applications, setAppPosition).id, get(app.arguments, 0)) {
                            tried = tried + 1;
                            r = splitAtWrite(state, analysis, goal, depth, budget - used, app.id, k, w, floor);
                            used = used + r.used;
                            if r.holds { return SplitResult { holds: true, used: used }; };
                        };
                    };
                };
            };
        };
    };
    // (a read of a list a forall fact is about, at an index on no known side of
    // the fact's bound: the goal holds below the bound and at or above it)
    rangeTried = 0;
    for back in 0..count {
        app = applicationAt(state.context.applications, count - 1 - back);
        if app.function = -14 && size(app.arguments) = 2 && rangeTried < 2 && used < budget {
            if equalToAny(analysis.classes, app.id, near) {
                k = get(app.arguments, 1);
                list = get(app.arguments, 0);
                for factPosition in 0..size(state.context.applications) {
                    fact = get(state.context.applications, factPosition);
                    if fact.function = -30 && size(fact.arguments) = 5 && rangeTried < 2 && used < budget {
                        if sameIn(analysis.classes, get(fact.arguments, 0), list) || sameIn(analysis.classes, get(fact.arguments, 1), list) {
                            for side in 0..2 {
                                bound = get(fact.arguments, 2 + side);
                                if rangeTried < 2 && used < budget {
                                    if linearEntails(state.context, bound, k, 0) = false && linearEntails(state.context, k, bound, -1) = false {
                                        rangeTried = rangeTried + 1;
                                        r = splitAtBound(state, goal, depth, budget - used, k, bound, floor);
                                        used = used + r.used;
                                        if r.holds { return SplitResult { holds: true, used: used }; };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    return SplitResult { holds: false, used: used };
};

// The goal at a read of a write: at the write's index the read is the value written; elsewhere it is a read of the
// list written to, at an index other than the write's (below it, for a push, where writeOf has also required the
// index to be in the list pushed to)
fn splitAtWrite(state: &ExecutionState, analysis: &ContextAnalysis, goal: &ValidatorGoal, depth: Int, budget: Int, readId: Int, k: Int, w: &WriteOf, floor: Int) -> SplitResult [{ affirm depth >= 1; }] [{ }] shrinks 2 * depth {
    used = 0;
    context = clone(state.context);
    sameIndex = sameIn(analysis.classes, k, w.idx);
    atOk = contextDifferent(analysis.equalities, context.applications, context.orders, context.different, analysis.differences, k, w.idx);
    if atOk = false {
        atIdx = ValidatorContext { equalities: push(push(clone(context.equalities), EqualityFact { left: k, right: w.idx }), EqualityFact { left: readId, right: w.value }), ..clone(context) };
        atOk = analyzeContext(atIdx).contradictory;
        if atOk = false { used = used + 1; atOk = entailsGoal(atIdx, clone(goal)); };
        // (the value may itself be read from a write: a node set from the node there)
        if atOk = false && used < budget {
            deeper = splitReadOverWrite(ExecutionState { context: clone(atIdx), ..clone(state) }, clone(goal), depth - 1, budget - used, floor);
            used = used + deeper.used;
            atOk = deeper.holds;
        };
    };
    if atOk = false { return SplitResult { holds: false, used: used }; };
    if sameIndex { return SplitResult { holds: true, used: used }; };
    newRead = freshBelow(state, floor);
    apps = push(clone(context.applications), ApplicationTerm { id: newRead, function: -14, arguments: push(push([], w.inner), k) });
    elsewhere = ValidatorContext { applications: apps, equalities: push(clone(context.equalities), EqualityFact { left: readId, right: newRead }), different: push(clone(context.different), DisequalityFact { left: k, right: w.idx }), ..clone(context) };
    if w.pushed {
        elsewhere = ValidatorContext { orders: push(clone(elsewhere.orders), OrderFact { smaller: k, greater: w.idx, strict: true }), ..clone(elsewhere) };
    };
    elseOk = analyzeContext(elsewhere).contradictory;
    if elseOk = false { used = used + 1; elseOk = entailsGoal(elsewhere, clone(goal)); };
    if elseOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(elsewhere), ..clone(state) }, clone(goal), depth - 1, budget - used, floor);
        used = used + deeper.used;
        elseOk = deeper.holds;
    };
    return SplitResult { holds: elseOk, used: used };
};

// The goal at a read on no known side of a forall fact's bound: below the bound, and at or above it
fn splitAtBound(state: &ExecutionState, goal: &ValidatorGoal, depth: Int, budget: Int, k: Int, bound: Int, floor: Int) -> SplitResult [{ affirm depth >= 1; }] [{ }] shrinks 2 * depth {
    used = 0;
    below = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: k, greater: bound, strict: true }), ..clone(state.context) };
    below = withInstances(state, below, floor);
    belowOk = analyzeContext(below).contradictory;
    if belowOk = false { used = used + 1; belowOk = entailsGoal(below, clone(goal)); };
    if belowOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(below), ..clone(state) }, clone(goal), depth - 1, budget - used, floor);
        used = used + deeper.used;
        belowOk = deeper.holds;
    };
    if belowOk = false { return SplitResult { holds: false, used: used }; };
    above = ValidatorContext { orders: push(clone(state.context.orders), OrderFact { smaller: bound, greater: k, strict: false }), ..clone(state.context) };
    above = withInstances(state, above, floor);
    aboveOk = analyzeContext(above).contradictory;
    if aboveOk = false { used = used + 1; aboveOk = entailsGoal(above, clone(goal)); };
    if aboveOk = false {
        deeper = splitReadOverWrite(ExecutionState { context: clone(above), ..clone(state) }, clone(goal), depth - 1, budget - used, floor);
        used = used + deeper.used;
        aboveOk = deeper.holds;
    };
    return SplitResult { holds: aboveOk, used: used };
};

// A term new to the state, and the state with its floor below it
fn mint(state: ExecutionState) -> Minted {
    term = state.floor - 1;
    return Minted { state: ExecutionState { floor: term, ..state }, term: term };
};

// A term new to a state that is part of another: below both what it mentions
// and the floor of the whole it was taken from, whose other terms it may meet
fn freshBelow(state: &ExecutionState, floor: Int) -> Int {
    return minInt(leastTermInUse(state), floor) - 1;
};

fn leastTermInUse(state: &ExecutionState) -> Int {
    least = -999;
    for binding in state.locals.entries() { if binding.value < least { least = binding.value; }; };
    for factPosition in 0..size(state.context.equalities) {
        fact = get(state.context.equalities, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    for factPosition in 0..size(state.context.different) {
        fact = get(state.context.different, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    for factPosition in 0..size(state.context.orders) {
        fact = get(state.context.orders, factPosition);
        if fact.smaller < least { least = fact.smaller; };
        if fact.greater < least { least = fact.greater; };
    };
    for factPosition in 0..size(state.context.differences) {
        fact = get(state.context.differences, factPosition);
        if fact.left < least { least = fact.left; };
        if fact.right < least { least = fact.right; };
    };
    // (an application is read where it is: it holds a list)
    for vPosition in 0..size(state.context.variants) {
        object = get(state.context.variants, vPosition).object;
        if object < least { least = object; };
    };
    for cPosition in 0..size(state.context.constants) {
        id = get(state.context.constants, cPosition).id;
        if id < least { least = id; };
    };
    for appPosition in 0..size(state.context.applications) {
        id = get(state.context.applications, appPosition).id;
        if id < least { least = id; };
        function = get(state.context.applications, appPosition).function;
        if function < least { least = function; };
        count = size(get(state.context.applications, appPosition).arguments);
        for k in 0..count {
            a = intAt(get(state.context.applications, appPosition).arguments, k, 0);
            if a < least { least = a; };
        };
    };
    // (a template's literal and function ids are the data's and need not occur in the facts)
    for template in state.templates {
        for node in template.nodes {
            if node.function < least { least = node.function; };
            if node.value is ValueRef::Term {
                term = (node.value as ValueRef::Term).term;
                if term < least { least = term; };
            };
        };
    };
    return least;
};

fn sameConstructorField(a: &ConstructorField, b: &ConstructorField) -> Bool {
    return a.constructor = b.constructor && a.field = b.field && a.index = b.index;
};

fn mergeTerm(joined: &HashMap<Int, Int>, ambiguous: &HashSet<Int>, term: Int) -> ValueLookup {
    if ambiguous.contains(term) { return ValueLookup::Missing; };
    if joined.contains(term) { return ValueLookup::Found { term: joined.lookup(term, 0) }; };
    return ValueLookup::Found { term: term };
};

fn normalizedContext(context: &ValidatorContext, pairs: &List<MergePair>, leftSide: Bool, raw: &RawFacts) -> NormalizedSide {
    joined = emptyIntMap();
    ambiguous = HashSet::new();
    // (a term a local keeps as itself across the join keeps its facts: a local
    // joined from it on this side is said equal to it here, not renamed into
    // it, or the local that keeps it would lose what is known of it)
    kept = HashSet::new();
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        if pair.joined = pair.left && pair.joined = pair.right && pair.left < 0 {
            kept = kept.insert(pair.left);
            joined = joined.insert(pair.left, pair.left);
        };
    };
    sameAsKept = [];
    for pairPosition in 0..size(pairs) {
        pair = get(pairs, pairPosition);
        source = pair.right;
        if leftSide { source = pair.left; };
        // (a literal is a term every fact may speak of, not the local's own
        // value: renaming it would turn m >= 1 into m >= c after c = 1 on one
        // side; the joined value gets its range from the bounds instead)
        if source >= 0 {
        } else if kept.contains(source) {
            if pair.joined != source { sameAsKept = push(sameAsKept, EqualityFact { left: pair.joined, right: source }); };
        } else if ambiguous.contains(source) = false {
            if joined.contains(source) {
                if joined.lookup(source, 0) != pair.joined {
                    ambiguous = ambiguous.insert(source);
                };
            } else {
                joined = joined.insert(source, pair.joined);
            };
        };
    };
    equalities = [];
    applications = [];
    constants = [];
    orders = [];
    different = [];
    variants = [];
    fieldFunctions = clone(context.fieldFunctions);
    constructorFunctions = clone(context.constructorFunctions);
    constructorFields = clone(context.constructorFields);
    differences = [];
    origins = [];
    terms = clone(raw.terms);
    starts = clone(raw.starts);
    definitions = clone(raw.definitions);
    for factPosition in 0..size(context.equalities) {
        fact = get(context.equalities, factPosition);
        starts = push(starts, size(terms));
        terms = push(push(terms, fact.left), fact.right);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                equalities = push(equalities, EqualityFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term });
                origins = push(origins, size(starts) - 1);
            };
        };
    };
    for fact in sameAsKept { equalities = push(equalities, fact); origins = push(origins, -1); };
    for factPosition in 0..size(context.applications) {
        fact = get(context.applications, factPosition);
        definitions = definitions.insert(size(starts));
        starts = push(starts, size(terms));
        terms = push(terms, fact.id);
        for argument in fact.arguments { terms = push(terms, argument); };
        id = mergeTerm(joined, ambiguous, fact.id);
        arguments = [];
        valid = true;
        for argumentPosition in 0..size(fact.arguments) {
            argument = get(fact.arguments, argumentPosition);
            mapped = mergeTerm(joined, ambiguous, argument);
            if mapped is ValueLookup::Found { arguments = push(arguments, (mapped as ValueLookup::Found).term); } else { valid = false; };
        };
        if id is ValueLookup::Found {
            if valid {
                applications = push(applications, ApplicationTerm { id: (id as ValueLookup::Found).term, function: fact.function, arguments: arguments });
                origins = push(origins, size(starts) - 1);
            };
        };
    };
    for factPosition in 0..size(context.constants) {
        fact = get(context.constants, factPosition);
        definitions = definitions.insert(size(starts));
        starts = push(starts, size(terms));
        terms = push(terms, fact.id);
        id = mergeTerm(joined, ambiguous, fact.id);
        if id is ValueLookup::Found {
            constants = push(constants, ConstantTerm { id: (id as ValueLookup::Found).term, kind: fact.kind, value: fact.value });
            origins = push(origins, size(starts) - 1);
        };
    };
    for factPosition in 0..size(context.orders) {
        fact = get(context.orders, factPosition);
        starts = push(starts, size(terms));
        terms = push(push(terms, fact.smaller), fact.greater);
        smaller = mergeTerm(joined, ambiguous, fact.smaller);
        greater = mergeTerm(joined, ambiguous, fact.greater);
        if smaller is ValueLookup::Found {
            if greater is ValueLookup::Found {
                orders = push(orders, OrderFact { smaller: (smaller as ValueLookup::Found).term, greater: (greater as ValueLookup::Found).term, strict: fact.strict });
                origins = push(origins, size(starts) - 1);
            };
        };
    };
    for factPosition in 0..size(context.different) {
        fact = get(context.different, factPosition);
        starts = push(starts, size(terms));
        terms = push(push(terms, fact.left), fact.right);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                different = push(different, DisequalityFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term });
                origins = push(origins, size(starts) - 1);
            };
        };
    };
    for factPosition in 0..size(context.differences) {
        fact = get(context.differences, factPosition);
        starts = push(starts, size(terms));
        terms = push(push(terms, fact.left), fact.right);
        left = mergeTerm(joined, ambiguous, fact.left);
        right = mergeTerm(joined, ambiguous, fact.right);
        if left is ValueLookup::Found {
            if right is ValueLookup::Found {
                differences = push(differences, DifferenceFact { left: (left as ValueLookup::Found).term, right: (right as ValueLookup::Found).term, bound: fact.bound });
                origins = push(origins, size(starts) - 1);
            };
        };
    };
    for factPosition in 0..size(context.variants) {
        fact = get(context.variants, factPosition);
        starts = push(starts, size(terms));
        terms = push(terms, fact.object);
        object = mergeTerm(joined, ambiguous, fact.object);
        if object is ValueLookup::Found {
            variants = push(variants, VariantFact { object: (object as ValueLookup::Found).term, family: fact.family, constructor: fact.constructor, matches: fact.matches });
            origins = push(origins, size(starts) - 1);
        };
    };
    normalized = ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
    return NormalizedSide { context: normalized, origins: origins, raw: RawFacts { terms: terms, starts: starts, definitions: definitions } };
};

fn sameEquality(a: &EqualityFact, b: &EqualityFact) -> Bool {
    return (a.left = b.left && a.right = b.right) || (a.left = b.right && a.right = b.left);
};

fn sameDisequality(a: &DisequalityFact, b: &DisequalityFact) -> Bool {
    return (a.left = b.left && a.right = b.right) || (a.left = b.right && a.right = b.left);
};

fn sameVariantFact(a: &VariantFact, b: &VariantFact) -> Bool {
    return a.object = b.object && a.family = b.family && a.constructor = b.constructor && a.matches = b.matches;
};

fn sameApplication(a: &ApplicationTerm, b: &ApplicationTerm) -> Bool {
    return a.id = b.id && a.function = b.function && a.arguments = b.arguments;
};

// A fact a join keeps when both paths hold it: a key that equal facts share,
// and whether two facts are the same
trait JoinedFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }];
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }];
};

impl JoinedFact for EqualityFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return minInt(self.left, self.right); };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameEquality(self, other); };
};

impl JoinedFact for ApplicationTerm {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.id; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameApplication(self, other); };
};

impl JoinedFact for ConstantTerm {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.id; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.id = other.id && self.kind = other.kind && self.value = other.value; };
};

impl JoinedFact for OrderFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.smaller; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.smaller = other.smaller && self.greater = other.greater && self.strict = other.strict; };
};

impl JoinedFact for DisequalityFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return minInt(self.left, self.right); };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameDisequality(self, other); };
};

impl JoinedFact for VariantFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.object; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameVariantFact(self, other); };
};

impl JoinedFact for ConstructorField {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.constructor; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return sameConstructorField(self, other); };
};

impl JoinedFact for DifferenceFact {
    fn joinKey(self: &Self) -> Int [{ }] [{ }] { return self.left; };
    fn sameFact(self: &Self, other: &Self) -> Bool [{ }] [{ }] { return self.left = other.left && self.right = other.right && self.bound = other.bound; };
};

fn factPositions<T: JoinedFact>(facts: &List<T>) -> HashMap<Int, List<Int>> {
    byKey = emptyPositions();
    for position in 0..size(facts) {
        key = JoinedFact::joinKey(get(facts, position));
        byKey = byKey.insert(key, push(byKey.lookup(key, []), position));
    };
    return byKey;
};

fn holdsFact<T: JoinedFact>(facts: &List<T>, byKey: &HashMap<Int, List<Int>>, fact: &T) -> Bool {
    for candidate in byKey.lookup(JoinedFact::joinKey(fact), []) {
        if candidate >= 0 && candidate < size(facts) {
            if JoinedFact::sameFact(fact, get(facts, candidate)) { return true; };
        };
    };
    return false;
};

// The facts of left that right holds too, each once. (A fact held twice on
// each side was kept four times, and the copies multiplied with every join
// after it.) The facts of right are found by their key, not by a walk over
// all of them for each fact of left.
fn commonFacts<T: JoinedFact + Clone>(left: &List<T>, right: &List<T>) -> List<T> {
    common = [];
    byKey = factPositions(right);
    kept = emptyPositions();
    for lPosition in 0..size(left) {
        lKey = JoinedFact::joinKey(get(left, lPosition));
        if holdsFact(right, byKey, get(left, lPosition)) {
            already = false;
            for earlier in kept.lookup(lKey, []) {
                if already = false && earlier >= 0 && earlier < size(left) {
                    if JoinedFact::sameFact(get(left, lPosition), get(left, earlier)) { already = true; };
                };
            };
            if already = false {
                kept = kept.insert(lKey, push(kept.lookup(lKey, []), lPosition));
                common = push(common, clone(get(left, lPosition)));
            };
        };
    };
    return common;
};

// The raw facts of a side whose renamed form the merged context holds
fn keptOrigins<T: JoinedFact>(renamed: &List<T>, merged: &List<T>, origins: &List<Int>, first: Int, kept: HashSet<Int>) -> HashSet<Int> {
    byKey = factPositions(merged);
    for position in 0..size(renamed) {
        origin = intAt(origins, first + position, -1);
        if origin >= 0 {
            if holdsFact(merged, byKey, get(renamed, position)) { kept = kept.insert(origin); };
        };
    };
    return kept;
};

fn keptRawFacts(side: &NormalizedSide, merged: &ValidatorContext, kept: HashSet<Int>) -> HashSet<Int> {
    first = 0;
    kept = keptOrigins(side.context.equalities, merged.equalities, side.origins, first, kept);
    first = first + size(side.context.equalities);
    kept = keptOrigins(side.context.applications, merged.applications, side.origins, first, kept);
    first = first + size(side.context.applications);
    kept = keptOrigins(side.context.constants, merged.constants, side.origins, first, kept);
    first = first + size(side.context.constants);
    kept = keptOrigins(side.context.orders, merged.orders, side.origins, first, kept);
    first = first + size(side.context.orders);
    kept = keptOrigins(side.context.different, merged.different, side.origins, first, kept);
    first = first + size(side.context.different);
    kept = keptOrigins(side.context.differences, merged.differences, side.origins, first, kept);
    first = first + size(side.context.differences);
    return keptOrigins(side.context.variants, merged.variants, side.origins, first, kept);
};

fn commonContext(left: &ValidatorContext, right: &ValidatorContext) -> ValidatorContext {
    fieldFunctions = [];
    rightFields = HashSet::new();
    for function in right.fieldFunctions { rightFields = rightFields.insert(function); };
    for function in left.fieldFunctions { if rightFields.contains(function) { fieldFunctions = push(fieldFunctions, function); }; };
    constructorFunctions = [];
    rightConstructors = HashSet::new();
    for function in right.constructorFunctions { rightConstructors = rightConstructors.insert(function); };
    for function in left.constructorFunctions { if rightConstructors.contains(function) { constructorFunctions = push(constructorFunctions, function); }; };
    return ValidatorContext { equalities: commonFacts(left.equalities, right.equalities), applications: commonFacts(left.applications, right.applications), constants: commonFacts(left.constants, right.constants), orders: commonFacts(left.orders, right.orders), different: commonFacts(left.different, right.different), variants: commonFacts(left.variants, right.variants), fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: commonFacts(left.constructorFields, right.constructorFields), differences: commonFacts(left.differences, right.differences) };
};

fn constantTermWithValue(context: &ValidatorContext, value: Int) -> ValueLookup {
    for constantPosition in 0..size(context.constants) {
        constant = get(context.constants, constantPosition);
        if constant.kind = 0 {
            if constant.value = value { return ValueLookup::Found { term: constant.id }; };
        };
    };
    return ValueLookup::Missing;
};

// A merge keeps a fact only when both sides hold it, after each side renames
// its own terms into the joined ones. Reading each joined term as its source
// on a side and every other id as itself, each side's values satisfy the
// merged state, whatever a generated (negative) id means on either side,
// provided that:
//   1. every joined term is fresh below every term either side mentions;
//   2. every joined term has one source on each side (pairs are keyed by
//      both sources);
//   3. a non-negative id has one value in both states: the constants either
//      side states of one are kept, and a local both sides bind to one keeps
//      it unpaired. The caller must not merge states in which a block that
//      makes host-numbered terms ran more than once.
// A template is kept by id: the host registers each with one id and content
// that speaks only of captured locals and literals. A term with two joined
// images on a side is dropped from that side, which costs precision only.
// A local both sides bind to the same generated id keeps it. Bounds of the
// joined terms come from addDifferenceHull, which asks no solver.
//
// The two sides are arrivals at one mark of the trunk: both states are the
// trunk's facts up to the mark and then their own suffixes. Only the suffixes
// are renamed and intersected; the prefix stays as it is, and so does every
// local neither side binds anew. Under the same reading each side satisfies
// a prefix fact: it is one of that side's own facts, and it names no joined
// term, since by 1 a joined term is below the floor of both sides, which is
// at or below every id of the prefix. A prefix term that a local of either
// side holds is paired with itself, as a local both sides bind to one id is,
// so it keeps its name in both suffixes: it is one value on both sides. The
// local joined from it gets a joined term, which the hull relates to it. An
// ambiguous term keeps its prefix facts unrenamed, which is sound for the
// same reason. The hull reads each side's suffix and the prefix facts near
// that side's sources, a subset of that side's facts, so whatever it derives
// holds there.
//
// Two arms may mint the same generated id for different terms: an arrival
// restored on the trunk takes back its own floor (restore), and a forall
// check's body gives back the floor it lowered (scopedRun). That is safe. Each
// arm mints below its floor, so never a prefix id; the reading above lets a
// generated id mean something different on each side; a merge keeps only what
// both sides state of it; and two arms' facts meet in one state only through
// a merge.
fn sideTerm(overlay: &HashMap<Int, Int>, trunkLocals: &HashMap<Int, Int>, local: Int) -> ValueLookup {
    if overlay.contains(local) { return ValueLookup::Found { term: overlay.lookup(local, 0) }; };
    return lookupLocal(trunkLocals, local);
};

struct LocalsJoin { locals: HashMap<Int, Int>, pairs: List<MergePair>, byLeft: HullLinks, floor: Int };

fn pairOf(join: &LocalsJoin, left: Int, right: Int) -> ValueLookup {
    for position in linkedItems(join.byLeft, left) {
        if position >= 0 && position < size(join.pairs) {
            if get(join.pairs, position).right = right { return ValueLookup::Found { term: get(join.pairs, position).joined }; };
        };
    };
    return ValueLookup::Missing;
};

fn withMergePair(join: LocalsJoin, pair: MergePair) -> LocalsJoin {
    LocalsJoin { locals: locals, pairs: pairs, byLeft: byLeft, floor: floor } = join;
    byLeft = linkAppend(byLeft, pair.left, size(pairs));
    return LocalsJoin { locals: locals, pairs: push(pairs, pair), byLeft: byLeft, floor: floor };
};

fn withJoinedLocal(join: LocalsJoin, local: Int, term: Int) -> LocalsJoin {
    LocalsJoin { locals: locals, pairs: pairs, byLeft: byLeft, floor: floor } = join;
    return LocalsJoin { locals: bindLocal(locals, local, term), pairs: pairs, byLeft: byLeft, floor: floor };
};

fn joinLocal(join: LocalsJoin, local: Int, leftTerm: Int, rightTerm: Int) -> LocalsJoin {
    if leftTerm >= 0 && leftTerm = rightTerm { return withJoinedLocal(join, local, leftTerm); };
    if leftTerm = rightTerm {
        // (another local joined from the kept term is said equal to it
        // rather than renamed into it, which would take from this local
        // what is known of it)
        kept = withJoinedLocal(join, local, leftTerm);
        if pairOf(kept, leftTerm, leftTerm) is ValueLookup::Missing {
            return withMergePair(kept, MergePair { left: leftTerm, right: leftTerm, joined: leftTerm });
        };
        return kept;
    };
    known = pairOf(join, leftTerm, rightTerm);
    if known is ValueLookup::Found { return withJoinedLocal(join, local, (known as ValueLookup::Found).term); };
    joined = join.floor - 1;
    LocalsJoin { locals: locals, pairs: pairs, byLeft: byLeft, floor: floor } = join;
    return withMergePair(LocalsJoin { locals: bindLocal(locals, local, joined), pairs: pairs, byLeft: byLeft, floor: joined }, MergePair { left: leftTerm, right: rightTerm, joined: joined });
};

// A prefix term either side's locals hold keeps its name on both sides: it
// is one value on both, and renaming it into a joined term on one side only
// would part the suffix facts each side has about it.
fn withPrefixTerm(join: LocalsJoin, prefix: &FactIndex, term: Int) -> LocalsJoin {
    // (weights keep a zero for a term whose facts were cut off)
    if term < 0 && prefix.weights.lookup(term, 0) > 0 && pairOf(join, term, term) is ValueLookup::Missing {
        return withMergePair(join, MergePair { left: term, right: term, joined: term });
    };
    return join;
};

// The locals either side binds anew, joined: the left's in its order, then
// the right's the left does not bind anew
fn joinOverlays(trunkLocals: &HashMap<Int, Int>, prefix: &FactIndex, left: &HashMap<Int, Int>, right: &HashMap<Int, Int>, floor: Int) -> LocalsJoin {
    join = LocalsJoin { locals: emptyIntMap(), pairs: emptyMergePairs(), byLeft: noLinks(), floor: floor };
    for binding in left.entries() {
        join = withPrefixTerm(join, prefix, binding.value);
        other = sideTerm(right, trunkLocals, binding.key);
        if other is ValueLookup::Found { join = withPrefixTerm(join, prefix, (other as ValueLookup::Found).term); };
    };
    for binding in right.entries() {
        join = withPrefixTerm(join, prefix, binding.value);
        mine = sideTerm(left, trunkLocals, binding.key);
        if mine is ValueLookup::Found { join = withPrefixTerm(join, prefix, (mine as ValueLookup::Found).term); };
    };
    for binding in left.entries() {
        other = sideTerm(right, trunkLocals, binding.key);
        if other is ValueLookup::Found { join = joinLocal(join, binding.key, binding.value, (other as ValueLookup::Found).term); };
    };
    for binding in right.entries() {
        if left.contains(binding.key) = false {
            mine = lookupLocal(trunkLocals, binding.key);
            if mine is ValueLookup::Found { join = joinLocal(join, binding.key, (mine as ValueLookup::Found).term, binding.value); };
        };
    };
    return join;
};

fn effectiveTemplates(arrival: &Arrival, trunkTemplates: &List<ForallTemplate>) -> List<ForallTemplate> {
    if arrival.ownTemplates { return clone(arrival.templates); };
    return clone(trunkTemplates);
};

struct SeenTerms { seen: HashSet<Int>, order: List<Int> };

fn withTerm(seen: HashSet<Int>, order: List<Int>, term: Int) -> SeenTerms {
    if seen.contains(term) { return SeenTerms { seen: seen, order: order }; };
    return SeenTerms { seen: seen.insert(term), order: push(order, term) };
};

// The sources, then every term the suffix mentions, each once
fn hullSeeds(suffix: &ValidatorContext, sources: &List<Int>) -> List<Int> {
    terms = SeenTerms { seen: HashSet::new(), order: [] };
    for t in sources { terms = withTerm(terms.seen, terms.order, t); };
    for f in suffix.equalities { terms = withTerm(terms.seen, terms.order, f.left); terms = withTerm(terms.seen, terms.order, f.right); };
    for f in suffix.applications {
        terms = withTerm(terms.seen, terms.order, f.id);
        for a in f.arguments { terms = withTerm(terms.seen, terms.order, a); };
    };
    for f in suffix.constants { terms = withTerm(terms.seen, terms.order, f.id); };
    for f in suffix.orders { terms = withTerm(terms.seen, terms.order, f.smaller); terms = withTerm(terms.seen, terms.order, f.greater); };
    for f in suffix.differences { terms = withTerm(terms.seen, terms.order, f.left); terms = withTerm(terms.seen, terms.order, f.right); };
    return terms.order;
};

// The prefix facts near a side's sources and the terms its suffix mentions,
// at a rung for each, then its suffix
fn hullSide(trunk: &Trunk, suffix: &ValidatorContext, sources: &List<Int>) -> ValidatorContext {
    if size(trunk.state.context.equalities) + size(trunk.state.context.applications) + size(trunk.state.context.constants) + size(trunk.state.context.orders) + size(trunk.state.context.differences) = 0 { return clone(suffix); };
    seeds = hullSeeds(suffix, sources);
    if size(seeds) = 0 { return clone(suffix); };
    near = goalSlice(trunk.state.context, trunk.index, seeds, firstRung() * (1 + size(seeds))).slice;
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = near;
    for f in suffix.equalities { equalities = push(equalities, f); };
    for f in suffix.applications { applications = push(applications, clone(f)); };
    for f in suffix.constants { constants = push(constants, f); };
    for f in suffix.orders { orders = push(orders, f); };
    for f in suffix.different { different = push(different, f); };
    for f in suffix.variants { variants = push(variants, f); };
    for f in suffix.differences { differences = push(differences, f); };
    return ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
};

fn pairSources(pairs: &List<MergePair>, leftSide: Bool) -> List<Int> {
    sources = [];
    for pair in pairs {
        if leftSide { sources = push(sources, pair.left); } else { sources = push(sources, pair.right); };
    };
    return sources;
};

// Two arrivals at the trunk's top joined into one there (see above)
fn mergeArrivals(trunk: &Trunk, left: Arrival, right: Arrival) -> Arrival {
    join = joinOverlays(trunk.state.locals, trunk.index, left.overlay, right.overlay, minInt(left.floor, right.floor));
    LocalsJoin { locals: locals, pairs: pairs, byLeft: byLeft, floor: floor } = join;
    noRaw = RawFacts { terms: [], starts: [], definitions: HashSet::new() };
    leftSide = normalizedContext(left.suffix, pairs, true, noRaw);
    rightSide = normalizedContext(right.suffix, pairs, false, leftSide.raw);
    ownTemplates = left.ownTemplates || right.ownTemplates;
    templates = noTemplates();
    if ownTemplates { templates = commonTemplates(effectiveTemplates(left, trunk.state.templates), effectiveTemplates(right, trunk.state.templates)); };
    merged = commonContext(leftSide.context, rightSide.context);
    // (a non-negative id's constant is one fact of both states: kept once,
    // unless the prefix already states it)
    known = HashSet::new();
    for c in merged.constants { known = known.insert(c.id); };
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = merged;
    for c in leftSide.context.constants {
        if c.id >= 0 && known.contains(c.id) = false && trunk.index.constantAt.contains(c.id) = false { constants = push(constants, c); known = known.insert(c.id); };
    };
    for c in rightSide.context.constants {
        if c.id >= 0 && known.contains(c.id) = false && trunk.index.constantAt.contains(c.id) = false { constants = push(constants, c); known = known.insert(c.id); };
    };
    suffix = ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences };
    keptFacts = keptRawFacts(rightSide, suffix, keptRawFacts(leftSide, suffix, HashSet::new()));
    named = HashSet::new();
    for binding in left.overlay.entries() { named = named.insert(binding.value); };
    for binding in right.overlay.entries() { named = named.insert(binding.value); };
    for binding in locals.entries() { named = named.insert(binding.value); };
    hulled = addDifferenceHull(suffix, floor, droppedDefinitions(rightSide.raw, keptFacts), pairs, hullSide(trunk, left.suffix, pairSources(pairs, true)), hullSide(trunk, right.suffix, pairSources(pairs, false)), named, trunk.index.valueAt);
    return Arrival { mark: clone(left.mark), suffix: hulled.context, overlay: locals, ownTemplates: ownTemplates, templates: templates, floor: hulled.floor };
};

fn emptyContext() -> ValidatorContext {
    return ValidatorContext { equalities: [], applications: [], constants: [], orders: [], different: [], variants: [], fieldFunctions: [], constructorFunctions: [], constructorFields: [], differences: [] };
};

// Two whole states merged: arrivals at the empty mark of an empty trunk
fn mergeStates(left: &ExecutionState, right: &ExecutionState) -> StateMergeLookup {
    empty = Trunk { state: ExecutionState { context: emptyContext(), locals: emptyIntMap(), templates: noTemplates(), floor: 0 }, index: noFactIndex(), trail: [], saved: [] };
    mark = push(push(push(push(push(push(push(push([], 0), 0), 0), 0), 0), 0), 0), 0);
    leftArrival = Arrival { mark: clone(mark), suffix: clone(left.context), overlay: clone(left.locals), ownTemplates: true, templates: clone(left.templates), floor: left.floor };
    rightArrival = Arrival { mark: mark, suffix: clone(right.context), overlay: clone(right.locals), ownTemplates: true, templates: clone(right.templates), floor: right.floor };
    merged = mergeArrivals(empty, leftArrival, rightArrival);
    return StateMergeLookup::Found { state: ExecutionState { context: merged.suffix, locals: merged.overlay, templates: merged.templates, floor: merged.floor } };
};

// What one side of a merge knows, indexed once. Classes are union-find roots
// over equalities and equal kind-0 constants; a class id names a class, and
// values holds the kind-0 value of a class that has one.
struct HullIndex { parent: HashMap<Int, Int>, values: HashMap<Int, Int>, defs: HashMap<Int, Int>, lows: HashMap<Int, Int>, highs: HashMap<Int, Int>, edges: HashMap<Int, Int>, names: HashMap<Int, Int>, anyNames: HashMap<Int, Int> };

struct HullForm { coeffs: HashMap<Int, Int>, leaves: List<Int>, leafTerms: List<Int>, constant: Int, valid: Bool, lo: Int, hi: Int, unknownLo: Int, unknownHi: Int, partLo: HashMap<Int, Int>, partHi: HashMap<Int, Int>, single: Int, singleCount: Int, root: Int, seen: HashSet<Int> };

struct HullBound { hasLo: Bool, lo: Int, hasHi: Bool, hi: Int };

fn hullSmall(v: Int) -> Bool {
    return v < 1099511627776 && v > -1099511627776;
};

fn idSmall(v: Int) -> Bool {
    return v < 2147483647 && v > -2147483647;
};

// (only called with both class ids strictly within 2^31, where the key is
// exact and far from overflow)
fn hullEdgeKey(a: Int, b: Int) -> Int { return a * 4294967296 + b; };

fn noLinks() -> HullLinks {
    return HullLinks { first: emptyIntMap(), last: emptyIntMap(), next: [], prev: [], items: [] };
};

fn linkAppend(links: HullLinks, key: Int, item: Int) -> HullLinks {
    HullLinks { first: first, last: last, next: next, prev: prev, items: items } = links;
    position = size(items);
    tail = last.lookup(key, -1);
    if tail >= 0 && tail < size(next) { next = set(next, tail, position); } else { first = first.insert(key, position); tail = -1; };
    return HullLinks { first: first, last: last.insert(key, position), next: push(next, -1), prev: push(prev, tail), items: push(items, item) };
};

struct LinkPop { links: HullLinks, ok: Bool };

// The links without their newest item, which must be the key's last and be
// item (ok is false, and nothing is taken, when it is not)
fn linkPop(links: HullLinks, key: Int, item: Int) -> LinkPop {
    HullLinks { first: first, last: last, next: next, prev: prev, items: items } = links;
    position = size(items) - 1;
    if position < 0 || last.lookup(key, -1) != position || intAt(items, position, -1) != item || size(next) != size(items) || size(prev) != size(items) {
        return LinkPop { links: HullLinks { first: first, last: last, next: next, prev: prev, items: items }, ok: false };
    };
    before = intAt(prev, position, -1);
    if before >= 0 && before < size(next) {
        next = set(next, before, -1);
        last = last.insert(key, before);
    } else {
        first = first.remove(key);
        last = last.remove(key);
    };
    if size(next) > 0 { next = pop(next); };
    if size(prev) > 0 { prev = pop(prev); };
    if size(items) > 0 { items = pop(items); };
    return LinkPop { links: HullLinks { first: first, last: last, next: next, prev: prev, items: items }, ok: true };
};

fn linkedItems(links: &HullLinks, key: Int) -> List<Int> {
    taken = [];
    at = links.first.lookup(key, -1);
    walked = 0;
    linkCount = size(links.items);
    while at >= 0 && at < size(links.items) && walked < linkCount [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
        taken = push(taken, get(links.items, at));
        at = intAt(links.next, at, -1);
        walked = walked + 1;
    };
    return taken;
};

fn hullIndex(context: &ValidatorContext, pairs: &List<MergePair>, leftSide: Bool) -> HullIndex {
    parent = emptyIntMap();
    weight = emptyIntMap();
    for position in 0..size(context.equalities) {
        e = get(context.equalities, position);
        UnionFind { parent: parent, weight: weight } = ufUnion(parent, weight, e.left, e.right);
    };
    firstOfValue = emptyIntMap();
    for position in 0..size(context.constants) {
        c = get(context.constants, position);
        if c.kind = 0 && hullSmall(c.value) {
            if firstOfValue.contains(c.value) {
                UnionFind { parent: parent, weight: weight } = ufUnion(parent, weight, firstOfValue.lookup(c.value, 0), c.id);
            } else { firstOfValue = firstOfValue.insert(c.value, c.id); };
        };
    };
    values = emptyIntMap();
    for position in 0..size(context.constants) {
        c = get(context.constants, position);
        if c.kind = 0 && hullSmall(c.value) {
            k = ufFind(parent, c.id);
            if values.contains(k) = false { values = values.insert(k, c.value); };
        };
    };
    defs = emptyIntMap();
    for position in 0..size(context.applications) {
        a = get(context.applications, position);
        if size(a.arguments) = 2 && (a.function = -1 || a.function = -2) {
            k = ufFind(parent, a.id);
            if defs.contains(k) = false { defs = defs.insert(k, position); };
        };
    };
    lows = emptyIntMap();
    highs = emptyIntMap();
    edges = emptyIntMap();
    for position in 0..size(context.orders) {
        o = get(context.orders, position);
        s = ufFind(parent, o.smaller);
        g = ufFind(parent, o.greater);
        step = 0;
        if o.strict { step = 1; };
        if values.contains(s) {
            v = values.lookup(s, 0) + step;
            if lows.contains(g) = false || v > lows.lookup(g, 0) { lows = lows.insert(g, v); };
        };
        if values.contains(g) {
            v = values.lookup(g, 0) - step;
            if highs.contains(s) = false || v < highs.lookup(s, 0) { highs = highs.insert(s, v); };
        };
        if idSmall(s) && idSmall(g) {
            key = hullEdgeKey(s, g);
            if edges.contains(key) = false || 0 - step < edges.lookup(key, 0) { edges = edges.insert(key, 0 - step); };
        };
    };
    for position in 0..size(context.differences) {
        d = get(context.differences, position);
        l = ufFind(parent, d.left);
        r = ufFind(parent, d.right);
        if idSmall(l) && idSmall(r) && hullSmall(d.bound) {
            key = hullEdgeKey(l, r);
            if edges.contains(key) = false || d.bound < edges.lookup(key, 0) { edges = edges.insert(key, d.bound); };
        };
    };
    // (a class holding a negative pair source is named by the first such
    // pair's joined term, as normalization renames it; a non-negative source
    // keeps its own id)
    names = emptyIntMap();
    anyNames = emptyIntMap();
    for position in 0..size(pairs) {
        p = get(pairs, position);
        source = p.right;
        if leftSide { source = p.left; };
        k = ufFind(parent, source);
        if source < 0 && names.contains(k) = false { names = names.insert(k, p.joined); };
        if anyNames.contains(k) = false { anyNames = anyNames.insert(k, p.joined); };
    };
    return HullIndex { parent: parent, values: values, defs: defs, lows: lows, highs: highs, edges: edges, names: names, anyNames: anyNames };
};

fn hullRoots(index: &HullIndex, selected: &List<MergePair>, leftSide: Bool) -> HashMap<Int, Int> {
    roots = emptyIntMap();
    for i in 0..size(selected) {
        p = get(selected, i);
        source = p.right;
        if leftSide { source = p.left; };
        k = ufFind(index.parent, source);
        if roots.contains(k) = false { roots = roots.insert(k, i); };
    };
    return roots;
};

// The classes whose add/sub definition reaches a dropped definition: a
// breadth-first walk up from the dropped ones, each class queued once.
fn hullReach(index: &HullIndex, context: &ValidatorContext, dropped: &List<Int>) -> HashSet<Int> {
    users = noLinks();
    for position in 0..size(context.applications) {
        a = get(context.applications, position);
        if size(a.arguments) = 2 && (a.function = -1 || a.function = -2) {
            k = ufFind(index.parent, a.id);
            users = linkAppend(users, ufFind(index.parent, intAt(a.arguments, 0, 0)), k);
            users = linkAppend(users, ufFind(index.parent, intAt(a.arguments, 1, 0)), k);
        };
    };
    reached = HashSet::new();
    queue = [];
    for position in 0..size(dropped) {
        k = ufFind(index.parent, get(dropped, position));
        if reached.contains(k) = false { reached = reached.insert(k); queue = push(queue, k); };
    };
    head = 0;
    bound = size(queue) + size(users.items) + 1;
    linkCount = size(users.items);
    while head < size(queue) && head < bound [{ affirm head >= 0; affirm head <= bound; }] shrinks bound - head {
        k = get(queue, head);
        head = head + 1;
        at = users.first.lookup(k, -1);
        walked = 0;
        while at >= 0 && at < size(users.items) && walked < linkCount [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
            owner = get(users.items, at);
            if reached.contains(owner) = false { reached = reached.insert(owner); queue = push(queue, owner); };
            at = intAt(users.next, at, -1);
            walked = walked + 1;
        };
    };
    return reached;
};

fn hullName(index: &HullIndex, term: Int) -> Int {
    return index.names.lookup(ufFind(index.parent, term), term);
};

// One root-edge candidate per end of a fact touching a selected root class,
// owned by the class's first selected pair
fn hullRootEdge(links: HullLinks, index: &HullIndex, roots: &HashMap<Int, Int>, root: Int, other: Int, otherClass: Int) -> HullLinks {
    if roots.contains(root) = false { return links; };
    owner = roots.lookup(root, 0);
    result = links;
    if index.anyNames.contains(otherClass) { result = linkAppend(result, owner, index.anyNames.lookup(otherClass, 0)); };
    // (a stable id names itself on both sides, even inside a renamed class)
    if other >= 0 { return linkAppend(result, owner, other); };
    return linkAppend(result, owner, hullName(index, other));
};

fn hullEdgeEnds(links: HullLinks, index: &HullIndex, roots: &HashMap<Int, Int>, a: Int, b: Int) -> HullLinks {
    ka = ufFind(index.parent, a);
    kb = ufFind(index.parent, b);
    return hullRootEdge(hullRootEdge(links, index, roots, ka, b, kb), index, roots, kb, a, ka);
};

fn hullEdgeLinks(links: HullLinks, index: &HullIndex, roots: &HashMap<Int, Int>, context: &ValidatorContext) -> HullLinks {
    result = links;
    for position in 0..size(context.orders) {
        o = get(context.orders, position);
        result = hullEdgeEnds(result, index, roots, o.smaller, o.greater);
    };
    for position in 0..size(context.differences) {
        d = get(context.differences, position);
        result = hullEdgeEnds(result, index, roots, d.left, d.right);
    };
    for position in 0..size(context.equalities) {
        e = get(context.equalities, position);
        result = hullEdgeEnds(result, index, roots, e.left, e.right);
    };
    return result;
};

// The affine form of a pair source on one side. The root's own add/sub
// definition is always expanded; below it only an unnamed, negative,
// non-source class not yet expanded on this side in this merge, so each
// class is expanded at most once per side however many pairs reach it.
fn hullForm(index: &HullIndex, context: &ValidatorContext, root: Int, named: &HashSet<Int>, sources: &HashSet<Int>, visited: HashSet<Int>) -> HullForm {
    coeffs = emptyIntMap();
    leaves = [];
    leafTerms = [];
    constant = 0;
    valid = true;
    terms = push([], root);
    signs = push([], 1);
    head = 0;
    bound = 2 * size(context.applications) + 2;
    seen = visited;
    while head < size(terms) && head < bound [{ affirm head >= 0; affirm head <= bound; }] shrinks bound - head {
        t = intAt(terms, head, 0);
        c = intAt(signs, head, 1);
        k = ufFind(index.parent, t);
        expandable = head = 0;
        if expandable = false {
            expandable = t < 0 && named.contains(t) = false && sources.contains(t) = false && seen.contains(k) = false;
        };
        head = head + 1;
        position = index.defs.lookup(k, -1);
        if index.values.contains(k) {
            constant = constant + c * index.values.lookup(k, 0);
            if hullSmall(constant) = false { valid = false; constant = 0; };
        } else if expandable && position >= 0 && position < size(context.applications) {
            seen = seen.insert(k);
            a = get(context.applications, position);
            terms = push(push(terms, intAt(a.arguments, 0, 0)), intAt(a.arguments, 1, 0));
            if a.function = -1 { signs = push(push(signs, c), c); } else { signs = push(push(signs, c), 0 - c); };
        } else {
            if coeffs.contains(k) = false { leaves = push(leaves, k); leafTerms = push(leafTerms, t); };
            n = coeffs.lookup(k, 0) + c;
            if n >= 1048576 || n <= -1048576 { valid = false; n = 0; };
            coeffs = coeffs.insert(k, n);
        };
    };
    if head < size(terms) { valid = false; };
    // (each leaf's share of the form's range, summed once: |c| < 2^20 and a
    // range end within 2^40 keep every product and running sum far from 2^63)
    lo = constant;
    hi = constant;
    unknownLo = 0;
    unknownHi = 0;
    partLo = emptyIntMap();
    partHi = emptyIntMap();
    single = 0;
    singleCount = 0;
    for leafPosition in 0..size(leaves) {
        k = get(leaves, leafPosition);
        c = coeffs.lookup(k, 0);
        if c != 0 {
            singleCount = singleCount + 1;
            single = k;
            haveLow = index.lows.contains(k) && hullSmall(index.lows.lookup(k, 0));
            haveHigh = index.highs.contains(k) && hullSmall(index.highs.lookup(k, 0));
            low = index.lows.lookup(k, 0);
            high = index.highs.lookup(k, 0);
            if c < 0 {
                swapHave = haveLow;
                haveLow = haveHigh;
                haveHigh = swapHave;
                swap = low;
                low = high;
                high = swap;
            };
            // (an overflowed sum counts as many unknowns, so dropping one leaf never clears it)
            if haveLow { partLo = partLo.insert(k, c * low); lo = lo + c * low; if hullSmall(lo) = false { unknownLo = unknownLo + 1000000; lo = 0; }; } else { unknownLo = unknownLo + 1; };
            if haveHigh { partHi = partHi.insert(k, c * high); hi = hi + c * high; if hullSmall(hi) = false { unknownHi = unknownHi + 1000000; hi = 0; }; } else { unknownHi = unknownHi + 1; };
        };
    };
    return HullForm { coeffs: coeffs, leaves: leaves, leafTerms: leafTerms, constant: constant, valid: valid, lo: lo, hi: hi, unknownLo: unknownLo, unknownHi: unknownHi, partLo: partLo, partHi: partHi, single: single, singleCount: singleCount, root: ufFind(index.parent, root), seen: seen };
};

fn hullTighter(a: &HullBound, b: &HullBound) -> HullBound {
    lo = a.lo;
    if b.hasLo && (a.hasLo = false || b.lo > a.lo) { lo = b.lo; };
    hi = a.hi;
    if b.hasHi && (a.hasHi = false || b.hi < a.hi) { hi = b.hi; };
    return HullBound { hasLo: a.hasLo || b.hasLo, lo: lo, hasHi: a.hasHi || b.hasHi, hi: hi };
};

// Bounds of root - m on one side, m read as `reading` there: the root's own
// direct edge to m, and the form's residual, each proved alone; the tighter
// end of the two is kept.
fn hullResidual(index: &HullIndex, form: &HullForm, reading: Int) -> HullBound {
    m = ufFind(index.parent, reading);
    if m = form.root { return HullBound { hasLo: true, lo: 0, hasHi: true, hi: 0 }; };
    direct = HullBound { hasLo: false, lo: 0, hasHi: false, hi: 0 };
    if idSmall(m) && idSmall(form.root) {
        up = hullEdgeKey(form.root, m);
        down = hullEdgeKey(m, form.root);
        direct = HullBound { hasLo: index.edges.contains(down), lo: 0 - index.edges.lookup(down, 0), hasHi: index.edges.contains(up), hi: index.edges.lookup(up, 0) };
    };
    if form.valid = false { return direct; };
    k = form.constant;
    residual = HullBound { hasLo: false, lo: 0, hasHi: false, hi: 0 };
    if form.coeffs.lookup(m, 0) = 1 {
        // (identity: drop m's own share)
        uLo = form.unknownLo;
        lo = form.lo;
        if form.partLo.contains(m) { lo = lo - form.partLo.lookup(m, 0); } else { uLo = uLo - 1; };
        uHi = form.unknownHi;
        hi = form.hi;
        if form.partHi.contains(m) { hi = hi - form.partHi.lookup(m, 0); } else { uHi = uHi - 1; };
        residual = HullBound { hasLo: uLo = 0 && hullSmall(lo), lo: lo, hasHi: uHi = 0 && hullSmall(hi), hi: hi };
    } else if form.singleCount = 1 && form.coeffs.lookup(form.single, 0) = 1 && idSmall(m) && idSmall(form.single) {
        up = hullEdgeKey(form.single, m);
        down = hullEdgeKey(m, form.single);
        residual = HullBound { hasLo: index.edges.contains(down), lo: k - index.edges.lookup(down, 0), hasHi: index.edges.contains(up), hi: k + index.edges.lookup(up, 0) };
    } else if index.values.contains(m) {
        v = index.values.lookup(m, 0);
        residual = HullBound { hasLo: form.unknownLo = 0, lo: form.lo - v, hasHi: form.unknownHi = 0, hi: form.hi - v };
    } else {
        haveHigh = index.highs.contains(m) && hullSmall(index.highs.lookup(m, 0));
        haveLow = index.lows.contains(m) && hullSmall(index.lows.lookup(m, 0));
        residual = HullBound { hasLo: form.unknownLo = 0 && haveHigh, lo: form.lo - index.highs.lookup(m, 0), hasHi: form.unknownHi = 0 && haveLow, hi: form.hi - index.lows.lookup(m, 0) };
    };
    return hullTighter(direct, residual);
};

// The range of the root alone: its form's range, tightened by its own facts
fn hullRange(index: &HullIndex, form: &HullForm) -> HullBound {
    own = HullBound { hasLo: index.lows.contains(form.root), lo: index.lows.lookup(form.root, 0), hasHi: index.highs.contains(form.root), hi: index.highs.lookup(form.root, 0) };
    if index.values.contains(form.root) { v = index.values.lookup(form.root, 0); own = HullBound { hasLo: true, lo: v, hasHi: true, hi: v }; };
    if form.valid = false { return own; };
    return hullTighter(own, HullBound { hasLo: form.unknownLo = 0, lo: form.lo, hasHi: form.unknownHi = 0, hi: form.hi });
};

fn sideReading(pairs: &List<MergePair>, byJoined: &HashMap<Int, Int>, leftSide: Bool, name: Int) -> Int {
    position = byJoined.lookup(name, -1);
    if position >= 0 && position < size(pairs) {
        p = get(pairs, position);
        if leftSide { return p.left; };
        return p.right;
    };
    return name;
};

// The terms whose definition (an application or constant) the merge dropped
fn droppedDefinitions(raw: &RawFacts, kept: &HashSet<Int>) -> List<Int> {
    dropped = [];
    for f in 0..size(raw.starts) {
        if raw.definitions.contains(f) && kept.contains(f) = false { dropped = push(dropped, intAt(raw.terms, intAt(raw.starts, f, 0), 0)); };
    };
    return dropped;
};

// The facts a merge adds, built up pair by pair. Every id it mints is next,
// counting down; canMint is false near the bottom of Int.
struct HullFacts { orders: List<OrderFact>, differences: List<DifferenceFact>, constants: List<ConstantTerm>, applications: List<ApplicationTerm>, equalities: List<EqualityFact>, constantOf: HashMap<Int, Int>, next: Int, canMint: Bool };

// value <= joined (or joined <= value) against the merged constant of that
// value (the suffix's, else the prefix's), minted when there is none and
// minting is allowed, else omitted
fn hullRangeFact(facts: HullFacts, values: &HashMap<Int, Int>, value: Int, joined: Int, low: Bool) -> HullFacts {
    HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint } = facts;
    present = constantOf.contains(value);
    bound = constantOf.lookup(value, 0);
    if present = false && values.contains(value) {
        present = true;
        bound = values.lookup(value, 0);
    };
    if present = false && canMint {
        constantOf = constantOf.insert(value, next);
        constants = push(constants, ConstantTerm { id: next, kind: 0, value: value });
        bound = next;
        next = next - 1;
        present = true;
    };
    if present {
        if low { orders = push(orders, OrderFact { smaller: bound, greater: joined, strict: false }); } else { orders = push(orders, OrderFact { smaller: joined, greater: bound, strict: false }); };
    };
    return HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint };
};

// The looser of the two sides' bounds of joined - m, where both sides have it
fn hullDifferenceFacts(facts: HullFacts, lb: &HullBound, rb: &HullBound, m: Int, joined: Int) -> HullFacts {
    HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint } = facts;
    if lb.hasLo && rb.hasLo {
        lo = minInt(lb.lo, rb.lo);
        if lo >= 1 { orders = push(orders, OrderFact { smaller: m, greater: joined, strict: true }); } else if lo >= 0 { orders = push(orders, OrderFact { smaller: m, greater: joined, strict: false }); } else { differences = push(differences, DifferenceFact { left: m, right: joined, bound: 0 - lo }); };
    };
    if lb.hasHi && rb.hasHi {
        hi = lb.hi;
        if rb.hi > hi { hi = rb.hi; };
        if hi <= -1 { orders = push(orders, OrderFact { smaller: joined, greater: m, strict: true }); } else if hi <= 0 { orders = push(orders, OrderFact { smaller: joined, greater: m, strict: false }); } else { differences = push(differences, DifferenceFact { left: joined, right: m, bound: hi }); };
    };
    return HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint };
};

// The coefficient-1 leaves of both forms, then the root-edge candidates the
// pair owns
fn hullCandidates(li: &HullIndex, lf: &HullForm, ri: &HullIndex, rf: &HullForm, links: &HullLinks, owner: Int) -> List<Int> {
    candidates = [];
    for j in 0..size(lf.leaves) { if lf.coeffs.lookup(get(lf.leaves, j), 0) = 1 { candidates = push(candidates, hullName(li, intAt(lf.leafTerms, j, 0))); }; };
    for j in 0..size(rf.leaves) { if rf.coeffs.lookup(get(rf.leaves, j), 0) = 1 { candidates = push(candidates, hullName(ri, intAt(rf.leafTerms, j, 0))); }; };
    at = links.first.lookup(owner, -1);
    walked = 0;
    linkCount = size(links.items);
    while at >= 0 && at < size(links.items) && walked < linkCount [{ affirm walked >= 0; affirm walked <= linkCount; }] shrinks linkCount - walked {
        candidates = push(candidates, get(links.items, at));
        at = intAt(links.next, at, -1);
        walked = walked + 1;
    };
    return candidates;
};

// The range of one joined term and its difference against each candidate,
// each candidate once; a candidate constant on the left is covered by the range
fn hullPairFacts(facts: HullFacts, values: &HashMap<Int, Int>, li: &HullIndex, lf: &HullForm, ri: &HullIndex, rf: &HullForm, joined: Int, pairs: &List<MergePair>, byJoined: &HashMap<Int, Int>, candidates: &List<Int>) -> HullFacts {
    result = facts;
    lr = hullRange(li, lf);
    rr = hullRange(ri, rf);
    if lr.hasLo && rr.hasLo { result = hullRangeFact(result, values, minInt(lr.lo, rr.lo), joined, true); };
    if lr.hasHi && rr.hasHi {
        hi = lr.hi;
        if rr.hi > hi { hi = rr.hi; };
        result = hullRangeFact(result, values, hi, joined, false);
    };
    done = HashSet::new();
    done = done.insert(joined);
    for position in 0..size(candidates) {
        m = get(candidates, position);
        leftReading = sideReading(pairs, byJoined, true, m);
        if done.contains(m) = false && li.values.contains(ufFind(li.parent, leftReading)) = false {
            done = done.insert(m);
            result = hullDifferenceFacts(result, hullResidual(li, lf, leftReading), hullResidual(ri, rf, sideReading(pairs, byJoined, false, m)), m, joined);
        };
    };
    return result;
};

// Two pairs whose constant values trade places keep their sum, found by the
// opposite difference in one pass; the total must already be a merged
// constant
fn hullSums(facts: HullFacts, values: &HashMap<Int, Int>, li: &HullIndex, ri: &HullIndex, selected: &List<MergePair>) -> HullFacts {
    HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint } = facts;
    byDelta = emptyIntMap();
    sums = 0;
    for i in 0..size(selected) {
        p = get(selected, i);
        a = ufFind(li.parent, p.left);
        c = ufFind(ri.parent, p.right);
        if li.values.contains(a) && ri.values.contains(c) && sums < 8 {
            av = li.values.lookup(a, 0);
            delta = av - ri.values.lookup(c, 0);
            if delta != 0 && byDelta.contains(0 - delta) {
                position = byDelta.lookup(0 - delta, 0);
                if position >= 0 && position < size(selected) {
                    q = get(selected, position);
                    total = av + li.values.lookup(ufFind(li.parent, q.left), 0);
                    known = constantOf.contains(total) || values.contains(total);
                    totalTerm = values.lookup(total, 0);
                    if constantOf.contains(total) { totalTerm = constantOf.lookup(total, 0); };
                    if known && canMint {
                        applications = push(applications, ApplicationTerm { id: next, function: -1, arguments: push(push([], q.joined), p.joined) });
                        equalities = push(equalities, EqualityFact { left: next, right: totalTerm });
                        next = next - 1;
                        sums = sums + 1;
                    };
                };
            };
            if delta != 0 && byDelta.contains(delta) = false { byDelta = byDelta.insert(delta, i); };
        };
    };
    return HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint };
};

// Every renamed pair, and each self-pair whose root class reaches a dropped
// definition on either side
fn hullSelected(pairs: &List<MergePair>, li: &HullIndex, ri: &HullIndex, lreach: &HashSet<Int>, rreach: &HashSet<Int>) -> List<MergePair> {
    selected = emptyMergePairs();
    for position in 0..size(pairs) {
        p = get(pairs, position);
        if p.joined != p.left || p.joined != p.right || lreach.contains(ufFind(li.parent, p.left)) || rreach.contains(ufFind(ri.parent, p.right)) { selected = push(selected, clone(p)); };
    };
    return selected;
};

// Bounds both sides give each joined term, read off each side's facts with no
// solver: its range, and its difference against each candidate (the
// coefficient-1 leaves of its forms and the other ends of facts on its root
// class), keeping the looser end of the two sides and omitting an end either
// side lacks. Every id it mints is below least, which is at or below every id
// either side or the merged state mentions; near the bottom of Int it mints
// nothing and drops the facts that would need a new term. A constant it needs
// is the merged facts' own, else the prefix's (values), else minted.
struct Hulled { context: ValidatorContext, floor: Int };

fn addDifferenceHull(merged: ValidatorContext, least: Int, dropped: &List<Int>, pairs: &List<MergePair>, left: &ValidatorContext, right: &ValidatorContext, named: &HashSet<Int>, values: &HashMap<Int, Int>) -> Hulled {
    if size(pairs) = 0 { return Hulled { context: merged, floor: least }; };
    li = hullIndex(left, pairs, true);
    ri = hullIndex(right, pairs, false);
    selected = hullSelected(pairs, li, ri, hullReach(li, left, dropped), hullReach(ri, right, dropped));
    if size(selected) = 0 { return Hulled { context: merged, floor: least }; };
    leftSources = HashSet::new();
    rightSources = HashSet::new();
    byJoined = emptyIntMap();
    for position in 0..size(pairs) {
        p = get(pairs, position);
        leftSources = leftSources.insert(p.left);
        rightSources = rightSources.insert(p.right);
        if byJoined.contains(p.joined) = false { byJoined = byJoined.insert(p.joined, position); };
    };
    edgeLinks = hullEdgeLinks(hullEdgeLinks(noLinks(), li, hullRoots(li, selected, true), left), ri, hullRoots(ri, selected, false), right);
    constantOf = emptyIntMap();
    for position in 0..size(merged.constants) {
        c = get(merged.constants, position);
        if c.kind = 0 && constantOf.contains(c.value) = false { constantOf = constantOf.insert(c.value, c.id); };
    };
    canMint = least > -4611686018427387904;
    next = 0;
    if canMint { next = least - 1; };
    ValidatorContext { equalities: equalities, applications: applications, constants: constants, orders: orders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: differences } = merged;
    facts = HullFacts { orders: orders, differences: differences, constants: constants, applications: applications, equalities: equalities, constantOf: constantOf, next: next, canMint: canMint };
    lv = HashSet::new();
    rv = HashSet::new();
    for i in 0..size(selected) {
        p = get(selected, i);
        lf = hullForm(li, left, p.left, named, leftSources, lv);
        rf = hullForm(ri, right, p.right, named, rightSources, rv);
        facts = hullPairFacts(facts, values, li, lf, ri, rf, p.joined, pairs, byJoined, hullCandidates(li, lf, ri, rf, edgeLinks, i));
        lv = lf.seen;
        rv = rf.seen;
    };
    HullFacts { orders: hullOrders, differences: hullDifferences, constants: hullConstants, applications: hullApplications, equalities: hullEqualities, constantOf: finalConstantOf, next: finalNext, canMint: finalCanMint } = hullSums(facts, values, li, ri, selected);
    floor = least;
    if finalCanMint && finalNext < least { floor = finalNext + 1; };
    return Hulled { context: ValidatorContext { equalities: hullEqualities, applications: hullApplications, constants: hullConstants, orders: hullOrders, different: different, variants: variants, fieldFunctions: fieldFunctions, constructorFunctions: constructorFunctions, constructorFields: constructorFields, differences: hullDifferences }, floor: floor };
};
