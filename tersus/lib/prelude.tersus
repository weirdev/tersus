// The library that every program has when it mentions one of its traits (`Sequence`, `Growable`, `Clone`, `Copy`, `Drop`, `Deref`, `Hash`) or
// `hashCombine` and does not declare it itself (see Pipeline.parseSource): it is parsed
// before the program, so the program's line numbers are its own.
//
// `Sequence<E>` says what a sequence of E is: `size`, `get`, `set` and `push`, with contracts written with `size` and `get` themselves,
// which a contract may call. `size(self)` is a function of the type that implements the trait, so what a contract says of `size(v)` is
// what the impl's `size` promises. A struct that implements it has `size(v)`, `get(v, i)`, `set(v, i, x)` and `push(v, x)` as calls of
// its impl, and `v.size()` and `Sequence::size(v)` are the same call (see examples/vec.tersus).

trait Sequence<E> {
    fn size(self: &Self) -> Int [{ }] [{ affirm return >= 0; }];
    fn get(self: &Self, i: Int) -> E [{ affirm i >= 0; affirm i < size(self); }] [{ }];
    fn set(self: Self, i: Int, x: E) -> Self [{ affirm i >= 0; affirm i < size(self); }] [{ affirm size(return) = size(self); affirm get(return, i) = x; }];
};

// What a sequence that can grow has: a push at the end, which an array has not (its size never changes)
trait Growable<E> {
    fn push(self: Self, x: E) -> Self [{ }] [{ affirm size(return) = size(self) + 1; affirm get(return, size(self)) = x; }];
};

// A list is a sequence that can grow, which it is by these impls: the functions are the ones a list has, so a call of one of them in a
// body here is the list's own. What they promise is what the trait promises and the frame of each, which is what a caller of a list
// through a bound relies on (a program that declares Sequence itself has a list implementing it by being a list, as before).
impl<T> Sequence<T> for List<T> {
    fn size(self: &Self) -> Int [{ }] [{ affirm return >= 0; }] { return size(self); };
    fn get(self: &Self, i: Int) -> T [{ affirm i >= 0; affirm i < size(self); }] [{ affirm return = get(self, i); }] { return clone(get(self, i)); };
    fn set(self: Self, i: Int, x: T) -> Self [{ affirm i >= 0; affirm i < size(self); }] [{ affirm size(return) = size(self); affirm get(return, i) = x; affirm forall j where j >= 0, j < size(self), j != i: get(return, j) = get(self, j); }] { return set(self, i, x); };
};

impl<T> Growable<T> for List<T> {
    fn push(self: Self, x: T) -> Self [{ }] [{ affirm size(return) = size(self) + 1; affirm get(return, size(self)) = x; affirm forall j in 0..size(self): get(return, j) = get(self, j); }] { return push(self, x); };
};

// An array is a sequence of its elements, by the same kind of impl, and it cannot grow, and a Box of one is too.
impl<T, n> Sequence<T> for Array<T, n> {
    fn size(self: &Self) -> Int [{ }] [{ affirm return >= 0; }] { return size(self); };
    fn get(self: &Self, i: Int) -> T [{ affirm i >= 0; affirm i < size(self); }] [{ affirm return = get(self, i); }] { return clone(get(self, i)); };
    fn set(self: Self, i: Int, x: T) -> Self [{ affirm i >= 0; affirm i < size(self); }] [{ affirm size(return) = size(self); affirm get(return, i) = x; affirm forall j where j >= 0, j < size(self), j != i: get(return, j) = get(self, j); }] { return set(self, i, x); };
};

impl<T> Sequence<T> for Box<Array<T>> {
    fn size(self: &Self) -> Int [{ }] [{ affirm return >= 0; }] { return size(self); };
    fn get(self: &Self, i: Int) -> T [{ affirm i >= 0; affirm i < size(self); }] [{ affirm return = get(self, i); }] { return clone(get(self, i)); };
    fn set(self: Self, i: Int, x: T) -> Self [{ affirm i >= 0; affirm i < size(self); }] [{ affirm size(return) = size(self); affirm get(return, i) = x; affirm forall j where j >= 0, j < size(self), j != i: get(return, j) = get(self, j); }] { return set(self, i, x); };
};

trait Copy { };

// What is done when a value goes out of scope: `impl Drop for T { fn drop(self: Self) -> Int { ... }; };` is called by native code where a value
// of T is freed (at the end of the scope of the local that holds it, when it is given another value, or when what holds it is freed), before
// what its fields own is freed. It is how a type that holds a permission (POINTERS.md) frees the memory it is for, so such a type is not
// linear: its drop is its use. A program does not call it, and a type with a drop is not Clone or Copy.
trait Drop {
    fn drop(self: Self) -> Int [{ }] [{ }];
};

// What a key of a HashMap hashes to: a number from 0 to 2147483646, the same for values that are equal. The number is not made to
// resist anyone: it spreads ordinary keys over the buckets of a map, and a key set chosen to collide makes the chains long (still
// correct, just slow). A struct or an enum gets one by writing `impl Hash for T { fn hash(self: &Self) -> Int { ... }; };` and
// combining the hashes of its fields with hashCombine; Int, Byte, Bool and String have theirs already.
//
// The mixing keeps every step in range with `%`: an Int traps on overflow and nothing wraps, so a hash that multiplied freely
// would stop the program on keys it should hash. hashCombine(h, x) is one step of it (h is a hash so far, x any Int), and a
// longer hash is a fold of it over the parts.
trait Hash {
    fn hash(self: &Self) -> Int [{ }] [{ affirm return >= 0; affirm return < 2147483647; }];
};

fn hashCombine(h: Int, x: Int) -> Int [{ affirm h >= 0; affirm h < 2147483647; }] [{ affirm return >= 0; affirm return < 2147483647; }] {
    r = x % 2147483647;
    if r < 0 { r = r + 2147483647; };
    return (h * 31 + r) % 2147483647;
};

impl Hash for Int {
    fn hash(self: &Self) -> Int [{ }] [{ affirm return >= 0; affirm return < 2147483647; }] { return hashCombine(17, self); };
};

impl Hash for Byte {
    fn hash(self: &Self) -> Int [{ }] [{ affirm return >= 0; affirm return < 2147483647; }] { return hashCombine(19, toInt(self)); };
};

impl Hash for Bool {
    fn hash(self: &Self) -> Int [{ }] [{ affirm return >= 0; affirm return < 2147483647; }] { if self { return 1231; }; return 1237; };
};

// What a value that holds another is looked through to: `impl Deref<T> for W { fn deref(self: &Self) -> T { ... }; };` says that where a
// struct or an enum is looked at (a field is read, `is`, `as`, a `match`, the base of an update, `shrinks`), a value of W is looked at
// through the T its `deref` gives, as a Box is looked through to what it holds. The functions of T are not the functions of W: a method
// is called on the value inside, as with a Box. A Box is the one Deref that no library can write, since what it holds is not a field of
// it, so the language gives it itself (LANGUAGE.md, Box).
trait Deref<T> {
    fn deref(self: &Self) -> T [{ }] [{ }];
};
