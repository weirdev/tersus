// The library that every program has when it mentions `Sequence` and does not declare it itself (see Pipeline.parseSource): it is parsed
// before the program, so the program's line numbers are its own.
//
// `Sequence<E>` says what a sequence of E is: `size`, `get`, `set` and `push`, with contracts written with `size` and `get` themselves,
// which a contract may call. `size(self)` is a function of the type that implements the trait, so what a contract says of `size(v)` is
// what the impl's `size` promises. A struct that implements it has `size(v)`, `get(v, i)`, `set(v, i, x)` and `push(v, x)` as calls of
// its impl, and `v.size()` and `Sequence::size(v)` are the same call (see examples/vec.tersus).

trait Sequence<E> {
    fn size(self: &Self) -> Int [{ }] [{ affirm return >= 0; }];
    fn get(self: &Self, i: Int) -> E [{ affirm i >= 0; affirm i < size(self); }] [{ }];
    fn set(self: Self, i: Int, x: E) -> Self [{ affirm i >= 0; affirm i < size(self); }] [{ affirm size(return) = size(self); affirm get(return, i) = x; }];
    fn push(self: Self, x: E) -> Self [{ }] [{ affirm size(return) = size(self) + 1; affirm get(return, size(self)) = x; }];
};
