import mir::emit::types { Ctx, cloneImplName, cloneSymbol, containsName, dropName, dropRangeSymbol, dropSymbol, fieldsLayout, functionSymbol, layoutOf, needsDrop, needsDropIn, printSymbol };
import mir::support::support { noStrings, showInt, beforeAngle, canonical, variantsOf, isEnum, sizedArray, isAggregate, declaredName, roundUp, simpleLayout };
import data::codec::codec { Type };
import mir::reader::reader { Field, Variant, TypeDecl };

// The lines that free the fields of one variant of a value at %slot, the fields from the byte `start`
fn dropFieldLines(types: &List<TypeDecl>, fns: &List<String>, variantIndex: Int, fields: &List<Field>, start: Int) -> List<String> ~ {
    out = noStrings();
    offset = 0;
    i = 0;
    for f in fields {
        l = layoutOf(types, f.ty);
        offset = roundUp(offset, l.align);
        if needsDrop(types, fns, f.ty) {
            reg = "%df".then(showInt(variantIndex)).then(".").then(showInt(i));
            out = push(out, "    ".then(reg).then(" = getelementptr i8, ptr %slot, i64 ").then(showInt(start + offset)));
            out = push(out, "    call void ".then(dropSymbol(types, f.ty)).then("(ptr ").then(reg).then(")"));
        };
        offset = offset + l.size;
        i = i + 1;
    };
    return out;
};

// The function that frees what a value of the type owns: the drop of the type first when it has one (not when the value
// was taken apart, which cleared its bytes), then what its fields or its elements own
fn dropFunctionLines(types: &List<TypeDecl>, fns: &List<String>, t: &Type) -> List<String> ~ {
    out = noStrings();
    out = push(out, "define internal void ".then(dropSymbol(types, t)).then("(ptr %slot) {"));
    out = push(out, "entry:");
    arr = sizedArray(t);
    if arr.ok {
        step = layoutOf(types, arr.elem).size;
        out = push(out, "    br label %ahead");
        out = push(out, "ahead:");
        out = push(out, "    %ai = phi i64 [0, %entry], [%anext, %abody]");
        out = push(out, "    %acond = icmp eq i64 %ai, ".then(showInt(arr.length)));
        out = push(out, "    br i1 %acond, label %done, label %abody");
        out = push(out, "abody:");
        out = push(out, "    %aoff = mul i64 %ai, ".then(showInt(step)));
        out = push(out, "    %ap = getelementptr i8, ptr %slot, i64 %aoff");
        out = push(out, "    call void ".then(dropSymbol(types, arr.elem)).then("(ptr %ap)"));
        out = push(out, "    %anext = add i64 %ai, 1");
        out = push(out, "    br label %ahead");
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok { return noStrings(); };
    variants = variantsOf(types, n.text);
    isEnumKind = isEnum(types, n.text);
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    start = 0;
    if isEnumKind { start = roundUp(4, payload); };
    if containsName(fns, dropName(n.text)) {
        size = layoutOf(types, t).size;
        out = push(out, "    br label %zhead");
        out = push(out, "zhead:");
        out = push(out, "    %zi = phi i64 [0, %entry], [%znext, %zbody]");
        out = push(out, "    %zcond = icmp eq i64 %zi, ".then(showInt(size)));
        out = push(out, "    br i1 %zcond, label %fields, label %zbody");
        out = push(out, "zbody:");
        out = push(out, "    %zp = getelementptr i8, ptr %slot, i64 %zi");
        out = push(out, "    %zb = load i8, ptr %zp");
        out = push(out, "    %znz = icmp ne i8 %zb, 0");
        out = push(out, "    %znext = add i64 %zi, 1");
        out = push(out, "    br i1 %znz, label %znonzero, label %zhead");
        out = push(out, "znonzero:");
        out = push(out, "    %dr = call i64 ".then(functionSymbol(dropName(n.text))).then("(ptr %slot)"));
        out = push(out, "    br label %fields");
        out = push(out, "fields:");
    };
    if isEnumKind {
        out = push(out, "    %tag = load i32, ptr %slot");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
        j = 0;
        for v in variants {
            out = push(out, "v".then(showInt(j)).then(":"));
            for l in dropFieldLines(types, fns, j, v.fields, start) { out = push(out, clone(l)); };
            out = push(out, "    br label %done");
            j = j + 1;
        };
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if size(variants) > 0 {
        for l in dropFieldLines(types, fns, 0, get(variants, 0).fields, start) { out = push(out, clone(l)); };
    };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// The function that frees what each of a run of values of the type owns (Addr::dropRange)
fn dropRangeFunctionLines(types: &List<TypeDecl>, fns: &List<String>, t: &Type) -> List<String> ~ {
    out = noStrings();
    step = layoutOf(types, t).size;
    out = push(out, "define internal void ".then(dropRangeSymbol(types, t)).then("(i64 %base, i64 %count) {"));
    out = push(out, "entry:");
    out = push(out, "    %basep = inttoptr i64 %base to ptr");
    out = push(out, "    br label %rhead");
    out = push(out, "rhead:");
    out = push(out, "    %ri = phi i64 [0, %entry], [%rnext, %rbody]");
    out = push(out, "    %rcond = icmp eq i64 %ri, %count");
    out = push(out, "    br i1 %rcond, label %done, label %rbody");
    out = push(out, "rbody:");
    out = push(out, "    %roff = mul i64 %ri, ".then(showInt(step)));
    out = push(out, "    %rp = getelementptr i8, ptr %basep, i64 %roff");
    out = push(out, "    call void ".then(dropSymbol(types, t)).then("(ptr %rp)"));
    out = push(out, "    %rnext = add i64 %ri, 1");
    out = push(out, "    br label %rhead");
    out = push(out, "done:");
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A drop function for every type that owns something to free, and the run function of each
fn dropFunctions(types: &List<TypeDecl>, fns: &List<String>, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        if needsDrop(types, fns, t) && (t is Type::TNamed || sizedArray(t).ok) {
            for l in dropFunctionLines(types, fns, t) { out = push(out, clone(l)); };
            for l in dropRangeFunctionLines(types, fns, t) { out = push(out, clone(l)); };
            out = push(out, "");
        };
    };
    return out;
};

// The lines that copy one field of a value at %from into %to, where the field is a value held inline (a word is
// already copied by the copy of the whole value): a copy the field's type makes itself, which is its `Clone`
// impl when it has one and the made function of its type when it does not
fn cloneFieldLines(cx: &Ctx, variantIndex: Int, fields: &List<Field>, start: Int) -> List<String> ~ {
    types = &cx.types;
    out = noStrings();
    offset = 0;
    i = 0;
    for f in fields {
        l = layoutOf(types, &f.ty);
        offset = roundUp(offset, l.align);
        ct = canonical(types, f.ty);
        if isAggregate(ct) {
            reg = "%cf".then(showInt(variantIndex)).then(".").then(showInt(i));
            out = push(out, "    ".then(reg).then("f = getelementptr i8, ptr %from, i64 ").then(showInt(start + offset)));
            out = push(out, "    ".then(reg).then("t = getelementptr i8, ptr %to, i64 ").then(showInt(start + offset)));
            implName = cloneImplName(cx, ct);
            if implName.ok {
                out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr ").then(reg).then("t, ptr ").then(reg).then("f)"));
            } else {
                out = push(out, "    call void ".then(cloneSymbol(types, ct)).then("(ptr ").then(reg).then("t, ptr ").then(reg).then("f)"));
            };
        };
        offset = offset + l.size;
        i = i + 1;
    };
    return out;
};

// The function that copies a value of the type into another that shares nothing with it, for a type with no
// `Clone` impl to call (a copy of a type that has one is that impl): the words of the value, and then what
// its fields or its elements hold, as a deep copy is made. A value that is not there (0)
// is copied as it is.
fn cloneFunctionLines(cx: &Ctx, t: &Type) -> List<String> ~ {
    types = &cx.types;
    out = noStrings();
    out = push(out, "define internal void ".then(cloneSymbol(types, t)).then("(ptr %to, ptr %from) {"));
    out = push(out, "entry:");
    bytes = layoutOf(types, t).size;
    if bytes > 0 {
        out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %to, ptr %from, i64 ".then(showInt(bytes)).then(", i1 false)"));
    };
    arr = sizedArray(t);
    if arr.ok {
        if needsDropIn(cx, arr.elem) {
            step = layoutOf(types, arr.elem).size;
            out = push(out, "    br label %chead");
            out = push(out, "chead:");
            out = push(out, "    %ci = phi i64 [0, %entry], [%cnext, %cbody]");
            out = push(out, "    %ccond = icmp eq i64 %ci, ".then(showInt(arr.length)));
            out = push(out, "    br i1 %ccond, label %done, label %cbody");
            out = push(out, "cbody:");
            out = push(out, "    %coff = mul i64 %ci, ".then(showInt(step)));
            out = push(out, "    %cfp = getelementptr i8, ptr %from, i64 %coff");
            out = push(out, "    %ctp = getelementptr i8, ptr %to, i64 %coff");
            implName = cloneImplName(cx, arr.elem);
            if implName.ok {
                out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %ctp, ptr %cfp)"));
            } else {
                out = push(out, "    call void ".then(cloneSymbol(types, arr.elem)).then("(ptr %ctp, ptr %cfp)"));
            };
            out = push(out, "    %cnext = add i64 %ci, 1");
            out = push(out, "    br label %chead");
            out = push(out, "done:");
        };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok {
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    variants = variantsOf(types, n.text);
    isEnumKind = isEnum(types, n.text);
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    start = 0;
    if isEnumKind { start = roundUp(4, payload); };
    if size(variants) > 0 && size(get(variants, 0).fields) > 0 && (beforeAngle(n.text) = "List" || beforeAngle(n.text) = "Box") {
        fields = get(variants, 0).fields;
        offset0 = 0;
        lenOffset = 0;
        capOffset = 0;
        offset = 0;
        i = 0;
        for f in fields {
            l = layoutOf(types, f.ty);
            offset = roundUp(offset, l.align);
            if i = 0 { offset0 = start + offset; };
            if i = 1 { lenOffset = start + offset; };
            if i = 2 { capOffset = start + offset; };
            offset = offset + l.size;
            i = i + 1;
        };
        held = get(fields, 0).ty;
        if held is Type::TAddr {
            elem = Box::unbox((held as Type::TAddr).inner);
            out = push(out, "    %addrp = getelementptr i8, ptr %from, i64 ".then(showInt(offset0)));
            out = push(out, "    %addr = load i64, ptr %addrp");
            out = push(out, "    %has = icmp ne i64 %addr, 0");
            if beforeAngle(n.text) = "List" {
                step = layoutOf(types, elem).size;
                out = push(out, "    br i1 %has, label %lalloc, label %done");
                out = push(out, "lalloc:");
                out = push(out, "    %lenp = getelementptr i8, ptr %from, i64 ".then(showInt(lenOffset)));
                out = push(out, "    %count = load i64, ptr %lenp");
                out = push(out, "    %bytes = mul i64 %count, ".then(showInt(step)));
                out = push(out, "    %copy = call ptr @tersus_box_new(i64 %bytes)");
                out = push(out, "    %base = inttoptr i64 %addr to ptr");
                if step > 0 {
                    out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %copy, ptr %base, i64 %bytes, i1 false)");
                };
                if needsDropIn(cx, elem) {
                    out = push(out, "    br label %lhead");
                    out = push(out, "lhead:");
                    out = push(out, "    %li = phi i64 [0, %lalloc], [%lnext, %lbody]");
                    out = push(out, "    %lcond = icmp eq i64 %li, %count");
                    out = push(out, "    br i1 %lcond, label %lstore, label %lbody");
                    out = push(out, "lbody:");
                    out = push(out, "    %loff = mul i64 %li, ".then(showInt(step)));
                    out = push(out, "    %lfp = getelementptr i8, ptr %base, i64 %loff");
                    out = push(out, "    %ltp = getelementptr i8, ptr %copy, i64 %loff");
                    implName = cloneImplName(cx, elem);
                    if implName.ok {
                        out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %ltp, ptr %lfp)"));
                    } else {
                        out = push(out, "    call void ".then(cloneSymbol(types, elem)).then("(ptr %ltp, ptr %lfp)"));
                    };
                    out = push(out, "    %lnext = add i64 %li, 1");
                    out = push(out, "    br label %lhead");
                    out = push(out, "lstore:");
                } else {
                    out = push(out, "    br label %lstore");
                    out = push(out, "lstore:");
                };
                out = push(out, "    %top = getelementptr i8, ptr %to, i64 ".then(showInt(offset0)));
                out = push(out, "    %copyi = ptrtoint ptr %copy to i64");
                out = push(out, "    store i64 %copyi, ptr %top");
                out = push(out, "    %capp = getelementptr i8, ptr %to, i64 ".then(showInt(capOffset)));
                out = push(out, "    store i64 %count, ptr %capp");
                out = push(out, "    br label %done");
                out = push(out, "done:");
            } else {
                esize = layoutOf(types, elem).size;
                out = push(out, "    br i1 %has, label %balloc, label %done");
                out = push(out, "balloc:");
                out = push(out, "    %heldp = inttoptr i64 %addr to ptr");
                out = push(out, "    %copy = call ptr @tersus_box_new(i64 ".then(showInt(esize)).then(")"));
                if isAggregate(elem) {
                    implName = cloneImplName(cx, elem);
                    if implName.ok {
                        out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %copy, ptr %heldp)"));
                    } else {
                        out = push(out, "    call void ".then(cloneSymbol(types, elem)).then("(ptr %copy, ptr %heldp)"));
                    };
                } else {
                    if esize > 0 {
                        out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %copy, ptr %heldp, i64 ".then(showInt(esize)).then(", i1 false)"));
                    };
                };
                out = push(out, "    %top = getelementptr i8, ptr %to, i64 ".then(showInt(offset0)));
                out = push(out, "    %copyi = ptrtoint ptr %copy to i64");
                out = push(out, "    store i64 %copyi, ptr %top");
                out = push(out, "    br label %done");
                out = push(out, "done:");
            };
            out = push(out, "    ret void");
            out = push(out, "}");
            return out;
        };
    };
    if isEnumKind {
        out = push(out, "    %tag = load i32, ptr %from");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
        j = 0;
        for v in variants {
            out = push(out, "v".then(showInt(j)).then(":"));
            for l in cloneFieldLines(cx, j, v.fields, start) { out = push(out, clone(l)); };
            out = push(out, "    br label %done");
            j = j + 1;
        };
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if size(variants) > 0 {
        for l in cloneFieldLines(cx, 0, get(variants, 0).fields, start) { out = push(out, clone(l)); };
    };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A copy function for every type that is a value held inline, for a copy of one that has no `Clone` impl to call
fn cloneFunctions(cx: &Ctx, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        if t is Type::TNamed || sizedArray(t).ok {
            for l in cloneFunctionLines(cx, t) { out = push(out, clone(l)); };
            out = push(out, "");
        };
    };
    return out;
};

// The lines that write a text, a byte at a time (tersus_writeByte is the byte of the runtime)
fn printTextLines(tagIn: &String, text: &String) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    i = 0;
    for b in text.bytes {
        out = push(out, "    %t".then(clone(tag)).then(".").then(showInt(i)).then(" = call i64 @tersus_writeByte(i64 ").then(showInt(toInt(b))).then(")"));
        i = i + 1;
    };
    return out;
};

// The lines that make the word a slot holds (slot_value of the runtime) in %<tag>w, from its address in %<tag>p
fn printWordLines(types: &List<TypeDecl>, tagIn: &String, ty: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    p = "%".then(clone(tag)).then("p");
    w = "%".then(clone(tag)).then("w");
    if isAggregate(ty) || sizedArray(ty).ok {
        out = push(out, "    ".then(w).then(" = ptrtoint ptr ").then(p).then(" to i64"));
        return out;
    };
    if ty is Type::TBool {
        out = push(out, "    %".then(clone(tag)).then("b = load i8, ptr ").then(p));
        out = push(out, "    %".then(clone(tag)).then("c = icmp ne i8 %".then(clone(tag)).then("b, 0")));
        out = push(out, "    ".then(w).then(" = zext i1 %".then(clone(tag)).then("c to i64")));
        return out;
    };
    simple = simpleLayout(ty);
    if simple.ok && simple.layout.size < 8 {
        bits = showInt(simple.layout.size * 8);
        out = push(out, "    %".then(clone(tag)).then("v = load i").then(bits).then(", ptr ").then(p));
        ext = "zext";
        if ty is Type::TWord && (ty as Type::TWord).signed { ext = "sext"; };
        out = push(out, "    ".then(w).then(" = ").then(ext).then(" i").then(bits).then(" %".then(clone(tag)).then("v to i64")));
        return out;
    };
    out = push(out, "    ".then(w).then(" = load i64, ptr ").then(p));
    return out;
};

// The lines that print the value of the type at %<tag>p
fn printCallLines(types: &List<TypeDecl>, tagIn: &String, ty: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    for l in printWordLines(types, tag, ty) { out = push(out, clone(l)); };
    out = push(out, "    call void ".then(printSymbol(types, ty)).then("(i64 %").then(clone(tag)).then("w)"));
    return out;
};

// The lines of the loop that prints elements (of the type at %<tag>p offsets in %base, their number in %count), between the brackets
fn printElementsLines(types: &List<TypeDecl>, tagIn: &String, elem: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    step = layoutOf(types, elem).size;
    for l in printTextLines(clone(tag).then("o"), "[") { out = push(out, clone(l)); };
    out = push(out, "    br label %".then(clone(tag)).then("head"));
    out = push(out, clone(tag).then("head:"));
    out = push(out, "    %".then(clone(tag)).then("i = phi i64 [0, %entry], [%").then(clone(tag)).then("next, %").then(clone(tag)).then("elem]"));
    out = push(out, "    %".then(clone(tag)).then("cond = icmp eq i64 %").then(clone(tag)).then("i, %count"));
    out = push(out, "    br i1 %".then(clone(tag)).then("cond, label %").then(clone(tag)).then("done, label %").then(clone(tag)).then("sepq"));
    out = push(out, clone(tag).then("sepq:"));
    out = push(out, "    %".then(clone(tag)).then("first = icmp eq i64 %").then(clone(tag)).then("i, 0"));
    out = push(out, "    br i1 %".then(clone(tag)).then("first, label %").then(clone(tag)).then("elem, label %").then(clone(tag)).then("sep"));
    out = push(out, clone(tag).then("sep:"));
    for l in printTextLines(clone(tag).then("s"), ", ") { out = push(out, clone(l)); };
    out = push(out, "    br label %".then(clone(tag)).then("elem"));
    out = push(out, clone(tag).then("elem:"));
    out = push(out, "    %".then(clone(tag)).then("off = mul i64 %").then(clone(tag)).then("i, ").then(showInt(step)));
    out = push(out, "    %e".then(clone(tag)).then("p = getelementptr i8, ptr %base, i64 %").then(clone(tag)).then("off"));
    for l in printCallLines(types, "e".then(clone(tag)), elem) { out = push(out, clone(l)); };
    out = push(out, "    %".then(clone(tag)).then("next = add i64 %").then(clone(tag)).then("i, 1"));
    out = push(out, "    br label %".then(clone(tag)).then("head"));
    out = push(out, clone(tag).then("done:"));
    for l in printTextLines(clone(tag).then("c"), "]") { out = push(out, clone(l)); };
    return out;
};

// The lines that print the number in %w, in decimal (the digits are made from the end of a room of the frame)
fn printDecimalLines(signed: Bool) -> List<String> ~ {
    out = noStrings();
    if signed {
        out = push(out, "    %negc = icmp slt i64 %w, 0");
        out = push(out, "    br i1 %negc, label %neg, label %conv0");
        out = push(out, "neg:");
        for l in printTextLines("m", "-") { out = push(out, clone(l)); };
        out = push(out, "    %mag0 = sub i64 0, %w");
        out = push(out, "    br label %conv");
        out = push(out, "conv0:");
        out = push(out, "    br label %conv");
        out = push(out, "conv:");
        out = push(out, "    %mag = phi i64 [%mag0, %neg], [%w, %conv0]");
    } else {
        out = push(out, "    %mag = add i64 %w, 0");
    };
    out = push(out, "    %buf = alloca [20 x i8]");
    out = push(out, "    %vp = alloca i64");
    out = push(out, "    store i64 %mag, ptr %vp");
    out = push(out, "    %cp = alloca i64");
    out = push(out, "    store i64 0, ptr %cp");
    out = push(out, "    %iszero = icmp eq i64 %mag, 0");
    out = push(out, "    br i1 %iszero, label %zero, label %dhead");
    out = push(out, "zero:");
    for l in printTextLines("z", "0") { out = push(out, clone(l)); };
    out = push(out, "    ret void");
    out = push(out, "dhead:");
    out = push(out, "    %v = load i64, ptr %vp");
    out = push(out, "    %ddone = icmp eq i64 %v, 0");
    out = push(out, "    br i1 %ddone, label %ohead, label %dbody");
    out = push(out, "dbody:");
    out = push(out, "    %d = urem i64 %v, 10");
    out = push(out, "    %ch = add i64 %d, 48");
    out = push(out, "    %chi = trunc i64 %ch to i8");
    out = push(out, "    %c = load i64, ptr %cp");
    out = push(out, "    %pos = sub i64 19, %c");
    out = push(out, "    %bp = getelementptr i8, ptr %buf, i64 %pos");
    out = push(out, "    store i8 %chi, ptr %bp");
    out = push(out, "    %nv = udiv i64 %v, 10");
    out = push(out, "    store i64 %nv, ptr %vp");
    out = push(out, "    %nc = add i64 %c, 1");
    out = push(out, "    store i64 %nc, ptr %cp");
    out = push(out, "    br label %dhead");
    out = push(out, "ohead:");
    out = push(out, "    %c2 = load i64, ptr %cp");
    out = push(out, "    %odone = icmp eq i64 %c2, 0");
    out = push(out, "    br i1 %odone, label %fin, label %obody");
    out = push(out, "obody:");
    out = push(out, "    %pos2 = sub i64 20, %c2");
    out = push(out, "    %bp2 = getelementptr i8, ptr %buf, i64 %pos2");
    out = push(out, "    %ch2 = load i8, ptr %bp2");
    out = push(out, "    %chw = zext i8 %ch2 to i64");
    out = push(out, "    %wr = call i64 @tersus_writeByte(i64 %chw)");
    out = push(out, "    %nc2 = sub i64 %c2, 1");
    out = push(out, "    store i64 %nc2, ptr %cp");
    out = push(out, "    br label %ohead");
    out = push(out, "fin:");
    out = push(out, "    ret void");
    return out;
};

// The offset of each field of a variant (after the tag of an enum)
fn printFieldStart(types: &List<TypeDecl>, variants: &List<Variant>, isEnumKind: Bool) -> Int ~ {
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    if isEnumKind { return roundUp(4, payload); };
    return 0;
};

// The function that prints a value of the type
fn printFunctionLines(types: &List<TypeDecl>, t: &Type) -> List<String> ~ {
    out = noStrings();
    out = push(out, "define internal void ".then(printSymbol(types, t)).then("(i64 %w) {"));
    out = push(out, "entry:");
    if t is Type::TInt || t is Type::TAddr {
        for l in printDecimalLines(true) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TWord && (t as Type::TWord).signed {
        for l in printDecimalLines(true) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TByte || t is Type::TWord {
        for l in printDecimalLines(false) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TBool {
        out = push(out, "    %cond = icmp ne i64 %w, 0");
        out = push(out, "    br i1 %cond, label %bt, label %bf");
        out = push(out, "bt:");
        for l in printTextLines("t", "true") { out = push(out, clone(l)); };
        out = push(out, "    br label %bend");
        out = push(out, "bf:");
        for l in printTextLines("f", "false") { out = push(out, clone(l)); };
        out = push(out, "    br label %bend");
        out = push(out, "bend:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if t is Type::TFn {
        for l in printTextLines("u", "<function>") { out = push(out, clone(l)); };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    arr = sizedArray(t);
    if arr.ok {
        out = push(out, "    %base = inttoptr i64 %w to ptr");
        out = push(out, "    %count = add i64 ".then(showInt(arr.length)).then(", 0"));
        for l in printElementsLines(types, "a", arr.elem) { out = push(out, clone(l)); };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok {
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    variants = variantsOf(types, n.text);
    enumKind = isEnum(types, n.text);
    start = printFieldStart(types, variants, enumKind);
    out = push(out, "    %slot = inttoptr i64 %w to ptr");
    if size(variants) > 0 && size(get(variants, 0).fields) > 0 && (beforeAngle(n.text) = "List" || beforeAngle(n.text) = "Box") {
        fields = get(variants, 0).fields;
        offset0 = 0;
        lenOffset = 0;
        offset = 0;
        i = 0;
        for f in fields {
            l = layoutOf(types, f.ty);
            offset = roundUp(offset, l.align);
            if i = 0 { offset0 = start + offset; };
            if i = 1 { lenOffset = start + offset; };
            offset = offset + l.size;
            i = i + 1;
        };
        held = get(fields, 0).ty;
        if held is Type::TAddr {
            elem = Box::unbox((held as Type::TAddr).inner);
            out = push(out, "    %addrp = getelementptr i8, ptr %slot, i64 ".then(showInt(offset0)));
            out = push(out, "    %addr = load i64, ptr %addrp");
            if beforeAngle(n.text) = "List" {
                out = push(out, "    %lenp = getelementptr i8, ptr %slot, i64 ".then(showInt(lenOffset)));
                out = push(out, "    %count = load i64, ptr %lenp");
                out = push(out, "    %base = inttoptr i64 %addr to ptr");
                for l in printElementsLines(types, "l", elem) { out = push(out, clone(l)); };
            } else {
                out = push(out, "    %eheldp = inttoptr i64 %addr to ptr");
                for l in printCallLines(types, "eheld", elem) { out = push(out, clone(l)); };
            };
            out = push(out, "    ret void");
            out = push(out, "}");
            return out;
        };
    };
    if enumKind {
        out = push(out, "    %tag = load i32, ptr %slot");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
    };
    j = 0;
    for v in variants {
        if enumKind { out = push(out, "v".then(showInt(j)).then(":")); };
        for l in printTextLines("n".then(showInt(j)), beforeAngle(v.name)) { out = push(out, clone(l)); };
        if size(v.fields) > 0 {
            for l in printTextLines("o".then(showInt(j)), " { ") { out = push(out, clone(l)); };
            offset = 0;
            i = 0;
            for f in v.fields {
                l = layoutOf(types, f.ty);
                offset = roundUp(offset, l.align);
                if i > 0 {
                    for l2 in printTextLines("s".then(showInt(j)).then(".").then(showInt(i)), ", ") { out = push(out, clone(l2)); };
                };
                for l2 in printTextLines("f".then(showInt(j)).then(".").then(showInt(i)), beforeAngle(f.name).then(": ")) { out = push(out, clone(l2)); };
                tag = "x".then(showInt(j)).then(".").then(showInt(i));
                out = push(out, "    %".then(tag).then("p = getelementptr i8, ptr %slot, i64 ").then(showInt(start + offset)));
                for l2 in printCallLines(types, tag, f.ty) { out = push(out, clone(l2)); };
                offset = offset + l.size;
                i = i + 1;
            };
            for l in printTextLines("c".then(showInt(j)), " }") { out = push(out, clone(l)); };
        };
        if enumKind { out = push(out, "    br label %done"); };
        j = j + 1;
    };
    if enumKind { out = push(out, "done:"); };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A print function for every type the program holds a value of
fn printFunctions(types: &List<TypeDecl>, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        for l in printFunctionLines(types, t) { out = push(out, clone(l)); };
        out = push(out, "");
    };
    return out;
};
