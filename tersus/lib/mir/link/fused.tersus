import data::codec::codec { Token };
import mir::copies::worklist { makeCopiesWithPolicy };
import mir::full::full { FullProgram, fullAt, printFull };
import mir::full::tokens { integerAt, textAt, wordIs, quotedAt };
import mir::instances::complete { completeInstancesWith };
import mir::instances::names { InstanceNameClasses };
import mir::link::merge { LinkUnit, linkPrograms };
import mir::link::profile { parseNameProfile };

fn originalLibraryNames(units: &List<LinkUnit>) -> HashSet<String> ~ {
    names = HashSet::new();
    for u in units {
        if u.pkg = "tersuslib" {
            for b in &u.program.bounded { names = names.insert(clone(b.name)); };
        };
    };
    return names;
};
fn runFusedUnits(lines: &List<List<Token>>, at: Int, units: &List<LinkUnit>) -> String ~ {
    profile = parseNameProfile(lines, at);
    if !profile.ok { return "the linking request has invalid or incomplete name classes"; };
    linked = linkPrograms(units);
    if !linked.ok { return linked.message; };
    command = get(lines, 1);
    library = HashSet::new(); recording = false;
    if size(command) = 4 {
        count = integerAt(command, 2);
        if !count.ok || count.value < 0 || count.value > size(*units) || !(wordIs(command, 3, "record") || wordIs(command, 3, "validate")) {
            return "the linking request has invalid library provenance or recording policy";
        };
        for i in 0..count.value {
            for row in &get(units, i).program.bounded { library = library.insert(clone(row.name)); };
        };
        recording = wordIs(command, 3, "record");
    } else {
        if linked.program.checked || size(command) != 2 { return "the linking request has no explicit library provenance or recording policy"; };
        library = originalLibraryNames(units);
    };
    return fusedLinkReply(&profile.value, &library, recording, linked.program);
};
fn fusedLinkReply(classes: &InstanceNameClasses, library: &HashSet<String>, recording: Bool, merged: FullProgram) -> String ~ {
    program = completeInstancesWith(merged, classes);
    copies = makeCopiesWithPolicy(classes, program, library, recording);
    if copies.error != "" { return "Validation failed: ".concat(&copies.error); };
    printFull(&copies.value);
    return "";
};
fn standaloneReply(lines: &List<List<Token>>) -> String ~ {
    if size(lines) < 3 { return "the copies request is not program data"; };
    request = get(lines, 1); n = integerAt(request, 1);
    if size(request) < 2 || !n.ok || n.value < 1 || n.value > size(lines) - 2 { return "the copies request is not program data"; };
    rows = [];
    for i in 2..2 + n.value { rows = push(rows, clone(get(lines, i))); };
    parsed = fullAt(&rows);
    if !parsed.ok { return "the copies request contains unreadable MIR3"; };
    library = HashSet::new();
    start = 2; recording = false;
    if wordIs(request, 2, "record") { start = 3; recording = true; };
    if parsed.value.checked && !recording { return "the copies request has no explicit recording policy"; };
    for i in start..size(request) {
        if !quotedAt(request, i) { return "the copies request has an invalid library name"; };
        library = library.insert(textAt(request, i));
    };
    profile = parseNameProfile(lines, 2 + n.value);
    if !profile.ok { return "the copies request has invalid or incomplete name classes"; };
    copies = makeCopiesWithPolicy(&profile.value, parsed.value, &library, recording);
    if copies.error != "" { return copies.error; };
    printFull(&copies.value);
    return "";
};
