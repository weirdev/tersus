import data::codec::codec { Token };
import mir::full::full { FullProgram, fullAt, printFull };
import mir::full::tokens { integerAt, textAt, wordIs, quotedAt };
import mir::full::read { recordAt };
import mir::link::merge { LinkUnit, linkPrograms, completeSpecEnvs };
import mir::link::prune { pruneProgram };

fn isLinkRequest(lines: &List<List<Token>>) -> Bool ~ {
    row = recordAt(lines, 0);
    return size(row) = 2 && wordIs(&row, 0, "pass") && wordIs(&row, 1, "link");
};
fn takeRows(lines: &List<List<Token>>, lo: Int, hi: Int) -> List<List<Token>> ~ {
    out = []; if lo < 0 || hi < lo || hi > size(lines) { return out; };
    for i in lo..hi { out = push(out, clone(get(lines, i))); }; return out;
};
fn linkError(message: &String) -> Bool ~ { message.printError(); "\n".printError(); return false; };
fn mergeRequest(lines: &List<List<Token>>) -> Bool ~ {
    header = recordAt(lines, 1); count = integerAt(&header, 1);
    if size(header) != 2 || !count.ok || count.value < 0 || count.value > size(lines) { return linkError("the linking request is not unit data"); };
    units = []; at = 2;
    for i in 0..count.value {
        row = recordAt(lines, at); sizeAt = 3; hasModule = false;
        if wordIs(&row, 2, "some") { sizeAt = 4; hasModule = true; } else { if !wordIs(&row, 2, "none") { return linkError("the linking request has no module identity"); }; };
        n = integerAt(&row, sizeAt);
        if !wordIs(&row, 0, "unit") || !quotedAt(&row, 1) || (hasModule && !quotedAt(&row, 3)) || size(row) != sizeAt + 1 || !n.ok || n.value < 0 || n.value > size(lines) - at - 1 { return linkError("the linking request is not unit data"); };
        p = fullAt(takeRows(lines, at + 1, at + 1 + n.value));
        if !p.ok { return linkError("the linking request contains unreadable MIR3"); };
        modu = ""; if hasModule { modu = textAt(&row, 3); };
        units = push(units, LinkUnit { pkg: textAt(&row, 1), modu: modu, hasModule: hasModule, program: p.value }); at = at + n.value + 1;
    };
    if at != size(lines) { return linkError("the linking request has trailing data"); };
    linked = linkPrograms(&units); if !linked.ok { return linkError(&linked.message); };
    printFull(&linked.program); return true;
};
fn runLink(lines: &List<List<Token>>) -> Bool ~ {
    if !isLinkRequest(lines) { return linkError("the input is not a linking request"); };
    command = recordAt(lines, 1);
    if wordIs(&command, 0, "merge") { return mergeRequest(lines); };
    if size(command) != 1 { return linkError("the linking request has no operation"); };
    p = fullAt(takeRows(lines, 2, size(lines))); if !p.ok { return linkError("the linking request contains unreadable MIR3"); };
    program = p.value;
    if wordIs(&command, 0, "prune") { program = pruneProgram(program); } else {
        if wordIs(&command, 0, "environments") { program = completeSpecEnvs(program); } else { return linkError("the linking request has no operation"); };
    };
    printFull(&program); return true;
};
