import data::ast::ast { AstNode, AstName, AstValue, AstBody, AstExpression, AstTermination, AstValidation, AstProof, AstRule, AstStatement, AstSignature, AstTraitFn, AstBound, AstField, AstVariant, AstValueField, AstArg, AstOptName, AstOptTermination, AstBuiltin, AstNames, AstValues, AstStatements, AstExpressions, AstValidations, AstProofs, AstFields, AstVariants, AstValueFields, AstTypes, AstArgs, AstTraitFns, AstBounds, AstElaborated, AstEntry, AstEntries, AstOptNames, AstOptType, AstInterface, AstScheme };
import data::reader::reader { nodeKind, nodeRefs, nameValue };
import data::arena::arena { remapNode };
import data::codec::codec { Type, Size };
import mir::full::records { nodeAt };

fn shape(node: &AstNode) -> Int ~ {
    if node is AstNode::Name { return 0 + shapeName((node as AstNode::Name).value); };
    if node is AstNode::Type { return 100 + shapeType((node as AstNode::Type).value); };
    if node is AstNode::Size { return 200 + shapeSize((node as AstNode::Size).value); };
    if node is AstNode::Value { return 300 + shapeValue((node as AstNode::Value).value); };
    if node is AstNode::Body { return 400 + shapeBody((node as AstNode::Body).value); };
    if node is AstNode::Expression { return 500 + shapeExpression((node as AstNode::Expression).value); };
    if node is AstNode::Termination { return 600 + shapeTermination((node as AstNode::Termination).value); };
    if node is AstNode::Validation { return 700 + shapeValidation((node as AstNode::Validation).value); };
    if node is AstNode::Proof { return 800 + shapeProof((node as AstNode::Proof).value); };
    if node is AstNode::Rule { return 900 + shapeRule((node as AstNode::Rule).value); };
    if node is AstNode::Statement { return 1000 + shapeStatement((node as AstNode::Statement).value); };
    if node is AstNode::Signature { return 1100 + shapeSignature((node as AstNode::Signature).value); };
    if node is AstNode::TraitFn { return 1200 + shapeTraitFn((node as AstNode::TraitFn).value); };
    if node is AstNode::Bound { return 1300 + shapeBound((node as AstNode::Bound).value); };
    if node is AstNode::Field { return 1400 + shapeField((node as AstNode::Field).value); };
    if node is AstNode::Variant { return 1500 + shapeVariant((node as AstNode::Variant).value); };
    if node is AstNode::ValueField { return 1600 + shapeValueField((node as AstNode::ValueField).value); };
    if node is AstNode::Arg { return 1700 + shapeArg((node as AstNode::Arg).value); };
    if node is AstNode::OptName { return 1800 + shapeOptName((node as AstNode::OptName).value); };
    if node is AstNode::OptTermination { return 1900 + shapeOptTermination((node as AstNode::OptTermination).value); };
    if node is AstNode::Builtin { return 2000 + shapeBuiltin((node as AstNode::Builtin).value); };
    if node is AstNode::Names { return 2100 + shapeNames((node as AstNode::Names).value); };
    if node is AstNode::Values { return 2200 + shapeValues((node as AstNode::Values).value); };
    if node is AstNode::Statements { return 2300 + shapeStatements((node as AstNode::Statements).value); };
    if node is AstNode::Expressions { return 2400 + shapeExpressions((node as AstNode::Expressions).value); };
    if node is AstNode::Validations { return 2500 + shapeValidations((node as AstNode::Validations).value); };
    if node is AstNode::Proofs { return 2600 + shapeProofs((node as AstNode::Proofs).value); };
    if node is AstNode::Fields { return 2700 + shapeFields((node as AstNode::Fields).value); };
    if node is AstNode::Variants { return 2800 + shapeVariants((node as AstNode::Variants).value); };
    if node is AstNode::ValueFields { return 2900 + shapeValueFields((node as AstNode::ValueFields).value); };
    if node is AstNode::Types { return 3000 + shapeTypes((node as AstNode::Types).value); };
    if node is AstNode::Args { return 3100 + shapeArgs((node as AstNode::Args).value); };
    if node is AstNode::TraitFns { return 3200 + shapeTraitFns((node as AstNode::TraitFns).value); };
    if node is AstNode::Bounds { return 3300 + shapeBounds((node as AstNode::Bounds).value); };
    if node is AstNode::Elaborated { return 3400 + shapeElaborated((node as AstNode::Elaborated).value); };
    if node is AstNode::Entry { return 3500 + shapeEntry((node as AstNode::Entry).value); };
    if node is AstNode::Entries { return 3600 + shapeEntries((node as AstNode::Entries).value); };
    if node is AstNode::OptNames { return 3700 + shapeOptNames((node as AstNode::OptNames).value); };
    if node is AstNode::OptType { return 3800 + shapeOptType((node as AstNode::OptType).value); };
    if node is AstNode::Interface { return 3900 + shapeInterface((node as AstNode::Interface).value); };
    if node is AstNode::Scheme { return 4000 + shapeScheme((node as AstNode::Scheme).value); };
    return 0 - 1;
};

fn shapeName(v: &AstName) -> Int ~ {
    if v is AstName::End { return 0; };
    if v is AstName::Part { return 1; };
    return 0 - 1;
};
fn shapeType(v: &Type) -> Int ~ { return 0; };
fn shapeSize(v: &Size) -> Int ~ { return 0; };
fn shapeValue(v: &AstValue) -> Int ~ {
    if v is AstValue::VInt { return 0; };
    if v is AstValue::VList { return 1; };
    if v is AstValue::VBool { return 2; };
    if v is AstValue::VData { return 3; };
    if v is AstValue::VFnRef { return 4; };
    if v is AstValue::VFunct { return 5; };
    return 0 - 1;
};
fn shapeBody(v: &AstBody) -> Int ~ {
    if v is AstBody::NativeFunct { return 0; };
    if v is AstBody::BuiltinFunct { return 1; };
    return 0 - 1;
};
fn shapeExpression(v: &AstExpression) -> Int ~ {
    if v is AstExpression::Val { return 0; };
    if v is AstExpression::Var { return 1; };
    if v is AstExpression::F { return 2; };
    return 0 - 1;
};
fn shapeTermination(v: &AstTermination) -> Int ~ {
    if v is AstTermination::Shrinks { return 0; };
    if v is AstTermination::Counting { return 1; };
    if v is AstTermination::Parts { return 2; };
    if v is AstTermination::MayDiverge { return 3; };
    if v is AstTermination::Recursing { return 4; };
    return 0 - 1;
};
fn shapeValidation(v: &AstValidation) -> Int ~ {
    if v is AstValidation::Rewrite { return 0; };
    if v is AstValidation::ProofAssert { return 1; };
    if v is AstValidation::AssignProofVar { return 2; };
    if v is AstValidation::Assume { return 3; };
    return 0 - 1;
};
fn shapeProof(v: &AstProof) -> Int ~ {
    if v is AstProof::FApp { return 0; };
    if v is AstProof::ATerm { return 1; };
    if v is AstProof::CTerm { return 2; };
    if v is AstProof::Forall { return 3; };
    if v is AstProof::BVar { return 4; };
    return 0 - 1;
};
fn shapeRule(v: &AstRule) -> Int ~ {
    if v is AstRule::Refl { return 0; };
    if v is AstRule::Eval { return 1; };
    if v is AstRule::EvalAll { return 2; };
    if v is AstRule::CheckGtZero { return 3; };
    if v is AstRule::CheckRel { return 4; };
    if v is AstRule::UserRewrite { return 5; };
    return 0 - 1;
};
fn shapeStatement(v: &AstStatement) -> Int ~ {
    if v is AstStatement::Assign { return 0; };
    if v is AstStatement::AssignDeref { return 1; };
    if v is AstStatement::Let { return 2; };
    if v is AstStatement::Return { return 3; };
    if v is AstStatement::ValidationStatement { return 4; };
    if v is AstStatement::StructDef { return 5; };
    if v is AstStatement::EnumDef { return 6; };
    if v is AstStatement::AxiomDef { return 7; };
    if v is AstStatement::ProofDef { return 8; };
    if v is AstStatement::Block { return 9; };
    if v is AstStatement::If { return 10; };
    if v is AstStatement::While { return 11; };
    if v is AstStatement::TraitDef { return 12; };
    if v is AstStatement::ImplDef { return 13; };
    if v is AstStatement::BoundedDef { return 14; };
    if v is AstStatement::Mark { return 15; };
    if v is AstStatement::CopyDef { return 16; };
    if v is AstStatement::LinearDef { return 17; };
    if v is AstStatement::ExternDef { return 18; };
    if v is AstStatement::DropDef { return 19; };
    if v is AstStatement::Dissolve { return 20; };
    if v is AstStatement::Instance { return 21; };
    if v is AstStatement::PackLoop { return 22; };
    return 0 - 1;
};
fn shapeSignature(v: &AstSignature) -> Int ~ { return 0; };
fn shapeTraitFn(v: &AstTraitFn) -> Int ~ { return 0; };
fn shapeBound(v: &AstBound) -> Int ~ { return 0; };
fn shapeField(v: &AstField) -> Int ~ { return 0; };
fn shapeVariant(v: &AstVariant) -> Int ~ { return 0; };
fn shapeValueField(v: &AstValueField) -> Int ~ { return 0; };
fn shapeArg(v: &AstArg) -> Int ~ {
    if v is AstArg::ArgSize { return 0; };
    if v is AstArg::ArgType { return 1; };
    return 0 - 1;
};
fn shapeOptName(v: &AstOptName) -> Int ~ {
    if v is AstOptName::NoName { return 0; };
    if v is AstOptName::SomeName { return 1; };
    return 0 - 1;
};
fn shapeOptTermination(v: &AstOptTermination) -> Int ~ {
    if v is AstOptTermination::NoTermination { return 0; };
    if v is AstOptTermination::SomeTermination { return 1; };
    return 0 - 1;
};
fn shapeBuiltin(v: &AstBuiltin) -> Int ~ {
    if v is AstBuiltin::Ctor { return 0; };
    if v is AstBuiltin::FieldBuiltin { return 1; };
    if v is AstBuiltin::Is { return 2; };
    if v is AstBuiltin::Project { return 3; };
    if v is AstBuiltin::Cast { return 4; };
    if v is AstBuiltin::ToWord { return 5; };
    if v is AstBuiltin::Rel { return 6; };
    if v is AstBuiltin::Primitive { return 7; };
    return 0 - 1;
};
fn shapeNames(v: &AstNames) -> Int ~ {
    if v is AstNames::End { return 0; };
    if v is AstNames::Cons { return 1; };
    return 0 - 1;
};
fn shapeValues(v: &AstValues) -> Int ~ {
    if v is AstValues::End { return 0; };
    if v is AstValues::Cons { return 1; };
    return 0 - 1;
};
fn shapeStatements(v: &AstStatements) -> Int ~ {
    if v is AstStatements::End { return 0; };
    if v is AstStatements::Cons { return 1; };
    return 0 - 1;
};
fn shapeExpressions(v: &AstExpressions) -> Int ~ {
    if v is AstExpressions::End { return 0; };
    if v is AstExpressions::Cons { return 1; };
    return 0 - 1;
};
fn shapeValidations(v: &AstValidations) -> Int ~ {
    if v is AstValidations::End { return 0; };
    if v is AstValidations::Cons { return 1; };
    return 0 - 1;
};
fn shapeProofs(v: &AstProofs) -> Int ~ {
    if v is AstProofs::End { return 0; };
    if v is AstProofs::Cons { return 1; };
    return 0 - 1;
};
fn shapeFields(v: &AstFields) -> Int ~ {
    if v is AstFields::End { return 0; };
    if v is AstFields::Cons { return 1; };
    return 0 - 1;
};
fn shapeVariants(v: &AstVariants) -> Int ~ {
    if v is AstVariants::End { return 0; };
    if v is AstVariants::Cons { return 1; };
    return 0 - 1;
};
fn shapeValueFields(v: &AstValueFields) -> Int ~ {
    if v is AstValueFields::End { return 0; };
    if v is AstValueFields::Cons { return 1; };
    return 0 - 1;
};
fn shapeTypes(v: &AstTypes) -> Int ~ {
    if v is AstTypes::End { return 0; };
    if v is AstTypes::Cons { return 1; };
    return 0 - 1;
};
fn shapeArgs(v: &AstArgs) -> Int ~ {
    if v is AstArgs::End { return 0; };
    if v is AstArgs::Cons { return 1; };
    return 0 - 1;
};
fn shapeTraitFns(v: &AstTraitFns) -> Int ~ {
    if v is AstTraitFns::End { return 0; };
    if v is AstTraitFns::Cons { return 1; };
    return 0 - 1;
};
fn shapeBounds(v: &AstBounds) -> Int ~ {
    if v is AstBounds::End { return 0; };
    if v is AstBounds::Cons { return 1; };
    return 0 - 1;
};
fn shapeElaborated(v: &AstElaborated) -> Int ~ { return 0; };
fn shapeEntry(v: &AstEntry) -> Int ~ {
    if v is AstEntry::NamesEntry { return 0; };
    if v is AstEntry::CtorEntry { return 1; };
    if v is AstEntry::GenericEntry { return 2; };
    if v is AstEntry::InvariantEntry { return 3; };
    if v is AstEntry::TraitEntry { return 4; };
    if v is AstEntry::FunctionEntry { return 5; };
    if v is AstEntry::PairEntry { return 6; };
    if v is AstEntry::AssocEntry { return 7; };
    if v is AstEntry::ImplArgsEntry { return 8; };
    if v is AstEntry::ImplBoundsEntry { return 9; };
    if v is AstEntry::TemplateEntry { return 10; };
    if v is AstEntry::TypeEntry { return 11; };
    if v is AstEntry::SurfaceEntry { return 12; };
    if v is AstEntry::BuiltinEntry { return 13; };
    return 0 - 1;
};
fn shapeEntries(v: &AstEntries) -> Int ~ {
    if v is AstEntries::End { return 0; };
    if v is AstEntries::Cons { return 1; };
    return 0 - 1;
};
fn shapeOptNames(v: &AstOptNames) -> Int ~ {
    if v is AstOptNames::End { return 0; };
    if v is AstOptNames::Cons { return 1; };
    return 0 - 1;
};
fn shapeOptType(v: &AstOptType) -> Int ~ {
    if v is AstOptType::NoType { return 0; };
    if v is AstOptType::SomeType { return 1; };
    return 0 - 1;
};
fn shapeInterface(v: &AstInterface) -> Int ~ { return 0; };
fn shapeScheme(v: &AstScheme) -> Int ~ {
    if v is AstScheme::SigFn { return 0; };
    if v is AstScheme::SigDynamic { return 1; };
    if v is AstScheme::SigValueError { return 2; };
    return 0 - 1;
};

fn builtinValue(nodes: &List<AstNode>, id: Int) -> Int ~ {
    node = nodeAt(nodes, id);
    if !(node is AstNode::Value) || !((node as AstNode::Value).value is AstValue::VFunct) { return 0 - 1; };
    body = nodeAt(nodes, ((node as AstNode::Value).value as AstValue::VFunct).body);
    if !(body is AstNode::Body) || !((body as AstNode::Body).value is AstBody::BuiltinFunct) { return 0 - 1; };
    return ((body as AstNode::Body).value as AstBody::BuiltinFunct).b;
};
fn sameScalar(a: &AstNode, b: &AstNode) -> Bool ~ {
    if a is AstNode::Type && b is AstNode::Type { return (a as AstNode::Type).value = (b as AstNode::Type).value; };
    if a is AstNode::Size && b is AstNode::Size { return (a as AstNode::Size).value = (b as AstNode::Size).value; };
    if a is AstNode::Value && b is AstNode::Value {
        x = (a as AstNode::Value).value; y = (b as AstNode::Value).value;
        if x is AstValue::VBool && y is AstValue::VBool { return (x as AstValue::VBool).b = (y as AstValue::VBool).b; };
    };
    if a is AstNode::Statement && b is AstNode::Statement {
        x = (a as AstNode::Statement).value; y = (b as AstNode::Statement).value;
        if x is AstStatement::Mark && y is AstStatement::Mark { return (x as AstStatement::Mark).line = (y as AstStatement::Mark).line && (x as AstStatement::Mark).col = (y as AstStatement::Mark).col; };
        if x is AstStatement::PackLoop && y is AstStatement::PackLoop { return (x as AstStatement::PackLoop).take = (y as AstStatement::PackLoop).take; };
    };
    if a is AstNode::Builtin && b is AstNode::Builtin {
        x = (a as AstNode::Builtin).value; y = (b as AstNode::Builtin).value;
        if x is AstBuiltin::ToWord && y is AstBuiltin::ToWord { return (x as AstBuiltin::ToWord).signed = (y as AstBuiltin::ToWord).signed && (x as AstBuiltin::ToWord).bits = (y as AstBuiltin::ToWord).bits; };
        if x is AstBuiltin::Rel && y is AstBuiltin::Rel { return (x as AstBuiltin::Rel).r = (y as AstBuiltin::Rel).r; };
        if x is AstBuiltin::Primitive && y is AstBuiltin::Primitive { return (x as AstBuiltin::Primitive).name = (y as AstBuiltin::Primitive).name; };
    };
    if a is AstNode::Entry && b is AstNode::Entry {
        x = (a as AstNode::Entry).value; y = (b as AstNode::Entry).value;
        if x is AstEntry::SurfaceEntry && y is AstEntry::SurfaceEntry { return (x as AstEntry::SurfaceEntry).space = (y as AstEntry::SurfaceEntry).space; };
    };
    return true;
};
fn sameAst(a: &List<AstNode>, x: Int, b: &List<AstNode>, y: Int) -> Bool ~ {
    if x < 0 || y < 0 || x >= size(a) || y >= size(b) { return false; };
    left = nodeAt(a, x); right = nodeAt(b, y);
    if left is AstNode::Name && right is AstNode::Name { return nameValue(a, x) = nameValue(b, y); };
    lb = builtinValue(a, x); rb = builtinValue(b, y);
    // Eq Syntax.Value compares a builtin function only by its builtin, not its contracts.
    if lb >= 0 && rb >= 0 { return sameAst(a, lb, b, rb); };
    if shape(&left) != shape(&right) || !sameScalar(&left, &right) { return false; };
    ls = nodeRefs(&left); rs = nodeRefs(&right);
    if size(ls) != size(rs) { return false; };
    for i in 0..size(ls) { if i < size(rs) && !sameAst(a, get(&ls, i), b, get(&rs, i)) { return false; }; };
    return true;
};
