import data::codec::codec { Token, Parsed };
import data::reader::reader { parseAstLines };
import data::ast::ast { AstNode, AstStatement, AstValidations };
import mir::full::full { FullRecord, FullBlock, FullFunction, FullProgram };
import mir::full::tokens { argsEnd, integerAt, intsEnd, namesEnd, numberAt, operandsEnd, operandEnd, quotedAt, rvalueEnd, stepsEnd, textAt, tokenLine, typeEnd, word, wordIs, normalizeNumbers, normalizeTypes, sliceTokens };
import mir::full::records { EnvEntry, envEnd, envEntries, expandEnv, listItems, mapPayloadLine, payloadMatches, payloadSlots, uniqueEntries, orderEntries, envTokens, keyOrder };
import mir::full::write { mapProgramPayloads };

fn noFunction() -> FullFunction ~ { return FullFunction { header: [], spec: [], env: [], locals: [], loops: [], blocks: [] }; };
fn noFull() -> FullProgram ~ { return FullProgram { types: [], generics: [], invariants: [], bounded: [], boundedFacts: [], instances: [], protocols: [], ownership: [], checked: false, functions: [], entry: noFunction(), trailer: [], arena: [], shared: [] }; };
fn protocolRoles() -> List<String> ~ { return push(push(push(push(push(push(push([], "Box"), "Clone"), "Copy"), "Deref"), "Drop"), "Eq"), "List"); };
// A role's checked provider: one of the roles, and a declaration's name
fn protocolOk(ts: &List<Token>) -> Bool ~ {
    if size(ts) != 3 || !wordIs(ts, 0, "protocol") || !quotedAt(ts, 1) || !quotedAt(ts, 2) || size(textAt(ts, 2).bytes) = 0 { return false; };
    role = textAt(ts, 1);
    for r in protocolRoles() { if r = role { return true; }; };
    return false;
};
// Seven names from at, as an owned row's: a Copy provider or none, and each of Drop, Clone and Deref a provider with its
// function or neither
fn factNamesOk(ts: &List<Token>, at: Int) -> Bool ~ {
    if at < 0 || size(ts) != at + 7 { return false; };
    for i in at..at + 7 { if !quotedAt(ts, i) { return false; }; };
    for i in 0..3 { if (size(textAt(ts, at + 1 + 2 * i).bytes) = 0) != (size(textAt(ts, at + 2 + 2 * i).bytes) = 0) { return false; }; };
    return true;
};
// A function with bounds' checked facts of a type: the function, the type and the facts' seven names
fn boundedFactsOk(ts: &List<Token>) -> Bool ~ {
    if !wordIs(ts, 0, "boundedfacts") || !quotedAt(ts, 1) { return false; };
    return factNamesOk(ts, typeEnd(ts, 2));
};
// The function and the type of a boundedfacts row, as tokens, which name it once
fn boundedFactsKey(ts: &List<Token>) -> List<Token> ~ { return sliceTokens(ts, 1, typeEnd(ts, 2)); };
// An owner's checked facts: the owner and the seven names
fn ownedOk(ts: &List<Token>) -> Bool ~ {
    return wordIs(ts, 0, "owned") && quotedAt(ts, 1) && size(textAt(ts, 1).bytes) > 0 && factNamesOk(ts, 2);
};
fn badFull() -> Parsed<FullProgram> ~ { return Parsed<FullProgram> { value: noFull(), pos: 0, ok: false }; };
fn recordAt(lines: &List<List<Token>>, i: Int) -> List<Token> ~ {
    if i < 0 || i >= size(lines) { return []; };
    return normalizeNumbers(clone(get(lines, i)));
};
fn fieldsEnd(ts: &List<Token>, p: Int) -> Int ~ {
    n = numberAt(ts, p);
    if n < 0 { return 0 - 1; };
    at = p + 1;
    for i in 0..n { if !quotedAt(ts, at) { return 0 - 1; }; at = typeEnd(ts, at + 1); if at < 0 { return at; }; };
    return at;
};
fn declarationEnd(ts: &List<Token>) -> Int ~ {
    if !quotedAt(ts, 1) { return 0 - 1; };
    if wordIs(ts, 0, "struct") { return fieldsEnd(ts, 2); };
    if wordIs(ts, 0, "generic") { return fieldsEnd(ts, namesEnd(ts, 2)); };
    if wordIs(ts, 0, "instance") {
        if !quotedAt(ts, 2) { return 0 - 1; };
        return argsEnd(ts, 4, numberAt(ts, 3));
    };
    if wordIs(ts, 0, "invariant") { if integerAt(ts, 2).ok { return 3; }; return 0 - 1; };
    if wordIs(ts, 0, "bounded") { return boundedEnd(ts); };
    if !wordIs(ts, 0, "enum") { return 0 - 1; };
    n = numberAt(ts, 2); at = 3;
    if n < 0 { return 0 - 1; };
    for i in 0..n { if !quotedAt(ts, at) { return 0 - 1; }; at = fieldsEnd(ts, at + 1); if at < 0 { return at; }; };
    return at;
};
fn boundedEnd(ts: &List<Token>) -> Int ~ {
    at = namesEnd(ts, 2); at = namesEnd(ts, at); at = namesEnd(ts, at);
    n = numberAt(ts, at);
    if n < 0 { return 0 - 1; };
    at = at + 1;
    for i in 0..n {
        for j in at..at + 3 { if !integerAt(ts, j).ok { return 0 - 1; }; };
        at = intsEnd(ts, at + 3); at = intsEnd(ts, at);
        for j in at..at + 2 { if !integerAt(ts, j).ok { return 0 - 1; }; };
        if !quotedAt(ts, at + 2) || !integerAt(ts, at + 3).ok || !integerAt(ts, at + 4).ok { return 0 - 1; };
        at = at + 5;
        if !(wordIs(ts, at, "none") || integerAt(ts, at).ok) { return 0 - 1; };
        at = at + 1;
    };
    return at;
};
fn headerOk(ts: &List<Token>) -> Bool ~ {
    if !quotedAt(ts, 1) || !wordIs(ts, 2, "params") { return false; };
    at = intsEnd(ts, 3);
    if !wordIs(ts, at, "returns") { return false; };
    at = at + 1;
    if wordIs(ts, at, "none") { at = at + 1; } else {
        if !wordIs(ts, at, "some") { return false; };
        at = typeEnd(ts, at + 1);
    };
    if !wordIs(ts, at, "sizeparams") { return false; };
    at = namesEnd(ts, at + 1);
    if !wordIs(ts, at, "typeparams") { return false; };
    at = namesEnd(ts, at + 1);
    if !wordIs(ts, at, "borrowed") { return false; };
    at = intsEnd(ts, at + 1);
    if at = size(ts) { return true; };
    if !wordIs(ts, at, "mutborrowed") { return false; };
    at = intsEnd(ts, at + 1);
    if !wordIs(ts, at, "from") { return false; };
    return intsEnd(ts, at + 1) = size(ts);
};
fn specOk(ts: &List<Token>) -> Bool ~ {
    if !wordIs(ts, 0, "spec") || !wordIs(ts, 1, "requires") || !integerAt(ts, 2).ok || !wordIs(ts, 3, "ensures") || !integerAt(ts, 4).ok || !wordIs(ts, 5, "termination") { return false; };
    if !(wordIs(ts, 6, "none") || integerAt(ts, 6).ok) || !wordIs(ts, 7, "writes") { return false; };
    at = namesEnd(ts, 8);
    if !wordIs(ts, at, "mutparams") { return false; };
    at = namesEnd(ts, at + 1);
    if !wordIs(ts, at, "from") { return false; };
    return namesEnd(ts, at + 1) = size(ts);
};
fn loopOk(ts: &List<Token>) -> Bool ~ {
    return wordIs(ts, 0, "loop") && integerAt(ts, 1).ok && wordIs(ts, 2, "body") && integerAt(ts, 3).ok && wordIs(ts, 4, "invariant") && integerAt(ts, 5).ok && wordIs(ts, 6, "termination") && (wordIs(ts, 7, "none") || integerAt(ts, 7).ok) && wordIs(ts, 8, "env") && envEnd(ts, 9) = size(ts);
};
fn localOk(ts: &List<Token>) -> Bool ~ {
    if !wordIs(ts, 0, "local") || !integerAt(ts, 1).ok { return false; };
    if wordIs(ts, 2, "none") { return typeEnd(ts, 3) = size(ts); };
    return wordIs(ts, 2, "some") && quotedAt(ts, 3) && typeEnd(ts, 4) = size(ts);
};
fn ghostOk(ts: &List<Token>) -> Bool ~ {
    at = envEnd(ts, 2);
    if at < 0 { return false; };
    if wordIs(ts, 1, "validation") || wordIs(ts, 1, "axiom") || wordIs(ts, 1, "proof") || wordIs(ts, 1, "dissolve") { return integerAt(ts, at).ok && at + 1 = size(ts); };
    if wordIs(ts, 1, "position") { return integerAt(ts, at).ok && integerAt(ts, at + 1).ok && at + 2 = size(ts); };
    if wordIs(ts, 1, "function") { return quotedAt(ts, at) && quotedAt(ts, at + 1) && (wordIs(ts, at + 2, "true") || wordIs(ts, at + 2, "false")) && at + 3 = size(ts); };
    return false;
};
fn terminator(ts: &List<Token>) -> Bool ~ {
    return wordIs(ts, 0, "goto") || wordIs(ts, 0, "switch") || wordIs(ts, 0, "call") || wordIs(ts, 0, "return") || wordIs(ts, 0, "unreachable");
};
fn lineOk(ts: &List<Token>) -> Bool ~ {
    if wordIs(ts, 0, "assign") || wordIs(ts, 0, "peek") { return integerAt(ts, 1).ok && rvalueEnd(ts, 2) = size(ts); };
    if wordIs(ts, 0, "assignref") { return integerAt(ts, 1).ok && rvalueEnd(ts, stepsEnd(ts, 2)) = size(ts); };
    if wordIs(ts, 0, "ghost") { return ghostOk(ts); };
    if wordIs(ts, 0, "drop") || wordIs(ts, 0, "goto") { return integerAt(ts, 1).ok && size(ts) = 2; };
    if wordIs(ts, 0, "return") || wordIs(ts, 0, "unreachable") { return size(ts) = 1; };
    if wordIs(ts, 0, "switch") { at = operandEnd(ts, 1); return at >= 0 && integerAt(ts, at).ok && integerAt(ts, at + 1).ok && at + 2 = size(ts); };
    if wordIs(ts, 0, "call") {
        at = operandEnd(ts, 1); n = numberAt(ts, at);
        at = operandsEnd(ts, at + 1, n);
        return at >= 0 && integerAt(ts, at).ok && integerAt(ts, at + 1).ok && at + 2 = size(ts);
    };
    return false;
};
fn functionAt(lines: &List<List<Token>>, start: Int, shared: &List<List<EnvEntry>>) -> Parsed<FullFunction> ~ {
    bad = Parsed<FullFunction> { value: noFunction(), pos: 0, ok: false };
    if start < 0 { return bad; };
    header = normalizeTypes(recordAt(lines, start)); spec = recordAt(lines, start + 1); env = recordAt(lines, start + 2);
    if !headerOk(&header) || !specOk(&spec) || !wordIs(&env, 0, "env") || envEnd(&env, 1) != size(env) { return bad; };
    e = expandEnv(&env, shared); if !e.ok { return bad; };
    fun = FullFunction { header: header, spec: spec, env: e.value, locals: [], loops: [], blocks: [] };
    at = start + 3;
    more = true;
    while more [{ affirm at >= 0; }] ~ {
        row = recordAt(lines, at);
        if !wordIs(&row, 0, "local") { more = false; } else {
            row = normalizeTypes(row); if !localOk(&row) { return bad; };
            fun = FullFunction { locals: push(fun.locals, FullRecord { name: textAt(&row, 1), tokens: row }), ..fun }; at = at + 1;
        };
    };
    more = true;
    while more [{ affirm at >= 0; }] ~ {
        row = recordAt(lines, at);
        if !wordIs(&row, 0, "loop") { more = false; } else {
            if !loopOk(&row) { return bad; };
            e = expandEnv(&row, shared); if !e.ok { return bad; };
            fun = FullFunction { loops: push(fun.loops, FullRecord { name: textAt(&row, 1), tokens: e.value }), ..fun }; at = at + 1;
        };
    };
    more = true;
    while more [{ affirm at >= 0; }] ~ {
        row = recordAt(lines, at);
        if !wordIs(&row, 0, "block") { more = false; } else {
            id = integerAt(&row, 1);
            if size(row) != 2 || !id.ok { return bad; };
            block = FullBlock { id: id.value, lines: [] }; at = at + 1;
            active = true;
            while active [{ affirm at >= 0; }] ~ {
                if at >= size(lines) { return bad; };
                row = recordAt(lines, at); if !lineOk(&row) { return bad; };
                e = expandEnv(&row, shared); if !e.ok { return bad; };
                if terminator(&row) { active = false; };
                block = FullBlock { lines: push(block.lines, e.value), ..block }; at = at + 1;
            };
            fun = FullFunction { blocks: push(fun.blocks, block), ..fun };
        };
    };
    end = recordAt(lines, at);
    if !wordIs(&end, 0, "end") || size(end) != 1 || !uniqueNumericRecords(&fun.locals) || !uniqueNumericRecords(&fun.loops) { return bad; };
    ids = HashSet::new(); keys = [];
    for b in &fun.blocks {
        if HashSet::contains(&ids, b.id) { return bad; }; ids = ids.insert(b.id);
        keys = push(keys, String::fromInt(b.id));
    };
    blocks = [];
    for i in keyOrder(&keys, true) {
        if i >= 0 && i < size(fun.blocks) { blocks = push(blocks, clone(get(&fun.blocks, i))); };
    };
    fun = FullFunction { blocks: blocks, ..fun };
    return Parsed<FullFunction> { value: fun, pos: at + 1, ok: true };
};
fn uniqueNumericRecords(rows: &List<FullRecord>) -> Bool ~ {
    ids = HashSet::new();
    for row in rows { id = integerAt(&row.tokens, 1); if !id.ok || HashSet::contains(&ids, id.value) { return false; }; ids = ids.insert(id.value); };
    return true;
};
fn uniqueRecords(rows: &List<FullRecord>) -> Bool ~ {
    names = HashSet::new();
    for r in rows { if HashSet::contains(&names, &r.name) { return false; }; names = names.insert(clone(r.name)); };
    return true;
};
fn trailerOk(rows: &List<List<Token>>) -> Bool ~ {
    labels = push(push(push(push(push(push([], "copies"), "linear"), "drops"), "stubs"), "declared"), "nested");
    if size(rows) != 7 { return false; };
    for i in 0..6 {
        ts = recordAt(rows, i);
        if size(ts) < 2 || !wordIs(&ts, 0, get(&labels, i)) || namesEnd(&ts, 1) != size(ts) { return false; };
        seen = HashSet::new();
        for j in 2..size(ts) { n = textAt(&ts, j); if HashSet::contains(&seen, &n) { return false; }; seen = seen.insert(n); };
    };
    ts = recordAt(rows, 6);
    return wordIs(&ts, 0, "assumes") && intsEnd(&ts, 1) = size(ts);
};
fn fullRows(program: &FullProgram) -> List<List<Token>> ~ {
    out = [];
    for r in &program.invariants { out = push(out, clone(r.tokens)); };
    for fun in &program.functions { out = functionRows(out, fun); };
    out = functionRows(out, &program.entry);
    for row in &program.trailer { out = push(out, clone(row)); };
    return out;
};
fn functionRows(out: List<List<Token>>, fun: &FullFunction) -> List<List<Token>> ~ {
    out = push(out, clone(fun.spec));
    for r in &fun.loops { out = push(out, clone(r.tokens)); };
    for b in &fun.blocks { for row in &b.lines { out = push(out, clone(row)); }; };
    return out;
};
fn payloadsOk(program: &FullProgram, roots: &List<Int>) -> Bool ~ {
    seen = HashSet::new();
    for row in fullRows(program) {
        for slot in payloadSlots(&row) {
            r = integerAt(&row, slot);
            if !r.ok || r.value < 0 || r.value >= size(roots) || HashSet::contains(&seen, r.value) { return false; };
            if !payloadMatches(&row, slot, &program.arena, get(roots, r.value)) { return false; };
            seen = seen.insert(r.value);
        };
    };
    return seen.size() = size(roots);
};
// Legacy PackLoop records omit the invariant; current AST output writes one empty list per loop.
fn packLoopInvariants(nodes: List<AstNode>) -> List<AstNode> ~ {
    missing = false;
    for node in &nodes {
        if node is AstNode::Statement {
            statement = (node as AstNode::Statement).value;
            if statement is AstStatement::PackLoop {
                if (statement as AstStatement::PackLoop).inv = 0 - 1 { missing = true; };
            };
        };
    };
    if !missing { return nodes; };
    limit = size(nodes);
    for at in 0..limit {
        if at < 0 || at >= size(nodes) { return nodes; };
        node = clone(get(&nodes, at));
        if node is AstNode::Statement {
            statement = (node as AstNode::Statement).value;
            if statement is AstStatement::PackLoop {
                loop = statement as AstStatement::PackLoop;
                if loop.inv = 0 - 1 {
                    empty = size(nodes);
                    nodes = push(nodes, AstNode::Validations { value: AstValidations::End });
                    nodes = set(nodes, at, AstNode::Statement { value: AstStatement::PackLoop { i: loop.i, a: loop.a, p: loop.p, lo: loop.lo, hi: loop.hi, take: loop.take, inv: empty, xs: loop.xs } });
                };
            };
        };
    };
    return nodes;
};

fn parseFull(lines: &List<List<Token>>) -> Parsed<FullProgram> ~ {
    bad = badFull();
    if size(lines) = 0 { return bad; };
    header = clone(get(lines, 0));
    if size(header) != 2 || !wordIs(&header, 0, "tersus-mir") || !wordIs(&header, 1, "3") { return bad; };
    program = noFull();
    at = 1;
    shared = [];
    phase = 0;
    owners = 0 - 1;
    declaring = true;
    while declaring [{ affirm at >= 1; }] ~ {
        if at >= size(lines) { return bad; };
        row = recordAt(lines, at);
        if wordIs(&row, 0, "function") || wordIs(&row, 0, "main") { declaring = false; } else {
            kind = recordPhase(&row);
            if kind < phase || kind < 0 { return bad; };
            phase = kind;
            if kind = 4 {
                row = normalizeTypes(row);
                if !boundedFactsOk(&row) { return bad; };
                program = FullProgram { boundedFacts: push(program.boundedFacts, FullRecord { name: textAt(&row, 1), tokens: row }), ..program };
            } else if kind = 6 {
                if !protocolOk(&row) { return bad; };
                program = FullProgram { protocols: push(program.protocols, FullRecord { name: textAt(&row, 1), tokens: row }), ..program };
            } else if kind = 7 {
                // (the count comes first, once, and then exactly that many rows)
                if wordIs(&row, 0, "ownership") {
                    count = integerAt(&row, 1);
                    if program.checked || size(row) != 2 || !count.ok || count.value < 0 || textAt(&row, 1) != String::fromInt(count.value) { return bad; };
                    program = FullProgram { checked: true, ..program };
                    owners = count.value;
                } else {
                    if !program.checked || !ownedOk(&row) || size(program.ownership) >= owners { return bad; };
                    program = FullProgram { ownership: push(program.ownership, FullRecord { name: textAt(&row, 1), tokens: row }), ..program };
                };
            } else if kind = 8 {
                if size(row) < 1 { return bad; };
                env = push([], word("none"));
                for i in 1..size(row) { env = push(env, clone(get(&row, i))); };
                if envEnd(&env, 0) != size(env) { return bad; };
                entries = envEntries(&env, 0); if !uniqueEntries(&entries) { return bad; };
                shared = push(shared, orderEntries(entries));
            } else {
                row = normalizeTypes(row);
                if declarationEnd(&row) != size(row) { return bad; };
                r = FullRecord { name: textAt(&row, 1), tokens: row };
                program = addRecord(program, kind, r);
            };
            at = at + 1;
        };
    };
    readingFunctions = true;
    while readingFunctions ~ {
        row = recordAt(lines, at);
        if !wordIs(&row, 0, "function") { readingFunctions = false; } else {
            fun = functionAt(lines, at, &shared); if !fun.ok { return bad; };
            program = FullProgram { functions: push(program.functions, fun.value), ..program }; at = fun.pos;
        };
    };
    if program.checked && size(program.ownership) != owners { return bad; };
    // (each boundedfacts row is of a function with bounds the data has, once for each type it names)
    boundedNames = HashSet::new(); for r in &program.bounded { boundedNames = boundedNames.insert(clone(r.name)); };
    factKeys = [];
    for r in &program.boundedFacts {
        key = boundedFactsKey(&r.tokens);
        if !HashSet::contains(&boundedNames, &r.name) { return bad; };
        for k in &factKeys { if k = key { return bad; }; };
        factKeys = push(factKeys, key);
    };
    if !wordIs(recordAt(lines, at), 0, "main") { return bad; };
    fun = functionAt(lines, at, &shared); if !fun.ok { return bad; };
    program = FullProgram { entry: fun.value, ..program }; at = fun.pos;
    for i in 0..7 { program = FullProgram { trailer: push(program.trailer, recordAt(lines, at)), ..program }; at = at + 1; };
    if !trailerOk(&program.trailer) { return bad; };
    if at < 0 || at >= size(lines) { return bad; };
    data = clone(get(lines, at)); count = integerAt(&data, 1);
    if !wordIs(&data, 0, "data") || size(data) != 2 || !count.ok || textAt(&data, 1) != String::fromInt(count.value) || count.value < 2 || count.value != size(lines) - at - 1 { return bad; };
    astLines = [];
    for i in at + 1..size(lines) { astLines = push(astLines, tokenLine(get(lines, i))); };
    ast = parseAstLines(&astLines);
    if !ast.ok || ast.value.stage != "mir" { return bad; };
    root = ast.value.root;
    program = FullProgram { arena: packLoopInvariants(ast.value.nodes), ..program };
    roots = listItems(&program.arena, root);
    if !payloadsOk(&program, &roots) || !uniqueRecords(&program.types) || !uniqueRecords(&program.generics) || !uniqueRecords(&program.invariants) || !uniqueRecords(&program.bounded) || !uniqueRecords(&program.instances) || !uniqueRecords(&program.protocols) || !uniqueRecords(&program.ownership) || !uniqueFunctions(&program.functions) { return bad; };
    tables = []; for entries in &shared { tables = push(tables, envTokens(entries)); };
    program = FullProgram { shared: tables, ..program };
    return Parsed<FullProgram> { value: mapProgramPayloads(program, &roots), pos: size(lines), ok: true };
};
fn recordPhase(ts: &List<Token>) -> Int ~ {
    if wordIs(ts, 0, "struct") || wordIs(ts, 0, "enum") { return 0; };
    if wordIs(ts, 0, "generic") { return 1; };
    if wordIs(ts, 0, "invariant") { return 2; };
    if wordIs(ts, 0, "bounded") { return 3; };
    if wordIs(ts, 0, "boundedfacts") { return 4; };
    if wordIs(ts, 0, "instance") { return 5; };
    if wordIs(ts, 0, "protocol") { return 6; };
    if wordIs(ts, 0, "ownership") || wordIs(ts, 0, "owned") { return 7; };
    if wordIs(ts, 0, "shared") { return 8; };
    return 0 - 1;
};
fn addRecord(p: FullProgram, kind: Int, r: FullRecord) -> FullProgram ~ {
    if kind = 0 { return FullProgram { types: push(p.types, r), ..p }; };
    if kind = 1 { return FullProgram { generics: push(p.generics, r), ..p }; };
    if kind = 2 { return FullProgram { invariants: push(p.invariants, r), ..p }; };
    if kind = 3 { return FullProgram { bounded: push(p.bounded, r), ..p }; };
    if kind = 4 { return FullProgram { boundedFacts: push(p.boundedFacts, r), ..p }; };
    return FullProgram { instances: push(p.instances, r), ..p };
};
fn uniqueFunctions(fns: &List<FullFunction>) -> Bool ~ {
    seen = HashSet::new();
    for fun in fns { n = textAt(&fun.header, 1); if HashSet::contains(&seen, &n) { return false; }; seen = seen.insert(n); };
    return true;
};
