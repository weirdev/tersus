import data::codec::codec { Token, Parsed };
import data::ast::ast { AstNode };
import mir::full::read { parseFull };
import mir::full::tokens { textAt };
import mir::full::write { outputFull, emitFull, clearMetadata };

fn fullAt(lines: &List<List<Token>>) -> Parsed<FullProgram> ~ { return parseFull(lines, true); };
fn fullAtForLink(lines: &List<List<Token>>, transportsClosurePack: Bool) -> Parsed<FullProgram> ~ { return parseFull(lines, transportsClosurePack); };
fn printFull(program: &FullProgram) -> Int ~ { return emitFull(outputFull(program)); };
fn clearFunctionMetadata(program: FullProgram) -> FullProgram ~ { return clearMetadata(program); };

struct FullRecord { name: String, tokens: List<Token> };
impl Clone for FullRecord { };

struct FullBlock { id: Int, lines: List<List<Token>> };
impl Clone for FullBlock { };

struct FullFunction {
    header: List<Token>, spec: List<Token>, env: List<Token>,
    locals: List<FullRecord>, loops: List<FullRecord>, blocks: List<FullBlock>
};
impl Clone for FullFunction { };

// Payload tokens hold AST node IDs internally; only the wire uses payload ordinals.
// Shared environments remain referenced until their canonical wire variants are written.
// boundedFacts: a function with bounds' checked facts of a type its body names (`boundedfacts FUNCTION TYPE` and the seven
// names of an owned row), named by the function; protocols: each role's checked provider (`protocol ROLE PROVIDER`); ownership: each owner's checked facts, as the owned
// rows of MIR version 2 are (`owned OWNER COPY DROP-PROVIDER DROP-FUNCTION CLONE-PROVIDER CLONE-FUNCTION DEREF-PROVIDER
// DEREF-FUNCTION`), after `ownership COUNT`; checked: the data has that table, if empty, rather than none
struct FullProgram {
    types: List<FullRecord>, generics: List<FullRecord>, invariants: List<FullRecord>,
    bounded: List<FullRecord>, boundedFacts: List<FullRecord>, instances: List<FullRecord>,
    protocols: List<FullRecord>, ownership: List<FullRecord>, checked: Bool,
    functions: List<FullFunction>, entry: FullFunction,
    trailer: List<List<Token>>, arena: List<AstNode>, shared: List<List<Token>>
};
impl Clone for FullProgram { };

fn rowIndex(rows: &List<FullRecord>, n: &String) -> Int ~ { i = 0; for r in rows { if r.name = n { return i; }; i = i + 1; }; return 0 - 1; };
fn fnIndex(fns: &List<FullFunction>, n: &String) -> Int ~ { i = 0; for f in fns { if textAt(&f.header, 1) = n { return i; }; i = i + 1; }; return 0 - 1; };
