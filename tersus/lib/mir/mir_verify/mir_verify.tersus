import mir::support::support { Layout, beforeAngle, escaped, renderType, declName, lookupDecl, sizedArray, declaredName, roundUp, wordLayout, simpleLayout };
import data::codec::codec { Size, Type, quoted, parseInt, wordOf };

// The MIR as data, checked for well-formedness by a program in Tersus: what MirVerify checks of a
// program in the form `tersus mir --data` prints, or a pre-erasure program written by MirData: its
// shape, and the types of its operations. It reads the MIR as lib/mir/mir_reader/mir_reader.tersus does (both import the shared reader of the mir package), from
// the standard input, prints OK and gives 0 when the program is well formed, and prints the first
// problem it finds (in the words of MirVerify, with the place of the function and the block) and
// gives 1 when it is not. What is not the MIR as data is refused as the reader refuses it.
//
//     tersus mir --data examples/hello.tersus | tersus run lib/mir/mir_verify/mir_verify.tersus
//
// The validator's part of a program is not in the data (MirData.forNative), so there is nothing here
// of contracts, loop specifications or ghost statements: this is the check that lowering and each pass
// over the owned MIR go through again before native code is made of a program (MirVerify.verifyProgram
// in Haskell, which has to agree with this on every program the format can carry).

import mir::reader::reader { Field, Variant, TypeDecl, Constant, Operand, RefStep, Rvalue, Statement, Terminator, MirBlock, LocalDecl, Function, Program, listWords, programAt, readLines };


// ---- the emitter ----

// Strings


impl String {
    fn then(self: Self, other: &String) -> Self [{ }] [{ }] {
        return self.concat(other);
    };
};

fn noTypes() -> List<Type> [{ }] [{ }] {
    return [];
};

fn noConstants() -> List<Constant> [{ }] [{ }] {
    return [];
};


// The name of a global: quoted, so that any name will do
fn global(prefix: &String, name: &String) -> String [{ }] [{ }] {
    return "@\"".then(prefix).then(escaped(name)).then("\"");
};

// Types


fn layoutOf(types: &List<TypeDecl>, t: &Type) -> Layout ~ {
    simple = simpleLayout(t);
    if simple.ok { return simple.layout; };
    if t is Type::TList { return Layout { size: 24, align: 8 }; };
    if t is Type::TBox && Box::unbox((t as Type::TBox).inner) is Type::TArray { return Layout { size: 24, align: 8 }; };
    arr = sizedArray(t);
    if arr.ok {
        e = layoutOf(types, arr.elem);
        return Layout { size: arr.length * e.size, align: e.align };
    };
    n = declaredName(types, t);
    if !n.ok { return wordLayout(); };
    i = lookupDecl(types, n.text);
    if i < 0 { return wordLayout(); };
    r = wordLayout();
    match get(types, i) {
        TypeDecl::DStruct { name: name, fields: fields } => {
            align = 1;
            end = 0;
            for f in fields {
                l = layoutOf(types, f.ty);
                if l.align > align { align = l.align; };
                end = roundUp(end, l.align) + l.size;
            };
            r = Layout { size: roundUp(end, align), align: align };
        },
        TypeDecl::DEnum { name: name, variants: variants } => {
            payload = 1;
            widest = 0;
            for v in variants {
                align = 1;
                end = 0;
                for f in v.fields {
                    l = layoutOf(types, f.ty);
                    if l.align > align { align = l.align; };
                    end = roundUp(end, l.align) + l.size;
                };
                if align > payload { payload = align; };
                if roundUp(end, align) > widest { widest = roundUp(end, align); };
            };
            start = roundUp(4, payload);
            align = payload;
            if align < 4 { align = 4; };
            r = Layout { size: roundUp(start + widest, align), align: align };
        },
    };
    return r;
};

// The layout of a struct of these fields
fn fieldsLayout(types: &List<TypeDecl>, fields: &List<Field>) -> Layout ~ {
    align = 1;
    end = 0;
    for f in fields {
        l = layoutOf(types, f.ty);
        if l.align > align { align = l.align; };
        end = roundUp(end, l.align) + l.size;
    };
    return Layout { size: roundUp(end, align), align: align };
};

// The layout of a declared struct or enum
fn declLayout(types: &List<TypeDecl>, d: &TypeDecl) -> Layout ~ {
    return layoutOf(types, Type::TNamed { name: declName(d), base: declName(d), argc: 0, argTokens: [] });
};

// The 8-byte words of room a value held inline takes in a frame (Mir.slotsOf)
fn slotsOf(types: &List<TypeDecl>, t: &Type) -> Int ~ {
    return (layoutOf(types, t).size + 7) / 8;
};

// ---- verification ----

struct TyRes { ok: Bool, ty: Type };

impl Clone for TyRes { };

fn noTy() -> TyRes [{ }] [{ }] {
    return TyRes { ok: false, ty: Type::TInt };
};

// Per-function positions are built once and shared by local typing and callee signatures.
// Preserve the first declaration of duplicate IDs; never put recursive Type values in the index.
struct FunctionIndex { names: List<String>, locals: List<HashMap<Int, Int>>, entry: HashMap<Int, Int> };

fn emptyLocalIndex() -> HashMap<Int, Int> [{ }] [{ }] {
    return HashMap::new();
};

fn indexLocals(f: &Function) -> HashMap<Int, Int> [{ }] [{ }] {
    locals = emptyLocalIndex();
    i = 0;
    while i < size(f.locals) [{ affirm i >= 0; affirm i <= size(f.locals); }] shrinks size(f.locals) - i {
        d = &get(f.locals, i);
        if !locals.contains((*d).id) { locals = locals.insert((*d).id, i); };
        i = i + 1;
    };
    return locals;
};

fn findLocal(f: &Function, locals: &HashMap<Int, Int>, id: Int) -> Int [{ }] [{ affirm return >= -1; affirm return < size(f.locals); }] {
    i = locals.lookup(id, -1);
    if i >= 0 && i < size(f.locals) { return i; };
    return -1;
};

fn declared(locals: &HashMap<Int, Int>, id: Int) -> Bool [{ }] [{ }] {
    return locals.contains(id);
};

fn localTy(f: &Function, locals: &HashMap<Int, Int>, id: Int) -> TyRes [{ }] [{ }] {
    i = findLocal(f, locals, id);
    if i >= 0 && i < size(f.locals) { return TyRes { ok: true, ty: clone(get(f.locals, i).ty) }; };
    return noTy();
};

// The functions are searched by a list of their names made once (verifyProgram), the entry last: reading the name of
// the function at a place with `get` copies the whole function there, so a search of the functions themselves copies
// most of the program for every name it looks up, and a program the size of the emitter took minutes for that alone.
fn findFunction(funcs: &FunctionIndex, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(funcs.names); }] {
    i = 0;
    while i < size(funcs.names) [{ affirm i >= 0; affirm i <= size(funcs.names); }] shrinks size(funcs.names) - i {
        if get(funcs.names, i) = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

fn functionKnown(funcs: &FunctionIndex, name: &String) -> Bool [{ }] [{ }] {
    return findFunction(funcs, name) >= 0;
};

// The declaration that a constructor builds: a struct is its own, a variant its enum's
struct CtorInfo { ok: Bool, typeName: String, fields: List<Field> };

impl Clone for CtorInfo { };

fn noCtor() -> CtorInfo [{ }] [{ }] {
    return CtorInfo { ok: false, typeName: "", fields: [] };
};

fn ctorInfo(p: &Program, name: &String) -> CtorInfo [{ }] [{ }] {
    types = &p.types;
    i = 0;
    while i < size(types) [{ affirm i >= 0; affirm i <= size(types); }] shrinks size(types) - i {
        d = &get(types, i);
        info = ctorInDecl(d, name);
        if info.ok { return info; };
        i = i + 1;
    };
    return noCtor();
};

fn ctorInDecl(d: &TypeDecl, name: &String) -> CtorInfo [{ }] [{ }] {
    if d is TypeDecl::DStruct {
        if (d as TypeDecl::DStruct).name = name {
            return CtorInfo { ok: true, typeName: clone((d as TypeDecl::DStruct).name), fields: clone((d as TypeDecl::DStruct).fields) };
        };
    } else {
        variants = (d as TypeDecl::DEnum).variants;
        j = 0;
        while j < size(variants) [{ affirm j >= 0; affirm j <= size(variants); }] shrinks size(variants) - j {
            v = &get(variants, j);
            info = ctorInVariant(v, (d as TypeDecl::DEnum).name, name);
            if info.ok { return info; };
            j = j + 1;
        };
    };
    return noCtor();
};

fn ctorInVariant(v: &Variant, owner: &String, name: &String) -> CtorInfo [{ }] [{ }] {
    if v.name = name { return CtorInfo { ok: true, typeName: clone(owner), fields: clone(v.fields) }; };
    return noCtor();
};

fn fieldType(fields: &List<Field>, name: &String) -> TyRes [{ }] [{ }] {
    for f in fields {
        if f.name = name { return TyRes { ok: true, ty: clone(f.ty) }; };
    };
    return noTy();
};

fn findBlock(f: &Function, id: Int) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(f.blocks); }] {
    blocks = &f.blocks;
    i = 0;
    while i < size(blocks) [{ affirm i >= 0; affirm i <= size(blocks); }] shrinks size(blocks) - i {
        b = &get(blocks, i);
        if blockHasId(b, id) { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

fn blockHasId(b: &MirBlock, id: Int) -> Bool [{ }] [{ }] {
    return b.id = id;
};

fn typeEq(a: &Type, b: &Type) -> Bool ~ {
    return renderType(a) = renderType(b);
};

fn isUnknown(t: &Type) -> Bool ~ {
    r = false;
    match t {
        Type::TVar { n: n } => { r = true; },
        Type::TList { elem: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TArray { elem: e, size: s } => { r = isUnknown(Box::unbox(e)); },
        Type::TBox { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TAddr { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TRef { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TMutRef { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TBlock { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TUninit { inner: e } => { r = isUnknown(Box::unbox(e)); },
        Type::TFn { args: args, ret: ret } => {
            r = isUnknown(Box::unbox(ret));
            for a in args { if isUnknown(a) { r = true; }; };
        },
        Type::TForall { sizes: sizes, types: types, body: body } => { r = isUnknown(Box::unbox(body)); },
        Type::TInt => { },
        Type::TByte => { },
        Type::TBool => { },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => { },
        Type::TVariant { name: name } => { },
        Type::TParam { name: name } => { },
        Type::TWord { signed: signed, bits: bits } => { },
    };
    return r;
};

// The pieces of the arguments of an instance name, split where no < or ( is open (Mir.instanceOf)
fn safeSlice(s: &String, from: Int, to: Int) -> String [{ }] [{ }] {
    f = from;
    if f < 0 { f = 0; };
    if f > size(s.bytes) { f = size(s.bytes); };
    e = to;
    if e < f { e = f; };
    if e > size(s.bytes) { e = size(s.bytes); };
    return s.slice(f, e);
};

fn instanceArgs(name: &String) -> List<String> [{ }] [{ }] {
    args = [];
    depth = 0;
    start = 0;
    open = 0 - 1;
    i = 0;
    bytes = name.bytes;
    n = size(bytes);
    while i < n [{ affirm i >= 0; affirm i <= n; }] shrinks n - i {
        c = toInt(get(bytes, i));
        if c = 60 && open < 0 { open = i; start = i + 1; };
        if c = 60 || c = 40 { depth = depth + 1; };
        if c = 62 && i > 0 && toInt(get(bytes, i - 1)) != 45 { depth = depth - 1; };
        if c = 41 { depth = depth - 1; };
        if c = 44 && depth = 1 && open >= 0 {
            args = push(args, safeSlice(name, start, i));
            start = i + 1;
            if start < n {
                if toInt(get(bytes, start)) = 32 { start = start + 1; };
            };
        };
        i = i + 1;
    };
    if open >= 0 && n > 0 { args = push(args, safeSlice(name, start, n - 1)); };
    return args;
};

fn isSizeText(s: &String) -> Bool [{ }] [{ }] {
    if s = "?" { return true; };
    if size(s.bytes) = 0 { return false; };
    digits = true;
    lower = true;
    for b in s.bytes {
        c = toInt(b);
        if c < 48 || c > 57 { digits = false; };
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c = 95) { lower = false; };
    };
    if digits { return true; };
    if size(s.bytes) > 1 && toInt(get(s.bytes, 0)) = 95 { return true; };
    return lower;
};

fn isParamText(s: &String) -> Bool [{ }] [{ }] {
    if size(s.bytes) > 0 {
        c = toInt(get(s.bytes, 0));
        if c < 97 || c > 122 { return false; };
    };
    if size(s.bytes) = 0 { return false; };
    return isSizeText(s);
};

// A type as the name of an instance writes it, read back (only what can stand in an instance's arguments)
struct TextParse { ok: Bool, ty: Type, pos: Int };

impl Clone for TextParse { };

fn textSize(text: &String) -> Size [{ }] [{ }] {
    if text = "?" { return Size::SAny; };
    if size(text.bytes) > 1 {
        if toInt(get(text.bytes, 0)) = 95 {
            rest = safeSlice(text, 1, size(text.bytes));
            n = parseInt(rest);
            if n.ok { return Size::SVar { n: n.value }; };
        };
    };
    n = parseInt(text);
    if n.ok { return Size::SConst { n: n.value }; };
    if size(text.bytes) = 0 { return Size::SAny; };
    return Size::SParam { name: clone(text) };
};

fn typeWordPrefix(text: &String, word: &String) -> Bool [{ }] [{ }] {
    if !text.startsWith(word) { return false; };
    n = size(word.bytes);
    if n = size(text.bytes) { return true; };
    if n >= size(text.bytes) { return false; };
    c = toInt(get(text.bytes, n));
    return c = 44 || c = 41 || c = 62 || c = 32;
};

// The element of a list type, in either of its spellings: the list shape, and the named struct List of the
// prelude that a list is in the data now
fn listElemOf(t: &Type) -> TyRes ~ {
    if t is Type::TList { return TyRes { ok: true, ty: clone(Box::unbox((t as Type::TList).elem)) }; };
    if t is Type::TNamed && beforeAngle((t as Type::TNamed).name) = "List" {
        args = instanceArgs((t as Type::TNamed).name);
        if size(args) = 1 { return textType(get(args, 0)); };
    };
    return noTy();
};

// The type a Box holds, in either of its spellings
fn boxInnerOf(t: &Type) -> TyRes ~ {
    if t is Type::TBox { return TyRes { ok: true, ty: clone(Box::unbox((t as Type::TBox).inner)) }; };
    if t is Type::TNamed && beforeAngle((t as Type::TNamed).name) = "Box" {
        args = instanceArgs((t as Type::TNamed).name);
        if size(args) = 1 { return textType(get(args, 0)); };
    };
    return noTy();
};

fn isListTy(t: &Type) -> Bool [{ }] [{ }] {
    if t is Type::TList { return true; };
    return t is Type::TNamed && beforeAngle((t as Type::TNamed).name) = "List";
};

// A name as an instance writes it: a lower-case name is quoted with a backtick there (`List<`point>`), which
// is spelling, not part of the name
fn unquoteName(s: &String) -> String [{ }] [{ }] {
    if size(s.bytes) > 0 && toInt(get(s.bytes, 0)) = 96 { return safeSlice(s, 1, size(s.bytes)); };
    return clone(s);
};

fn textTypeAt(s: &String, pos: Int) -> TextParse ~ {
    bad = TextParse { ok: false, ty: Type::TInt, pos: pos };
    if pos < 0 { return bad; };
    if pos >= size(s.bytes) { return bad; };
    rest = safeSlice(s, pos, size(s.bytes));
    if rest.startsWith("fn(") {
        args = [];
        next = pos + 3;
        if next >= size(s.bytes) { return bad; };
        while next < size(s.bytes) && toInt(get(s.bytes, next)) != 41 [{ affirm next >= 0; affirm next <= size(s.bytes); }] ~ {
            a = textTypeAt(s, next);
            if !a.ok || a.pos <= next || a.pos >= size(s.bytes) { return bad; };
            args = push(args, a.ty);
            next = a.pos;
            if toInt(get(s.bytes, next)) = 44 {
                next = next + 1;
                if next < size(s.bytes) && toInt(get(s.bytes, next)) = 32 { next = next + 1; };
                if next >= size(s.bytes) || toInt(get(s.bytes, next)) = 41 { return bad; };
            } else if toInt(get(s.bytes, next)) != 41 { return bad; };
        };
        if next >= size(s.bytes) || !safeSlice(s, next, size(s.bytes)).startsWith(") -> ") { return bad; };
        ret = textTypeAt(s, next + 5);
        if !ret.ok { return bad; };
        return TextParse { ok: true, ty: Type::TFn { args: args, ret: Box::new(ret.ty) }, pos: ret.pos };
    };
    if typeWordPrefix(rest, "Int") { return TextParse { ok: true, ty: Type::TInt, pos: pos + 3 }; };
    if typeWordPrefix(rest, "Byte") { return TextParse { ok: true, ty: Type::TByte, pos: pos + 4 }; };
    if typeWordPrefix(rest, "Bool") { return TextParse { ok: true, ty: Type::TBool, pos: pos + 4 }; };
    if rest.startsWith("List<") {
        inner = textTypeAt(s, pos + 5);
        if !inner.ok || inner.pos < 0 || inner.pos >= size(s.bytes) || toInt(get(s.bytes, inner.pos)) != 62 { return bad; };
        return TextParse { ok: true, ty: Type::TList { elem: Box::new(inner.ty) }, pos: inner.pos + 1 };
    };
    if rest.startsWith("Box<") {
        inner = textTypeAt(s, pos + 4);
        if !inner.ok || inner.pos < 0 || inner.pos >= size(s.bytes) || toInt(get(s.bytes, inner.pos)) != 62 { return bad; };
        return TextParse { ok: true, ty: Type::TBox { inner: Box::new(inner.ty) }, pos: inner.pos + 1 };
    };
    if rest.startsWith("Addr<") {
        inner = textTypeAt(s, pos + 5);
        if !inner.ok || inner.pos < 0 || inner.pos >= size(s.bytes) || toInt(get(s.bytes, inner.pos)) != 62 { return bad; };
        return TextParse { ok: true, ty: Type::TAddr { inner: Box::new(inner.ty) }, pos: inner.pos + 1 };
    };
    if rest.startsWith("Uninit<") {
        inner = textTypeAt(s, pos + 7);
        if !inner.ok || inner.pos < 0 || inner.pos >= size(s.bytes) || toInt(get(s.bytes, inner.pos)) != 62 { return bad; };
        return TextParse { ok: true, ty: Type::TUninit { inner: Box::new(inner.ty) }, pos: inner.pos + 1 };
    };
    if rest.startsWith("&mut ") {
        inner = textTypeAt(s, pos + 5);
        if !inner.ok { return bad; };
        return TextParse { ok: true, ty: Type::TMutRef { inner: Box::new(inner.ty) }, pos: inner.pos };
    };
    if rest.startsWith("&") {
        inner = textTypeAt(s, pos + 1);
        if !inner.ok { return bad; };
        return TextParse { ok: true, ty: Type::TRef { inner: Box::new(inner.ty) }, pos: inner.pos };
    };
    if rest.startsWith("'") {
        end = pos + 1;
        while end < size(s.bytes) && toInt(get(s.bytes, end)) != 44 && toInt(get(s.bytes, end)) != 62 && toInt(get(s.bytes, end)) != 41 [{ affirm end >= 0; affirm end <= size(s.bytes); }] ~ { end = end + 1; };
        return TextParse { ok: true, ty: Type::TParam { name: safeSlice(s, pos + 1, end) }, pos: end };
    };
    if rest.startsWith("Array<") {
        inner = textTypeAt(s, pos + 6);
        if !inner.ok || inner.pos < 0 || inner.pos >= size(s.bytes) || toInt(get(s.bytes, inner.pos)) != 44 { return bad; };
        end = inner.pos;
        if end < 0 { end = 0; };
        if end > size(s.bytes) { end = size(s.bytes); };
        depth = 1;
        while end < size(s.bytes) && depth > 0 [{ affirm end >= 0; affirm end <= size(s.bytes); }] ~ {
            c = toInt(get(s.bytes, end));
            if c = 60 { depth = depth + 1; };
            if c = 62 && !(end > 0 && toInt(get(s.bytes, end - 1)) = 45) { depth = depth - 1; };
            end = end + 1;
        };
        if depth != 0 || end <= 0 || toInt(get(s.bytes, end - 1)) != 62 { return bad; };
        // The size after the comma is part of the type (`Array<Int, 2>` is not `Array<Int, 3>`)
        arrSize = Size::SAny;
        if inner.pos >= 0 && inner.pos < size(s.bytes) {
            if toInt(get(s.bytes, inner.pos)) = 44 {
                start = inner.pos + 1;
                stop = end;
                if stop > start { stop = stop - 1; };
                while start < stop && toInt(get(s.bytes, start)) = 32 [{ affirm start >= 0; affirm start <= size(s.bytes); }] ~ { start = start + 1; };
                while stop > start && toInt(get(s.bytes, stop - 1)) = 32 [{ affirm stop >= 0; affirm stop <= size(s.bytes); }] ~ { stop = stop - 1; };
                arrSize = textSize(safeSlice(s, start, stop));
            };
        };
        return TextParse { ok: true, ty: Type::TArray { elem: Box::new(inner.ty), size: arrSize }, pos: end };
    };
    // a name, possibly an instance or a variant: kept whole, as the data keeps it
    end = pos;
    depth = 0;
    while end < size(s.bytes) [{ affirm end >= 0; affirm end <= size(s.bytes); }] ~ {
        c = toInt(get(s.bytes, end));
        if c = 60 || c = 40 { depth = depth + 1; };
        if c = 41 { if depth = 0 { return TextParse { ok: true, ty: Type::TNamed { name: unquoteName(safeSlice(s, pos, end)), base: unquoteName(safeSlice(s, pos, end)), argc: 0, argTokens: [] }, pos: end }; }; depth = depth - 1; };
        if c = 62 && !(end > pos && toInt(get(s.bytes, end - 1)) = 45) { if depth = 0 { return TextParse { ok: true, ty: Type::TNamed { name: unquoteName(safeSlice(s, pos, end)), base: unquoteName(safeSlice(s, pos, end)), argc: 0, argTokens: [] }, pos: end }; }; depth = depth - 1; };
        if c = 44 && depth = 0 { return TextParse { ok: true, ty: Type::TNamed { name: unquoteName(safeSlice(s, pos, end)), base: unquoteName(safeSlice(s, pos, end)), argc: 0, argTokens: [] }, pos: end }; };
        end = end + 1;
    };
    return TextParse { ok: true, ty: Type::TNamed { name: unquoteName(safeSlice(s, pos, end)), base: unquoteName(safeSlice(s, pos, end)), argc: 0, argTokens: [] }, pos: end };
};

fn textType(s: &String) -> TyRes ~ {
    r = textTypeAt(s, 0);
    if r.ok && r.pos = size(s.bytes) { return TyRes { ok: true, ty: r.ty }; };
    return noTy();
};

// An Int, a Byte, a Bool, a fixed-width integer or an address: the values that are compared as they are
fn isWordType(t: &Type) -> Bool {
    return t is Type::TInt || t is Type::TByte || t is Type::TBool || t is Type::TWord || t is Type::TAddr;
};

fn sub(p: &Program, wanted: &Type, actual: &Type) -> Bool ~ {
    return subType(p, wanted, actual, false);
};

fn subType(p: &Program, wanted: &Type, actual: &Type, strict: Bool) -> Bool ~ {
    if wanted is Type::TParam { return true; };
    if actual is Type::TParam { return true; };
    if strict {
        if (wanted is Type::TRef) != (actual is Type::TRef) || (wanted is Type::TMutRef) != (actual is Type::TMutRef) { return false; };
        if wanted is Type::TRef && actual is Type::TRef { return subType(p, Box::unbox((wanted as Type::TRef).inner), Box::unbox((actual as Type::TRef).inner), true); };
        if wanted is Type::TMutRef && actual is Type::TMutRef { return subType(p, Box::unbox((wanted as Type::TMutRef).inner), Box::unbox((actual as Type::TMutRef).inner), true); };
    };
    if wanted is Type::TRef { return subType(p, Box::unbox((wanted as Type::TRef).inner), actual, strict); };
    if actual is Type::TRef { return subType(p, wanted, Box::unbox((actual as Type::TRef).inner), strict); };
    if wanted is Type::TList && actual is Type::TList {
        return subType(p, Box::unbox((wanted as Type::TList).elem), Box::unbox((actual as Type::TList).elem), strict);
    };
    // (a list and a Box are named types in the checker and their own shapes here, so a name a field read was
    // written against and the shape of the value it is read from are two spellings of one type)
    if wanted is Type::TNamed && actual is Type::TList {
        wa = instanceArgs((wanted as Type::TNamed).name);
        if beforeAngle((wanted as Type::TNamed).name) != "List" || size(wa) != 1 { return false; };
        et = textType(get(wa, 0));
        return et.ok && sub(p, et.ty, Box::unbox((actual as Type::TList).elem));
    };
    if wanted is Type::TList && actual is Type::TNamed {
        aa = instanceArgs((actual as Type::TNamed).name);
        if beforeAngle((actual as Type::TNamed).name) != "List" || size(aa) != 1 { return false; };
        et = textType(get(aa, 0));
        return et.ok && sub(p, Box::unbox((wanted as Type::TList).elem), et.ty);
    };
    if wanted is Type::TBox && actual is Type::TNamed {
        aa = instanceArgs((actual as Type::TNamed).name);
        if beforeAngle((actual as Type::TNamed).name) != "Box" || size(aa) != 1 { return false; };
        et = textType(get(aa, 0));
        return et.ok && sub(p, Box::unbox((wanted as Type::TBox).inner), et.ty);
    };
    if wanted is Type::TNamed && actual is Type::TBox {
        wa = instanceArgs((wanted as Type::TNamed).name);
        if beforeAngle((wanted as Type::TNamed).name) != "Box" || size(wa) != 1 { return false; };
        et = textType(get(wa, 0));
        return et.ok && sub(p, et.ty, Box::unbox((actual as Type::TBox).inner));
    };
    if wanted is Type::TArray && actual is Type::TArray {
        ws = (wanted as Type::TArray).size;
        actualSize = (actual as Type::TArray).size;
        same = false;
        match ws {
            Size::SAny => { same = actualSize is Size::SAny; },
            Size::SConst { n: wn } => { same = actualSize is Size::SConst && (actualSize as Size::SConst).n = wn; },
            Size::SParam { name: pn } => { same = actualSize is Size::SParam && (actualSize as Size::SParam).name = pn; },
            Size::SVar { n: vn } => { same = actualSize is Size::SVar && (actualSize as Size::SVar).n = vn; },
        };
        if !same { return false; };
        return subType(p, Box::unbox((wanted as Type::TArray).elem), Box::unbox((actual as Type::TArray).elem), strict);
    };
    if wanted is Type::TBox && actual is Type::TBox {
        return subType(p, Box::unbox((wanted as Type::TBox).inner), Box::unbox((actual as Type::TBox).inner), strict);
    };
    if wanted is Type::TAddr && actual is Type::TAddr {
        return subType(p, Box::unbox((wanted as Type::TAddr).inner), Box::unbox((actual as Type::TAddr).inner), strict);
    };
    if wanted is Type::TBlock && actual is Type::TBlock {
        return subType(p, Box::unbox((wanted as Type::TBlock).inner), Box::unbox((actual as Type::TBlock).inner), true);
    };
    if wanted is Type::TBlock && actual is Type::TBlock {
        return sub(p, Box::unbox((wanted as Type::TBlock).inner), Box::unbox((actual as Type::TBlock).inner));
    };
    if wanted is Type::TUninit && actual is Type::TUninit {
        return sub(p, Box::unbox((wanted as Type::TUninit).inner), Box::unbox((actual as Type::TUninit).inner));
    };
    if wanted is Type::TNamed && actual is Type::TVariant {
        info = ctorInfo(p, (actual as Type::TVariant).name);
        return info.ok && info.typeName = (wanted as Type::TNamed).name;
    };
    if wanted is Type::TNamed && actual is Type::TNamed {
        wn = (wanted as Type::TNamed).name;
        an = (actual as Type::TNamed).name;
        if wn = an { return true; };
        if beforeAngle(wn) != beforeAngle(an) { return false; };
        wa = instanceArgs(wn);
        aa = instanceArgs(an);
        if size(wa) != size(aa) || size(wa) = 0 { return false; };
        i = 0;
        ok = true;
        while i < size(wa) && i < size(aa) [{ affirm i >= 0; affirm i <= size(wa); affirm i <= size(aa); }] ~ {
            if i < size(aa) {
            x = get(wa, i);
            y = get(aa, i);
            if x != y {
                if isSizeText(x) && isSizeText(y) {
                    if !(isParamText(x) || isParamText(y)) { ok = false; };
                } else {
                    xp = textType(x);
                    yp = textType(y);
                    if !xp.ok || !yp.ok || !subType(p, xp.ty, yp.ty, strict) { ok = false; };
                };
            };
            };
            i = i + 1;
        };
        return ok;
    };
    if wanted is Type::TFn && actual is Type::TFn {
        wa = (wanted as Type::TFn).args;
        aa = (actual as Type::TFn).args;
        if size(wa) != size(aa) { return false; };
        wr = Box::unbox((wanted as Type::TFn).ret);
        ar = Box::unbox((actual as Type::TFn).ret);
        if !subType(p, wr, ar, true) { return false; };
        i = 0;
        ok = true;
        while i < size(wa) && i < size(aa) [{ affirm i >= 0; affirm i <= size(wa); affirm i <= size(aa); }] ~ {
            if i < size(aa) {
                wt = get(wa, i);
                at = get(aa, i);
                if !subType(p, wt, at, true) { ok = false; };
            };
            i = i + 1;
        };
        return ok;
    };
    return typeEq(wanted, actual);
};

fn wordInRange(signed: Bool, bits: Int, n: Int) -> Bool [{ }] [{ }] {
    if bits < 0 { return false; };
    bound = 1;
    i = 0;
    while i < bits [{ affirm i >= 0; affirm i <= bits; }] shrinks bits - i { bound = bound * 2; i = i + 1; };
    if signed { return n >= 0 - bound / 2 && n < bound / 2; };
    return n >= 0 && n < bound;
};

fn functionTypeOf(p: &Program, f: &Function, locals: &HashMap<Int, Int>) -> Type [{ }] [{ }] {
    args = [];
    for pid in f.params {
        lt = localTy(f, locals, pid);
        ty = Type::TVar { n: 0 };
        if lt.ok { ty = lt.ty; };
        borrowed = false;
        for b in f.borrowed { if b = pid { borrowed = true; }; };
        if borrowed {
            mutable = false;
            for b in f.mutBorrowed { if b = pid { mutable = true; }; };
            if mutable { ty = Type::TMutRef { inner: Box::new(ty) }; }
            else { ty = Type::TRef { inner: Box::new(ty) }; };
        };
        args = push(args, ty);
    };
    ret = Type::TVar { n: 0 };
    if f.hasReturn { ret = clone(f.returns); };
    base = Type::TFn { args: args, ret: Box::new(ret) };
    if size(f.sizeParams) = 0 && size(f.typeParams) = 0 { return base; };
    return Type::TForall { sizes: clone(f.sizeParams), types: clone(f.typeParams), body: Box::new(base) };
};

fn functionTypeOfName(p: &Program, funcs: &FunctionIndex, name: &String) -> TyRes [{ }] [{ }] {
    i = findFunction(funcs, name);
    if i < 0 { return noTy(); };
    if i = size(p.functions) { return TyRes { ok: true, ty: functionTypeOf(p, &p.entry, &funcs.entry) }; };
    if i >= 0 && i < size(p.functions) && i < size(funcs.locals) { return TyRes { ok: true, ty: functionTypeOf(p, &get(p.functions, i), &get(funcs.locals, i)) }; };
    return noTy();
};

fn constantFits(p: &Program, funcs: &FunctionIndex, wanted: &Type, c: &Constant) -> Bool ~ {
    if wanted is Type::TRef { return constantFits(p, funcs, Box::unbox((wanted as Type::TRef).inner), c); };
    if wanted is Type::TParam { return true; };
    r = false;
    match c {
        Constant::CInt { n: n } => {
            r = wanted is Type::TInt;
            if wanted is Type::TByte { r = n >= 0 && n < 256; };
            if wanted is Type::TWord { r = wordInRange((wanted as Type::TWord).signed, (wanted as Type::TWord).bits, n); };
        },
        Constant::CBool { b: b } => { r = wanted is Type::TBool; },
        Constant::CList { items: items } => {
            le = listElemOf(wanted);
            if le.ok {
                e = le.ty;
                r = true;
                for v in items { if !constantFits(p, funcs, e, v) { r = false; }; };
            };
        },
        Constant::CArray { items: items } => {
            if wanted is Type::TArray {
                sz = (wanted as Type::TArray).size;
                if sz is Size::SConst && (sz as Size::SConst).n = size(items) {
                    e = Box::unbox((wanted as Type::TArray).elem);
                    r = true;
                    for v in items { if !constantFits(p, funcs, e, v) { r = false; }; };
                };
            };
        },
        Constant::CData { name: name, fields: fields, values: values } => {
            info = ctorInfo(p, name);
            if info.ok && sub(p, wanted, Type::TNamed { name: clone(info.typeName), base: clone(info.typeName), argc: 0, argTokens: [] }) && size(fields) = size(info.fields) && size(values) = size(info.fields) {
                r = true;
                i = 0;
                while i < size(fields) && i < size(values) && i < size(info.fields) [{ affirm i >= 0; affirm i <= size(fields); affirm i <= size(values); affirm i <= size(info.fields); }] ~ {
                    if get(fields, i) != get(info.fields, i).name || !constantFits(p, funcs, get(info.fields, i).ty, get(values, i)) { r = false; };
                    i = i + 1;
                };
            };
        },
        Constant::CFn { name: name } => {
            ft = functionTypeOfName(p, funcs, name);
            r = ft.ok && sub(p, wanted, ft.ty);
        },
    };
    return r;
};

fn operandTy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, o: &Operand) -> TyRes [{ }] [{ }] {
    r = noTy();
    match o {
        Operand::Copy { local: l } => { r = localTy(f, locals, l); },
        Operand::Move { local: l } => { r = localTy(f, locals, l); },
        Operand::Const { value: c } => {
            match c {
                Constant::CInt { n: n } => { r = TyRes { ok: true, ty: Type::TInt }; },
                Constant::CBool { b: b } => { r = TyRes { ok: true, ty: Type::TBool }; },
                Constant::CData { name: name, fields: fields, values: values } => {
                    info = ctorInfo(p, name);
                    if info.ok { r = TyRes { ok: true, ty: Type::TNamed { name: clone(info.typeName), base: clone(info.typeName), argc: 0, argTokens: [] } }; };
                },
                Constant::CFn { name: name } => { r = functionTypeOfName(p, funcs, name); },
                Constant::CList { items: items } => { },
                Constant::CArray { items: items } => { },
            };
        },
    };
    return r;
};

fn fits(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, wanted: &Type, o: &Operand) -> Bool ~ {
    r = false;
    match o {
        Operand::Copy { local: l } => {
            lt = localTy(f, locals, l);
            r = lt.ok && sub(p, wanted, lt.ty);
        },
        Operand::Move { local: l } => {
            lt = localTy(f, locals, l);
            r = lt.ok && sub(p, wanted, lt.ty);
        },
        Operand::Const { value: c } => { r = constantFits(p, funcs, wanted, c); },
    };
    return r;
};

fn renderOperand(p: &Program, f: &Function, locals: &HashMap<Int, Int>, o: &Operand) -> String ~ {
    r = "the constant";
    match o {
        Operand::Copy { local: l } => {
            lt = localTy(f, locals, l);
            r = "_".then(String::fromInt(l));
            if lt.ok { r = r.then(" (").then(renderType(lt.ty)).then(")"); };
        },
        Operand::Move { local: l } => {
            lt = localTy(f, locals, l);
            r = "_".then(String::fromInt(l));
            if lt.ok { r = r.then(" (").then(renderType(lt.ty)).then(")"); };
        },
        Operand::Const { value: c } => { },
    };
    return r;
};

fn one(s: String) -> List<String> [{ }] [{ affirm size(return) = 1; }] {
    return push([], s);
};

fn single<T: Clone>(x: &T) -> List<T> [{ }] [{ affirm size(return) = 1; }] {
    return push([], clone(x));
};

fn pairOf<T: Clone>(x: &T, y: &T) -> List<T> [{ }] [{ affirm size(return) = 2; }] {
    return push(push([], clone(x)), clone(y));
};

fn expectedWhy(p: &Program, f: &Function, locals: &HashMap<Int, Int>, t: &Type, o: &Operand) -> List<String> ~ {
    return one(renderOperand(p, f, locals, o).then(" is not ").then(renderType(t)));
};

fn resultWhy(d: &Type, t: &Type) -> List<String> ~ {
    if typeEq(d, t) { return []; };
    return one("the result is ".then(renderType(t)).then(", not ").then(renderType(d)));
};

fn intWhys(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, os: &List<Operand>) -> List<String> ~ {
    out = [];
    for o in os {
        if !fits(p, funcs, f, locals, Type::TInt, o) { out = push(out, renderOperand(p, f, locals, o).then(" is not Int")); };
    };
    return out;
};

fn operandLocals(o: &Operand) -> List<Int> [{ }] [{ }] {
    r = [];
    match o {
        Operand::Copy { local: l } => { r = single(l); },
        Operand::Move { local: l } => { r = single(l); },
        Operand::Const { value: c } => { },
    };
    return r;
};

fn constantFunctions(c: &Constant) -> List<String> ~ {
    out = [];
    match c {
        Constant::CFn { name: name } => { out = single(name); },
        Constant::CList { items: items } => { for v in items { for n in constantFunctions(v) { out = push(out, clone(n)); }; }; },
        Constant::CArray { items: items } => { for v in items { for n in constantFunctions(v) { out = push(out, clone(n)); }; }; },
        Constant::CData { name: name, fields: fields, values: values } => { for v in values { for n in constantFunctions(v) { out = push(out, clone(n)); }; }; },
        Constant::CInt { n: n } => { },
        Constant::CBool { b: b } => { },
    };
    return out;
};

fn operandFunctions(o: &Operand) -> List<String> ~ {
    r = [];
    match o {
        Operand::Const { value: c } => { r = constantFunctions(c); },
        Operand::Copy { local: l } => { },
        Operand::Move { local: l } => { },
    };
    return r;
};

fn refStepOperands(steps: &List<RefStep>) -> List<Operand> [{ }] [{ }] {
    out = [];
    for s in steps {
        if s is RefStep::Index { out = push(out, clone((s as RefStep::Index).o)); };
    };
    return out;
};

fn rvalueOperands(rv: &Rvalue) -> List<Operand> [{ }] [{ }] {
    out = [];
    match rv {
        Rvalue::Use { o: o } => { out = single(o); },
        Rvalue::BinaryOp { op: op, a: a, b: b } => { out = pairOf(a, b); },
        Rvalue::ListOp { op: op, args: args } => { out = clone(args); },
        Rvalue::MakeList { items: items } => { out = clone(items); },
        Rvalue::MakeBox { o: o } => { out = single(o); },
        Rvalue::Unbox { o: o } => { out = single(o); },
        Rvalue::Unsize { o: o } => { out = single(o); },
        Rvalue::MakeData { name: name, fields: fields, values: values } => { out = clone(values); },
        Rvalue::ReadField { o: o, name: name, field: field } => { out = single(o); },
        Rvalue::IsVariant { o: o, name: name } => { out = single(o); },
        Rvalue::AsVariant { o: o, name: name } => { out = single(o); },
        Rvalue::Copy { o: o } => { out = single(o); },
        Rvalue::TakeField { local: l, name: name, field: field } => { out = single(Operand::Copy { local: l }); },
        Rvalue::Borrow { root: root, steps: steps, mutable: m } => { out = refStepOperands(steps); },
        Rvalue::Deref { o: o } => { out = single(o); },
    };
    return out;
};

fn textAt(args: &List<String>, i: Int) -> TyRes ~ {
    if i >= 0 && i < size(args) { return textType(get(args, i)); };
    return noTy();
};

fn sequenceFits(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, e: &Type, o: &Operand) -> Bool ~ {
    if fits(p, funcs, f, locals, Type::TList { elem: Box::new(clone(e)) }, o) { return true; };
    ot = operandTy(p, funcs, f, locals, o);
    if ot.ok {
        t = ot.ty;
        if t is Type::TRef { t = Box::unbox(clone((t as Type::TRef).inner)); };
        if t is Type::TMutRef { t = Box::unbox(clone((t as Type::TMutRef).inner)); };
        if t is Type::TArray && sub(p, e, Box::unbox((t as Type::TArray).elem)) { return true; };
        bt = boxInnerOf(t);
        if bt.ok {
            inner = bt.ty;
            if inner is Type::TArray && sub(p, e, Box::unbox((inner as Type::TArray).elem)) { return true; };
        };
        if t is Type::TNamed {
            name = (t as Type::TNamed).name;
            if beforeAngle(name) = "List" {
                args = instanceArgs(name);
                if size(args) = 1 {
                    et = textAt(args, 0);
                    if et.ok && sub(p, e, et.ty) { return true; };
                };
            };
        };
    };
    r = false;
    match o {
        Operand::Const { value: c } => {
            if c is Constant::CArray {
                r = true;
                for v in (c as Constant::CArray).items { if !constantFits(p, funcs, e, v) { r = false; }; };
            };
        },
        Operand::Copy { local: l } => { },
        Operand::Move { local: l } => { },
    };
    return r;
};

fn listLike(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, o: &Operand) -> Bool ~ {
    ot = operandTy(p, funcs, f, locals, o);
    if ot.ok {
        t = ot.ty;
        inner = clone(t);
        if t is Type::TRef { inner = Box::unbox(clone((t as Type::TRef).inner)); };
        if t is Type::TMutRef { inner = Box::unbox(clone((t as Type::TMutRef).inner)); };
        bi = boxInnerOf(inner);
        return isListTy(inner) || inner is Type::TArray || (bi.ok && bi.ty is Type::TArray);
    };
    r = false;
    match o {
        Operand::Const { value: c } => { r = c is Constant::CList || c is Constant::CArray; },
        Operand::Copy { local: l } => { },
        Operand::Move { local: l } => { },
    };
    return r;
};

fn narrowType(op: Int) -> Type [{ }] [{ }] {
    if op = 40 { return Type::TWord { signed: true, bits: 8 }; };
    if op = 41 { return Type::TWord { signed: true, bits: 16 }; };
    if op = 42 { return Type::TWord { signed: true, bits: 32 }; };
    if op = 43 { return Type::TWord { signed: false, bits: 16 }; };
    return Type::TWord { signed: false, bits: 32 };
};

fn addressWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, o: &Operand, d: &Type, rest: Int, resultCheck: Int) -> List<String> ~ {
    // resultCheck: 0 none, 1 result is Int, 2 result sub element, 3 result fits address
    ot = operandTy(p, funcs, f, locals, o);
    if !ot.ok || !(ot.ty is Type::TAddr) { return one(renderOperand(p, f, locals, o).then(" is not an address")); };
    elem = Box::unbox((ot.ty as Type::TAddr).inner);
    out = [];
    if resultCheck = 1 { out = resultWhy(d, Type::TInt); };
    if resultCheck = 2 && !sub(p, d, elem) { out = one("the result is ".then(renderType(elem)).then(", not ").then(renderType(d))); };
    if resultCheck = 3 && !fits(p, funcs, f, locals, d, o) { out = one(renderOperand(p, f, locals, o).then(" is not ").then(renderType(d))); };
    return out;
};

fn permissionOrZero(d: &Type, rest: Int) -> List<String> ~ {
    if rest = 1 { return []; };
    if rest = 0 && d is Type::TInt { return []; };
    return one("the result is ".then(renderType(d)).then(", not Int"));
};

fn argAt(args: &List<Operand>, i: Int) -> Operand [{ }] [{ }] {
    if i >= 0 && i < size(args) { return clone(get(args, i)); };
    return Operand::Const { value: Constant::CInt { n: 0 } };
};

fn pointerWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, d: &Type, op: Int, args: &List<Operand>) -> List<String> ~ {
    n = size(args);
    out = [];
    if op = 23 {
        if n != 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 3);
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        return out;
    };
    if op = 24 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 0);
        if !(d is Type::TAddr) { out = push(out, "the result is ".then(renderType(d)).then(", not an address")); };
        return out;
    };
    if op = 25 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 1);
        return out;
    };
    if op = 26 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        if !(d is Type::TAddr) { out = push(out, "the result is ".then(renderType(d)).then(", not an address")); };
        return out;
    };
    if op = 27 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        if !(d is Type::TAddr) { out = push(out, "the result is ".then(renderType(d)).then(", not an address")); };
        return out;
    };
    if op = 28 || op = 30 {
        if n < 2 || n > 3 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 2);
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        return out;
    };
    if op = 29 {
        if n < 3 || n > 4 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        ot = operandTy(p, funcs, f, locals, argAt(args, 0));
        if !ot.ok || !(ot.ty is Type::TAddr) { return one(renderOperand(p, f, locals, argAt(args, 0)).then(" is not an address")); };
        elem = Box::unbox((ot.ty as Type::TAddr).inner);
        if !fits(p, funcs, f, locals, elem, argAt(args, 2)) { out = one(renderOperand(p, f, locals, argAt(args, 2)).then(" is not ").then(renderType(elem))); };
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        for w in permissionOrZero(d, n - 3) { out = push(out, clone(w)); };
        return out;
    };
    if op = 31 {
        if n < 2 || n > 3 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 0);
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        for w in permissionOrZero(d, n - 2) { out = push(out, clone(w)); };
        return out;
    };
    if op = 32 {
        if n < 3 || n > 4 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 0);
        for w in intWhys(p, funcs, f, locals, pairOf(argAt(args, 1), argAt(args, 2))) { out = push(out, clone(w)); };
        for w in permissionOrZero(d, n - 3) { out = push(out, clone(w)); };
        return out;
    };
    if op = 33 {
        if n < 2 || n > 3 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 3);
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        return out;
    };
    if op = 34 {
        if n < 1 || n > 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = addressWhy(p, funcs, f, locals, argAt(args, 0), d, 0, 1);
        return out;
    };
    return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands"));
};

fn exactOperandWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, wanted: &Type, o: &Operand) -> List<String> ~ {
    actual = operandTy(p, funcs, f, locals, o);
    if actual.ok && typeEq(wanted, actual.ty) { return []; };
    return expectedWhy(p, f, locals, wanted, o);
};

fn blockOpWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, d: &Type, op: Int, args: &List<Operand>) -> List<String> ~ {
    n = size(args);
    wantN = 2;
    if op = 48 { wantN = 3; };
    if op = 53 { wantN = 1; };
    if n != wantN { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
    if !(d is Type::TBlock) { return one("the result is ".then(renderType(clone(d))).then(", not a Block")); };
    elem = Box::unbox((d as Type::TBlock).inner);
    if op = 53 {
        actual = operandTy(p, funcs, f, locals, argAt(args, 0));
        if actual.ok && actual.ty is Type::TBlock { return []; };
        return one(renderOperand(p, f, locals, argAt(args, 0)).then(" is not a Block"));
    };
    firstType = clone(d);
    if op = 46 || op = 52 { firstType = Type::TAddr { inner: Box::new(clone(elem)) }; };
    out = exactOperandWhy(p, funcs, f, locals, firstType, argAt(args, 0));
    secondType = Type::TInt;
    if op = 48 { secondType = Type::TAddr { inner: Box::new(clone(elem)) }; };
    if op = 51 { secondType = clone(d); };
    for w in exactOperandWhy(p, funcs, f, locals, secondType, argAt(args, 1)) { out = push(out, clone(w)); };
    if op = 48 {
        for w in exactOperandWhy(p, funcs, f, locals, Type::TInt, argAt(args, 2)) { out = push(out, clone(w)); };
    };
    return out;
};

fn listOpWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, d: &Type, op: Int, args: &List<Operand>, inSet: Bool) -> List<String> ~ {
    out = [];
    n = size(args);
    if op = 0 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !listLike(p, funcs, f, locals, argAt(args, 0)) { out = one(renderOperand(p, f, locals, argAt(args, 0)).then(" is not a list")); };
        for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
        return out;
    };
    if op = 1 || op = 2 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !sequenceFits(p, funcs, f, locals, d, argAt(args, 0)) { out = one(renderOperand(p, f, locals, argAt(args, 0)).then(" is not ").then(renderType(Type::TList { elem: Box::new(clone(d)) }))); };
        return out;
    };
    if op = 3 {
        if n != 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !sequenceFits(p, funcs, f, locals, d, argAt(args, 0)) { out = one(renderOperand(p, f, locals, argAt(args, 0)).then(" is not ").then(renderType(Type::TList { elem: Box::new(clone(d)) }))); };
        for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
        return out;
    };
    if op = 4 || op = 6 {
        isSetOp = op = 6;
        wantN = 2;
        if isSetOp { wantN = 3; };
        if n != wantN { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        elem = noTy();
        le2 = listElemOf(d);
        if le2.ok { elem = le2; };
        if !elem.ok && d is Type::TArray && isSetOp { elem = TyRes { ok: true, ty: clone(Box::unbox((d as Type::TArray).elem)) }; };
        db4 = boxInnerOf(d);
        if !elem.ok && db4.ok && isSetOp {
            inner = db4.ty;
            if inner is Type::TArray { elem = TyRes { ok: true, ty: clone(Box::unbox((inner as Type::TArray).elem)) }; };
        };
        if !elem.ok { return one("the result is ".then(renderType(d)).then(", not a list")); };
        if !fits(p, funcs, f, locals, d, argAt(args, 0)) { out = expectedWhy(p, f, locals, d, argAt(args, 0)); };
        xi = 1;
        if isSetOp {
            for w in intWhys(p, funcs, f, locals, single(argAt(args, 1))) { out = push(out, clone(w)); };
            xi = 2;
        };
        if !fits(p, funcs, f, locals, elem.ty, argAt(args, xi)) { out = push(out, renderOperand(p, f, locals, argAt(args, xi)).then(" is not ").then(renderType(elem.ty))); };
        return out;
    };
    if op = 5 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !fits(p, funcs, f, locals, d, argAt(args, 0)) { out = expectedWhy(p, f, locals, d, argAt(args, 0)); };
        return out;
    };
    if op = 7 {
        if n != 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if d is Type::TArray {
            e = Box::unbox((d as Type::TArray).elem);
            sz = (d as Type::TArray).size;
            given = argAt(args, 0);
            sizeOk = false;
            match given {
                Operand::Const { value: c } => {
                    if c is Constant::CInt && sz is Size::SConst && (c as Constant::CInt).n = (sz as Size::SConst).n { sizeOk = true; };
                },
                Operand::Copy { local: l } => { if sz is Size::SParam { sizeOk = true; }; },
                Operand::Move { local: l } => { if sz is Size::SParam { sizeOk = true; }; },
            };
            if !sizeOk { return one("array needs a result that is an array and a size that is a constant"); };
            if !fits(p, funcs, f, locals, e, argAt(args, 1)) { out = expectedWhy(p, f, locals, e, argAt(args, 1)); };
            return out;
        };
        return one("array needs a result that is an array and a size that is a constant");
    };
    if op = 8 {
        if n != 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        db = boxInnerOf(d);
        if db.ok {
            inner = db.ty;
            if inner is Type::TArray && (inner as Type::TArray).size is Size::SAny {
                e = Box::unbox((inner as Type::TArray).elem);
                out = intWhys(p, funcs, f, locals, single(argAt(args, 0)));
                if !fits(p, funcs, f, locals, e, argAt(args, 1)) { out = push(out, renderOperand(p, f, locals, argAt(args, 1)).then(" is not ").then(renderType(e))); };
                return out;
            };
        };
        return one("Array::boxed needs a result that is a Box of an array of any size");
    };
    if op = 9 {
        if n != 0 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        db9 = boxInnerOf(d);
        if db9.ok {
            inner = db9.ty;
            if inner is Type::TArray && (inner as Type::TArray).size is Size::SAny { return []; };
        };
        return one("Array::empty needs a result that is a Box of an array of any size");
    };
    if op = 10 || op = 11 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !fits(p, funcs, f, locals, Type::TByte, argAt(args, 0)) { out = expectedWhy(p, f, locals, Type::TByte, argAt(args, 0)); };
        for w in resultWhy(d, Type::TByte) { out = push(out, clone(w)); };
        return out;
    };
    if op = 12 || op = 13 || op = 16 || op = 19 {
        if n != 0 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        return resultWhy(d, Type::TInt);
    };
    if op = 14 {
        if n != 2 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
        return out;
    };
    if op = 15 || op = 18 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if !fits(p, funcs, f, locals, Type::TByte, argAt(args, 0)) { out = expectedWhy(p, f, locals, Type::TByte, argAt(args, 0)); };
        for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
        return out;
    };
    if op = 17 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
        return out;
    };
    if op = 20 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        for w in resultWhy(d, Type::TByte) { out = push(out, clone(w)); };
        return out;
    };
    if op = 21 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        okFrom = fits(p, funcs, f, locals, Type::TByte, argAt(args, 0))
            || fits(p, funcs, f, locals, Type::TWord { signed: true, bits: 8 }, argAt(args, 0))
            || fits(p, funcs, f, locals, Type::TWord { signed: true, bits: 16 }, argAt(args, 0))
            || fits(p, funcs, f, locals, Type::TWord { signed: true, bits: 32 }, argAt(args, 0))
            || fits(p, funcs, f, locals, Type::TWord { signed: false, bits: 16 }, argAt(args, 0))
            || fits(p, funcs, f, locals, Type::TWord { signed: false, bits: 32 }, argAt(args, 0));
        if !okFrom { out = expectedWhy(p, f, locals, Type::TByte, argAt(args, 0)); };
        for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
        return out;
    };
    if op >= 40 && op <= 44 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        out = intWhys(p, funcs, f, locals, args);
        for w in resultWhy(d, narrowType(op)) { out = push(out, clone(w)); };
        return out;
    };
    if op = 22 {
        if n != 0 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if d is Type::TAddr { return []; };
        return one("the result is ".then(renderType(d)).then(", not an address"));
    };
    if op = 23 || op = 24 || op = 25 || op = 26 || op = 27 || op = 28 || op = 29 || op = 30 || op = 31 || op = 32 || op = 33 || op = 34 {
        return pointerWhy(p, funcs, f, locals, d, op, args);
    };
    if op >= 35 && op <= 38 {
        if n != 1 && op != 35 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if op = 35 && n != 0 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        return [];
    };
    if op = 39 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        return resultWhy(d, Type::TInt);
    };
    if op = 45 {
        if n != 1 { return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands")); };
        if d is Type::TArray {
            e = clone(Box::unbox((d as Type::TArray).elem));
            if !sequenceFits(p, funcs, f, locals, e, argAt(args, 0)) { return expectedWhy(p, f, locals, Type::TList { elem: Box::new(e) }, argAt(args, 0)); };
            return out;
        };
        return one("Array::fromList needs a result that is an array");
    };
    if op >= 46 && op <= 53 { return blockOpWhy(p, funcs, f, locals, d, op, args); };
    return one(wordOf(listWords(), op).then(" is applied to ").then(String::fromInt(n)).then(" operands"));
};

fn valueOf(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, typeName: &String, o: &Operand) -> Bool ~ {
    ot = operandTy(p, funcs, f, locals, o);
    if !ot.ok { return false; };
    t = ot.ty;
    if t is Type::TBox { return sub(p, Type::TNamed { name: clone(typeName), base: clone(typeName), argc: 0, argTokens: [] }, Box::unbox((t as Type::TBox).inner)); };
    if t is Type::TNamed && beforeAngle((t as Type::TNamed).name) = "Box" {
        iargs = instanceArgs((t as Type::TNamed).name);
        if size(iargs) = 1 {
            et = textAt(iargs, 0);
            if et.ok && sub(p, Type::TNamed { name: clone(typeName), base: clone(typeName), argc: 0, argTokens: [] }, et.ty) { return true; };
        };
    };
    return sub(p, Type::TNamed { name: clone(typeName), base: clone(typeName), argc: 0, argTokens: [] }, t);
};

fn ctorFields(p: &Program, ctor: &String) -> List<Field> ~ {
    for d in p.types {
        if d is TypeDecl::DStruct {
            if (d as TypeDecl::DStruct).name = ctor { return clone((d as TypeDecl::DStruct).fields); };
        };
        if d is TypeDecl::DEnum {
            for v in (d as TypeDecl::DEnum).variants {
                if v.name = ctor { return clone(v.fields); };
            };
        };
    };
    return [];
};

fn placeWhy(p: &Program, f: &Function, locals: &HashMap<Int, Int>, root: Int, steps: &List<RefStep>) -> TyRes ~ {
    lt = localTy(f, locals, root);
    if !lt.ok { return noTy(); };
    ty = lt.ty;
    if ty is Type::TRef { ty = Box::unbox((ty as Type::TRef).inner); };
    if ty is Type::TMutRef { ty = Box::unbox((ty as Type::TMutRef).inner); };
    i = 0;
    while i < size(steps) [{ affirm i >= 0; affirm i <= size(steps); }] ~ {
        step = get(steps, i);
        if step is RefStep::Field {
            fields = ctorFields(p, (step as RefStep::Field).ctor);
            found = false;
            for fd in fields {
                if fd.name = (step as RefStep::Field).field { ty = clone(fd.ty); found = true; };
            };
            if !found { return noTy(); };
        };
        if step is RefStep::Index {
            if ty is Type::TBox { ty = Box::unbox((ty as Type::TBox).inner); };
            if ty is Type::TList { ty = Box::unbox((ty as Type::TList).elem); }
            else if ty is Type::TArray { ty = Box::unbox((ty as Type::TArray).elem); }
            else if ty is Type::TNamed {
                // Native containers declare the exact slot type in addr, including nested Boxes.
                boxed = beforeAngle((ty as Type::TNamed).name) = "Box";
                fields = ctorFields(p, (ty as Type::TNamed).name);
                found = false;
                for fd in fields {
                    if fd.name = "addr" && fd.ty is Type::TAddr {
                        ty = clone(Box::unbox((fd.ty as Type::TAddr).inner));
                        found = true;
                    };
                };
                if !found { return noTy(); };
                // (a Box's one slot holds the whole array, so an index is of the array's element)
                if boxed && ty is Type::TArray { ty = Box::unbox((ty as Type::TArray).elem); };
            } else { return noTy(); };
        };
        if ty is Type::TRef { ty = Box::unbox((ty as Type::TRef).inner); };
        if ty is Type::TMutRef { ty = Box::unbox((ty as Type::TMutRef).inner); };
        i = i + 1;
    };
    return TyRes { ok: true, ty: ty };
};

fn borrowedParameter(f: &Function, locals: &HashMap<Int, Int>, o: &Operand) -> Bool ~ {
    ids = operandLocals(o);
    if size(ids) != 1 { return false; };
    id = get(ids, 0);
    if !localTy(f, locals, id).ok { return false; };
    parameter = false;
    for p in f.params { if p = id { parameter = true; }; };
    if !parameter { return false; };
    for b in f.borrowed { if b = id { return true; }; };
    return false;
};

fn rvalueWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, d: &Type, rv: &Rvalue) -> List<String> ~ {
    out = [];
    match rv {
        Rvalue::Use { o: o } => {
            if !fits(p, funcs, f, locals, d, o) { out = expectedWhy(p, f, locals, d, o); };
        },
        Rvalue::BinaryOp { op: op, a: a, b: b } => {
            if op = 5 || op = 6 {
                out = resultWhy(d, Type::TBool);
                ta = operandTy(p, funcs, f, locals, a);
                tb = operandTy(p, funcs, f, locals, b);
                if ta.ok && tb.ok {
                    // (only words are compared: any other value is compared by its Eq, which the checker calls in its place)
                    if !isWordType(ta.ty) || !isWordType(tb.ty) { out = push(out, "only words are compared, and the operands are ".then(renderType(ta.ty)).then(" and ").then(renderType(tb.ty))); }
                    else if !sub(p, ta.ty, tb.ty) && !sub(p, tb.ty, ta.ty) {
                        out = push(out, "the operands are ".then(renderType(ta.ty)).then(" and ").then(renderType(tb.ty)));
                    };
                };
            } else if op >= 7 {
                out = intWhys(p, funcs, f, locals, pairOf(a, b));
                for w in resultWhy(d, Type::TBool) { out = push(out, clone(w)); };
            } else {
                out = intWhys(p, funcs, f, locals, pairOf(a, b));
                for w in resultWhy(d, Type::TInt) { out = push(out, clone(w)); };
            };
        },
        Rvalue::ListOp { op: op, args: args } => {
            out = listOpWhy(p, funcs, f, locals, d, op, args, false);
        },
        Rvalue::MakeList { items: items } => {
            mle = listElemOf(d);
            if mle.ok {
                e = mle.ty;
                for o in items { if !fits(p, funcs, f, locals, e, o) { out = push(out, renderOperand(p, f, locals, o).then(" is not ").then(renderType(clone(e)))); }; };
            } else { out = one("the result is ".then(renderType(d)).then(", not a list")); };
        },
        Rvalue::MakeBox { o: o } => {
            mb = boxInnerOf(d);
            if mb.ok {
                held = mb.ty;
                if !fits(p, funcs, f, locals, held, o) { out = expectedWhy(p, f, locals, held, o); };
            } else if d is Type::TNamed && beforeAngle((d as Type::TNamed).name) = "List" {
                iargs = instanceArgs((d as Type::TNamed).name);
                ot = operandTy(p, funcs, f, locals, o);
                okBox = false;
                if size(iargs) = 1 {
                    et = textAt(iargs, 0);
                    if et.ok {
                        if ot.ok && ot.ty is Type::TArray && sub(p, et.ty, Box::unbox((ot.ty as Type::TArray).elem)) { okBox = true; };
                        if o is Operand::Const && (o as Operand::Const).value is Constant::CArray { okBox = true; };
                    };
                };
                if !okBox { out = one(renderOperand(p, f, locals, o).then(" is not an array")); };
            } else { out = one("the result is ".then(renderType(d)).then(", not a Box")); };
        },
        Rvalue::Unbox { o: o } => {
            ot = operandTy(p, funcs, f, locals, o);
            matched = false;
            ub = boxInnerOf(ot.ty);
            if ot.ok && ub.ok {
                held = ub.ty;
                if !sub(p, d, held) { out = one("the result is ".then(renderType(d)).then(", not ").then(renderType(held))); };
                matched = true;
            };
            if !matched && ot.ok && ot.ty is Type::TNamed && beforeAngle((ot.ty as Type::TNamed).name) = "List" {
                iargs = instanceArgs((ot.ty as Type::TNamed).name);
                if size(iargs) = 1 {
                    et = textAt(iargs, 0);
                    if et.ok && d is Type::TArray && sub(p, Box::unbox((d as Type::TArray).elem), et.ty) { matched = true; };
                };
                if !matched { out = one("the result is ".then(renderType(d)).then(", not an array")); };
                matched = true;
            };
            if !matched { out = one(renderOperand(p, f, locals, o).then(" is not a Box")); };
        },
        Rvalue::Unsize { o: o } => {
            ot = operandTy(p, funcs, f, locals, o);
            okUn = false;
            dbu = boxInnerOf(d);
            obu = boxInnerOf(ot.ty);
            if dbu.ok && ot.ok && obu.ok {
                de = dbu.ty;
                oe = obu.ty;
                if de is Type::TArray && oe is Type::TArray {
                    dsz = (de as Type::TArray).size;
                    osz = (oe as Type::TArray).size;
                    if dsz is Size::SAny && !(osz is Size::SAny) && sub(p, Box::unbox((de as Type::TArray).elem), Box::unbox((oe as Type::TArray).elem)) { okUn = true; };
                };
            };
            if !okUn { out = one("unsize needs a Box of an array, and a result that is a Box of an array of any size"); };
        },
        Rvalue::MakeData { name: name, fields: fields, values: values } => {
            info = ctorInfo(p, name);
            if !info.ok { out = one("there is no constructor ".then(name)); }
            else {
                namesOk = size(fields) = size(info.fields);
                if namesOk {
                    i = 0;
                    while i < size(fields) && i < size(info.fields) [{ affirm i >= 0; affirm i <= size(fields); affirm i <= size(info.fields); }] ~ {
                        if i < size(info.fields) {
                            if get(fields, i) != get(info.fields, i).name { namesOk = false; };
                        };
                        i = i + 1;
                    };
                };
                if !namesOk { out = one(clone(name).then(" is built with the wrong fields")); }
                else {
                    if !typeEq(d, Type::TNamed { name: clone(info.typeName), base: clone(info.typeName), argc: 0, argTokens: [] }) { out = one("the result is ".then(renderType(d)).then(", not ").then(info.typeName)); };
                    i = 0;
                    while i < size(values) && i < size(info.fields) [{ affirm i >= 0; affirm i <= size(values); affirm i <= size(info.fields); }] ~ {
                        if i < size(info.fields) {
                            ft = get(info.fields, i).ty;
                            if !fits(p, funcs, f, locals, ft, get(values, i)) { out = push(out, renderOperand(p, f, locals, get(values, i)).then(" is not ").then(renderType(ft))); };
                        };
                        i = i + 1;
                    };
                };
            };
        },
        Rvalue::ReadField { o: o, name: name, field: field } => {
            info = ctorInfo(p, name);
            if !info.ok { out = one("there is no constructor ".then(name)); }
            else {
                if !valueOf(p, funcs, f, locals, info.typeName, o) { out = one(renderOperand(p, f, locals, o).then(" is not a ").then(name)); };
                ft = fieldType(info.fields, field);
                if !ft.ok { out = push(out, clone(name).then(" has no field ").then(field)); }
                else if !sub(p, d, ft.ty) { out = push(out, "the field is ".then(renderType(ft.ty)).then(", not ").then(renderType(d))); };
            };
        },
        Rvalue::IsVariant { o: o, name: name } => {
            info = ctorInfo(p, name);
            if !info.ok { out = one("there is no constructor ".then(name)); }
            else {
                if !valueOf(p, funcs, f, locals, info.typeName, o) { out = one(renderOperand(p, f, locals, o).then(" is not a ").then(info.typeName)); };
                for w in resultWhy(d, Type::TBool) { out = push(out, clone(w)); };
            };
        },
        Rvalue::AsVariant { o: o, name: name } => {
            info = ctorInfo(p, name);
            if !info.ok { out = one("there is no constructor ".then(name)); }
            else {
                if !valueOf(p, funcs, f, locals, info.typeName, o) { out = one(renderOperand(p, f, locals, o).then(" is not a ").then(info.typeName)); };
                if !sub(p, d, Type::TVariant { name: clone(name) }) { out = push(out, "the result is ".then(renderType(d)).then(", not ").then(name)); };
            };
        },
        Rvalue::Copy { o: o } => {
            if !fits(p, funcs, f, locals, d, o) { out = expectedWhy(p, f, locals, d, o); };
        },
        Rvalue::Borrow { root: root, steps: steps, mutable: m } => {
            pt = placeWhy(p, f, locals, root, steps);
            held = boxInnerOf(pt.ty);
            wanted = noTy();
            if d is Type::TRef { wanted = TyRes { ok: true, ty: clone(Box::unbox((d as Type::TRef).inner)) }; };
            if d is Type::TMutRef { wanted = TyRes { ok: true, ty: clone(Box::unbox((d as Type::TMutRef).inner)) }; };
            if pt.ok && held.ok && wanted.ok && typeEq(wanted.ty, held.ty) {
                sourceBox = pt.ty is Type::TBox;
                if pt.ty is Type::TNamed {
                    for field in ctorFields(p, (pt.ty as Type::TNamed).name) {
                        if field.name = "blk" && field.ty is Type::TBlock && typeEq(Box::unbox((field.ty as Type::TBlock).inner), held.ty) { sourceBox = true; };
                    };
                };
                if sourceBox { pt = held; };
            };
            if !pt.ok { out = one("a reference is to a place that is not there"); }
            else if d is Type::TRef {
                inner = Box::unbox((d as Type::TRef).inner);
                if !sub(p, inner, pt.ty) && !sub(p, pt.ty, inner) { out = one("a reference to ".then(renderType(pt.ty)).then(" is not ").then(renderType(d))); };
            } else if d is Type::TMutRef {
                inner = Box::unbox((d as Type::TMutRef).inner);
                if !m { out = one("a read reference is not an update reference"); };
                if !sub(p, inner, pt.ty) && !sub(p, pt.ty, inner) { out = one("a reference to ".then(renderType(pt.ty)).then(" is not ").then(renderType(d))); };
            } else { out = one("a reference is not ".then(renderType(d))); };
        },
        Rvalue::Deref { o: o } => {
            ot = operandTy(p, funcs, f, locals, o);
            if !ot.ok { out = one("a reference is read through a value that is not there"); }
            else if borrowedParameter(f, locals, o) {
                if !subType(p, d, ot.ty, true) { out = one("what a reference is to is ".then(renderType(ot.ty)).then(", not ").then(renderType(d))); };
            } else if ot.ty is Type::TRef {
                inner = Box::unbox((ot.ty as Type::TRef).inner);
                if !sub(p, d, inner) { out = one("what a reference is to is ".then(renderType(inner)).then(", not ").then(renderType(d))); };
            } else if ot.ty is Type::TMutRef {
                inner = Box::unbox((ot.ty as Type::TMutRef).inner);
                if !sub(p, d, inner) { out = one("what a reference is to is ".then(renderType(inner)).then(", not ").then(renderType(d))); };
            } else { out = one("a value that is not a reference is read through"); };
        },
        Rvalue::TakeField { local: l, name: name, field: field } => {
            out = rvalueWhy(p, funcs, f, locals, d, Rvalue::ReadField { o: Operand::Copy { local: l }, name: clone(name), field: clone(field) });
        },
    };
    return out;
};

fn substSizes(t: &Type, names: &List<String>, sizes: &List<Size>) -> Type ~ {
    r = clone(t);
    match t {
        Type::TArray { elem: e, size: s } => {
            ns = clone(s);
            if s is Size::SParam {
                nm = (s as Size::SParam).name;
                i = 0;
                while i < size(names) && i < size(sizes) [{ affirm i >= 0; affirm i <= size(names); affirm i <= size(sizes); }] ~ {
                    if i < size(sizes) {
                        if get(names, i) = nm { ns = clone(get(sizes, i)); };
                    };
                    i = i + 1;
                };
            };
            r = Type::TArray { elem: Box::new(substSizes(Box::unbox(e), names, sizes)), size: ns };
        },
        Type::TList { elem: e } => { r = Type::TList { elem: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TBox { inner: e } => { r = Type::TBox { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TAddr { inner: e } => { r = Type::TAddr { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TRef { inner: e } => { r = Type::TRef { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TMutRef { inner: e } => { r = Type::TMutRef { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TBlock { inner: e } => { r = Type::TBlock { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TUninit { inner: e } => { r = Type::TUninit { inner: Box::new(substSizes(Box::unbox(e), names, sizes)) }; },
        Type::TFn { args: args, ret: ret } => {
            na = [];
            for a in args { na = push(na, substSizes(a, names, sizes)); };
            r = Type::TFn { args: na, ret: Box::new(substSizes(Box::unbox(ret), names, sizes)) };
        },
        Type::TForall { sizes: sizes2, types: types, body: body } => {
            r = Type::TForall { sizes: clone(sizes2), types: clone(types), body: Box::new(substSizes(Box::unbox(body), names, sizes)) };
        },
        Type::TInt => { },
        Type::TByte => { },
        Type::TBool => { },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            listElem = listElemOf(t);
            boxInner = boxInnerOf(t);
            if listElem.ok { r = Type::TList { elem: Box::new(substSizes(listElem.ty, names, sizes)) }; }
            else if boxInner.ok { r = Type::TBox { inner: Box::new(substSizes(boxInner.ty, names, sizes)) }; };
        },
        Type::TVariant { name: name } => { },
        Type::TVar { n: n } => { },
        Type::TParam { name: name } => { },
        Type::TWord { signed: signed, bits: bits } => { },
    };
    return r;
};

fn sizeOfOperand(f: &Function, locals: &HashMap<Int, Int>, o: &Operand) -> Size [{ }] [{ }] {
    r = Size::SAny;
    match o {
        Operand::Const { value: c } => { if c is Constant::CInt { r = Size::SConst { n: (c as Constant::CInt).n }; }; },
        Operand::Copy { local: l } => {
            i = findLocal(f, locals, l);
            if i >= 0 && i < size(f.locals) && get(f.locals, i).named { r = Size::SParam { name: clone(get(f.locals, i).name) }; };
        },
        Operand::Move { local: l } => {
            i = findLocal(f, locals, l);
            if i >= 0 && i < size(f.locals) && get(f.locals, i).named { r = Size::SParam { name: clone(get(f.locals, i).name) }; };
        },
    };
    return r;
};

fn fnTypeAfterSizes(f: &Function, locals: &HashMap<Int, Int>, t: &Type, args: &List<Operand>) -> TyRes ~ {
    if t is Type::TForall {
        sizes = (t as Type::TForall).sizes;
        body = Box::unbox((t as Type::TForall).body);
        if size(args) < size(sizes) { return noTy(); };
        given = [];
        i = size(args) - size(sizes);
        while i < size(args) [{ affirm i >= 0; affirm i <= size(args); }] ~ {
            given = push(given, sizeOfOperand(f, locals, get(args, i)));
            i = i + 1;
        };
        return TyRes { ok: true, ty: substSizes(body, sizes, given) };
    };
    return TyRes { ok: true, ty: clone(t) };
};

fn callArgFits(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, wanted: &Type, o: &Operand) -> Bool ~ {
    actual = operandTy(p, funcs, f, locals, o);
    if wanted is Type::TMutRef { return actual.ok && actual.ty is Type::TMutRef && subType(p, wanted, actual.ty, true); };
    if wanted is Type::TBlock { return actual.ok && actual.ty is Type::TBlock && subType(p, wanted, actual.ty, true); };
    if wanted is Type::TRef && actual.ok && actual.ty is Type::TMutRef {
        return subType(p, Box::unbox((wanted as Type::TRef).inner), Box::unbox((actual.ty as Type::TMutRef).inner), true);
    };
    return fits(p, funcs, f, locals, wanted, o);
};

fn callWhy(p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>, callee: &Operand, args: &List<Operand>, dest: Int) -> List<String> ~ {
    ct = operandTy(p, funcs, f, locals, callee);
    if !ct.ok { return one("the callee is not a function"); };
    ctt = fnTypeAfterSizes(f, locals, ct.ty, args);
    if !ctt.ok { return one("the callee is not a function"); };
    t = ctt.ty;
    if !(t is Type::TFn) { return one("the callee is not a function"); };
    params = (t as Type::TFn).args;
    result = Box::unbox((t as Type::TFn).ret);
    if size(params) != size(args) { return one("it takes ".then(String::fromInt(size(params))).then(" arguments, got ").then(String::fromInt(size(args)))); };
    out = [];
    i = 0;
    while i < size(args) && i < size(params) [{ affirm i >= 0; affirm i <= size(args); affirm i <= size(params); }] ~ {
        if i < size(params) {
            if !callArgFits(p, funcs, f, locals, get(params, i), get(args, i)) {
                out = push(out, "argument ".then(String::fromInt(i + 1)).then(" is not ").then(renderType(get(params, i))));
            };
        };
        i = i + 1;
    };
    dt = localTy(f, locals, dest);
    if dt.ok && !sub(p, dt.ty, result) {
        out = push(out, "the result is ".then(renderType(result)).then(", not ").then(renderType(dt.ty)));
    };
    return out;
};

fn statementLocals(st: &Statement) -> List<Int> [{ }] [{ }] {
    out = [];
    match st {
        Statement::Assign { local: l, rv: rv } => {
            out = single(l);
            for o in rvalueOperands(rv) { for x in operandLocals(o) { out = push(out, x); }; };
        },
        Statement::Peek { local: l, rv: rv } => {
            out = single(l);
            for o in rvalueOperands(rv) { for x in operandLocals(o) { out = push(out, x); }; };
        },
        Statement::Drop { local: l } => { out = single(l); },
        Statement::Ghost => { },
        Statement::Dissolve { local: l } => { out = single(l); },
        Statement::AssignRef { local: l, steps: steps, rv: rv } => {
            out = single(l);
            for o in rvalueOperands(rv) { for x in operandLocals(o) { out = push(out, x); }; };
            for o in refStepOperands(steps) { for x in operandLocals(o) { out = push(out, x); }; };
        },
    };
    return out;
};

fn terminatorLocals(t: &Terminator) -> List<Int> [{ }] [{ }] {
    out = [];
    match t {
        Terminator::Switch { cond: c, yes: yes, no: no } => { out = operandLocals(c); },
        Terminator::Call { callee: callee, args: args, dest: dest, next: next } => {
            out = single(dest);
            for x in operandLocals(callee) { out = push(out, x); };
            for o in args { for x in operandLocals(o) { out = push(out, x); }; };
        },
        Terminator::Goto { block: blk } => { },
        Terminator::Return => { },
        Terminator::Unreachable => { },
    };
    return out;
};

fn terminatorFunctions(t: &Terminator) -> List<String> ~ {
    out = [];
    match t {
        Terminator::Switch { cond: c, yes: yes, no: no } => { out = operandFunctions(c); },
        Terminator::Call { callee: callee, args: args, dest: dest, next: next } => {
            out = operandFunctions(callee);
            for o in args { for n in operandFunctions(o) { out = push(out, clone(n)); }; };
        },
        Terminator::Goto { block: blk } => { },
        Terminator::Return => { },
        Terminator::Unreachable => { },
    };
    return out;
};

fn functionProblems(types: &List<TypeDecl>, p: &Program, funcs: &FunctionIndex, f: &Function, locals: &HashMap<Int, Int>) -> List<String> ~ {
    out = [];
    prefix = "In ".then(f.name).then(": ");
    if findBlock(f, 0) < 0 { out = push(out, clone(prefix).then("no entry block bb0")); };
    for d in f.locals {
        if isUnknown(d.ty) { out = push(out, clone(prefix).then("_").then(String::fromInt(d.id)).then(" has no known type")); };
        if d.ty is Type::TArray && slotsOf(types, d.ty) > 8192 {
            out = push(out, clone(prefix).then("_").then(String::fromInt(d.id)).then(" is ").then(renderType(d.ty)).then(", which takes ").then(String::fromInt(slotsOf(types, d.ty))).then(" words, more than the 8192 that an array held in a frame can have"));
        };
    };
    for pid in f.params {
        if !declared(locals, pid) { out = push(out, clone(prefix).then("parameter _").then(String::fromInt(pid)).then(" is not declared")); };
    };
    if f.hasReturn {
        if !declared(locals, 0) { out = push(out, clone(prefix).then("_0 is not declared")); };
        z = localTy(f, locals, 0);
        if z.ok && !typeEq(z.ty, f.returns) {
            out = push(out, clone(prefix).then("_0 is ").then(renderType(z.ty)).then(" but the function returns ").then(renderType(f.returns)));
        };
    };
    for b in f.blocks {
        bp = clone(prefix).then("bb").then(String::fromInt(b.id)).then(": ");
        used = [];
        for st in b.stmts { for l in statementLocals(st) { used = push(used, l); }; };
        for l in terminatorLocals(b.term) { used = push(used, l); };
        for l in used {
            if !declared(locals, l) { out = push(out, clone(bp).then("uses the undeclared _").then(String::fromInt(l))); };
        };
        fnames = [];
        for st in b.stmts {
            rvOps = [];
            match st {
                Statement::Assign { local: dl, rv: rv } => { rvOps = rvalueOperands(rv); },
                Statement::Peek { local: dl, rv: rv } => { rvOps = rvalueOperands(rv); },
                Statement::Drop { local: dl } => { },
                Statement::Ghost => { },
                Statement::Dissolve { local: dl } => { },
                Statement::AssignRef { local: dl, steps: steps, rv: rv } => { rvOps = rvalueOperands(rv); },
            };
            for o in rvOps { for n in operandFunctions(o) { fnames = push(fnames, clone(n)); }; };
        };
        for n in terminatorFunctions(b.term) { fnames = push(fnames, clone(n)); };
        for n in fnames {
            if !functionKnown(funcs, n) { out = push(out, clone(bp).then("names the function ").then(n).then(", which is not there")); };
        };
        targets = [];
        match b.term {
            Terminator::Goto { block: t } => { targets = single(t); },
            Terminator::Switch { cond: c, yes: yes, no: no } => { targets = pairOf(yes, no); },
            Terminator::Call { callee: callee, args: args, dest: dest, next: next } => { targets = single(next); },
            Terminator::Return => { },
            Terminator::Unreachable => { },
        };
        for t in targets {
            if findBlock(f, t) < 0 { out = push(out, clone(bp).then("jumps to bb").then(String::fromInt(t)).then(", which is not there")); };
        };
        for st in b.stmts {
            match st {
                Statement::Assign { local: dl, rv: rv } => { dst = localTy(f, locals, dl); if dst.ok { for w in rvalueWhy(p, funcs, f, locals, dst.ty, rv) { out = push(out, clone(bp).then("is ill typed: ").then(w)); }; }; },
                Statement::Peek { local: dl, rv: rv } => { dst = localTy(f, locals, dl); if dst.ok { for w in rvalueWhy(p, funcs, f, locals, dst.ty, rv) { out = push(out, clone(bp).then("is ill typed: ").then(w)); }; }; },
                Statement::AssignRef { local: dl, steps: steps, rv: rv } => { dst = placeWhy(p, f, locals, dl, steps); if dst.ok { for w in rvalueWhy(p, funcs, f, locals, dst.ty, rv) { out = push(out, clone(bp).then("is ill typed: ").then(w)); }; }; },
                Statement::Drop { local: dl } => { },
                Statement::Ghost => { },
                Statement::Dissolve { local: dl } => { },
            };
        };
        match b.term {
            Terminator::Switch { cond: c, yes: yes, no: no } => {
                if !fits(p, funcs, f, locals, Type::TBool, c) { out = push(out, clone(bp).then("is ill typed: the test is not a Bool")); };
            },
            Terminator::Call { callee: callee, args: args, dest: dest, next: next } => {
                for w in callWhy(p, funcs, f, locals, callee, args, dest) { out = push(out, clone(bp).then("is ill typed: ").then(w)); };
            },
            Terminator::Goto { block: t } => { },
            Terminator::Return => { },
            Terminator::Unreachable => { },
        };
    };
    return out;
};

// The first problem of the program, or the empty string when it is well formed
fn verifyProgram(p: &Program) -> String ~ {
    names = [];
    indexes = [];
    i = 0;
    while i < size(p.functions) [{ affirm i >= 0; affirm i <= size(p.functions); }] shrinks size(p.functions) - i {
        f = &get(p.functions, i);
        names = push(names, clone((*f).name));
        indexes = push(indexes, indexLocals(f));
        i = i + 1;
    };
    names = push(names, clone(p.entry.name));
    funcs = FunctionIndex { names: names, locals: indexes, entry: indexLocals(&p.entry) };
    all = functionProblems(p.types, p, funcs, &p.entry, &funcs.entry);
    if size(all) > 0 { return clone(get(all, 0)); };
    i = 0;
    while i < size(p.functions) && i < size(funcs.locals) [{ affirm i >= 0; affirm i <= size(p.functions); affirm i <= size(funcs.locals); }] shrinks size(p.functions) - i {
        ps = functionProblems(p.types, p, funcs, &get(p.functions, i), &get(funcs.locals, i));
        if size(ps) > 0 { return clone(get(ps, 0)); };
        i = i + 1;
    };
    return "";
};

// The program is read from the standard input, and checked. What cannot be read is reported as the
// reader reports it; a program that is not well formed is reported on the standard error and gives 1.
read = readLines();
if !read.ok {
    "the input is not the MIR as data: a bad name\n".printError();
    return 1;
};
program = programAt(read.value);
if !program.ok {
    "the input is not the MIR as data\n".printError();
    return 1;
};
problem = verifyProgram(program.value);
if problem = "" {
    "OK".print();
    writeByte(toByte(10));
} else {
    problem.printError();
    writeError(toByte(10));
    return 1;
};
