import data::codec::codec { Parsed, parseInt };
import mir::full::records { beforeText };

fn decimalFits(text: &String) -> Parsed<Int> ~ { return parseInt(text); };

fn negativeDecimal(a: &String) -> Bool ~ { return a.startsWith("-"); };
fn magnitude(a: &String) -> String ~ {
    if negativeDecimal(a) { return a.slice(1, size(a.bytes)); };
    return clone(a);
};
fn magnitudeCmp(a: &String, b: &String) -> Int ~ {
    if size(a.bytes) < size(b.bytes) { return -1; };
    if size(a.bytes) > size(b.bytes) { return 1; };
    if beforeText(a, b) { return -1; };
    if beforeText(b, a) { return 1; };
    return 0;
};
fn decimalCmp(a: &String, b: &String) -> Int ~ {
    an = negativeDecimal(a); bn = negativeDecimal(b);
    if an != bn { if an { return -1; }; return 1; };
    am = magnitude(a); bm = magnitude(b); c = magnitudeCmp(&am, &bm);
    if an { return 0 - c; }; return c;
};
fn digitAt(a: &String, p: Int) -> Int ~ {
    if p < 0 || p >= size(a.bytes) { return 0; };
    return toInt(get(a.bytes, p)) - 48;
};
fn decimalDigits(ds: &List<Int>, negative: Bool) -> String ~ {
    i = size(ds);
    while i > 0 && get(ds, i - 1) = 0 ~ { i = i - 1; };
    if i = 0 { return "0"; };
    bytes = [];
    if negative { bytes = push(bytes, toByte(45)); };
    while i > 0 ~ {
        i = i - 1;
        bytes = push(bytes, toByte(48 + get(ds, i)));
    };
    return String { bytes: bytes };
};
fn magnitudeAdd(a: &String, b: &String, negative: Bool) -> String ~ {
    i = size(a.bytes); j = size(b.bytes); carry = 0; ds = [];
    while i > 0 || j > 0 || carry != 0 ~ {
        i = i - 1; j = j - 1;
        d = digitAt(a, i) + digitAt(b, j) + carry;
        ds = push(ds, d % 10); carry = d / 10;
    };
    return decimalDigits(&ds, negative);
};
fn magnitudeSub(larger: &String, smaller: &String, negative: Bool) -> String ~ {
    i = size(larger.bytes); j = size(smaller.bytes); borrow = 0; ds = [];
    while i > 0 ~ {
        i = i - 1; j = j - 1;
        d = digitAt(larger, i) - digitAt(smaller, j) - borrow;
        borrow = 0;
        if d < 0 { d = d + 10; borrow = 1; };
        ds = push(ds, d);
    };
    return decimalDigits(&ds, negative);
};
fn signedAdd(a: &String, an: Bool, b: &String, bn: Bool) -> String ~ {
    if an = bn { return magnitudeAdd(a, b, an); };
    if magnitudeCmp(a, b) < 0 { return magnitudeSub(b, a, bn); };
    return magnitudeSub(a, b, an);
};
fn decimalAdd(a: &String, b: &String) -> String ~ {
    am = magnitude(a); bm = magnitude(b);
    return signedAdd(&am, negativeDecimal(a), &bm, negativeDecimal(b));
};
fn decimalSub(a: &String, b: &String) -> String ~ {
    am = magnitude(a); bm = magnitude(b);
    return signedAdd(&am, negativeDecimal(a), &bm, !negativeDecimal(b));
};
fn decimalMul(a: &String, b: &String) -> String ~ {
    am = magnitude(a); bm = magnitude(b);
    na = size(am.bytes); nb = size(bm.bytes);
    ds = []; for i in 0..na + nb { ds = push(ds, 0); };
    for i in 0..na {
        x = digitAt(&am, na - 1 - i); carry = 0;
        for j in 0..nb {
            k = i + j;
            d = x * digitAt(&bm, nb - 1 - j) + get(ds, k) + carry;
            ds = set(ds, k, d % 10); carry = d / 10;
        };
        ds = set(ds, i + nb, carry);
    };
    return decimalDigits(&ds, negativeDecimal(a) != negativeDecimal(b));
};
