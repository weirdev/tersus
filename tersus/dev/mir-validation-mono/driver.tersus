import data::reader::reader { readRecords, tokenizeMir };
import mir::validationmono::request { runValidationMono };

fn runProbe() -> Bool ~ {
    input = readRecords(0 - 1);
    if !input.ok { return false; };
    rows = [];
    for line in &input.value {
        row = tokenizeMir(line);
        if !row.ok { return false; };
        rows = push(rows, row.value);
    };
    return runValidationMono(&rows);
};

if !runProbe() { return 1; };
