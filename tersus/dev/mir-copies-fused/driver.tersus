import data::codec::codec { Parsed, Token, tokenize, isWord };
import data::reader::reader { readRecord, readRecords, tokenizeMir };
import mir::reader::reader { readLines };
import mir::link::link { isLinkRequest, runLink, linkError };
import copiesprobe::auditRequest { inspectMerge };
import mir::full::tokens { wordIs };

fn runLinkProbe() -> Int ~ {
    request = readEmitterInput();
    if !request.ok {
        "the input is not the MIR as data: a bad name\n".printError();
        return 1;
    };
    if !isLinkRequest(&request.value) { linkError("the input is not a linking request"); return 1; };
    if size(request.value) > 1 && wordIs(get(&request.value, 1), 0, "inspect-merge") {
        if !inspectMerge(&request.value) { return 1; };
    } else { if !runLink(&request.value) { return 1; }; };
    return 0;
};
