fn isEven(n: Int) -> Bool [{ affirm n >= 0; }] [{ }] shrinks n {
    if n = 0 { return true; };
    return isOdd(n - 1);
};
fn isOdd(n: Int) -> Bool [{ affirm n >= 0; }] [{ }] shrinks n {
    if n = 0 { return false; };
    return isEven(n - 1);
};
if isEven(10) && !isOdd(10) { return 1; };
return 0;
