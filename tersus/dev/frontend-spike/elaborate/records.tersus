import data::codec::codec { Token, Parsed, tokenize, parseInt, indexOf, catStrings };

// One record of the AST data (AST_DATA.md): its tag, an index into tagWords (-1 for a tag the spike does not
// model), its unquoted numeric fields in order, its first quoted field, its first unquoted field that is not a
// number, and the line as it was read, which the output repeats when the record is unchanged.
struct Rec { tag: Int, nums: List<Int>, text: String, word: String, line: String };
impl Clone for Rec { };

struct Input { recs: List<Rec>, root: Int, ok: Bool };

// 0 StatementsEnd, 1 StatementsCons, 2 NameEnd, 3 NamePart, 4 Var, 5 Val, 6 F, 7 ExpressionsEnd, 8 ExpressionsCons,
// 9 VInt, 10 VBool, 11 VFunct, 12 NamesEnd, 13 NamesCons, 14 ValidationsEnd, 15 ValidationsCons, 16 NoName,
// 17 SomeName, 18 FieldBuiltin, 19 BuiltinFunct, 20 NativeFunct, 21 ProofsEnd, 22 ProofsCons, 23 Return, 24 Assign,
// 25 Mark, 26 If, 27 While, 28 Block, 29 Rel, 30 Primitive, 31 Ctor, 32 ArgsEnd, 33 TypesEnd, 34 TypesCons, 35 Type,
// 36 Signature, 37 NoTermination, 38 SomeTermination, 39 Shrinks, 40 MayDiverge, 41 ProofAssert, 42 FApp, 43 ATerm,
// 44 CTerm, 45 StructDef, 46 Field, 47 FieldsEnd, 48 FieldsCons, 49 Assume, 50 Forall, 51 BVar, 52 Counting,
// 53 Parts, 54 ValidationStatement, 55 AssignProofVar
fn tagWords() -> List<String> [{ }] [{ }] {
    w = push([], "StatementsEnd");
    w = push(w, "StatementsCons");
    w = push(w, "NameEnd");
    w = push(w, "NamePart");
    w = push(w, "Var");
    w = push(w, "Val");
    w = push(w, "F");
    w = push(w, "ExpressionsEnd");
    w = push(w, "ExpressionsCons");
    w = push(w, "VInt");
    w = push(w, "VBool");
    w = push(w, "VFunct");
    w = push(w, "NamesEnd");
    w = push(w, "NamesCons");
    w = push(w, "ValidationsEnd");
    w = push(w, "ValidationsCons");
    w = push(w, "NoName");
    w = push(w, "SomeName");
    w = push(w, "FieldBuiltin");
    w = push(w, "BuiltinFunct");
    w = push(w, "NativeFunct");
    w = push(w, "ProofsEnd");
    w = push(w, "ProofsCons");
    w = push(w, "Return");
    w = push(w, "Assign");
    w = push(w, "Mark");
    w = push(w, "If");
    w = push(w, "While");
    w = push(w, "Block");
    w = push(w, "Rel");
    w = push(w, "Primitive");
    w = push(w, "Ctor");
    w = push(w, "ArgsEnd");
    w = push(w, "TypesEnd");
    w = push(w, "TypesCons");
    w = push(w, "Type");
    w = push(w, "Signature");
    w = push(w, "NoTermination");
    w = push(w, "SomeTermination");
    w = push(w, "Shrinks");
    w = push(w, "MayDiverge");
    w = push(w, "ProofAssert");
    w = push(w, "FApp");
    w = push(w, "ATerm");
    w = push(w, "CTerm");
    w = push(w, "StructDef");
    w = push(w, "Field");
    w = push(w, "FieldsEnd");
    w = push(w, "FieldsCons");
    w = push(w, "Assume");
    w = push(w, "Forall");
    w = push(w, "BVar");
    w = push(w, "Counting");
    w = push(w, "Parts");
    w = push(w, "ValidationStatement");
    w = push(w, "AssignProofVar");
    return w;
};

fn readLine() -> Parsed<String> [{ }] [{ }] {
    bytes = [];
    c = readByte();
    if c < 0 { return Parsed<String> { value: "", pos: 0, ok: true }; };
    n = 0;
    while c >= 0 && c != 10 [{ affirm n >= 0; affirm n <= 1000000; }] shrinks 1000000 - n {
        if n >= 1000000 { return Parsed<String> { value: "", pos: 1, ok: false }; };
        if c < 32 || c > 126 { return Parsed<String> { value: "", pos: 1, ok: false }; };
        bytes = push(bytes, toByte(c));
        n = n + 1;
        c = readByte();
    };
    return Parsed<String> { value: String { bytes: bytes }, pos: 1, ok: true };
};

fn badInput() -> Input [{ }] [{ }] {
    return Input { recs: [], root: 0, ok: false };
};

fn recordOf(words: &List<String>, tokens: &List<Token>, line: String) -> Rec [{ }] [{ }] {
    nums = [];
    text = "";
    word = "";
    if size(tokens) = 0 { return Rec { tag: 0 - 1, nums: nums, text: text, word: word, line: line }; };
    tag = indexOf(words, get(tokens, 0).text);
    haveText = false;
    haveWord = false;
    i = 1;
    while i < size(tokens) [{ affirm i >= 1; affirm i <= size(tokens); }] shrinks size(tokens) - i {
        t = get(tokens, i);
        if t.quoted {
            if !haveText { text = clone(t.text); haveText = true; };
        } else {
            n = parseInt(t.text);
            if n.ok { nums = push(nums, n.value); } else {
                if !haveWord { word = clone(t.text); haveWord = true; };
            };
        };
        i = i + 1;
    };
    return Rec { tag: tag, nums: nums, text: text, word: word, line: line };
};

// The parsed AST data on the standard input. The records are trusted to be the writer's (the AST reader checks
// the format); only what the elaborator needs is read.
fn readInput() -> Input ~ {
    words = tagWords();
    header = readLine();
    if !header.ok || header.pos = 0 || header.value != "tersus-ast 1 parsed" { return badInput(); };
    recs = [];
    while true [{ }] ~ {
        line = readLine();
        if !line.ok || line.pos = 0 { return badInput(); };
        ts = tokenize(line.value);
        if !ts.ok || size(ts.value) = 0 { return badInput(); };
        tokens = ts.value;
        if get(tokens, 0).text = "root" {
            if size(tokens) != 2 { return badInput(); };
            root = parseInt(get(tokens, 1).text);
            if !root.ok || root.value < 0 || root.value != size(recs) - 1 { return badInput(); };
            return Input { recs: recs, root: root.value, ok: true };
        };
        recs = push(recs, recordOf(words, tokens, line.value));
    };
    return badInput();
};

fn tagAt(recs: &List<Rec>, id: Int) -> Int [{ }] [{ }] {
    if id < 0 || id >= size(recs) { return 0 - 1; };
    return get(recs, id).tag;
};

// Field i of record id, or -1 when there is no such record or field
fn numAt(recs: &List<Rec>, id: Int, i: Int) -> Int [{ }] [{ }] {
    if id < 0 || id >= size(recs) || i < 0 { return 0 - 1; };
    r = get(recs, id);
    if i >= size(r.nums) { return 0 - 1; };
    return get(r.nums, i);
};

fn textAt(recs: &List<Rec>, id: Int) -> String [{ }] [{ }] {
    if id < 0 || id >= size(recs) { return ""; };
    return clone(get(recs, id).text);
};

fn wordAtRec(recs: &List<Rec>, id: Int) -> String [{ }] [{ }] {
    if id < 0 || id >= size(recs) { return ""; };
    return clone(get(recs, id).word);
};

// A name: its parts joined (NamePart "text" tail ... NameEnd). Every reference is to an earlier record, which
// is what makes the walk end.
fn nameAt(recs: &List<Rec>, start: Int) -> String [{ }] [{ }] {
    out = "";
    id = start;
    while id >= 0 && id < size(recs) [{ }] shrinks id + 1 {
        if tagAt(recs, id) != 3 { return out; };
        next = numAt(recs, id, 0);
        if next >= id { return out; };
        out = catStrings(out, get(recs, id).text);
        id = next;
    };
    return out;
};

// The heads of a typed list (a Cons record is HEAD TAIL; any other record ends it), in order
fn itemsAt(recs: &List<Rec>, start: Int, consTag: Int) -> List<Int> [{ }] [{ }] {
    items = [];
    id = start;
    while id >= 0 && id < size(recs) [{ }] shrinks id + 1 {
        if tagAt(recs, id) != consTag { return items; };
        items = push(items, numAt(recs, id, 0));
        next = numAt(recs, id, 1);
        if next >= id { return items; };
        id = next;
    };
    return items;
};

// The builtin a value is (VFunct ... (BuiltinFunct B) ...), or -1
fn builtinOf(recs: &List<Rec>, value: Int) -> Int [{ }] [{ }] {
    if tagAt(recs, value) != 11 { return 0 - 1; };
    body = numAt(recs, value, 3);
    if tagAt(recs, body) != 19 { return 0 - 1; };
    return numAt(recs, body, 0);
};
