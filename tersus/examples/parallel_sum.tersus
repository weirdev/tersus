// Parallel iteration: pairSums walks two lists of the same length with one index and builds
// a list of the sums of each element pair. get is only legal for 0 <= index < size(list), so
// the validator has to show that for both lists. The loop condition gives index < size(a), and
// the input contract (size(a) = size(b)) carries it over to b. push's output contract lets the
// invariant track the size of the result, which becomes the function's output contract.
// The counter facts (0 <= i <= n, and i = n after the loop) follow from the loop condition
// and the invariant, so no axioms are needed. define s0 = size(out) makes the validator
// evaluate the size of the empty list, which the invariant size(out) = i needs on entry.

fn pairSums(a, b) [{
    affirm size(a) = size(b);
}] [{
    affirm size(return) = size(a);
}] {
    n = size(a);
    i = 0;
    out = [];
    define s0 = size(out);
    while i < n [{ affirm i >= 0; affirm i <= n; affirm size(out) = i; }] {
        out = push(out, get(a, i) + get(b, i));
        i = i + 1;
    };
    return out;
};

x = [1, 2, 3];
y = [10, 20, 30];
// The call site has to show the contract: both lists have three elements.
define nx = size(x);
define ny = size(y);
affirm size(x) = size(y);
sums = pairSums(x, y);
// The output contract says the result is as long as the inputs.
define ns = size(sums);
affirm size(sums) = size(x);
return sums;
