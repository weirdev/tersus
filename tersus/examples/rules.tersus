// User-defined rewrite rules.

// An axiom's output is trusted, but its input is checked at every rewrite site.
axiom positiveMeansOne(x) [{
    affirm x > 0;
}] [{
    affirm x = 1;
}];

// A proof rule's body is validated once, when the rule is defined.
proof keepPositive(x) [{
    affirm x > 0;
}] [{
    affirm x > 0;
}] {
    affirm x > 0;
};

x = 5;
rewrite eqToGtZero x;
rewrite keepPositive x;
affirm x > 0;
rewrite positiveMeansOne x;
affirm x = 1;
rewrite eqToLtPlus1 x;
affirm x < 6;
