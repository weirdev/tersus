// What push and set leave alone. Their contracts say that every element the list already had is
// unchanged: forall j in 0..size(list): get(return, j) = get(list, j) for push, and the same
// for set except at j = index. A program gets these facts for any element it reads.
fn appendKeeping(l: List<Int>, x: Int) -> List<Int> [{ }] [{ }] {
    return push(l, x);
};

a = [10, 20, 30];
b = push(a, 40);
affirm get(b, 1) = get(a, 1);
c = set(b, 2, 99);
affirm get(c, 0) = get(b, 0);
affirm get(c, 3) = get(b, 3);
return get(c, 0) + get(c, 2) + get(c, 3);
