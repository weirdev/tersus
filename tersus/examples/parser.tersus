// The Tersus parser, written in Tersus: reads source segments and writes the AST as data (`tersus-ast 1 parsed`, AST_DATA.md), byte for byte as AstData.writeParsed of the Haskell parser (src/Parse.hs) writes it. The host protocol is documented in AST_DATA.md.

// ---- MIR codec types ----
struct Token { quoted: Bool, text: String };

impl Clone for Token { };
impl Eq for Token { };

struct Parsed<T> { value: T, pos: Int, ok: Bool };

impl<T> Clone for Parsed<T> { };

enum Size { SConst { n: Int }, SAny, SParam { name: String }, SVar { n: Int } };

impl Clone for Size { };
impl Eq for Size { };

enum Type {
    TInt,
    TByte,
    TBool,
    TList { elem: Box<Type> },
    TArray { elem: Box<Type>, size: Size },
    TBox { inner: Box<Type> },
    TFn { args: List<Type>, ret: Box<Type> },
    TNamed { name: String, base: String, argc: Int, argTokens: List<Token> },
    TVariant { name: String },
    TVar { n: Int },
    TForall { sizes: List<String>, types: List<String>, body: Box<Type> },
    TParam { name: String },
    TRef { inner: Box<Type> },
    TMutRef { inner: Box<Type> },
    TAddr { inner: Box<Type> },
    TBlock { inner: Box<Type> },
    TUninit { inner: Box<Type> },
    TWord { signed: Bool, bits: Int },
};

impl Clone for Type { };
impl Eq for Type { };

// ---- end MIR codec types ----

enum AstName { End, Part { text: String, tail: Int } };
impl Clone for AstName { };

enum AstValue {
    VInt { n: Int },
    VList { xs: Int },
    VBool { b: Bool },
    VData { n: Int, xs: Int },
    VFnRef { n: Int },
    VFunct { ps: Int, ins: Int, outs: Int, body: Int, exports: Int },
};
impl Clone for AstValue { };

enum AstBody {
    NativeFunct { sig: Int, term: Int, stmts: Int },
    BuiltinFunct { b: Int },
};
impl Clone for AstBody { };

enum AstExpression {
    Val { v: Int },
    Var { n: Int },
    F { f: Int, xs: Int },
};
impl Clone for AstExpression { };

enum AstTermination {
    Shrinks { e: Int },
    Counting { e: Int },
    Parts { e: Int },
    MayDiverge,
    Recursing { t: Int },
};
impl Clone for AstTermination { };

enum AstValidation {
    Rewrite { r: Int },
    ProofAssert { p: Int },
    AssignProofVar { n: Int, e: Int },
    Assume { p: Int },
};
impl Clone for AstValidation { };

enum AstProof {
    FApp { f: Int, xs: Int },
    ATerm { n: Int },
    CTerm { v: Int },
    Forall { n: Int, gs: Int, b: Int },
    BVar { n: Int },
};
impl Clone for AstProof { };

enum AstRule {
    Refl { p: Int },
    Eval { n: Int },
    EvalAll,
    CheckGtZero { p: Int },
    CheckRel { p: Int },
    UserRewrite { n: Int, xs: Int },
};
impl Clone for AstRule { };

enum AstStatement {
    Assign { n: Int, e: Int },
    AssignDeref { a: Int, b: Int },
    Let { n: Int, e: Int },
    Return { e: Int },
    ValidationStatement { v: Int },
    StructDef { n: Int, ps: Int, fs: Int, vs: Int },
    EnumDef { n: Int, vs: Int },
    AxiomDef { n: Int, ps: Int, ins: Int, outs: Int },
    ProofDef { n: Int, ps: Int, ins: Int, outs: Int, body: Int },
    Block { xs: Int },
    If { e: Int, a: Int, b: Int },
    While { e: Int, vs: Int, t: Int, xs: Int },
    TraitDef { n: Int, ps: Int, fs: Int },
    ImplDef { traitName: Int, args: Int, n: Int, ty: Int, bs: Int, xs: Int },
    BoundedDef { bs: Int, s: Int },
    Mark { line: Int, col: Int },
    CopyDef { n: Int },
    LinearDef { n: Int },
    ExternDef { n: Int },
    DropDef { n: Int },
    Dissolve { n: Int },
};
impl Clone for AstStatement { };

struct AstSignature { ts: Int, ret: Int, ss: Int, ps: Int, ws: Int, fs: Int };
impl Clone for AstSignature { };

struct AstTraitFn { n: Int, ps: Int, sig: Int, ins: Int, outs: Int };
impl Clone for AstTraitFn { };

struct AstBound { p: Int, n: Int, ts: Int };
impl Clone for AstBound { };

struct AstField { n: Int, ty: Int };
impl Clone for AstField { };

struct AstVariant { n: Int, fs: Int };
impl Clone for AstVariant { };

struct AstValueField { n: Int, v: Int };
impl Clone for AstValueField { };

enum AstArg {
    ArgSize { s: Int },
    ArgType { t: Int },
};
impl Clone for AstArg { };

enum AstOptName {
    NoName,
    SomeName { n: Int },
};
impl Clone for AstOptName { };

enum AstOptTermination {
    NoTermination,
    SomeTermination { t: Int },
};
impl Clone for AstOptTermination { };

enum AstBuiltin {
    Ctor { n: Int, args: Int, fs: Int },
    FieldBuiltin { owner: Int, n: Int },
    Is { n: Int },
    Project { n: Int, f: Int },
    Cast { n: Int },
    ToWord { signed: Bool, bits: Int },
    Rel { r: Int },
    Primitive { name: String },
};
impl Clone for AstBuiltin { };

enum AstNames { End, Cons { head: Int, tail: Int } };
impl Clone for AstNames { };

enum AstValues { End, Cons { head: Int, tail: Int } };
impl Clone for AstValues { };

enum AstStatements { End, Cons { head: Int, tail: Int } };
impl Clone for AstStatements { };

enum AstExpressions { End, Cons { head: Int, tail: Int } };
impl Clone for AstExpressions { };

enum AstValidations { End, Cons { head: Int, tail: Int } };
impl Clone for AstValidations { };

enum AstProofs { End, Cons { head: Int, tail: Int } };
impl Clone for AstProofs { };

enum AstFields { End, Cons { head: Int, tail: Int } };
impl Clone for AstFields { };

enum AstVariants { End, Cons { head: Int, tail: Int } };
impl Clone for AstVariants { };

enum AstValueFields { End, Cons { head: Int, tail: Int } };
impl Clone for AstValueFields { };

enum AstTypes { End, Cons { head: Int, tail: Int } };
impl Clone for AstTypes { };

enum AstArgs { End, Cons { head: Int, tail: Int } };
impl Clone for AstArgs { };

enum AstTraitFns { End, Cons { head: Int, tail: Int } };
impl Clone for AstTraitFns { };

enum AstBounds { End, Cons { head: Int, tail: Int } };
impl Clone for AstBounds { };

struct AstElaborated { statements: Int, types: Int };
impl Clone for AstElaborated { };

enum AstNode {
    Name { value: AstName },
    Type { value: Type },
    Size { value: Size },
    Value { value: AstValue },
    Body { value: AstBody },
    Expression { value: AstExpression },
    Termination { value: AstTermination },
    Validation { value: AstValidation },
    Proof { value: AstProof },
    Rule { value: AstRule },
    Statement { value: AstStatement },
    Signature { value: AstSignature },
    TraitFn { value: AstTraitFn },
    Bound { value: AstBound },
    Field { value: AstField },
    Variant { value: AstVariant },
    ValueField { value: AstValueField },
    Arg { value: AstArg },
    OptName { value: AstOptName },
    OptTermination { value: AstOptTermination },
    Builtin { value: AstBuiltin },
    Names { value: AstNames },
    Values { value: AstValues },
    Statements { value: AstStatements },
    Expressions { value: AstExpressions },
    Validations { value: AstValidations },
    Proofs { value: AstProofs },
    Fields { value: AstFields },
    Variants { value: AstVariants },
    ValueFields { value: AstValueFields },
    Types { value: AstTypes },
    Args { value: AstArgs },
    TraitFns { value: AstTraitFns },
    Bounds { value: AstBounds },
    Elaborated { value: AstElaborated },
};
impl Clone for AstNode { };

struct AstProgram { elaborated: Bool, nodes: List<AstNode>, root: Int };
impl Clone for AstProgram { };


fn hexDigit(d: Int) -> Byte [{ affirm d >= 0; affirm d <= 15; }] [{ }] {
    if d < 10 { return toByte(48 + d); };
    return toByte(55 + d);
};


fn printInt(n: Int) -> Int [{ }] [{ }] {
    return " ".print() + String::fromInt(n).print();
};


fn printWord(w: &String) -> Int [{ }] [{ }] {
    return " ".print() + w.print();
};


fn printName(name: &String) -> Int [{ }] [{ }] {
    n = " \"".print();
    for i in 0..size(name.bytes) {
        c = toInt(get(name.bytes, i));
        if c >= 32 && c < 127 && c != 34 && c != 92 {
            writeByte(toByte(c));
            n = n + 1;
        } else {
            writeByte(toByte(92));
            writeByte(toByte(120));
            writeByte(hexDigit(c / 16));
            writeByte(hexDigit(c % 16));
            n = n + 4;
        };
    };
    writeByte(toByte(34));
    return n + 1;
};


fn printNames(names: &List<String>) -> Int [{ }] [{ }] {
    n = printInt(size(names));
    for name in names {
        n = n + printName(name);
    };
    return n;
};


fn printInts(ints: &List<Int>) -> Int [{ }] [{ }] {
    n = printInt(size(ints));
    for v in ints {
        n = n + printInt(v);
    };
    return n;
};


fn newLine() -> Int [{ }] [{ }] {
    writeByte(toByte(10));
    return 1;
};


fn printSize(s: &Size) -> Int [{ }] [{ }] {
    return match s {
        Size::SConst { n: n } => " c".print() + printInt(n),
        Size::SAny => " any".print(),
        Size::SParam { name: name } => " p".print() + printName(name),
        Size::SVar { n: n } => " v".print() + printInt(n),
    };
};


fn printType(t: &Type) -> Int ~ {
    n = 0;
    match t {
        Type::TInt => { n = " int".print(); },
        Type::TByte => { n = " byte".print(); },
        Type::TBool => { n = " bool".print(); },
        Type::TList { elem: e } => { n = " list".print() + printType(Box::unbox(e)); },
        Type::TArray { elem: e, size: s } => { n = " array".print() + printType(Box::unbox(e)) + printSize(s); },
        Type::TBox { inner: e } => { n = " box".print() + printType(Box::unbox(e)); },
        Type::TFn { args: args, ret: r } => {
            n = " fn".print() + printInt(size(args));
            i = 0;
            while i < size(args) [{ affirm i >= 0; affirm i <= size(args); }] ~ {
                n = n + printType(get(args, i));
                i = i + 1;
            };
            n = n + printType(Box::unbox(r));
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            n = " named".print() + printName(base) + printInt(argc);
            for tok in argTokens {
                if tok.quoted {
                    n = n + printName(tok.text);
                } else {
                    n = n + printWord(tok.text);
                };
            };
        },
        Type::TVariant { name: name } => { n = " variant".print() + printName(name); },
        Type::TVar { n: v } => { n = " var".print() + printInt(v); },
        Type::TForall { sizes: sizes, types: types, body: body } => {
            n = " forall".print() + printNames(sizes) + printNames(types) + printType(Box::unbox(body));
        },
        Type::TParam { name: name } => { n = " param".print() + printName(name); },
        Type::TRef { inner: e } => { n = " ref".print() + printType(Box::unbox(e)); },
        Type::TMutRef { inner: e } => { n = " mutref".print() + printType(Box::unbox(e)); },
        Type::TAddr { inner: e } => { n = " addr".print() + printType(Box::unbox(e)); },
        Type::TBlock { inner: e } => { n = " block".print() + printType(Box::unbox(e)); },
        Type::TUninit { inner: e } => { n = " uninit".print() + printType(Box::unbox(e)); },
        Type::TWord { signed: signed, bits: bits } => {
            w = " u32";
            if signed && bits = 8 { w = " i8"; };
            if signed && bits = 16 { w = " i16"; };
            if signed && bits = 32 { w = " i32"; };
            if !signed && bits = 16 { w = " u16"; };
            n = w.print();
        },
    };
    return n;
};


fn isWord(ts: &List<Token>, pos: Int, w: &String) -> Bool [{ }] [{ }] {
    if pos < 0 || pos >= size(ts) { return false; };
    t = get(ts, pos);
    return !t.quoted && t.text = w;
};


fn relationWords() -> List<String> [{ }] [{ }] {
    w = push([], "Eq");
    w = push(w, "NotEq");
    w = push(w, "Lt");
    w = push(w, "Gt");
    w = push(w, "LtEq");
    w = push(w, "GtEq");
    return w;
};

fn indexOf(table: &List<String>, word: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(table); }] {
    i = 0;
    while i < size(table) [{ affirm i >= 0; affirm i <= size(table); }] shrinks size(table) - i {
        if get(table, i) = word { return i; };
        i = i + 1;
    };
    return 0 - 1;
};


fn wordOf(table: &List<String>, i: Int) -> String [{ }] [{ }] {
    if i >= 0 && i < size(table) { return clone(get(table, i)); };
    return "";
};


fn printNode(node: &AstNode) -> Int ~ {
    bytesWritten = 0;
    match node {
        AstNode::Name { value: v } => { match v { AstName::End => { bytesWritten = "NameEnd".print(); }, AstName::Part { text: s, tail: t } => { bytesWritten = "NamePart".print() + printName(s) + printInt(t); }, }; },
        AstNode::Type { value: v } => { bytesWritten = "Type".print() + printType(v); },
        AstNode::Size { value: v } => { bytesWritten = "Size".print() + printSize(v); },
        AstNode::Value { value: v } => {
            match v {
                AstValue::VInt { n: n } => { bytesWritten = "VInt".print() + printInt(n); },
                AstValue::VList { xs: xs } => { bytesWritten = "VList".print() + printInt(xs); },
                AstValue::VBool { b: b } => { bytesWritten = "VBool".print() + printBool(b); },
                AstValue::VData { n: n, xs: xs } => { bytesWritten = "VData".print() + printInt(n) + printInt(xs); },
                AstValue::VFnRef { n: n } => { bytesWritten = "VFnRef".print() + printInt(n); },
                AstValue::VFunct { ps: ps, ins: ins, outs: outs, body: body, exports: exports } => { bytesWritten = "VFunct".print() + printInt(ps) + printInt(ins) + printInt(outs) + printInt(body) + printInt(exports); },
            };
        },
        AstNode::Body { value: v } => {
            match v {
                AstBody::NativeFunct { sig: sig, term: term, stmts: stmts } => { bytesWritten = "NativeFunct".print() + printInt(sig) + printInt(term) + printInt(stmts); },
                AstBody::BuiltinFunct { b: b } => { bytesWritten = "BuiltinFunct".print() + printInt(b); },
            };
        },
        AstNode::Expression { value: v } => {
            match v {
                AstExpression::Val { v: v } => { bytesWritten = "Val".print() + printInt(v); },
                AstExpression::Var { n: n } => { bytesWritten = "Var".print() + printInt(n); },
                AstExpression::F { f: f, xs: xs } => { bytesWritten = "F".print() + printInt(f) + printInt(xs); },
            };
        },
        AstNode::Termination { value: v } => {
            match v {
                AstTermination::Shrinks { e: e } => { bytesWritten = "Shrinks".print() + printInt(e); },
                AstTermination::Counting { e: e } => { bytesWritten = "Counting".print() + printInt(e); },
                AstTermination::Parts { e: e } => { bytesWritten = "Parts".print() + printInt(e); },
                AstTermination::MayDiverge => { bytesWritten = "MayDiverge".print(); },
                AstTermination::Recursing { t: t } => { bytesWritten = "Recursing".print() + printInt(t); },
            };
        },
        AstNode::Validation { value: v } => {
            match v {
                AstValidation::Rewrite { r: r } => { bytesWritten = "Rewrite".print() + printInt(r); },
                AstValidation::ProofAssert { p: p } => { bytesWritten = "ProofAssert".print() + printInt(p); },
                AstValidation::AssignProofVar { n: n, e: e } => { bytesWritten = "AssignProofVar".print() + printInt(n) + printInt(e); },
                AstValidation::Assume { p: p } => { bytesWritten = "Assume".print() + printInt(p); },
            };
        },
        AstNode::Proof { value: v } => {
            match v {
                AstProof::FApp { f: f, xs: xs } => { bytesWritten = "FApp".print() + printInt(f) + printInt(xs); },
                AstProof::ATerm { n: n } => { bytesWritten = "ATerm".print() + printInt(n); },
                AstProof::CTerm { v: v } => { bytesWritten = "CTerm".print() + printInt(v); },
                AstProof::Forall { n: n, gs: gs, b: b } => { bytesWritten = "Forall".print() + printInt(n) + printInt(gs) + printInt(b); },
                AstProof::BVar { n: n } => { bytesWritten = "BVar".print() + printInt(n); },
            };
        },
        AstNode::Rule { value: v } => {
            match v {
                AstRule::Refl { p: p } => { bytesWritten = "Refl".print() + printInt(p); },
                AstRule::Eval { n: n } => { bytesWritten = "Eval".print() + printInt(n); },
                AstRule::EvalAll => { bytesWritten = "EvalAll".print(); },
                AstRule::CheckGtZero { p: p } => { bytesWritten = "CheckGtZero".print() + printInt(p); },
                AstRule::CheckRel { p: p } => { bytesWritten = "CheckRel".print() + printInt(p); },
                AstRule::UserRewrite { n: n, xs: xs } => { bytesWritten = "UserRewrite".print() + printInt(n) + printInt(xs); },
            };
        },
        AstNode::Statement { value: v } => {
            match v {
                AstStatement::Assign { n: n, e: e } => { bytesWritten = "Assign".print() + printInt(n) + printInt(e); },
                AstStatement::AssignDeref { a: a, b: b } => { bytesWritten = "AssignDeref".print() + printInt(a) + printInt(b); },
                AstStatement::Let { n: n, e: e } => { bytesWritten = "Let".print() + printInt(n) + printInt(e); },
                AstStatement::Return { e: e } => { bytesWritten = "Return".print() + printInt(e); },
                AstStatement::ValidationStatement { v: v } => { bytesWritten = "ValidationStatement".print() + printInt(v); },
                AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: vs } => { bytesWritten = "StructDef".print() + printInt(n) + printInt(ps) + printInt(fs) + printInt(vs); },
                AstStatement::EnumDef { n: n, vs: vs } => { bytesWritten = "EnumDef".print() + printInt(n) + printInt(vs); },
                AstStatement::AxiomDef { n: n, ps: ps, ins: ins, outs: outs } => { bytesWritten = "AxiomDef".print() + printInt(n) + printInt(ps) + printInt(ins) + printInt(outs); },
                AstStatement::ProofDef { n: n, ps: ps, ins: ins, outs: outs, body: body } => { bytesWritten = "ProofDef".print() + printInt(n) + printInt(ps) + printInt(ins) + printInt(outs) + printInt(body); },
                AstStatement::Block { xs: xs } => { bytesWritten = "Block".print() + printInt(xs); },
                AstStatement::If { e: e, a: a, b: b } => { bytesWritten = "If".print() + printInt(e) + printInt(a) + printInt(b); },
                AstStatement::While { e: e, vs: vs, t: t, xs: xs } => { bytesWritten = "While".print() + printInt(e) + printInt(vs) + printInt(t) + printInt(xs); },
                AstStatement::TraitDef { n: n, ps: ps, fs: fs } => { bytesWritten = "TraitDef".print() + printInt(n) + printInt(ps) + printInt(fs); },
                AstStatement::ImplDef { traitName: traitName, args: args, n: n, ty: ty, bs: bs, xs: xs } => { bytesWritten = "ImplDef".print() + printInt(traitName) + printInt(args) + printInt(n) + printInt(ty) + printInt(bs) + printInt(xs); },
                AstStatement::BoundedDef { bs: bs, s: s } => { bytesWritten = "BoundedDef".print() + printInt(bs) + printInt(s); },
                AstStatement::Mark { line: line, col: col } => { bytesWritten = "Mark".print() + printInt(line) + printInt(col); },
                AstStatement::CopyDef { n: n } => { bytesWritten = "CopyDef".print() + printInt(n); },
                AstStatement::LinearDef { n: n } => { bytesWritten = "LinearDef".print() + printInt(n); },
                AstStatement::ExternDef { n: n } => { bytesWritten = "ExternDef".print() + printInt(n); },
                AstStatement::DropDef { n: n } => { bytesWritten = "DropDef".print() + printInt(n); },
                AstStatement::Dissolve { n: n } => { bytesWritten = "Dissolve".print() + printInt(n); },
            };
        },
        AstNode::Signature { value: v } => { bytesWritten = "Signature".print() + printInt(v.ts) + printInt(v.ret) + printInt(v.ss) + printInt(v.ps) + printInt(v.ws) + printInt(v.fs); },
        AstNode::TraitFn { value: v } => { bytesWritten = "TraitFn".print() + printInt(v.n) + printInt(v.ps) + printInt(v.sig) + printInt(v.ins) + printInt(v.outs); },
        AstNode::Bound { value: v } => { bytesWritten = "Bound".print() + printInt(v.p) + printInt(v.n) + printInt(v.ts); },
        AstNode::Field { value: v } => { bytesWritten = "Field".print() + printInt(v.n) + printInt(v.ty); },
        AstNode::Variant { value: v } => { bytesWritten = "Variant".print() + printInt(v.n) + printInt(v.fs); },
        AstNode::ValueField { value: v } => { bytesWritten = "ValueField".print() + printInt(v.n) + printInt(v.v); },
        AstNode::Arg { value: v } => {
            match v {
                AstArg::ArgSize { s: s } => { bytesWritten = "ArgSize".print() + printInt(s); },
                AstArg::ArgType { t: t } => { bytesWritten = "ArgType".print() + printInt(t); },
            };
        },
        AstNode::OptName { value: v } => {
            match v {
                AstOptName::NoName => { bytesWritten = "NoName".print(); },
                AstOptName::SomeName { n: n } => { bytesWritten = "SomeName".print() + printInt(n); },
            };
        },
        AstNode::OptTermination { value: v } => {
            match v {
                AstOptTermination::NoTermination => { bytesWritten = "NoTermination".print(); },
                AstOptTermination::SomeTermination { t: t } => { bytesWritten = "SomeTermination".print() + printInt(t); },
            };
        },
        AstNode::Builtin { value: v } => {
            match v {
                AstBuiltin::Ctor { n: n, args: args, fs: fs } => { bytesWritten = "Ctor".print() + printInt(n) + printInt(args) + printInt(fs); },
                AstBuiltin::FieldBuiltin { owner: owner, n: n } => { bytesWritten = "FieldBuiltin".print() + printInt(owner) + printInt(n); },
                AstBuiltin::Is { n: n } => { bytesWritten = "Is".print() + printInt(n); },
                AstBuiltin::Project { n: n, f: f } => { bytesWritten = "Project".print() + printInt(n) + printInt(f); },
                AstBuiltin::Cast { n: n } => { bytesWritten = "Cast".print() + printInt(n); },
                AstBuiltin::ToWord { signed: signed, bits: bits } => { bytesWritten = "ToWord".print() + printBool(signed) + printInt(bits); },
                AstBuiltin::Rel { r: r } => { bytesWritten = "Rel".print() + printWord(wordOf(relationWords(), r)); },
                AstBuiltin::Primitive { name: s } => { bytesWritten = "Primitive".print() + printName(s); },
            };
        },
        AstNode::Names { value: v } => { match v { AstNames::End => { bytesWritten = "NamesEnd".print(); }, AstNames::Cons { head: h, tail: t } => { bytesWritten = "NamesCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Values { value: v } => { match v { AstValues::End => { bytesWritten = "ValuesEnd".print(); }, AstValues::Cons { head: h, tail: t } => { bytesWritten = "ValuesCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Statements { value: v } => { match v { AstStatements::End => { bytesWritten = "StatementsEnd".print(); }, AstStatements::Cons { head: h, tail: t } => { bytesWritten = "StatementsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Expressions { value: v } => { match v { AstExpressions::End => { bytesWritten = "ExpressionsEnd".print(); }, AstExpressions::Cons { head: h, tail: t } => { bytesWritten = "ExpressionsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Validations { value: v } => { match v { AstValidations::End => { bytesWritten = "ValidationsEnd".print(); }, AstValidations::Cons { head: h, tail: t } => { bytesWritten = "ValidationsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Proofs { value: v } => { match v { AstProofs::End => { bytesWritten = "ProofsEnd".print(); }, AstProofs::Cons { head: h, tail: t } => { bytesWritten = "ProofsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Fields { value: v } => { match v { AstFields::End => { bytesWritten = "FieldsEnd".print(); }, AstFields::Cons { head: h, tail: t } => { bytesWritten = "FieldsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Variants { value: v } => { match v { AstVariants::End => { bytesWritten = "VariantsEnd".print(); }, AstVariants::Cons { head: h, tail: t } => { bytesWritten = "VariantsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::ValueFields { value: v } => { match v { AstValueFields::End => { bytesWritten = "ValueFieldsEnd".print(); }, AstValueFields::Cons { head: h, tail: t } => { bytesWritten = "ValueFieldsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Types { value: v } => { match v { AstTypes::End => { bytesWritten = "TypesEnd".print(); }, AstTypes::Cons { head: h, tail: t } => { bytesWritten = "TypesCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Args { value: v } => { match v { AstArgs::End => { bytesWritten = "ArgsEnd".print(); }, AstArgs::Cons { head: h, tail: t } => { bytesWritten = "ArgsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::TraitFns { value: v } => { match v { AstTraitFns::End => { bytesWritten = "TraitFnsEnd".print(); }, AstTraitFns::Cons { head: h, tail: t } => { bytesWritten = "TraitFnsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Bounds { value: v } => { match v { AstBounds::End => { bytesWritten = "BoundsEnd".print(); }, AstBounds::Cons { head: h, tail: t } => { bytesWritten = "BoundsCons".print() + printInt(h) + printInt(t); }, }; },
        AstNode::Elaborated { value: v } => { bytesWritten = "Elaborated".print() + printInt(v.statements) + printInt(v.types); },
    };
    return bytesWritten + newLine();
};

fn printBool(b: Bool) -> Int [{ }] [{ }] { if b { return " true".print(); }; return " false".print(); };

fn printAst(p: &AstProgram) -> Int ~ {
    n = "tersus-ast 1".print();
    if p.elaborated { n = n + " elaborated".print(); } else { n = n + " parsed".print(); };
    n = n + newLine();
    for node in p.nodes { n = n + printNode(node); };
    return n + "root".print() + printInt(p.root) + newLine();
};


fn catStrings(a: &String, b: &String) -> String [{ }] [{ }] {
    out = clone(a);
    for i in 0..size(b.bytes) {
        out = push(out, get(b.bytes, i));
    };
    return out;
};


fn hexValue(c: Int) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return <= 15; }] {
    if c >= 48 && c <= 57 { return c - 48; };
    if c >= 65 && c <= 70 { return c - 55; };
    return 0 - 1;
};


// ---- parser state ----

struct CtorInfo { name: String, fields: List<String> };
impl Clone for CtorInfo { };
struct FieldInfo { name: String, ty: Type };
impl Clone for FieldInfo { };
struct FieldsInfo { name: String, fields: List<FieldInfo> };
impl Clone for FieldsInfo { };
struct TypeInfo { name: String, variants: List<String> };
impl Clone for TypeInfo { };
struct GenInfo { name: String, params: List<String> };
impl Clone for GenInfo { };
struct ArgV { isSize: Bool, size: Size, ty: Type };
impl Clone for ArgV { };

struct St {
    src: String, pos: Int, nodes: List<AstNode>,
    ctors: List<CtorInfo>, fieldsOf: List<FieldsInfo>, types: List<TypeInfo>, generics: List<GenInfo>,
    selfName: String, hasSelf: Bool, selfTy: Type, hasSelfTy: Bool,
    typeParams: List<String>, implParams: List<String>, ownClone: Bool, locate: Bool,
    err: String, errPos: Int, genLine: Int, genCol: Int
};
impl Clone for St { };

struct Res<T> { st: St, v: T, ok: Bool };
impl<T> Clone for Res<T> { };
struct LitOut { name: String, ctorArgs: List<ArgV>, declared: List<String>, isVariant: Bool };
impl Clone for LitOut { };
struct Arm { name: String, fields: List<String>, vars: List<String>, body: List<Int> };
struct IdPair { a: Int, b: Int };
impl Clone for IdPair { };
impl Clone for Arm { };
struct MatchHead { scrutinee: Int };
impl Clone for MatchHead { };
struct HeaderOut { names: List<String>, types: List<Type>, ret: Type, ins: List<Int>, outs: List<Int>, writes: List<String>, froms: List<String> };
impl Clone for HeaderOut { };
struct ParamOut { names: List<String>, types: List<Type> };
impl Clone for ParamOut { };
struct OneParam { name: String, ty: Type };
impl Clone for OneParam { };
struct GenParam { name: String, boundTraits: List<String>, boundArgs: List<List<Type>> };
impl Clone for GenParam { };
struct FieldOut { name: String, ty: Type };
impl Clone for FieldOut { };


fn newSt(src: &String) -> St ~ {
    return St { src: clone(src), pos: 0, nodes: [], ctors: [], fieldsOf: [], types: [], generics: [],
        selfName: "", hasSelf: false, selfTy: Type::TInt, hasSelfTy: false,
        typeParams: [], implParams: [], ownClone: false, locate: false, err: "", errPos: 0, genLine: 0, genCol: 0 };
};

fn fail<T>(st: St, v: T, msg: &String) -> Res<T> ~ {
    s = st;
    if size(s.err.bytes) = 0 { s = St { err: clone(msg), ..s }; s = St { errPos: s.pos, ..s }; };
    return Res<T> { st: s, v: v, ok: false };
};

fn ok<T>(st: St, v: T) -> Res<T> ~ {
    return Res<T> { st: st, v: v, ok: true };
};

fn nameAtOr(xs: &List<String>, i: Int, fallback: &String) -> String ~ {
    if i < 0 || i >= size(xs) { return clone(fallback); };
    return clone(get(xs, i));
};

fn armAt(arms: &List<Arm>, i: Int) -> Arm ~ {
    if i < 0 || i >= size(arms) { return Arm { name: "", fields: [], vars: [], body: [] }; };
    return clone(get(arms, i));
};

fn intAtOr(xs: &List<Int>, i: Int, fallback: Int) -> Int ~ {
    if i < 0 || i >= size(xs) { return fallback; };
    return get(xs, i);
};

fn typeAtOr(xs: &List<Type>, i: Int) -> Type ~ {
    if i < 0 || i >= size(xs) { return Type::TInt; };
    return clone(get(xs, i));
};

fn typesAtOr(xs: &List<List<Type>>, i: Int) -> List<Type> ~ {
    if i < 0 || i >= size(xs) { return []; };
    return clone(get(xs, i));
};

fn nodeAtList(xs: &List<AstNode>, i: Int) -> AstNode ~ {
    if i < 0 || i >= size(xs) { return AstNode::Name { value: AstName::End }; };
    return clone(get(xs, i));
};

fn nodeAt(st: &St, id: Int) -> AstNode ~ {
    if id < 0 || id >= size(st.nodes) { return AstNode::Name { value: AstName::End }; };
    return nodeAtList(st.nodes, id);
};

fn setNodeAt(st: St, id: Int, node: AstNode) -> St ~ {
    if id < 0 || id >= size(st.nodes) { return st; };
    return St { nodes: set(st.nodes, id, node), ..st };
};

fn setIntAt(xs: &List<Int>, id: Int, v: Int) -> List<Int> ~ {
    if id < 0 || id >= size(xs) { return clone(xs); };
    return set(clone(xs), id, v);
};

fn emit(st: St, node: AstNode) -> Res<Int> ~ {
    s = st;
    id = size(s.nodes);
    s = St { nodes: push(s.nodes, node), ..s };
    return ok(s, id);
};

// ---- character helpers (source is UTF-8 bytes; a character is a code point) ----

fn srcSlice(st: &St, from: Int, to: Int) -> String ~ {
    if from < 0 || to < from || to > size(st.src.bytes) { return ""; };
    return st.src.slice(from, to);
};

fn strSlice(text: &String, from: Int, to: Int) -> String ~ {
    if from < 0 || to < from || to > size(text.bytes) { return ""; };
    return text.slice(from, to);
};

fn byteAt(st: &St, i: Int) -> Int ~ {
    if i < 0 || i >= size(st.src.bytes) { return 0 - 1; };
    return toInt(get(st.src.bytes, i));
};

fn decodeAt(st: &St, i: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; affirm get(return, 0) >= 0 - 1; affirm get(return, 1) >= 0; affirm get(return, 1) <= 4; }] ~ {
    // [code point, byte length]; an invalid byte is its own value with length 1
    c = byteAt(st, i);
    if c < 0 { return push(push([], 0 - 1), 0); };
    if c < 128 { return push(push([], c), 1); };
    if c >= 194 && c <= 223 {
        b = byteAt(st, i + 1);
        if b >= 128 && b <= 191 { return push(push([], (c - 192) * 64 + b - 128), 2); };
        return push(push([], c), 1);
    };
    if c >= 224 && c <= 239 {
        b = byteAt(st, i + 1);
        d = byteAt(st, i + 2);
        if b >= 128 && b <= 191 && d >= 128 && d <= 191 { return push(push([], (c - 224) * 4096 + (b - 128) * 64 + d - 128), 3); };
        return push(push([], c), 1);
    };
    if c >= 240 && c <= 244 {
        b = byteAt(st, i + 1);
        d = byteAt(st, i + 2);
        e = byteAt(st, i + 3);
        if b >= 128 && b <= 191 && d >= 128 && d <= 191 && e >= 128 && e <= 191 { return push(push([], (c - 240) * 262144 + (b - 128) * 4096 + (d - 128) * 64 + e - 128), 4); };
        return push(push([], c), 1);
    };
    return push(push([], c), 1);
};

fn decodeStrAt(name: &String, i: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; affirm get(return, 1) >= 0; affirm get(return, 1) <= 4; }] ~ {
    // [code point, byte length] in a String's bytes; an invalid byte is its own value with length 1
    if i < 0 || i >= size(name.bytes) { return push(push([], 0 - 1), 0); };
    c = toInt(get(name.bytes, i));
    if c < 128 { return push(push([], c), 1); };
    if c >= 194 && c <= 223 {
        if i + 1 < size(name.bytes) {
            b = toInt(get(name.bytes, i + 1));
            if b >= 128 && b <= 191 { return push(push([], (c - 192) * 64 + b - 128), 2); };
        };
        return push(push([], c), 1);
    };
    if c >= 224 && c <= 239 {
        if i + 2 < size(name.bytes) {
            b = toInt(get(name.bytes, i + 1));
            d = toInt(get(name.bytes, i + 2));
            if b >= 128 && b <= 191 && d >= 128 && d <= 191 { return push(push([], (c - 224) * 4096 + (b - 128) * 64 + d - 128), 3); };
        };
        return push(push([], c), 1);
    };
    if c >= 240 && c <= 244 {
        if i + 3 < size(name.bytes) {
            b = toInt(get(name.bytes, i + 1));
            d = toInt(get(name.bytes, i + 2));
            e = toInt(get(name.bytes, i + 3));
            if b >= 128 && b <= 191 && d >= 128 && d <= 191 && e >= 128 && e <= 191 { return push(push([], (c - 240) * 262144 + (b - 128) * 4096 + (d - 128) * 64 + e - 128), 4); };
        };
        return push(push([], c), 1);
    };
    return push(push([], c), 1);
};

fn isLetterCp(cp: Int) -> Bool ~ {
    if cp >= 128 { return true; };
    return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122);
};

fn isDigitCp(cp: Int) -> Bool ~ { return cp >= 48 && cp <= 57; };

fn isIdentCp(cp: Int) -> Bool ~ { return isLetterCp(cp) || isDigitCp(cp); };

fn isUpperCp(cp: Int) -> Bool ~ {
    if cp >= 65 && cp <= 90 { return true; };
    if cp >= 128 { d = decodeUpper(cp); return d; };
    return false;
};

fn decodeUpper(cp: Int) -> Bool ~ {
    // code points at or beyond 128 that are not lowercase letters or digits are taken as type names only when uppercase ASCII-like; the corpus uses ASCII type names
    return false;
};

fn isTypeParamName(name: &String) -> Bool ~ {
    if size(name.bytes) = 0 { return false; };
    c = toInt(get(name.bytes, 0));
    return c >= 65 && c <= 90;
};

fn lineCol(src: &String, pos: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; }] ~ {
    line = 1;
    col = 1;
    i = 0;
    while i < pos && i < size(src.bytes) [{ affirm i >= 0; affirm i <= size(src.bytes) + 4; }] ~ {
        c = toInt(get(src.bytes, i));
        if c = 10 { line = line + 1; col = 1; i = i + 1; }
        else {
            if c = 9 { col = col + 8 - (col - 1) % 8; i = i + 1; }
            else {
                d = decodeAt(St { src: clone(src), pos: 0, nodes: [], ctors: [], fieldsOf: [], types: [], generics: [], selfName: "", hasSelf: false, selfTy: Type::TInt, hasSelfTy: false, typeParams: [], implParams: [], ownClone: false, locate: false, err: "", errPos: 0, genLine: 0, genCol: 0 }, i);
                col = col + 1;
                i = i + get(d, 1);
            };
        };
    };
    return push(push([], line), col);
};

fn srcLineCol(st: &St, pos: Int) -> List<Int> [{ }] [{ affirm size(return) = 2; }] ~ {
    lc = lineCol(st.src, pos);
    if st.genCol > 0 { return push(push([], st.genLine), st.genCol + get(lc, 1) - 1); };
    return lc;
};

fn skipWs(st: St) -> St ~ {
    s = st;
    loop = true;
    while loop ~ {
        c = byteAt(s, s.pos);
        if c = 32 || c = 13 || c = 10 || c = 9 { s = St { pos: s.pos + 1, ..s }; }
        else {
            if c = 47 && byteAt(s, s.pos + 1) = 47 {
                s = St { pos: s.pos + 2, ..s };
                while s.pos < size(s.src.bytes) && byteAt(s, s.pos) != 10 ~ { s = St { pos: s.pos + 1, ..s }; };
            } else { loop = false; };
        };
    };
    return s;
};

fn atEnd(st: &St) -> Bool ~ { return st.pos >= size(st.src.bytes); };

fn peekIs(st: &St, text: &String) -> Bool ~ {
    if st.pos + size(text.bytes) > size(st.src.bytes) { return false; };
    i = 0;
    while i < size(text.bytes) [{ affirm i >= 0; affirm i <= size(text.bytes); }] ~ {
        if byteAt(st, st.pos + i) != toInt(get(text.bytes, i)) { return false; };
        i = i + 1;
    };
    return true;
};

fn eat(st: St, text: &String) -> Res<Bool> ~ {
    if peekIs(st, text) { s = st; s = St { pos: s.pos + size(text.bytes), ..s }; return ok(s, true); };
    return ok(st, false);
};

fn keywordAt(st: &St, kw: &String) -> Bool ~ {
    if !peekIs(st, kw) { return false; };
    after = st.pos + size(kw.bytes);
    if after >= size(st.src.bytes) { return true; };
    d = decodeAt(st, after);
    return !isIdentCp(get(d, 0));
};

fn eatKeyword(st: St, kw: &String) -> Res<Bool> ~ {
    if keywordAt(st, kw) { s = st; s = St { pos: s.pos + size(kw.bytes), ..s }; return ok(s, true); };
    return ok(st, false);
};

fn expectText(st: St, text: &String, what: &String) -> Res<Bool> ~ {
    r = eat(st, text);
    if r.v { return r; };
    return fail(r.st, false, catStrings("expected ", clone(what)));
};

fn parseVariable(st: St) -> Res<String> ~ {
    d = decodeAt(st, st.pos);
    cp = get(d, 0);
    if cp < 0 || !isLetterCp(cp) { return fail(st, "", "expected a name"); };
    s = st;
    start = s.pos;
    s = St { pos: s.pos + get(d, 1), ..s };
    loop = true;
    while loop ~ {
        d2 = decodeAt(s, s.pos);
        cp2 = get(d2, 0);
        if cp2 >= 0 && isIdentCp(cp2) { s = St { pos: s.pos + get(d2, 1), ..s }; } else { loop = false; };
    };
    return ok(s, srcSlice(s, start, s.pos));
};

fn containsName(xs: &List<String>, x: &String) -> Bool ~ {
    for v in xs { if v = x { return true; }; };
    return false;
};

fn indexOfName(xs: &List<String>, x: &String) -> Int [{ }] [{ affirm return < size(xs); affirm return >= 0 - 1; }] ~ {
    i = 0;
    for v in xs { if v = x { return i; }; i = i + 1; };
    return 0 - 1;
};

fn reversedStrings(xs: &List<String>) -> List<String> ~ {
    out = [];
    i = size(xs) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(xs); }] ~ { out = push(out, clone(get(xs, i))); i = i - 1; };
    return out;
};

fn reversedInts(xs: &List<Int>) -> List<Int> ~ {
    out = [];
    i = size(xs) - 1;
    while i >= 0 [{ affirm i + 1 >= 0; affirm i + 1 <= size(xs); }] ~ { out = push(out, get(xs, i)); i = i - 1; };
    return out;
};

fn cat3(a: &String, b: &String, c: &String) -> String ~ { return catStrings(catStrings(a, b), c); };

// ---- arena builders, in AstData's emission order ----

fn putName(st: St, name: &String) -> Res<Int> ~ {
    // split at '.' boundaries into chunks of at most 512 name characters, as Haskell's AstData name encoding does
    chunks = [];
    start = 0;
    count = 0;
    i = 0;
    while i < size(name.bytes) ~ {
        d = decodeStrAt(name, i);
        len = get(d, 1);
        if len <= 0 { len = 1; };
        if count = 512 { chunks = push(chunks, strSlice(name, start, i)); start = i; count = 0; };
        count = count + 1;
        i = i + len;
    };
    chunks = push(chunks, strSlice(name, start, size(name.bytes)));
    if size(name.bytes) = 0 { chunks = []; };
    r = emit(st, AstNode::Name { value: AstName::End });
    return putNameGo(r.st, reversedStrings(chunks), 0, r.v);
};

fn putNameGo(st: St, rev: &List<String>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    r2 = emit(st, AstNode::Name { value: AstName::Part { text: clone(get(rev, i)), tail: tail } });
    return putNameGo(r2.st, rev, i + 1, r2.v);
};
fn putTypeNode(st: St, t: Type) -> Res<Int> ~ { return emit(st, AstNode::Type { value: t }); };

fn putSizeNode(st: St, s: Size) -> Res<Int> ~ { return emit(st, AstNode::Size { value: s }); };

fn namesList(st: St, xs: &List<String>) -> Res<Int> ~ {
    r = emit(st, AstNode::Names { value: AstNames::End });
    return namesListGo(r.st, reversedStrings(xs), 0, r.v);
};

fn namesListGo(st: St, rev: &List<String>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    h = putName(st, get(rev, i));
    if !h.ok { return Res<Int> { st: h.st, v: 0, ok: false }; };
    e = emit(h.st, AstNode::Names { value: AstNames::Cons { head: h.v, tail: tail } });
    return namesListGo(e.st, rev, i + 1, e.v);
};

fn intsListNode(st: St, xs: &List<Int>, kind: Int) -> Res<Int> ~ {
    // kinds: 23 Values, 24 Statements, 25 Expressions, 26 Validations, 27 Proofs, 28 Fields, 29 Variants, 30 ValueFields, 31 Types, 32 Args, 33 TraitFns, 34 Bounds (head nodes already emitted)
    return ok(st, 0 - 1);
};

fn statementsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Statements { value: AstStatements::End });
    return statementsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn statementsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Statements { value: AstStatements::Cons { head: get(rev, i), tail: tail } });
    return statementsListGo(e.st, rev, i + 1, e.v);
};

fn expressionsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Expressions { value: AstExpressions::End });
    return expressionsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn expressionsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Expressions { value: AstExpressions::Cons { head: get(rev, i), tail: tail } });
    return expressionsListGo(e.st, rev, i + 1, e.v);
};

fn validationsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Validations { value: AstValidations::End });
    return validationsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn validationsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Validations { value: AstValidations::Cons { head: get(rev, i), tail: tail } });
    return validationsListGo(e.st, rev, i + 1, e.v);
};

fn proofsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Proofs { value: AstProofs::End });
    return proofsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn proofsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Proofs { value: AstProofs::Cons { head: get(rev, i), tail: tail } });
    return proofsListGo(e.st, rev, i + 1, e.v);
};

fn valuesList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Values { value: AstValues::End });
    return valuesListGo(r.st, reversedInts(xs), 0, r.v);
};

fn valuesListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Values { value: AstValues::Cons { head: get(rev, i), tail: tail } });
    return valuesListGo(e.st, rev, i + 1, e.v);
};

fn typesList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Types { value: AstTypes::End });
    return typesListGo(r.st, reversedInts(xs), 0, r.v);
};

fn typesListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Types { value: AstTypes::Cons { head: get(rev, i), tail: tail } });
    return typesListGo(e.st, rev, i + 1, e.v);
};

fn argsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Args { value: AstArgs::End });
    return argsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn argsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Args { value: AstArgs::Cons { head: get(rev, i), tail: tail } });
    return argsListGo(e.st, rev, i + 1, e.v);
};

fn boundsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Bounds { value: AstBounds::End });
    return boundsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn boundsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Bounds { value: AstBounds::Cons { head: get(rev, i), tail: tail } });
    return boundsListGo(e.st, rev, i + 1, e.v);
};

fn traitFnsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::TraitFns { value: AstTraitFns::End });
    return traitFnsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn traitFnsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::TraitFns { value: AstTraitFns::Cons { head: get(rev, i), tail: tail } });
    return traitFnsListGo(e.st, rev, i + 1, e.v);
};

fn fieldsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Fields { value: AstFields::End });
    return fieldsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn fieldsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Fields { value: AstFields::Cons { head: get(rev, i), tail: tail } });
    return fieldsListGo(e.st, rev, i + 1, e.v);
};

fn variantsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::Variants { value: AstVariants::End });
    return variantsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn variantsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::Variants { value: AstVariants::Cons { head: get(rev, i), tail: tail } });
    return variantsListGo(e.st, rev, i + 1, e.v);
};

fn valueFieldsList(st: St, xs: &List<Int>) -> Res<Int> ~ {
    r = emit(st, AstNode::ValueFields { value: AstValueFields::End });
    return valueFieldsListGo(r.st, reversedInts(xs), 0, r.v);
};

fn valueFieldsListGo(st: St, rev: &List<Int>, i: Int, tail: Int) -> Res<Int> [{ affirm i >= 0; }] [{ }] ~ {
    if i >= size(rev) { return ok(st, tail); };
    e = emit(st, AstNode::ValueFields { value: AstValueFields::Cons { head: get(rev, i), tail: tail } });
    return valueFieldsListGo(e.st, rev, i + 1, e.v);
};

fn putArgNode(st: St, a: ArgV) -> Res<Int> ~ {
    if a.isSize {
        s = putSizeNode(st, a.size);
        if !s.ok { return s; };
        return emit(s.st, AstNode::Arg { value: AstArg::ArgSize { s: s.v } });
    };
    t = putTypeNode(st, a.ty);
    if !t.ok { return t; };
    return emit(t.st, AstNode::Arg { value: AstArg::ArgType { t: t.v } });
};

fn putArgsNodes(st: St, xs: &List<ArgV>) -> Res<Int> ~ {
    ids = [];
    s = st;
    for a in xs {
        r = putArgNode(s, clone(a));
        if !r.ok { return r; };
        s = r.st;
        ids = push(ids, r.v);
    };
    return argsList(s, ids);
};

fn putTypesNodes(st: St, xs: &List<Type>) -> Res<Int> ~ {
    ids = [];
    s = st;
    for t in xs {
        r = putTypeNode(s, clone(t));
        if !r.ok { return r; };
        s = r.st;
        ids = push(ids, r.v);
    };
    return typesList(s, ids);
};

fn optNameNode(st: St, has: Bool, name: &String) -> Res<Int> ~ {
    if !has { return emit(st, AstNode::OptName { value: AstOptName::NoName }); };
    n = putName(st, name);
    if !n.ok { return n; };
    return emit(n.st, AstNode::OptName { value: AstOptName::SomeName { n: n.v } });
};

fn emptyValidations(st: St) -> Res<Int> ~ { return emit(st, AstNode::Validations { value: AstValidations::End }); };

fn emptyProofs(st: St) -> Res<Int> ~ { return emit(st, AstNode::Proofs { value: AstProofs::End }); };

// ---- builtins: primitive name -> parameter names (BuiltinRegistry.entryParams via builtinSymbol) ----

fn primParams(name: &String) -> List<String> ~ {
    if name = "Size" || name = "First" || name = "Last" || name = "Pop" { return push([], "list"); };
    if name = "Get" { return push(push([], "list"), "index"); };
    if name = "Push" { return push(push([], "list"), "x"); };
    if name = "Set" || name = "Replace" { return push(push(push([], "list"), "index"), "x"); };
    if name = "Plus" || name = "Minus" || name = "Times" || name = "Div" || name = "Mod" || name = "And" || name = "Or" || name = "Within" { return push(push([], "a"), "b"); };
    if name = "Not" { return push([], "a"); };
    if name = "NewArray" || name = "NewBoxedArray" { return push(push([], "n"), "x"); };
    if name = "ArrayFrom" || name = "ArrayFromList" || name = "BytesFrom" { return push([], "list"); };
    if name = "NewEmptyArray" || name = "ReadByte" || name = "ArgCount" || name = "FileLoad" || name = "FileStore" || name = "AddrNull" || name = "UninitEmpty" { return []; };
    if name = "WriteByte" || name = "WriteError" || name = "PathByte" || name = "StoreByte" { return push([], "b"); };
    if name = "ArgByte" { return push(push([], "i"), "j"); };
    if name = "FileByte" { return push([], "i"); };
    if name = "ToByte" { return push([], "x"); };
    if name = "FromByte" { return push([], "b"); };
    if name = "Unsize" || name = "UnBox" { return push([], "box"); };
    if name = "NewBox" || name = "CloneOf" { return push([], "value"); };
    if name = "BorrowOf" || name = "BorrowMutOf" || name = "OldOf" { return push([], "place"); };
    if name = "DerefOf" { return push([], "reference"); };
    if name = "AddrOffset" { return push(push([], "p"), "i"); };
    if name = "AddrCast" || name = "AddrToInt" { return push([], "p"); };
    if name = "AddrFromInt" || name = "AddrAlloc" { return push([], "n"); };
    if name = "AddrGet" || name = "AddrTake" || name = "AddrDropValue" { return push(push(push([], "p"), "i"), "b"); };
    if name = "AddrWrite" { return push(push(push(push([], "p"), "i"), "x"), "b"); };
    if name = "AddrDropRange" { return push(push(push(push([], "p"), "i"), "n"), "b"); };
    if name = "AddrResize" { return push(push(push([], "p"), "n"), "b"); };
    if name = "AddrFree" { return push(push([], "p"), "b"); };
    if name = "AllocPair" { return push([], "a1"); };
    if name = "TakePair" || name = "ResizePair" { return push(push(push([], "a1"), "a2"), "a3"); };
    if name = "SplitPair" { return push(push([], "a1"), "a2"); };
    if name = "BlockNew" || name = "BlockAssume" { return push(push([], "p"), "n"); };
    if name = "BlockTaken" || name = "BlockSplitLo" || name = "BlockSplitHi" { return push(push([], "b"), "i"); };
    if name = "BlockResized" { return push(push(push([], "b"), "q"), "n"); };
    if name = "BlockJoin" { return push(push([], "lo"), "hi"); };
    if name = "BlockCast" { return push([], "b"); };
    if name = "BlockBase" || name = "BlockCap" || name = "BlockFilled" || name = "BlockContents" || name = "BlockOrigin" || name = "BlockStart" || name = "BlockExtent" || name = "BlockCount" { return push([], "a1"); };
    if name = "UninitNew" { return push([], "x"); };
    if name = "UninitGet" || name = "UninitTake" || name = "UninitDiscard" || name = "UninitFilled" || name = "UninitAt" { return push([], "u"); };
    return [];
};

fn builtinValue(st: St, b: AstBuiltin, params: &List<String>) -> Res<Int> ~ {
    // VFunct params [] [] (BuiltinFunct b) []
    ps = namesList(st, params);
    if !ps.ok { return ps; };
    ins = emptyValidations(ps.st);
    outs = emptyValidations(ins.st);
    bn = emit(outs.st, AstNode::Builtin { value: b });
    body = emit(bn.st, AstNode::Body { value: AstBody::BuiltinFunct { b: bn.v } });
    ex = emptyProofs(body.st);
    return emit(ex.st, AstNode::Value { value: AstValue::VFunct { ps: ps.v, ins: ins.v, outs: outs.v, body: body.v, exports: ex.v } });
};

fn primValue(st: St, name: &String) -> Res<Int> ~ {
    return builtinValue(st, AstBuiltin::Primitive { name: clone(name) }, primParams(name));
};

fn relValue(st: St, r: Int) -> Res<Int> ~ {
    return builtinValue(st, AstBuiltin::Rel { r: r }, push(push([], "a"), "b"));
};

fn relIndexOf(op: &String) -> Int ~ {
    if op = "=" { return 0; };
    if op = "!=" { return 1; };
    if op = "<" { return 2; };
    if op = ">" { return 3; };
    if op = "<=" { return 4; };
    if op = ">=" { return 5; };
    return 0 - 1;
};

// the builtin a name in a proof stands for (BuiltinRegistry.proofBuiltinByName), as a primitive name; "" for none
fn proofPrimName(name: &String) -> String ~ {
    if name = "size" { return "Size"; };
    if name = "first" { return "First"; };
    if name = "last" { return "Last"; };
    if name = "get" { return "Get"; };
    if name = "push" { return "Push"; };
    if name = "pop" { return "Pop"; };
    if name = "set" { return "Set"; };
    if name = "array" { return "NewArray"; };
    return "";
};

// the builtin `builtin fn name` declares (BuiltinRegistry.builtinDecls): primitive name; "" for none
fn declPrimName(name: &String) -> String ~ {
    if name = "size" { return "Size"; };
    if name = "first" { return "First"; };
    if name = "last" { return "Last"; };
    if name = "get" { return "Get"; };
    if name = "push" { return "Push"; };
    if name = "pop" { return "Pop"; };
    if name = "set" { return "Set"; };
    if name = "plus" { return "Plus"; };
    if name = "minus" { return "Minus"; };
    if name = "times" { return "Times"; };
    if name = "div" { return "Div"; };
    if name = "mod" { return "Mod"; };
    if name = "array" { return "NewArray"; };
    if name = "arrayFrom" { return "ArrayFrom"; };
    if name = "arrayFromList" { return "ArrayFromList"; };
    if name = "arrayBoxed" { return "NewBoxedArray"; };
    if name = "arrayEmpty" { return "NewEmptyArray"; };
    if name = "writeByte" { return "WriteByte"; };
    if name = "writeError" { return "WriteError"; };
    if name = "readByte" { return "ReadByte"; };
    if name = "argCount" { return "ArgCount"; };
    if name = "argByte" { return "ArgByte"; };
    if name = "pathByte" { return "PathByte"; };
    if name = "fileLoad" { return "FileLoad"; };
    if name = "fileByte" { return "FileByte"; };
    if name = "storeByte" { return "StoreByte"; };
    if name = "fileStore" { return "FileStore"; };
    if name = "toByte" { return "ToByte"; };
    if name = "toInt" { return "FromByte"; };
    if name = "bytesFrom" { return "BytesFrom"; };
    if name = "unsize" { return "Unsize"; };
    if name = "boxNew" { return "NewBox"; };
    if name = "boxUnbox" { return "UnBox"; };
    if name = "cloneOf" { return "CloneOf"; };
    return "";
};

// ---- type tokens and rendered names (DataCodec.typeTokens, Types.renderTypeForName) ----

fn wordTok(w: &String) -> Token ~ { return Token { quoted: false, text: clone(w) }; };

fn nameTok(w: &String) -> Token ~ { return Token { quoted: true, text: clone(w) }; };

fn sizeTokensOf(s: Size) -> List<Token> ~ {
    return match s {
        Size::SConst { n: n } => push(push([], wordTok("c")), wordTok(String::fromInt(n))),
        Size::SAny => push([], wordTok("any")),
        Size::SParam { name: name } => push(push([], wordTok("p")), nameTok(name)),
        Size::SVar { n: n } => push(push([], wordTok("v")), wordTok(String::fromInt(n))),
    };
};

fn argTokensOf(a: ArgV) -> List<Token> ~ {
    if a.isSize { out = push([], wordTok("size")); for t in sizeTokensOf(a.size) { out = push(out, clone(t)); }; return out; };
    out = push([], wordTok("type"));
    for t in typeTokensOf(a.ty) { out = push(out, clone(t)); };
    return out;
};

fn typeTokensOf(t: Type) -> List<Token> ~ {
    out = [];
    match t {
        Type::TInt => { out = push([], wordTok("int")); },
        Type::TByte => { out = push([], wordTok("byte")); },
        Type::TBool => { out = push([], wordTok("bool")); },
        Type::TWord { signed: signed, bits: bits } => {
            w = "u32";
            if signed && bits = 8 { w = "i8"; };
            if signed && bits = 16 { w = "i16"; };
            if signed && bits = 32 { w = "i32"; };
            if !signed && bits = 16 { w = "u16"; };
            out = push([], wordTok(w));
        },
        Type::TList { elem: e } => { out = push([], wordTok("list")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TArray { elem: e, size: s } => { out = push([], wordTok("array")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; for x in sizeTokensOf(s) { out = push(out, clone(x)); }; },
        Type::TBox { inner: e } => { out = push([], wordTok("box")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TAddr { inner: e } => { out = push([], wordTok("addr")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TBlock { inner: e } => { out = push([], wordTok("block")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TUninit { inner: e } => { out = push([], wordTok("uninit")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TRef { inner: e } => { out = push([], wordTok("ref")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TMutRef { inner: e } => { out = push([], wordTok("mutref")); for x in typeTokensOf(Box::unbox(e)) { out = push(out, clone(x)); }; },
        Type::TFn { args: args, ret: r } => {
            out = push(push([], wordTok("fn")), wordTok(String::fromInt(size(args))));
            for a in args { for x in typeTokensOf(clone(a)) { out = push(out, clone(x)); }; };
            for x in typeTokensOf(Box::unbox(r)) { out = push(out, clone(x)); };
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            out = push(push(push([], wordTok("named")), nameTok(base)), wordTok(String::fromInt(argc)));
            for x in argTokens { out = push(out, clone(x)); };
        },
        Type::TVariant { name: name } => { out = push(push([], wordTok("variant")), nameTok(name)); },
        Type::TVar { n: n } => { out = push(push([], wordTok("var")), wordTok(String::fromInt(n))); },
        Type::TParam { name: name } => { out = push(push([], wordTok("param")), nameTok(name)); },
        Type::TForall { sizes: sizes, types: types, body: body } => {
            out = push(push([], wordTok("forall")), wordTok(String::fromInt(size(sizes))));
            for s in sizes { out = push(out, nameTok(s)); };
            out = push(out, wordTok(String::fromInt(size(types))));
            for s in types { out = push(out, nameTok(s)); };
            for x in typeTokensOf(Box::unbox(body)) { out = push(out, clone(x)); };
        },
    };
    return out;
};

fn renderSizeName(s: Size) -> String ~ {
    return match s {
        Size::SConst { n: n } => String::fromInt(n),
        Size::SAny => "?",
        Size::SParam { name: name } => clone(name),
        Size::SVar { n: n } => catStrings("_", String::fromInt(n)),
    };
};

fn renderTypeName(t: Type) -> String ~ {
    r = "";
    match t {
        Type::TInt => { r = "Int"; },
        Type::TByte => { r = "Byte"; },
        Type::TBool => { r = "Bool"; },
        Type::TWord { signed: signed, bits: bits } => { if signed { r = catStrings("I", String::fromInt(bits)); } else { r = catStrings("U", String::fromInt(bits)); }; },
        Type::TList { elem: e } => { r = cat3("List<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TBox { inner: e } => { r = cat3("Box<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TAddr { inner: e } => { r = cat3("Addr<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TBlock { inner: e } => { r = cat3("Block<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TUninit { inner: e } => { r = cat3("Uninit<", renderTypeName(Box::unbox(e)), ">"); },
        Type::TRef { inner: e } => { r = catStrings("&", renderTypeName(Box::unbox(e))); },
        Type::TMutRef { inner: e } => { r = catStrings("&mut ", renderTypeName(Box::unbox(e))); },
        Type::TArray { elem: e, size: s } => { r = catStrings(cat3("Array<", renderTypeName(Box::unbox(e)), ", "), catStrings(renderSizeName(s), ">")); },
        Type::TFn { args: args, ret: ret } => {
            parts = "fn(";
            i = 0;
            for a in args { if i > 0 { parts = catStrings(parts, ", "); }; parts = catStrings(parts, renderTypeName(clone(a))); i = i + 1; };
            r = cat3(catStrings(parts, ") -> "), renderTypeName(Box::unbox(ret)), "");
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => { r = clone(name); },
        Type::TVariant { name: name } => { r = clone(name); },
        Type::TVar { n: n } => { r = catStrings("?", String::fromInt(n)); },
        Type::TParam { name: name } => { r = catStrings("'", clone(name)); },
        Type::TForall { sizes: sizes, types: types, body: body } => { r = renderTypeName(Box::unbox(body)); },
    };
    return r;
};

fn renderArgName(a: ArgV) -> String ~ {
    if a.isSize { return renderSizeName(a.size); };
    return renderTypeName(a.ty);
};

fn instanceNameOf(base: &String, args: &List<ArgV>) -> String ~ {
    if size(args) = 0 { return clone(base); };
    joined = "";
    i = 0;
    for a in args { if i > 0 { joined = catStrings(joined, ", "); }; joined = catStrings(joined, renderArgName(clone(a))); i = i + 1; };
    return cat3(cat3(base, "<", joined), ">", "");
};

fn namedTypeOf(base: &String, args: &List<ArgV>) -> Type ~ {
    tokens = [];
    for a in args { for t in argTokensOf(clone(a)) { tokens = push(tokens, clone(t)); }; };
    // Haskell renderTypeForName gives a bare lowercase name a leading `; the instance name stored is that rendering
    name = instanceNameOf(base, args);
    if size(args) = 0 && isBareLower(base) { name = catStrings("`", clone(base)); };
    return Type::TNamed { name: name, base: clone(base), argc: size(args), argTokens: tokens };
};

fn isBareLower(name: &String) -> Bool ~ {
    if size(name.bytes) = 0 { return false; };
    c = toInt(get(name.bytes, 0));
    if c < 97 || c > 122 { return false; };
    for i in 0..size(name.bytes) {
        b = toInt(get(name.bytes, i));
        if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) { return false; };
    };
    return true;
};

fn baseNameOf(name: &String) -> String ~ {
    i = 0;
    while i < size(name.bytes) && get(name.bytes, i) != toByte(60) ~ { i = i + 1; };
    return strSlice(name, 0, i);
};

fn containsText(s: &String, needle: &String) -> Bool ~ {
    if size(needle.bytes) > size(s.bytes) { return false; };
    i = 0;
    while i + size(needle.bytes) <= size(s.bytes) ~ {
        same = true;
        j = 0;
        while j < size(needle.bytes) ~ { if get(s.bytes, i + j) != get(needle.bytes, j) { same = false; }; j = j + 1; };
        if same { return true; };
        i = i + 1;
    };
    return false;
};

fn splitPath(name: &String) -> List<String> ~ {
    out = [];
    start = 0;
    i = 0;
    while i + 1 < size(name.bytes) [{ affirm i >= 0; affirm start >= 0; }] ~ {
        if get(name.bytes, i) = toByte(58) && get(name.bytes, i + 1) = toByte(58) { out = push(out, strSlice(name, start, i)); i = i + 2; start = i; } else { i = i + 1; };
    };
    out = push(out, strSlice(name, start, size(name.bytes)));
    return out;
};

fn joinFrom(segs: &List<String>, i: Int) -> String [{ affirm i >= 0; }] [{ }] ~ {
    out = "";
    j = i;
    while j < size(segs) [{ affirm j >= i; }] ~ { if j > i { out = catStrings(out, "::"); }; out = catStrings(out, clone(get(segs, j))); j = j + 1; };
    return out;
};

fn isSuffixPath(short: &String, long: &String) -> Bool ~ {
    ss = splitPath(short);
    ls = splitPath(long);
    if size(ss) > size(ls) { return false; };
    off = size(ls) - size(ss);
    i = 0;
    while i < size(ss) ~ { if get(ss, i) != get(ls, off + i) { return false; }; i = i + 1; };
    return true;
};

fn samePath(a: &String, b: &String) -> Bool ~ {
    return a = b || isSuffixPath(a, b) || isSuffixPath(b, a);
};

// ---- declaration lookups ----

fn findCtor(st: &St, name: &String) -> List<String> ~ {
    for c in st.ctors { if c.name = name { return clone(c.fields); }; };
    return [];
};

fn hasCtor(st: &St, name: &String) -> Bool ~ {
    for c in st.ctors { if c.name = name { return true; }; };
    return false;
};

fn matchedCtorName(st: &St, name: &String) -> String ~ {
    segs = splitPath(name);
    i = 0;
    while i < size(segs) ~ {
        cand = joinFrom(segs, i);
        if hasCtor(st, cand) { return cand; };
        i = i + 1;
    };
    return "";
};

fn findCtorPath(st: &St, name: &String) -> List<String> ~ {
    m = matchedCtorName(st, name);
    if size(m.bytes) = 0 { return []; };
    return findCtor(st, m);
};

fn genericsForPath(st: &St, name: &String) -> List<String> ~ {
    segs = splitPath(name);
    i = 0;
    while i < size(segs) ~ {
        cand = joinFrom(segs, i);
        ps = findGenerics(st, cand);
        if size(ps) > 0 { return ps; };
        i = i + 1;
    };
    return [];
};

fn findFields(st: &St, name: &String) -> List<FieldInfo> ~ {
    for c in st.fieldsOf { if c.name = name { return clone(c.fields); }; };
    return [];
};

fn findGenerics(st: &St, name: &String) -> List<String> ~ {
    for c in st.generics { if c.name = name { return clone(c.params); }; };
    return [];
};

fn hasGenerics(st: &St, name: &String) -> Bool ~ {
    for c in st.generics { if c.name = name { return true; }; };
    return false;
};

fn findTypeVariants(st: &St, variant: &String) -> List<String> ~ {
    // [typeName, variant1, ...] for the type that has this variant; [] when unknown
    for c in st.types {
        for v in c.variants { if v = variant { out = push([], clone(c.name)); for w in c.variants { out = push(out, clone(w)); }; return out; }; };
    };
    return [];
};

fn hasTypeNamed(st: &St, name: &String) -> Bool ~ {
    for c in st.types { if c.name = name { return true; }; };
    return false;
};

fn setCtor(st: St, name: &String, fields: &List<String>) -> St ~ {
    s = st;
    out = [];
    for c in s.ctors { if c.name != name { out = push(out, clone(c)); }; };
    out = push(out, CtorInfo { name: clone(name), fields: clone(fields) });
    s = St { ctors: out, ..s };
    return s;
};

fn setFields(st: St, name: &String, fields: &List<FieldInfo>) -> St ~ {
    s = st;
    out = [];
    for c in s.fieldsOf { if c.name != name { out = push(out, clone(c)); }; };
    out = push(out, FieldsInfo { name: clone(name), fields: clone(fields) });
    s = St { fieldsOf: out, ..s };
    return s;
};

fn setTypeInfo(st: St, name: &String, variants: &List<String>) -> St ~ {
    s = st;
    out = [];
    for c in s.types { if c.name != name { out = push(out, clone(c)); }; };
    out = push(out, TypeInfo { name: clone(name), variants: clone(variants) });
    s = St { types: out, ..s };
    return s;
};

fn setGenerics(st: St, name: &String, params: &List<String>) -> St ~ {
    s = st;
    if size(params) = 0 { return s; };
    out = [];
    for c in s.generics { if c.name != name { out = push(out, clone(c)); }; };
    out = push(out, GenInfo { name: clone(name), params: clone(params) });
    s = St { generics: out, ..s };
    return s;
};

fn deleteCtor(st: St, name: &String) -> St ~ {
    s = st;
    out = [];
    for c in s.ctors { if c.name != name { out = push(out, clone(c)); }; };
    s = St { ctors: out, ..s };
    return s;
};

fn removeGenerics(st: St, name: &String) -> St ~ {
    s = st;
    out = [];
    for c in s.generics { if c.name != name { out = push(out, clone(c)); }; };
    s = St { generics: out, ..s };
    return s;
};

fn removeTypeInfo(st: St, name: &String) -> St ~ {
    s = st;
    out = [];
    for c in s.types { if c.name != name { out = push(out, clone(c)); }; };
    s = St { types: out, ..s };
    return s;
};

fn typeVariantsNamed(st: &St, name: &String) -> List<String> ~ {
    for c in st.types { if c.name = name { return clone(c.variants); }; };
    return [];
};

fn shadowCtors(st: St, name: &String) -> St ~ {
    s = deleteCtor(st, name);
    for v in typeVariantsNamed(s, name) { s = deleteCtor(s, v); };
    return s;
};

fn resolveSelfName(st: &St, name: &String) -> String ~ {
    if name = "Self" && st.hasSelf { return clone(st.selfName); };
    return clone(name);
};

fn namePathOf(st: St) -> Res<List<String>> ~ {
    v = parseVariable(st);
    if !v.ok { return Res<List<String>> { st: v.st, v: [], ok: false }; };
    first = v.v;
    s = v.st;
    return namePathRest(s, push([], first));
};

fn namePathRest(st: St, segs: List<String>) -> Res<List<String>> ~ {
    s = st;
    if !peekIs(s, "::") { return ok(s, segs); };
    s = St { pos: s.pos + 2, ..s };
    w = parseVariable(s);
    if !w.ok { return Res<List<String>> { st: w.st, v: [], ok: false }; };
    next = w.v;
    s2 = w.st;
    return namePathRest(s2, push(segs, next));
};

fn qualifiedName(st: St) -> Res<String> ~ {
    p = namePathOf(st);
    if !p.ok { return Res<String> { st: p.st, v: "", ok: false }; };
    s = p.st;
    first = "";
    out = "";
    i = 0;
    for seg in p.v {
        if i = 0 { first = clone(seg); out = baseNameOf(resolveSelfName(s, seg)); } else { out = cat3(out, "::", seg); };
        i = i + 1;
    };
    if size(p.v) = 1 { return ok(s, resolveSelfName(s, first)); };
    return ok(s, out);
};

// ---- values ----

fn digitsValue(st: St, text: &String, negative: Bool) -> Res<Int> ~ {
    // a VInt value node; the magnitude must fit Int (Parse.vint: Int is 64 bits)
    acc = 0;
    i = 0;
    n = size(text.bytes);
    if n = 0 { return fail(st, 0, "expected an integer"); };
    while i < n ~ {
        c = toInt(get(text.bytes, i));
        d = c - 48;
        if d < 0 || d > 9 { return fail(st, 0, "expected an integer"); };
        if acc < 0 - 922337203685477580 || (acc = 0 - 922337203685477580 && d > 8) { return fail(st, 0, "Integer literal out of range (Int is 64 bits)"); };
        acc = acc * 10 - d;
        i = i + 1;
    };
    value = acc;
    if !negative {
        if acc = 0 - 9223372036854775807 - 1 { return fail(st, 0, "Integer literal out of range (Int is 64 bits)"); };
        value = 0 - acc;
    };
    nm = putName(st, String::fromInt(value));
    if !nm.ok { return nm; };
    return emit(nm.st, AstNode::Value { value: AstValue::VInt { n: nm.v } });
};

fn valueNode(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if keywordAt(s, "true") { s = St { pos: s.pos + 4, ..s }; s = skipWs(s); return emit(s, AstNode::Value { value: AstValue::VBool { b: true } }); };
    if keywordAt(s, "false") { s = St { pos: s.pos + 5, ..s }; s = skipWs(s); return emit(s, AstNode::Value { value: AstValue::VBool { b: false } }); };
    c = byteAt(s, s.pos);
    if c = 91 {
        // [ value, ... ]
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        vals = [];
        if byteAt(s, s.pos) != 93 {
            loop = true;
            while loop ~ {
                v = valueNode(s);
                if !v.ok { return v; };
                s = v.st;
                vals = push(vals, v.v);
                s = skipWs(s);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
            };
        };
        s = skipWs(s);
        if byteAt(s, s.pos) != 93 { return fail(s, 0, "expected ]"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        lst = valuesList(s, vals);
        if !lst.ok { return lst; };
        return emit(lst.st, AstNode::Value { value: AstValue::VList { xs: lst.v } });
    };
    negative = false;
    if c = 45 { negative = true; s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
    start = s.pos;
    while byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
    if s.pos = start { return fail(s, 0, "expected a value"); };
    text = srcSlice(s, start, s.pos);
    s = skipWs(s);
    r = digitsValue(s, text, negative);
    return r;
};

fn utf8Encode(cp: Int) -> List<Int> ~ {
    if cp < 128 { return push([], cp); };
    if cp < 2048 { return push(push([], 192 + cp / 64), 128 + cp % 64); };
    if cp < 65536 { return push(push(push([], 224 + cp / 4096), 128 + (cp / 64) % 64), 128 + cp % 64); };
    return push(push(push(push([], 240 + cp / 262144), 128 + (cp / 4096) % 64), 128 + (cp / 64) % 64), 128 + cp % 64);
};

// the bytes of a string literal, or a failure; state is past the closing quote and whitespace
fn stringBytes(st: St) -> Res<List<Int>> ~ {
    s = st;
    if byteAt(s, s.pos) != 34 { return fail(s, [], "expected a string"); };
    s = St { pos: s.pos + 1, ..s };
    bytes = [];
    loop = true;
    while loop ~ {
        c = byteAt(s, s.pos);
        if c < 0 || c = 10 { return fail(s, [], "the end of the string"); };
        if c = 34 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            if c = 92 {
                s = St { pos: s.pos + 1, ..s };
                esc = escapeBytes(s);
                if !esc.ok { return esc; };
                s = esc.st;
                for b in esc.v { bytes = push(bytes, b); };
            } else {
                d = decodeAt(s, s.pos);
                cp = get(d, 0);
                len = get(d, 1);
                if len <= 0 { len = 1; };
                for b in utf8Encode(cp) { bytes = push(bytes, b); };
                s = St { pos: s.pos + len, ..s };
            };
        };
    };
    s = skipWs(s);
    return ok(s, bytes);
};

fn escapeBytes(st: St) -> Res<List<Int>> ~ {
    s = st;
    e = byteAt(s, s.pos);
    if e = 110 { return ok(St { pos: s.pos + 1, ..s }, push([], 10)); };
    if e = 114 { return ok(St { pos: s.pos + 1, ..s }, push([], 13)); };
    if e = 116 { return ok(St { pos: s.pos + 1, ..s }, push([], 9)); };
    if e = 48 { return ok(St { pos: s.pos + 1, ..s }, push([], 0)); };
    if e = 34 { return ok(St { pos: s.pos + 1, ..s }, push([], 34)); };
    if e = 92 { return ok(St { pos: s.pos + 1, ..s }, push([], 92)); };
    if e != 117 { return fail(s, [], "a character of the string"); };
    s = St { pos: s.pos + 1, ..s };
    if byteAt(s, s.pos) != 123 { return fail(s, [], "a \\u escape"); };
    s = St { pos: s.pos + 1, ..s };
    value = 0;
    digits = 0;
    loop = true;
    while loop ~ {
        h = hexValue(byteAt(s, s.pos));
        if h < 0 { loop = false; }
        else {
            value = value * 16 + h;
            digits = digits + 1;
            s = St { pos: s.pos + 1, ..s };
            if digits > 6 { return fail(s, [], "a \\u escape of a character that does not exist"); };
        };
    };
    if digits = 0 { return fail(s, [], "a \\u escape"); };
    if byteAt(s, s.pos) != 125 { return fail(s, [], "a \\u escape"); };
    s = St { pos: s.pos + 1, ..s };
    if value > 1114111 || (value >= 55296 && value < 57344) { return fail(s, [], "a \\u escape of a character that does not exist"); };
    return ok(s, utf8Encode(value));
};

fn stringCtorCheck(st: &St) -> Bool ~ {
    f = findCtor(st, "String");
    return size(f) = 1 && get(f, 0) = "bytes";
};

// ---- types ----

fn sizeArgument(st: St) -> Res<Size> ~ {
    s = skipWs(st);
    c = byteAt(s, s.pos);
    if c >= 48 && c <= 57 {
        start = s.pos;
        while byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
        p = parseDigitsText(s, srcSlice(s, start, s.pos));
        if !p.ok { return fail(p.st, Size::SAny, "a size that does not fit"); };
        return ok(p.st, Size::SConst { n: p.v });
    };
    if c = 63 { s = St { pos: s.pos + 1, ..s }; return ok(s, Size::SAny); };
    v = parseVariable(s);
    if !v.ok { return Res<Size> { st: v.st, v: Size::SAny, ok: false }; };
    return ok(v.st, Size::SParam { name: v.v });
};

fn parseDigitsText(st: St, text: &String) -> Res<Int> ~ {
    acc = 0;
    i = 0;
    while i < size(text.bytes) ~ {
        d = toInt(get(text.bytes, i)) - 48;
        if d < 0 || d > 9 { return fail(st, 0, "expected a number"); };
        if acc > 922337203685477580 || (acc = 922337203685477580 && d > 7) { return fail(st, 0, "a number that does not fit"); };
        acc = acc * 10 + d;
        i = i + 1;
    };
    return ok(st, acc);
};

fn noArgs() -> List<ArgV> ~ { return []; };

fn genericArguments(st: St, params: &List<String>) -> Res<List<ArgV>> ~ {
    // at '<'
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    args = noArgs();
    i = 0;
    for p in params {
        if i > 0 {
            if byteAt(s, s.pos) != 44 { return fail(s, args, "expected ,"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
        };
        if isTypeParamName(p) {
            t = typeAnnotation(s);
            if !t.ok { return Res<List<ArgV>> { st: t.st, v: noArgs(), ok: false }; };
            s = t.st;
            args = push(args, ArgV { isSize: false, size: Size::SAny, ty: t.v });
        } else {
            z = sizeArgument(s);
            if !z.ok { return Res<List<ArgV>> { st: z.st, v: noArgs(), ok: false }; };
            s = z.st;
            s = skipWs(s);
            args = push(args, ArgV { isSize: true, size: z.v, ty: Type::TInt });
        };
        i = i + 1;
    };
    s = skipWs(s);
    if byteAt(s, s.pos) != 62 { return fail(s, args, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    return ok(s, args);
};

fn tryGenericArguments(st: St, params: &List<String>) -> Res<List<ArgV>> ~ {
    save = clone(st);
    s = skipWs(st);
    if byteAt(s, s.pos) != 60 { return ok(save, noArgs()); };
    r = genericArguments(s, params);
    if !r.ok { return ok(save, noArgs()); };
    // signal "present" by a wrapper: caller distinguishes by position; here failure also means absent in Haskell (optionMaybe), but a malformed list after < is then a later failure anyway
    return r;
};

fn hasGenericArguments(st: &St, params: &List<String>) -> Bool ~ {
    s = skipWs(clone(st));
    if byteAt(s, s.pos) != 60 { return false; };
    r = genericArguments(s, params);
    return r.ok;
};

fn wordTypeOf(name: &String) -> Type ~ {
    if name = "I8" { return Type::TWord { signed: true, bits: 8 }; };
    if name = "I16" { return Type::TWord { signed: true, bits: 16 }; };
    if name = "I32" { return Type::TWord { signed: true, bits: 32 }; };
    if name = "I64" { return Type::TInt; };
    if name = "U8" { return Type::TByte; };
    if name = "U16" { return Type::TWord { signed: false, bits: 16 }; };
    if name = "U32" { return Type::TWord { signed: false, bits: 32 }; };
    return Type::TInt;
};

fn isWordTypeName(name: &String) -> Bool ~ {
    return name = "I8" || name = "I16" || name = "I32" || name = "I64" || name = "U8" || name = "U16" || name = "U32";
};

fn typeAnnotation(st: St) -> Res<Type> ~ {
    s = skipWs(st);
    r = typeInner(s);
    if !r.ok { return r; };
    return ok(skipWs(r.st), r.v);
};

fn typeInner(st: St) -> Res<Type> ~ {
    s = st;
    // borrowed
    if peekIs(s, "&mut") {
        after = s.pos + 4;
        // &mut must not be followed by an identifier character is not required by Haskell (string "&mut" then whitespace)
        s2 = s;
        s2 = St { pos: after, ..s2 };
        s2 = skipWs(s2);
        inner = namedOrFunctionType(s2);
        if inner.ok { return ok(inner.st, Type::TMutRef { inner: Box::new(inner.v) }); };
        return Res<Type> { st: inner.st, v: Type::TInt, ok: false };
    };
    if byteAt(s, s.pos) = 38 && byteAt(s, s.pos + 1) != 38 {
        s2 = s;
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(s2);
        inner = namedOrFunctionType(s2);
        if inner.ok { return ok(inner.st, Type::TRef { inner: Box::new(inner.v) }); };
        return Res<Type> { st: inner.st, v: Type::TInt, ok: false };
    };
    f = tryFunctionType(s);
    if f.ok { return f; };
    s = f.st;
    if byteAt(s, s.pos) = 40 {
        // tuple type
        s2 = s;
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(s2);
        parts = [];
        loop = true;
        while loop ~ {
            part = tuplePartType(s2);
            if !part.ok { return part; };
            s2 = part.st;
            parts = push(parts, part.v);
            s2 = skipWs(s2);
            if byteAt(s2, s2.pos) = 44 { s2 = St { pos: s2.pos + 1, ..s2 }; s2 = skipWs(s2); } else { loop = false; };
        };
        if byteAt(s2, s2.pos) != 41 { return fail(s2, Type::TInt, "expected )"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        if size(parts) < 2 { return fail(s2, Type::TInt, "a tuple type has two parts or more"); };
        args = [];
        for p in parts { args = push(args, ArgV { isSize: false, size: Size::SAny, ty: clone(p) }); };
        return ok(s2, namedTypeOf(catStrings("Tuple", String::fromInt(size(parts))), args));
    };
    return namedType(s);
};

fn tuplePartType(st: St) -> Res<Type> ~ {
    s = skipWs(st);
    ghostly = false;
    g = eatKeyword(s, "ghost");
    if g.v { ghostly = true; s = skipWs(g.st); } else { s = g.st; };
    t = typeAnnotation(s);
    if !t.ok { return t; };
    if ghostly && !ghostTypeOf(clone(t.v)) { return fail(t.st, Type::TInt, "ghost is written before a type that is a permission, Block<T>"); };
    return t;
};

fn ghostTypeOf(t: Type) -> Bool ~ {
    okGhost = false;
    match t {
        Type::TBlock { inner: e } => { okGhost = true; },
        Type::TRef { inner: e } => { okGhost = ghostTypeOf(Box::unbox(e)); },
        Type::TMutRef { inner: e } => { okGhost = false; },
        Type::TInt => { okGhost = false; },
        Type::TByte => { okGhost = false; },
        Type::TBool => { okGhost = false; },
        Type::TList { elem: e } => { okGhost = false; },
        Type::TArray { elem: e, size: s } => { okGhost = false; },
        Type::TBox { inner: e } => { okGhost = false; },
        Type::TFn { args: a, ret: r } => { okGhost = false; },
        Type::TNamed { name: n, base: b, argc: c, argTokens: ts } => { okGhost = false; },
        Type::TVariant { name: n } => { okGhost = false; },
        Type::TVar { n: n } => { okGhost = false; },
        Type::TForall { sizes: a, types: b, body: c } => { okGhost = false; },
        Type::TParam { name: n } => { okGhost = false; },
        Type::TAddr { inner: e } => { okGhost = false; },
        Type::TUninit { inner: e } => { okGhost = false; },
        Type::TWord { signed: a, bits: b } => { okGhost = false; },
    };
    return okGhost;
};

fn tryFunctionType(st: St) -> Res<Type> ~ {
    s = st;
    k = eatKeyword(s, "fn");
    if !k.v { return Res<Type> { st: k.st, v: Type::TInt, ok: false }; };
    kSt = k.st;
    s = skipWs(kSt);
    if byteAt(s, s.pos) != 40 { return Res<Type> { st: s, v: Type::TInt, ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    args = [];
    if byteAt(s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            t = typeAnnotation(s);
            if !t.ok { return t; };
            s = t.st;
            args = push(args, t.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, Type::TInt, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if !peekIs(s, "->") { return fail(s, Type::TInt, "expected ->"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(s);
    r = typeAnnotation(s);
    if !r.ok { return r; };
    return ok(r.st, Type::TFn { args: args, ret: Box::new(r.v) });
};

fn namedOrFunctionType(st: St) -> Res<Type> ~ {
    f = tryFunctionType(st);
    if f.ok { return f; };
    return namedType(f.st);
};

fn namedType(st: St) -> Res<Type> ~ {
    s = st;
    v = parseVariable(s);
    if !v.ok { return Res<Type> { st: v.st, v: Type::TInt, ok: false }; };
    raw = v.v;
    s = v.st;
    if raw = "Self" && s.hasSelfTy {
        // optional ::Variant
        if peekIs(s, "::") {
            save = clone(s);
            s = St { pos: s.pos + 2, ..s };
            w = parseVariable(s);
            if w.ok {
                s = w.st;
                selfTyCopy = clone(s.selfTy);
                match s.selfTy {
                    Type::TNamed { name: n, base: b, argc: c, argTokens: ts } => { return ok(s, Type::TVariant { name: cat3(b, "::", w.v) }); },
                    Type::TInt => { return ok(s, selfTyCopy); },
                    Type::TByte => { return ok(s, selfTyCopy); },
                    Type::TBool => { return ok(s, selfTyCopy); },
                    Type::TList { elem: e } => { return ok(s, selfTyCopy); },
                    Type::TArray { elem: e, size: z } => { return ok(s, selfTyCopy); },
                    Type::TBox { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TFn { args: a, ret: r } => { return ok(s, selfTyCopy); },
                    Type::TVariant { name: n } => { return ok(s, selfTyCopy); },
                    Type::TVar { n: n } => { return ok(s, selfTyCopy); },
                    Type::TForall { sizes: a, types: b, body: c } => { return ok(s, selfTyCopy); },
                    Type::TParam { name: n } => { return ok(s, selfTyCopy); },
                    Type::TRef { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TMutRef { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TAddr { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TBlock { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TUninit { inner: e } => { return ok(s, selfTyCopy); },
                    Type::TWord { signed: a, bits: b } => { return ok(s, selfTyCopy); },
                };
            };
            s = save;
        };
        stc = clone(s.selfTy);
        return ok(s, stc);
    };
    name = resolveSelfName(s, raw);
    s2 = s;
    // a path of several segments is a variant when it has two and a generic named type otherwise
    extraSegs = [];
    s3 = clone(s2);
    segLoop = true;
    while segLoop ~ {
        if peekIs(s3, "::") {
            saveSeg = clone(s3);
            s3 = St { pos: s3.pos + 2, ..s3 };
            w = parseVariable(s3);
            if w.ok { extraSegs = push(extraSegs, w.v); s3 = w.st; } else { s3 = saveSeg; segLoop = false; };
        } else { segLoop = false; };
    };
    if size(extraSegs) > 0 {
        full = clone(name);
        for seg in extraSegs { full = cat3(full, "::", seg); };
        pparams = genericsForPath(s3, full);
        if size(pparams) > 0 && hasGenericArguments(s3, pparams) {
            g = genericArguments(skipWs(clone(s3)), pparams);
            if g.ok { return ok(g.st, namedTypeOf(full, g.v)); };
        };
        if size(extraSegs) = 1 { return ok(s3, Type::TVariant { name: full }); };
        return ok(s3, namedTypeOf(full, []));
    };
    if containsName(s2.typeParams, name) { return ok(s2, Type::TParam { name: clone(name) }); };
    if name = "Int" { return ok(s2, Type::TInt); };
    if name = "Byte" { return ok(s2, Type::TByte); };
    if name = "Bool" { return ok(s2, Type::TBool); };
    if isWordTypeName(name) { return ok(s2, wordTypeOf(name)); };
    if name = "List" || name = "Box" || name = "Addr" || name = "Block" || name = "Uninit" {
        s2 = skipWs(s2);
        if byteAt(s2, s2.pos) != 60 { return fail(s2, Type::TInt, "expected <"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(s2);
        e = typeAnnotation(s2);
        if !e.ok { return e; };
        s2 = skipWs(e.st);
        if byteAt(s2, s2.pos) != 62 { return fail(s2, Type::TInt, "expected >"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        if name = "List" { return ok(s2, Type::TList { elem: Box::new(e.v) }); };
        if name = "Box" { return ok(s2, Type::TBox { inner: Box::new(e.v) }); };
        if name = "Addr" { return ok(s2, Type::TAddr { inner: Box::new(e.v) }); };
        if name = "Block" { return ok(s2, Type::TBlock { inner: Box::new(e.v) }); };
        return ok(s2, Type::TUninit { inner: Box::new(e.v) });
    };
    if name = "Array" {
        s2 = skipWs(s2);
        if byteAt(s2, s2.pos) != 60 { return fail(s2, Type::TInt, "expected <"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        s2 = skipWs(s2);
        e = typeAnnotation(s2);
        if !e.ok { return e; };
        s2 = e.st;
        size = Size::SAny;
        s2 = skipWs(s2);
        if byteAt(s2, s2.pos) = 44 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            z = sizeArgument(s2);
            if !z.ok { return Res<Type> { st: z.st, v: Type::TInt, ok: false }; };
            s2 = z.st;
            size = z.v;
        };
        s2 = skipWs(s2);
        if byteAt(s2, s2.pos) != 62 { return fail(s2, Type::TInt, "expected >"); };
        s2 = St { pos: s2.pos + 1, ..s2 };
        return ok(s2, Type::TArray { elem: Box::new(e.v), size: size });
    };
    // variant?
    if peekIs(s2, "::") {
        save = clone(s2);
        s2 = St { pos: s2.pos + 2, ..s2 };
        w = parseVariable(s2);
        if w.ok { return ok(w.st, Type::TVariant { name: cat3(name, "::", w.v) }); };
        s2 = save;
    };
    params = findGenerics(s2, name);
    if size(params) > 0 {
        if hasGenericArguments(s2, params) {
            g = genericArguments(skipWs(clone(s2)), params);
            if g.ok { return ok(g.st, namedTypeOf(name, g.v)); };
        };
        return ok(s2, namedTypeOf(name, []));
    };
    return ok(s2, namedTypeOf(name, []));
};

// ---- expressions ----

fn exprNode(st: St, node: AstExpression) -> Res<Int> ~ { return emit(st, AstNode::Expression { value: node }); };

fn valExpr(st: St, valueNode: Int) -> Res<Int> ~ { return exprNode(st, AstExpression::Val { v: valueNode }); };

fn builtinExpr(st: St, b: AstBuiltin, params: &List<String>, args: &List<Int>) -> Res<Int> ~ {
    bv = builtinValue(st, b, params);
    if !bv.ok { return bv; };
    ve = valExpr(bv.st, bv.v);
    if !ve.ok { return ve; };
    xs = expressionsList(ve.st, args);
    if !xs.ok { return xs; };
    return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
};

fn primExpr(st: St, name: &String, args: &List<Int>) -> Res<Int> ~ {
    return builtinExpr(st, AstBuiltin::Primitive { name: clone(name) }, primParams(name), args);
};

fn varExprNode(st: St, name: &String) -> Res<Int> ~ {
    n = putName(st, name);
    if !n.ok { return n; };
    return exprNode(n.st, AstExpression::Var { n: n.v });
};

fn expression(st: St) -> Res<Int> ~ { return exprLevel0(st); };

fn exprLevel0(st: St) -> Res<Int> ~ {
    // ||
    l = exprLevel1(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "||") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            r = exprLevel1(s2);
            if !r.ok { return r; };
            s = r.st;
            b = primExpr(s, "Or", push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn exprLevel1(st: St) -> Res<Int> ~ {
    l = exprRelations(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "&&") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            r = exprRelations(s2);
            if !r.ok { return r; };
            s = r.st;
            b = primExpr(s, "And", push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn exprRelations(st: St) -> Res<Int> ~ {
    l = exprAdditive(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        op = relationOpAt(s2);
        if size(op.bytes) > 0 {
            s2 = St { pos: s2.pos + size(op.bytes), ..s2 };
            s2 = skipWs(s2);
            r = exprAdditive(s2);
            if !r.ok { return r; };
            s = r.st;
            b = relExprOf(s, op, left, r.v);
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { loop = false; s = s2; };
    };
    // is Variant
    s2 = skipWs(s);
    k = eatKeyword(s2, "is");
    if k.v {
        s3 = skipWs(k.st);
        dc = declaredCtorNode(s3);
        if !dc.ok { return Res<Int> { st: dc.st, v: 0, ok: false }; };
        s = dc.st;
        b = isExprOf(s, dc.v, left);
        if !b.ok { return b; };
        s = b.st;
        left = b.v;
        s = skipWs(s);
    } else { s = k.st; };
    return ok(s, left);
};

fn relationOpAt(st: &St) -> String ~ {
    // many1 of =<>! , classified
    i = st.pos;
    going = true;
    while going && i < size(st.src.bytes) ~ {
        c = byteAt(st, i);
        if c = 61 || c = 60 || c = 62 || c = 33 { i = i + 1; } else { going = false; };
    };
    if i = st.pos { return ""; };
    op = srcSlice(st, st.pos, i);
    if op = "=" || op = "!=" || op = "<" || op = ">" || op = "<=" || op = ">=" { return op; };
    return "";
};

fn relExprOf(st: St, op: &String, l: Int, r: Int) -> Res<Int> ~ {
    idx = relIndexOf(op);
    bv = relValue(st, idx);
    if !bv.ok { return bv; };
    ve = valExpr(bv.st, bv.v);
    if !ve.ok { return ve; };
    xs = expressionsList(ve.st, push(push([], l), r));
    if !xs.ok { return xs; };
    return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
};

fn isExprOf(st: St, variantName: &String, e: Int) -> Res<Int> ~ {
    n = putName(st, variantName);
    if !n.ok { return n; };
    return builtinExpr(n.st, AstBuiltin::Is { n: n.v }, push([], "value"), push([], e));
};

fn exprAdditive(st: St) -> Res<Int> ~ {
    l = exprMultiplicative(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        c = byteAt(s2, s2.pos);
        if c = 43 || c = 45 {
            // a '-' that starts a negative literal in operand position is not an operator here (Haskell: op then whitespace then operand; '-' is consumed as operator)
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            r = exprMultiplicative(s2);
            if !r.ok { return r; };
            s = r.st;
            name = "Plus";
            if c = 45 { name = "Minus"; };
            b = primExpr(s, name, push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn exprMultiplicative(st: St) -> Res<Int> ~ {
    l = nonInfixExpr(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        c = byteAt(s2, s2.pos);
        if c = 42 || c = 47 || c = 37 {
            // '//' is a comment, handled by whitespace; a single '/' here is Div (a comment would have been eaten as whitespace before)
            if c = 47 && byteAt(s2, s2.pos + 1) = 47 { s = s2; loop = false; }
            else {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(s2);
                r = nonInfixExpr(s2);
                if !r.ok { return r; };
                s = r.st;
                name = "Times";
                if c = 47 { name = "Div"; };
                if c = 37 { name = "Mod"; };
                b = primExpr(s, name, push(push([], left), r.v));
                if !b.ok { return b; };
                s = b.st;
                left = b.v;
            };
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn declaredCtorNode(st: St) -> Res<String> ~ {
    q = qualifiedName(st);
    if !q.ok { return q; };
    if size(matchedCtorName(q.st, q.v).bytes) = 0 { return fail(q.st, "", cat3("Unknown struct or variant ", q.v, "")); };
    return q;
};

fn nonInfixExpr(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    c = byteAt(s, s.pos);
    // borrow
    if c = 38 {
        if peekIs(s, "&mut") {
            s = St { pos: s.pos + 4, ..s };
            s = skipWs(s);
            inner = nonInfixExpr(s);
            if !inner.ok { return inner; };
            return primExpr(inner.st, "BorrowMutOf", push([], inner.v));
        };
        if byteAt(s, s.pos + 1) != 38 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            inner = nonInfixExpr(s);
            if !inner.ok { return inner; };
            return primExpr(inner.st, "BorrowOf", push([], inner.v));
        };
    };
    if c = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = nonInfixExpr(s);
        if !inner.ok { return inner; };
        return primExpr(inner.st, "DerefOf", push([], inner.v));
    };
    if c = 33 && byteAt(s, s.pos + 1) != 61 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = nonInfixExpr(s);
        if !inner.ok { return inner; };
        return primExpr(inner.st, "Not", push([], inner.v));
    };
    if c = 34 {
        lit = stringLiteralExpr(s);
        if !lit.ok { return lit; };
        return withFieldsExpr(lit.st, lit.v);
    };
    if c = 35 {
        // #[ ... ] array literal of values
        s = St { pos: s.pos + 1, ..s };
        v = valueNode(s);
        if !v.ok { return v; };
        ve = valExpr(v.st, v.v);
        if !ve.ok { return ve; };
        return primExpr(ve.st, "ArrayFrom", push([], ve.v));
    };
    if c = 60 {
        qc = qualifiedCallExpr(s);
        if !qc.ok { return qc; };
        return withFieldsExpr(qc.st, qc.v);
    };
    if c = 40 {
        pe = parensExpr(s);
        if !pe.ok { return pe; };
        return withFieldsExpr(pe.st, pe.v);
    };
    // struct literal / call / variable, string handled above, value (number, bool, list)
    if isDigitCp(c) || c = 45 || c = 91 || keywordAt(s, "true") || keywordAt(s, "false") {
        v = valueNode(s);
        if !v.ok { return v; };
        ve = valExpr(v.st, v.v);
        if !ve.ok { return ve; };
        return withFieldsExpr(ve.st, ve.v);
    };
    // name-led
    base = nameLedExpr(s);
    if !base.ok { return base; };
    return withFieldsExpr(base.st, base.v);
};

fn stringLiteralExpr(st: St) -> Res<Int> ~ {
    if !stringCtorCheck(st) { return fail(st, 0, "a string literal needs the library String, which this program declares differently"); };
    sb = stringBytes(st);
    if !sb.ok { return Res<Int> { st: sb.st, v: 0, ok: false }; };
    s = clone(sb.st);
    vals = [];
    for b in sb.v {
        nm = putName(s, String::fromInt(b));
        if !nm.ok { return nm; };
        s = nm.st;
        vn = emit(s, AstNode::Value { value: AstValue::VInt { n: nm.v } });
        s = vn.st;
        vals = push(vals, vn.v);
    };
    lst = valuesList(s, vals);
    if !lst.ok { return lst; };
    lv = emit(lst.st, AstNode::Value { value: AstValue::VList { xs: lst.v } });
    bytesFrom = primValue(lv.st, "BytesFrom");
    if !bytesFrom.ok { return bytesFrom; };
    ve1 = valExpr(bytesFrom.st, bytesFrom.v);
    lvExpr = valExpr(ve1.st, lv.v);
    argList2 = expressionsList(lvExpr.st, push([], lvExpr.v));
    f1 = exprNode(argList2.st, AstExpression::F { f: ve1.v, xs: argList2.v });
    ctor = ctorValue(f1.st, "String", [], push([], "bytes"));
    if !ctor.ok { return ctor; };
    ve2 = valExpr(ctor.st, ctor.v);
    args2 = expressionsList(ve2.st, push([], f1.v));
    if !args2.ok { return args2; };
    return exprNode(args2.st, AstExpression::F { f: ve2.v, xs: args2.v });
};

fn ctorValue(st: St, name: &String, args: &List<ArgV>, fields: &List<String>) -> Res<Int> ~ {
    n = putName(st, name);
    if !n.ok { return n; };
    a = putArgsNodes(n.st, args);
    if !a.ok { return a; };
    f = namesList(a.st, fields);
    if !f.ok { return f; };
    return builtinValue(f.st, AstBuiltin::Ctor { n: n.v, args: a.v, fs: f.v }, fields);
};

fn parensExpr(st: St) -> Res<Int> ~ {
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    parts = [];
    loop = true;
    while loop ~ {
        e = expression(s);
        if !e.ok { return e; };
        s = e.st;
        parts = push(parts, e.v);
        s = skipWs(s);
        if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if size(parts) = 1 { return ok(s, get(parts, 0)); };
    fields = [];
    i = 0;
    while i < size(parts) ~ { fields = push(fields, String::fromInt(i)); i = i + 1; };
    ctor = ctorValue(s, catStrings("Tuple", String::fromInt(size(parts))), [], fields);
    if !ctor.ok { return ctor; };
    ve = valExpr(ctor.st, ctor.v);
    xs = expressionsList(ve.st, parts);
    if !xs.ok { return xs; };
    r = exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
    return r;
};

fn qualifiedCallExpr(st: St) -> Res<Int> ~ {
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    v = qualifiedName(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    owner = baseNameOf(v.v);
    s = skipWs(v.st);
    trt = "";
    hasTrait = false;
    k = eatKeyword(s, "as");
    if k.v {
        s = skipWs(k.st);
        w = qualifiedName(s);
        if !w.ok { return Res<Int> { st: w.st, v: 0, ok: false }; };
        trt = w.v;
        hasTrait = true;
        s = skipWs(w.st);
    } else { s = k.st; };
    if byteAt(s, s.pos) != 62 { return fail(s, 0, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    if !peekIs(s, "::") { return fail(s, 0, "expected ::"); };
    s = St { pos: s.pos + 2, ..s };
    f = parseVariable(s);
    if !f.ok { return Res<Int> { st: f.st, v: 0, ok: false }; };
    s = f.st;
    full = implName(owner, hasTrait, trt, f.v);
    if byteAt(s, s.pos) != 40 { return fail(s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    args = exprArgs(s);
    if !args.ok { return Res<Int> { st: args.st, v: 0, ok: false }; };
    s = args.st;
    ve = varExprNode(s, full);
    if !ve.ok { return ve; };
    xs = expressionsList(ve.st, args.v);
    if !xs.ok { return xs; };
    return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
};

fn implName(owner: &String, hasTrait: Bool, trt: &String, f: &String) -> String ~ {
    if hasTrait { return catStrings(cat3(cat3("<", owner, " as "), trt, ">"), cat3("::", f, "")); };
    return cat3(cat3("<", owner, ">"), "::", f);
};

fn exprArgs(st: St) -> Res<List<Int>> ~ {
    // just past '('; consumes through ')'
    s = st;
    args = [];
    if byteAt(s, s.pos) = 41 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); return ok(s, args); };
    loop = true;
    while loop ~ {
        e = expression(s);
        if !e.ok { return Res<List<Int>> { st: e.st, v: [], ok: false }; };
        s = e.st;
        args = push(args, e.v);
        s = skipWs(s);
        if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, [], "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, args);
};

fn nameLedExpr(st: St) -> Res<Int> ~ {
    s = st;
    save = clone(s);
    // struct literal attempt
    lit = tryStructLiteralExpr(s);
    if lit.ok { return lit; };
    s = save;
    // call or variable
    q = qualifiedName(s);
    if !q.ok { return Res<Int> { st: q.st, v: 0, ok: false }; };
    s = q.st;
    name = q.v;
    if byteAt(s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        args = exprArgs(s);
        if !args.ok { return Res<Int> { st: args.st, v: 0, ok: false }; };
        s = args.st;
        ve = varExprNode(s, name);
        if !ve.ok { return ve; };
        xs = expressionsList(ve.st, args.v);
        if !xs.ok { return xs; };
        return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
    };
    if containsText(name, "::") { return fail(s, 0, "expected ("); };
    return varExprNode(s, name);
};

fn withFieldsExpr(st: St, base: Int) -> Res<Int> ~ {
    s = skipWs(st);
    k = eatKeyword(s, "as");
    if k.v {
        s2 = skipWs(k.st);
        dc = declaredCtorNode(s2);
        if !dc.ok { return Res<Int> { st: dc.st, v: 0, ok: false }; };
        cast = castExprOf(dc.st, dc.v, base);
        if !cast.ok { return cast; };
        return withFieldsExpr(cast.st, cast.v);
    };
    s = k.st;
    if byteAt(s, s.pos) = 46 && byteAt(s, s.pos + 1) != 46 {
        s = St { pos: s.pos + 1, ..s };
        fname = "";
        if byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 {
            start = s.pos;
            while byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
            fname = srcSlice(s, start, s.pos);
        } else {
            v = parseVariable(s);
            if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
            fname = v.v;
            s = v.st;
        };
        if byteAt(s, s.pos) = 40 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            args = exprArgs(s);
            if !args.ok { return Res<Int> { st: args.st, v: 0, ok: false }; };
            s = args.st;
            ve = varExprNode(s, catStrings(".", fname));
            if !ve.ok { return ve; };
            all = push([], base);
            for a in args.v { all = push(all, a); };
            xs = expressionsList(ve.st, all);
            if !xs.ok { return xs; };
            r = exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
            return withFieldsExpr(r.st, r.v);
        };
        fe = fieldExprOf(s, fname, base);
        if !fe.ok { return fe; };
        return withFieldsExpr(fe.st, fe.v);
    };
    return ok(s, base);
};
fn fieldExprOf(st: St, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName(st, fname);
    if !n.ok { return n; };
    on = optNameNode(n.st, false, "");
    if !on.ok { return on; };
    return builtinExpr(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: n.v }, push([], "struct"), push([], of));
};

fn fieldExprOwned(st: St, owner: &String, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName(st, fname);
    if !n.ok { return n; };
    on = optNameNode(n.st, true, owner);
    if !on.ok { return on; };
    return builtinExpr(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: n.v }, push([], "struct"), push([], of));
};

fn castExprOf(st: St, variant: &String, of: Int) -> Res<Int> ~ {
    n = putName(st, variant);
    if !n.ok { return n; };
    return builtinExpr(n.st, AstBuiltin::Cast { n: n.v }, push([], "value"), push([], of));
};

fn projectExprOf(st: St, variant: &String, fname: &String, of: Int) -> Res<Int> ~ {
    n = putName(st, variant);
    if !n.ok { return n; };
    fn2 = putName(n.st, fname);
    if !fn2.ok { return fn2; };
    return builtinExpr(fn2.st, AstBuiltin::Project { n: n.v, f: fn2.v }, push([], "value"), push([], of));
};

// arena inspection helpers

fn nodeIs(st: &St, id: Int, kind: Int) -> Bool ~ {
    // kind: 1 Name, 4 Value, 6 Expression, 9 Proof
    n = nodeAt(st, id);
    if kind = 1 && n is AstNode::Name { return true; };
    if kind = 4 && n is AstNode::Value { return true; };
    if kind = 6 && n is AstNode::Expression { return true; };
    if kind = 9 && n is AstNode::Proof { return true; };
    return false;
};

fn nameText(st: &St, id: Int) -> String ~ {
    n = nodeAt(st, id);
    if n is AstNode::Name {
        v = (n as AstNode::Name).value;
        return match v {
            AstName::End => "",
            AstName::Part { text: t, tail: tail } => catStrings(t, nameText(st, tail)),
        };
    };
    return "";
};

fn exprParts(st: &St, id: Int) -> List<Int> ~ {
    // [f, xs] when id is Expression F, else []
    n = nodeAt(st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        return match v {
            AstExpression::F { f: f, xs: xs } => push(push([], f), xs),
            AstExpression::Val { v: vv } => [],
            AstExpression::Var { n: nn } => [],
        };
    };
    return [];
};

fn exprVarName(st: &St, id: Int) -> String ~ {
    n = nodeAt(st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        return match v {
            AstExpression::Var { n: nn } => nameText(st, nn),
            AstExpression::Val { v: vv } => "",
            AstExpression::F { f: f, xs: xs } => "",
        };
    };
    return "";
};

fn exprListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Expressions {
            v = (n as AstNode::Expressions).value;
            match v {
                AstExpressions::End => { loop = false; },
                AstExpressions::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn clonedBaseOf(st: &St, e: Int) -> List<Int> ~ {
    parts = exprParts(st, e);
    if size(parts) != 2 { return []; };
    fname = exprVarName(st, get(parts, 0));
    if fname != "clone" && fname != ".clone" { return []; };
    args = exprListIds(st, get(parts, 1));
    if size(args) != 1 { return []; };
    return push([], get(args, 0));
};

// ---- struct literals, in expression and in proof form ----


fn litHead(st: St) -> Res<LitOut> ~ {
    // qualified name known to ctors, with generic arguments and an opening brace consumed (or a fieldless variant)
    q = qualifiedName(st);
    if !q.ok { return Res<LitOut> { st: q.st, v: LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, ok: false }; };
    s = q.st;
    base = q.v;
    matched = matchedCtorName(s, base);
    declared = findCtor(s, matched);
    if size(matched.bytes) = 0 { return fail(s, LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, "not a struct or variant"); };
    isVar = containsText(matched, "::");
    ctorArgs = [];
    candidate = clone(base);
    params = findGenerics(s, matched);
    if size(params) > 0 && !isVar {
        if hasGenericArguments(s, params) {
            g = genericArguments(skipWs(clone(s)), params);
            if !g.ok { return Res<LitOut> { st: g.st, v: LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, ok: false }; };
            s = g.st;
            ctorArgs = g.v;
            candidate = instanceNameOf(base, ctorArgs);
            // a candidate instance is not itself declared; Haskell keeps the matched name's fields
        };
    };
    if size(declared) = 0 && containsText(candidate, "::") {
        s = skipWs(s);
        return ok(s, LitOut { name: candidate, ctorArgs: ctorArgs, declared: declared, isVariant: true });
    };
    s = skipWs(s);
    if byteAt(s, s.pos) != 123 { return fail(s, LitOut { name: "", ctorArgs: [], declared: [], isVariant: false }, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    return ok(s, LitOut { name: candidate, ctorArgs: ctorArgs, declared: declared, isVariant: containsText(candidate, "::") });
};

fn tryStructLiteralExpr(st: St) -> Res<Int> ~ {
    save = clone(st);
    head = litHead(st);
    if !head.ok { return Res<Int> { st: save, v: 0, ok: false }; };
    s = head.st;
    h = head.v;
    if size(h.declared) = 0 && h.isVariant {
        ctor = ctorValue(s, h.name, [], []);
        if !ctor.ok { return ctor; };
        ve = valExpr(ctor.st, ctor.v);
        if !ve.ok { return ve; };
        xs = expressionsList(ve.st, []);
        if !xs.ok { return xs; };
        return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
    };
    return structFieldsExpr(s, h);
};

fn structFieldsExpr(st: St, h: LitOut) -> Res<Int> ~ {
    s = skipWs(st);
    initNames = [];
    initVals = [];
    hasBase = false;
    base = 0;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "..") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            b = expression(s2);
            if !b.ok { return b; };
            s = b.st;
            hasBase = true;
            base = b.v;
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            loop = false;
        } else {
            if byteAt(s2, s2.pos) = 125 { s = s2; loop = false; }
            else {
                f = parseVariable(s2);
                if !f.ok { return Res<Int> { st: f.st, v: 0, ok: false }; };
                s = skipWs(f.st);
                if byteAt(s, s.pos) != 58 { return fail(s, 0, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                v = expression(s);
                if !v.ok { return v; };
                s = v.st;
                initNames = push(initNames, f.v);
                initVals = push(initVals, v.v);
                s = skipWs(s);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            };
        };
    };
    if byteAt(s, s.pos) != 125 { return fail(s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    for n in initNames { if !containsName(h.declared, n) { return fail(s, 0, cat3(cat3("Struct ", h.name, " has no field "), n, "")); }; };
    if hasDupStrings(initNames) { return fail(s, 0, cat3("Struct ", h.name, " literal repeats a field")); };
    if hasBase {
        allGiven = true;
        for d in h.declared { if !containsName(initNames, d) { allGiven = false; }; };
        if allGiven { return fail(s, 0, cat3("Struct ", h.name, " literal gives every field, so ..base copies nothing")); };
    };
    args = [];
    for field in h.declared {
        idx = indexOfName(initNames, field);
        if idx >= 0 { args = push(args, get(initVals, idx)); }
        else {
            if !hasBase { return fail(s, 0, cat3(cat3("Struct ", h.name, " literal lacks field "), field, "")); };
            cloned = clonedBaseOf(s, base);
            if !s.ownClone && size(cloned) = 1 {
                fv = fieldFromExpr(s, h.name, get(cloned, 0), field);
                if !fv.ok { return fv; };
                s = fv.st;
                cv = primExpr(s, "CloneOf", push([], fv.v));
                if !cv.ok { return cv; };
                s = cv.st;
                args = push(args, cv.v);
            } else {
                fv = fieldFromExpr(s, h.name, base, field);
                if !fv.ok { return fv; };
                s = fv.st;
                args = push(args, fv.v);
            };
        };
    };
    ctor = ctorValue(s, h.name, h.ctorArgs, h.declared);
    if !ctor.ok { return ctor; };
    ve = valExpr(ctor.st, ctor.v);
    xs = expressionsList(ve.st, args);
    if !xs.ok { return xs; };
    return exprNode(xs.st, AstExpression::F { f: ve.v, xs: xs.v });
};

fn fieldFromExpr(st: St, litName: &String, from: Int, field: &String) -> Res<Int> ~ {
    if containsText(litName, "::") {
        cast = castExprOf(st, litName, from);
        if !cast.ok { return cast; };
        return fieldExprOf(cast.st, field, cast.v);
    };
    return fieldExprOwned(st, litName, field, from);
};

fn hasDupStrings(xs: &List<String>) -> Bool ~ {
    i = 0;
    for x in xs {
        j = 0;
        for y in xs { if j > i && y = x { return true; }; j = j + 1; };
        i = i + 1;
    };
    return false;
};

// ---- proofs ----

fn proofNode(st: St, node: AstProof) -> Res<Int> ~ { return emit(st, AstNode::Proof { value: node }); };

fn ctermProof(st: St, valueNode: Int) -> Res<Int> ~ { return proofNode(st, AstProof::CTerm { v: valueNode }); };

fn atermProof(st: St, name: &String) -> Res<Int> ~ {
    n = putName(st, name);
    if !n.ok { return n; };
    return proofNode(n.st, AstProof::ATerm { n: n.v });
};

fn builtinProof(st: St, b: AstBuiltin, params: &List<String>, args: &List<Int>) -> Res<Int> ~ {
    bv = builtinValue(st, b, params);
    if !bv.ok { return bv; };
    ct = ctermProof(bv.st, bv.v);
    if !ct.ok { return ct; };
    xs = proofsList(ct.st, args);
    if !xs.ok { return xs; };
    return proofNode(xs.st, AstProof::FApp { f: ct.v, xs: xs.v });
};

fn primProof(st: St, name: &String, args: &List<Int>) -> Res<Int> ~ {
    return builtinProof(st, AstBuiltin::Primitive { name: clone(name) }, primParams(name), args);
};

fn proof(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if keywordAt(s, "forall") {
        f = forallProof(s);
        if f.ok { return f; };
        return f;
    };
    return proofOr(s);
};

fn proofOr(st: St) -> Res<Int> ~ {
    l = proofAnd(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "||") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            r = proofAnd(s2);
            if !r.ok { return r; };
            s = r.st;
            b = primProof(s, "Or", push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn proofAnd(st: St) -> Res<Int> ~ {
    l = proofRel(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "&&") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            r = proofRel(s2);
            if !r.ok { return r; };
            s = r.st;
            b = primProof(s, "And", push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn proofRel(st: St) -> Res<Int> ~ {
    l = proofAdd(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        op = relationOpAt(s2);
        if size(op.bytes) > 0 {
            s2 = St { pos: s2.pos + size(op.bytes), ..s2 };
            s2 = skipWs(s2);
            r = proofAdd(s2);
            if !r.ok { return r; };
            s = r.st;
            b = relProofOf(s, relIndexOf(op), left, r.v);
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { loop = false; s = s2; };
    };
    s2 = skipWs(s);
    k = eatKeyword(s2, "is");
    if k.v {
        s3 = skipWs(k.st);
        dc = declaredCtorNode(s3);
        if !dc.ok { return Res<Int> { st: dc.st, v: 0, ok: false }; };
        s = dc.st;
        n = putName(s, dc.v);
        if !n.ok { return n; };
        b = builtinProof(n.st, AstBuiltin::Is { n: n.v }, push([], "value"), push([], left));
        if !b.ok { return b; };
        s = b.st;
        left = b.v;
        s = skipWs(s);
    } else { s = k.st; };
    return ok(s, left);
};

fn proofAdd(st: St) -> Res<Int> ~ {
    l = proofMul(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        c = byteAt(s2, s2.pos);
        if c = 43 || c = 45 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            r = proofMul(s2);
            if !r.ok { return r; };
            s = r.st;
            name = "Plus";
            if c = 45 { name = "Minus"; };
            b = primProof(s, name, push(push([], left), r.v));
            if !b.ok { return b; };
            s = b.st;
            left = b.v;
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn proofMul(st: St) -> Res<Int> ~ {
    l = nonInfixProof(st);
    if !l.ok { return l; };
    s = l.st;
    left = l.v;
    loop = true;
    while loop ~ {
        save = clone(s);
        s2 = skipWs(s);
        c = byteAt(s2, s2.pos);
        if c = 42 || c = 47 || c = 37 {
            if c = 47 && byteAt(s2, s2.pos + 1) = 47 { s = s2; loop = false; }
            else {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(s2);
                r = nonInfixProof(s2);
                if !r.ok { return r; };
                s = r.st;
                name = "Times";
                if c = 47 { name = "Div"; };
                if c = 37 { name = "Mod"; };
                b = primProof(s, name, push(push([], left), r.v));
                if !b.ok { return b; };
                s = b.st;
                left = b.v;
            };
        } else { s = s2; loop = false; };
    };
    return ok(s, left);
};

fn forallProof(st: St) -> Res<Int> ~ {
    s = st;
    k = eatKeyword(s, "forall");
    if !k.v { return fail(k.st, 0, "expected forall"); };
    s = skipWs(k.st);
    idx = parseVariable(s);
    if !idx.ok { return Res<Int> { st: idx.st, v: 0, ok: false }; };
    index = idx.v;
    s = skipWs(idx.st);
    guards = [];
    body = 0;
    if keywordAt(s, "in") {
        k2 = eatKeyword(s, "in");
        s = skipWs(k2.st);
        lower = proof(s);
        if !lower.ok { return lower; };
        s = lower.st;
        s = skipWs(s);
        if !peekIs(s, "..") { return fail(s, 0, "expected .."); };
        s = St { pos: s.pos + 2, ..s };
        s = skipWs(s);
        upper = proof(s);
        if !upper.ok { return upper; };
        s = skipWs(upper.st);
        if byteAt(s, s.pos) != 58 { return fail(s, 0, "expected :"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        b = proof(s);
        if !b.ok { return b; };
        s = b.st;
        body = b.v;
        ai = atermProof(s, index);
        if !ai.ok { return ai; };
        s = ai.st;
        ge = relProofOf(s, 5, ai.v, lower.v);
        if !ge.ok { return ge; };
        s = ge.st;
        ai2 = atermProof(s, index);
        if !ai2.ok { return ai2; };
        s = ai2.st;
        lt = relProofOf(s, 2, ai2.v, upper.v);
        if !lt.ok { return lt; };
        s = lt.st;
        guards = push(push([], ge.v), lt.v);
    } else {
        k2 = eatKeyword(s, "where");
        if !k2.v { return fail(k2.st, 0, "expected where or in"); };
        s = skipWs(k2.st);
        loop = true;
        while loop ~ {
            g = proof(s);
            if !g.ok { return g; };
            s = g.st;
            guards = push(guards, g.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
        if byteAt(s, s.pos) != 58 { return fail(s, 0, "expected :"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        b = proof(s);
        if !b.ok { return b; };
        s = b.st;
        body = b.v;
    };
    if proofHasForall(s, body) { return fail(s, 0, "forall does not nest"); };
    for g in guards { if proofHasForall(s, g) { return fail(s, 0, "forall does not nest"); }; };
    boundGuards = [];
    for g in guards {
        bg = bindIndex(s, g, index);
        s = bg;
        boundGuards = push(boundGuards, g);
        // bindIndex mutates nodes in place; the id is unchanged
    };
    s2 = bindIndex(s, body, index);
    n = putName(s2, index);
    if !n.ok { return n; };
    s = n.st;
    gl = proofsList(s, boundGuards);
    if !gl.ok { return gl; };
    return proofNode(gl.st, AstProof::Forall { n: n.v, gs: gl.v, b: body });
};

fn relProofOf(st: St, r: Int, l: Int, rr: Int) -> Res<Int> ~ {
    bv = relValue(st, r);
    if !bv.ok { return bv; };
    ct = ctermProof(bv.st, bv.v);
    if !ct.ok { return ct; };
    xs = proofsList(ct.st, push(push([], l), rr));
    if !xs.ok { return xs; };
    return proofNode(xs.st, AstProof::FApp { f: ct.v, xs: xs.v });
};

fn proofHasForall(st: &St, id: Int) -> Bool ~ {
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        exists = false;
        match v {
            AstProof::Forall { n: a, gs: b, b: c } => { exists = true; },
            AstProof::FApp { f: f, xs: xs } => {
                exists = proofHasForall(st, f);
                for x in proofListIds(st, xs) { if proofHasForall(st, x) { exists = true; }; };
            },
            AstProof::ATerm { n: a } => { exists = false; },
            AstProof::CTerm { v: a } => { exists = false; },
            AstProof::BVar { n: a } => { exists = false; },
        };
        return exists;
    };
    return false;
};

fn proofListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Proofs {
            v = (n as AstNode::Proofs).value;
            match v {
                AstProofs::End => { loop = false; },
                AstProofs::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn bindIndex(st: St, id: Int, index: &String) -> St ~ {
    s = st;
    n = nodeAt(s, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        match v {
            AstProof::ATerm { n: a } => {
                if nameText(s, a) = index {
                    s = setNodeAt(s, id, AstNode::Proof { value: AstProof::BVar { n: a } });
                };
            },
            AstProof::FApp { f: f, xs: xs } => {
                s = bindIndex(s, f, index);
                for x in proofListIds(s, xs) { s = bindIndex(s, x, index); };
            },
            AstProof::CTerm { v: a } => { },
            AstProof::Forall { n: a, gs: b, b: c } => { },
            AstProof::BVar { n: a } => { },
        };
    };
    return s;
};

fn nonInfixProof(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if keywordAt(s, "old") {
        save = clone(s);
        k = eatKeyword(s, "old");
        s2 = skipWs(k.st);
        if byteAt(s2, s2.pos) = 40 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            inner = proof(s2);
            if !inner.ok { return inner; };
            s2 = skipWs(inner.st);
            if byteAt(s2, s2.pos) != 41 { return fail(s2, 0, "expected )"); };
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            return primProof(s2, "OldOf", push([], inner.v));
        };
        s = save;
    };
    c = byteAt(s, s.pos);
    if c = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = nonInfixProof(s);
        if !inner.ok { return inner; };
        return primProof(inner.st, "DerefOf", push([], inner.v));
    };
    if c = 34 {
        lit = stringLiteralProof(s);
        if !lit.ok { return lit; };
        return withFieldsProof(lit.st, lit.v);
    };
    if c = 35 {
        s = St { pos: s.pos + 1, ..s };
        v = valueNode(s);
        if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
        ct = ctermProof(v.st, v.v);
        if !ct.ok { return ct; };
        return builtinProof(ct.st, AstBuiltin::Primitive { name: "ArrayFrom" }, push([], "list"), push([], ct.v));
        // Haskell: FApp (CTerm ArrayFromSym) [CTerm items]; the argument is the value itself as CTerm
    };
    base = proofBase(s);
    if !base.ok { return base; };
    return withFieldsProof(base.st, base.v);
};

fn stringLiteralProof(st: St) -> Res<Int> ~ {
    if !stringCtorCheck(st) { return fail(st, 0, "a string literal needs the library String, which this program declares differently"); };
    sb = stringBytes(st);
    if !sb.ok { return Res<Int> { st: sb.st, v: 0, ok: false }; };
    s = clone(sb.st);
    vals = [];
    for b in sb.v {
        nm = putName(s, String::fromInt(b));
        if !nm.ok { return nm; };
        s = nm.st;
        vn = emit(s, AstNode::Value { value: AstValue::VInt { n: nm.v } });
        s = vn.st;
        vals = push(vals, vn.v);
    };
    lst = valuesList(s, vals);
    if !lst.ok { return lst; };
    lv = emit(lst.st, AstNode::Value { value: AstValue::VList { xs: lst.v } });
    ctLv = ctermProof(lv.st, lv.v);
    bytesFrom = primProof(ctLv.st, "BytesFrom", push([], ctLv.v));
    if !bytesFrom.ok { return bytesFrom; };
    ctor = ctorSymbolProof(bytesFrom.st, "String", [], push([], "bytes"));
    if !ctor.ok { return ctor; };
    xs = proofsList(ctor.st, push([], bytesFrom.v));
    if !xs.ok { return xs; };
    return proofNode(xs.st, AstProof::FApp { f: ctor.v, xs: xs.v });
};

fn proofBase(st: St) -> Res<Int> ~ {
    s = st;
    c = byteAt(s, s.pos);
    if c = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = proof(s);
        if !inner.ok { return inner; };
        s = skipWs(inner.st);
        if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        return ok(s, inner.v);
    };
    // value (concrete)
    if isDigitCp(c) || c = 45 || c = 91 || keywordAt(s, "true") || keywordAt(s, "false") {
        v = valueNode(s);
        if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
        return ctermProof(v.st, v.v);
    };
    // struct literal in proof form
    lit = tryStructLiteralProof(s);
    if lit.ok { return lit; };
    s = lit.st;
    // function proof or abstract term
    q = qualifiedName(s);
    if !q.ok { return Res<Int> { st: q.st, v: 0, ok: false }; };
    s = q.st;
    if byteAt(s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        args = [];
        if byteAt(s, s.pos) != 41 {
            loop = true;
            while loop ~ {
                a = proof(s);
                if !a.ok { return a; };
                s = a.st;
                args = push(args, a.v);
                s = skipWs(s);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
            };
        };
        if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        prim = proofPrimName(q.v);
        funct = 0;
        if size(prim.bytes) > 0 {
            bv = primValue(s, prim);
            if !bv.ok { return bv; };
            ct = ctermProof(bv.st, bv.v);
            if !ct.ok { return ct; };
            s = ct.st;
            funct = ct.v;
        } else {
            at = atermProof(s, q.v);
            if !at.ok { return at; };
            s = at.st;
            funct = at.v;
        };
        xs = proofsList(s, args);
        if !xs.ok { return xs; };
        return proofNode(xs.st, AstProof::FApp { f: funct, xs: xs.v });
    };
    if containsText(q.v, "::") { return fail(s, 0, "expected ("); };
    return atermProof(s, q.v);
};

fn withFieldsProof(st: St, base: Int) -> Res<Int> ~ {
    s = st;
    acc = base;
    loop = true;
    while loop ~ {
        s = skipWs(s);
        k = eatKeyword(clone(s), "as");
        if k.v {
            s2 = skipWs(k.st);
            dc = declaredCtorNode(s2);
            if !dc.ok { return Res<Int> { st: dc.st, v: 0, ok: false }; };
            s = dc.st;
            n = putName(s, dc.v);
            if !n.ok { return n; };
            cast = builtinProof(n.st, AstBuiltin::Cast { n: n.v }, push([], "value"), push([], acc));
            if !cast.ok { return cast; };
            s = cast.st;
            acc = cast.v;
            s = skipWs(s);
        } else {
            s = k.st;
            if byteAt(s, s.pos) = 46 && byteAt(s, s.pos + 1) != 46 {
                s = St { pos: s.pos + 1, ..s };
                fname = "";
                if byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 {
                    start = s.pos;
                    while byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
                    fname = srcSlice(s, start, s.pos);
                } else {
                    v = parseVariable(s);
                    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
                    fname = v.v;
                    s = v.st;
                };
                n = putName(s, fname);
                if !n.ok { return n; };
                on = optNameNode(n.st, false, "");
                if !on.ok { return on; };
                fe = builtinProof(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: n.v }, push([], "struct"), push([], acc));
                if !fe.ok { return fe; };
                s = fe.st;
                acc = fe.v;
                s = skipWs(s);
            } else { loop = false; };
        };
    };
    return ok(s, acc);
};

fn tryStructLiteralProof(st: St) -> Res<Int> ~ {
    save = clone(st);
    head = litHead(st);
    if !head.ok { return Res<Int> { st: save, v: 0, ok: false }; };
    s = head.st;
    h = head.v;
    if size(h.declared) = 0 && h.isVariant {
        ctor = ctorSymbolProof(s, h.name, [], []);
        if !ctor.ok { return ctor; };
        xs = proofsList(ctor.st, []);
        if !xs.ok { return xs; };
        return proofNode(xs.st, AstProof::FApp { f: ctor.v, xs: xs.v });
    };
    return structFieldsProof(s, h);
};

fn ctorSymbolProof(st: St, name: &String, args: &List<ArgV>, fields: &List<String>) -> Res<Int> ~ {
    cv = ctorValue(st, name, args, fields);
    if !cv.ok { return cv; };
    return ctermProof(cv.st, cv.v);
};

fn structFieldsProof(st: St, h: LitOut) -> Res<Int> ~ {
    s = skipWs(st);
    initNames = [];
    initVals = [];
    hasBase = false;
    base = 0;
    loop = true;
    while loop ~ {
        s2 = skipWs(s);
        if peekIs(s2, "..") {
            s2 = St { pos: s2.pos + 2, ..s2 };
            s2 = skipWs(s2);
            b = proof(s2);
            if !b.ok { return b; };
            s = b.st;
            hasBase = true;
            base = b.v;
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            loop = false;
        } else {
            if byteAt(s2, s2.pos) = 125 { s = s2; loop = false; }
            else {
                f = parseVariable(s2);
                if !f.ok { return Res<Int> { st: f.st, v: 0, ok: false }; };
                s = skipWs(f.st);
                if byteAt(s, s.pos) != 58 { return fail(s, 0, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                v = proof(s);
                if !v.ok { return v; };
                s = v.st;
                initNames = push(initNames, f.v);
                initVals = push(initVals, v.v);
                s = skipWs(s);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            };
        };
    };
    if byteAt(s, s.pos) != 125 { return fail(s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    for n in initNames { if !containsName(h.declared, n) { return fail(s, 0, cat3(cat3("Struct ", h.name, " has no field "), n, "")); }; };
    if hasDupStrings(initNames) { return fail(s, 0, cat3("Struct ", h.name, " literal repeats a field")); };
    if hasBase {
        allGiven = true;
        for d in h.declared { if !containsName(initNames, d) { allGiven = false; }; };
        if allGiven { return fail(s, 0, cat3("Struct ", h.name, " literal gives every field, so ..base copies nothing")); };
    };
    args = [];
    for field in h.declared {
        idx = indexOfName(initNames, field);
        if idx >= 0 { args = push(args, get(initVals, idx)); }
        else {
            if !hasBase { return fail(s, 0, cat3(cat3("Struct ", h.name, " literal lacks field "), field, "")); };
            fv = fieldFromProof(s, h.name, base, field);
            if !fv.ok { return fv; };
            s = fv.st;
            args = push(args, fv.v);
        };
    };
    ctor = ctorSymbolProof(s, h.name, h.ctorArgs, h.declared);
    if !ctor.ok { return ctor; };
    xs = proofsList(ctor.st, args);
    if !xs.ok { return xs; };
    return proofNode(xs.st, AstProof::FApp { f: ctor.v, xs: xs.v });
};

fn fieldFromProof(st: St, litName: &String, from: Int, field: &String) -> Res<Int> ~ {
    if containsText(litName, "::") {
        n = putName(st, litName);
        if !n.ok { return n; };
        cast = builtinProof(n.st, AstBuiltin::Cast { n: n.v }, push([], "value"), push([], from));
        if !cast.ok { return cast; };
        fn2 = putName(cast.st, field);
        if !fn2.ok { return fn2; };
        on = optNameNode(fn2.st, false, "");
        if !on.ok { return on; };
        return builtinProof(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: fn2.v }, push([], "struct"), push([], cast.v));
    };
    n = putName(st, field);
    if !n.ok { return n; };
    on = optNameNode(n.st, true, litName);
    if !on.ok { return on; };
    return builtinProof(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: n.v }, push([], "struct"), push([], from));
};

// ---- validation statements ----

fn validationNode(st: St, node: AstValidation) -> Res<Int> ~ { return emit(st, AstNode::Validation { value: node }); };

fn stmtNode(st: St, node: AstStatement) -> Res<Int> ~ { return emit(st, AstNode::Statement { value: node }); };

fn proofBuiltinKind(st: &St, id: Int) -> String ~ {
    // the primitive name of a CTerm builtin proof, or "" 
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = "";
        match v {
            AstProof::CTerm { v: vv } => { out = valueBuiltinPrim(st, vv); },
            AstProof::FApp { f: a, xs: b } => { out = ""; },
            AstProof::ATerm { n: a } => { out = ""; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = ""; },
            AstProof::BVar { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn valueBuiltinPrim(st: &St, valueId: Int) -> String ~ {
    n = nodeAt(st, valueId);
    if n is AstNode::Value {
        v = (n as AstNode::Value).value;
        out = "";
        match v {
            AstValue::VFunct { ps: a, ins: b, outs: c, body: d, exports: e } => { out = bodyPrimName(st, d); },
            AstValue::VInt { n: a } => { out = ""; },
            AstValue::VList { xs: a } => { out = ""; },
            AstValue::VBool { b: a } => { out = ""; },
            AstValue::VData { n: a, xs: b } => { out = ""; },
            AstValue::VFnRef { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn bodyPrimName(st: &St, bodyId: Int) -> String ~ {
    n = nodeAt(st, bodyId);
    if n is AstNode::Body {
        v = (n as AstNode::Body).value;
        out = "";
        match v {
            AstBody::BuiltinFunct { b: b } => { out = builtinPrimName(st, b); },
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn builtinPrimName(st: &St, builtinId: Int) -> String ~ {
    n = nodeAt(st, builtinId);
    if n is AstNode::Builtin {
        v = (n as AstNode::Builtin).value;
        out = "";
        match v {
            AstBuiltin::Primitive { name: nm } => { out = clone(nm); },
            AstBuiltin::Ctor { n: a, args: b, fs: c } => { out = ""; },
            AstBuiltin::FieldBuiltin { owner: a, n: b } => { out = ""; },
            AstBuiltin::Is { n: a } => { out = ""; },
            AstBuiltin::Project { n: a, f: b } => { out = ""; },
            AstBuiltin::Cast { n: a } => { out = ""; },
            AstBuiltin::ToWord { signed: a, bits: b } => { out = ""; },
            AstBuiltin::Rel { r: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn proofFAppParts(st: &St, id: Int) -> List<Int> ~ {
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = [];
        match v {
            AstProof::FApp { f: f, xs: xs } => { out = push(push([], f), xs); },
            AstProof::ATerm { n: a } => { out = []; },
            AstProof::CTerm { v: a } => { out = []; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = []; },
            AstProof::BVar { n: a } => { out = []; },
        };
        return out;
    };
    return [];
};

fn proofATermName(st: &St, id: Int) -> String ~ {
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = "";
        match v {
            AstProof::ATerm { n: a } => { out = nameText(st, a); },
            AstProof::FApp { f: a, xs: b } => { out = ""; },
            AstProof::CTerm { v: a } => { out = ""; },
            AstProof::Forall { n: a, gs: b, b: c } => { out = ""; },
            AstProof::BVar { n: a } => { out = ""; },
        };
        return out;
    };
    return "";
};

fn conjunctsOf(st: St, id: Int) -> Res<List<Int>> ~ {
    parts = proofFAppParts(st, id);
    if size(parts) = 2 && proofBuiltinKind(st, get(parts, 0)) = "And" {
        args = proofListIds(st, get(parts, 1));
        if size(args) = 2 {
            l = conjunctsOf(st, get(args, 0));
            if !l.ok { return l; };
            r = conjunctsOf(l.st, get(args, 1));
            if !r.ok { return r; };
            out = clone(l.v);
            for x in r.v { out = push(out, x); };
            return ok(r.st, out);
        };
    };
    return ok(st, push([], id));
};

fn mentionsConnective(st: &St, id: Int) -> Bool ~ {
    k = proofBuiltinKind(st, id);
    if k = "And" || k = "Or" || k = "Not" { return true; };
    parts = proofFAppParts(st, id);
    if size(parts) = 2 {
        if mentionsConnective(st, get(parts, 0)) { return true; };
        for x in proofListIds(st, get(parts, 1)) { if mentionsConnective(st, x) { return true; }; };
        return false;
    };
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        out = false;
        match v {
            AstProof::Forall { n: a, gs: gs, b: b } => {
                out = mentionsConnective(st, b);
                for g in proofListIds(st, gs) { if mentionsConnective(st, g) { out = true; }; };
            },
            AstProof::FApp { f: a, xs: b } => { out = false; },
            AstProof::ATerm { n: a } => { out = false; },
            AstProof::CTerm { v: a } => { out = false; },
            AstProof::BVar { n: a } => { out = false; },
        };
        return out;
    };
    return false;
};

fn copyProof(st: St, id: Int) -> Res<Int> ~ {
    n = nodeAt(st, id);
    if n is AstNode::Proof {
        v = (n as AstNode::Proof).value;
        return match v {
            AstProof::ATerm { n: a } => copyATerm(st, a),
            AstProof::BVar { n: a } => copyBVar(st, a),
            AstProof::CTerm { v: a } => copyCTerm(st, a),
            AstProof::FApp { f: f, xs: xs } => copyFApp(st, f, xs),
            AstProof::Forall { n: a, gs: b, b: c } => copyForall(st, a, b, c),
        };
    };
    return fail(st, 0, "internal: not a proof");
};

fn copyNameId(st: St, id: Int) -> Res<Int> ~ {
    // a fresh copy of a name node chain
    text = nameText(st, id);
    return putName(st, text);
};

fn copyATerm(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return proofNode(nn.st, AstProof::ATerm { n: nn.v });
};

fn copyBVar(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return proofNode(nn.st, AstProof::BVar { n: nn.v });
};

fn copyCTerm(st: St, valueId: Int) -> Res<Int> ~ {
    cv = copyValue(st, valueId);
    if !cv.ok { return cv; };
    return proofNode(cv.st, AstProof::CTerm { v: cv.v });
};

fn copyFApp(st: St, f: Int, xs: Int) -> Res<Int> ~ {
    cf = copyProof(st, f);
    if !cf.ok { return cf; };
    s = clone(cf.st);
    ids = [];
    for x in proofListIds(s, xs) {
        cx = copyProof(s, x);
        if !cx.ok { return cx; };
        s = cx.st;
        ids = push(ids, cx.v);
    };
    lst = proofsList(s, ids);
    if !lst.ok { return lst; };
    return proofNode(lst.st, AstProof::FApp { f: cf.v, xs: lst.v });
};

fn copyForall(st: St, nameId: Int, gs: Int, b: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    s = clone(nn.st);
    ids = [];
    for g in proofListIds(s, gs) {
        cg = copyProof(s, g);
        if !cg.ok { return cg; };
        s = cg.st;
        ids = push(ids, cg.v);
    };
    cb = copyProof(s, b);
    if !cb.ok { return cb; };
    lst = proofsList(cb.st, ids);
    if !lst.ok { return lst; };
    return proofNode(lst.st, AstProof::Forall { n: nn.v, gs: lst.v, b: cb.v });
};

fn copyValue(st: St, id: Int) -> Res<Int> ~ {
    // values in proofs are literals and builtin symbols; copy the node kinds that occur
    n = nodeAt(st, id);
    if n is AstNode::Value {
        v = (n as AstNode::Value).value;
        return match v {
            AstValue::VInt { n: a } => copyVInt(st, a),
            AstValue::VBool { b: b } => emit(st, AstNode::Value { value: AstValue::VBool { b: b } }),
            AstValue::VList { xs: xs } => copyVList(st, xs),
            AstValue::VData { n: a, xs: b } => copyVData(st, a, b),
            AstValue::VFnRef { n: a } => copyVFnRef(st, a),
            AstValue::VFunct { ps: a, ins: b, outs: c, body: d, exports: e } => copyVFunct(st, a, b, c, d, e),
        };
    };
    return fail(st, 0, "internal: not a value");
};

fn copyVInt(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return emit(nn.st, AstNode::Value { value: AstValue::VInt { n: nn.v } });
};

fn copyVFnRef(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return emit(nn.st, AstNode::Value { value: AstValue::VFnRef { n: nn.v } });
};

fn valuesListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Values {
            v = (n as AstNode::Values).value;
            match v {
                AstValues::End => { loop = false; },
                AstValues::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyVList(st: St, xs: Int) -> Res<Int> ~ {
    s = st;
    ids = [];
    for x in valuesListIds(s, xs) {
        cx = copyValue(s, x);
        if !cx.ok { return cx; };
        s = cx.st;
        ids = push(ids, cx.v);
    };
    lst = valuesList(s, ids);
    if !lst.ok { return lst; };
    return emit(lst.st, AstNode::Value { value: AstValue::VList { xs: lst.v } });
};

fn valueFieldsListIds(st: &St, id: Int) -> List<IdPair> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::ValueFields {
            v = (n as AstNode::ValueFields).value;
            match v {
                AstValueFields::End => { loop = false; },
                AstValueFields::Cons { head: h, tail: t } => {
                    hn = nodeAt(st, h);
                    if hn is AstNode::ValueField {
                        hv = (hn as AstNode::ValueField).value;
                        out = push(out, IdPair { a: hv.n, b: hv.v });
                    };
                    cur = t;
                },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyVData(st: St, nameId: Int, xs: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    s = clone(nn.st);
    ids = [];
    for pair in valueFieldsListIds(s, xs) {
        fnn = copyNameId(s, pair.a);
        if !fnn.ok { return fnn; };
        s = fnn.st;
        cv = copyValue(s, pair.b);
        if !cv.ok { return cv; };
        s = cv.st;
        vf = emit(s, AstNode::ValueField { value: AstValueField { n: fnn.v, v: cv.v } });
        s = vf.st;
        ids = push(ids, vf.v);
    };
    lst = valueFieldsList(s, ids);
    if !lst.ok { return lst; };
    return emit(lst.st, AstNode::Value { value: AstValue::VData { n: nn.v, xs: lst.v } });
};

fn copyVFunct(st: St, ps: Int, ins: Int, outs: Int, body: Int, exports: Int) -> Res<Int> ~ {
    // only builtin symbols occur in proofs: params names, two empty validation lists, a Builtin body, empty proofs
    bn = nodeAt(st, body);
    prim = "";
    if bn is AstNode::Body {
        bv = (bn as AstNode::Body).value;
        match bv {
            AstBody::BuiltinFunct { b: b } => { prim = builtinPrimName(st, b); },
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => { prim = ""; },
        };
    };
    if size(prim.bytes) = 0 {
        // a Ctor/Field/etc symbol: rebuild from the builtin node copy
        return copyVFunctGeneric(st, ps, ins, outs, body, exports);
    };
    names = namesListIds(st, ps);
    texts = [];
    for nid in names { texts = push(texts, nameText(st, nid)); };
    return primValue(st, prim);
};

fn copyVFunctGeneric(st: St, ps: Int, ins: Int, outs: Int, body: Int, exports: Int) -> Res<Int> ~ {
    bn = nodeAt(st, body);
    if bn is AstNode::Body {
        bv = (bn as AstNode::Body).value;
        return match bv {
            AstBody::BuiltinFunct { b: b } => copyBuiltinSymbolValue(st, b, ps),
            AstBody::NativeFunct { sig: a, term: b, stmts: c } => fail(st, 0, "internal: cannot copy function value"),
        };
    };
    return fail(st, 0, "internal: cannot copy function value");
};
fn copyBuiltinSymbolValue(st: St, builtinId: Int, ps: Int) -> Res<Int> ~ {
    n = nodeAt(st, builtinId);
    if n is AstNode::Builtin {
        v = (n as AstNode::Builtin).value;
        return match v {
            AstBuiltin::Primitive { name: nm } => primValue(st, nm),
            AstBuiltin::Rel { r: r } => relValue(st, r),
            AstBuiltin::ToWord { signed: a, bits: b } => builtinValue(st, AstBuiltin::ToWord { signed: a, bits: b }, push([], "x")),
            AstBuiltin::Ctor { n: a, args: b, fs: c } => copyCtorSymbol(st, a, b, c),
            AstBuiltin::FieldBuiltin { owner: a, n: b } => copyFieldSymbol(st, a, b),
            AstBuiltin::Is { n: a } => copyIsSymbol(st, a),
            AstBuiltin::Project { n: a, f: b } => copyProjectSymbol(st, a, b),
            AstBuiltin::Cast { n: a } => copyCastSymbol(st, a),
        };
    };
    return fail(st, 0, "internal: cannot copy builtin");
};
fn namesListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Names {
            v = (n as AstNode::Names).value;
            match v {
                AstNames::End => { loop = false; },
                AstNames::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn argsListValues(st: &St, id: Int) -> List<ArgV> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Args {
            v = (n as AstNode::Args).value;
            match v {
                AstArgs::End => { loop = false; },
                AstArgs::Cons { head: h, tail: t } => {
                    hn = nodeAt(st, h);
                    if hn is AstNode::Arg {
                        hv = (hn as AstNode::Arg).value;
                        match hv {
                            AstArg::ArgSize { s: s } => { sn = nodeAt(st, s); if sn is AstNode::Size { out = push(out, ArgV { isSize: true, size: (sn as AstNode::Size).value, ty: Type::TInt }); }; },
                            AstArg::ArgType { t: t } => { tn = nodeAt(st, t); if tn is AstNode::Type { out = push(out, ArgV { isSize: false, size: Size::SAny, ty: (tn as AstNode::Type).value }); }; },
                        };
                    };
                    cur = t;
                },
            };
        } else { loop = false; };
    };
    return out;
};

fn copyCtorSymbol(st: St, nameId: Int, argsId: Int, fsId: Int) -> Res<Int> ~ {
    name = nameText(st, nameId);
    args = argsListValues(st, argsId);
    fields = [];
    for nid in namesListIds(st, fsId) { fields = push(fields, nameText(st, nid)); };
    return ctorValue(st, name, args, fields);
};

fn copyFieldSymbol(st: St, ownerId: Int, nameId: Int) -> Res<Int> ~ {
    name = nameText(st, nameId);
    on = nodeAt(st, ownerId);
    has = false;
    owner = "";
    if on is AstNode::OptName {
        ov = (on as AstNode::OptName).value;
        match ov {
            AstOptName::NoName => { has = false; },
            AstOptName::SomeName { n: a } => { has = true; owner = nameText(st, a); },
        };
    };
    nn = putName(st, name);
    if !nn.ok { return nn; };
    onn = optNameNode(nn.st, has, owner);
    if !onn.ok { return onn; };
    return builtinValue(onn.st, AstBuiltin::FieldBuiltin { owner: onn.v, n: nn.v }, push([], "struct"));
};

fn copyIsSymbol(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return builtinValue(nn.st, AstBuiltin::Is { n: nn.v }, push([], "value"));
};

fn copyCastSymbol(st: St, nameId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    return builtinValue(nn.st, AstBuiltin::Cast { n: nn.v }, push([], "value"));
};

fn copyProjectSymbol(st: St, nameId: Int, fieldId: Int) -> Res<Int> ~ {
    nn = copyNameId(st, nameId);
    if !nn.ok { return nn; };
    ff = copyNameId(nn.st, fieldId);
    if !ff.ok { return ff; };
    return builtinValue(ff.st, AstBuiltin::Project { n: nn.v, f: ff.v }, push([], "value"));
};

// `affirm a && b;` is two statements, and `affirm whole(b);` is two facts
fn splitAffirm(st: St, validationId: Int) -> Res<List<Int>> ~ {
    n = nodeAt(st, validationId);
    isAssert = false;
    proofId = 0;
    if n is AstNode::Validation {
        v = (n as AstNode::Validation).value;
        match v {
            AstValidation::ProofAssert { p: p } => { isAssert = true; proofId = p; },
            AstValidation::Rewrite { r: a } => { isAssert = false; },
            AstValidation::AssignProofVar { n: a, e: b } => { isAssert = false; },
            AstValidation::Assume { p: a } => { isAssert = false; },
        };
    };
    if !isAssert { return ok(st, push([], validationId)); };
    cs = conjunctsOf(st, proofId);
    if !cs.ok { return cs; };
    s = clone(cs.st);
    out = [];
    for q in cs.v {
        if mentionsConnective(s, q) { return fail(s, [], "a proof is not made of || or !: `affirm a && b;` is two statements, and a condition that is not a conjunction is not provable by this validator"); };
        facts = wholeFacts(s, q);
        if !facts.ok { return facts; };
        s = facts.st;
        for f in facts.v { out = push(out, f); };
    };
    return ok(s, out);
};

fn wholeFacts(st: St, q: Int) -> Res<List<Int>> ~ {
    // [validationId] normally; the two facts of whole(b) as ProofAssert validation nodes
    parts = proofFAppParts(st, q);
    if size(parts) = 2 && proofATermName(st, get(parts, 0)) = "whole" {
        args = proofListIds(st, get(parts, 1));
        if size(args) = 1 {
            b = get(args, 0);
            s = st;
            b1 = copyProof(s, b);
            if !b1.ok { return Res<List<Int>> { st: b1.st, v: [], ok: false }; };
            s = b1.st;
            startP = atermProof(s, "start");
            if !startP.ok { return Res<List<Int>> { st: startP.st, v: [], ok: false }; };
            s = startP.st;
            f1 = fappProofRaw(s, startP.v, push([], b1.v));
            if !f1.ok { return Res<List<Int>> { st: f1.st, v: [], ok: false }; };
            s = f1.st;
            zero = intValueProof(s, 0);
            if !zero.ok { return Res<List<Int>> { st: zero.st, v: [], ok: false }; };
            s = zero.st;
            eq1 = relProofOf(s, 0, f1.v, zero.v);
            if !eq1.ok { return Res<List<Int>> { st: eq1.st, v: [], ok: false }; };
            s = eq1.st;
            v1 = validationNode(s, AstValidation::ProofAssert { p: eq1.v });
            if !v1.ok { return Res<List<Int>> { st: v1.st, v: [], ok: false }; };
            s = v1.st;
            b2 = copyProof(s, b);
            if !b2.ok { return Res<List<Int>> { st: b2.st, v: [], ok: false }; };
            s = b2.st;
            capP = atermProof(s, "cap");
            if !capP.ok { return Res<List<Int>> { st: capP.st, v: [], ok: false }; };
            s = capP.st;
            f2 = fappProofRaw(s, capP.v, push([], b2.v));
            if !f2.ok { return Res<List<Int>> { st: f2.st, v: [], ok: false }; };
            s = f2.st;
            b3 = copyProof(s, b);
            if !b3.ok { return Res<List<Int>> { st: b3.st, v: [], ok: false }; };
            s = b3.st;
            orgP = atermProof(s, "origin");
            if !orgP.ok { return Res<List<Int>> { st: orgP.st, v: [], ok: false }; };
            s = orgP.st;
            f3 = fappProofRaw(s, orgP.v, push([], b3.v));
            if !f3.ok { return Res<List<Int>> { st: f3.st, v: [], ok: false }; };
            s = f3.st;
            extP = atermProof(s, "extent");
            if !extP.ok { return Res<List<Int>> { st: extP.st, v: [], ok: false }; };
            s = extP.st;
            f4 = fappProofRaw(s, extP.v, push([], f3.v));
            if !f4.ok { return Res<List<Int>> { st: f4.st, v: [], ok: false }; };
            s = f4.st;
            eq2 = relProofOf(s, 0, f2.v, f4.v);
            if !eq2.ok { return Res<List<Int>> { st: eq2.st, v: [], ok: false }; };
            s = eq2.st;
            v2 = validationNode(s, AstValidation::ProofAssert { p: eq2.v });
            if !v2.ok { return Res<List<Int>> { st: v2.st, v: [], ok: false }; };
            return ok(v2.st, push(push([], v1.v), v2.v));
        };
    };
    single = validationNode(st, AstValidation::ProofAssert { p: q });
    if !single.ok { return Res<List<Int>> { st: single.st, v: [], ok: false }; };
    return ok(single.st, push([], single.v));
};

fn fappProofRaw(st: St, f: Int, args: &List<Int>) -> Res<Int> ~ {
    xs = proofsList(st, args);
    if !xs.ok { return xs; };
    return proofNode(xs.st, AstProof::FApp { f: f, xs: xs.v });
};

fn intValueProof(st: St, n: Int) -> Res<Int> ~ {
    nm = putName(st, String::fromInt(n));
    if !nm.ok { return nm; };
    vn = emit(nm.st, AstNode::Value { value: AstValue::VInt { n: nm.v } });
    if !vn.ok { return vn; };
    return ctermProof(vn.st, vn.v);
};

fn validationStatement(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if keywordAt(s, "rewrite") {
        k = eatKeyword(s, "rewrite");
        s = skipWs(k.st);
        r = rwRule(s);
        if !r.ok { return Res<Int> { st: r.st, v: 0, ok: false }; };
        s = skipWs(r.st);
        rn = emit(s, AstNode::Rule { value: r.v });
        // rwRule returns a rule value wrapped: see rwRule
        return validationNode(rn.st, AstValidation::Rewrite { r: rn.v });
    };
    if keywordAt(s, "affirm") {
        k = eatKeyword(s, "affirm");
        s = skipWs(k.st);
        p = proof(s);
        if !p.ok { return p; };
        s = skipWs(p.st);
        return validationNode(s, AstValidation::ProofAssert { p: p.v });
    };
    if keywordAt(s, "define") {
        k = eatKeyword(s, "define");
        s = skipWs(k.st);
        v = parseVariable(s);
        if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
        s = skipWs(v.st);
        if byteAt(s, s.pos) != 61 { return fail(s, 0, "expected ="); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        e = expression(s);
        if !e.ok { return e; };
        s = skipWs(e.st);
        n = putName(s, v.v);
        if !n.ok { return n; };
        return validationNode(n.st, AstValidation::AssignProofVar { n: n.v, e: e.v });
    };
    return fail(s, 0, "expected a validation statement");
};

fn rwRule(st: St) -> Res<AstRule> ~ {
    v = parseVariable(st);
    if !v.ok { return Res<AstRule> { st: v.st, v: AstRule::EvalAll, ok: false }; };
    s = skipWs(v.st);
    name = v.v;
    if name = "refl" {
        p = proof(s);
        if !p.ok { return Res<AstRule> { st: p.st, v: AstRule::EvalAll, ok: false }; };
        return ok(p.st, AstRule::Refl { p: p.v });
    };
    if name = "eval" {
        w = parseVariable(s);
        if !w.ok { return Res<AstRule> { st: w.st, v: AstRule::EvalAll, ok: false }; };
        n = putName(w.st, w.v);
        if !n.ok { return Res<AstRule> { st: n.st, v: AstRule::EvalAll, ok: false }; };
        return ok(n.st, AstRule::Eval { n: n.v });
    };
    if name = "evalAll" { return ok(s, AstRule::EvalAll); };
    if name = "checkGtZero" {
        p = proof(s);
        if !p.ok { return Res<AstRule> { st: p.st, v: AstRule::EvalAll, ok: false }; };
        return ok(p.st, AstRule::CheckGtZero { p: p.v });
    };
    if name = "checkRel" {
        p = proof(s);
        if !p.ok { return Res<AstRule> { st: p.st, v: AstRule::EvalAll, ok: false }; };
        return ok(p.st, AstRule::CheckRel { p: p.v });
    };
    args = [];
    loop = true;
    while loop ~ {
        save = clone(s);
        p = proof(s);
        if p.ok { s = p.st; args = push(args, p.v); s = skipWs(s); } else { s = save; loop = false; };
    };
    n = putName(s, name);
    if !n.ok { return Res<AstRule> { st: n.st, v: AstRule::EvalAll, ok: false }; };
    xs = proofsList(n.st, args);
    if !xs.ok { return Res<AstRule> { st: xs.st, v: AstRule::EvalAll, ok: false }; };
    return ok(xs.st, AstRule::UserRewrite { n: n.v, xs: xs.v });
};

fn validationBlock(st: St) -> Res<List<Int>> ~ {
    // [{ affirm ...; ... }] -> validations; st is at '['
    s = st;
    if byteAt(s, s.pos) != 91 { return fail(s, [], "expected ["); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if byteAt(s, s.pos) != 123 { return fail(s, [], "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    out = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            v = validationStatement(s);
            if !v.ok { return Res<List<Int>> { st: v.st, v: [], ok: false }; };
            s = v.st;
            parts = splitAffirm(s, v.v);
            if !parts.ok { return parts; };
            s = parts.st;
            for x in parts.v { out = push(out, x); };
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 {
                while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            };
        };
    };
    s = skipWs(s);
    if byteAt(s, s.pos) != 93 { return fail(s, [], "expected ]"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, out);
};

fn optContract(st: St) -> Res<List<Int>> ~ {
    s = skipWs(st);
    if byteAt(s, s.pos) = 91 { return validationBlock(s); };
    return ok(s, []);
};

// ---- function headers ----




fn oneParameter(st: St) -> Res<OneParam> ~ {
    s = skipWs(st);
    ghostly = false;
    g = eatKeyword(s, "ghost");
    if g.v { ghostly = true; s = skipWs(g.st); } else { s = g.st; };
    v = parseVariable(s);
    if !v.ok { return Res<OneParam> { st: v.st, v: OneParam { name: "", ty: Type::TInt }, ok: false }; };
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 58 { return fail(s, OneParam { name: "", ty: Type::TInt }, "expected :"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    t = typeAnnotation(s);
    if !t.ok { return Res<OneParam> { st: t.st, v: OneParam { name: "", ty: Type::TInt }, ok: false }; };
    if ghostly && !ghostTypeOf(clone(t.v)) { return fail(t.st, OneParam { name: "", ty: Type::TInt }, "ghost is written before a type that is a permission, Block<T>"); };
    return ok(t.st, OneParam { name: v.v, ty: t.v });
};

fn parameters(st: St) -> Res<ParamOut> ~ {
    // at '('
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    names = [];
    tys = [];
    if byteAt(s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            p = oneParameter(s);
            if !p.ok { return Res<ParamOut> { st: p.st, v: ParamOut { names: [], types: [] }, ok: false }; };
            s = p.st;
            names = push(names, clone(p.v.name));
            tys = push(tys, p.v.ty);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, ParamOut { names: [], types: [] }, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, ParamOut { names: names, types: tys });
};

fn functHeader(st: St) -> Res<HeaderOut> ~ {
    empty = HeaderOut { names: [], types: [], ret: Type::TInt, ins: [], outs: [], writes: [], froms: [] };
    s = skipWs(st);
    if byteAt(s, s.pos) != 40 { return fail(s, empty, "expected ("); };
    ps = parameters(s);
    if !ps.ok { return Res<HeaderOut> { st: ps.st, v: empty, ok: false }; };
    s = ps.st;
    if !peekIs(s, "->") { return fail(s, empty, "expected ->"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(s);
    rt = typeAnnotation(s);
    if !rt.ok { return Res<HeaderOut> { st: rt.st, v: empty, ok: false }; };
    s = skipWs(rt.st);
    writes = [];
    wk = eatKeyword(s, "writes");
    if wk.v {
        s = skipWs(wk.st);
        if byteAt(s, s.pos) != 40 { return fail(s, empty, "expected ("); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        loop = true;
        while loop ~ {
            place = writePlace(s);
            if !place.ok { return Res<HeaderOut> { st: place.st, v: empty, ok: false }; };
            s = place.st;
            writes = push(writes, place.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
        if byteAt(s, s.pos) != 41 { return fail(s, empty, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
    } else { s = wk.st; };
    froms = [];
    fk = eatKeyword(s, "from");
    if fk.v {
        s = skipWs(fk.st);
        if byteAt(s, s.pos) = 40 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            loop = true;
            while loop ~ {
                v = parseVariable(s);
                if !v.ok { return Res<HeaderOut> { st: v.st, v: empty, ok: false }; };
                s = v.st;
                froms = push(froms, v.v);
                s = skipWs(s);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
            };
            if byteAt(s, s.pos) != 41 { return fail(s, empty, "expected )"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
        } else {
            v = parseVariable(s);
            if !v.ok { return Res<HeaderOut> { st: v.st, v: empty, ok: false }; };
            s = skipWs(v.st);
            froms = push([], v.v);
        };
    } else { s = fk.st; };
    ins = optContract(s);
    if !ins.ok { return Res<HeaderOut> { st: ins.st, v: empty, ok: false }; };
    s = ins.st;
    outs = optContract(s);
    if !outs.ok { return Res<HeaderOut> { st: outs.st, v: empty, ok: false }; };
    s = outs.st;
    return ok(s, HeaderOut { names: ps.v.names, types: ps.v.types, ret: rt.v, ins: ins.v, outs: outs.v, writes: writes, froms: froms });
};

fn writePlace(st: St) -> Res<String> ~ {
    v = parseVariable(st);
    if !v.ok { return v; };
    s = v.st;
    out = v.v;
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 46 {
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            w = parseVariable(s);
            if !w.ok { return w; };
            s = w.st;
            out = cat3(out, ".", w.v);
            s = skipWs(s);
        } else { loop = false; };
    };
    return ok(s, out);
};

fn terminationClause(st: St) -> Res<Int> ~ {
    // an OptTermination node
    s = skipWs(st);
    if byteAt(s, s.pos) = 126 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        t = emit(s, AstNode::Termination { value: AstTermination::MayDiverge });
        if !t.ok { return t; };
        return emit(t.st, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: t.v } });
    };
    k = eatKeyword(s, "shrinks");
    if k.v {
        s = skipWs(k.st);
        e = expression(s);
        if !e.ok { return e; };
        s = skipWs(e.st);
        t = emit(s, AstNode::Termination { value: AstTermination::Shrinks { e: e.v } });
        if !t.ok { return t; };
        return emit(t.st, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: t.v } });
    };
    return emit(k.st, AstNode::OptTermination { value: AstOptTermination::NoTermination });
};

fn signatureNode(st: St, types: &List<Type>, ret: Type, sizes: &List<String>, tps: &List<String>, writes: &List<String>, froms: &List<String>) -> Res<Int> ~ {
    ts = putTypesNodes(st, types);
    if !ts.ok { return ts; };
    rt = putTypeNode(ts.st, ret);
    if !rt.ok { return rt; };
    ss = namesList(rt.st, sizes);
    if !ss.ok { return ss; };
    ps = namesList(ss.st, tps);
    if !ps.ok { return ps; };
    ws = namesList(ps.st, writes);
    if !ws.ok { return ws; };
    fs = namesList(ws.st, froms);
    if !fs.ok { return fs; };
    return emit(fs.st, AstNode::Signature { value: AstSignature { ts: ts.v, ret: rt.v, ss: ss.v, ps: ps.v, ws: ws.v, fs: fs.v } });
};

// ---- statement blocks ----

fn statementBlock(st: St) -> Res<List<Int>> ~ {
    // statements separated by ';', with Marks when locating
    s = st;
    out = [];
    loop = true;
    while loop ~ {
        s = skipWs(s);
        if atEnd(s) || byteAt(s, s.pos) = 125 { loop = false; }
        else {
            startPos = s.pos;
            group = statements(s);
            if !group.ok { return group; };
            s = clone(group.st);
            if s.locate {
                lc = srcLineCol(s, startPos);
                m = emit(s, AstNode::Statement { value: AstStatement::Mark { line: get(lc, 0), col: get(lc, 1) } });
                if !m.ok { return Res<List<Int>> { st: m.st, v: [], ok: false }; };
                s = m.st;
                // the Mark must precede the group in the final list, but nodes are emitted in AstData order:
                // Haskell's Mark is a statement in the list; its record has no children, so emission order is list order.
                out = push(out, m.v);
            };
            for x in group.v { out = push(out, x); };
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 {
                while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
            } else { loop = false; };
        };
    };
    return ok(s, out);
};

fn curlyBlock(st: St) -> Res<List<Int>> ~ {
    s = skipWs(st);
    if byteAt(s, s.pos) != 123 { return fail(s, [], "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    inner = statementBlock(s);
    if !inner.ok { return inner; };
    s = inner.st;
    s = skipWs(s);
    if byteAt(s, s.pos) != 125 { return fail(s, [], "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, inner.v);
};

fn atImportKeyword(st: &St) -> Bool ~ {
    if !peekIs(st, "import") { return false; };
    after = byteAt(st, st.pos + 6);
    return after = 32 || after = 9 || after = 10 || after = 13;
};

fn statements(st: St) -> Res<List<Int>> ~ {
    s = skipWs(st);
    if atImportKeyword(s) { return fail(s, [], "import statements must come before any declaration in a file"); };
    ma = tryMatchAssign(s);
    if ma.ok { return ma; };
    return statementsAfterMatch(ma.st);
};

fn statementsAfterMatch(st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(s, "return") {
        mr = tryMatchReturn(s);
        if mr.ok { return mr; };
        return statementsAfterReturn(mr.st);
    };
    return statementsAfterReturn(s);
};

fn statementsAfterReturn(st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(s, "match") {
        return matchStatement(s);
    };
    if keywordAt(s, "for") {
        return forStatement(s);
    };
    ta = tryTupleAssign(s);
    if ta.ok { return ta; };
    return statementsAfterTuple(ta.st);
};

fn statementsAfterTuple(st: St) -> Res<List<Int>> ~ {
    s = st;
    sa = tryStructAssign(s);
    if sa.ok { return sa; };
    return statementsFinal(sa.st);
};

fn statementsFinal(st: St) -> Res<List<Int>> ~ {
    s = st;
    if keywordAt(s, "assume") {
        return assumeStatements(s);
    };
    if keywordAt(s, "linear") {
        return linearStatements(s);
    };
    if keywordAt(s, "extern") {
        return externStatements(s);
    };
    if keywordAt(s, "builtin") {
        return builtinStatements(s);
    };
    if keywordAt(s, "affirm") {
        v = validationStatement(s);
        if !v.ok { return Res<List<Int>> { st: v.st, v: [], ok: false }; };
        sp = splitAffirm(v.st, v.v);
        if !sp.ok { return sp; };
        s = clone(sp.st);
        out = [];
        for x in sp.v {
            w = emit(s, AstNode::Statement { value: AstStatement::ValidationStatement { v: x } });
            if !w.ok { return Res<List<Int>> { st: w.st, v: [], ok: false }; };
            s = w.st;
            out = push(out, w.v);
        };
        return ok(s, out);
    };
    one = statement(s);
    if !one.ok { return Res<List<Int>> { st: one.st, v: [], ok: false }; };
    return ok(one.st, push([], one.v));
};
fn assumeStatements(st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(st, "assume");
    s = skipWs(k.st);
    p = proof(s);
    if !p.ok { return Res<List<Int>> { st: p.st, v: [], ok: false }; };
    s = skipWs(p.st);
    pa = validationNode(s, AstValidation::ProofAssert { p: p.v });
    if !pa.ok { return Res<List<Int>> { st: pa.st, v: [], ok: false }; };
    sp = splitAffirm(pa.st, pa.v);
    if !sp.ok { return sp; };
    s = clone(sp.st);
    out = [];
    for x in sp.v {
        // ProofAssert becomes Assume; other split results stay as they are (wholeFacts gives ProofAsserts, which become Assume too in Haskell)
        nx = nodeAt(s, x);
        vid = x;
        if nx is AstNode::Validation {
            vv = (nx as AstNode::Validation).value;
            match vv {
                AstValidation::ProofAssert { p: pp } => {
                    a = validationNode(s, AstValidation::Assume { p: pp });
                    if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
                    s = a.st;
                    vid = a.v;
                },
                AstValidation::Rewrite { r: a } => { vid = x; },
                AstValidation::AssignProofVar { n: a, e: b } => { vid = x; },
                AstValidation::Assume { p: a } => { vid = x; },
            };
        };
        w = stmtNode(s, AstStatement::ValidationStatement { v: vid });
        if !w.ok { return Res<List<Int>> { st: w.st, v: [], ok: false }; };
        s = w.st;
        out = push(out, w.v);
    };
    return ok(s, out);
};

fn linearStatements(st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(st, "linear");
    s = skipWs(k.st);
    declared = statement(s);
    if !declared.ok { return Res<List<Int>> { st: declared.st, v: [], ok: false }; };
    s = declared.st;
    n = nodeAt(s, declared.v);
    name = "";
    isStruct = false;
    if n is AstNode::Statement {
        v = (n as AstNode::Statement).value;
        match v {
            AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { name = nameText(s, a); isStruct = true; },
            AstStatement::EnumDef { n: a, vs: b } => { name = nameText(s, a); isStruct = true; },
            AstStatement::Assign { n: a, e: b } => { isStruct = false; },
            AstStatement::AssignDeref { a: a, b: b } => { isStruct = false; },
            AstStatement::Let { n: a, e: b } => { isStruct = false; },
            AstStatement::Return { e: a } => { isStruct = false; },
            AstStatement::ValidationStatement { v: a } => { isStruct = false; },
            AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { isStruct = false; },
            AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { isStruct = false; },
            AstStatement::Block { xs: a } => { isStruct = false; },
            AstStatement::If { e: a, a: b, b: c } => { isStruct = false; },
            AstStatement::While { e: a, vs: b, t: c, xs: d } => { isStruct = false; },
            AstStatement::TraitDef { n: a, ps: b, fs: c } => { isStruct = false; },
            AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { isStruct = false; },
            AstStatement::BoundedDef { bs: a, s: b } => { isStruct = false; },
            AstStatement::Mark { line: a, col: b } => { isStruct = false; },
            AstStatement::CopyDef { n: a } => { isStruct = false; },
            AstStatement::LinearDef { n: a } => { isStruct = false; },
            AstStatement::ExternDef { n: a } => { isStruct = false; },
            AstStatement::DropDef { n: a } => { isStruct = false; },
            AstStatement::Dissolve { n: a } => { isStruct = false; },
        };
    };
    if !isStruct { return fail(s, [], "linear is written before a struct or an enum"); };
    nn = putName(s, name);
    if !nn.ok { return Res<List<Int>> { st: nn.st, v: [], ok: false }; };
    ld = stmtNode(nn.st, AstStatement::LinearDef { n: nn.v });
    if !ld.ok { return Res<List<Int>> { st: ld.st, v: [], ok: false }; };
    return ok(ld.st, push(push([], declared.v), ld.v));
};

fn cWordType(t: Type) -> Bool ~ {
    out = false;
    match t {
        Type::TInt => { out = true; },
        Type::TByte => { out = true; },
        Type::TBool => { out = true; },
        Type::TAddr { inner: e } => { out = true; },
        Type::TBlock { inner: e } => { out = true; },
        Type::TRef { inner: e } => { out = matchRefBlock(Box::unbox(e)); },
        Type::TList { elem: e } => { out = false; },
        Type::TArray { elem: e, size: s } => { out = false; },
        Type::TBox { inner: e } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn matchRefBlock(inner: Type) -> Bool ~ {
    out = false;
    match inner {
        Type::TBlock { inner: x } => { out = true; },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TList { elem: x } => { out = false; },
        Type::TArray { elem: x, size: s } => { out = false; },
        Type::TBox { inner: x } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: x } => { out = false; },
        Type::TMutRef { inner: x } => { out = false; },
        Type::TAddr { inner: x } => { out = false; },
        Type::TUninit { inner: x } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn externStatements(st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(st, "extern");
    s = skipWs(k.st);
    k2 = eatKeyword(s, "fn");
    if !k2.v { return fail(k2.st, [], "expected fn"); };
    s = skipWs(k2.st);
    v = parseVariable(s);
    if !v.ok { return Res<List<Int>> { st: v.st, v: [], ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    h = functHeader(s);
    if !h.ok { return Res<List<Int>> { st: h.st, v: [], ok: false }; };
    s = h.st;
    term = terminationClause(s);
    if !term.ok { return Res<List<Int>> { st: term.st, v: [], ok: false }; };
    s = term.st;
    i = 0;
    for t in h.v.types {
        if !cWordType(clone(t)) { return fail(s, [], cat3(cat3("the parameter ", nameAtOr(h.v.names, i, ""), " of extern fn "), cat3(name, " is not an Int, a Byte, a Bool, an address or a permission", ""), "")); };
        i = i + 1;
    };
    if !cWordType(clone(h.v.ret)) { return fail(s, [], cat3("extern fn ", name, " gives a value that is not an Int, a Byte, a Bool, an address or a permission")); };
    ed = stmtNameNode(s, 2, name);
    if !ed.ok { return Res<List<Int>> { st: ed.st, v: [], ok: false }; };
    s = ed.st;
    fnAssign = functAssign(s, name, h.v, term.v, []);
    if !fnAssign.ok { return Res<List<Int>> { st: fnAssign.st, v: [], ok: false }; };
    return ok(fnAssign.st, push(push([], ed.v), fnAssign.v));
};

fn stmtNameNode(st: St, kind: Int, name: &String) -> Res<Int> ~ {
    // kind: 0 CopyDef, 1 LinearDef, 2 ExternDef, 3 DropDef (LinearDef built elsewhere)
    n = putName(st, name);
    if !n.ok { return n; };
    if kind = 0 { return stmtNode(n.st, AstStatement::CopyDef { n: n.v }); };
    if kind = 2 { return stmtNode(n.st, AstStatement::ExternDef { n: n.v }); };
    if kind = 3 { return stmtNode(n.st, AstStatement::DropDef { n: n.v }); };
    return stmtNode(n.st, AstStatement::LinearDef { n: n.v });
};

fn functAssign(st: St, name: &String, h: HeaderOut, termNode: Int, body: &List<Int>) -> Res<Int> ~ {
    // Assign name (Val (VFunct names ins outs (NativeFunct sig term body) []))
    sig = signatureNode(st, h.types, h.ret, [], [], h.writes, h.froms);
    if !sig.ok { return sig; };
    s = sig.st;
    stmts = statementsList(s, body);
    if !stmts.ok { return stmts; };
    s = stmts.st;
    bodyNode = emit(s, AstNode::Body { value: AstBody::NativeFunct { sig: sig.v, term: termNode, stmts: stmts.v } });
    if !bodyNode.ok { return bodyNode; };
    s = bodyNode.st;
    ps = namesList(s, h.names);
    if !ps.ok { return ps; };
    s = ps.st;
    insL = validationsList(s, h.ins);
    if !insL.ok { return insL; };
    s = insL.st;
    outsL = validationsList(s, h.outs);
    if !outsL.ok { return outsL; };
    s = outsL.st;
    ex = emptyProofs(s);
    if !ex.ok { return ex; };
    s = ex.st;
    vf = emit(s, AstNode::Value { value: AstValue::VFunct { ps: ps.v, ins: insL.v, outs: outsL.v, body: bodyNode.v, exports: ex.v } });
    if !vf.ok { return vf; };
    s = vf.st;
    ve = valExpr(s, vf.v);
    if !ve.ok { return ve; };
    s = ve.st;
    nn = putName(s, name);
    if !nn.ok { return nn; };
    return stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: ve.v });
};

fn builtinStatements(st: St) -> Res<List<Int>> ~ {
    k = eatKeyword(st, "builtin");
    s = skipWs(k.st);
    k2 = eatKeyword(s, "fn");
    if !k2.v { return fail(k2.st, [], "expected fn"); };
    s = skipWs(k2.st);
    v = parseVariable(s);
    if !v.ok { return Res<List<Int>> { st: v.st, v: [], ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    h = functHeader(s);
    if !h.ok { return Res<List<Int>> { st: h.st, v: [], ok: false }; };
    s = h.st;
    prim = declPrimName(name);
    if size(prim.bytes) = 0 { return fail(s, [], cat3("builtin fn ", name, " is not a builtin of the standard library (BuiltinRegistry.builtinDecls)")); };
    exported = [];
    for o in h.v.outs {
        on = nodeAt(s, o);
        isA = false;
        pid = 0;
        if on is AstNode::Validation {
            ov = (on as AstNode::Validation).value;
            match ov {
                AstValidation::ProofAssert { p: pp } => { isA = true; pid = pp; },
                AstValidation::Rewrite { r: a } => { isA = false; },
                AstValidation::AssignProofVar { n: a, e: b } => { isA = false; },
                AstValidation::Assume { p: a } => { isA = false; },
            };
        };
        if !isA { return fail(s, [], cat3("builtin fn ", name, " promises only affirmations in its output contract")); };
        exported = push(exported, pid);
    };
    // Assign name (Val (VFunct params ins [] (BuiltinFunct b) exported))
    ps = namesList(s, h.v.names);
    if !ps.ok { return Res<List<Int>> { st: ps.st, v: [], ok: false }; };
    s = ps.st;
    insL = validationsList(s, h.v.ins);
    if !insL.ok { return Res<List<Int>> { st: insL.st, v: [], ok: false }; };
    s = insL.st;
    outsL = emptyValidations(s);
    if !outsL.ok { return Res<List<Int>> { st: outsL.st, v: [], ok: false }; };
    s = outsL.st;
    bn = primBuiltinNode(s, prim);
    if !bn.ok { return Res<List<Int>> { st: bn.st, v: [], ok: false }; };
    s = bn.st;
    bodyNode = emit(s, AstNode::Body { value: AstBody::BuiltinFunct { b: bn.v } });
    if !bodyNode.ok { return Res<List<Int>> { st: bodyNode.st, v: [], ok: false }; };
    s = bodyNode.st;
    exL = proofsList(s, exported);
    if !exL.ok { return Res<List<Int>> { st: exL.st, v: [], ok: false }; };
    s = exL.st;
    vf = emit(s, AstNode::Value { value: AstValue::VFunct { ps: ps.v, ins: insL.v, outs: outsL.v, body: bodyNode.v, exports: exL.v } });
    if !vf.ok { return Res<List<Int>> { st: vf.st, v: [], ok: false }; };
    s = vf.st;
    ve = valExpr(s, vf.v);
    if !ve.ok { return Res<List<Int>> { st: ve.st, v: [], ok: false }; };
    s = ve.st;
    nn = putName(s, name);
    if !nn.ok { return Res<List<Int>> { st: nn.st, v: [], ok: false }; };
    a = stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: ve.v });
    if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
    return ok(a.st, push([], a.v));
};

fn primBuiltinNode(st: St, prim: &String) -> Res<Int> ~ {
    return emit(st, AstNode::Builtin { value: AstBuiltin::Primitive { name: clone(prim) } });
};

fn statement(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if keywordAt(s, "return") {
        k = eatKeyword(s, "return");
        s2 = skipWs(k.st);
        e = expression(s2);
        if !e.ok { return e; };
        s = skipWs(e.st);
        return stmtNode(s, AstStatement::Return { e: e.v });
    };
    if keywordAt(s, "if") { return ifStatement(s); };
    if keywordAt(s, "while") { return whileStatement(s); };
    if keywordAt(s, "axiom") { return axiomStatement(s); };
    if keywordAt(s, "proof") { return proofDefStatement(s); };
    if keywordAt(s, "rewrite") || keywordAt(s, "affirm") || keywordAt(s, "define") {
        v = validationStatement(s);
        if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
        return stmtNode(v.st, AstStatement::ValidationStatement { v: v.v });
    };
    if keywordAt(s, "struct") { return structStatement(s); };
    if keywordAt(s, "enum") { return enumStatement(s); };
    if keywordAt(s, "trait") { return traitStatement(s); };
    if keywordAt(s, "impl") { return implStatement(s); };
    if keywordAt(s, "fn") { return functStatement(s); };
    if byteAt(s, s.pos) = 123 {
        inner = curlyBlock(s);
        if !inner.ok { return Res<Int> { st: inner.st, v: 0, ok: false }; };
        lst = statementsList(inner.st, inner.v);
        if !lst.ok { return lst; };
        return stmtNode(lst.st, AstStatement::Block { xs: lst.v });
    };
    // deref assignment, then call/assign
    da = tryDerefAssign(s);
    if da.ok { return da; };
    s = da.st;
    // assign: variable = (not ==)
    save = clone(s);
    v = parseVariable(s);
    if v.ok {
        s2 = skipWs(v.st);
        if byteAt(s2, s2.pos) = 61 && byteAt(s2, s2.pos + 1) != 61 {
            s2 = St { pos: s2.pos + 1, ..s2 };
            s2 = skipWs(s2);
            e = expression(s2);
            if !e.ok { return e; };
            s = skipWs(e.st);
            nn = putName(s, v.v);
            if !nn.ok { return nn; };
            return stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: e.v });
        };
    };
    s = save;
    // call statement
    startPos = s.pos;
    e = expression(s);
    if !e.ok { return e; };
    s = skipWs(e.st);
    parts = exprParts(s, e.v);
    if size(parts) = 2 {
        fname = exprVarName(s, get(parts, 0));
        if size(fname.bytes) > 0 || nodeIsVar(s, get(parts, 0)) {
            lc = srcLineCol(s, startPos);
            held = cat3("$call ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
            nn = putName(s, held);
            if !nn.ok { return nn; };
            return stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: e.v });
        };
    };
    return fail(s, 0, "a statement that is a call, or an assignment");
};

fn nodeIsVar(st: &St, id: Int) -> Bool ~ {
    n = nodeAt(st, id);
    if n is AstNode::Expression {
        v = (n as AstNode::Expression).value;
        out = false;
        match v {
            AstExpression::Var { n: a } => { out = true; },
            AstExpression::Val { v: a } => { out = false; },
            AstExpression::F { f: a, xs: b } => { out = false; },
        };
        return out;
    };
    return false;
};

fn ifStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "if");
    s = skipWs(k.st);
    cond = expression(s);
    if !cond.ok { return cond; };
    s = skipWs(cond.st);
    thenB = curlyBlock(s);
    if !thenB.ok { return Res<Int> { st: thenB.st, v: 0, ok: false }; };
    s = thenB.st;
    elseStmts = [];
    ek = eatKeyword(s, "else");
    ekSt = ek.st;
    if ek.v {
        s = skipWs(ekSt);
        if keywordAt(s, "if") {
            nested = ifStatement(s);
            if !nested.ok { return nested; };
            s = nested.st;
            elseStmts = push([], nested.v);
        } else {
            eb = curlyBlock(s);
            if !eb.ok { return Res<Int> { st: eb.st, v: 0, ok: false }; };
            s = eb.st;
            elseStmts = eb.v;
        };
    } else { s = ekSt; };
    a = statementsList(s, thenB.v);
    if !a.ok { return a; };
    b = statementsList(a.st, elseStmts);
    if !b.ok { return b; };
    return stmtNode(b.st, AstStatement::If { e: cond.v, a: a.v, b: b.v });
};

fn whileStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "while");
    s = skipWs(k.st);
    cond = expression(s);
    if !cond.ok { return cond; };
    s = skipWs(cond.st);
    inv = optContract(s);
    if !inv.ok { return Res<Int> { st: inv.st, v: 0, ok: false }; };
    s = skipWs(inv.st);
    term = terminationClause(s);
    if !term.ok { return term; };
    s = term.st;
    body = curlyBlock(s);
    if !body.ok { return Res<Int> { st: body.st, v: 0, ok: false }; };
    s = body.st;
    vs = validationsList(s, inv.v);
    if !vs.ok { return vs; };
    xs = statementsList(vs.st, body.v);
    if !xs.ok { return xs; };
    return stmtNode(xs.st, AstStatement::While { e: cond.v, vs: vs.v, t: term.v, xs: xs.v });
};

fn axiomStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "axiom");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 40 { return fail(s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    args = [];
    if byteAt(s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            w = parseVariable(s);
            if !w.ok { return Res<Int> { st: w.st, v: 0, ok: false }; };
            s = w.st;
            args = push(args, w.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    ins = validationBlock(s);
    if !ins.ok { return Res<Int> { st: ins.st, v: 0, ok: false }; };
    s = ins.st;
    outs = validationBlock(s);
    if !outs.ok { return Res<Int> { st: outs.st, v: 0, ok: false }; };
    s = outs.st;
    nn = putName(s, name);
    if !nn.ok { return nn; };
    ps = namesList(nn.st, args);
    if !ps.ok { return ps; };
    il = validationsList(ps.st, ins.v);
    if !il.ok { return il; };
    ol = validationsList(il.st, outs.v);
    if !ol.ok { return ol; };
    return stmtNode(ol.st, AstStatement::AxiomDef { n: nn.v, ps: ps.v, ins: il.v, outs: ol.v });
};

fn proofDefStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "proof");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 40 { return fail(s, 0, "expected ("); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    args = [];
    if byteAt(s, s.pos) != 41 {
        loop = true;
        while loop ~ {
            w = parseVariable(s);
            if !w.ok { return Res<Int> { st: w.st, v: 0, ok: false }; };
            s = w.st;
            args = push(args, w.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    ins = validationBlock(s);
    if !ins.ok { return Res<Int> { st: ins.st, v: 0, ok: false }; };
    s = ins.st;
    outs = validationBlock(s);
    if !outs.ok { return Res<Int> { st: outs.st, v: 0, ok: false }; };
    s = outs.st;
    if byteAt(s, s.pos) != 123 { return fail(s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    bodyVals = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            vv = validationStatement(s);
            if !vv.ok { return Res<Int> { st: vv.st, v: 0, ok: false }; };
            s = vv.st;
            sp = splitAffirm(s, vv.v);
            if !sp.ok { return Res<Int> { st: sp.st, v: 0, ok: false }; };
            s = sp.st;
            for x in sp.v { bodyVals = push(bodyVals, x); };
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 { while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); }; };
        };
    };
    s = skipWs(s);
    nn = putName(s, name);
    if !nn.ok { return nn; };
    ps = namesList(nn.st, args);
    if !ps.ok { return ps; };
    il = validationsList(ps.st, ins.v);
    if !il.ok { return il; };
    ol = validationsList(il.st, outs.v);
    if !ol.ok { return ol; };
    bl = validationsList(ol.st, bodyVals);
    if !bl.ok { return bl; };
    return stmtNode(bl.st, AstStatement::ProofDef { n: nn.v, ps: ps.v, ins: il.v, outs: ol.v, body: bl.v });
};

fn tryDerefAssign(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    save = clone(s);
    lhs = derefPlace(s);
    if !lhs.ok { return Res<Int> { st: save, v: 0, ok: false }; };
    s = skipWs(lhs.st);
    if byteAt(s, s.pos) = 61 && byteAt(s, s.pos + 1) != 61 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        e = expression(s);
        if !e.ok { return e; };
        s = skipWs(e.st);
        return stmtNode(s, AstStatement::AssignDeref { a: lhs.v, b: e.v });
    };
    return Res<Int> { st: save, v: 0, ok: false };
};

fn derefPlace(st: St) -> Res<Int> ~ {
    // withFields over (derefExpression | parens derefExpression), no method calls
    s = st;
    base = derefBase(s);
    if !base.ok { return base; };
    acc = base.v;
    s = base.st;
    loop = true;
    while loop ~ {
        s = skipWs(s);
        k = eatKeyword(clone(s), "as");
        if k.v {
            s2 = skipWs(k.st);
            dc = declaredCtorNode(s2);
            if !dc.ok { return Res<Int> { st: dc.st, v: 0, ok: false }; };
            s = dc.st;
            cast = castExprOf(s, dc.v, acc);
            if !cast.ok { return cast; };
            s = cast.st;
            acc = cast.v;
            s = skipWs(s);
        } else {
            s = k.st;
            if byteAt(s, s.pos) = 46 && byteAt(s, s.pos + 1) != 46 {
                s = St { pos: s.pos + 1, ..s };
                fname = "";
                if byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 {
                    start = s.pos;
                    while byteAt(s, s.pos) >= 48 && byteAt(s, s.pos) <= 57 ~ { s = St { pos: s.pos + 1, ..s }; };
                    fname = srcSlice(s, start, s.pos);
                } else {
                    v = parseVariable(s);
                    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
                    fname = v.v;
                    s = v.st;
                };
                fe = fieldExprOf(s, fname, acc);
                if !fe.ok { return fe; };
                s = fe.st;
                acc = fe.v;
                s = skipWs(s);
            } else { loop = false; };
        };
    };
    return ok(s, acc);
};

fn derefBase(st: St) -> Res<Int> ~ {
    s = skipWs(st);
    if byteAt(s, s.pos) = 42 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = nonInfixExpr(s);
        if !inner.ok { return inner; };
        return primExpr(inner.st, "DerefOf", push([], inner.v));
    };
    if byteAt(s, s.pos) = 40 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        inner = derefBase(s);
        if !inner.ok { return inner; };
        s = skipWs(inner.st);
        if byteAt(s, s.pos) != 41 { return fail(s, 0, "expected )"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        return ok(s, inner.v);
    };
    return fail(s, 0, "expected a dereference");
};

// ---- match ----


fn matchArmsHead(st: St) -> Res<Int> ~ {
    // consumes `match scrutinee {`; returns the scrutinee expression node; arms parsed by matchArmsRest
    return ok(st, 0);
};


fn matchHead(st: St) -> Res<MatchHead> ~ {
    k = eatKeyword(st, "match");
    if !k.v { return fail(k.st, MatchHead { scrutinee: 0 }, "expected match"); };
    s = skipWs(k.st);
    sc = expression(s);
    if !sc.ok { return Res<MatchHead> { st: sc.st, v: MatchHead { scrutinee: 0 }, ok: false }; };
    s = skipWs(sc.st);
    if byteAt(s, s.pos) != 123 { return fail(s, MatchHead { scrutinee: 0 }, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, MatchHead { scrutinee: sc.v });
};

fn matchArmBlock(st: St) -> Res<Arm> ~ {
    // Variant { field: var, ... } => { statements }
    dc = declaredCtorNode(st);
    if !dc.ok { return Res<Arm> { st: dc.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(dc.st);
    fields = [];
    vars = [];
    if byteAt(s, s.pos) = 123 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        if byteAt(s, s.pos) != 125 {
            loop = true;
            while loop ~ {
                f = parseVariable(s);
                if !f.ok { return Res<Arm> { st: f.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(f.st);
                if byteAt(s, s.pos) != 58 { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                v = parseVariable(s);
                if !v.ok { return Res<Arm> { st: v.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(v.st);
                fields = push(fields, f.v);
                vars = push(vars, v.v);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop = false; }; } else { loop = false; };
            };
        };
        if byteAt(s, s.pos) != 125 { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected }"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
    };
    declared = findCtorPath(s, dc.v);
    for f in fields { if !containsName(declared, f) { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, cat3(cat3("Variant ", dc.v, " has no field "), f, "")); }; };
    if hasDupStrings(fields) { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, cat3("Pattern ", dc.v, " repeats a field")); };
    if !peekIs(s, "=>") { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected =>"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(s);
    body = curlyBlock(s);
    if !body.ok { return Res<Arm> { st: body.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = body.st;
    if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
    return ok(s, Arm { name: dc.v, fields: fields, vars: vars, body: body.v });
};

fn matchStatement(st: St) -> Res<List<Int>> ~ {
    head = matchHead(st);
    if !head.ok { return Res<List<Int>> { st: head.st, v: [], ok: false }; };
    s = head.st;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); loop = false; }
        else {
            a = matchArmBlock(s);
            if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
            s = a.st;
            arms = push(arms, a.v);
        };
    };
    return desugarMatch(s, head.v.scrutinee, arms);
};

fn desugarMatch(st: St, scrutinee: Int, arms: &List<Arm>) -> Res<List<Int>> ~ {
    if size(arms) = 0 { return fail(st, [], "A match needs at least one arm"); };
    first = clone(get(arms, 0).name);
    typeName = "";
    variants = [];
    bestLen = 0 - 1;
    for c in st.types {
        for v in c.variants {
            if samePath(first, v) {
                vl = size(splitPath(v));
                if vl >= bestLen { bestLen = vl; typeName = clone(c.name); variants = clone(c.variants); };
            };
        };
    };
    if size(typeName.bytes) = 0 { return fail(st, [], cat3("Unknown variant ", first, "")); };
    names = [];
    for a in arms { names = push(names, clone(a.name)); };
    for n in names {
        covered = false;
        for v in variants { if samePath(n, v) { covered = true; }; };
        if !covered { return fail(st, [], cat3(cat3("A match over ", typeName, " has an arm of another type"), "", "")); };
    };
    if hasDupStrings(names) { return fail(st, [], cat3("A match over ", typeName, " repeats a variant")); };
    missing = [];
    for v in variants {
        covered = false;
        for n in names { if samePath(v, n) { covered = true; }; };
        if !covered { missing = push(missing, clone(v)); };
    };
    if size(missing) > 0 {
        joined = "";
        j = 0;
        for m in missing { if j > 0 { joined = catStrings(joined, " "); }; joined = catStrings(joined, m); j = j + 1; };
        return fail(st, [], cat3(cat3("A match over ", typeName, " does not cover "), joined, ""));
    };
    s = st;
    if size(arms) = 1 {
        a = clone(get(arms, 0));
        return desugarSingle(s, scrutinee, a);
    };
    hidden = putName(s, "$match");
    if !hidden.ok { return Res<List<Int>> { st: hidden.st, v: [], ok: false }; };
    s = hidden.st;
    chain = matchChainRest(s, arms, 0);
    if !chain.ok { return chain; };
    s = chain.st;
    // the chain was built against a subject variable node built inside matchChain; rebuild the Let now
    letNode = stmtNode(s, AstStatement::Let { n: hidden.v, e: scrutinee });
    if !letNode.ok { return Res<List<Int>> { st: letNode.st, v: [], ok: false }; };
    s = letNode.st;
    out = push([], letNode.v);
    for x in chain.v { out = push(out, x); };
    return ok(s, out);
};

fn desugarSingle(st: St, scrutinee: Int, a: Arm) -> Res<List<Int>> ~ {
    s = st;
    binds = matchBindings(s, clone(a));
    if !binds.ok { return binds; };
    s = binds.st;
    inner = clone(binds.v);
    for x in a.body { inner = push(inner, x); };
    // Block(Let $match scrutinee : bindings ++ body); the Let name node
    hidden = putName(s, "$match");
    if !hidden.ok { return Res<List<Int>> { st: hidden.st, v: [], ok: false }; };
    s = hidden.st;
    letNode = stmtNode(s, AstStatement::Let { n: hidden.v, e: scrutinee });
    if !letNode.ok { return Res<List<Int>> { st: letNode.st, v: [], ok: false }; };
    s = letNode.st;
    all = push([], letNode.v);
    for x in inner { all = push(all, x); };
    lst = statementsList(s, all);
    if !lst.ok { return Res<List<Int>> { st: lst.st, v: [], ok: false }; };
    blk = stmtNode(lst.st, AstStatement::Block { xs: lst.v });
    if !blk.ok { return Res<List<Int>> { st: blk.st, v: [], ok: false }; };
    return ok(blk.st, push([], blk.v));
};

fn matchBindings(st: St, a: Arm) -> Res<List<Int>> ~ {
    s = st;
    out = [];
    i = 0;
    for field in a.fields {
        var = nameAtOr(a.vars, i, "");
        subj = varExprNode(s, "$match");
        if !subj.ok { return Res<List<Int>> { st: subj.st, v: [], ok: false }; };
        s = subj.st;
        proj = projectExprOf(s, a.name, field, subj.v);
        if !proj.ok { return Res<List<Int>> { st: proj.st, v: [], ok: false }; };
        s = proj.st;
        nn = putName(s, var);
        if !nn.ok { return Res<List<Int>> { st: nn.st, v: [], ok: false }; };
        s = nn.st;
        letNode = stmtNode(s, AstStatement::Let { n: nn.v, e: proj.v });
        if !letNode.ok { return Res<List<Int>> { st: letNode.st, v: [], ok: false }; };
        s = letNode.st;
        out = push(out, letNode.v);
        i = i + 1;
    };
    return ok(s, out);
};

fn matchChain(st: St, arms: &List<Arm>, index: Int) -> Res<List<Int>> ~ {
    a = armAt(arms, index);
    if index = size(arms) - 1 {
        return matchBindings(st, a);
        // plus body appended by caller? Haskell chain last = bindings ++ body
    };
    return matchChainRest(st, arms, index);
};

fn matchChainRest(st: St, arms: &List<Arm>, index: Int) -> Res<List<Int>> ~ {
    a = armAt(arms, index);
    s = st;
    if index = size(arms) - 1 {
        binds = matchBindings(s, clone(a));
        if !binds.ok { return binds; };
        s = binds.st;
        out = clone(binds.v);
        for x in a.body { out = push(out, x); };
        return ok(s, out);
    };
    binds = matchBindings(s, clone(a));
    if !binds.ok { return binds; };
    s = binds.st;
    thenStmts = clone(binds.v);
    for x in a.body { thenStmts = push(thenStmts, x); };
    rest = matchChainRest(s, arms, index + 1);
    if !rest.ok { return rest; };
    s = rest.st;
    subj = varExprNode(s, "$match");
    if !subj.ok { return Res<List<Int>> { st: subj.st, v: [], ok: false }; };
    s = subj.st;
    isN = isExprOf(s, a.name, subj.v);
    if !isN.ok { return Res<List<Int>> { st: isN.st, v: [], ok: false }; };
    s = isN.st;
    aL = statementsList(s, thenStmts);
    if !aL.ok { return Res<List<Int>> { st: aL.st, v: [], ok: false }; };
    s = aL.st;
    bL = statementsList(s, rest.v);
    if !bL.ok { return Res<List<Int>> { st: bL.st, v: [], ok: false }; };
    s = bL.st;
    ifNode = stmtNode(s, AstStatement::If { e: isN.v, a: aL.v, b: bL.v });
    if !ifNode.ok { return Res<List<Int>> { st: ifNode.st, v: [], ok: false }; };
    return ok(ifNode.st, push([], ifNode.v));
};

fn tryMatchAssign(st: St) -> Res<List<Int>> ~ {
    save = clone(st);
    v = parseVariable(st);
    if !v.ok { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 61 || byteAt(s, s.pos + 1) = 61 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if !keywordAt(s, "match") { return Res<List<Int>> { st: save, v: [], ok: false }; };
    head = matchHead(s);
    if !head.ok { return Res<List<Int>> { st: head.st, v: [], ok: false }; };
    s = head.st;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); loop = false; }
        else {
            a = matchArmExpr(s);
            if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
            s = a.st;
            // body becomes [Assign var body]
            bodyExpr = intAtOr(a.v.body, 0, 0);
            an = putName(s, v.v);
            if !an.ok { return Res<List<Int>> { st: an.st, v: [], ok: false }; };
            s = an.st;
            assign = stmtNode(s, AstStatement::Assign { n: an.v, e: bodyExpr });
            if !assign.ok { return Res<List<Int>> { st: assign.st, v: [], ok: false }; };
            s = assign.st;
            arms = push(arms, Arm { name: a.v.name, fields: a.v.fields, vars: a.v.vars, body: push([], assign.v) });
        };
    };
    return desugarMatch(s, head.v.scrutinee, arms);
};

fn matchArmExpr(st: St) -> Res<Arm> ~ {
    dc = declaredCtorNode(st);
    if !dc.ok { return Res<Arm> { st: dc.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(dc.st);
    fields = [];
    vars = [];
    if byteAt(s, s.pos) = 123 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        if byteAt(s, s.pos) != 125 {
            loop = true;
            while loop ~ {
                f = parseVariable(s);
                if !f.ok { return Res<Arm> { st: f.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(f.st);
                if byteAt(s, s.pos) != 58 { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected :"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                v = parseVariable(s);
                if !v.ok { return Res<Arm> { st: v.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
                s = skipWs(v.st);
                fields = push(fields, f.v);
                vars = push(vars, v.v);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop = false; }; } else { loop = false; };
            };
        };
        if byteAt(s, s.pos) != 125 { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected }"); };
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
    };
    declared = findCtorPath(s, dc.v);
    for f in fields { if !containsName(declared, f) { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, cat3(cat3("Variant ", dc.v, " has no field "), f, "")); }; };
    if hasDupStrings(fields) { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, cat3("Pattern ", dc.v, " repeats a field")); };
    if !peekIs(s, "=>") { return fail(s, Arm { name: "", fields: [], vars: [], body: [] }, "expected =>"); };
    s = St { pos: s.pos + 2, ..s };
    s = skipWs(s);
    body = expression(s);
    if !body.ok { return Res<Arm> { st: body.st, v: Arm { name: "", fields: [], vars: [], body: [] }, ok: false }; };
    s = skipWs(body.st);
    if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); };
    return ok(s, Arm { name: dc.v, fields: fields, vars: vars, body: push([], body.v) });
};

fn tryMatchReturn(st: St) -> Res<List<Int>> ~ {
    save = clone(st);
    k = eatKeyword(st, "return");
    if !k.v { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = skipWs(k.st);
    if !keywordAt(s, "match") { return Res<List<Int>> { st: save, v: [], ok: false }; };
    head = matchHead(s);
    if !head.ok { return Res<List<Int>> { st: head.st, v: [], ok: false }; };
    s = head.st;
    arms = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); loop = false; }
        else {
            a = matchArmExpr(s);
            if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
            s = a.st;
            bodyExpr = intAtOr(a.v.body, 0, 0);
            rn = stmtNode(s, AstStatement::Return { e: bodyExpr });
            if !rn.ok { return Res<List<Int>> { st: rn.st, v: [], ok: false }; };
            s = rn.st;
            arms = push(arms, Arm { name: a.v.name, fields: a.v.fields, vars: a.v.vars, body: push([], rn.v) });
        };
    };
    return desugarMatch(s, head.v.scrutinee, arms);
};

// ---- for loops ----

fn assignsVar(st: &St, var: &String, stmts: &List<Int>) -> Bool ~ {
    for id in stmts {
        n = nodeAt(st, id);
        if n is AstNode::Statement {
            v = (n as AstNode::Statement).value;
            found = false;
            match v {
                AstStatement::Assign { n: a, e: b } => { found = nameText(st, a) = var; },
                AstStatement::Block { xs: xs } => { found = assignsVar(st, var, statementsListIds(st, xs)); },
                AstStatement::If { e: a, a: b, b: c } => { found = assignsVar(st, var, statementsListIds(st, b)) || assignsVar(st, var, statementsListIds(st, c)); },
                AstStatement::While { e: a, vs: b, t: c, xs: xs } => { found = assignsVar(st, var, statementsListIds(st, xs)); },
                AstStatement::AssignDeref { a: a, b: b } => { found = false; },
                AstStatement::Let { n: a, e: b } => { found = false; },
                AstStatement::Return { e: a } => { found = false; },
                AstStatement::ValidationStatement { v: a } => { found = false; },
                AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { found = false; },
                AstStatement::EnumDef { n: a, vs: b } => { found = false; },
                AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { found = false; },
                AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { found = false; },
                AstStatement::TraitDef { n: a, ps: b, fs: c } => { found = false; },
                AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { found = false; },
                AstStatement::BoundedDef { bs: a, s: b } => { found = false; },
                AstStatement::Mark { line: a, col: b } => { found = false; },
                AstStatement::CopyDef { n: a } => { found = false; },
                AstStatement::LinearDef { n: a } => { found = false; },
                AstStatement::ExternDef { n: a } => { found = false; },
                AstStatement::DropDef { n: a } => { found = false; },
                AstStatement::Dissolve { n: a } => { found = false; },
            };
            if found { return true; };
        };
    };
    return false;
};

fn statementsListIds(st: &St, id: Int) -> List<Int> ~ {
    out = [];
    cur = id;
    loop = true;
    while loop ~ {
        n = nodeAt(st, cur);
        if n is AstNode::Statements {
            v = (n as AstNode::Statements).value;
            match v {
                AstStatements::End => { loop = false; },
                AstStatements::Cons { head: h, tail: t } => { out = push(out, h); cur = t; },
            };
        } else { loop = false; };
    };
    return out;
};

fn forStatement(st: St) -> Res<List<Int>> ~ {
    startPos = st.pos;
    k = eatKeyword(st, "for");
    s = skipWs(k.st);
    first = parseVariable(s);
    if !first.ok { return Res<List<Int>> { st: first.st, v: [], ok: false }; };
    s = skipWs(first.st);
    second = "";
    hasSecond = false;
    if byteAt(s, s.pos) = 44 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        w = parseVariable(s);
        if !w.ok { return Res<List<Int>> { st: w.st, v: [], ok: false }; };
        second = w.v;
        hasSecond = true;
        s = skipWs(w.st);
    };
    ik = eatKeyword(s, "in");
    if !ik.v { return fail(ik.st, [], "expected in"); };
    s = skipWs(ik.st);
    start = expression(s);
    if !start.ok { return Res<List<Int>> { st: start.st, v: [], ok: false }; };
    s = skipWs(start.st);
    hasEnd = false;
    endExpr = 0;
    if peekIs(s, "..") {
        s = St { pos: s.pos + 2, ..s };
        s = skipWs(s);
        e = expression(s);
        if !e.ok { return Res<List<Int>> { st: e.st, v: [], ok: false }; };
        endExpr = e.v;
        hasEnd = true;
        s = skipWs(e.st);
    };
    inv = optContract(s);
    if !inv.ok { return Res<List<Int>> { st: inv.st, v: [], ok: false }; };
    s = inv.st;
    body = curlyBlock(s);
    if !body.ok { return Res<List<Int>> { st: body.st, v: [], ok: false }; };
    s = body.st;
    lc = srcLineCol(s, startPos);
    place = catStrings(String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    if hasSecond && hasEnd { return fail(s, [], "A for loop over a range has one variable, as in for i in 0..n"); };
    if hasEnd {
        return countingLoop(s, first.v, start.v, endExpr, inv.v, body.v);
    };
    if hasSecond {
        indexName = first.v;
        element = second;
        listName = catStrings("$list ", place);
        an = putName(s, listName);
        if !an.ok { return Res<List<Int>> { st: an.st, v: [], ok: false }; };
        s = an.st;
        assignList = stmtNode(s, AstStatement::Assign { n: an.v, e: start.v });
        if !assignList.ok { return Res<List<Int>> { st: assignList.st, v: [], ok: false }; };
        s = assignList.st;
        loopStmts = elementLoopBody(s, place, indexName, element, listName, inv.v, body.v);
        if !loopStmts.ok { return loopStmts; };
        s = loopStmts.st;
        out = push([], assignList.v);
        for x in loopStmts.v { out = push(out, x); };
        return ok(s, out);
    };
    indexName = catStrings("$index ", place);
    element = first.v;
    listName = catStrings("$list ", place);
    an = putName(s, listName);
    if !an.ok { return Res<List<Int>> { st: an.st, v: [], ok: false }; };
    s = an.st;
    assignList = stmtNode(s, AstStatement::Assign { n: an.v, e: start.v });
    if !assignList.ok { return Res<List<Int>> { st: assignList.st, v: [], ok: false }; };
    s = assignList.st;
    loopStmts = elementLoopBody(s, place, indexName, element, listName, inv.v, body.v);
    if !loopStmts.ok { return loopStmts; };
    s = loopStmts.st;
    out = push([], assignList.v);
    for x in loopStmts.v { out = push(out, x); };
    return ok(s, out);
};

fn elementLoopBody(st: St, place: &String, indexName: &String, element: &String, listName: &String, inv: &List<Int>, body: &List<Int>) -> Res<List<Int>> ~ {
    s = st;
    listVar = varExprNode(s, listName);
    if !listVar.ok { return Res<List<Int>> { st: listVar.st, v: [], ok: false }; };
    s = listVar.st;
    sizeE = primExpr(s, "Size", push([], listVar.v));
    if !sizeE.ok { return Res<List<Int>> { st: sizeE.st, v: [], ok: false }; };
    s = sizeE.st;
    listVar2 = varExprNode(s, listName);
    if !listVar2.ok { return Res<List<Int>> { st: listVar2.st, v: [], ok: false }; };
    s = listVar2.st;
    idxVar = varExprNode(s, indexName);
    if !idxVar.ok { return Res<List<Int>> { st: idxVar.st, v: [], ok: false }; };
    s = idxVar.st;
    getE = primExpr(s, "Get", push(push([], listVar2.v), idxVar.v));
    if !getE.ok { return Res<List<Int>> { st: getE.st, v: [], ok: false }; };
    s = getE.st;
    en = putName(s, element);
    if !en.ok { return Res<List<Int>> { st: en.st, v: [], ok: false }; };
    s = en.st;
    letNode = stmtNode(s, AstStatement::Let { n: en.v, e: getE.v });
    if !letNode.ok { return Res<List<Int>> { st: letNode.st, v: [], ok: false }; };
    s = letNode.st;
    innerBody = push([], letNode.v);
    for x in body { innerBody = push(innerBody, x); };
    zero = intExpr(s, 0);
    if !zero.ok { return Res<List<Int>> { st: zero.st, v: [], ok: false }; };
    s = zero.st;
    return countingLoop(s, indexName, zero.v, sizeE.v, inv, innerBody);
};

fn intExpr(st: St, n: Int) -> Res<Int> ~ {
    nm = putName(st, String::fromInt(n));
    if !nm.ok { return nm; };
    vn = emit(nm.st, AstNode::Value { value: AstValue::VInt { n: nm.v } });
    if !vn.ok { return vn; };
    return valExpr(vn.st, vn.v);
};

fn countingLoop(st: St, var: &String, lo: Int, hi: Int, inv: &List<Int>, body: &List<Int>) -> Res<List<Int>> ~ {
    if assignsVar(st, var, body) { return fail(st, [], cat3("The body of a for loop cannot assign its loop variable ", var, "")); };
    s = st;
    loName = catStrings("$lo ", var);
    hiName = catStrings("$hi ", var);
    an1 = putName(s, loName);
    if !an1.ok { return Res<List<Int>> { st: an1.st, v: [], ok: false }; };
    s = an1.st;
    a1 = stmtNode(s, AstStatement::Assign { n: an1.v, e: lo });
    if !a1.ok { return Res<List<Int>> { st: a1.st, v: [], ok: false }; };
    s = a1.st;
    an2 = putName(s, hiName);
    if !an2.ok { return Res<List<Int>> { st: an2.st, v: [], ok: false }; };
    s = an2.st;
    a2 = stmtNode(s, AstStatement::Assign { n: an2.v, e: hi });
    if !a2.ok { return Res<List<Int>> { st: a2.st, v: [], ok: false }; };
    s = a2.st;
    an3 = putName(s, var);
    if !an3.ok { return Res<List<Int>> { st: an3.st, v: [], ok: false }; };
    s = an3.st;
    loVar = varExprNode(s, loName);
    if !loVar.ok { return Res<List<Int>> { st: loVar.st, v: [], ok: false }; };
    s = loVar.st;
    a3 = stmtNode(s, AstStatement::Assign { n: an3.v, e: loVar.v });
    if !a3.ok { return Res<List<Int>> { st: a3.st, v: [], ok: false }; };
    s = a3.st;
    // invariant facts
    v1 = varProofAtom(s, var);
    if !v1.ok { return Res<List<Int>> { st: v1.st, v: [], ok: false }; };
    s = v1.st;
    n1 = atermProof(s, loName);
    if !n1.ok { return Res<List<Int>> { st: n1.st, v: [], ok: false }; };
    s = n1.st;
    ge = relProofOf(s, 5, v1.v, n1.v);
    if !ge.ok { return Res<List<Int>> { st: ge.st, v: [], ok: false }; };
    s = ge.st;
    geV = validationNode(s, AstValidation::ProofAssert { p: ge.v });
    if !geV.ok { return Res<List<Int>> { st: geV.st, v: [], ok: false }; };
    s = geV.st;
    v2 = varProofAtom(s, var);
    if !v2.ok { return Res<List<Int>> { st: v2.st, v: [], ok: false }; };
    s = v2.st;
    n2 = atermProof(s, hiName);
    if !n2.ok { return Res<List<Int>> { st: n2.st, v: [], ok: false }; };
    s = n2.st;
    le = relProofOf(s, 4, v2.v, n2.v);
    // Haskell uses GtEq for lo and LtEq for hi; rel indices: Eq0 NotEq1 Lt2 Gt3 LtEq4 GtEq5
    if !le.ok { return Res<List<Int>> { st: le.st, v: [], ok: false }; };
    s = le.st;
    leV = validationNode(s, AstValidation::ProofAssert { p: le.v });
    if !leV.ok { return Res<List<Int>> { st: leV.st, v: [], ok: false }; };
    s = leV.st;
    allInv = push(push([], geV.v), leV.v);
    for x in inv { allInv = push(allInv, x); };
    // condition var < hi
    c1 = varExprNode(s, var);
    if !c1.ok { return Res<List<Int>> { st: c1.st, v: [], ok: false }; };
    s = c1.st;
    c2 = varExprNode(s, hiName);
    if !c2.ok { return Res<List<Int>> { st: c2.st, v: [], ok: false }; };
    s = c2.st;
    cond = relExprOf(s, "<", c1.v, c2.v);
    if !cond.ok { return Res<List<Int>> { st: cond.st, v: [], ok: false }; };
    s = cond.st;
    // shrinks hi - var
    t1 = varExprNode(s, hiName);
    if !t1.ok { return Res<List<Int>> { st: t1.st, v: [], ok: false }; };
    s = t1.st;
    t2 = varExprNode(s, var);
    if !t2.ok { return Res<List<Int>> { st: t2.st, v: [], ok: false }; };
    s = t2.st;
    rem = primExpr(s, "Minus", push(push([], t1.v), t2.v));
    if !rem.ok { return Res<List<Int>> { st: rem.st, v: [], ok: false }; };
    s = rem.st;
    termNode = emit(s, AstNode::Termination { value: AstTermination::Shrinks { e: rem.v } });
    if !termNode.ok { return Res<List<Int>> { st: termNode.st, v: [], ok: false }; };
    s = termNode.st;
    optTerm = emit(s, AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: termNode.v } });
    if !optTerm.ok { return Res<List<Int>> { st: optTerm.st, v: [], ok: false }; };
    s = optTerm.st;
    // step var = var + 1
    sv = varExprNode(s, var);
    if !sv.ok { return Res<List<Int>> { st: sv.st, v: [], ok: false }; };
    s = sv.st;
    one = intExpr(s, 1);
    if !one.ok { return Res<List<Int>> { st: one.st, v: [], ok: false }; };
    s = one.st;
    plus = primExpr(s, "Plus", push(push([], sv.v), one.v));
    if !plus.ok { return Res<List<Int>> { st: plus.st, v: [], ok: false }; };
    s = plus.st;
    an4 = putName(s, var);
    if !an4.ok { return Res<List<Int>> { st: an4.st, v: [], ok: false }; };
    s = an4.st;
    step = stmtNode(s, AstStatement::Assign { n: an4.v, e: plus.v });
    if !step.ok { return Res<List<Int>> { st: step.st, v: [], ok: false }; };
    s = step.st;
    loopBody = clone(body);
    loopBody = push(loopBody, step.v);
    vs = validationsList(s, allInv);
    if !vs.ok { return Res<List<Int>> { st: vs.st, v: [], ok: false }; };
    s = vs.st;
    xs = statementsList(s, loopBody);
    if !xs.ok { return Res<List<Int>> { st: xs.st, v: [], ok: false }; };
    s = xs.st;
    w = stmtNode(s, AstStatement::While { e: cond.v, vs: vs.v, t: optTerm.v, xs: xs.v });
    if !w.ok { return Res<List<Int>> { st: w.st, v: [], ok: false }; };
    return ok(w.st, push(push(push(push([], a1.v), a2.v), a3.v), w.v));
};

fn varProofAtom(st: St, name: &String) -> Res<Int> ~ { return atermProof(st, name); };

fn tryTupleAssign(st: St) -> Res<List<Int>> ~ {
    save = clone(st);
    startPos = st.pos;
    s = skipWs(st);
    if byteAt(s, s.pos) != 40 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    names = [];
    loop = true;
    while loop ~ {
        v = parseVariable(s);
        if !v.ok { return Res<List<Int>> { st: save, v: [], ok: false }; };
        s = v.st;
        names = push(names, v.v);
        s = skipWs(s);
        if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
    };
    if byteAt(s, s.pos) != 41 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if byteAt(s, s.pos) != 61 || byteAt(s, s.pos + 1) = 61 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if size(names) < 2 { return fail(s, [], "a tuple is taken apart into two names or more"); };
    if hasDupStrings(names) { return fail(s, [], "a tuple is taken apart into a name twice"); };
    e = expression(s);
    if !e.ok { return Res<List<Int>> { st: e.st, v: [], ok: false }; };
    s = skipWs(e.st);
    lc = srcLineCol(s, startPos);
    held = cat3("$tuple ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    hn = putName(s, held);
    if !hn.ok { return Res<List<Int>> { st: hn.st, v: [], ok: false }; };
    s = hn.st;
    first = stmtNode(s, AstStatement::Assign { n: hn.v, e: e.v });
    if !first.ok { return Res<List<Int>> { st: first.st, v: [], ok: false }; };
    s = clone(first.st);
    out = push([], first.v);
    i = 0;
    for name in names {
        hv = varExprNode(s, held);
        if !hv.ok { return Res<List<Int>> { st: hv.st, v: [], ok: false }; };
        s = hv.st;
        fe = tupleFieldExpr(s, i, hv.v);
        if !fe.ok { return Res<List<Int>> { st: fe.st, v: [], ok: false }; };
        s = fe.st;
        nn = putName(s, name);
        if !nn.ok { return Res<List<Int>> { st: nn.st, v: [], ok: false }; };
        s = nn.st;
        a = stmtNode(s, AstStatement::Assign { n: nn.v, e: fe.v });
        if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
        s = a.st;
        out = push(out, a.v);
        i = i + 1;
    };
    return ok(s, out);
};

fn tupleFieldExpr(st: St, i: Int, of: Int) -> Res<Int> ~ {
    n = putName(st, String::fromInt(i));
    if !n.ok { return n; };
    on = optNameNode(n.st, false, "");
    if !on.ok { return on; };
    return builtinExpr(on.st, AstBuiltin::FieldBuiltin { owner: on.v, n: n.v }, push([], "struct"), push([], of));
};

fn tryStructAssign(st: St) -> Res<List<Int>> ~ {
    save = clone(st);
    startPos = st.pos;
    s = skipWs(st);
    q = qualifiedName(s);
    if !q.ok { return Res<List<Int>> { st: save, v: [], ok: false }; };
    if !hasCtor(q.st, q.v) { return Res<List<Int>> { st: save, v: [], ok: false }; };
    declared = findCtorPath(q.st, q.v);
    name = q.v;
    s = skipWs(q.st);
    if byteAt(s, s.pos) != 123 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    fields = [];
    vars = [];
    if byteAt(s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            f = parseVariable(s);
            if !f.ok { return Res<List<Int>> { st: save, v: [], ok: false }; };
            s = skipWs(f.st);
            if byteAt(s, s.pos) != 58 { return Res<List<Int>> { st: save, v: [], ok: false }; };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            v = parseVariable(s);
            if !v.ok { return Res<List<Int>> { st: save, v: [], ok: false }; };
            s = skipWs(v.st);
            fields = push(fields, f.v);
            vars = push(vars, v.v);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 125 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if byteAt(s, s.pos) != 61 || byteAt(s, s.pos + 1) = 61 { return Res<List<Int>> { st: save, v: [], ok: false }; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if containsText(name, "::") { return fail(s, [], "a variant is taken apart with match, which says what to do with the other variants"); };
    same = size(fields) = size(declared);
    if same {
        i = 0;
        for f in fields { if f != get(declared, i) { same = false; }; i = i + 1; };
    };
    if !same {
        joined = "";
        j = 0;
        for d in declared { if j > 0 { joined = catStrings(joined, ", "); }; joined = catStrings(joined, d); j = j + 1; };
        return fail(s, [], cat3(cat3(cat3("Struct ", name, " is taken apart into every one of its fields, in the order it declares them ("), joined, ")"), "", ""));
    };
    if hasDupStrings(vars) { return fail(s, [], "a struct is taken apart into a name twice"); };
    e = expression(s);
    if !e.ok { return Res<List<Int>> { st: e.st, v: [], ok: false }; };
    s = skipWs(e.st);
    lc = srcLineCol(s, startPos);
    held = cat3("$struct ", String::fromInt(get(lc, 0)), catStrings(":", String::fromInt(get(lc, 1))));
    hn = putName(s, held);
    if !hn.ok { return Res<List<Int>> { st: hn.st, v: [], ok: false }; };
    s = hn.st;
    first = stmtNode(s, AstStatement::Assign { n: hn.v, e: e.v });
    if !first.ok { return Res<List<Int>> { st: first.st, v: [], ok: false }; };
    s = clone(first.st);
    out = push([], first.v);
    i = 0;
    for field in fields {
        var = get(vars, i);
        hv = varExprNode(s, held);
        if !hv.ok { return Res<List<Int>> { st: hv.st, v: [], ok: false }; };
        s = hv.st;
        fe = fieldExprOf(s, field, hv.v);
        if !fe.ok { return Res<List<Int>> { st: fe.st, v: [], ok: false }; };
        s = fe.st;
        nn = putName(s, var);
        if !nn.ok { return Res<List<Int>> { st: nn.st, v: [], ok: false }; };
        s = nn.st;
        a = stmtNode(s, AstStatement::Assign { n: nn.v, e: fe.v });
        if !a.ok { return Res<List<Int>> { st: a.st, v: [], ok: false }; };
        s = a.st;
        out = push(out, a.v);
        i = i + 1;
    };
    dn = putName(s, held);
    if !dn.ok { return Res<List<Int>> { st: dn.st, v: [], ok: false }; };
    s = dn.st;
    d = stmtNode(s, AstStatement::Dissolve { n: dn.v });
    if !d.ok { return Res<List<Int>> { st: d.st, v: [], ok: false }; };
    out = push(out, d.v);
    return ok(d.st, out);
};

// ---- declarations ----

fn structStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "struct");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    params = [];
    // try < params >
    save = clone(s);
    if byteAt(s, s.pos) = 60 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        loop = true;
        okParams = true;
        while loop ~ {
            w = parseVariable(s);
            if !w.ok { okParams = false; s = w.st; loop = false; }
            else {
                s = skipWs(w.st);
                params = push(params, w.v);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
            };
        };
        if okParams && byteAt(s, s.pos) = 62 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { s = save; params = []; };
    };
    outerParams = s.typeParams;
    tps = [];
    for p in params { if isTypeParamName(p) { tps = push(tps, clone(p)); }; };
    s = St { typeParams: tps, ..s };
    if size(params) > 0 { s = setGenerics(s, name, params); } else { s = removeGenerics(s, name); };
    if byteAt(s, s.pos) != 123 { return fail(s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    fieldNames = [];
    fieldTypes = [];
    if byteAt(s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            f = structField(s);
            if !f.ok { return Res<Int> { st: f.st, v: 0, ok: false }; };
            s = f.st;
            fieldNames = push(fieldNames, clone(f.v.name));
            fieldTypes = push(fieldTypes, f.v.ty);
            s = skipWs(s);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 125 { return fail(s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    inv = [];
    ik = eatKeyword(s, "invariant");
    ikSt = ik.st;
    if ik.v {
        s = skipWs(ikSt);
        c = optContract(s);
        if !c.ok { return Res<Int> { st: c.st, v: 0, ok: false }; };
        // invariant is written with the contract syntax directly (functContractReqs), optContract already handles [{...}]
        inv = c.v;
        s = c.st;
    } else { s = ikSt; };
    s = St { typeParams: outerParams, ..s };
    if hasDupStrings(fieldNames) { return fail(s, 0, cat3("Struct ", name, " repeats a field")); };
    if isBuiltinTypeName(name) { return fail(s, 0, cat3(name, " is a builtin type and cannot be a struct name", "")); };
    s = shadowCtors(s, name);
    s = setCtor(s, clone(name), clone(fieldNames));
    s = setTypeInfo(s, clone(name), push([], clone(name)));
    finfos = [];
    i = 0;
    for fn2 in fieldNames { finfos = push(finfos, FieldInfo { name: clone(fn2), ty: clone(get(fieldTypes, i)) }); i = i + 1; };
    s = setFields(s, name, finfos);
    nn = putName(s, name);
    if !nn.ok { return nn; };
    s = nn.st;
    ps = namesList(s, params);
    if !ps.ok { return ps; };
    s = ps.st;
    fs = fieldsNodes(s, fieldNames, fieldTypes);
    if !fs.ok { return fs; };
    s = fs.st;
    vs = validationsList(s, inv);
    if !vs.ok { return vs; };
    return stmtNode(vs.st, AstStatement::StructDef { n: nn.v, ps: ps.v, fs: fs.v, vs: vs.v });
};

fn isBuiltinTypeName(name: &String) -> Bool ~ {
    if name = "Int" || name = "Bool" || name = "List" || name = "Array" || name = "Box" || name = "Self" || name = "Addr" || name = "Block" || name = "Uninit" { return true; };
    if name = "I8" || name = "I16" || name = "I32" || name = "I64" || name = "U8" || name = "U16" || name = "U32" { return true; };
    if isTupleBase(name) { return true; };
    return false;
};

fn isTupleBase(name: &String) -> Bool ~ {
    // TupleN for 2 <= N <= 16, no leading zero
    if size(name.bytes) <= 5 { return false; };
    if strSlice(name, 0, 5) != "Tuple" { return false; };
    digits = strSlice(name, 5, size(name.bytes));
    if size(digits.bytes) = 0 { return false; };
    if get(digits.bytes, 0) = toByte(48) { return false; };
    n = 0;
    for i in 0..size(digits.bytes) {
        c = toInt(get(digits.bytes, i));
        if c < 48 || c > 57 { return false; };
        n = n * 10 + c - 48;
    };
    return n >= 2 && n <= 16;
};

fn fieldsNodes(st: St, names: &List<String>, tys: &List<Type>) -> Res<Int> ~ {
    s = st;
    ids = [];
    i = 0;
    for nm in names {
        nn = putName(s, nm);
        if !nn.ok { return nn; };
        s = nn.st;
        tn = putTypeNode(s, typeAtOr(tys, i));
        if !tn.ok { return tn; };
        s = tn.st;
        f = emit(s, AstNode::Field { value: AstField { n: nn.v, ty: tn.v } });
        if !f.ok { return f; };
        s = f.st;
        ids = push(ids, f.v);
        i = i + 1;
    };
    return fieldsList(s, ids);
};


fn structField(st: St) -> Res<FieldOut> ~ {
    s = skipWs(st);
    ghostly = false;
    g = eatKeyword(s, "ghost");
    if g.v { ghostly = true; s = skipWs(g.st); } else { s = g.st; };
    v = parseVariable(s);
    if !v.ok { return Res<FieldOut> { st: v.st, v: FieldOut { name: "", ty: Type::TInt }, ok: false }; };
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 58 { return fail(s, FieldOut { name: "", ty: Type::TInt }, "expected :"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    t = typeAnnotation(s);
    if !t.ok { return Res<FieldOut> { st: t.st, v: FieldOut { name: "", ty: Type::TInt }, ok: false }; };
    if ghostly && !ghostTypeOf(clone(t.v)) { return fail(t.st, FieldOut { name: "", ty: Type::TInt }, "ghost is written before a type that is a permission, Block<T>"); };
    return ok(t.st, FieldOut { name: v.v, ty: t.v });
};

fn enumStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "enum");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    if byteAt(s, s.pos) != 123 { return fail(s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    variantNames = [];
    variantFields = [];
    if byteAt(s, s.pos) != 125 {
        loop = true;
        while loop ~ {
            w = parseVariable(s);
            if !w.ok { return Res<Int> { st: w.st, v: 0, ok: false }; };
            s = skipWs(w.st);
            full = cat3(name, "::", w.v);
            fnames = [];
            ftys = [];
            if byteAt(s, s.pos) = 123 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                if byteAt(s, s.pos) != 125 {
                    loop2 = true;
                    while loop2 ~ {
                        f = structField(s);
                        if !f.ok { return Res<Int> { st: f.st, v: 0, ok: false }; };
                        s = f.st;
                        fnames = push(fnames, clone(f.v.name));
                        ftys = push(ftys, f.v.ty);
                        s = skipWs(s);
                        if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop2 = false; }; } else { loop2 = false; };
                    };
                };
                if byteAt(s, s.pos) != 125 { return fail(s, 0, "expected }"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
            };
            if hasDupStrings(fnames) { return fail(s, 0, cat3("Variant ", w.v, " repeats a field")); };
            variantNames = push(variantNames, clone(full));
            variantFields = push(variantFields, clone(fnames));
            // store field types under the variant name
            finfos = [];
            i = 0;
            for fn2 in fnames { finfos = push(finfos, FieldInfo { name: clone(fn2), ty: clone(get(ftys, i)) }); i = i + 1; };
            s = setCtor(s, clone(full), clone(fnames));
            s = setFields(s, full, finfos);
            if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); if byteAt(s, s.pos) = 125 { loop = false; }; } else { loop = false; };
        };
    };
    if byteAt(s, s.pos) != 125 { return fail(s, 0, "expected }"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    if name = "Int" || name = "Bool" || name = "List" || name = "Array" || name = "Box" || name = "Self" { return fail(s, 0, cat3(name, " is a builtin type and cannot be an enum name", "")); };
    if size(variantNames) = 0 { return fail(s, 0, cat3("Enum ", name, " has no variants")); };
    if hasDupStrings(variantNames) { return fail(s, 0, cat3("Enum ", name, " repeats a variant")); };
    s = shadowCtors(s, name);
    s = removeGenerics(s, name);
    s = setTypeInfo(s, name, variantNames);
    nn = putName(s, name);
    if !nn.ok { return nn; };
    s = nn.st;
    // variants nodes need field types: recompute from fieldsOf
    ids = [];
    s = clone(s);
    for vn in variantNames {
        vnNode = putName(s, vn);
        if !vnNode.ok { return vnNode; };
        s = vnNode.st;
        finfos = findFields(s, vn);
        fnames2 = [];
        ftys2 = [];
        for fi in finfos { fnames2 = push(fnames2, clone(fi.name)); ftys2 = push(ftys2, clone(fi.ty)); };
        fs = fieldsNodes(s, fnames2, ftys2);
        if !fs.ok { return fs; };
        s = fs.st;
        varNode = emit(s, AstNode::Variant { value: AstVariant { n: vnNode.v, fs: fs.v } });
        if !varNode.ok { return varNode; };
        s = varNode.st;
        ids = push(ids, varNode.v);
    };
    vs = variantsList(s, ids);
    if !vs.ok { return vs; };
    return stmtNode(vs.st, AstStatement::EnumDef { n: nn.v, vs: vs.v });
};

fn traitStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "trait");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    name = v.v;
    s = skipWs(v.st);
    params = [];
    save = clone(s);
    if byteAt(s, s.pos) = 60 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        loop = true;
        okParams = true;
        tmp = [];
        while loop ~ {
            w = parseVariable(s);
            if !w.ok { okParams = false; s = w.st; loop = false; }
            else {
                s = skipWs(w.st);
                tmp = push(tmp, w.v);
                if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
            };
        };
        if okParams && byteAt(s, s.pos) = 62 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); params = tmp; } else { s = save; };
    };
    if name = "Int" || name = "Bool" || name = "List" || name = "Array" || name = "Box" || name = "Self" { return fail(s, 0, cat3(name, " is a builtin type and cannot be a trait name", "")); };
    for p in params { if !isTypeParamName(p) { return fail(s, 0, cat3(cat3("trait ", name, " has a size parameter: a trait has types only"), "", "")); }; };
    outerParams = s.typeParams;
    s = St { typeParams: clone(params), ..s };
    s = shadowCtors(s, name);
    s = removeTypeInfo(s, name);
    if size(params) > 0 { s = setGenerics(s, name, params); } else { s = removeGenerics(s, name); };
    if byteAt(s, s.pos) != 123 { return fail(s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    fns = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            tf = traitFunction(s);
            if !tf.ok { return Res<Int> { st: tf.st, v: 0, ok: false }; };
            s = tf.st;
            fns = push(fns, tf.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 { while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); }; };
        };
    };
    s = skipWs(s);
    s = St { typeParams: outerParams, ..s };
    // repeat check on trait fn names
    tnames = [];
    for fid in fns { tnames = push(tnames, traitFnNameOf(s, fid)); };
    if hasDupStrings(tnames) { return fail(s, 0, cat3("Trait ", name, " repeats a function")); };
    nn = putName(s, name);
    if !nn.ok { return nn; };
    s = nn.st;
    ps = namesList(s, params);
    if !ps.ok { return ps; };
    s = ps.st;
    fs = traitFnsList(s, fns);
    if !fs.ok { return fs; };
    return stmtNode(fs.st, AstStatement::TraitDef { n: nn.v, ps: ps.v, fs: fs.v });
};

fn traitFnNameOf(st: &St, id: Int) -> String ~ {
    n = nodeAt(st, id);
    if n is AstNode::TraitFn {
        v = (n as AstNode::TraitFn).value;
        return nameText(st, v.n);
    };
    return "";
};

fn traitFunction(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "fn");
    if !k.v { return fail(k.st, 0, "expected fn"); };
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    fname = v.v;
    s = skipWs(v.st);
    h = functHeader(s);
    if !h.ok { return Res<Int> { st: h.st, v: 0, ok: false }; };
    s = h.st;
    hnames = h.v.names;
    hins = h.v.ins;
    houts = h.v.outs;
    sig = signatureNode(s, h.v.types, h.v.ret, [], [], [], []);
    if !sig.ok { return sig; };
    s = sig.st;
    nn = putName(s, fname);
    if !nn.ok { return nn; };
    s = nn.st;
    ps = namesList(s, hnames);
    if !ps.ok { return ps; };
    s = ps.st;
    il = validationsList(s, hins);
    if !il.ok { return il; };
    s = il.st;
    ol = validationsList(s, houts);
    if !ol.ok { return ol; };
    return emit(ol.st, AstNode::TraitFn { value: AstTraitFn { n: nn.v, ps: ps.v, sig: sig.v, ins: il.v, outs: ol.v } });
};

// generic parameters of fn/impl: [name, [(trait, [types])]] encoded as parallel lists

fn noGenParams() -> List<GenParam> ~ { return []; };

fn genericParamList(st: St) -> Res<List<GenParam>> ~ {
    // at '<'; consumes through '>'
    s = st;
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    out = noGenParams();
    loop = true;
    while loop ~ {
        gp = oneGenericParam(s);
        if !gp.ok { return Res<List<GenParam>> { st: gp.st, v: noGenParams(), ok: false }; };
        s = gp.st;
        out = push(out, gp.v);
        s = skipWs(s);
        if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
    };
    if byteAt(s, s.pos) != 62 { return fail(s, out, "expected >"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    return ok(s, out);
};

fn oneGenericParam(st: St) -> Res<GenParam> ~ {
    empty = GenParam { name: "", boundTraits: [], boundArgs: [] };
    v = parseVariable(st);
    if !v.ok { return Res<GenParam> { st: v.st, v: empty, ok: false }; };
    s = skipWs(v.st);
    traits = [];
    argss = [];
    if byteAt(s, s.pos) = 58 {
        s = St { pos: s.pos + 1, ..s };
        s = skipWs(s);
        loop = true;
        while loop ~ {
            t = qualifiedName(s);
            if !t.ok { return Res<GenParam> { st: t.st, v: empty, ok: false }; };
            s = skipWs(t.st);
            args = [];
            if byteAt(s, s.pos) = 60 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                loop2 = true;
                while loop2 ~ {
                    ty = typeAnnotation(s);
                    if !ty.ok { return Res<GenParam> { st: ty.st, v: empty, ok: false }; };
                    s = ty.st;
                    args = push(args, ty.v);
                    s = skipWs(s);
                    if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop2 = false; };
                };
                if byteAt(s, s.pos) != 62 { return fail(s, empty, "expected >"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
            };
            traits = push(traits, t.v);
            argss = push(argss, args);
            if byteAt(s, s.pos) = 43 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { loop = false; };
        };
    };
    return ok(s, GenParam { name: v.v, boundTraits: traits, boundArgs: argss });
};

fn boundsNodes(st: St, gps: &List<GenParam>) -> Res<List<Int>> ~ {
    s = st;
    ids = [];
    for gp in gps {
        i = 0;
        for tr in gp.boundTraits {
            pn = putName(s, gp.name);
            if !pn.ok { return Res<List<Int>> { st: pn.st, v: [], ok: false }; };
            s = pn.st;
            tn = putName(s, tr);
            if !tn.ok { return Res<List<Int>> { st: tn.st, v: [], ok: false }; };
            s = tn.st;
            ts = putTypesNodes(s, typesAtOr(gp.boundArgs, i));
            if !ts.ok { return Res<List<Int>> { st: ts.st, v: [], ok: false }; };
            s = ts.st;
            b = emit(s, AstNode::Bound { value: AstBound { p: pn.v, n: tn.v, ts: ts.v } });
            if !b.ok { return Res<List<Int>> { st: b.st, v: [], ok: false }; };
            s = b.st;
            ids = push(ids, b.v);
            i = i + 1;
        };
    };
    return ok(s, ids);
};

fn functStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "fn");
    s = skipWs(k.st);
    v = parseVariable(s);
    if !v.ok { return Res<Int> { st: v.st, v: 0, ok: false }; };
    var = v.v;
    s = skipWs(v.st);
    if var = "clone" && !s.hasSelf { s = St { ownClone: true, ..s }; };
    outerParams = s.typeParams;
    // generic parameters
    gps = [];
    save = clone(s);
    if byteAt(s, s.pos) = 60 {
        scanned = scanGenericNames(s);
        tpsScan = [];
        for n in scanned { if isTypeParamName(n) { tpsScan = push(tpsScan, clone(n)); }; };
        for p in s.implParams { if isTypeParamName(p) { tpsScan = push(tpsScan, clone(p)); }; };
        s = St { typeParams: tpsScan, ..s };
        g = genericParamList(s);
        if g.ok { gps = g.v; s = g.st; } else { s = save; };
    };
    generics = [];
    for gp in gps { generics = push(generics, clone(gp.name)); };
    for gp in gps {
        for tr in gp.boundTraits { };
    };
    // a bound on a size parameter is refused
    bi = 0;
    for gp in gps {
        if size(gp.boundTraits) > 0 && !isTypeParamName(gp.name) { return fail(s, 0, "a bound on a size"); };
        bi = bi + 1;
    };
    typeParams = [];
    sizes = [];
    for gname in generics { if isTypeParamName(gname) { typeParams = push(typeParams, clone(gname)); } else { sizes = push(sizes, clone(gname)); }; };
    implTypeParams = [];
    implSizes = [];
    for p in s.implParams { if isTypeParamName(p) { implTypeParams = push(implTypeParams, clone(p)); } else { implSizes = push(implSizes, clone(p)); }; };
    allTypes = clone(typeParams);
    for p in implTypeParams { allTypes = push(allTypes, clone(p)); };
    allSizes = clone(sizes);
    for p in implSizes { allSizes = push(allSizes, clone(p)); };
    s = St { typeParams: clone(allTypes), ..s };
    h = functHeader(s);
    if !h.ok { return Res<Int> { st: h.st, v: 0, ok: false }; };
    s = h.st;
    term = terminationClause(s);
    if !term.ok { return Res<Int> { st: term.st, v: 0, ok: false }; };
    s = term.st;
    body = curlyBlock(s);
    if !body.ok { return Res<Int> { st: body.st, v: 0, ok: false }; };
    s = body.st;
    s = St { typeParams: outerParams, ..s };
    allNames = clone(h.v.names);
    allTypesList = clone(h.v.types);
    for sz in allSizes { allNames = push(allNames, clone(sz)); allTypesList = push(allTypesList, Type::TInt); };
    header2 = HeaderOut { names: allNames, types: allTypesList, ret: h.v.ret, ins: h.v.ins, outs: h.v.outs, writes: h.v.writes, froms: h.v.froms };
    assign = functAssignFull(s, var, header2, term.v, body.v, allSizes, allTypes);
    if !assign.ok { return assign; };
    s = assign.st;
    hasBounds = false;
    for gp in gps { if size(gp.boundTraits) > 0 { hasBounds = true; }; };
    if !hasBounds { return ok(s, assign.v); };
    bIds = boundsNodes(s, gps);
    if !bIds.ok { return Res<Int> { st: bIds.st, v: 0, ok: false }; };
    s = bIds.st;
    bl = boundsList(s, bIds.v);
    if !bl.ok { return bl; };
    return stmtNode(bl.st, AstStatement::BoundedDef { bs: bl.v, s: assign.v });
};

fn functAssignFull(st: St, name: &String, h: HeaderOut, termNode: Int, body: &List<Int>, sizes: &List<String>, tps: &List<String>) -> Res<Int> ~ {
    sig = signatureNode(st, h.types, h.ret, sizes, tps, h.writes, h.froms);
    if !sig.ok { return sig; };
    s = sig.st;
    stmts = statementsList(s, body);
    if !stmts.ok { return stmts; };
    s = stmts.st;
    bodyNode = emit(s, AstNode::Body { value: AstBody::NativeFunct { sig: sig.v, term: termNode, stmts: stmts.v } });
    if !bodyNode.ok { return bodyNode; };
    s = bodyNode.st;
    ps = namesList(s, h.names);
    if !ps.ok { return ps; };
    s = ps.st;
    insL = validationsList(s, h.ins);
    if !insL.ok { return insL; };
    s = insL.st;
    outsL = validationsList(s, h.outs);
    if !outsL.ok { return outsL; };
    s = outsL.st;
    ex = emptyProofs(s);
    if !ex.ok { return ex; };
    s = ex.st;
    vf = emit(s, AstNode::Value { value: AstValue::VFunct { ps: ps.v, ins: insL.v, outs: outsL.v, body: bodyNode.v, exports: ex.v } });
    if !vf.ok { return vf; };
    s = vf.st;
    ve = valExpr(s, vf.v);
    if !ve.ok { return ve; };
    s = ve.st;
    nn = putName(s, name);
    if !nn.ok { return nn; };
    return stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: ve.v });
};

fn scanGenericNames(st: &St) -> List<String> ~ {
    // the parameter names after '<', without consuming
    s = clone(st);
    names = [];
    if byteAt(s, s.pos) != 60 { return names; };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    depth = 1;
    loop = true;
    expectName = true;
    while loop ~ {
        if atEnd(s) { loop = false; }
        else {
            if expectName {
                v = parseVariable(s);
                if !v.ok { s = v.st; loop = false; }
                else {
                    names = push(names, v.v);
                    s = v.st;
                    expectName = false;
                };
            } else {
                c = byteAt(s, s.pos);
                if c = 60 { depth = depth + 1; s = St { pos: s.pos + 1, ..s }; }
                else { if c = 62 { depth = depth - 1; s = St { pos: s.pos + 1, ..s }; if depth = 0 { loop = false; }; }
                else { if c = 44 && depth = 1 { expectName = true; s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { s = St { pos: s.pos + 1, ..s }; }; }; };
            };
        };
    };
    return names;
};

fn implStatement(st: St) -> Res<Int> ~ {
    k = eatKeyword(st, "impl");
    s = skipWs(k.st);
    outerParams0 = s.typeParams;
    // impl parameters
    implParamList = [];
    implBoundsGps = [];
    save0 = clone(s);
    if byteAt(s, s.pos) = 60 {
        scanned = scanGenericNames(s);
        tps = [];
        for n in scanned { if isTypeParamName(n) { tps = push(tps, clone(n)); }; };
        s = St { typeParams: tps, ..s };
        g = genericParamList(s);
        if g.ok { implParamList = g.v; s = g.st; } else { s = save0; };
    };
    s = St { typeParams: outerParams0, ..s };
    implParams = [];
    for gp in implParamList { implParams = push(implParams, clone(gp.name)); };
    outerParams = s.typeParams;
    tpsOnly = [];
    for n in implParams { if isTypeParamName(n) { tpsOnly = push(tpsOnly, clone(n)); }; };
    s = St { typeParams: tpsOnly, ..s };
    first = qualifiedName(s);
    if !first.ok { return Res<Int> { st: first.st, v: 0, ok: false }; };
    s = skipWs(first.st);
    firstArgs = [];
    hasFirstArgs = false;
    fp = findGenerics(s, first.v);
    if size(fp) > 0 && hasGenericArguments(s, fp) {
        g = genericArguments(skipWs(s), fp);
        if g.ok { firstArgs = g.v; hasFirstArgs = true; s = g.st; } else { s = g.st; };
    };
    trt = "";
    hasTrait = false;
    traitArgs = [];
    typeName = clone(first.v);
    typeArgs = clone(firstArgs);
    hasTypeArgs = hasFirstArgs;
    s = skipWs(s);
    fk = eatKeyword(s, "for");
    if fk.v {
        s = skipWs(fk.st);
        t = qualifiedName(s);
        if !t.ok { return Res<Int> { st: t.st, v: 0, ok: false }; };
        trt = first.v;
        hasTrait = true;
        traitArgs = firstArgs;
        typeName = t.v;
        s = skipWs(t.st);
        typeArgs = [];
        hasTypeArgs = false;
        if typeName = "List" || typeName = "Box" {
            s2 = skipWs(s);
            if byteAt(s2, s2.pos) = 60 {
                s2 = St { pos: s2.pos + 1, ..s2 };
                s2 = skipWs(s2);
                ty = typeAnnotation(s2);
                if !ty.ok { return Res<Int> { st: ty.st, v: 0, ok: false }; };
                s = skipWs(ty.st);
                if byteAt(s, s.pos) != 62 { return fail(s, 0, "expected >"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                typeArgs = push([], ArgV { isSize: false, size: Size::SAny, ty: ty.v });
                hasTypeArgs = true;
            } else { s = s2; };
        } else {
            if typeName = "Array" {
                s2 = skipWs(s);
                if byteAt(s2, s2.pos) = 60 {
                    s2 = St { pos: s2.pos + 1, ..s2 };
                    s2 = skipWs(s2);
                    ty = typeAnnotation(s2);
                    if !ty.ok { return Res<Int> { st: ty.st, v: 0, ok: false }; };
                    s = ty.st;
                    size = Size::SAny;
                    s = skipWs(s);
                    if byteAt(s, s.pos) = 44 {
                        s = St { pos: s.pos + 1, ..s };
                        s = skipWs(s);
                        z = sizeArgument(s);
                        if !z.ok { return Res<Int> { st: z.st, v: 0, ok: false }; };
                        s = z.st;
                        size = z.v;
                    };
                    s = skipWs(s);
                    if byteAt(s, s.pos) != 62 { return fail(s, 0, "expected >"); };
                    s = St { pos: s.pos + 1, ..s };
                    s = skipWs(s);
                    typeArgs = push(push([], ArgV { isSize: false, size: Size::SAny, ty: ty.v }), ArgV { isSize: true, size: size, ty: Type::TInt });
                    hasTypeArgs = true;
                } else { s = s2; };
            } else {
                tp2 = findGenerics(s, typeName);
                if size(tp2) > 0 && hasGenericArguments(s, tp2) {
                    g = genericArguments(skipWs(s), tp2);
                    if g.ok { typeArgs = g.v; hasTypeArgs = true; s = g.st; } else { s = g.st; };
                };
            };
        };
    } else { s = fk.st; };
    s = St { typeParams: outerParams, ..s };
    isBuiltinType = typeName = "List" || typeName = "Box" || typeName = "Array" || typeName = "Int" || typeName = "Byte" || typeName = "Bool";
    if !isBuiltinType && !containsText(typeName, "::") && !hasTypeNamed(s, typeName) { return fail(s, 0, cat3(cat3("impl for ", typeName, ", which is not a struct or enum declared before"), "", "")); };
    // trait parameter checks
    if hasTrait {
        tp3 = findGenerics(s, trt);
        if size(tp3) > 0 && !hasFirstArgs {
            joined = joinNames(tp3);
            return fail(s, 0, cat3(catStrings(cat3(cat3("trait ", trt, " has parameters <"), joined, ">: write impl "), cat3(trt, "<", joined)), cat3("> for ", typeName, ""), ""));
        };
        if size(tp3) = 0 && hasFirstArgs { return fail(s, 0, cat3("trait ", trt, " has no parameters")); };
    };
    // self name and type
    selfName = clone(typeName);
    selfTy = namedTypeOf(typeName, typeArgs);
    if typeName = "List" || typeName = "Box" || typeName = "Array" {
        if !hasTypeArgs && typeName = "List" { return fail(s, 0, "impl for List names its types, so it is written impl<T> Trait<T> for List<T>"); };
        selfName = instanceNameOf(typeName, typeArgs);
        selfTy = namedTypeOf(typeName, typeArgs);
    } else {
        tp4 = findGenerics(s, typeName);
        if size(tp4) > 0 {
            if !hasTypeArgs {
                return fail(s, 0, cat3(catStrings(cat3(cat3("impl for ", typeName, ", which has parameters <"), joinNames(tp4), ">: write impl<"), joinNames(tp4)), cat3("> ", typeName, ""), cat3("<", joinNames(tp4), ">")));
            };
            if size(implParams) = 0 { return fail(s, 0, cat3("impl for ", typeName, " names its types, so it is written impl<...>")); };
            selfName = instanceNameOf(typeName, typeArgs);
            selfTy = namedTypeOf(typeName, typeArgs);
        } else {
            if size(implParams) > 0 { return fail(s, 0, cat3(cat3(cat3("impl<", joinNames(implParams), "> for "), typeName, ", which has no parameters"), "", "")); };
            selfName = clone(typeName);
            selfTy = namedTypeOf(typeName, []);
        };
    };
    savedSelfName = s.selfName;
    savedHasSelf = s.hasSelf;
    savedSelfTy = s.selfTy;
    savedHasSelfTy = s.hasSelfTy;
    savedImplParams = s.implParams;
    s = St { selfName: clone(selfName), ..s };
    s = St { hasSelf: true, ..s };
    s = St { selfTy: clone(selfTy), ..s };
    s = St { hasSelfTy: true, ..s };
    s = St { implParams: clone(implParams), ..s };
    if hasCtor(s, typeName) { s = setCtor(s, selfName, findCtor(s, typeName)); };
    s = skipWs(s);
    if byteAt(s, s.pos) != 123 { return fail(s, 0, "expected {"); };
    s = St { pos: s.pos + 1, ..s };
    s = skipWs(s);
    written = [];
    loop = true;
    while loop ~ {
        if byteAt(s, s.pos) = 125 { s = St { pos: s.pos + 1, ..s }; loop = false; }
        else {
            d = implFunction(s, typeName, hasTrait, trt);
            if !d.ok { return Res<Int> { st: d.st, v: 0, ok: false }; };
            s = d.st;
            written = push(written, d.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 { while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); }; };
        };
    };
    s = skipWs(s);
    standardEq = hasTrait && trt = "Eq" && size(written) = 0 && !isBuiltinType;
    standardClone = hasTrait && trt = "Clone" && size(written) = 0 && !isBuiltinType;
    functions = written;
    if standardEq || standardClone {
        text = "";
        if standardEq { text = standardEqText(s, typeName); } else { text = standardCloneText(s, typeName); };
        gen = parseGenerated(s, text, typeName, hasTrait, trt);
        if !gen.ok { return Res<Int> { st: gen.st, v: 0, ok: false }; };
        s = gen.st;
        functions = gen.v;
    };
    implBoundsIds = [];
    implBounds = boundsNodesList(s, implParamList);
    if !implBounds.ok { return Res<Int> { st: implBounds.st, v: 0, ok: false }; };
    s = implBounds.st;
    extraTrait = "";
    if standardEq { extraTrait = "Eq"; };
    if standardClone { extraTrait = "Clone"; };
    if size(extraTrait.bytes) > 0 {
        s = clone(s);
        for p in implParams {
            if isTypeParamName(p) && !genHasBound(implParamList, p, extraTrait) {
                pn = putName(s, p);
                if !pn.ok { return pn; };
                s = pn.st;
                tn = putName(s, extraTrait);
                if !tn.ok { return tn; };
                s = tn.st;
                ts = typesList(s, []);
                if !ts.ok { return ts; };
                s = ts.st;
                b = emit(s, AstNode::Bound { value: AstBound { p: pn.v, n: tn.v, ts: ts.v } });
                if !b.ok { return b; };
                s = b.st;
                // bounds are a list node built later; keep ids in a side list via a second pass: store in implBoundsIds
                implBoundsIds = push(implBoundsIds, b.v);
            };
        };
    };
    s = St { selfName: savedSelfName, ..s };
    s = St { hasSelf: savedHasSelf, ..s };
    s = St { selfTy: savedSelfTy, ..s };
    s = St { hasSelfTy: savedHasSelfTy, ..s };
    s = St { implParams: savedImplParams, ..s };
    if selfName != typeName { s = deleteCtor(s, selfName); };
    on = optNameNode(s, hasTrait, trt);
    if !on.ok { return on; };
    s = on.st;
    aa = putArgsNodes(s, traitArgs);
    if !aa.ok { return aa; };
    s = aa.st;
    nn = putName(s, typeName);
    if !nn.ok { return nn; };
    s = nn.st;
    tyNode = putTypeNode(s, selfTy);
    if !tyNode.ok { return tyNode; };
    s = tyNode.st;
    allBounds = clone(implBounds.v);
    for x in implBoundsIds { allBounds = push(allBounds, x); };
    bl = boundsList(s, allBounds);
    if !bl.ok { return bl; };
    s = bl.st;
    xs = statementsList(s, functions);
    if !xs.ok { return xs; };
    return stmtNode(xs.st, AstStatement::ImplDef { traitName: on.v, args: aa.v, n: nn.v, ty: tyNode.v, bs: bl.v, xs: xs.v });
};

fn joinNames(xs: &List<String>) -> String ~ {
    out = "";
    i = 0;
    for x in xs { if i > 0 { out = catStrings(out, ", "); }; out = catStrings(out, x); i = i + 1; };
    return out;
};

fn genHasBound(gps: &List<GenParam>, p: &String, trt: &String) -> Bool ~ {
    for gp in gps { if gp.name = p { for t in gp.boundTraits { if t = trt { return true; }; }; }; };
    return false;
};

fn boundsNodesList(st: St, gps: &List<GenParam>) -> Res<List<Int>> ~ {
    s = st;
    ids = [];
    for gp in gps {
        i = 0;
        for tr in gp.boundTraits {
            pn = putName(s, gp.name);
            if !pn.ok { return Res<List<Int>> { st: pn.st, v: [], ok: false }; };
            s = pn.st;
            tn = putName(s, tr);
            if !tn.ok { return Res<List<Int>> { st: tn.st, v: [], ok: false }; };
            s = tn.st;
            ts = putTypesNodes(s, typesAtOr(gp.boundArgs, i));
            if !ts.ok { return Res<List<Int>> { st: ts.st, v: [], ok: false }; };
            s = ts.st;
            b = emit(s, AstNode::Bound { value: AstBound { p: pn.v, n: tn.v, ts: ts.v } });
            if !b.ok { return Res<List<Int>> { st: b.st, v: [], ok: false }; };
            s = b.st;
            ids = push(ids, b.v);
            i = i + 1;
        };
    };
    return ok(s, ids);
};

fn implFunction(st: St, typeName: &String, hasTrait: Bool, trt: &String) -> Res<Int> ~ {
    d = functStatement(st);
    if !d.ok { return d; };
    assignParts = statementAssignParts(d.st, d.v);
    if size(assignParts) != 2 { return d; };
    s = d.st;
    var = nameText(s, get(assignParts, 0));
    variantName = cat3(typeName, "::", var);
    if hasCtor(s, variantName) { return fail(s, 0, cat3(variantName, " is a variant, and cannot also be a function", "")); };
    full = implName(typeName, hasTrait, trt, var);
    nn = putName(s, full);
    if !nn.ok { return Res<Int> { st: nn.st, v: 0, ok: false }; };
    return stmtNode(nn.st, AstStatement::Assign { n: nn.v, e: get(assignParts, 1) });
};

fn statementAssignParts(st: &St, id: Int) -> List<Int> ~ {
    n = nodeAt(st, id);
    if n is AstNode::Statement {
        v = (n as AstNode::Statement).value;
        out = [];
        match v {
            AstStatement::Assign { n: a, e: b } => { out = push(push([], a), b); },
            AstStatement::AssignDeref { a: a, b: b } => { out = []; },
            AstStatement::Let { n: a, e: b } => { out = []; },
            AstStatement::Return { e: a } => { out = []; },
            AstStatement::ValidationStatement { v: a } => { out = []; },
            AstStatement::StructDef { n: a, ps: b, fs: c, vs: d } => { out = []; },
            AstStatement::EnumDef { n: a, vs: b } => { out = []; },
            AstStatement::AxiomDef { n: a, ps: b, ins: c, outs: d } => { out = []; },
            AstStatement::ProofDef { n: a, ps: b, ins: c, outs: d, body: e } => { out = []; },
            AstStatement::Block { xs: a } => { out = []; },
            AstStatement::If { e: a, a: b, b: c } => { out = []; },
            AstStatement::While { e: a, vs: b, t: c, xs: d } => { out = []; },
            AstStatement::TraitDef { n: a, ps: b, fs: c } => { out = []; },
            AstStatement::ImplDef { traitName: a, args: b, n: c, ty: d, bs: e, xs: f } => { out = []; },
            AstStatement::BoundedDef { bs: a, s: b } => { out = []; },
            AstStatement::Mark { line: a, col: b } => { out = []; },
            AstStatement::CopyDef { n: a } => { out = []; },
            AstStatement::LinearDef { n: a } => { out = []; },
            AstStatement::ExternDef { n: a } => { out = []; },
            AstStatement::DropDef { n: a } => { out = []; },
            AstStatement::Dissolve { n: a } => { out = []; },
        };
        return out;
    };
    return [];
};
fn parseGenerated(st: St, text: &String, typeName: &String, hasTrait: Bool, trt: &String) -> Res<List<Int>> ~ {
    savedSrc = clone(st.src);
    savedPos = st.pos;
    savedGenLine = st.genLine;
    savedGenCol = st.genCol;
    base = lineCol(savedSrc, savedPos);
    s = st;
    s = St { src: clone(text), ..s };
    s = St { pos: 0, ..s };
    s = St { genLine: get(base, 0), ..s };
    s = St { genCol: get(base, 1), ..s };
    out = [];
    loop = true;
    while loop ~ {
        s = skipWs(s);
        if atEnd(s) { loop = false; }
        else {
            d = implFunction(s, typeName, hasTrait, trt);
            if !d.ok { return Res<List<Int>> { st: d.st, v: [], ok: false }; };
            s = d.st;
            out = push(out, d.v);
            s = skipWs(s);
            if byteAt(s, s.pos) = 59 { while byteAt(s, s.pos) = 59 ~ { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); }; };
        };
    };
    s = St { src: savedSrc, ..s };
    s = St { pos: savedPos, ..s };
    s = St { genLine: savedGenLine, ..s };
    s = St { genCol: savedGenCol, ..s };
    return ok(s, out);
};

// ---- generated Eq and Clone (Parse.standardEqFunction, Parse.standardCloneFunction) ----

fn fieldsOfVariant(st: &St, v: &String) -> List<FieldInfo> ~ { return findFields(st, v); };

fn typeMentionsSelf(t: Type, self: &String) -> Bool ~ {
    out = false;
    match t {
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = b = self; },
        Type::TList { elem: e } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TBox { inner: e } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TArray { elem: e, size: s } => { out = typeMentionsSelf(Box::unbox(e), self); },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: e } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TAddr { inner: e } => { out = false; },
        Type::TBlock { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn isSelfType(t: Type, self: &String) -> Bool ~ {
    out = false;
    match t {
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { out = b = self; },
        Type::TInt => { out = false; },
        Type::TByte => { out = false; },
        Type::TBool => { out = false; },
        Type::TList { elem: e } => { out = false; },
        Type::TArray { elem: e, size: s } => { out = false; },
        Type::TBox { inner: e } => { out = false; },
        Type::TFn { args: a, ret: r } => { out = false; },
        Type::TVariant { name: a } => { out = false; },
        Type::TVar { n: a } => { out = false; },
        Type::TForall { sizes: a, types: b, body: c } => { out = false; },
        Type::TParam { name: a } => { out = false; },
        Type::TRef { inner: e } => { out = false; },
        Type::TMutRef { inner: e } => { out = false; },
        Type::TAddr { inner: e } => { out = false; },
        Type::TBlock { inner: e } => { out = false; },
        Type::TUninit { inner: e } => { out = false; },
        Type::TWord { signed: a, bits: b } => { out = false; },
    };
    return out;
};

fn differsText(a: &String, b: &String) -> String ~ {
    return cat3(cat3("if ", a, " != "), b, " { return false; }; ");
};

fn standardEqText(st: &St, typeName: &String) -> String ~ {
    variants = typeVariantsOf(st, typeName);
    body = "";
    if size(variants) = 1 && !containsText(nameAtOr(variants, 0, ""), "::") {
        fields = fieldsOfVariant(st, nameAtOr(variants, 0, ""));
        i = 0;
        for f in fields {
            body = catStrings(body, compareFieldText(st, typeName, i, clone(f), "self", "other"));
            i = i + 1;
        };
        body = catStrings(body, "return true;");
    } else {
        for v in variants {
            fields = fieldsOfVariant(st, v);
            inner = "";
            i = 0;
            for f in fields {
                inner = catStrings(inner, compareFieldText(st, typeName, i, clone(f), cat3("(self as ", v, ")"), cat3("(other as ", v, ")")));
                i = i + 1;
            };
            body = catStrings(body, catStrings(cat3(cat3("if self is ", v, " { if other is "), v, " { "), catStrings(inner, "return true; }; return false; }; ")));
        };
        body = catStrings(body, "return false;");
    };
    return cat3("fn eq(self: &Self, other: &Self) -> Bool [{ }] [{ affirm return = (self = other); }] shrinks self { ", body, " };");
};

fn typeVariantsOf(st: &St, typeName: &String) -> List<String> ~ {
    for c in st.types { if c.name = typeName { return clone(c.variants); }; };
    return [];
};

fn compareFieldText(st: &St, typeName: &String, n: Int, f: FieldInfo, a: &String, b: &String) -> String ~ {
    isListSelf = false;
    match f.ty {
        Type::TList { elem: e } => { isListSelf = typeMentionsSelf(Box::unbox(e), typeName); },
        Type::TInt => { isListSelf = false; },
        Type::TByte => { isListSelf = false; },
        Type::TBool => { isListSelf = false; },
        Type::TArray { elem: e, size: s } => { isListSelf = false; },
        Type::TBox { inner: e } => { isListSelf = false; },
        Type::TFn { args: x, ret: r } => { isListSelf = false; },
        Type::TNamed { name: x, base: y, argc: c, argTokens: d } => { isListSelf = false; },
        Type::TVariant { name: x } => { isListSelf = false; },
        Type::TVar { n: x } => { isListSelf = false; },
        Type::TForall { sizes: x, types: y, body: c } => { isListSelf = false; },
        Type::TParam { name: x } => { isListSelf = false; },
        Type::TRef { inner: e } => { isListSelf = false; },
        Type::TMutRef { inner: e } => { isListSelf = false; },
        Type::TAddr { inner: e } => { isListSelf = false; },
        Type::TBlock { inner: e } => { isListSelf = false; },
        Type::TUninit { inner: e } => { isListSelf = false; },
        Type::TWord { signed: x, bits: y } => { isListSelf = false; },
    };
    if isListSelf {
        i = catStrings("i", String::fromInt(n));
        l = cat3(a, ".", f.name);
        r = cat3(b, ".", f.name);
        out = differsText(cat3("size(", l, ")"), cat3("size(", r, ")"));
        out = catStrings(out, cat3(cat3(catStrings(i, " = 0; while "), i, " < size("), l, ")"));
        out = catStrings(out, cat3(cat3(cat3(cat3("[{ affirm ", i, " >= 0; affirm "), i, " <= size("), l, "); affirm forall j in 0.."), i, ": get("));
        out = catStrings(out, cat3(cat3(catStrings(l, ", j) = get("), r, ", j); }] shrinks size("), l, ") - "));
        out = catStrings(out, catStrings(i, " { "));
        out = catStrings(out, differsText(cat3(cat3("get(", l, ", "), i, ")"), cat3(cat3("get(", r, ", "), i, ")")));
        out = catStrings(out, cat3(catStrings(i, " = "), i, " + 1; }; "));
        return out;
    };
    return differsText(cat3(a, ".", f.name), cat3(b, ".", f.name));
};

fn standardCloneText(st: &St, typeName: &String) -> String ~ {
    variants = typeVariantsOf(st, typeName);
    body = "";
    if size(variants) = 1 && !containsText(nameAtOr(variants, 0, ""), "::") {
        fields = fieldsOfVariant(st, nameAtOr(variants, 0, ""));
        parts = cloneParts(st, typeName, fields, "self.");
        body = catStrings(nameAtOr(parts, 0, ""), cat3("return Self { ", nameAtOr(parts, 1, ""), " };"));
    } else {
        vi = 0;
        for v in variants {
            fields = fieldsOfVariant(st, v);
            src = cat3("(self as ", v, ")");
            parts = clonePartsPrefixed(st, typeName, fields, src);
            built = clone(v);
            if size(fields) > 0 { built = cat3(catStrings(v, " { "), nameAtOr(parts, 1, ""), " }"); };
            if vi < size(variants) - 1 {
                body = catStrings(body, catStrings(catStrings(cat3("if self is ", v, " { "), nameAtOr(parts, 0, "")), cat3("return ", built, "; }; ")));
            } else {
                body = catStrings(body, catStrings(nameAtOr(parts, 0, ""), cat3("return ", built, ";")));
            };
            vi = vi + 1;
        };
    };
    return cat3("fn clone(self: &Self) -> Self [{ }] [{ affirm return = self; }] shrinks self { ", body, " };");
};

fn cloneParts(st: &St, typeName: &String, fields: &List<FieldInfo>, prefix: &String) -> List<String> ~ {
    pre = "";
    assigns = "";
    i = 0;
    for f in fields {
        src = cat3(prefix, f.name, "");
        part = fieldCloneText(st, typeName, i, clone(f), src);
        pre = catStrings(pre, nameAtOr(part, 0, ""));
        if i > 0 { assigns = catStrings(assigns, ", "); };
        assigns = catStrings(assigns, cat3(cat3(f.name, ": ", nameAtOr(part, 1, "")), "", ""));
        i = i + 1;
    };
    return push(push([], pre), assigns);
};

fn clonePartsPrefixed(st: &St, typeName: &String, fields: &List<FieldInfo>, srcBase: &String) -> List<String> ~ {
    pre = "";
    assigns = "";
    i = 0;
    for f in fields {
        src = cat3(srcBase, ".", f.name);
        part = fieldCloneText(st, typeName, i, clone(f), src);
        pre = catStrings(pre, nameAtOr(part, 0, ""));
        if i > 0 { assigns = catStrings(assigns, ", "); };
        assigns = catStrings(assigns, cat3(f.name, ": ", nameAtOr(part, 1, "")));
        i = i + 1;
    };
    return push(push([], pre), assigns);
};

fn fieldCloneText(st: &St, typeName: &String, n: Int, f: FieldInfo, src: &String) -> List<String> ~ {
    kind = 0; // 0 clone(x), 1 list loop, 2 array loop, 3 box self
    match f.ty {
        Type::TList { elem: e } => { if typeMentionsSelf(Box::unbox(e), typeName) { kind = 1; }; },
        Type::TArray { elem: e, size: s } => { if typeMentionsSelf(Box::unbox(e), typeName) { kind = 2; }; },
        Type::TBox { inner: e } => { if isSelfType(Box::unbox(e), typeName) { kind = 3; }; },
        Type::TInt => { kind = 0; },
        Type::TByte => { kind = 0; },
        Type::TBool => { kind = 0; },
        Type::TFn { args: a, ret: r } => { kind = 0; },
        Type::TNamed { name: a, base: b, argc: c, argTokens: d } => { kind = 0; },
        Type::TVariant { name: a } => { kind = 0; },
        Type::TVar { n: a } => { kind = 0; },
        Type::TForall { sizes: a, types: b, body: c } => { kind = 0; },
        Type::TParam { name: a } => { kind = 0; },
        Type::TRef { inner: e } => { kind = 0; },
        Type::TMutRef { inner: e } => { kind = 0; },
        Type::TAddr { inner: e } => { kind = 0; },
        Type::TBlock { inner: e } => { kind = 0; },
        Type::TUninit { inner: e } => { kind = 0; },
        Type::TWord { signed: a, bits: b } => { kind = 0; },
    };
    if kind = 3 { return push(push([], ""), cat3("Box::new(clone(Box::unbox(", src, ")))")); };
    if kind = 1 || kind = 2 {
        c = catStrings("cloneField", String::fromInt(n));
        i = catStrings("cloneIndex", String::fromInt(n));
        out = cat3(catStrings(c, " = []; "), i, " = 0; while ");
        out = catStrings(out, cat3(catStrings(i, " < size("), src, ") [{ affirm "));
        out = catStrings(out, cat3(catStrings(i, " >= 0; affirm "), i, " <= size("));
        out = catStrings(out, cat3(catStrings(src, "); affirm size("), c, ") = "));
        out = catStrings(out, cat3(catStrings(i, "; affirm forall j in 0.."), i, ": get("));
        out = catStrings(out, cat3(cat3(catStrings(c, ", j) = get("), src, ", j); }] shrinks size("), src, ") - "));
        out = catStrings(out, cat3(catStrings(i, " { "), c, " = push("));
        out = catStrings(out, cat3(cat3(catStrings(c, ", clone(get("), src, ", "), i, "))); "));
        out = catStrings(out, cat3(catStrings(i, " = "), i, " + 1; }; "));
        if kind = 2 { return push(push([], out), cat3("Array::fromList(", c, ")")); };
        return push(push([], out), c);
    };
    return push(push([], ""), cat3("clone(", src, ")"));
};
// ---- arena reordering: records in AstData emission order, renumbered ----
struct Arena { old: List<AstNode>, nodes: List<AstNode>, map: List<Int> };
impl Clone for Arena { };

fn arenaEmit(a: Arena, id: Int) -> Arena ~ {
    node = nodeAtList(a.old, id);
    if isListNode(node) { return arenaEmitList(a, id); };
    out = a;
    for child in nodeChildren(node) { out = arenaEmit(out, child); };
    newNode = remapNode(nodeAtList(out.old, id), out.map);
    newId = size(out.nodes);
    out = Arena { nodes: push(out.nodes, newNode), ..out };
    out = Arena { map: setIntAt(out.map, id, newId), ..out };
    return out;
};

fn arenaEmitList(a: Arena, id: Int) -> Arena ~ {
    chain = chainOf(a.old, id);
    heads = getChainHeads(chain);
    consIds = getChainCons(chain);
    out = a;
    endId = getChainEnd(chain);
    newEnd = size(out.nodes);
    out = Arena { nodes: push(out.nodes, nodeAtList(out.old, endId)), ..out };
    out = Arena { map: setIntAt(out.map, endId, newEnd), ..out };
    i = size(heads) - 1;
    while i >= 0 ~ {
        out = arenaEmit(out, intAtOr(heads, i, 0));
        consId = intAtOr(consIds, i, 0);
        consNode = remapNode(nodeAtList(out.old, consId), out.map);
        newId = size(out.nodes);
        out = Arena { nodes: push(out.nodes, consNode), ..out };
        out = Arena { map: setIntAt(out.map, consId, newId), ..out };
        i = i - 1;
    };
    return out;
};

fn reorderArena(nodes: &List<AstNode>, root: Int) -> AstProgram ~ {
    mapInit = [];
    for n in nodes { mapInit = push(mapInit, 0 - 1); };
    a = Arena { old: clone(nodes), nodes: [], map: mapInit };
    a = arenaEmit(a, root);
    return AstProgram { elaborated: false, nodes: a.nodes, root: intAtOr(a.map, root, root) };
};


fn getChainEnd(chain: &List<Int>) -> Int ~ { return intAtOr(chain, 0, 0); };
fn getChainHeads(chain: &List<Int>) -> List<Int> ~ { out = []; i = 1; while i < size(chain) ~ { out = push(out, get(chain, i)); i = i + 2; }; return out; };
fn getChainCons(chain: &List<Int>) -> List<Int> ~ { out = []; i = 2; while i < size(chain) ~ { out = push(out, get(chain, i)); i = i + 2; }; return out; };

fn chainOf(old: &List<AstNode>, id: Int) -> List<Int> ~ {
    cur = id; heads = []; cons = []; endId = id;
    loop = true;
    while loop ~ {
        node = nodeAtList(old, cur);
        if node is AstNode::Names { v = (node as AstNode::Names).value; match v { AstNames::End => { endId = cur; loop = false; }, AstNames::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Values { v = (node as AstNode::Values).value; match v { AstValues::End => { endId = cur; loop = false; }, AstValues::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Statements { v = (node as AstNode::Statements).value; match v { AstStatements::End => { endId = cur; loop = false; }, AstStatements::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Expressions { v = (node as AstNode::Expressions).value; match v { AstExpressions::End => { endId = cur; loop = false; }, AstExpressions::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Validations { v = (node as AstNode::Validations).value; match v { AstValidations::End => { endId = cur; loop = false; }, AstValidations::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Proofs { v = (node as AstNode::Proofs).value; match v { AstProofs::End => { endId = cur; loop = false; }, AstProofs::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Fields { v = (node as AstNode::Fields).value; match v { AstFields::End => { endId = cur; loop = false; }, AstFields::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Variants { v = (node as AstNode::Variants).value; match v { AstVariants::End => { endId = cur; loop = false; }, AstVariants::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::ValueFields { v = (node as AstNode::ValueFields).value; match v { AstValueFields::End => { endId = cur; loop = false; }, AstValueFields::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Types { v = (node as AstNode::Types).value; match v { AstTypes::End => { endId = cur; loop = false; }, AstTypes::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Args { v = (node as AstNode::Args).value; match v { AstArgs::End => { endId = cur; loop = false; }, AstArgs::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::TraitFns { v = (node as AstNode::TraitFns).value; match v { AstTraitFns::End => { endId = cur; loop = false; }, AstTraitFns::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        if node is AstNode::Bounds { v = (node as AstNode::Bounds).value; match v { AstBounds::End => { endId = cur; loop = false; }, AstBounds::Cons { head: h, tail: t } => { heads = push(heads, h); cons = push(cons, cur); cur = t; }, }; } else {
        loop = false;
        };
        };
        };
        };
        };
        };
        };
        };
        };
        };
        };
        };
        };
    };
    out = push([], endId); i = 0; for h in heads { out = push(out, h); out = push(out, intAtOr(cons, i, 0)); i = i + 1; }; return out;
};

fn isListNode(node: &AstNode) -> Bool ~ {
    if node is AstNode::Names { return true; };
    if node is AstNode::Values { return true; };
    if node is AstNode::Statements { return true; };
    if node is AstNode::Expressions { return true; };
    if node is AstNode::Validations { return true; };
    if node is AstNode::Proofs { return true; };
    if node is AstNode::Fields { return true; };
    if node is AstNode::Variants { return true; };
    if node is AstNode::ValueFields { return true; };
    if node is AstNode::Types { return true; };
    if node is AstNode::Args { return true; };
    if node is AstNode::TraitFns { return true; };
    if node is AstNode::Bounds { return true; };
    return false;
};

fn nodeChildren(node: &AstNode) -> List<Int> ~ {
    out = [];
    if node is AstNode::Name { v = (node as AstNode::Name).value;
        match v {
            AstName::End  => { out = []; },
            AstName::Part { text: text, tail: tail } => { out = push([], tail); },
        };
    };
    if node is AstNode::Value { v = (node as AstNode::Value).value;
        match v {
            AstValue::VInt { n: n } => { out = push([], n); },
            AstValue::VList { xs: xs } => { out = push([], xs); },
            AstValue::VBool { b: b } => { out = []; },
            AstValue::VData { n: n, xs: xs } => { out = push(push([], n), xs); },
            AstValue::VFnRef { n: n } => { out = push([], n); },
            AstValue::VFunct { ps: ps, ins: ins, outs: outs, body: body, exports: exports } => { out = push(push(push(push(push([], ps), ins), outs), body), exports); },
        };
    };
    if node is AstNode::Body { v = (node as AstNode::Body).value;
        match v {
            AstBody::NativeFunct { sig: sig, term: term, stmts: stmts } => { out = push(push(push([], sig), term), stmts); },
            AstBody::BuiltinFunct { b: b } => { out = push([], b); },
        };
    };
    if node is AstNode::Expression { v = (node as AstNode::Expression).value;
        match v {
            AstExpression::Val { v: v } => { out = push([], v); },
            AstExpression::Var { n: n } => { out = push([], n); },
            AstExpression::F { f: f, xs: xs } => { out = push(push([], f), xs); },
        };
    };
    if node is AstNode::Termination { v = (node as AstNode::Termination).value;
        match v {
            AstTermination::Shrinks { e: e } => { out = push([], e); },
            AstTermination::Counting { e: e } => { out = push([], e); },
            AstTermination::Parts { e: e } => { out = push([], e); },
            AstTermination::MayDiverge  => { out = []; },
            AstTermination::Recursing { t: t } => { out = push([], t); },
        };
    };
    if node is AstNode::Validation { v = (node as AstNode::Validation).value;
        match v {
            AstValidation::Rewrite { r: r } => { out = push([], r); },
            AstValidation::ProofAssert { p: p } => { out = push([], p); },
            AstValidation::AssignProofVar { n: n, e: e } => { out = push(push([], n), e); },
            AstValidation::Assume { p: p } => { out = push([], p); },
        };
    };
    if node is AstNode::Proof { v = (node as AstNode::Proof).value;
        match v {
            AstProof::FApp { f: f, xs: xs } => { out = push(push([], f), xs); },
            AstProof::ATerm { n: n } => { out = push([], n); },
            AstProof::CTerm { v: v } => { out = push([], v); },
            AstProof::Forall { n: n, gs: gs, b: b } => { out = push(push(push([], n), gs), b); },
            AstProof::BVar { n: n } => { out = push([], n); },
        };
    };
    if node is AstNode::Rule { v = (node as AstNode::Rule).value;
        match v {
            AstRule::Refl { p: p } => { out = push([], p); },
            AstRule::Eval { n: n } => { out = push([], n); },
            AstRule::EvalAll  => { out = []; },
            AstRule::CheckGtZero { p: p } => { out = push([], p); },
            AstRule::CheckRel { p: p } => { out = push([], p); },
            AstRule::UserRewrite { n: n, xs: xs } => { out = push(push([], n), xs); },
        };
    };
    if node is AstNode::Statement { v = (node as AstNode::Statement).value;
        match v {
            AstStatement::Assign { n: n, e: e } => { out = push(push([], n), e); },
            AstStatement::AssignDeref { a: a, b: b } => { out = push(push([], a), b); },
            AstStatement::Let { n: n, e: e } => { out = push(push([], n), e); },
            AstStatement::Return { e: e } => { out = push([], e); },
            AstStatement::ValidationStatement { v: v } => { out = push([], v); },
            AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: vs } => { out = push(push(push(push([], n), ps), fs), vs); },
            AstStatement::EnumDef { n: n, vs: vs } => { out = push(push([], n), vs); },
            AstStatement::AxiomDef { n: n, ps: ps, ins: ins, outs: outs } => { out = push(push(push(push([], n), ps), ins), outs); },
            AstStatement::ProofDef { n: n, ps: ps, ins: ins, outs: outs, body: body } => { out = push(push(push(push(push([], n), ps), ins), outs), body); },
            AstStatement::Block { xs: xs } => { out = push([], xs); },
            AstStatement::If { e: e, a: a, b: b } => { out = push(push(push([], e), a), b); },
            AstStatement::While { e: e, vs: vs, t: t, xs: xs } => { out = push(push(push(push([], e), vs), t), xs); },
            AstStatement::TraitDef { n: n, ps: ps, fs: fs } => { out = push(push(push([], n), ps), fs); },
            AstStatement::ImplDef { traitName: traitName, args: args, n: n, ty: ty, bs: bs, xs: xs } => { out = push(push(push(push(push(push([], traitName), args), n), ty), bs), xs); },
            AstStatement::BoundedDef { bs: bs, s: s } => { out = push(push([], bs), s); },
            AstStatement::Mark { line: line, col: col } => { out = []; },
            AstStatement::CopyDef { n: n } => { out = push([], n); },
            AstStatement::LinearDef { n: n } => { out = push([], n); },
            AstStatement::ExternDef { n: n } => { out = push([], n); },
            AstStatement::DropDef { n: n } => { out = push([], n); },
            AstStatement::Dissolve { n: n } => { out = push([], n); },
        };
    };
    if node is AstNode::Arg { v = (node as AstNode::Arg).value;
        match v {
            AstArg::ArgSize { s: s } => { out = push([], s); },
            AstArg::ArgType { t: t } => { out = push([], t); },
        };
    };
    if node is AstNode::OptName { v = (node as AstNode::OptName).value;
        match v {
            AstOptName::NoName  => { out = []; },
            AstOptName::SomeName { n: n } => { out = push([], n); },
        };
    };
    if node is AstNode::OptTermination { v = (node as AstNode::OptTermination).value;
        match v {
            AstOptTermination::NoTermination  => { out = []; },
            AstOptTermination::SomeTermination { t: t } => { out = push([], t); },
        };
    };
    if node is AstNode::Builtin { v = (node as AstNode::Builtin).value;
        match v {
            AstBuiltin::Ctor { n: n, args: args, fs: fs } => { out = push(push(push([], n), args), fs); },
            AstBuiltin::FieldBuiltin { owner: owner, n: n } => { out = push(push([], owner), n); },
            AstBuiltin::Is { n: n } => { out = push([], n); },
            AstBuiltin::Project { n: n, f: f } => { out = push(push([], n), f); },
            AstBuiltin::Cast { n: n } => { out = push([], n); },
            AstBuiltin::ToWord { signed: signed, bits: bits } => { out = []; },
            AstBuiltin::Rel { r: r } => { out = []; },
            AstBuiltin::Primitive { name: name } => { out = []; },
        };
    };
    if node is AstNode::Signature { v = (node as AstNode::Signature).value;
        out = push(push(push(push(push(push([], v.ts), v.ret), v.ss), v.ps), v.ws), v.fs);
    };
    if node is AstNode::TraitFn { v = (node as AstNode::TraitFn).value;
        out = push(push(push(push(push([], v.n), v.ps), v.sig), v.ins), v.outs);
    };
    if node is AstNode::Bound { v = (node as AstNode::Bound).value;
        out = push(push(push([], v.p), v.n), v.ts);
    };
    if node is AstNode::Field { v = (node as AstNode::Field).value;
        out = push(push([], v.n), v.ty);
    };
    if node is AstNode::Variant { v = (node as AstNode::Variant).value;
        out = push(push([], v.n), v.fs);
    };
    if node is AstNode::ValueField { v = (node as AstNode::ValueField).value;
        out = push(push([], v.n), v.v);
    };
    if node is AstNode::Elaborated { v = (node as AstNode::Elaborated).value;
        out = push(push([], v.statements), v.types);
    };
    if node is AstNode::Type { out = []; };
    if node is AstNode::Size { out = []; };
    if node is AstNode::Names { out = []; };
    if node is AstNode::Values { out = []; };
    if node is AstNode::Statements { out = []; };
    if node is AstNode::Expressions { out = []; };
    if node is AstNode::Validations { out = []; };
    if node is AstNode::Proofs { out = []; };
    if node is AstNode::Fields { out = []; };
    if node is AstNode::Variants { out = []; };
    if node is AstNode::ValueFields { out = []; };
    if node is AstNode::Types { out = []; };
    if node is AstNode::Args { out = []; };
    if node is AstNode::TraitFns { out = []; };
    if node is AstNode::Bounds { out = []; };
    return out;
};

fn remapNode(node: AstNode, map: &List<Int>) -> AstNode ~ {
    result = clone(node);
    if node is AstNode::Name { v = clone((node as AstNode::Name).value);
        match v {
            AstName::End  => { result = AstNode::Name { value: AstName::End  }; },
            AstName::Part { text: text, tail: tail } => { result = AstNode::Name { value: AstName::Part { text: text, tail: intAtOr(map, tail, tail) } }; },
        };
    };
    if node is AstNode::Value { v = clone((node as AstNode::Value).value);
        match v {
            AstValue::VInt { n: n } => { result = AstNode::Value { value: AstValue::VInt { n: intAtOr(map, n, n) } }; },
            AstValue::VList { xs: xs } => { result = AstNode::Value { value: AstValue::VList { xs: intAtOr(map, xs, xs) } }; },
            AstValue::VBool { b: b } => { result = AstNode::Value { value: AstValue::VBool { b: b } }; },
            AstValue::VData { n: n, xs: xs } => { result = AstNode::Value { value: AstValue::VData { n: intAtOr(map, n, n), xs: intAtOr(map, xs, xs) } }; },
            AstValue::VFnRef { n: n } => { result = AstNode::Value { value: AstValue::VFnRef { n: intAtOr(map, n, n) } }; },
            AstValue::VFunct { ps: ps, ins: ins, outs: outs, body: body, exports: exports } => { result = AstNode::Value { value: AstValue::VFunct { ps: intAtOr(map, ps, ps), ins: intAtOr(map, ins, ins), outs: intAtOr(map, outs, outs), body: intAtOr(map, body, body), exports: intAtOr(map, exports, exports) } }; },
        };
    };
    if node is AstNode::Body { v = clone((node as AstNode::Body).value);
        match v {
            AstBody::NativeFunct { sig: sig, term: term, stmts: stmts } => { result = AstNode::Body { value: AstBody::NativeFunct { sig: intAtOr(map, sig, sig), term: intAtOr(map, term, term), stmts: intAtOr(map, stmts, stmts) } }; },
            AstBody::BuiltinFunct { b: b } => { result = AstNode::Body { value: AstBody::BuiltinFunct { b: intAtOr(map, b, b) } }; },
        };
    };
    if node is AstNode::Expression { v = clone((node as AstNode::Expression).value);
        match v {
            AstExpression::Val { v: v } => { result = AstNode::Expression { value: AstExpression::Val { v: intAtOr(map, v, v) } }; },
            AstExpression::Var { n: n } => { result = AstNode::Expression { value: AstExpression::Var { n: intAtOr(map, n, n) } }; },
            AstExpression::F { f: f, xs: xs } => { result = AstNode::Expression { value: AstExpression::F { f: intAtOr(map, f, f), xs: intAtOr(map, xs, xs) } }; },
        };
    };
    if node is AstNode::Termination { v = clone((node as AstNode::Termination).value);
        match v {
            AstTermination::Shrinks { e: e } => { result = AstNode::Termination { value: AstTermination::Shrinks { e: intAtOr(map, e, e) } }; },
            AstTermination::Counting { e: e } => { result = AstNode::Termination { value: AstTermination::Counting { e: intAtOr(map, e, e) } }; },
            AstTermination::Parts { e: e } => { result = AstNode::Termination { value: AstTermination::Parts { e: intAtOr(map, e, e) } }; },
            AstTermination::MayDiverge  => { result = AstNode::Termination { value: AstTermination::MayDiverge  }; },
            AstTermination::Recursing { t: t } => { result = AstNode::Termination { value: AstTermination::Recursing { t: intAtOr(map, t, t) } }; },
        };
    };
    if node is AstNode::Validation { v = clone((node as AstNode::Validation).value);
        match v {
            AstValidation::Rewrite { r: r } => { result = AstNode::Validation { value: AstValidation::Rewrite { r: intAtOr(map, r, r) } }; },
            AstValidation::ProofAssert { p: p } => { result = AstNode::Validation { value: AstValidation::ProofAssert { p: intAtOr(map, p, p) } }; },
            AstValidation::AssignProofVar { n: n, e: e } => { result = AstNode::Validation { value: AstValidation::AssignProofVar { n: intAtOr(map, n, n), e: intAtOr(map, e, e) } }; },
            AstValidation::Assume { p: p } => { result = AstNode::Validation { value: AstValidation::Assume { p: intAtOr(map, p, p) } }; },
        };
    };
    if node is AstNode::Proof { v = clone((node as AstNode::Proof).value);
        match v {
            AstProof::FApp { f: f, xs: xs } => { result = AstNode::Proof { value: AstProof::FApp { f: intAtOr(map, f, f), xs: intAtOr(map, xs, xs) } }; },
            AstProof::ATerm { n: n } => { result = AstNode::Proof { value: AstProof::ATerm { n: intAtOr(map, n, n) } }; },
            AstProof::CTerm { v: v } => { result = AstNode::Proof { value: AstProof::CTerm { v: intAtOr(map, v, v) } }; },
            AstProof::Forall { n: n, gs: gs, b: b } => { result = AstNode::Proof { value: AstProof::Forall { n: intAtOr(map, n, n), gs: intAtOr(map, gs, gs), b: intAtOr(map, b, b) } }; },
            AstProof::BVar { n: n } => { result = AstNode::Proof { value: AstProof::BVar { n: intAtOr(map, n, n) } }; },
        };
    };
    if node is AstNode::Rule { v = clone((node as AstNode::Rule).value);
        match v {
            AstRule::Refl { p: p } => { result = AstNode::Rule { value: AstRule::Refl { p: intAtOr(map, p, p) } }; },
            AstRule::Eval { n: n } => { result = AstNode::Rule { value: AstRule::Eval { n: intAtOr(map, n, n) } }; },
            AstRule::EvalAll  => { result = AstNode::Rule { value: AstRule::EvalAll  }; },
            AstRule::CheckGtZero { p: p } => { result = AstNode::Rule { value: AstRule::CheckGtZero { p: intAtOr(map, p, p) } }; },
            AstRule::CheckRel { p: p } => { result = AstNode::Rule { value: AstRule::CheckRel { p: intAtOr(map, p, p) } }; },
            AstRule::UserRewrite { n: n, xs: xs } => { result = AstNode::Rule { value: AstRule::UserRewrite { n: intAtOr(map, n, n), xs: intAtOr(map, xs, xs) } }; },
        };
    };
    if node is AstNode::Statement { v = clone((node as AstNode::Statement).value);
        match v {
            AstStatement::Assign { n: n, e: e } => { result = AstNode::Statement { value: AstStatement::Assign { n: intAtOr(map, n, n), e: intAtOr(map, e, e) } }; },
            AstStatement::AssignDeref { a: a, b: b } => { result = AstNode::Statement { value: AstStatement::AssignDeref { a: intAtOr(map, a, a), b: intAtOr(map, b, b) } }; },
            AstStatement::Let { n: n, e: e } => { result = AstNode::Statement { value: AstStatement::Let { n: intAtOr(map, n, n), e: intAtOr(map, e, e) } }; },
            AstStatement::Return { e: e } => { result = AstNode::Statement { value: AstStatement::Return { e: intAtOr(map, e, e) } }; },
            AstStatement::ValidationStatement { v: v } => { result = AstNode::Statement { value: AstStatement::ValidationStatement { v: intAtOr(map, v, v) } }; },
            AstStatement::StructDef { n: n, ps: ps, fs: fs, vs: vs } => { result = AstNode::Statement { value: AstStatement::StructDef { n: intAtOr(map, n, n), ps: intAtOr(map, ps, ps), fs: intAtOr(map, fs, fs), vs: intAtOr(map, vs, vs) } }; },
            AstStatement::EnumDef { n: n, vs: vs } => { result = AstNode::Statement { value: AstStatement::EnumDef { n: intAtOr(map, n, n), vs: intAtOr(map, vs, vs) } }; },
            AstStatement::AxiomDef { n: n, ps: ps, ins: ins, outs: outs } => { result = AstNode::Statement { value: AstStatement::AxiomDef { n: intAtOr(map, n, n), ps: intAtOr(map, ps, ps), ins: intAtOr(map, ins, ins), outs: intAtOr(map, outs, outs) } }; },
            AstStatement::ProofDef { n: n, ps: ps, ins: ins, outs: outs, body: body } => { result = AstNode::Statement { value: AstStatement::ProofDef { n: intAtOr(map, n, n), ps: intAtOr(map, ps, ps), ins: intAtOr(map, ins, ins), outs: intAtOr(map, outs, outs), body: intAtOr(map, body, body) } }; },
            AstStatement::Block { xs: xs } => { result = AstNode::Statement { value: AstStatement::Block { xs: intAtOr(map, xs, xs) } }; },
            AstStatement::If { e: e, a: a, b: b } => { result = AstNode::Statement { value: AstStatement::If { e: intAtOr(map, e, e), a: intAtOr(map, a, a), b: intAtOr(map, b, b) } }; },
            AstStatement::While { e: e, vs: vs, t: t, xs: xs } => { result = AstNode::Statement { value: AstStatement::While { e: intAtOr(map, e, e), vs: intAtOr(map, vs, vs), t: intAtOr(map, t, t), xs: intAtOr(map, xs, xs) } }; },
            AstStatement::TraitDef { n: n, ps: ps, fs: fs } => { result = AstNode::Statement { value: AstStatement::TraitDef { n: intAtOr(map, n, n), ps: intAtOr(map, ps, ps), fs: intAtOr(map, fs, fs) } }; },
            AstStatement::ImplDef { traitName: traitName, args: args, n: n, ty: ty, bs: bs, xs: xs } => { result = AstNode::Statement { value: AstStatement::ImplDef { traitName: intAtOr(map, traitName, traitName), args: intAtOr(map, args, args), n: intAtOr(map, n, n), ty: intAtOr(map, ty, ty), bs: intAtOr(map, bs, bs), xs: intAtOr(map, xs, xs) } }; },
            AstStatement::BoundedDef { bs: bs, s: s } => { result = AstNode::Statement { value: AstStatement::BoundedDef { bs: intAtOr(map, bs, bs), s: intAtOr(map, s, s) } }; },
            AstStatement::Mark { line: line, col: col } => { result = AstNode::Statement { value: AstStatement::Mark { line: line, col: col } }; },
            AstStatement::CopyDef { n: n } => { result = AstNode::Statement { value: AstStatement::CopyDef { n: intAtOr(map, n, n) } }; },
            AstStatement::LinearDef { n: n } => { result = AstNode::Statement { value: AstStatement::LinearDef { n: intAtOr(map, n, n) } }; },
            AstStatement::ExternDef { n: n } => { result = AstNode::Statement { value: AstStatement::ExternDef { n: intAtOr(map, n, n) } }; },
            AstStatement::DropDef { n: n } => { result = AstNode::Statement { value: AstStatement::DropDef { n: intAtOr(map, n, n) } }; },
            AstStatement::Dissolve { n: n } => { result = AstNode::Statement { value: AstStatement::Dissolve { n: intAtOr(map, n, n) } }; },
        };
    };
    if node is AstNode::Arg { v = clone((node as AstNode::Arg).value);
        match v {
            AstArg::ArgSize { s: s } => { result = AstNode::Arg { value: AstArg::ArgSize { s: intAtOr(map, s, s) } }; },
            AstArg::ArgType { t: t } => { result = AstNode::Arg { value: AstArg::ArgType { t: intAtOr(map, t, t) } }; },
        };
    };
    if node is AstNode::OptName { v = clone((node as AstNode::OptName).value);
        match v {
            AstOptName::NoName  => { result = AstNode::OptName { value: AstOptName::NoName  }; },
            AstOptName::SomeName { n: n } => { result = AstNode::OptName { value: AstOptName::SomeName { n: intAtOr(map, n, n) } }; },
        };
    };
    if node is AstNode::OptTermination { v = clone((node as AstNode::OptTermination).value);
        match v {
            AstOptTermination::NoTermination  => { result = AstNode::OptTermination { value: AstOptTermination::NoTermination  }; },
            AstOptTermination::SomeTermination { t: t } => { result = AstNode::OptTermination { value: AstOptTermination::SomeTermination { t: intAtOr(map, t, t) } }; },
        };
    };
    if node is AstNode::Builtin { v = clone((node as AstNode::Builtin).value);
        match v {
            AstBuiltin::Ctor { n: n, args: args, fs: fs } => { result = AstNode::Builtin { value: AstBuiltin::Ctor { n: intAtOr(map, n, n), args: intAtOr(map, args, args), fs: intAtOr(map, fs, fs) } }; },
            AstBuiltin::FieldBuiltin { owner: owner, n: n } => { result = AstNode::Builtin { value: AstBuiltin::FieldBuiltin { owner: intAtOr(map, owner, owner), n: intAtOr(map, n, n) } }; },
            AstBuiltin::Is { n: n } => { result = AstNode::Builtin { value: AstBuiltin::Is { n: intAtOr(map, n, n) } }; },
            AstBuiltin::Project { n: n, f: f } => { result = AstNode::Builtin { value: AstBuiltin::Project { n: intAtOr(map, n, n), f: intAtOr(map, f, f) } }; },
            AstBuiltin::Cast { n: n } => { result = AstNode::Builtin { value: AstBuiltin::Cast { n: intAtOr(map, n, n) } }; },
            AstBuiltin::ToWord { signed: signed, bits: bits } => { result = AstNode::Builtin { value: AstBuiltin::ToWord { signed: signed, bits: bits } }; },
            AstBuiltin::Rel { r: r } => { result = AstNode::Builtin { value: AstBuiltin::Rel { r: r } }; },
            AstBuiltin::Primitive { name: name } => { result = AstNode::Builtin { value: AstBuiltin::Primitive { name: name } }; },
        };
    };
    if node is AstNode::Signature { v = clone((node as AstNode::Signature).value);
        result = AstNode::Signature { value: AstSignature { ts: intAtOr(map, v.ts, v.ts), ret: intAtOr(map, v.ret, v.ret), ss: intAtOr(map, v.ss, v.ss), ps: intAtOr(map, v.ps, v.ps), ws: intAtOr(map, v.ws, v.ws), fs: intAtOr(map, v.fs, v.fs) } };
    };
    if node is AstNode::TraitFn { v = clone((node as AstNode::TraitFn).value);
        result = AstNode::TraitFn { value: AstTraitFn { n: intAtOr(map, v.n, v.n), ps: intAtOr(map, v.ps, v.ps), sig: intAtOr(map, v.sig, v.sig), ins: intAtOr(map, v.ins, v.ins), outs: intAtOr(map, v.outs, v.outs) } };
    };
    if node is AstNode::Bound { v = clone((node as AstNode::Bound).value);
        result = AstNode::Bound { value: AstBound { p: intAtOr(map, v.p, v.p), n: intAtOr(map, v.n, v.n), ts: intAtOr(map, v.ts, v.ts) } };
    };
    if node is AstNode::Field { v = clone((node as AstNode::Field).value);
        result = AstNode::Field { value: AstField { n: intAtOr(map, v.n, v.n), ty: intAtOr(map, v.ty, v.ty) } };
    };
    if node is AstNode::Variant { v = clone((node as AstNode::Variant).value);
        result = AstNode::Variant { value: AstVariant { n: intAtOr(map, v.n, v.n), fs: intAtOr(map, v.fs, v.fs) } };
    };
    if node is AstNode::ValueField { v = clone((node as AstNode::ValueField).value);
        result = AstNode::ValueField { value: AstValueField { n: intAtOr(map, v.n, v.n), v: intAtOr(map, v.v, v.v) } };
    };
    if node is AstNode::Elaborated { v = clone((node as AstNode::Elaborated).value);
        result = AstNode::Elaborated { value: AstElaborated { statements: intAtOr(map, v.statements, v.statements), types: intAtOr(map, v.types, v.types) } };
    };
    if node is AstNode::Names { v = clone((node as AstNode::Names).value); match v { AstNames::End => { result = clone(node); }, AstNames::Cons { head: h, tail: t } => { result = AstNode::Names { value: AstNames::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Values { v = clone((node as AstNode::Values).value); match v { AstValues::End => { result = clone(node); }, AstValues::Cons { head: h, tail: t } => { result = AstNode::Values { value: AstValues::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Statements { v = clone((node as AstNode::Statements).value); match v { AstStatements::End => { result = clone(node); }, AstStatements::Cons { head: h, tail: t } => { result = AstNode::Statements { value: AstStatements::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Expressions { v = clone((node as AstNode::Expressions).value); match v { AstExpressions::End => { result = clone(node); }, AstExpressions::Cons { head: h, tail: t } => { result = AstNode::Expressions { value: AstExpressions::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Validations { v = clone((node as AstNode::Validations).value); match v { AstValidations::End => { result = clone(node); }, AstValidations::Cons { head: h, tail: t } => { result = AstNode::Validations { value: AstValidations::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Proofs { v = clone((node as AstNode::Proofs).value); match v { AstProofs::End => { result = clone(node); }, AstProofs::Cons { head: h, tail: t } => { result = AstNode::Proofs { value: AstProofs::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Fields { v = clone((node as AstNode::Fields).value); match v { AstFields::End => { result = clone(node); }, AstFields::Cons { head: h, tail: t } => { result = AstNode::Fields { value: AstFields::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Variants { v = clone((node as AstNode::Variants).value); match v { AstVariants::End => { result = clone(node); }, AstVariants::Cons { head: h, tail: t } => { result = AstNode::Variants { value: AstVariants::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::ValueFields { v = clone((node as AstNode::ValueFields).value); match v { AstValueFields::End => { result = clone(node); }, AstValueFields::Cons { head: h, tail: t } => { result = AstNode::ValueFields { value: AstValueFields::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Types { v = clone((node as AstNode::Types).value); match v { AstTypes::End => { result = clone(node); }, AstTypes::Cons { head: h, tail: t } => { result = AstNode::Types { value: AstTypes::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Args { v = clone((node as AstNode::Args).value); match v { AstArgs::End => { result = clone(node); }, AstArgs::Cons { head: h, tail: t } => { result = AstNode::Args { value: AstArgs::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::TraitFns { v = clone((node as AstNode::TraitFns).value); match v { AstTraitFns::End => { result = clone(node); }, AstTraitFns::Cons { head: h, tail: t } => { result = AstNode::TraitFns { value: AstTraitFns::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    if node is AstNode::Bounds { v = clone((node as AstNode::Bounds).value); match v { AstBounds::End => { result = clone(node); }, AstBounds::Cons { head: h, tail: t } => { result = AstNode::Bounds { value: AstBounds::Cons { head: intAtOr(map, h, h), tail: intAtOr(map, t, t) } }; }, }; };
    return result;
};

fn hasTextPrefix(text: &String, prefix: &String) -> Bool ~ {
    if size(prefix.bytes) > size(text.bytes) { return false; };
    i = 0;
    while i < size(prefix.bytes) ~ { if get(text.bytes, i) != get(prefix.bytes, i) { return false; }; i = i + 1; };
    return true;
};

fn joinComma(xs: &List<String>) -> String ~ {
    out = "";
    i = 0;
    for x in xs { if i > 0 { out = catStrings(out, ", "); }; out = catStrings(out, x); i = i + 1; };
    return out;
};

// The import declarations at the head of the file segment (Parse.fileParser): their paths,
// rendered. A file with imports is parsed whole, and only then refused as not linked.
fn fileHead(st: St) -> Res<List<String>> ~ {
    s = skipWs(st);
    out = [];
    loop = true;
    while loop ~ {
        if atImportKeyword(s) {
            s = St { pos: s.pos + 6, ..s };
            s = skipWs(s);
            p = namePathOf(s);
            if !p.ok { return Res<List<String>> { st: p.st, v: [], ok: false }; };
            rendered = joinFrom(p.v, 0);
            s = skipWs(p.st);
            k = eatKeyword(s, "as");
            if k.v {
                s = skipWs(k.st);
                a = parseVariable(s);
                if !a.ok { return Res<List<String>> { st: a.st, v: [], ok: false }; };
                s = skipWs(a.st);
            } else { s = k.st; };
            if byteAt(s, s.pos) = 123 {
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
                if byteAt(s, s.pos) = 125 { return fail(s, out, "an import name list must not be empty"); };
                namesLoop = true;
                while namesLoop ~ {
                    w = parseVariable(s);
                    if !w.ok { return Res<List<String>> { st: w.st, v: [], ok: false }; };
                    s = skipWs(w.st);
                    if byteAt(s, s.pos) = 44 { s = St { pos: s.pos + 1, ..s }; s = skipWs(s); } else { namesLoop = false; };
                };
                if byteAt(s, s.pos) != 125 { return fail(s, out, "expected }"); };
                s = St { pos: s.pos + 1, ..s };
                s = skipWs(s);
            };
            if byteAt(s, s.pos) != 59 { return fail(s, out, "expected ;"); };
            s = St { pos: s.pos + 1, ..s };
            s = skipWs(s);
            out = push(out, rendered);
        } else { loop = false; };
    };
    return ok(s, out);
};

// One segment of the file the pipeline reads: the last segment is a file, with its import
// declarations; the libraries in front of it are statement blocks
fn parseSegment(state: St, isFile: Bool) -> Res<List<Int>> ~ {
    if !isFile { return statementBlock(state); };
    head = fileHead(state);
    if !head.ok { return Res<List<Int>> { st: head.st, v: [], ok: false }; };
    body = statementBlock(head.st);
    if !body.ok { return body; };
    bv = body.v;
    bs = body.st;
    if size(head.v) > 0 {
        s2 = skipWs(clone(bs));
        if atEnd(s2) { return fail(bs, [], catStrings("imports are not linked yet: ", joinComma(head.v))); };
    };
    return Res<List<Int>> { st: bs, v: bv, ok: true };
};

// ---- driver ----

fn parseNonNegative(text: &String) -> Int ~ {
    if size(text.bytes) = 0 { return 0 - 1; };
    n = 0;
    for i in 0..size(text.bytes) {
        c = toInt(get(text.bytes, i));
        if c < 48 || c > 57 { return 0 - 1; };
        n = n * 10 + c - 48;
    };
    return n;
};

fn splitTwoSpaces(line: &String) -> List<String> ~ {
    out = [];
    start = 0;
    i = 0;
    while i < size(line.bytes) ~ {
        if get(line.bytes, i) = toByte(32) { out = push(out, strSlice(line, start, i)); start = i + 1; };
        i = i + 1;
    };
    out = push(out, strSlice(line, start, size(line.bytes)));
    return out;
};

fn readSegmentBytes(count: Int) -> List<Int> ~ {
    bytes = [];
    i = 0;
    while i < count ~ {
        c = readByte();
        if c < 0 { return []; };
        bytes = push(bytes, c);
        i = i + 1;
    };
    if count = 0 { return push([], 0 - 1); };
    return bytes;
};

fn bytesToString(bytes: &List<Int>) -> String ~ {
    bs = [];
    for b in bytes { if b >= 0 && b < 256 { bs = push(bs, toByte(b)); } else { bs = push(bs, toByte(0)); }; };
    return String { bytes: bs };
};

headerLine = String::readLine(64);
if headerLine != "tersus-parse 1" { "tersus parser: bad header, expected tersus-parse 1\n".printError(); return 1; };
metaLine = String::readLine(64);
meta = splitTwoSpaces(metaLine);
if size(meta) != 2 { "tersus parser: bad segment line\n".printError(); return 1; };
locatingFlag = parseNonNegative(get(meta, 0));
segmentCount = parseNonNegative(get(meta, 1));
if locatingFlag < 0 || locatingFlag > 1 || segmentCount < 0 { "tersus parser: bad segment line\n".printError(); return 1; };
state = newSt("");
allStatements = [];
parseFailed = false;
failMessage = "";
failSource = "";
failPos = 0;
si = 0;
while si < segmentCount && !parseFailed ~ {
    countLine = String::readLine(64);
    byteCount = parseNonNegative(countLine);
    if byteCount < 0 { parseFailed = true; failMessage = "bad byte count"; }
    else {
        seg = readSegmentBytes(byteCount);
        if byteCount > 0 && size(seg) != byteCount { parseFailed = true; failMessage = "short input"; }
        else {
            if byteCount = 0 && size(seg) = 1 && get(seg, 0) = 0 - 1 { seg = []; };
            source = bytesToString(seg);
            state = St { src: clone(source), ..state };
            state = St { pos: 0, ..state };
            state = St { locate: locatingFlag = 1 && si = segmentCount - 1, ..state };
            state = St { err: "", ..state };
            parsed = parseSegment(state, si = segmentCount - 1);
            if !parsed.ok {
                parseFailed = true;
                failMessage = parsed.st.err;
                if size(failMessage.bytes) = 0 { failMessage = "parse error"; };
                failSource = source;
                failPos = parsed.st.errPos;
                state = parsed.st;
            } else {
                s = skipWs(parsed.st);
                if !atEnd(s) {
                    parseFailed = true;
                    failMessage = "expected the end of the input";
                    failSource = source;
                    failPos = s.pos;
                    state = s;
                } else {
                    state = s;
                    for x in parsed.v { allStatements = push(allStatements, x); };
                };
            };
        };
    };
    si = si + 1;
};
if parseFailed {
    if hasTextPrefix(failMessage, "imports are not linked yet: ") {
        msg = catStrings(clone(failMessage), "\n");
        msg.printError();
        return 1;
    };
    lc = lineCol(failSource, failPos);
    msg = cat3(cat3("line ", String::fromInt(get(lc, 0)), ":"), String::fromInt(get(lc, 1)), ": ");
    msg = catStrings(catStrings(msg, failMessage), "\n");
    msg.printError();
    return 1;
};
rootResult = statementsList(state, allStatements);
if !rootResult.ok { "tersus parser: internal arena failure\n".printError(); return 1; };
written = printAst(reorderArena(rootResult.st.nodes, rootResult.v));
return 0;
