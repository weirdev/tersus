// Early return. `return` ends the function (or the program) where it runs, so a guard clause
// can leave the rest of the function to a case that is already known to be safe.
fn firstOr(lst, fallback) {
    // Guard clause: the else branch returns, so the statements below only run when
    // size(lst) > 0, and the validator checks them under that assumption.
    if size(lst) > 0 {
    } else {
        return fallback;
    };
    define s = size(lst);
    rewrite eqToGtZero s;
    return first(lst);
};

// A chain of guard clauses, one per case.
fn sign(n) {
    if n < 0 {
        return 0 - 1;
    };
    if n > 0 {
        return 1;
    };
    return 0;
};

// 4 + 100 + (-1) + 1 + 0
return firstOr([4, 8], 0) + firstOr([], 100) + sign(0 - 5) + sign(7) + sign(0);
