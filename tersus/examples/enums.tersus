// An enum is a type with several variants, each with its own named fields. Variants are written
// Enum::Variant, and `x is Enum::Variant` tests which one a value is. A match takes a value apart:
// every variant needs an arm, and an arm binds the fields it names.
enum Shape {
    Circle { radius: Int },
    Rect { width: Int, height: Int },
    Empty,
};

// Fields that are numbers can be copied wherever the value is wanted, if the enum says so (without Copy a value is moved, and
// a program that needs it again writes clone(s), which needs Clone)
impl Clone for Shape { };
impl Copy for Shape { };

fn area(s: Shape) -> Int {
    return match s {
        Shape::Circle { radius: r } => r * r * 3,
        Shape::Rect { width: w, height: h } => w * h,
        Shape::Empty => 0,
    };
};

// A field of an enum value is read after a cast to the variant that has it. The validator asks for the proof
// that the value is that variant (the contract demands it here, and the caller has to show it); running a
// cast does nothing, and a wrong one is undefined behaviour.
fn radiusOf(s: Shape) -> Int
    [{ affirm s is Shape::Circle; }]
    [{ affirm return = (s as Shape::Circle).radius; }]
{
    return (s as Shape::Circle).radius;
};

// A type cannot hold itself (it would have no size), but it can hold a Box of itself. A Box has the value of what it holds, and
// is looked into where the enum is: tested with `is`, cast, matched and read for a field as the enum would be.
enum Tree {
    Leaf,
    Branch { left: Box<Tree>, value: Int, right: Box<Tree> },
};

fn sum(t: Box<Tree>) -> Int shrinks t {
    return match t {
        Tree::Leaf => 0,
        Tree::Branch { left: l, value: v, right: r } => v + sum(l) + sum(r),
    };
};

circle = Shape::Circle { radius: 2 };
affirm circle is Shape::Circle;
radius = radiusOf(circle);
affirm radius = 2;
tree = Box::new(Tree::Branch {
    left: Box::new(Tree::Branch { left: Box::new(Tree::Leaf), value: 1, right: Box::new(Tree::Leaf) }),
    value: 2,
    right: Box::new(Tree::Leaf),
});
return area(circle) + area(Shape::Rect { width: 3, height: 4 }) + sum(tree);
