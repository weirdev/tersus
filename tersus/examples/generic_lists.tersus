// Lists hold any one type of element: List<Int>, List<Bool>, List<List<Int>>.
// An element is a term like any other, so contracts and foralls work on them.
fn flags(values: List<Int>) -> List<Bool> {
    out = [];
    for value in values {
        out = push(out, value > 0);
    };
    return out;
};

// Appends a copy of the first row; the new last row is known to be that copy.
fn repeatFirst(rows: List<List<Int>>) -> List<List<Int>>
    [{ affirm size(rows) > 0; }]
    [{ affirm size(return) = size(rows) + 1; affirm get(return, size(rows)) = get(rows, 0); }]
{
    return push(rows, first(rows));
};

marks = flags([3, -1]);
affirm size(marks) = 2;
rows = [[1, 2], [3, 4]];
return repeatFirst(rows);
