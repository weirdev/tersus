// A doubly linked list stored in an array: the links are indexes into the list.
// Index 0 is a sentinel, and a list with one node points to itself both ways.
//
// What the validator proves is that the list is well formed: every link is a valid index, so following a
// link with `get` can never fail, and the two directions agree (the node after i has i before it, and the
// node before i has i after it). The operations keep both true. The invariant is six foralls.
struct Node { value: Int, prev: Int, next: Int };

// The links of every node are inside the list and agree with each other
fn insertAfter(nodes: List<Node>, p: Int, v: Int) -> List<Node>
    [{
        affirm size(nodes) > 0;
        affirm p >= 0; affirm p < size(nodes);
        affirm forall i in 0..size(nodes): get(nodes, i).next >= 0;
        affirm forall i in 0..size(nodes): get(nodes, i).next < size(nodes);
        affirm forall i in 0..size(nodes): get(nodes, i).prev >= 0;
        affirm forall i in 0..size(nodes): get(nodes, i).prev < size(nodes);
        affirm forall i in 0..size(nodes): get(nodes, get(nodes, i).next).prev = i;
        affirm forall i in 0..size(nodes): get(nodes, get(nodes, i).prev).next = i;
    }]
    [{
        affirm size(return) = size(nodes) + 1;
        affirm forall i in 0..size(return): get(return, i).next >= 0;
        affirm forall i in 0..size(return): get(return, i).next < size(return);
        affirm forall i in 0..size(return): get(return, i).prev >= 0;
        affirm forall i in 0..size(return): get(return, i).prev < size(return);
        affirm forall i in 0..size(return): get(return, get(return, i).next).prev = i;
        affirm forall i in 0..size(return): get(return, get(return, i).prev).next = i;
    }]
{
    q = get(nodes, p).next;           // the node after p, which is a valid index by the invariant
    n = size(nodes);                  // the new node goes at the end
    out = push(nodes, Node { value: v, prev: p, next: q });
    out = set(out, p, Node { next: n, ..get(out, p) });
    out = set(out, q, Node { prev: n, ..get(out, q) });
    return out;
};

// Following links is safe, however many times: cur is always a valid index
fn walk(nodes: List<Node>, start: Int, steps: Int) -> Int
    [{
        affirm start >= 0; affirm start < size(nodes);
        affirm forall i in 0..size(nodes): get(nodes, i).next >= 0;
        affirm forall i in 0..size(nodes): get(nodes, i).next < size(nodes);
    }]
    [{ affirm return >= 0; affirm return < size(nodes); }]
{
    cur = start;
    taken = 0;
    while taken < steps [{ affirm taken >= 0; affirm cur >= 0; affirm cur < size(nodes); }] {
        cur = get(nodes, cur).next;
        taken = taken + 1;
    };
    return cur;
};

// A list of one node that points to itself
single = push([], Node { value: 7, prev: 0, next: 0 });
two = insertAfter(single, 0, 8);
three = insertAfter(two, 1, 9);
return get(three, walk(three, 0, 2)).value;
