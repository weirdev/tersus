// Higher-order functions over lists, arrays, maps and sets: map, filter, fold, any, all, find and
// sortBy take a closure through an Fn bound, as free functions in the way size and get are free
// functions (the array forms are named for the array: mapArray, filterArray, foldArray, anyArray,
// allArray, findArray, sortArrayBy, since a function name is defined once). HashMap and HashSet
// have forEach, retainIf and fold as methods. What a caller can prove is said without calling the
// closure: map keeps the size, filter keeps at most the size, find gives an index in range or -1.

xs = push(push(push(push([], 3), 1), 2), 9);
doubled = map(xs, fn(x) => x * 2);
big = filter(xs, fn(x) => x > 1);
total = fold(xs, 0, fn(acc, x) => acc + x);
sorted = sortBy(xs, fn(a, b) => a < b);
found = find(xs, fn(x) => x = 2);

a = #[3, 1, 2];
aDoubled = mapArray(a, fn(x) => x * 2);
aSorted = sortArrayBy(a, fn(x, y) => x < y);
aTotal = foldArray(a, 0, fn(acc, x) => acc + x);

m = HashMap::new().insert(1, 10).insert(2, 20).insert(3, 30);
mTotal = hashMapFold(m, 0, fn(acc, k, v) => acc + (*v));
kept = hashMapRetainIf(m, fn(k, v) => (*v) > 15);

s = HashSet::new().insert(1).insert(2).insert(3);
sTotal = hashSetFold(s, 0, fn(acc, k) => acc + (*k));
sKept = hashSetRetainIf(s, fn(k) => (*k) > 1);

r = get(doubled, 3) * 10000000 + get(sorted, 0) * 1000000 + get(sorted, 3) * 100000 + size(big) * 10000 + total * 1000 + found * 100 + get(aDoubled, 2) * 10 + aTotal;
r = r + mTotal * 100000 + kept.size() * 10000 + sTotal * 1000 + sKept.size() * 100;
if any(xs, fn(x) => x > 8) { r = r + 10; };
if all(xs, fn(x) => x > 0) { r = r + 1; };
return r;
