// Rejected: one function of a mutually recursive pair is declared ~, so the other is not shown to end either.
fn isOdd(n: Int) -> Int [{ affirm n >= 0; }] [{ }] ~ {
    if n = 0 { return 0; } else { return isEven(n - 1); };
};
fn isEven(n: Int) -> Int [{ affirm n >= 0; }] [{ }] shrinks n {
    if n = 0 { return 1; } else { return isOdd(n - 1); };
};
return isEven(3);
