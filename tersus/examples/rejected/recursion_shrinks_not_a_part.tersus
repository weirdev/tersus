// Rejected: the call passes the tree itself, not one of its fields.
enum Tree {
    Leaf,
    Branch { left: Tree, right: Tree },
};

fn count(t: Tree) -> Int shrinks t {
    return match t {
        Tree::Leaf => 1,
        Tree::Branch { left: l, right: r } => count(l) + count(t),
    };
};
return count(Tree::Leaf);
