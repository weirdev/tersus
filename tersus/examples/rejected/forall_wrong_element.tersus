// Rejected: the loop builds the sums of the pairs, but the output contract claims one more than
// each sum. The invariant is right, so the loop validates, and the contract fails after it.
fn pairSums(a, b) [{
    affirm size(a) = size(b);
}] [{
    affirm forall j in 0..size(a): get(return, j) = ((get(a, j) + get(b, j)) + 1);
}] {
    n = size(a);
    i = 0;
    out = [];
    while i < n [{
        affirm i >= 0;
        affirm i <= n;
        affirm size(out) = i;
        affirm forall j in 0..i: get(out, j) = (get(a, j) + get(b, j));
    }] {
        out = push(out, get(a, i) + get(b, i));
        i = i + 1;
    };
    return out;
};
