// A growable list: `Vec<T>`, from the prelude (lib/prelude.tersus), which every program that mentions `Vec` or `Sequence` has. A Vec is a
// Box of an array that holds the elements and how many are in use; `push` into a full one makes an array twice as large. It implements
// `Sequence<E>` (`size`, `get`, `set`, `push`), so `size(v)`, `v.get(i)` and `v.push(x)` are the calls of its impl, and its invariant
// (0 <= len <= size(data), a capacity of at least 1) is what lets a loop that pushes say only `size(v) = i`.

// A Vec of Ints: the first 20 squares. The loop says what it keeps in terms of the size, and the invariant of Vec does the rest.
squares = Vec::new(0);
i = 0;
while i < 20 [{ affirm i >= 0; affirm i <= 20; affirm size(squares) = i; }] shrinks 20 - i {
    squares = squares.push(i * i);
    i = i + 1;
};

// A Vec of values that own something: the lists are moved in, cloned out, and freed with the Vec
rows = Vec::new(push([], 0));
rows = rows.push(push(push([], 1), 2));
rows = rows.push(push([], 3));
firstRow = rows.get(0);

// A Vec of Vecs
grid = Vec::new(Vec::new(0)).push(Vec::new(0).push(7));

// Setting and popping
flags = Vec::new(false).push(true).push(false).push(true);
flags = flags.set(0, true).pop();

return squares.get(19) + size(squares) + size(firstRow) * 1000 + size(grid) * 10000 + size(flags) * 100000;    // 361 + 20 + 2000 + 10000 + 200000
