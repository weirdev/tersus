// A growable list written in Tersus: a Box of an array that holds the elements, and how many of them are in use. The array is
// the capacity, and a push into a full one makes an array twice as large and moves the elements over.
//
// The functions are those of `impl<T> Vec<T>`, so a call is written `v.push(x)`. Each says what it keeps true: 0 <= len <= size(data),
// and a capacity of at least 1. A function over a Vec asks for it, and the ones that make a Vec promise it, so a caller that only builds
// Vecs with these functions never has to prove it again.
struct Vec<T> {
    data: Box<Array<T>>,
    len: Int,
};

impl<T> Vec<T> {
    // An empty Vec. The array needs an element to fill it with, which is never read: nothing is in use until it is pushed.
    fn new(filler: T) -> Self [{ }] [{ affirm return.len = 0; affirm size(return.data) = 4; }] {
        return Self { data: Array::boxed(4, filler), len: 0 };
    };

    fn len(self: &Self) -> Int [{ }] [{ affirm return = self.len; }] {
        return self.len;
    };

    // The element at an index in use
    fn get(self: &Self, i: Int) -> T [{ define n = self.len; define cap = size(self.data); affirm i >= 0; affirm i < n; affirm n <= cap; }] [{ }] {
        return get(self.data, i);
    };

    fn set(self: Self, i: Int, x: T) -> Self [{ define n = self.len; define cap = size(self.data); affirm i >= 0; affirm i < n; affirm n <= cap; }] [{ affirm return.len = self.len; affirm size(return.data) = size(self.data); }] {
        return Self { data: set(self.data, i, x), len: self.len };
    };

    fn push(self: Self, x: T) -> Self [{ define n = self.len; define cap = size(self.data); affirm n >= 0; affirm n <= cap; affirm cap >= 1; }] [{ affirm return.len = self.len + 1; affirm return.len <= size(return.data); affirm size(return.data) >= 1; }] {
        if self.len < size(self.data) {
            return Self { data: set(self.data, self.len, x), len: self.len + 1 };
        };
        big = Array::boxed(size(self.data) * 2, x);
        i = 0;
        while i < self.len [{ affirm i >= 0; affirm i <= self.len; affirm size(big) = size(self.data) * 2; }] shrinks self.len - i {
            big = set(big, i, get(self.data, i));
            i = i + 1;
        };
        return Self { data: set(big, self.len, x), len: self.len + 1 };
    };

    // Takes the last element out of use (it stays in the array, which holds it until it is written over or the Vec is freed)
    fn pop(self: Self) -> Self [{ define n = self.len; define cap = size(self.data); affirm n >= 1; affirm n <= cap; }] [{ affirm return.len = self.len - 1; affirm size(return.data) = size(self.data); }] {
        return Self { data: self.data, len: self.len - 1 };
    };
};

// A Vec of Ints: the first 20 squares
squares = Vec::new(0);
i = 0;
while i < 20 [{ affirm i >= 0; affirm i <= 20; affirm squares.len = i; define n = squares.len; define cap = size(squares.data); affirm n >= 0; affirm n <= cap; affirm cap >= 1; }] shrinks 20 - i {
    squares = squares.push(i * i);
    i = i + 1;
};

// A Vec of values that own something: the lists are moved in, cloned out, and freed with the Vec
rows = Vec::new(push([], 0));
rows = rows.push(push(push([], 1), 2));
rows = rows.push(push([], 3));
firstRow = rows.get(0);

// A Vec of Vecs
grid = Vec::new(Vec::new(0)).push(Vec::new(0).push(7));

// Setting and popping
flags = Vec::new(false).push(true).push(false).push(true);
flags = flags.set(0, true).pop();

return squares.get(19) + squares.len() + size(firstRow) * 1000 + grid.len() * 10000 + flags.len() * 100000;    // 361 + 20 + 2000 + 10000 + 200000
