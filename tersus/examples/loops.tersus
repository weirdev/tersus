// A while loop checked with an invariant. The validator reasons about integer comparisons
// and x + 1 itself, so it sees that i < 3 gives i + 1 <= 3 and that i = 0 gives i <= 3.

i = 0;
total = 0;
// The invariant must hold before the first iteration, is assumed at the start of the body,
// and must hold again at the end of the body.
while i < 3 [{ affirm i <= 3; }] shrinks 3 - i {
    i = i + 1;
    total = total + 10;
};
// After the loop the invariant holds and the condition does not.
affirm i <= 3;
affirm i >= 3;
return total;
