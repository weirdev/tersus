// Functions with one and several arguments, and one that relies on an input contract.
fn add1(i: Int) -> Int {
    return i + 1;
};

fn addThree(a: Int, b: Int, c: Int) -> Int {
    return a + b + c;
};

// first and last need a non-empty list, so the contract has to show size(lst) > 0.
fn sumFirstLast(lst: &List<Int>) -> Int [{
    define s = size(lst);
    rewrite eqToGtZero s;
    affirm s > 0;
}] {
    return first(lst) + last(lst);
};

x = add1(4);
y = sumFirstLast([3, 6, 9, 12]);
return addThree(x, y, 1);
