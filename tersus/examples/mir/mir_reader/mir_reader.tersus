// The MIR as data, read and written by a program (step 31 of the roadmap, see STEP31.md). It reads what `tersus mir --data` prints (see MirData in MIR.md)
// from the standard input into the types below, which are those of Mir.hs, and writes it again: the output is the input. It is the start of the lowering to LLVM IR
// that is written in Tersus (the emitter reads the program in this form), and the first program of its size, so it is also a test of the validator.
//
//     tersus mir --data examples/hello.tersus | tersus run examples/mir/mir_reader/mir_reader.tersus
//
// How it is written, which is how the rest of the emitter will be:
// - A line is split into tokens (a word, or a name in quotes), and a parser takes the tokens and the index of the one it starts at. It gives a `Parsed<T>`:
//   the value, the index after what it read, and whether it could be read. There are no options or results in the language, so a parser that fails gives a value
//   of no meaning, the index at the end of the line and `ok: false`, and the one that called it gives up in its turn.
// - A parser that reads at least one token needs an index that is in the line and gives one that is after it, which is also what makes the ones that call
//   themselves end (`shrinks size(ts) - pos`). Those that read a number of things (a list of types) may read none.
// - The MIR is a tree of enums, so a function that walks it calls itself on a part that is a Box, or on the elements of a list; those that go through lists are `~`
//   (no guarantee that they end), since only a part of a struct or an enum is known to be smaller. Every index is proved to be in range all the same.
// - The binary operations and the list operations are numbers, in the order of the tables `binaryWords` and `listWords`; they are words in the data.
//
// What it is made to read is the output of the writer: `tersus-mir 1`, the types, the functions and `main` (in that order), a record to a line, and a line
// not longer than `lineLimit` bytes. An end of the input, or an empty line, is the end of the file. The types, tokenizer and parsers are the shared
// reader of the mir package (`examples/mir/reader/reader.tersus`), imported below; this file keeps the writer and the program that runs.

import mir::reader::reader { Size, Type, Field, TypeDecl, Constant, Operand, RefStep, Rvalue, Statement, Terminator, MirBlock, LocalDecl, Function, Program, binaryWords, listWords, wordOf, quoted, programAt, readLines };


// Writing. A token is written with a space before it, and a record starts with its word without one. Every function gives the number of bytes it wrote.

fn hexDigit(d: Int) -> Byte [{ affirm d >= 0; affirm d <= 15; }] [{ }] {
    if d < 10 { return toByte(48 + d); };
    return toByte(55 + d);
};

fn printInt(n: Int) -> Int [{ }] [{ }] {
    return " ".print() + String::fromInt(n).print();
};

fn printWord(w: &String) -> Int [{ }] [{ }] {
    return " ".print() + w.print();
};

// A name in quotes: the bytes that are printable ASCII as they are, and the others, `"` and `\` as `\xHH`
fn printName(name: &String) -> Int [{ }] [{ }] {
    n = " \"".print();
    for i in 0..size(name.bytes) {
        c = toInt(get(&name.bytes, i));
        if c >= 32 && c < 127 && c != 34 && c != 92 {
            writeByte(toByte(c));
            n = n + 1;
        } else {
            writeByte(toByte(92));
            writeByte(toByte(120));
            writeByte(hexDigit(c / 16));
            writeByte(hexDigit(c % 16));
            n = n + 4;
        };
    };
    writeByte(toByte(34));
    return n + 1;
};

fn printNames(names: &List<String>) -> Int [{ }] [{ }] {
    n = printInt(size(names));
    for name in &names {
        n = n + printName(name);
    };
    return n;
};

fn printInts(ints: &List<Int>) -> Int [{ }] [{ }] {
    n = printInt(size(ints));
    for v in &ints {
        n = n + printInt(v);
    };
    return n;
};

fn newLine() -> Int [{ }] [{ }] {
    writeByte(toByte(10));
    return 1;
};

fn printSize(s: &Size) -> Int [{ }] [{ }] {
    return match s {
        Size::SConst { n: n } => " c".print() + printInt(n),
        Size::SAny => " any".print(),
        Size::SParam { name: name } => " p".print() + printName(name),
        Size::SVar { n: n } => " v".print() + printInt(n),
    };
};

fn printType(t: &Type) -> Int ~ {
    n = 0;
    match t {
        Type::TInt => { n = " int".print(); },
        Type::TByte => { n = " byte".print(); },
        Type::TBool => { n = " bool".print(); },
        Type::TList { elem: e } => { n = " named \"List\" 1 type".print() + printType(Box::unbox(e)); },
        Type::TArray { elem: e, size: s } => { n = " array".print() + printType(Box::unbox(e)) + printSize(s); },
        Type::TBox { inner: e } => { n = " named \"Box\" 1 type".print() + printType(Box::unbox(e)); },
        Type::TFn { args: args, ret: r } => {
            n = " fn".print() + printInt(size(args));
            i = 0;
            while i < size(args) [{ affirm i >= 0; affirm i <= size(args); }] ~ {
                n = n + printType(get(args, i));
                i = i + 1;
            };
            n = n + printType(Box::unbox(r));
        },
        Type::TNamed { name: name, base: base, argc: argc, argTokens: argTokens } => {
            n = " named".print() + printName(base) + printInt(argc);
            for tok in argTokens {
                if tok.quoted {
                    n = n + printName(&tok.text);
                } else {
                    n = n + printWord(&tok.text);
                };
            };
        },
        Type::TVariant { name: name } => { n = " variant".print() + printName(name); },
        Type::TVar { n: v } => { n = " var".print() + printInt(v); },
        Type::TForall { sizes: sizes, types: types, body: body } => {
            n = " forall".print() + printNames(sizes) + printNames(types) + printType(Box::unbox(body));
        },
        Type::TParam { name: name } => { n = " param".print() + printName(name); },
        Type::TRef { inner: e } => { n = " ref".print() + printType(Box::unbox(e)); },
        Type::TMutRef { inner: e } => { n = " mutref".print() + printType(Box::unbox(e)); },
        Type::TAddr { inner: e } => { n = " addr".print() + printType(Box::unbox(e)); },
        Type::TBlock { inner: e } => { n = " block".print() + printType(Box::unbox(e)); },
        Type::TUninit { inner: e } => { n = " uninit".print() + printType(Box::unbox(e)); },
        Type::TWord { signed: signed, bits: bits } => {
            w = " u32";
            if signed && bits = 8 { w = " i8"; };
            if signed && bits = 16 { w = " i16"; };
            if signed && bits = 32 { w = " i32"; };
            if !signed && bits = 16 { w = " u16"; };
            n = w.print();
        },
    };
    return n;
};

fn printConstant(c: &Constant) -> Int ~ {
    n = 0;
    match c {
        Constant::CInt { n: v } => { n = " int".print() + printInt(v); },
        Constant::CBool { b: b } => {
            if b { n = " bool true".print(); } else { n = " bool false".print(); };
        },
        Constant::CList { items: items } => {
            n = " list".print() + printInt(size(items));
            i = 0;
            while i < size(items) [{ affirm i >= 0; affirm i <= size(items); }] ~ {
                n = n + printConstant(get(items, i));
                i = i + 1;
            };
        },
        Constant::CArray { items: items } => {
            n = " array".print() + printInt(size(items));
            i = 0;
            while i < size(items) [{ affirm i >= 0; affirm i <= size(items); }] ~ {
                n = n + printConstant(get(items, i));
                i = i + 1;
            };
        },
        Constant::CData { name: name, fields: fields, values: values } => {
            n = " data".print() + printName(name) + printInt(size(fields));
            i = 0;
            while i < size(fields) && i < size(values) [{ affirm i >= 0; affirm i <= size(fields); affirm i <= size(values); }] ~ {
                n = n + printName(get(fields, i)) + printConstant(get(values, i));
                i = i + 1;
            };
        },
        Constant::CFn { name: name } => { n = " fn".print() + printName(name); },
    };
    return n;
};

fn printOperand(o: &Operand) -> Int ~ {
    return match o {
        Operand::Copy { local: l } => " copy".print() + printInt(l),
        Operand::Move { local: l } => " move".print() + printInt(l),
        Operand::Const { value: c } => " const".print() + printConstant(c),
    };
};

fn printOperands(os: &List<Operand>) -> Int ~ {
    n = printInt(size(os));
    i = 0;
    while i < size(os) [{ affirm i >= 0; affirm i <= size(os); }] ~ {
        n = n + printOperand(get(os, i));
        i = i + 1;
    };
    return n;
};

fn printRefStep(step: &RefStep) -> Int ~ {
    n = 0;
    match step {
        RefStep::Field { ctor: ctor, field: field } => { n = " field".print() + printName(ctor) + printName(field); },
        RefStep::Index { o: o } => { n = " index".print() + printOperand(o); },
    };
    return n;
};

fn printRvalue(rv: &Rvalue) -> Int ~ {
    n = 0;
    match rv {
        Rvalue::Use { o: o } => { n = " use".print() + printOperand(o); },
        Rvalue::BinaryOp { op: op, a: a, b: b } => {
            n = " binary".print() + printWord(wordOf(binaryWords(), op)) + printOperand(a) + printOperand(b);
        },
        Rvalue::ListOp { op: op, args: args } => {
            n = " listop".print() + printWord(wordOf(listWords(), op)) + printOperands(args);
        },
        Rvalue::MakeList { items: items } => { n = " makelist".print() + printOperands(items); },
        Rvalue::MakeBox { o: o } => { n = " makebox".print() + printOperand(o); },
        Rvalue::Unbox { o: o } => { n = " unbox".print() + printOperand(o); },
        Rvalue::Unsize { o: o } => { n = " unsize".print() + printOperand(o); },
        Rvalue::MakeData { name: name, fields: fields, values: values } => {
            n = " makedata".print() + printName(name) + printInt(size(fields));
            i = 0;
            while i < size(fields) && i < size(values) [{ affirm i >= 0; affirm i <= size(fields); affirm i <= size(values); }] ~ {
                n = n + printName(get(fields, i)) + printOperand(get(values, i));
                i = i + 1;
            };
        },
        Rvalue::ReadField { o: o, name: name, field: field } => {
            n = " readfield".print() + printOperand(o) + printName(name) + printName(field);
        },
        Rvalue::IsVariant { o: o, name: name } => { n = " isvariant".print() + printOperand(o) + printName(name); },
        Rvalue::AsVariant { o: o, name: name } => { n = " asvariant".print() + printOperand(o) + printName(name); },
        Rvalue::Copy { o: o } => { n = " clone".print() + printOperand(o); },
        Rvalue::TakeField { local: l, name: name, field: field } => {
            n = " takefield".print() + printInt(l) + printName(name) + printName(field);
        },
        Rvalue::Borrow { root: root, steps: steps, mutable: mutable } => {
            kw = " borrow";
            if mutable { kw = " borrowmut"; };
            n = kw.print() + printInt(root) + printInt(size(steps));
            i = 0;
            while i < size(steps) [{ affirm i >= 0; affirm i <= size(steps); }] ~ {
                n = n + printRefStep(get(steps, i));
                i = i + 1;
            };
        },
        Rvalue::Deref { o: o } => { n = " deref".print() + printOperand(o); },
    };
    return n;
};

fn printStatement(st: &Statement) -> Int ~ {
    n = 0;
    match st {
        Statement::Assign { local: l, rv: rv } => { n = "assign".print() + printInt(l) + printRvalue(rv); },
        Statement::Peek { local: l, rv: rv } => { n = "peek".print() + printInt(l) + printRvalue(rv); },
        Statement::Drop { local: l } => { n = "drop".print() + printInt(l); },
        Statement::Ghost => { n = "ghost".print(); },
        Statement::Dissolve { local: l } => { n = "dissolve".print() + printInt(l); },
        Statement::AssignRef { local: l, steps: steps, rv: rv } => {
            n = "assignref".print() + printInt(l) + printInt(size(steps));
            i = 0;
            while i < size(steps) [{ affirm i >= 0; affirm i <= size(steps); }] ~ {
                n = n + printRefStep(get(steps, i));
                i = i + 1;
            };
            n = n + printRvalue(rv);
        },
    };
    return n + newLine();
};

fn printTerminator(t: &Terminator) -> Int ~ {
    n = 0;
    match t {
        Terminator::Goto { block: b } => { n = "goto".print() + printInt(b); },
        Terminator::Switch { cond: c, yes: yes, no: no } => { n = "switch".print() + printOperand(c) + printInt(yes) + printInt(no); },
        Terminator::Call { callee: callee, args: args, dest: dest, next: after } => {
            n = "call".print() + printOperand(callee) + printOperands(args) + printInt(dest) + printInt(after);
        },
        Terminator::Return => { n = "return".print(); },
        Terminator::Unreachable => { n = "unreachable".print(); },
    };
    return n + newLine();
};

fn printBlock(b: &MirBlock) -> Int ~ {
    n = "block".print() + printInt(b.id) + newLine();
    i = 0;
    while i < size(b.stmts) [{ affirm i >= 0; affirm i <= size(b.stmts); }] ~ {
        n = n + printStatement(get(b.stmts, i));
        i = i + 1;
    };
    return n + printTerminator(b.term);
};

fn printLocal(d: &LocalDecl) -> Int ~ {
    n = "local".print() + printInt(d.id);
    if d.named { n = n + " some".print() + printName(d.name); } else { n = n + " none".print(); };
    return n + printType(d.ty) + newLine();
};

fn printFunction(kind: &String, f: &Function) -> Int ~ {
    n = kind.print() + printName(f.name) + " params".print() + printInts(f.params) + " returns".print();
    if f.hasReturn { n = n + " some".print() + printType(f.returns); } else { n = n + " none".print(); };
    n = n + " sizeparams".print() + printNames(f.sizeParams) + " typeparams".print() + printNames(f.typeParams) + " borrowed".print() + printInts(f.borrowed);
    if size(f.mutBorrowed) + size(f.from) > 0 { n = n + " mutborrowed".print() + printInts(f.mutBorrowed) + " from".print() + printInts(f.from); };
    n = n + newLine();
    i = 0;
    while i < size(f.locals) [{ affirm i >= 0; affirm i <= size(f.locals); }] ~ {
        n = n + printLocal(get(f.locals, i));
        i = i + 1;
    };
    j = 0;
    while j < size(f.blocks) [{ affirm j >= 0; affirm j <= size(f.blocks); }] ~ {
        n = n + printBlock(get(f.blocks, j));
        j = j + 1;
    };
    return n + "end".print() + newLine();
};

fn printFields(fields: &List<Field>) -> Int ~ {
    n = printInt(size(fields));
    for f in fields {
        n = n + printName(f.name) + printType(f.ty);
    };
    return n;
};

fn printDecl(d: &TypeDecl) -> Int ~ {
    n = 0;
    match d {
        TypeDecl::DStruct { name: name, fields: fields } => { n = "struct".print() + printName(name) + printFields(fields); },
        TypeDecl::DEnum { name: name, variants: variants } => {
            n = "enum".print() + printName(name) + printInt(size(variants));
            for v in variants {
                n = n + printName(v.name) + printFields(v.fields);
            };
        },
    };
    return n + newLine();
};

fn printProgram(p: &Program) -> Int ~ {
    n = "tersus-mir 1".print() + newLine();
    for d in p.types {
        n = n + printDecl(d);
    };
    for f in p.functions {
        n = n + printFunction("function", f);
    };
    return n + printFunction("main", p.entry);
};

// The program is read from the standard input and written again. What cannot be read is reported on the standard error.
read = readLines();
if !read.ok {
    "the input is not the MIR as data: a bad name\n".printError();
    return 1;
};
program = programAt(read.value);
if !program.ok {
    "the input is not the MIR as data\n".printError();
    return 1;
};
printProgram(program.value);
