import data::codec::codec { Parsed, Token };
import mir::reader::reader { Program, programAt, readLines };
import mir::writer::writer { printProgram };

read = readLines();
if !read.ok {
    "the input is not the MIR as data: a bad name\n".printError();
    return 1;
};
program = programAt(read.value);
if !program.ok {
    "the input is not the MIR as data\n".printError();
    return 1;
};
printProgram(program.value);
