import mir::emit::types { closeTypes, contextOf, dropSymbol, functionNames, functionSymbol, isExtern, isNumberWord, llvmType, needsDrop, noTypes, printSymbol, resultStruct, slotsOf };
import mir::emit::values { Gen };
import mir::emit::functions { emitBody, emitFunction, externDeclaration, failedFn };
import mir::emit::helpers { cloneFunctions, dropFunctions, printFunctions };
import mir::support::support { noStrings, showInt, renderType, isAggregate };
import data::codec::codec { Type };
import mir::reader::reader { TypeDecl, Function, Program, programAt, readLines };
import mir::ownership::ownership { isOwnershipRequest, runOwnership };

// The lowering from the MIR to LLVM IR, written in Tersus (step 31 of the roadmap, see STEP31.md): the compiler's only emitter. It was written function by function
// oracle. It reads the MIR as data from the standard input (what `tersus mir --data` prints) and writes the LLVM IR.
//
//     tersus mir --data examples/hello.tersus | tersus run examples/mir/emit/emit.tersus
//
// With no argument it writes all of the IR of the program (TestMirEmit runs every mode of it on every example and every
// program of the native tests, and TestNative builds and runs the IR). The argument `outline` writes the declarations, the made functions of the types of the locals and the entry point,
// and `bodies` the code of each function: the parts it was written in.
//
// The reader of the MIR as data (its types, tokenizer and parsers) is the shared reader of the mir package
// (`examples/mir/reader/reader.tersus`), imported above. The lowering helpers are the declaration-only sibling files
// types, values, operations, functions and helpers; this file keeps program assembly and the executable entry.
// Output follows the same ordering and naming as the Haskell emitter it replaced:
// - There are no maps: the types of the program are a list in the order of the Haskell map, and a lookup is a scan of it.
// - There is no state monad: a function gives its lines (a `List<String>`) and, where the Haskell also gives the types the code needs, those.
// - A function that goes through the types of the program calls itself on parts that are not smaller as a value (a struct holds another by name), so these are `~`.
// - An error is a result with `ok: false` and the message that the Haskell gives (`Native code does not support ... yet`).


// The declarations of the runtime and of the intrinsics
fn declarations() -> List<String> [{ }] [{ }] {
    out = noStrings();
    out = push(out, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)");
    out = push(out, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)");
    out = push(out, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)");
    out = push(out, "declare void @tersus_overflow() noreturn");
    out = push(out, "declare i64 @tersus_writeByte(i64)");
    out = push(out, "declare i64 @tersus_writeError(i64)");
    out = push(out, "declare i64 @tersus_readByte()");
    out = push(out, "declare void @tersus_init(i32, ptr)");
    out = push(out, "declare i64 @tersus_argCount()");
    out = push(out, "declare i64 @tersus_argByte(i64, i64)");
    out = push(out, "declare i64 @tersus_pathByte(i64)");
    out = push(out, "declare i64 @tersus_fileLoad()");
    out = push(out, "declare i64 @tersus_fileByte(i64)");
    out = push(out, "declare i64 @tersus_storeByte(i64)");
    out = push(out, "declare i64 @tersus_fileStore()");
    out = push(out, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)");
    out = push(out, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)");
    out = push(out, "declare ptr @tersus_box_new(i64)");
    out = push(out, "declare void @tersus_box_free(ptr)");
    out = push(out, "declare i64 @tersus_addr_alloc(i64, i64)");
    out = push(out, "declare i64 @tersus_addr_resize(i64, i64, i64)");
    out = push(out, "declare void @tersus_addr_free(i64)");
    out = push(out, "");
    return out;
};

// The C-level main: runs the program and prints its return value, if it returned one
struct Entry { ok: Bool, error: String, lines: List<String>, types: List<Type> };

impl Clone for Entry { };

fn failedEntry(message: &String) -> Entry [{ }] [{ }] {
    return Entry { ok: false, error: clone(message), lines: noStrings(), types: noTypes() };
};

// The lines of the body of `main`, with the indentation (a label has none)
fn wrapMain(body: &List<String>) -> List<String> [{ }] [{ }] {
    out = noStrings();
    out = push(out, "define i32 @main(i32 %argc, ptr %argv) {");
    out = push(out, "    call void @tersus_init(i32 %argc, ptr %argv)");
    for l in body {
        if size(l.bytes) > 0 && get(l.bytes, size(l.bytes) - 1) = toByte(58) {
            out = push(out, clone(l));
        } else {
            out = push(out, "    ".then(l));
        };
    };
    out = push(out, "}");
    return out;
};

fn entryPoint(types: &List<TypeDecl>, fns: &List<String>, main: &Function) -> Entry ~ {
    if !main.hasReturn {
        body = noStrings();
        body = push(body, "call void @tersus_main()");
        body = push(body, "ret i32 0");
        return Entry { ok: true, error: "", lines: wrapMain(body), types: noTypes() };
    };
    ty = main.returns;
    roots = noTypes();
    roots = push(roots, clone(ty));
    body = noStrings();
    // a value held inline (an array, a struct, an enum) is made in a frame, so the program is given room for it, and prints it (and frees what it owns) from there
    if isAggregate(ty) {
        body = push(body, "%out = alloca [".then(showInt(slotsOf(types, ty))).then(" x i64]"));
        body = push(body, "%ok = call i1 @tersus_main(ptr %out)");
        body = push(body, "br i1 %ok, label %print, label %done");
        body = push(body, "print:");
        body = push(body, "%w = ptrtoint ptr %out to i64");
        body = push(body, "call void ".then(printSymbol(types, ty)).then("(i64 %w)"));
        body = push(body, "%nl = call i64 @tersus_writeByte(i64 10)");
        if needsDrop(types, fns, ty) {
            body = push(body, "call void ".then(dropSymbol(types, ty)).then("(ptr %out)"));
        };
        body = push(body, "br label %done");
        body = push(body, "done:");
        body = push(body, "ret i32 0");
        return Entry { ok: true, error: "", lines: wrapMain(body), types: roots };
    };
    t = llvmType(ty);
    if !t.ok { return failedEntry(t.text); };
    result = resultStruct(t.text);
    word = "%v";
    convert = noStrings();
    if ty is Type::TBool {
        convert = push(convert, "%w = zext i1 %v to i64");
        word = "%w";
    };
    if !(isNumberWord(ty) || ty is Type::TBool) {
        convert = push(convert, "%w = ptrtoint ptr %v to i64");
        word = "%w";
    };
    body = push(body, "%r = call ".then(result).then(" @tersus_main()"));
    body = push(body, "%ok = extractvalue ".then(result).then(" %r, 1"));
    body = push(body, "br i1 %ok, label %print, label %done");
    body = push(body, "print:");
    body = push(body, "%v = extractvalue ".then(result).then(" %r, 0"));
    for c in convert { body = push(body, clone(c)); };
    body = push(body, "call void ".then(printSymbol(types, ty)).then("(i64 ").then(word).then(")"));
    body = push(body, "%nl = call i64 @tersus_writeByte(i64 10)");
    body = push(body, "br label %done");
    body = push(body, "done:");
    body = push(body, "ret i32 0");
    return Entry { ok: true, error: "", lines: wrapMain(body), types: roots };
};

fn printLines(lines: &List<String>) -> Int [{ }] [{ }] {
    n = 0;
    for l in lines {
        n = n + l.print();
        writeByte(toByte(10));
        n = n + 1;
    };
    return n;
};

// What the code of a function gives, as lines: the globals the code needs, the rooms for the values it builds, the code, and the types it makes a function for (the
// newest first)
fn bodyLines(index: Int, g: &Gen) -> List<String> ~ {
    out = noStrings();
    out = push(out, "; function ".then(showInt(index)));
    out = push(out, "; globals");
    for l in g.globals { out = push(out, clone(l)); };
    out = push(out, "; temps");
    for l in g.temps { out = push(out, clone(l)); };
    out = push(out, "; code");
    for l in g.lines { out = push(out, clone(l)); };
    out = push(out, "; types");
    i = size(g.types);
    while i > 0 [{ affirm i >= 0; affirm i <= size(g.types); }] shrinks i {
        i = i - 1;
        out = push(out, renderType(get(g.types, i)));
    };
    return out;
};

// The code of every function, each with a line that says which it is (the functions in order, then main); a function the emitter cannot make is marked
fn bodies(program: &Program) -> List<String> ~ {
    cx = contextOf(program);
    out = noStrings();
    index = 0;
    for f in program.functions {
        g = emitBody(cx, false, f);
        if size(g.error.bytes) > 0 {
            out = push(out, "; function ".then(showInt(index)));
            out = push(out, "; unsupported");
        } else {
            for l in bodyLines(index, g) { out = push(out, clone(l)); };
        };
        index = index + 1;
    };
    g = emitBody(cx, true, program.entry);
    if size(g.error.bytes) > 0 {
        out = push(out, "; function ".then(showInt(index)));
        out = push(out, "; unsupported");
    } else {
        for l in bodyLines(index, g) { out = push(out, clone(l)); };
    };
    return out;
};

// The whole IR of the program: the declarations, the functions in order,
// main, and the entry point
fn ir(program: &Program) -> Entry ~ {
    cx = contextOf(program);
    pieces = [];
    roots = noTypes();
    for f in program.functions {
        r = failedFn("");
        if isExtern(f.name) { r = externDeclaration(f); } else { r = emitFunction(cx, false, functionSymbol(f.name), f); };
        if !r.ok { return failedEntry(r.error); };
        pieces = push(pieces, r.lines);
        for t in r.types { roots = push(roots, clone(t)); };
    };
    m = emitFunction(cx, true, "@tersus_main", program.entry);
    if !m.ok { return failedEntry(m.error); };
    for t in m.types { roots = push(roots, clone(t)); };
    e = entryPoint(program.types, functionNames(program), program.entry);
    if !e.ok { return e; };
    for t in e.types { roots = push(roots, clone(t)); };
    closed = closeTypes(program.types, roots);
    lines = declarations();
    for b in pieces {
        for l in b { lines = push(lines, clone(l)); };
        lines = push(lines, "");
    };
    for l in m.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    for l in dropFunctions(program.types, functionNames(program), closed) { lines = push(lines, clone(l)); };
    for l in cloneFunctions(cx, closed) { lines = push(lines, clone(l)); };
    for l in printFunctions(program.types, closed) { lines = push(lines, clone(l)); };
    for l in e.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    return Entry { ok: true, error: "", lines: lines, types: closed };
};

// The IR so far: the declarations, the made functions of the types of the locals and what they contain, and the entry point
fn outline(program: &Program) -> Entry ~ {
    entry = entryPoint(program.types, functionNames(program), program.entry);
    if !entry.ok { return entry; };
    roots = noTypes();
    for f in program.functions {
        for d in f.locals { roots = push(roots, clone(d.ty)); };
    };
    for d in program.entry.locals { roots = push(roots, clone(d.ty)); };
    for t in entry.types { roots = push(roots, clone(t)); };
    closed = closeTypes(program.types, roots);
    cx = contextOf(program);
    lines = declarations();
    for l in dropFunctions(program.types, functionNames(program), closed) { lines = push(lines, clone(l)); };
    for l in cloneFunctions(cx, closed) { lines = push(lines, clone(l)); };
    for l in printFunctions(program.types, closed) { lines = push(lines, clone(l)); };
    for l in entry.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    return Entry { ok: true, error: "", lines: lines, types: closed };
};

// The program is read from the standard input and its IR is written. The first argument says what: `ir` (or none) is all of it, `outline` the
// declarations, the made functions and the entry point, and `bodies` the code of each function. What cannot be read or made is
// reported on the standard error. An input whose first line is `pass ownership` or `pass expand` asks for that ownership pass
// instead (examples/mir/ownership), so that the seed of the emitter also has them.
mode = String::arg(0, 100);
read = readLines();
if !read.ok {
    "the input is not the MIR as data: a bad name\n".printError();
    return 1;
};
if isOwnershipRequest(read.value) {
    if !runOwnership(read.value) { return 1; };
} else {
    program = programAt(read.value);
    if !program.ok {
        "the input is not the MIR as data\n".printError();
        return 1;
    };
    if mode = "bodies" {
        printLines(bodies(program.value));
    } else {
        if mode = "outline" || mode = "ir" || mode = "" {
            result = failedEntry("");
            if mode = "outline" { result = outline(program.value); } else { result = ir(program.value); };
            if !result.ok {
                result.error.printError();
                "\n".printError();
                return 1;
            };
            printLines(result.lines);
        } else {
            "the first argument is ir, outline or bodies\n".printError();
            return 1;
        };
    };
};
