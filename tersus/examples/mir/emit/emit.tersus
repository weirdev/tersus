import data::codec::codec { Size, Type, done, quoted, parseInt };

// The lowering from the MIR to LLVM IR, written in Tersus (step 31 of the roadmap, see STEP31.md): the compiler's only emitter. It was written function by function
// oracle. It reads the MIR as data from the standard input (what `tersus mir --data` prints) and writes the LLVM IR.
//
//     tersus mir --data examples/hello.tersus | tersus run examples/mir/emit/emit.tersus
//
// With no argument it writes all of the IR of the program (TestMirEmit runs every mode of it on every example and every
// program of the native tests, and TestNative builds and runs the IR). The argument `outline` writes the declarations, the made functions of the types of the locals and the entry point,
// and `bodies` the code of each function: the parts it was written in.
//
// The reader of the MIR as data (its types, tokenizer and parsers) is the shared reader of the mir package
// (`examples/mir/reader/reader.tersus`), imported below. The rest is written as the Haskell is, in the same order and with the same names, so that the two can be read side
// by side:
// - There are no maps: the types of the program are a list in the order of the Haskell map, and a lookup is a scan of it.
// - There is no state monad: a function gives its lines (a `List<String>`) and, where the Haskell also gives the types the code needs, those.
// - A function that goes through the types of the program calls itself on parts that are not smaller as a value (a struct holds another by name), so these are `~`.
// - An error is a result with `ok: false` and the message that the Haskell gives (`Native code does not support ... yet`).

import mir::reader::reader { Field, Variant, TypeDecl, Constant, Operand, RefStep, Rvalue, Statement, Terminator, MirBlock, Function, Program, noOperand, programAt, readLines };


// ---- the emitter ----

// Strings

// `a.then(b)` is `a.concat(b)` that says nothing of its result. The text is put together from many pieces here (a line of the IR is ten of them), and what `concat` promises
// of the size and the bytes of each is a set of facts that the proof of every later statement of the function has to carry: the time to validate a function with a few
// of these chains was most of the time to validate the program.
impl String {
    fn then(self: Self, other: &String) -> Self [{ }] [{ }] {
        return self.concat(other);
    };
};

struct Res { ok: Bool, text: String };

impl Clone for Res { };

fn noTypes() -> List<Type> [{ }] [{ }] {
    return [];
};

fn noConstants() -> List<Constant> [{ }] [{ }] {
    return [];
};

fn noStrings() -> List<String> [{ }] [{ }] {
    return [];
};

fn showInt(n: Int) -> String [{ }] [{ }] {
    return String::fromInt(n);
};

// The strings of a list with a string between them
fn joinWith(sep: &String, parts: &List<String>) -> String [{ }] [{ }] {
    out = "";
    for i in 0..size(parts) {
        if i > 0 { out = out.then(sep); };
        out = out.then(get(parts, i));
    };
    return out;
};

// The text before the first `<` (a struct with sizes prints as the struct)
fn beforeAngle(name: &String) -> String [{ }] [{ }] {
    i = name.find(toByte(60), 0);
    return name.slice(0, i);
};

fn withoutBackticks(name: &String) -> String [{ }] [{ }] {
    out = "";
    for i in 0..size(name.bytes) {
        b = get(name.bytes, i);
        if b != toByte(96) { out = push(out, b); };
    };
    return out;
};

fn hexUpper(d: Int) -> Byte [{ affirm d >= 0; affirm d <= 15; }] [{ }] {
    if d < 10 { return toByte(48 + d); };
    return toByte(55 + d);
};

// A name as LLVM writes it in quotes and in a string: the bytes that are printable ASCII as they are and the others (and `"` and `\`) as `\hh`
fn escaped(name: &String) -> String [{ }] [{ }] {
    out = "";
    for i in 0..size(name.bytes) {
        c = toInt(get(name.bytes, i));
        if c >= 32 && c < 127 && c != 34 && c != 92 {
            out = push(out, toByte(c));
        } else {
            out = push(out, toByte(92));
            out = push(out, hexUpper(c / 16));
            out = push(out, hexUpper(c % 16));
        };
    };
    return out;
};

// The name of a global: quoted, so that any name will do
fn global(prefix: &String, name: &String) -> String [{ }] [{ }] {
    return "@\"".then(prefix).then(escaped(name)).then("\"");
};

// Types

fn renderSize(s: &Size) -> String [{ }] [{ }] {
    return match s {
        Size::SConst { n: n } => showInt(n),
        Size::SAny => "?",
        Size::SParam { name: name } => clone(name),
        Size::SVar { n: n } => "_".then(showInt(n)),
    };
};

// A type in Tersus syntax (Pretty.renderType)
fn renderType(t: &Type) -> String ~ {
    r = "";
    match t {
        Type::TInt => { r = "Int"; },
        Type::TByte => { r = "Byte"; },
        Type::TBool => { r = "Bool"; },
        Type::TList { elem: e } => { r = "List<".then(renderType(Box::unbox(e))).then(">"); },
        Type::TBox { inner: e } => { r = "Box<".then(renderType(Box::unbox(e))).then(">"); },
        Type::TArray { elem: e, size: s } => { r = "Array<".then(renderType(Box::unbox(e))).then(", ").then(renderSize(s)).then(">"); },
        Type::TRef { inner: e } => { r = "&".then(renderType(Box::unbox(e))); },
        Type::TMutRef { inner: e } => { r = "&mut ".then(renderType(Box::unbox(e))); },
        Type::TAddr { inner: e } => { r = "Addr<".then(renderType(Box::unbox(e))).then(">"); },
        Type::TBlock { inner: e } => { r = "Block<".then(renderType(Box::unbox(e))).then(">"); },
        Type::TUninit { inner: e } => { r = "Uninit<".then(renderType(Box::unbox(e))).then(">"); },
        Type::TWord { signed: signed, bits: bits } => {
            if signed { r = "I".then(showInt(bits)); } else { r = "U".then(showInt(bits)); };
        },
        Type::TParam { name: name } => { r = clone(name); },
        Type::TForall { sizes: sizes, types: types, body: body } => {
            names = noStrings();
            for tn in types { names = push(names, clone(tn)); };
            for sn in sizes { names = push(names, clone(sn)); };
            r = "<".then(joinWith(", ", names)).then(">").then(renderType(Box::unbox(body)));
        },
        Type::TFn { args: args, ret: ret } => {
            parts = noStrings();
            for a in args { parts = push(parts, renderType(a)); };
            r = "fn(".then(joinWith(", ", parts)).then(") -> ").then(renderType(Box::unbox(ret)));
        },
        Type::TNamed { name: name } => { r = withoutBackticks(name); },
        Type::TVariant { name: name } => { r = clone(name); },
        Type::TVar { n: n } => { r = "?"; },
    };
    return r;
};

fn declName(d: &TypeDecl) -> String [{ }] [{ }] {
    if d is TypeDecl::DStruct { return clone((d as TypeDecl::DStruct).name); };
    return clone((d as TypeDecl::DEnum).name);
};

// The index of the declaration of a struct or an enum in the types of the program, or -1
fn lookupDecl(types: &List<TypeDecl>, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(types); }] {
    i = 0;
    while i < size(types) [{ affirm i >= 0; affirm i <= size(types); }] shrinks size(types) - i {
        d = &get(types, i);
        if declName(d) = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

fn variantNamed(variants: &List<Variant>, name: &String) -> Bool [{ }] [{ }] {
    for v in variants {
        if v.name = name { return true; };
    };
    return false;
};

// The enum that has the variant (a struct is its own constructor, and a cast to it has the type of a variant of it): Mir.ownerOf
fn ownerOf(types: &List<TypeDecl>, v: &String) -> Res [{ }] [{ }] {
    i = lookupDecl(types, v);
    if i >= 0 {
        d = get(types, i);
        if d is TypeDecl::DStruct { return Res { ok: true, text: clone(v) }; };
    };
    for d in types {
        match d {
            TypeDecl::DStruct { name: name, fields: fields } => { },
            TypeDecl::DEnum { name: name, variants: variants } => {
                if variantNamed(variants, v) { return Res { ok: true, text: clone(name) }; };
            },
        };
    };
    return Res { ok: false, text: "" };
};

// A value of a variant has the representation of its enum, so the made functions of one serve both
fn canonical(types: &List<TypeDecl>, t: &Type) -> Type [{ }] [{ }] {
    if t is Type::TVariant {
        o = ownerOf(types, (t as Type::TVariant).name);
        if o.ok { return Type::TNamed { name: clone(o.text), base: o.text, argc: 0, argTokens: [] }; };
    };
    return clone(t);
};

// The variants of a struct or an enum: a struct is one variant, named as it is
fn variantsOf(types: &List<TypeDecl>, n: &String) -> List<Variant> [{ }] [{ }] {
    out = [];
    i = lookupDecl(types, n);
    if i >= 0 {
        d = get(types, i);
        match d {
            TypeDecl::DStruct { name: name, fields: fields } => { out = push(out, Variant { name: clone(name), fields: clone(fields) }); },
            TypeDecl::DEnum { name: name, variants: variants } => { out = clone(variants); },
        };
    };
    return out;
};

fn isEnum(types: &List<TypeDecl>, n: &String) -> Bool [{ }] [{ }] {
    i = lookupDecl(types, n);
    if i >= 0 {
        d = get(types, i);
        return d is TypeDecl::DEnum;
    };
    return false;
};

// What a type is when it is an array: whether it is one of the kind asked for, its length when it has one, and the type of its elements. (The cast of an enum is
// proved by the test just before it, so the tests are made where the cast is.)
struct ArrayInfo { ok: Bool, length: Int, elem: Type };

impl Clone for ArrayInfo { };

fn notArray() -> ArrayInfo [{ }] [{ }] {
    return ArrayInfo { ok: false, length: 0, elem: Type::TInt };
};

// An array of a size that is a constant (the TArray of Haskell)
fn sizedArray(t: &Type) -> ArrayInfo [{ }] [{ }] {
    if t is Type::TArray {
        s = (t as Type::TArray).size;
        if s is Size::SConst {
            return ArrayInfo { ok: true, length: (s as Size::SConst).n, elem: clone(Box::unbox((t as Type::TArray).elem)) };
        };
    };
    return notArray();
};

// An array of no size
fn unsizedArray(t: &Type) -> ArrayInfo [{ }] [{ }] {
    if t is Type::TArray {
        s = (t as Type::TArray).size;
        if s is Size::SAny {
            return ArrayInfo { ok: true, length: 0, elem: clone(Box::unbox((t as Type::TArray).elem)) };
        };
    };
    return notArray();
};

// A type, if there is one (what a list of native code holds)
struct Held { ok: Bool, ty: Type };

impl Clone for Held { };

fn isSizedArray(t: &Type) -> Bool [{ }] [{ }] {
    return sizedArray(t).ok;
};

fn isAggregate(t: &Type) -> Bool [{ }] [{ }] {
    return isSizedArray(t) || t is Type::TNamed || t is Type::TVariant;
};

// The struct or enum that a type is a value of: a struct or an enum itself, or a variant (whose enum is looked up)
fn declaredName(types: &List<TypeDecl>, t: &Type) -> Res [{ }] [{ }] {
    if t is Type::TNamed { return Res { ok: true, text: clone((t as Type::TNamed).name) }; };
    if t is Type::TVariant { return ownerOf(types, (t as Type::TVariant).name); };
    return Res { ok: false, text: "" };
};

// The layout of a value held inline (Mir.layoutOf, C's rules): its bytes and its alignment. An Int, an address, a function and a Box are 8 bytes, a Box of an
// array of no size 16, a Byte and a Bool 1, a fixed-width integer its bits over 8; an array is its elements, a struct its fields each at a multiple of its
// alignment (and the size rounded up to the largest), and an enum a U32 tag and then the fields of its variant from the first offset every variant can start at.
struct Layout { size: Int, align: Int };

impl Clone for Layout { };

fn roundUp(n: Int, a: Int) -> Int [{ }] [{ }] {
    if a <= 1 { return n; };
    return (n + a - 1) / a * a;
};

fn wordLayout() -> Layout [{ }] [{ }] {
    return Layout { size: 8, align: 8 };
};

// The layout of a type that is not a struct or an enum, or of no type when it is one
struct Simple { ok: Bool, layout: Layout };

impl Clone for Simple { };

fn simpleLayout(t: &Type) -> Simple [{ }] [{ }] {
    if t is Type::TByte || t is Type::TBool { return Simple { ok: true, layout: Layout { size: 1, align: 1 } }; };
    if t is Type::TWord {
        b = (t as Type::TWord).bits / 8;
        return Simple { ok: true, layout: Layout { size: b, align: b } };
    };
    return Simple { ok: false, layout: wordLayout() };
};

fn layoutOf(types: &List<TypeDecl>, t: &Type) -> Layout ~ {
    if t is Type::TBlock { return Layout { size: 0, align: 1 }; };
    if t is Type::TUninit { return layoutOf(types, Box::unbox((t as Type::TUninit).inner)); };
    simple = simpleLayout(t);
    if simple.ok { return clone(simple.layout); };
    arr = sizedArray(t);
    if arr.ok {
        e = layoutOf(types, arr.elem);
        return Layout { size: arr.length * e.size, align: e.align };
    };
    n = declaredName(types, t);
    if !n.ok { return wordLayout(); };
    i = lookupDecl(types, n.text);
    if i < 0 { return wordLayout(); };
    r = wordLayout();
    d = &get(types, i);
    match *d {
        TypeDecl::DStruct { name: name, fields: fields } => {
            align = 1;
            end = 0;
            for f in fields {
                l = layoutOf(types, &f.ty);
                if l.align > align { align = l.align; };
                end = roundUp(end, l.align) + l.size;
            };
            r = Layout { size: roundUp(end, align), align: align };
        },
        TypeDecl::DEnum { name: name, variants: variants } => {
            payload = 1;
            widest = 0;
            for v in variants {
                align = 1;
                end = 0;
                for f in v.fields {
                    l = layoutOf(types, &f.ty);
                    if l.align > align { align = l.align; };
                    end = roundUp(end, l.align) + l.size;
                };
                if align > payload { payload = align; };
                if roundUp(end, align) > widest { widest = roundUp(end, align); };
            };
            start = roundUp(4, payload);
            align = payload;
            if align < 4 { align = 4; };
            r = Layout { size: roundUp(start + widest, align), align: align };
        },
    };
    return r;
};

// The layout of a struct of these fields
fn fieldsLayout(types: &List<TypeDecl>, fields: &List<Field>) -> Layout ~ {
    align = 1;
    end = 0;
    for f in fields {
        l = layoutOf(types, &f.ty);
        if l.align > align { align = l.align; };
        end = roundUp(end, l.align) + l.size;
    };
    return Layout { size: roundUp(end, align), align: align };
};

// The layout of a declared struct or enum
fn declLayout(types: &List<TypeDecl>, d: &TypeDecl) -> Layout ~ {
    return layoutOf(types, Type::TNamed { name: declName(d), base: declName(d), argc: 0, argTokens: [] });
};

// The 8-byte words of room a value held inline takes in a frame (Mir.slotsOf)
fn slotsOf(types: &List<TypeDecl>, t: &Type) -> Int ~ {
    return (layoutOf(types, t).size + 7) / 8;
};

// An extern function (`extern fn`, named `extern f` in the MIR) is the C function f
fn isExtern(name: &String) -> Bool [{ }] [{ }] {
    return name.startsWith("extern ");
};

// The symbol of a function of the program. Quoted, since a lifted function is named outer::inner. An extern function is the C function of its name.
fn functionSymbol(name: &String) -> String [{ }] [{ }] {
    if isExtern(name) && size(name.bytes) >= 7 { return "@\"".then(escaped(name.slice(7, size(name.bytes)))).then("\""); };
    return global("fn.", name);
};

fn containsName(names: &List<String>, n: &String) -> Bool [{ }] [{ }] {
    for s in names {
        if s = n { return true; };
    };
    return false;
};

// The name of the drop of a struct or an enum (Mir.dropFunction)
fn dropName(n: &String) -> String [{ }] [{ }] {
    return "<".then(n).then(" as Drop>::drop");
};

// Whether a value owns something to free: a Box, or an array, struct or enum that holds one or has a drop (MirOwnership.needsDrop). The names
// are those of the functions of the program, which have the drop of a type that has one.
fn needsDrop(types: &List<TypeDecl>, fns: &List<String>, t: &Type) -> Bool ~ {
    if t is Type::TBox { return true; };
    if t is Type::TArray { return needsDrop(types, fns, Box::unbox((t as Type::TArray).elem)); };
    n = declaredName(types, t);
    if !n.ok { return false; };
    // (the struct that a list is made of owns the memory at its address)
    if beforeAngle(n.text) = "List" { return true; };
    // (a struct or an enum with a drop has something to do when it is freed, whatever its fields are)
    if containsName(fns, dropName(n.text)) { return true; };
    i = lookupDecl(types, n.text);
    if i < 0 { return false; };
    d = get(types, i);
    r = false;
    match d {
        TypeDecl::DStruct { name: name, fields: fields } => {
            for f in fields {
                if needsDrop(types, fns, f.ty) { r = true; };
            };
        },
        TypeDecl::DEnum { name: name, variants: variants } => {
            for v in variants {
                for f in v.fields {
                    if needsDrop(types, fns, f.ty) { r = true; };
                };
            };
        },
    };
    return r;
};

// The symbol of the function that frees what a value of the type owns, made for the type below
fn dropSymbol(types: &List<TypeDecl>, t: &Type) -> String ~ {
    return global("drop.", renderType(canonical(types, t)));
};

// The symbol of the function that prints a value of the type, made for the type below
fn printSymbol(types: &List<TypeDecl>, t: &Type) -> String ~ {
    return global("print.", renderType(canonical(types, t)));
};

// The symbol of the function that copies a value of the type into room of its own, made for the type below: the copy
// that is made when the type has no `Clone` impl to call (a copy of a type that has one is that impl, called)
fn cloneSymbol(types: &List<TypeDecl>, t: &Type) -> String ~ {
    return global("clone.", renderType(canonical(types, t)));
};


// The symbol of the function that frees what each of a run of values of the type owns
fn dropRangeSymbol(types: &List<TypeDecl>, t: &Type) -> String ~ {
    return global("droprange.", renderType(canonical(types, t)));
};

// The lines that free the fields of one variant of a value at %slot, the fields from the byte `start`
fn dropFieldLines(types: &List<TypeDecl>, fns: &List<String>, variantIndex: Int, fields: &List<Field>, start: Int) -> List<String> ~ {
    out = noStrings();
    offset = 0;
    i = 0;
    for f in fields {
        l = layoutOf(types, f.ty);
        offset = roundUp(offset, l.align);
        if needsDrop(types, fns, f.ty) {
            reg = "%df".then(showInt(variantIndex)).then(".").then(showInt(i));
            out = push(out, "    ".then(reg).then(" = getelementptr i8, ptr %slot, i64 ").then(showInt(start + offset)));
            out = push(out, "    call void ".then(dropSymbol(types, f.ty)).then("(ptr ").then(reg).then(")"));
        };
        offset = offset + l.size;
        i = i + 1;
    };
    return out;
};

// The function that frees what a value of the type owns: the drop of the type first when it has one (not when the value
// was taken apart, which cleared its bytes), then what its fields or its elements own
fn dropFunctionLines(types: &List<TypeDecl>, fns: &List<String>, t: &Type) -> List<String> ~ {
    out = noStrings();
    out = push(out, "define internal void ".then(dropSymbol(types, t)).then("(ptr %slot) {"));
    out = push(out, "entry:");
    arr = sizedArray(t);
    if arr.ok {
        step = layoutOf(types, arr.elem).size;
        out = push(out, "    br label %ahead");
        out = push(out, "ahead:");
        out = push(out, "    %ai = phi i64 [0, %entry], [%anext, %abody]");
        out = push(out, "    %acond = icmp eq i64 %ai, ".then(showInt(arr.length)));
        out = push(out, "    br i1 %acond, label %done, label %abody");
        out = push(out, "abody:");
        out = push(out, "    %aoff = mul i64 %ai, ".then(showInt(step)));
        out = push(out, "    %ap = getelementptr i8, ptr %slot, i64 %aoff");
        out = push(out, "    call void ".then(dropSymbol(types, arr.elem)).then("(ptr %ap)"));
        out = push(out, "    %anext = add i64 %ai, 1");
        out = push(out, "    br label %ahead");
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok { return noStrings(); };
    variants = variantsOf(types, n.text);
    isEnumKind = isEnum(types, n.text);
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    start = 0;
    if isEnumKind { start = roundUp(4, payload); };
    if containsName(fns, dropName(n.text)) {
        size = layoutOf(types, t).size;
        out = push(out, "    br label %zhead");
        out = push(out, "zhead:");
        out = push(out, "    %zi = phi i64 [0, %entry], [%znext, %zbody]");
        out = push(out, "    %zcond = icmp eq i64 %zi, ".then(showInt(size)));
        out = push(out, "    br i1 %zcond, label %fields, label %zbody");
        out = push(out, "zbody:");
        out = push(out, "    %zp = getelementptr i8, ptr %slot, i64 %zi");
        out = push(out, "    %zb = load i8, ptr %zp");
        out = push(out, "    %znz = icmp ne i8 %zb, 0");
        out = push(out, "    %znext = add i64 %zi, 1");
        out = push(out, "    br i1 %znz, label %znonzero, label %zhead");
        out = push(out, "znonzero:");
        out = push(out, "    %dr = call i64 ".then(functionSymbol(dropName(n.text))).then("(ptr %slot)"));
        out = push(out, "    br label %fields");
        out = push(out, "fields:");
    };
    if isEnumKind {
        out = push(out, "    %tag = load i32, ptr %slot");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
        j = 0;
        for v in variants {
            out = push(out, "v".then(showInt(j)).then(":"));
            for l in dropFieldLines(types, fns, j, v.fields, start) { out = push(out, clone(l)); };
            out = push(out, "    br label %done");
            j = j + 1;
        };
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if size(variants) > 0 {
        for l in dropFieldLines(types, fns, 0, get(variants, 0).fields, start) { out = push(out, clone(l)); };
    };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// The function that frees what each of a run of values of the type owns (Addr::dropRange)
fn dropRangeFunctionLines(types: &List<TypeDecl>, fns: &List<String>, t: &Type) -> List<String> ~ {
    out = noStrings();
    step = layoutOf(types, t).size;
    out = push(out, "define internal void ".then(dropRangeSymbol(types, t)).then("(i64 %base, i64 %count) {"));
    out = push(out, "entry:");
    out = push(out, "    %basep = inttoptr i64 %base to ptr");
    out = push(out, "    br label %rhead");
    out = push(out, "rhead:");
    out = push(out, "    %ri = phi i64 [0, %entry], [%rnext, %rbody]");
    out = push(out, "    %rcond = icmp eq i64 %ri, %count");
    out = push(out, "    br i1 %rcond, label %done, label %rbody");
    out = push(out, "rbody:");
    out = push(out, "    %roff = mul i64 %ri, ".then(showInt(step)));
    out = push(out, "    %rp = getelementptr i8, ptr %basep, i64 %roff");
    out = push(out, "    call void ".then(dropSymbol(types, t)).then("(ptr %rp)"));
    out = push(out, "    %rnext = add i64 %ri, 1");
    out = push(out, "    br label %rhead");
    out = push(out, "done:");
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A drop function for every type that owns something to free, and the run function of each
fn dropFunctions(types: &List<TypeDecl>, fns: &List<String>, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        if needsDrop(types, fns, t) && (t is Type::TNamed || sizedArray(t).ok) {
            for l in dropFunctionLines(types, fns, t) { out = push(out, clone(l)); };
            for l in dropRangeFunctionLines(types, fns, t) { out = push(out, clone(l)); };
            out = push(out, "");
        };
    };
    return out;
};

// Whether a value is a word that is a number: an Int, a Byte or an address
fn isNumberWord(t: &Type) -> Bool [{ }] [{ }] {
    return t is Type::TInt || t is Type::TByte || t is Type::TAddr || t is Type::TWord;
};

// The LLVM type of a value that is a word, or why there is none
fn llvmType(t: &Type) -> Res ~ {
    unsupported = Res { ok: false, text: "Native code does not support ".then(renderType(t)).then(" yet") };
    if isNumberWord(t) { return Res { ok: true, text: "i64" }; };
    if t is Type::TBool { return Res { ok: true, text: "i1" }; };
    if t is Type::TRef || t is Type::TMutRef { return Res { ok: true, text: "ptr" }; };
    arr = sizedArray(t);
    if arr.ok {
        inner = llvmType(arr.elem);
        if !inner.ok { return inner; };
        return Res { ok: true, text: "ptr" };
    };
    if t is Type::TNamed || t is Type::TVariant || t is Type::TFn { return Res { ok: true, text: "ptr" }; };
    return unsupported;
};


// The types inside a type (a type that contains itself is there once)
fn parts(types: &List<TypeDecl>, t: &Type) -> List<Type> ~ {
    out = noTypes();
    if t is Type::TAddr {
        out = push(out, canonical(types, Box::unbox((t as Type::TAddr).inner)));
        return out;
    };
    arr = sizedArray(t);
    if arr.ok {
        out = push(out, canonical(types, arr.elem));
        return out;
    };
    if t is Type::TNamed {
        for v in variantsOf(types, (t as Type::TNamed).name) {
            for f in v.fields { out = push(out, canonical(types, f.ty)); };
        };
    };
    return out;
};

fn contains(seen: &List<Type>, t: &Type) -> Bool [{ }] [{ }] {
    i = 0;
    while i < size(seen) [{ affirm i >= 0; affirm i <= size(seen); }] shrinks size(seen) - i {
        s = &get(seen, i);
        if s = t { return true; };
        i = i + 1;
    };
    return false;
};

fn closeTypes(types: &List<TypeDecl>, roots: &List<Type>) -> List<Type> ~ {
    // Retain the first root occurrence so the depth-first output order stays unchanged.
    unique = noTypes();
    i = 0;
    while i < size(roots) [{ affirm i >= 0; affirm i <= size(roots); }] shrinks size(roots) - i {
        t = canonical(types, &get(roots, i));
        if !contains(unique, t) { unique = push(unique, t); };
        i = i + 1;
    };
    work = noTypes();
    i = size(unique);
    while i > 0 [{ affirm i >= 0; affirm i <= size(unique); }] shrinks i {
        i = i - 1;
        work = push(work, clone(get(unique, i)));
    };
    seen = noTypes();
    while size(work) > 0 [{ }] ~ {
        t = last(work);
        work = pop(work);
        if !contains(seen, t) {
            seen = push(seen, clone(t));
            ps = parts(types, t);
            j = size(ps);
            while j > 0 [{ affirm j >= 0; affirm j <= size(ps); }] shrinks j {
                j = j - 1;
                work = push(work, clone(get(ps, j)));
            };
        };
    };
    return seen;
};

// The names of the functions of the program
fn functionNames(program: &Program) -> List<String> ~ {
    names = noStrings();
    for f in program.functions { names = push(names, clone(f.name)); };
    return names;
};

// The declarations of the runtime and of the intrinsics
fn declarations() -> List<String> [{ }] [{ }] {
    out = noStrings();
    out = push(out, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)");
    out = push(out, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)");
    out = push(out, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)");
    out = push(out, "declare void @tersus_overflow() noreturn");
    out = push(out, "declare i64 @tersus_writeByte(i64)");
    out = push(out, "declare i64 @tersus_writeError(i64)");
    out = push(out, "declare i64 @tersus_readByte()");
    out = push(out, "declare void @tersus_init(i32, ptr)");
    out = push(out, "declare i64 @tersus_argCount()");
    out = push(out, "declare i64 @tersus_argByte(i64, i64)");
    out = push(out, "declare i64 @tersus_pathByte(i64)");
    out = push(out, "declare i64 @tersus_fileLoad()");
    out = push(out, "declare i64 @tersus_fileByte(i64)");
    out = push(out, "declare i64 @tersus_storeByte(i64)");
    out = push(out, "declare i64 @tersus_fileStore()");
    out = push(out, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)");
    out = push(out, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)");
    out = push(out, "declare ptr @tersus_box_new(i64)");
    out = push(out, "declare void @tersus_box_free(ptr)");
    out = push(out, "declare i64 @tersus_addr_alloc(i64, i64)");
    out = push(out, "declare i64 @tersus_addr_resize(i64, i64, i64)");
    out = push(out, "declare void @tersus_addr_free(i64)");
    out = push(out, "");
    return out;
};

// The C-level main: runs the program and prints its return value, if it returned one
struct Entry { ok: Bool, error: String, lines: List<String>, types: List<Type> };

impl Clone for Entry { };

fn failedEntry(message: &String) -> Entry [{ }] [{ }] {
    return Entry { ok: false, error: clone(message), lines: noStrings(), types: noTypes() };
};

// The lines of the body of `main`, with the indentation (a label has none)
fn wrapMain(body: &List<String>) -> List<String> [{ }] [{ }] {
    out = noStrings();
    out = push(out, "define i32 @main(i32 %argc, ptr %argv) {");
    out = push(out, "    call void @tersus_init(i32 %argc, ptr %argv)");
    for l in body {
        if size(l.bytes) > 0 && get(l.bytes, size(l.bytes) - 1) = toByte(58) {
            out = push(out, clone(l));
        } else {
            out = push(out, "    ".then(l));
        };
    };
    out = push(out, "}");
    return out;
};

fn resultStruct(t: &String) -> String [{ }] [{ }] {
    return "{ ".then(t).then(", i1 }");
};

fn entryPoint(types: &List<TypeDecl>, fns: &List<String>, main: &Function) -> Entry ~ {
    if !main.hasReturn {
        body = noStrings();
        body = push(body, "call void @tersus_main()");
        body = push(body, "ret i32 0");
        return Entry { ok: true, error: "", lines: wrapMain(body), types: noTypes() };
    };
    ty = main.returns;
    roots = noTypes();
    roots = push(roots, clone(ty));
    body = noStrings();
    // a value held inline (an array, a struct, an enum) is made in a frame, so the program is given room for it, and prints it (and frees what it owns) from there
    if isAggregate(ty) {
        body = push(body, "%out = alloca [".then(showInt(slotsOf(types, ty))).then(" x i64]"));
        body = push(body, "%ok = call i1 @tersus_main(ptr %out)");
        body = push(body, "br i1 %ok, label %print, label %done");
        body = push(body, "print:");
        body = push(body, "%w = ptrtoint ptr %out to i64");
        body = push(body, "call void ".then(printSymbol(types, ty)).then("(i64 %w)"));
        body = push(body, "%nl = call i64 @tersus_writeByte(i64 10)");
        if needsDrop(types, fns, ty) {
            body = push(body, "call void ".then(dropSymbol(types, ty)).then("(ptr %out)"));
        };
        body = push(body, "br label %done");
        body = push(body, "done:");
        body = push(body, "ret i32 0");
        return Entry { ok: true, error: "", lines: wrapMain(body), types: roots };
    };
    t = llvmType(ty);
    if !t.ok { return failedEntry(t.text); };
    result = resultStruct(t.text);
    word = "%v";
    convert = noStrings();
    if ty is Type::TBool {
        convert = push(convert, "%w = zext i1 %v to i64");
        word = "%w";
    };
    if !(isNumberWord(ty) || ty is Type::TBool) {
        convert = push(convert, "%w = ptrtoint ptr %v to i64");
        word = "%w";
    };
    body = push(body, "%r = call ".then(result).then(" @tersus_main()"));
    body = push(body, "%ok = extractvalue ".then(result).then(" %r, 1"));
    body = push(body, "br i1 %ok, label %print, label %done");
    body = push(body, "print:");
    body = push(body, "%v = extractvalue ".then(result).then(" %r, 0"));
    for c in convert { body = push(body, clone(c)); };
    body = push(body, "call void ".then(printSymbol(types, ty)).then("(i64 ").then(word).then(")"));
    body = push(body, "%nl = call i64 @tersus_writeByte(i64 10)");
    body = push(body, "br label %done");
    body = push(body, "done:");
    body = push(body, "ret i32 0");
    return Entry { ok: true, error: "", lines: wrapMain(body), types: roots };
};

fn printLines(lines: &List<String>) -> Int [{ }] [{ }] {
    n = 0;
    for l in lines {
        n = n + l.print();
        writeByte(toByte(10));
        n = n + 1;
    };
    return n;
};

// The code of a function
//
// The Haskell emits a block in a state monad `G`: a counter for the names of temporaries and labels, the lines so far, the types the code makes a function for, the
// globals it needs and the rooms in the frame for values it builds. Here the state is a `Gen` that each function takes and gives back. A function that also gives a value
// leaves its text in `last` (the name of the value that an instruction made, a number, the type of a local): the caller reads it at once, with `g.last`. The state is never
// in a struct with the value, since a field read from a struct that is used again afterwards is a copy, and a copy of the lines so far for each instruction would make the
// time to emit a function grow with the square of its size. An error is the first message in `error`: what comes after it is not looked at.
//
// Everything the Haskell emits is here: words, values held inline (arrays, structs and enums), Boxes, clones and drops, the calls and returns of each, and the function
// around its blocks. `bodies` shows the blocks of each function, `ir` is all of the IR.

struct Gen { count: Int, lines: List<String>, types: List<Type>, globals: List<String>, temps: List<String>, error: String, last: String, owner: String };

impl Clone for Gen { };

// What a call needs to know of a function of the program: the types of its parameters and of its result. (Looking a function up in the program itself copies it, and all
// its blocks, so they are taken once.)
struct Sig { name: String, params: List<Type>, ptrs: List<Bool>, paramsOk: Bool, hasReturn: Bool, returns: Type };

impl Clone for Sig { };

// What builds a value: a struct (tag 0, which has no word for it) or a variant of an enum (its position in the enum), the enum it is of, and its fields
struct Ctor { name: String, owner: String, tag: Int, tagged: Bool, fields: List<Field> };

impl Clone for Ctor { };

// The types of the program and the signatures of its functions, and for each type what is asked of it again and again, worked out once: the names, to look one up without
// copying the declarations, whether a value of it owns something and the words it takes, and the constructors
struct Ctx { types: List<TypeDecl>, sigs: List<Sig>, names: List<String>, drops: List<Bool>, sizes: List<Int>, aligns: List<Int>, ctors: List<Ctor>, ctorNames: List<String>, clones: List<String>, cloneTys: List<String> };

impl Clone for Ctx { };

fn newGen(owner: &String) -> Gen [{ }] [{ }] {
    return Gen { count: 0, lines: noStrings(), types: noTypes(), globals: noStrings(), temps: noStrings(), error: "", last: "", owner: clone(owner) };
};

// The first error is the one that is kept
fn failG(g: Gen, message: &String) -> Gen [{ }] [{ }] {
    if size(g.error.bytes) > 0 { return g; };
    return Gen { error: clone(message), ..g };
};

// The value of what was done: a text for the caller to take
fn giving(g: Gen, text: &String) -> Gen [{ }] [{ }] {
    return Gen { last: clone(text), ..g };
};

// An instruction
fn emit(g: Gen, line: &String) -> Gen [{ }] [{ }] {
    return Gen { lines: push(g.lines, "    ".then(line)), ..g };
};

// The start of a block
fn label(g: Gen, name: &String) -> Gen [{ }] [{ }] {
    return Gen { lines: push(g.lines, clone(name).then(":")), ..g };
};

// A name for a label that no other has
fn freshLabel(g: Gen, base: &String) -> Gen [{ }] [{ }] {
    return Gen { count: g.count + 1, last: clone(base).then(showInt(g.count)), ..g };
};

// An instruction that gives a value, and the name of that value
fn ins(g: Gen, base: &String, text: &String) -> Gen [{ }] [{ }] {
    name = "%".then(base).then(showInt(g.count));
    line = "    ".then(name).then(" = ").then(text);
    return Gen { count: g.count + 1, lines: push(g.lines, line), last: name, ..g };
};

fn slot(l: Int) -> String [{ }] [{ }] {
    return "%l.".then(showInt(l));
};

fn blockLabel(b: Int) -> String [{ }] [{ }] {
    return "bb".then(showInt(b));
};

// The value a slot holds before anything is assigned to it
fn zeroOf(t: &String) -> String [{ }] [{ }] {
    if t = "i1" { return "false"; };
    if t = "ptr" { return "null"; };
    return "0";
};

struct LT { ok: Bool, ty: Type };

impl Clone for LT { };

// The type of a local of a function (the locals are numbered from 0 in order, and the search is for those that are not)
fn localTypeOf(f: &Function, l: Int) -> LT [{ }] [{ }] {
    if l >= 0 && l < size(f.locals) {
        d = get(f.locals, l);
        if d.id = l { return LT { ok: true, ty: clone(d.ty) }; };
    };
    for d in f.locals {
        if d.id = l { return LT { ok: true, ty: clone(d.ty) }; };
    };
    return LT { ok: false, ty: Type::TInt };
};

fn hasInt(l: &List<Int>, x: Int) -> Bool [{ }] [{ }] {
    for y in l {
        if y = x { return true; };
    };
    return false;
};

fn noBools() -> List<Bool> [{ }] [{ }] {
    return [];
};

fn sigOf(f: &Function) -> Sig [{ }] [{ }] {
    params = noTypes();
    ptrs = noBools();
    ok = true;
    for param in f.params {
        r = localTypeOf(f, param);
        if r.ok { params = push(params, r.ty); } else {
            params = push(params, Type::TInt);
            ok = false;
        };
        ptrs = push(ptrs, hasInt(f.borrowed, param) || hasInt(f.mutBorrowed, param));
    };
    return Sig { name: clone(f.name), params: params, ptrs: ptrs, paramsOk: ok, hasReturn: f.hasReturn, returns: clone(f.returns) };
};

fn noCtors() -> List<Ctor> [{ }] [{ }] {
    return [];
};

fn noInts2() -> List<Int> [{ }] [{ }] {
    return [];
};

// The constructors of the program: the structs first and then the variants of the enums, in order, so that the first with a name is what Mir.constructor finds
fn ctorsOf(types: &List<TypeDecl>) -> List<Ctor> ~ {
    out = noCtors();
    for d in types {
        if d is TypeDecl::DStruct {
            out = push(out, Ctor { name: clone((d as TypeDecl::DStruct).name), owner: clone((d as TypeDecl::DStruct).name), tag: 0, tagged: false, fields: clone((d as TypeDecl::DStruct).fields) });
        };
    };
    for d in types {
        if d is TypeDecl::DEnum {
            variants = (d as TypeDecl::DEnum).variants;
            i = 0;
            while i < size(variants) [{ affirm i >= 0; affirm i <= size(variants); }] shrinks size(variants) - i {
                v = get(variants, i);
                out = push(out, Ctor { name: clone(v.name), owner: clone((d as TypeDecl::DEnum).name), tag: i, tagged: true, fields: clone(v.fields) });
                i = i + 1;
            };
        };
    };
    return out;
};

fn contextOf(program: &Program) -> Ctx ~ {
    fns = functionNames(program);
    sigs = [];
    for f in program.functions { sigs = push(sigs, sigOf(f)); };
    names = noStrings();
    drops = noBools();
    sizes = noInts2();
    aligns = noInts2();
    for d in program.types {
        names = push(names, declName(d));
        drops = push(drops, needsDrop(program.types, fns, Type::TNamed { name: declName(d), base: declName(d), argc: 0, argTokens: [] }));
        l = declLayout(program.types, d);
        sizes = push(sizes, l.size);
        aligns = push(aligns, l.align);
    };
    ctors = ctorsOf(program.types);
    ctorNames = noStrings();
    for c in ctors { ctorNames = push(ctorNames, clone(c.name)); };
    clones = noStrings();
    cloneTys = noStrings();
    for s in sigs {
        if s.hasReturn && size(s.params) > 0 && hasText(s.name, " as Clone>::clone") {
            clones = push(clones, clone(s.name));
            cloneTys = push(cloneTys, renderType(canonical(program.types, s.returns)));
        };
    };
    return Ctx { types: clone(program.types), sigs: sigs, names: names, drops: drops, sizes: sizes, aligns: aligns, ctors: ctors, ctorNames: ctorNames, clones: clones, cloneTys: cloneTys };
};

// The index of the declaration of a struct or an enum, or -1 (the same as lookupDecl, without copying the declarations)
fn declIndex(cx: &Ctx, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(cx.names); }] {
    i = 0;
    while i < size(cx.names) [{ affirm i >= 0; affirm i <= size(cx.names); }] shrinks size(cx.names) - i {
        if get(cx.names, i) = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

fn sigIndex(cx: &Ctx, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(cx.sigs); }] {
    i = 0;
    while i < size(cx.sigs) [{ affirm i >= 0; affirm i <= size(cx.sigs); }] shrinks size(cx.sigs) - i {
        if get(cx.sigs, i).name = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

// Whether `hay` holds `needle`
fn hasText(hay: &String, needle: &String) -> Bool ~ {
    i = 0;
    while i < size(hay.bytes) [{ affirm i >= 0; affirm i <= size(hay.bytes); }] shrinks size(hay.bytes) - i {
        if hay.slice(i, size(hay.bytes)).startsWith(needle) { return true; };
        i = i + 1;
    };
    return size(needle.bytes) = 0;
};

// The `Clone` impl of a type, when the program has one: the function a copy of the type is. It is the one whose
// name says it is the `clone` of the trait `Clone` and whose result is the type (the impl of a list is named
// for `List`, and its result is the `List` the list is made of, so the name is not made from the type)
fn cloneImplName(cx: &Ctx, t: &Type) -> Res ~ {
    want = renderType(canonical(&cx.types, t));
    i = 0;
    while i < size(cx.clones) && i < size(cx.cloneTys) [{ affirm i >= 0; affirm i <= size(cx.clones); affirm i <= size(cx.cloneTys); }] shrinks size(cx.clones) - i {
        if get(cx.cloneTys, i) = want { return Res { ok: true, text: clone(get(cx.clones, i)) }; };
        i = i + 1;
    };
    return Res { ok: false, text: "" };
};

// The lines that copy one field of a value at %from into %to, where the field is a value held inline (a word is
// already copied by the copy of the whole value): a copy the field's type makes itself, which is its `Clone`
// impl when it has one and the made function of its type when it does not
fn cloneFieldLines(cx: &Ctx, variantIndex: Int, fields: &List<Field>, start: Int) -> List<String> ~ {
    types = &cx.types;
    out = noStrings();
    offset = 0;
    i = 0;
    for f in fields {
        l = layoutOf(types, &f.ty);
        offset = roundUp(offset, l.align);
        ct = canonical(types, f.ty);
        if isAggregate(ct) {
            reg = "%cf".then(showInt(variantIndex)).then(".").then(showInt(i));
            out = push(out, "    ".then(reg).then("f = getelementptr i8, ptr %from, i64 ").then(showInt(start + offset)));
            out = push(out, "    ".then(reg).then("t = getelementptr i8, ptr %to, i64 ").then(showInt(start + offset)));
            implName = cloneImplName(cx, ct);
            if implName.ok {
                out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr ").then(reg).then("t, ptr ").then(reg).then("f)"));
            } else {
                out = push(out, "    call void ".then(cloneSymbol(types, ct)).then("(ptr ").then(reg).then("t, ptr ").then(reg).then("f)"));
            };
        };
        offset = offset + l.size;
        i = i + 1;
    };
    return out;
};

// The function that copies a value of the type into another that shares nothing with it, for a type with no
// `Clone` impl to call (a copy of a type that has one is that impl): the words of the value, and then what
// its fields or its elements hold, as a deep copy is made. A value that is not there (0)
// is copied as it is.
fn cloneFunctionLines(cx: &Ctx, t: &Type) -> List<String> ~ {
    types = &cx.types;
    out = noStrings();
    out = push(out, "define internal void ".then(cloneSymbol(types, t)).then("(ptr %to, ptr %from) {"));
    out = push(out, "entry:");
    bytes = layoutOf(types, t).size;
    if bytes > 0 {
        out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %to, ptr %from, i64 ".then(showInt(bytes)).then(", i1 false)"));
    };
    arr = sizedArray(t);
    if arr.ok {
        if needsDropIn(cx, arr.elem) {
            step = layoutOf(types, arr.elem).size;
            out = push(out, "    br label %chead");
            out = push(out, "chead:");
            out = push(out, "    %ci = phi i64 [0, %entry], [%cnext, %cbody]");
            out = push(out, "    %ccond = icmp eq i64 %ci, ".then(showInt(arr.length)));
            out = push(out, "    br i1 %ccond, label %done, label %cbody");
            out = push(out, "cbody:");
            out = push(out, "    %coff = mul i64 %ci, ".then(showInt(step)));
            out = push(out, "    %cfp = getelementptr i8, ptr %from, i64 %coff");
            out = push(out, "    %ctp = getelementptr i8, ptr %to, i64 %coff");
            implName = cloneImplName(cx, arr.elem);
            if implName.ok {
                out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %ctp, ptr %cfp)"));
            } else {
                out = push(out, "    call void ".then(cloneSymbol(types, arr.elem)).then("(ptr %ctp, ptr %cfp)"));
            };
            out = push(out, "    %cnext = add i64 %ci, 1");
            out = push(out, "    br label %chead");
            out = push(out, "done:");
        };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok {
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    variants = variantsOf(types, n.text);
    isEnumKind = isEnum(types, n.text);
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    start = 0;
    if isEnumKind { start = roundUp(4, payload); };
    if size(variants) > 0 && size(get(variants, 0).fields) > 0 && (beforeAngle(n.text) = "List" || beforeAngle(n.text) = "Box") {
        fields = get(variants, 0).fields;
        offset0 = 0;
        lenOffset = 0;
        capOffset = 0;
        offset = 0;
        i = 0;
        for f in fields {
            l = layoutOf(types, f.ty);
            offset = roundUp(offset, l.align);
            if i = 0 { offset0 = start + offset; };
            if i = 1 { lenOffset = start + offset; };
            if i = 2 { capOffset = start + offset; };
            offset = offset + l.size;
            i = i + 1;
        };
        held = get(fields, 0).ty;
        if held is Type::TAddr {
            elem = Box::unbox((held as Type::TAddr).inner);
            out = push(out, "    %addrp = getelementptr i8, ptr %from, i64 ".then(showInt(offset0)));
            out = push(out, "    %addr = load i64, ptr %addrp");
            out = push(out, "    %has = icmp ne i64 %addr, 0");
            if beforeAngle(n.text) = "List" {
                step = layoutOf(types, elem).size;
                out = push(out, "    br i1 %has, label %lalloc, label %done");
                out = push(out, "lalloc:");
                out = push(out, "    %lenp = getelementptr i8, ptr %from, i64 ".then(showInt(lenOffset)));
                out = push(out, "    %count = load i64, ptr %lenp");
                out = push(out, "    %bytes = mul i64 %count, ".then(showInt(step)));
                out = push(out, "    %copy = call ptr @tersus_box_new(i64 %bytes)");
                out = push(out, "    %base = inttoptr i64 %addr to ptr");
                if step > 0 {
                    out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %copy, ptr %base, i64 %bytes, i1 false)");
                };
                if needsDropIn(cx, elem) {
                    out = push(out, "    br label %lhead");
                    out = push(out, "lhead:");
                    out = push(out, "    %li = phi i64 [0, %lalloc], [%lnext, %lbody]");
                    out = push(out, "    %lcond = icmp eq i64 %li, %count");
                    out = push(out, "    br i1 %lcond, label %lstore, label %lbody");
                    out = push(out, "lbody:");
                    out = push(out, "    %loff = mul i64 %li, ".then(showInt(step)));
                    out = push(out, "    %lfp = getelementptr i8, ptr %base, i64 %loff");
                    out = push(out, "    %ltp = getelementptr i8, ptr %copy, i64 %loff");
                    implName = cloneImplName(cx, elem);
                    if implName.ok {
                        out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %ltp, ptr %lfp)"));
                    } else {
                        out = push(out, "    call void ".then(cloneSymbol(types, elem)).then("(ptr %ltp, ptr %lfp)"));
                    };
                    out = push(out, "    %lnext = add i64 %li, 1");
                    out = push(out, "    br label %lhead");
                    out = push(out, "lstore:");
                } else {
                    out = push(out, "    br label %lstore");
                    out = push(out, "lstore:");
                };
                out = push(out, "    %top = getelementptr i8, ptr %to, i64 ".then(showInt(offset0)));
                out = push(out, "    %copyi = ptrtoint ptr %copy to i64");
                out = push(out, "    store i64 %copyi, ptr %top");
                out = push(out, "    %capp = getelementptr i8, ptr %to, i64 ".then(showInt(capOffset)));
                out = push(out, "    store i64 %count, ptr %capp");
                out = push(out, "    br label %done");
                out = push(out, "done:");
            } else {
                esize = layoutOf(types, elem).size;
                out = push(out, "    br i1 %has, label %balloc, label %done");
                out = push(out, "balloc:");
                out = push(out, "    %heldp = inttoptr i64 %addr to ptr");
                out = push(out, "    %copy = call ptr @tersus_box_new(i64 ".then(showInt(esize)).then(")"));
                if isAggregate(elem) {
                    implName = cloneImplName(cx, elem);
                    if implName.ok {
                        out = push(out, "    call void ".then(functionSymbol(implName.text)).then("(ptr %copy, ptr %heldp)"));
                    } else {
                        out = push(out, "    call void ".then(cloneSymbol(types, elem)).then("(ptr %copy, ptr %heldp)"));
                    };
                } else {
                    if esize > 0 {
                        out = push(out, "    call void @llvm.memcpy.p0.p0.i64(ptr %copy, ptr %heldp, i64 ".then(showInt(esize)).then(", i1 false)"));
                    };
                };
                out = push(out, "    %top = getelementptr i8, ptr %to, i64 ".then(showInt(offset0)));
                out = push(out, "    %copyi = ptrtoint ptr %copy to i64");
                out = push(out, "    store i64 %copyi, ptr %top");
                out = push(out, "    br label %done");
                out = push(out, "done:");
            };
            out = push(out, "    ret void");
            out = push(out, "}");
            return out;
        };
    };
    if isEnumKind {
        out = push(out, "    %tag = load i32, ptr %from");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
        j = 0;
        for v in variants {
            out = push(out, "v".then(showInt(j)).then(":"));
            for l in cloneFieldLines(cx, j, v.fields, start) { out = push(out, clone(l)); };
            out = push(out, "    br label %done");
            j = j + 1;
        };
        out = push(out, "done:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if size(variants) > 0 {
        for l in cloneFieldLines(cx, 0, get(variants, 0).fields, start) { out = push(out, clone(l)); };
    };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A copy function for every type that is a value held inline, for a copy of one that has no `Clone` impl to call
fn cloneFunctions(cx: &Ctx, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        if t is Type::TNamed || sizedArray(t).ok {
            for l in cloneFunctionLines(cx, t) { out = push(out, clone(l)); };
            out = push(out, "");
        };
    };
    return out;
};


// The index of the constructor with a name, or -1 (Mir.constructor)
fn ctorIndex(cx: &Ctx, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(cx.ctorNames); }] {
    i = 0;
    while i < size(cx.ctorNames) [{ affirm i >= 0; affirm i <= size(cx.ctorNames); }] shrinks size(cx.ctorNames) - i {
        if get(cx.ctorNames, i) = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

// The struct or enum that a type is a value of: a struct or an enum itself, or a variant (whose enum is looked up)
fn declaredIn(cx: &Ctx, t: &Type) -> Res [{ }] [{ }] {
    if t is Type::TNamed { return Res { ok: true, text: clone((t as Type::TNamed).name) }; };
    if t is Type::TVariant {
        i = ctorIndex(cx, (t as Type::TVariant).name);
        if i >= 0 && i < size(cx.ctors) { return Res { ok: true, text: clone(get(cx.ctors, i).owner) }; };
    };
    return Res { ok: false, text: "" };
};

// Whether a value owns something to free (needsDrop, with the answer for a struct or an enum taken from the table)
fn needsDropIn(cx: &Ctx, t: &Type) -> Bool ~ {
    if t is Type::TBox { return true; };
    if t is Type::TArray { return needsDropIn(cx, Box::unbox((t as Type::TArray).elem)); };
    n = declaredIn(cx, t);
    if !n.ok { return false; };
    i = declIndex(cx, n.text);
    if i < 0 || i >= size(cx.drops) { return false; };
    return get(cx.drops, i);
};

// The layout of a value held inline (layoutOf, with the answer for a struct or an enum taken from the table)
fn layoutIn(cx: &Ctx, t: &Type) -> Layout ~ {
    simple = simpleLayout(t);
    if simple.ok { return clone(simple.layout); };
    arr = sizedArray(t);
    if arr.ok {
        e = layoutIn(cx, arr.elem);
        return Layout { size: arr.length * e.size, align: e.align };
    };
    n = declaredIn(cx, t);
    if !n.ok { return wordLayout(); };
    i = declIndex(cx, n.text);
    if i < 0 || i >= size(cx.sizes) || i >= size(cx.aligns) { return wordLayout(); };
    return Layout { size: get(cx.sizes, i), align: get(cx.aligns, i) };
};

fn bytesIn(cx: &Ctx, t: &Type) -> Int ~ {
    return layoutIn(cx, t).size;
};

// The 8-byte words of room a value held inline takes in a frame
fn slotsIn(cx: &Ctx, t: &Type) -> Int ~ {
    return (bytesIn(cx, t) + 7) / 8;
};

// Whether a local of the type has something to free: a value held inline that holds something of the heap (a list or a Box of the library,
// which is a word of it)
fn ownsIn(cx: &Ctx, t: &Type) -> Bool ~ {
    return isAggregate(t) && needsDropIn(cx, t);
};

// The type of a local, which is in `ty`; an error in the state when there is no such local
struct LTG { g: Gen, ty: Type };

impl Clone for LTG { };

// The LLVM type of a value that is a word, as text in `last`; the state has the error when there is none
fn typeText(g: Gen, t: &Type) -> Gen ~ {
    r = llvmType(t);
    if !r.ok { return failG(g, r.text); };
    return giving(g, r.text);
};

// A struct is its own constructor, and a variant has its enum's representation
fn constructedType(cx: &Ctx, name: &String) -> Type [{ }] [{ }] {
    i = declIndex(cx, name);
    if i >= 0 && i < size(&cx.types) {
        d = get(&cx.types, i);
        if d is TypeDecl::DStruct { return Type::TNamed { name: clone(name), base: clone(name), argc: 0, argTokens: [] }; };
    };
    return Type::TVariant { name: clone(name) };
};

// An array of a size that is a constant or not, and a Box of an array of any size (the arrays that a Box holds are on the heap)
fn isArray(t: &Type) -> Bool [{ }] [{ }] {
    return isSizedArray(t);
};

// A list of native code: the struct List of lib/lists.tersus, whose first field is the address of the elements, so that an element is read from the address that the struct
// starts with
fn isListStruct(t: &Type) -> Bool [{ }] [{ }] {
    if t is Type::TNamed { return beforeAngle((t as Type::TNamed).name) = "List"; };
    return false;
};

// The type of the elements of a list of native code: what the address that is its first field is of
fn listElement(cx: &Ctx, t: &Type) -> Held ~ {
    if !(t is Type::TNamed) { return Held { ok: false, ty: Type::TInt }; };
    i = lookupDecl(&cx.types, (t as Type::TNamed).name);
    if i < 0 || i >= size(&cx.types) { return Held { ok: false, ty: Type::TInt }; };
    d = get(&cx.types, i);
    if d is TypeDecl::DStruct {
        fields = (d as TypeDecl::DStruct).fields;
        if size(fields) > 0 {
            first = get(fields, 0).ty;
            if first is Type::TAddr { return Held { ok: true, ty: clone(Box::unbox((first as Type::TAddr).inner)) }; };
        };
    };
    return Held { ok: false, ty: Type::TInt };
};

// A Box of native code: the struct Box of lib/box.tersus, whose one word is the address of what it holds, as a Box's is
fn isBoxStruct(t: &Type) -> Bool [{ }] [{ }] {
    if t is Type::TNamed { return beforeAngle((t as Type::TNamed).name) = "Box"; };
    return false;
};

// Whether the contents of a constant say what it is made of: a number or a Bool does, and a list when one element does
fn constantKnown(c: &Constant) -> Bool ~ {
    if c is Constant::CList {
        for x in (c as Constant::CList).items {
            if constantKnown(x) { return true; };
        };
        return false;
    };
    if c is Constant::CArray {
        for x in (c as Constant::CArray).items {
            if constantKnown(x) { return true; };
        };
        return false;
    };
    return true;
};

// The type of a constant, as far as its contents say: an empty list of lists is a List<List<Int>>
fn constantShape(cx: &Ctx, c: &Constant) -> Type ~ {
    if c is Constant::CBool { return Type::TBool; };
    if c is Constant::CList || c is Constant::CArray {
        items = noConstants();
        if c is Constant::CList { items = (c as Constant::CList).items; };
        if c is Constant::CArray { items = (c as Constant::CArray).items; };
        // the shape of the first element that shows what it is made of, or of the first
        elem = Type::TInt;
        found = false;
        for x in items {
            if !found && constantKnown(x) {
                elem = constantShape(cx, x);
                found = true;
            };
        };
        if !found && size(items) > 0 { elem = constantShape(cx, get(items, 0)); };
        if c is Constant::CList { return Type::TList { elem: Box::new(elem) }; };
        return Type::TArray { elem: Box::new(elem), size: Size::SConst { n: size(items) } };
    };
    if c is Constant::CData { return constructedType(cx, (c as Constant::CData).name); };
    if c is Constant::CFn {
        i = sigIndex(cx, (c as Constant::CFn).name);
        if i >= 0 {
            sig = get(cx.sigs, i);
            ret = Type::TInt;
            if sig.hasReturn { ret = clone(sig.returns); };
            return Type::TFn { args: clone(sig.params), ret: Box::new(ret) };
        };
        return Type::TInt;
    };
    return Type::TInt;
};

// The type that the operands of an operation share. A local has a type; a constant has one only where it holds a number or a Bool, and the nesting of an empty list is all it
// says of its elements, so the type of a local comes first, then that of a constant that shows its leaves, then the shape of one that does not, with Int for the leaf.
fn sharedType(cx: &Ctx, f: &Function, os: &List<Operand>) -> Type ~ {
    for o in os {
        if o is Operand::Copy {
            r = localTypeOf(f, (o as Operand::Copy).local);
            if r.ok { return r.ty; };
        };
        if o is Operand::Move {
            r = localTypeOf(f, (o as Operand::Move).local);
            if r.ok { return r.ty; };
        };
    };
    for o in os {
        if o is Operand::Const {
            c = (o as Operand::Const).value;
            if constantKnown(c) { return constantShape(cx, c); };
        };
    };
    for o in os {
        if o is Operand::Const { return constantShape(cx, (o as Operand::Const).value); };
    };
    return Type::TInt;
};

// A type the code makes a function for (a drop, a copy or a print of it), put with the types of the program
fn descriptor(g: Gen, cx: &Ctx, t: &Type) -> Gen ~ {
    return Gen { types: push(g.types, clone(t)), ..g };
};

// Copies the value of the type at `from` into `to`, which then shares nothing with it: the copy the type
// makes itself, which is its `Clone` impl when it has one (which is assumed to be a value that is made of
// copies of its parts, as the impl the language makes for `impl Clone for T { };` is) and the made function
// of the type when it does not
fn cloneValue(g: Gen, cx: &Ctx, current: &String, t: &Type, to: &String, from: &String) -> Gen ~ {
    g1 = descriptor(g, cx, t);
    implName = cloneImplName(cx, t);
    // (a copy inside the `Clone` impl of the type itself is the copy the impl is made of, not the impl called
    // again: the impl of a Box copies the Box it makes, and the impl of a list the list it holds)
    if implName.ok && implName.text = current { implName = Res { ok: false, text: "" }; };
    if implName.ok {
        return emit(g1, "call void ".then(functionSymbol(implName.text)).then("(ptr ").then(clone(to)).then(", ptr ").then(clone(from)).then(")"));
    };
    return emit(g1, "call void ".then(cloneSymbol(&cx.types, t)).then("(ptr ").then(clone(to)).then(", ptr ").then(clone(from)).then(")"));
};

// Frees what the value a local holds owns (nothing, if it holds none), and leaves a Box it held holding nothing
fn dropSlot(g: Gen, cx: &Ctx, t: &Type, l: Int) -> Gen ~ {
    g1 = descriptor(g, cx, t);
    return emit(g1, "call void ".then(dropSymbol(&cx.types, t)).then("(ptr ").then(slot(l)).then(")"));
};

fn memcpyText(to: &String, from: &String, bytes: Int) -> String [{ }] [{ }] {
    return "call void @llvm.memcpy.p0.p0.i64(ptr ".then(to).then(", ptr ").then(from).then(", i64 ").then(showInt(bytes)).then(", i1 false)");
};

// Copies the words of a value to where another is (nothing to do when it is where it is)
fn copyWords(g: Gen, to: &String, from: &String, bytes: Int) -> Gen [{ }] [{ }] {
    if to = from || bytes = 0 { return g; };
    return emit(g, memcpyText(to, from, bytes));
};

// Clears the words of a value that has been moved out
fn zeroWords(g: Gen, at: &String, bytes: Int) -> Gen [{ }] [{ }] {
    if bytes = 0 { return g; };
    return emit(g, "call void @llvm.memset.p0.i64(ptr ".then(at).then(", i8 0, i64 ").then(showInt(bytes)).then(", i1 false)"));
};

// Room in the frame of the function for a value it builds, made at its start; its name in `last`
fn entryTemp(g: Gen, count: Int) -> Gen [{ }] [{ }] {
    name = "%t.".then(showInt(g.count));
    return Gen { count: g.count + 1, temps: push(g.temps, "    ".then(name).then(" = alloca [").then(showInt(count)).then(" x i64]")), last: name, ..g };
};

// The constructor with a name, as the index in the table of the context (the error is in the state)
struct CtorAt { g: Gen, i: Int };

impl Clone for CtorAt { };

fn constructorG(g: Gen, cx: &Ctx, name: &String) -> CtorAt [{ }] [{ }] {
    i = ctorIndex(cx, name);
    if i < 0 || i >= size(cx.ctors) { return CtorAt { g: failG(g, "Unknown struct or variant: ".then(name)), i: 0 }; };
    return CtorAt { g: g, i: i };
};

// The constructor at an index of the table (a made-up one when there is none, which constructorG has said)
fn ctorAt(cx: &Ctx, i: Int) -> Ctor [{ }] [{ }] {
    if i >= 0 && i < size(cx.ctors) { return clone(get(cx.ctors, i)); };
    return Ctor { name: "", owner: "", tag: 0, tagged: false, fields: [] };
};

// The index of a field in the fields of a constructor, or -1
fn fieldIndex(fields: &List<Field>, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(fields); }] {
    i = 0;
    while i < size(fields) [{ affirm i >= 0; affirm i <= size(fields); }] shrinks size(fields) - i {
        if get(fields, i).name = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

// The byte offset of the field at a position of a constructor: an enum value starts with a word that says the variant, a struct with its first field. A field is a word, or
// the words of a value held inline.
fn fieldOffset(cx: &Ctx, c: &Ctor, i: Int) -> Int ~ {
    // (the fields of a variant of an enum start after the tag, where every variant's fields can start: Mir.fieldOffsets)
    types = &cx.types;
    start = 0;
    if c.tagged {
        payload = 1;
        k = lookupDecl(types, c.owner);
        if k >= 0 {
            d = &get(types, k);
            match *d {
                TypeDecl::DEnum { name: name, variants: variants } => {
                    for v in variants {
                        l = fieldsLayout(types, &v.fields);
                        if l.align > payload { payload = l.align; };
                    };
                },
                TypeDecl::DStruct { name: name, fields: fields } => { },
            };
        };
        start = roundUp(4, payload);
    };
    offset = 0;
    j = 0;
    while j < i && j < size(c.fields) [{ affirm j >= 0; affirm j <= size(c.fields); }] shrinks size(c.fields) - j {
        l = layoutIn(cx, &get(c.fields, j).ty);
        offset = roundUp(offset, l.align) + l.size;
        j = j + 1;
    };
    if i >= 0 && i < size(c.fields) { offset = roundUp(offset, layoutIn(cx, &get(c.fields, i).ty).align); };
    return start + offset;
};

// The LLVM type a number of the type is stored as
fn memoryType(t: &Type) -> String [{ }] [{ }] {
    if t is Type::TByte || t is Type::TBool { return "i8"; };
    if t is Type::TWord { return "i".then(showInt((t as Type::TWord).bits)); };
    return "i64";
};

// A value in memory is as many bytes as its type has (layoutOf): an Int or an address 8, a Bool 1 (0 or 1), a Byte 1 and a fixed-width integer its bits over 8, and a
// pointer 8. In a register a number is an i64 and a Bool an i1, so a narrower one is truncated to be stored and widened when it is loaded (with its sign, for a signed one).
fn storeAt(g: Gen, t: &Type, p: &String, value: &String) -> Gen [{ }] [{ }] {
    if t is Type::TByte || t is Type::TWord {
        width = memoryType(t);
        g1 = ins(g, "w", "trunc i64 ".then(value).then(" to ").then(width));
        w = clone(g1.last);
        return emit(g1, "store ".then(width).then(" ").then(w).then(", ptr ").then(p));
    };
    if isNumberWord(t) { return emit(g, "store i64 ".then(value).then(", ptr ").then(p)); };
    if t is Type::TBool {
        g1 = ins(g, "w", "zext i1 ".then(value).then(" to i8"));
        w = clone(g1.last);
        return emit(g1, "store i8 ".then(w).then(", ptr ").then(p));
    };
    return emit(g, "store ptr ".then(value).then(", ptr ").then(p));
};

fn loadAt(g: Gen, t: &Type, p: &String) -> Gen [{ }] [{ }] {
    if t is Type::TByte || t is Type::TWord {
        width = memoryType(t);
        how = "zext";
        if t is Type::TWord && (t as Type::TWord).signed { how = "sext"; };
        g1 = ins(g, "w", "load ".then(width).then(", ptr ").then(p));
        w = clone(g1.last);
        return ins(g1, "v", clone(how).then(" ").then(width).then(" ").then(w).then(" to i64"));
    };
    if isNumberWord(t) { return ins(g, "v", "load i64, ptr ".then(p)); };
    if t is Type::TBool {
        g1 = ins(g, "w", "load i8, ptr ".then(p));
        w = clone(g1.last);
        return ins(g1, "b", "icmp ne i8 ".then(w).then(", 0"));
    };
    return ins(g, "v", "load ptr, ptr ".then(p));
};

// A slot of a struct or an enum value, at a byte offset
fn storeSlot(g: Gen, cx: &Ctx, t: &Type, object: &String, offset: Int, value: &String) -> Gen ~ {
    g1 = ins(g, "p", "getelementptr i8, ptr ".then(object).then(", i64 ").then(showInt(offset)));
    p = clone(g1.last);
    if isAggregate(t) { return copyWords(g1, p, value, bytesIn(cx, t)); };
    return storeAt(g1, t, p, value);
};

fn loadSlot(g: Gen, t: &Type, object: &String, offset: Int) -> Gen [{ }] [{ }] {
    g1 = ins(g, "p", "getelementptr i8, ptr ".then(object).then(", i64 ").then(showInt(offset)));
    p = clone(g1.last);
    return loadAt(g1, t, p);
};

// The address of an element at an index, an element being so many bytes
fn elementAddress(g: Gen, base: &String, index: &String, bytes: Int) -> Gen [{ }] [{ }] {
    g1 = ins(g, "o", "mul i64 ".then(index).then(", ").then(showInt(bytes)));
    offset = clone(g1.last);
    return ins(g1, "p", "getelementptr i8, ptr ".then(base).then(", i64 ").then(offset));
};

// The numbers in a constant array, flattened
fn flattenConstant(ws: List<String>, c: &Constant) -> List<String> ~ {
    out = ws;
    if c is Constant::CInt { out = push(out, showInt((c as Constant::CInt).n)); };
    if c is Constant::CBool {
        if (c as Constant::CBool).b { out = push(out, "1"); } else { out = push(out, "0"); };
    };
    if c is Constant::CArray {
        for x in (c as Constant::CArray).items { out = flattenConstant(out, x); };
    };
    return out;
};

// Whether a constant is, or has in it, a Bool
fn hasBool(c: &Constant) -> Bool ~ {
    if c is Constant::CBool { return true; };
    if c is Constant::CArray {
        for x in (c as Constant::CArray).items {
            if hasBool(x) { return true; };
        };
    };
    return false;
};

// The position of a name in a list of names, or -1
fn fieldIndex2(names: &List<String>, name: &String) -> Int [{ }] [{ affirm return >= 0 - 1; affirm return < size(names); }] {
    i = 0;
    while i < size(names) [{ affirm i >= 0; affirm i <= size(names); }] shrinks size(names) - i {
        if get(names, i) = name { return i; };
        i = i + 1;
    };
    return 0 - 1;
};

// The words of a constant array as a global that the code only reads: its name in `last`
fn constantWords(g: Gen, cs: &List<Constant>) -> Gen ~ {
    k = global("const.", clone(g.owner).then("#").then(showInt(g.count)));
    ws = noStrings();
    for c in cs { ws = flattenConstant(ws, c); };
    // (an array literal is of Ints, which are 8 bytes, or of Bools, which are 1)
    element = "i64";
    for c in cs {
        if hasBool(c) { element = "i8"; };
    };
    body = "zeroinitializer";
    if size(ws) > 0 {
        parts = noStrings();
        for w in ws { parts = push(parts, clone(element).then(" ").then(w)); };
        body = "[".then(joinWith(", ", parts)).then("]");
    };
    line = clone(k).then(" = private constant [").then(showInt(size(ws))).then(" x ").then(element).then("] ").then(body);
    return Gen { count: g.count + 1, globals: push(g.globals, line), last: k, ..g };
};

// Writes a constant into the words at an address, of the type that it is
fn writeConstant(g: Gen, cx: &Ctx, ty: &Type, at: &String, c: &Constant) -> Gen ~ {
    if c is Constant::CInt { return emit(g, "store ".then(memoryType(ty)).then(" ").then(showInt((c as Constant::CInt).n)).then(", ptr ").then(at)); };
    if c is Constant::CBool {
        if (c as Constant::CBool).b { return emit(g, "store i8 1, ptr ".then(at)); };
        return emit(g, "store i8 0, ptr ".then(at));
    };
    if c is Constant::CFn { return emit(g, "store ptr ".then(functionSymbol((c as Constant::CFn).name)).then(", ptr ").then(at)); };
    if c is Constant::CList { return failG(g, "Native code has no list constant: ".then(renderType(ty))); };
    if c is Constant::CArray {
        g1 = constantWords(g, (c as Constant::CArray).items);
        from = clone(g1.last);
        return copyWords(g1, at, from, bytesIn(cx, ty));
    };
    if !(c is Constant::CData) { return failG(g, "A constant of the wrong type"); };
    name = (c as Constant::CData).name;
    names = (c as Constant::CData).fields;
    values = (c as Constant::CData).values;
    k = constructorG(g, cx, name);
    g1 = k.g;
    if size(g1.error.bytes) > 0 { return g1; };
    ctor = ctorAt(cx, k.i);
    if ctor.tagged { g1 = emit(g1, "store i32 ".then(showInt(ctor.tag)).then(", ptr ").then(at)); };
    i = 0;
    while i < size(ctor.fields) [{ affirm i >= 0; affirm i <= size(ctor.fields); }] ~ {
        field = get(ctor.fields, i);
        j = fieldIndex2(names, field.name);
        if j < 0 || j >= size(values) { return failG(g1, "A field is missing: ".then(name).then(".").then(field.name)); };
        offset = fieldOffset(cx, ctor, i);
        g2 = ins(g1, "p", "getelementptr i8, ptr ".then(at).then(", i64 ").then(showInt(offset)));
        p = clone(g2.last);
        g1 = writeConstant(g2, cx, field.ty, p, get(values, j));
        i = i + 1;
    };
    return g1;
};

// A constant that is held inline: an array literal is a global, and a struct or an enum is built in room of its own each time it is wanted (it can hold a list, which is
// made then); its address in `last`
fn constantAggregate(g: Gen, cx: &Ctx, ty: &Type, c: &Constant) -> Gen ~ {
    if c is Constant::CArray { return constantWords(g, (c as Constant::CArray).items); };
    g1 = entryTemp(g, slotsIn(cx, ty));
    room = clone(g1.last);
    g2 = writeConstant(g1, cx, ty, room, c);
    return giving(g2, room);
};

// The text of a constant, in `last`
fn constantValue(g: Gen, cx: &Ctx, ty: &Type, c: &Constant) -> Gen ~ {
    if c is Constant::CInt { return giving(g, showInt((c as Constant::CInt).n)); };
    if c is Constant::CBool {
        if (c as Constant::CBool).b { return giving(g, "true"); };
        return giving(g, "false");
    };
    // a function is its address
    if c is Constant::CFn { return giving(g, functionSymbol((c as Constant::CFn).name)); };
    if c is Constant::CArray || c is Constant::CData { return constantAggregate(g, cx, ty, c); };
    return failG(g, "A constant of the wrong type is not a ".then(renderType(ty)));
};

// The address of the words of a value held inline that an operand is, ready for something to take: a value that is moved out of a local and owns something is copied to room
// of its own and the local is cleared, so that what takes it can copy it later with the local already empty. A constant is built in room of its own.
fn operandAddress(g: Gen, cx: &Ctx, f: &Function, ty: &Type, o: &Operand) -> Gen ~ {
    if o is Operand::Const { return constantAggregate(g, cx, ty, (o as Operand::Const).value); };
    if o is Operand::Copy { return giving(g, slot((o as Operand::Copy).local)); };
    if o is Operand::Move {
        l = (o as Operand::Move).local;
        lt = localTypeOf(f, l);
        if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
        if ownsIn(cx, lt.ty) {
            bytes = bytesIn(cx, lt.ty);
            g1 = entryTemp(g, (bytes + 7) / 8);
            room = clone(g1.last);
            g2 = copyWords(g1, room, slot(l), bytes);
            g3 = zeroWords(g2, slot(l), bytes);
            return giving(g3, room);
        };
        return giving(g, slot(l));
    };
    return g;
};

// The text that stands for an operand where a value of the type is wanted, in `last`: the value loaded from the slot of a local, a number or a Bool, or the address of a value
// held inline
fn operandValue(g: Gen, cx: &Ctx, f: &Function, ty: &Type, o: &Operand) -> Gen ~ {
    if o is Operand::Const { return constantValue(g, cx, ty, (o as Operand::Const).value); };
    l = 0;
    moved = false;
    if o is Operand::Copy { l = (o as Operand::Copy).local; };
    if o is Operand::Move {
        l = (o as Operand::Move).local;
        moved = true;
    };
    lt = localTypeOf(f, l);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
    g1 = typeText(g, lt.ty);
    t = clone(g1.last);
    // (a value held inline is the address of the words it is made of)
    if isAggregate(lt.ty) {
        if moved { return operandAddress(g1, cx, f, lt.ty, o); };
        return giving(g1, slot(l));
    };
    g2 = ins(g1, "v", "load ".then(t).then(", ptr ").then(slot(l)));
    if moved {
        v = clone(g2.last);
        g3 = emit(g2, "store ".then(t).then(" ").then(zeroOf(t)).then(", ptr ").then(slot(l)));
        return giving(g3, v);
    };
    return g2;
};

// The type of a local that an operand is
fn operandLocalType(f: &Function, o: &Operand) -> LT [{ }] [{ }] {
    if o is Operand::Copy { return localTypeOf(f, (o as Operand::Copy).local); };
    if o is Operand::Move { return localTypeOf(f, (o as Operand::Move).local); };
    return LT { ok: false, ty: Type::TInt };
};

// The address of the words of a struct or an enum value that an operand is: a local holds them, and a Box holds a pointer to them; in `last`
fn dataBase(g: Gen, cx: &Ctx, f: &Function, ty: &Type, o: &Operand) -> Gen ~ {
    if o is Operand::Const { return constantAggregate(g, cx, ty, (o as Operand::Const).value); };
    l = 0;
    if o is Operand::Copy { l = (o as Operand::Copy).local; };
    if o is Operand::Move { l = (o as Operand::Move).local; };
    lt = localTypeOf(f, l);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
    // (a Box of the library is the address of what it holds, as a Box is: lib/box.tersus; its own field is read from it)
    if isBoxStruct(lt.ty) && !isBoxStruct(ty) { return ins(g, "b", "load ptr, ptr ".then(slot(l))); };
    if lt.ty is Type::TRef || lt.ty is Type::TMutRef { return ins(g, "b", "load ptr, ptr ".then(slot(l))); };
    return giving(g, slot(l));
};

// Whether an operand is an array
fn isArrayOperand(f: &Function, o: &Operand) -> Bool [{ }] [{ }] {
    if o is Operand::Const { return (o as Operand::Const).value is Constant::CArray; };
    lt = operandLocalType(f, o);
    if !lt.ok { return false; };
    if isArray(lt.ty) || isListStruct(lt.ty) { return true; };
    if lt.ty is Type::TRef { return isListStruct(clone(Box::unbox(clone((lt.ty as Type::TRef).inner)))); };
    if lt.ty is Type::TMutRef { return isListStruct(clone(Box::unbox(clone((lt.ty as Type::TMutRef).inner)))); };
    return false;
};

// The address of the words of an array operand: a local, or a constant that is a global; in `last`
fn arrayPtr(g: Gen, f: &Function, o: &Operand) -> Gen ~ {
    if o is Operand::Const {
        c = (o as Operand::Const).value;
        if c is Constant::CArray { return constantWords(g, (c as Constant::CArray).items); };
        return failG(g, "Not an array");
    };
    lt = operandLocalType(f, o);
    l = 0;
    if o is Operand::Copy { l = (o as Operand::Copy).local; };
    if o is Operand::Move { l = (o as Operand::Move).local; };
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
    // (a list of native code holds the address of the elements in its first word)
    if isListStruct(lt.ty) { return ins(g, "a", "load ptr, ptr ".then(slot(l))); };
    if lt.ty is Type::TRef || lt.ty is Type::TMutRef {
        g1 = ins(g, "a", "load ptr, ptr ".then(slot(l)));
        at = clone(g1.last);
        inner = Type::TInt;
        if lt.ty is Type::TRef { inner = clone(Box::unbox(clone((lt.ty as Type::TRef).inner))); };
        if lt.ty is Type::TMutRef { inner = clone(Box::unbox(clone((lt.ty as Type::TMutRef).inner))); };
        if isListStruct(inner) { return ins(g1, "a", "load ptr, ptr ".then(at)); };
        return g1;
    };
    return giving(g, slot(l));
};

// What an element of a list or an array is, ready to be written: the word, or for a value held inline the address of its words
fn elementValue(g: Gen, cx: &Ctx, f: &Function, elementTy: &Type, o: &Operand) -> Gen ~ {
    if isAggregate(elementTy) { return operandAddress(g, cx, f, elementTy, o); };
    return operandValue(g, cx, f, elementTy, o);
};

// Frees what an element owns, before another is written over it
fn dropElement(g: Gen, cx: &Ctx, elementTy: &Type, base: &String, index: &String) -> Gen ~ {
    if !needsDropIn(cx, elementTy) { return g; };
    if !(elementTy is Type::TNamed || elementTy is Type::TVariant || sizedArray(elementTy).ok) { return g; };
    bytes = bytesIn(cx, elementTy);
    g1 = elementAddress(g, base, index, bytes);
    p = clone(g1.last);
    g2 = descriptor(g1, cx, elementTy);
    return emit(g2, "call void ".then(dropSymbol(&cx.types, elementTy)).then("(ptr ").then(p).then(")"));
};

fn writeElement(g: Gen, cx: &Ctx, elementTy: &Type, base: &String, index: &String, value: &String) -> Gen ~ {
    bytes = bytesIn(cx, elementTy);
    g1 = elementAddress(g, base, index, bytes);
    p = clone(g1.last);
    if isAggregate(elementTy) { return copyWords(g1, p, value, bytes); };
    return storeAt(g1, elementTy, p, value);
};

// The number of elements of an array operand, as text in `last`: a constant when the size is in the type, and what a Box of an array of no size carries otherwise
fn arrayLength(g: Gen, f: &Function, o: &Operand) -> Gen ~ {
    if o is Operand::Const {
        c = (o as Operand::Const).value;
        if c is Constant::CArray { return giving(g, showInt(size((c as Constant::CArray).items))); };
        return failG(g, "Not an array");
    };
    lt = operandLocalType(f, o);
    l = 0;
    if o is Operand::Copy { l = (o as Operand::Copy).local; };
    if o is Operand::Move { l = (o as Operand::Move).local; };
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
    arr = sizedArray(lt.ty);
    if arr.ok { return giving(g, showInt(arr.length)); };
    return failG(g, "Not an array: Local ".then(showInt(l)));
};

// The text of the index of the last element, given the text of the length
fn lastIndex(g: Gen, count: &String) -> Gen [{ }] [{ }] {
    n = parseInt(count);
    if n.ok { return giving(g, showInt(n.value - 1)); };
    return ins(g, "i", "sub i64 ".then(count).then(", 1"));
};

// Goes to the overflow block when the flag is set, and carries on in a new block otherwise
fn stopOn(g: Gen, flag: &String) -> Gen [{ }] [{ }] {
    g1 = freshLabel(g, "ok");
    next = clone(g1.last);
    g2 = emit(g1, "br i1 ".then(flag).then(", label %overflow, label %").then(next));
    return label(g2, next);
};

// Arithmetic that stops the program when the result does not fit in an Int; the value is in `last`
fn checked(g: Gen, name: &String, x: &String, y: &String) -> Gen [{ }] [{ }] {
    g1 = ins(g, "o", "call {i64, i1} @llvm.".then(name).then(".with.overflow.i64(i64 ").then(x).then(", i64 ").then(y).then(")"));
    result = clone(g1.last);
    g2 = ins(g1, "r", "extractvalue {i64, i1} ".then(result).then(", 0"));
    value = clone(g2.last);
    g3 = ins(g2, "f", "extractvalue {i64, i1} ".then(result).then(", 1"));
    overflowed = clone(g3.last);
    return giving(stopOn(g3, overflowed), value);
};

// Whether a remainder and the divisor have opposite signs and the remainder is not 0, which is when truncating and rounding down differ
fn roundsTheOtherWay(g: Gen, r: &String, divisor: &String) -> Gen [{ }] [{ }] {
    g1 = ins(g, "c", "icmp ne i64 ".then(r).then(", 0"));
    nonZero = clone(g1.last);
    g2 = ins(g1, "x", "xor i64 ".then(r).then(", ").then(divisor));
    signs = clone(g2.last);
    g3 = ins(g2, "c", "icmp slt i64 ".then(signs).then(", 0"));
    differ = clone(g3.last);
    return ins(g3, "c", "and i1 ".then(nonZero).then(", ").then(differ));
};

// The comparison of a relation: 5 eq, 6 noteq, 7 lt, 8 lteq, 9 gt, 10 gteq
fn predicate(op: Int) -> String [{ }] [{ }] {
    if op = 5 { return "eq"; };
    if op = 6 { return "ne"; };
    if op = 7 { return "slt"; };
    if op = 9 { return "sgt"; };
    if op = 8 { return "sle"; };
    return "sge";
};

fn intMin() -> String [{ }] [{ }] {
    return showInt(0 - 9223372036854775807 - 1);
};

// A value as the word the runtime takes: an Int as it is, a Bool as 0 or 1, a Box as its address; in `last`
fn toWord(g: Gen, t: &Type, value: &String) -> Gen [{ }] [{ }] {
    if isNumberWord(t) { return giving(g, value); };
    if t is Type::TBool { return ins(g, "w", "zext i1 ".then(value).then(" to i64")); };
    return ins(g, "w", "ptrtoint ptr ".then(value).then(" to i64"));
};

// The binary operations: 0 add, 1 sub, 2 mul, 3 div, 4 mod, and the relations; the value is in `last`
fn binary(g: Gen, cx: &Ctx, op: Int, ty: &Type, x: &String, y: &String) -> Gen ~ {
    if op = 0 { return checked(g, "sadd", x, y); };
    if op = 1 { return checked(g, "ssub", x, y); };
    if op = 2 { return checked(g, "smul", x, y); };
    if op = 3 {
        // the one quotient that does not fit, which sdiv does not define
        g1 = ins(g, "c", "icmp eq i64 ".then(x).then(", ").then(intMin()));
        isMin = clone(g1.last);
        g2 = ins(g1, "c", "icmp eq i64 ".then(y).then(", -1"));
        isMinusOne = clone(g2.last);
        g3 = ins(g2, "c", "and i1 ".then(isMin).then(", ").then(isMinusOne));
        overflows = clone(g3.last);
        g4 = stopOn(g3, overflows);
        // sdiv rounds toward 0 and `/` rounds down
        g5 = ins(g4, "q", "sdiv i64 ".then(x).then(", ").then(y));
        q = clone(g5.last);
        g6 = ins(g5, "r", "srem i64 ".then(x).then(", ").then(y));
        r = clone(g6.last);
        g7 = roundsTheOtherWay(g6, r, y);
        adjust = clone(g7.last);
        g8 = ins(g7, "q", "sub i64 ".then(q).then(", 1"));
        lower = clone(g8.last);
        return ins(g8, "q", "select i1 ".then(adjust).then(", i64 ").then(lower).then(", i64 ").then(q));
    };
    if op = 4 {
        // x % -1 is 0, and srem does not define it for the smallest Int
        g1 = ins(g, "c", "icmp eq i64 ".then(y).then(", -1"));
        isMinusOne = clone(g1.last);
        g2 = ins(g1, "d", "select i1 ".then(isMinusOne).then(", i64 1, i64 ").then(y));
        divisor = clone(g2.last);
        g3 = ins(g2, "r", "srem i64 ".then(x).then(", ").then(divisor));
        r = clone(g3.last);
        // srem takes the sign of the dividend and `%` the sign of the divisor
        g4 = roundsTheOtherWay(g3, r, y);
        adjust = clone(g4.last);
        g5 = ins(g4, "r", "add i64 ".then(r).then(", ").then(y));
        shifted = clone(g5.last);
        return ins(g5, "r", "select i1 ".then(adjust).then(", i64 ").then(shifted).then(", i64 ").then(r));
    };
    g1 = typeText(g, ty);
    t = clone(g1.last);
    return ins(g1, "c", "icmp ".then(predicate(op)).then(" ").then(t).then(" ").then(x).then(", ").then(y));
};

// An element of an array that is a word, or its length
fn arrayRead(g: Gen, cx: &Ctx, f: &Function, destType: &Type, op: Int, os: &List<Operand>) -> Gen ~ {
    n = size(os);
    // 0 length, 1 first, 2 last, 3 get, 6 set
    if op = 0 && n = 1 { return arrayLength(g, f, get(os, 0)); };
    if op = 1 && n = 1 {
        g1 = arrayPtr(g, f, get(os, 0));
        base = clone(g1.last);
        return loadAt(g1, destType, base);
    };
    if op = 2 && n = 1 {
        g1 = arrayLength(g, f, get(os, 0));
        length = clone(g1.last);
        g2 = lastIndex(g1, length);
        index = clone(g2.last);
        g3 = arrayPtr(g2, f, get(os, 0));
        base = clone(g3.last);
        g4 = elementAddress(g3, base, index, bytesIn(cx, destType));
        p = clone(g4.last);
        return loadAt(g4, destType, p);
    };
    if op = 3 && n = 2 {
        g1 = arrayPtr(g, f, get(os, 0));
        base = clone(g1.last);
        g2 = operandValue(g1, cx, f, Type::TInt, get(os, 1));
        index = clone(g2.last);
        g3 = elementAddress(g2, base, index, bytesIn(cx, destType));
        p = clone(g3.last);
        return loadAt(g3, destType, p);
    };
    return failG(g, "Native code does not support this operation for an array yet");
};

// What the memory an address operand is the address of holds
fn addressElement(f: &Function, o: &Operand) -> LT [{ }] [{ }] {
    lt = operandLocalType(f, o);
    if lt.ok && lt.ty is Type::TAddr { return LT { ok: true, ty: clone(Box::unbox((lt.ty as Type::TAddr).inner)) }; };
    return LT { ok: false, ty: Type::TInt };
};

// The address of the slot i of the memory at p, as a number in `last`
fn slotNumber(g: Gen, cx: &Ctx, f: &Function, p: &Operand, i: &Operand) -> Gen ~ {
    e = addressElement(f, p);
    if !e.ok { return failG(g, "Not an address"); };
    bytes = bytesIn(cx, e.ty);
    g1 = operandValue(g, cx, f, Type::TInt, p);
    a = clone(g1.last);
    g2 = operandValue(g1, cx, f, Type::TInt, i);
    x = clone(g2.last);
    g3 = ins(g2, "o", "mul i64 ".then(x).then(", ").then(showInt(bytes)));
    o = clone(g3.last);
    return ins(g3, "a", "add i64 ".then(a).then(", ").then(o));
};

// The same as a pointer
fn slotAddress(g: Gen, cx: &Ctx, f: &Function, p: &Operand, i: &Operand) -> Gen ~ {
    g1 = slotNumber(g, cx, f, p, i);
    n = clone(g1.last);
    return ins(g1, "p", "inttoptr i64 ".then(n).then(" to ptr"));
};

// The operations on addresses (POINTERS.md), whose permissions are erased: an address is an i64, the memory of an allocation is slots of the bytes of a
// value of the type one after another, and a value is in a slot as it is in an element of an array. The runtime allocates, resizes and frees.
fn addressOp(g: Gen, cx: &Ctx, f: &Function, destType: &Type, op: Int, args: &List<Operand>) -> Gen ~ {
    n = size(args);
    // 22 addrNull, 23 addrOffset, 24 addrCast, 25 addrToInt, 26 addrFromInt, 27 addrAlloc, 28 addrGet, 29 addrWrite, 30 addrTake, 31 addrDropValue, 32 addrDropRange,
    // 33 addrResize, 34 addrFree
    if op = 54 && n = 3 {
        if !(destType is Type::TRef) { return failG(g, "Addr borrowing gives a read reference"); };
        return slotAddress(g, cx, f, get(args, 0), get(args, 1));
    };
    if op = 22 && n = 0 { return giving(g, "0"); };
    if op = 23 && n = 2 { return slotNumber(g, cx, f, get(args, 0), get(args, 1)); };
    if (op = 24 || op = 25 || op = 26) && n = 1 { return operandValue(g, cx, f, Type::TInt, get(args, 0)); };
    if op = 27 && n = 1 {
        if !(destType is Type::TAddr) { return failG(g, "Addr::alloc gives an address"); };
        bytes = bytesIn(cx, Box::unbox((destType as Type::TAddr).inner));
        g1 = operandValue(g, cx, f, Type::TInt, get(args, 0));
        x = clone(g1.last);
        return ins(g1, "m", "call i64 @tersus_addr_alloc(i64 ".then(x).then(", i64 ").then(showInt(bytes)).then(")"));
    };
    if op = 33 && n = 2 {
        e = addressElement(f, get(args, 0));
        if !e.ok { return failG(g, "Not an address"); };
        bytes = bytesIn(cx, e.ty);
        g1 = operandValue(g, cx, f, Type::TInt, get(args, 0));
        a = clone(g1.last);
        g2 = operandValue(g1, cx, f, Type::TInt, get(args, 1));
        x = clone(g2.last);
        return ins(g2, "m", "call i64 @tersus_addr_resize(i64 ".then(a).then(", i64 ").then(x).then(", i64 ").then(showInt(bytes)).then(")"));
    };
    if op = 34 && n = 1 {
        g1 = operandValue(g, cx, f, Type::TInt, get(args, 0));
        a = clone(g1.last);
        return giving(emit(g1, "call void @tersus_addr_free(i64 ".then(a).then(")")), "0");
    };
    if (op = 28 || op = 30) && n = 2 {
        g1 = slotAddress(g, cx, f, get(args, 0), get(args, 1));
        p = clone(g1.last);
        return loadAt(g1, destType, p);
    };
    if op = 29 && n = 3 {
        e = addressElement(f, get(args, 0));
        if !e.ok { return failG(g, "Not an address"); };
        g1 = slotAddress(g, cx, f, get(args, 0), get(args, 1));
        at = clone(g1.last);
        g2 = elementValue(g1, cx, f, e.ty, get(args, 2));
        value = clone(g2.last);
        bytes = bytesIn(cx, e.ty);
        if isAggregate(e.ty) { return giving(copyWords(g2, at, value, bytes), "0"); };
        return giving(storeAt(g2, e.ty, at, value), "0");
    };
    if op = 31 && n = 2 {
        e = addressElement(f, get(args, 0));
        if !e.ok { return failG(g, "Not an address"); };
        if !needsDropIn(cx, e.ty) { return giving(g, "0"); };
        if !(e.ty is Type::TNamed || e.ty is Type::TVariant || sizedArray(e.ty).ok) { return giving(g, "0"); };
        g1 = slotAddress(g, cx, f, get(args, 0), get(args, 1));
        at = clone(g1.last);
        g2 = descriptor(g1, cx, e.ty);
        return giving(emit(g2, "call void ".then(dropSymbol(&cx.types, e.ty)).then("(ptr ").then(at).then(")")), "0");
    };
    if op = 32 && n = 3 {
        e = addressElement(f, get(args, 0));
        if !e.ok { return failG(g, "Not an address"); };
        if !needsDropIn(cx, e.ty) { return giving(g, "0"); };
        if !(e.ty is Type::TNamed || e.ty is Type::TVariant || sizedArray(e.ty).ok) { return giving(g, "0"); };
        g1 = slotNumber(g, cx, f, get(args, 0), get(args, 1));
        at = clone(g1.last);
        g2 = operandValue(g1, cx, f, Type::TInt, get(args, 2));
        count = clone(g2.last);
        g3 = descriptor(g2, cx, e.ty);
        return giving(emit(g3, "call void ".then(dropRangeSymbol(&cx.types, e.ty)).then("(i64 ").then(at).then(", i64 ").then(count).then(")")), "0");
    };
    return failG(g, "Native code does not support this operation on an address");
};

// The value of an rvalue that is a word, in `last`
// The address of the place a borrow is of, in `last`: the root local's own room, then each step to the place. A root or a value
// held inline is its room; what a list or a Box holds is at the address that is its first word, which an index step starts from.
// What a reference is to, or the type itself if it is not a reference
fn refTargetOf(t: &Type) -> Type ~ {
    if t is Type::TRef { return clone(Box::unbox(clone((t as Type::TRef).inner))); };
    if t is Type::TMutRef { return clone(Box::unbox(clone((t as Type::TMutRef).inner))); };
    return clone(t);
};

fn assignRefType(cx: &Ctx, f: &Function, root: Int, steps: &List<RefStep>) -> Type ~ {
    lt = localTypeOf(f, root);
    if !lt.ok { return Type::TInt; };
    ty = refTargetOf(lt.ty);
    i = 0;
    while i < size(steps) [{ affirm i >= 0; affirm i <= size(steps); }] ~ {
        ty = refTargetOf(ty);
        step = get(steps, i);
        if step is RefStep::Field {
            ctorName = (step as RefStep::Field).ctor;
            fieldName = (step as RefStep::Field).field;
            k = 0;
            while k < size(cx.ctors) [{ affirm k >= 0; affirm k <= size(cx.ctors); }] ~ {
                ctor = get(cx.ctors, k);
                if ctor.name = ctorName {
                    j = fieldIndex(ctor.fields, fieldName);
                    if j >= 0 { ty = clone(get(ctor.fields, j).ty); };
                };
                k = k + 1;
            };
        };
        if step is RefStep::Index {
            elem = Held { ok: false, ty: Type::TInt };
            if isListStruct(ty) { elem = listElement(cx, ty); };
            if isBoxStruct(ty) { elem = listElement(cx, ty); };
            arr = sizedArray(ty);
            if arr.ok { elem = Held { ok: true, ty: clone(arr.elem) }; };
            if elem.ok { ty = clone(elem.ty); };
        };
        i = i + 1;
    };
    return ty;
};

fn placeAddress(g: Gen, cx: &Ctx, f: &Function, root: Int, steps: &List<RefStep>) -> Gen ~ {
    lt = localTypeOf(f, root);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(root))); };
    g1 = g;
    at = slot(root);
    ty = clone(lt.ty);
    // (the root may itself be a reference: a reborrow is to what the reference is to)
    if ty is Type::TRef || ty is Type::TMutRef {
        g1 = ins(g1, "p", "load ptr, ptr ".then(at));
        at = clone(g1.last);
        ty = refTargetOf(lt.ty);
    };
    i = 0;
    while i < size(steps) [{ affirm i >= 0; affirm i <= size(steps); }] ~ {
        // (a step may start from a reference met on the way, which is followed the same way)
        if ty is Type::TRef || ty is Type::TMutRef {
            g1 = ins(g1, "p", "load ptr, ptr ".then(at));
            at = clone(g1.last);
            ty = refTargetOf(ty);
        };
        step = get(steps, i);
        if step is RefStep::Field {
            ctorName = (step as RefStep::Field).ctor;
            fieldName = (step as RefStep::Field).field;
            k = constructorG(g1, cx, ctorName);
            if size(k.g.error.bytes) > 0 { return k.g; };
            ctor = ctorAt(cx, k.i);
            j = fieldIndex(ctor.fields, fieldName);
            if j < 0 { return failG(k.g, "Variant ".then(ctorName).then(" has no field ").then(fieldName)); };
            g1 = ins(k.g, "p", "getelementptr i8, ptr ".then(at).then(", i64 ").then(showInt(fieldOffset(cx, ctor, j))));
            at = clone(g1.last);
            ty = clone(get(ctor.fields, j).ty);
        };
        if step is RefStep::Index {
            o = (step as RefStep::Index).o;
            elem = Held { ok: false, ty: Type::TInt };
            if isListStruct(ty) { elem = listElement(cx, ty); };
            if isBoxStruct(ty) { elem = listElement(cx, ty); };
            arr = sizedArray(ty);
            if arr.ok { elem = Held { ok: true, ty: clone(arr.elem) }; };
            if !elem.ok { return failG(g1, "A reference to an element of this is not made by native code"); };
            g1 = operandValue(g1, cx, f, Type::TInt, o);
            index = clone(g1.last);
            base = clone(at);
            if isListStruct(ty) || isBoxStruct(ty) {
                g1 = ins(g1, "a", "load ptr, ptr ".then(at));
                base = clone(g1.last);
            };
            g1 = elementAddress(g1, base, index, bytesIn(cx, elem.ty));
            at = clone(g1.last);
            ty = clone(elem.ty);
        };
        i = i + 1;
    };
    return giving(g1, at);
};

fn operandPointer(g: Gen, cx: &Ctx, f: &Function, o: &Operand) -> Gen ~ {
    l = 0;
    isLocal = false;
    if o is Operand::Copy { l = (o as Operand::Copy).local; isLocal = true; };
    if o is Operand::Move { l = (o as Operand::Move).local; isLocal = true; };
    if !isLocal { return operandValue(g, cx, f, Type::TInt, o); };
    lt = localTypeOf(f, l);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
    if lt.ty is Type::TRef || lt.ty is Type::TMutRef { return operandValue(g, cx, f, lt.ty, o); };
    return giving(g, slot(l));
};

fn rvalue(g: Gen, cx: &Ctx, f: &Function, destType: &Type, rv: &Rvalue) -> Gen ~ {
    if rv is Rvalue::Use { return operandValue(g, cx, f, destType, (rv as Rvalue::Use).o); };
    if rv is Rvalue::Borrow { return placeAddress(g, cx, f, (rv as Rvalue::Borrow).root, (rv as Rvalue::Borrow).steps); };
    if rv is Rvalue::Deref {
        o = (rv as Rvalue::Deref).o;
        g1 = operandPointer(g, cx, f, o);
        at = clone(g1.last);
        return loadAt(g1, destType, at);
    };
    // (native code has no Box: a Box is made into a struct of lib/box.tersus or lib/lists.tersus first, see MirLists)
    if rv is Rvalue::MakeBox || rv is Rvalue::Unbox { return failG(g, "Native code has no Box: a Box is made into the struct of lib/box.tersus first (see MirLists)"); };
    if rv is Rvalue::BinaryOp {
        op = (rv as Rvalue::BinaryOp).op;
        a = (rv as Rvalue::BinaryOp).a;
        b = (rv as Rvalue::BinaryOp).b;
        operands = push(push([], clone(a)), clone(b));
        ty = sharedType(cx, f, operands);
        g1 = operandValue(g, cx, f, ty, a);
        x = clone(g1.last);
        g2 = operandValue(g1, cx, f, ty, b);
        y = clone(g2.last);
        return binary(g2, cx, op, ty, x, y);
    };
    if rv is Rvalue::MakeList { return failG(g, "Native code has no list: a list is made into the struct of lib/lists.tersus first (see MirLists)"); };
    if rv is Rvalue::ListOp {
        op = (rv as Rvalue::ListOp).op;
        args = (rv as Rvalue::ListOp).args;
        n = size(args);
        // 10 writeByte, 11 writeError, 12 readByte, 13 argCount, 14 argByte, 15 pathByte, 16 fileLoad, 17 fileByte, 18 storeByte, 19 fileStore, 20 toByte, 21 fromByte,
        // 22 to 34 the operations on addresses
        if (op >= 22 && op <= 34) || op = 54 { return addressOp(g, cx, f, destType, op, args); };
        // 35 uninitEmpty, 36 uninitNew, 37 uninitGet, 38 uninitTake, 39 uninitDiscard: an Uninit<T> is a T (an empty one is a T that is 0)
        if op = 35 && n = 0 {
            g1 = typeText(g, destType);
            t = clone(g1.last);
            return giving(g1, zeroOf(t));
        };
        if (op = 36 || op = 37 || op = 38) && n = 1 { return operandValue(g, cx, f, destType, get(args, 0)); };
        if op = 39 && n = 1 { return giving(g, "0"); };
        // 40 to 44 an Int as a fixed-width integer: the same number in a register
        if op >= 40 && op <= 44 && n = 1 { return operandValue(g, cx, f, Type::TInt, get(args, 0)); };
        if op = 12 && n = 0 { return ins(g, "r", "call i64 @tersus_readByte()"); };
        if op = 16 && n = 0 { return ins(g, "l", "call i64 @tersus_fileLoad()"); };
        if op = 19 && n = 0 { return ins(g, "t", "call i64 @tersus_fileStore()"); };
        if op = 13 && n = 0 { return ins(g, "n", "call i64 @tersus_argCount()"); };
        if n = 1 {
            a = get(args, 0);
            if op = 15 || op = 18 || op = 11 || op = 10 || op = 21 {
                g1 = operandValue(g, cx, f, Type::TByte, a);
                if op = 21 { return g1; };
                x = clone(g1.last);
                callText = "call i64 @tersus_pathByte(i64 ";
                base = "p";
                if op = 18 { callText = "call i64 @tersus_storeByte(i64 "; base = "s"; };
                if op = 11 { callText = "call i64 @tersus_writeError(i64 "; base = "e"; };
                if op = 10 { callText = "call i64 @tersus_writeByte(i64 "; base = "w"; };
                return ins(g1, base, callText.then(x).then(")"));
            };
            if op = 17 {
                g1 = operandValue(g, cx, f, Type::TInt, a);
                x = clone(g1.last);
                return ins(g1, "f", "call i64 @tersus_fileByte(i64 ".then(x).then(")"));
            };
            if op = 20 { return operandValue(g, cx, f, Type::TInt, a); };
        };
        if op = 14 && n = 2 {
            g1 = operandValue(g, cx, f, Type::TInt, get(args, 0));
            x = clone(g1.last);
            g2 = operandValue(g1, cx, f, Type::TInt, get(args, 1));
            y = clone(g2.last);
            return ins(g2, "a", "call i64 @tersus_argByte(i64 ".then(x).then(", i64 ").then(y).then(")"));
        };
        if n > 0 && isArrayOperand(f, get(args, 0)) { return arrayRead(g, cx, f, destType, op, args); };
        return failG(g, "Native code does not support this operation here");
    };
    if rv is Rvalue::ReadField {
        name = (rv as Rvalue::ReadField).name;
        field = (rv as Rvalue::ReadField).field;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        i = fieldIndex(ctor.fields, field);
        if i < 0 { return failG(k.g, "Variant ".then(name).then(" has no field ").then(field)); };
        g1 = dataBase(k.g, cx, f, constructedType(cx, name), (rv as Rvalue::ReadField).o);
        base = clone(g1.last);
        return loadSlot(g1, get(ctor.fields, i).ty, base, fieldOffset(cx, ctor, i));
    };
    if rv is Rvalue::IsVariant {
        name = (rv as Rvalue::IsVariant).name;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        // (a struct has no tag, and a value of its type is that struct)
        if !ctor.tagged { return giving(k.g, "true"); };
        g1 = dataBase(k.g, cx, f, constructedType(cx, name), (rv as Rvalue::IsVariant).o);
        base = clone(g1.last);
        g2 = ins(g1, "t", "load i32, ptr ".then(base));
        found = clone(g2.last);
        return ins(g2, "c", "icmp eq i32 ".then(found).then(", ").then(showInt(ctor.tag)));
    };
    // the field is moved out of the value: what it held is left holding nothing
    if rv is Rvalue::TakeField {
        name = (rv as Rvalue::TakeField).name;
        field = (rv as Rvalue::TakeField).field;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        i = fieldIndex(ctor.fields, field);
        if i < 0 { return failG(k.g, "Variant ".then(name).then(" has no field ").then(field)); };
        g1 = dataBase(k.g, cx, f, constructedType(cx, name), Operand::Copy { local: (rv as Rvalue::TakeField).local });
        base = clone(g1.last);
        offset = fieldOffset(cx, ctor, i);
        g2 = loadSlot(g1, get(ctor.fields, i).ty, base, offset);
        taken = clone(g2.last);
        g3 = ins(g2, "p", "getelementptr i8, ptr ".then(base).then(", i64 ").then(showInt(offset)));
        p = clone(g3.last);
        return giving(emit(g3, "store i64 0, ptr ".then(p)), taken);
    };
    return failG(g, "Native code makes this where it is held inline, not as a word");
};

// n copies of an element: one store of zeros when it is a zero, and a loop otherwise. `count` is the text of the number, known to be `n` when `isKnown`.
fn fillElements(g: Gen, cx: &Ctx, f: &Function, target: &String, elementTy: &Type, count: &String, isKnown: Bool, n: Int, x: &Operand) -> Gen ~ {
    if isKnown && n = 0 { return g; };
    isZero = false;
    if x is Operand::Const {
        c = (x as Operand::Const).value;
        if c is Constant::CInt { isZero = (c as Constant::CInt).n = 0; };
        if c is Constant::CBool { isZero = !(c as Constant::CBool).b; };
    };
    if isZero && !isAggregate(elementTy) {
        g1 = g;
        bytes = "";
        size1 = bytesIn(cx, elementTy);
        if isKnown {
            bytes = showInt(size1 * n);
        } else {
            g1 = ins(g1, "z", "mul i64 ".then(count).then(", ").then(showInt(size1)));
            bytes = clone(g1.last);
        };
        return emit(g1, "call void @llvm.memset.p0.i64(ptr ".then(target).then(", i8 0, i64 ").then(bytes).then(", i1 false)"));
    };
    // an element that owns something is not the same words n times: each is a copy of the one that is given, which stays its own
    owning = needsDropIn(cx, elementTy);
    g1 = g;
    value = "";
    if !owning {
        g1 = elementValue(g1, cx, f, elementTy, x);
        value = clone(g1.last);
    };
    source = "";
    if owning {
        if x is Operand::Copy { source = slot((x as Operand::Copy).local); };
        if x is Operand::Move { source = slot((x as Operand::Move).local); };
        if x is Operand::Const { return failG(g1, "An element that owns something is made from a constant"); };
    };
    bytes = bytesIn(cx, elementTy);
    g2 = freshLabel(g1, "fill");
    k = clone(g2.last);
    before = clone(k).then(".before");
    header = clone(k).then(".header");
    body = clone(k).then(".body");
    finish = clone(k).then(".done");
    i = "%".then(k).then(".i");
    next = "%".then(k).then(".next");
    g3 = emit(g2, "br label %".then(before));
    g4 = label(g3, before);
    g5 = emit(g4, "br label %".then(header));
    g6 = label(g5, header);
    g7 = emit(g6, clone(i).then(" = phi i64 [ 0, %").then(before).then(" ], [ ").then(next).then(", %").then(body).then(" ]"));
    g8 = ins(g7, "c", "icmp slt i64 ".then(i).then(", ").then(count));
    c = clone(g8.last);
    g9 = emit(g8, "br i1 ".then(c).then(", label %").then(body).then(", label %").then(finish));
    g10 = label(g9, body);
    g11 = g10;
    if owning {
        g11 = elementAddress(g11, target, i, bytes);
        p = clone(g11.last);
        g11 = cloneValue(g11, cx, f.name, elementTy, p, source);
    } else {
        g11 = writeElement(g11, cx, elementTy, target, i, value);
    };
    g12 = emit(g11, next.then(" = add i64 ").then(i).then(", 1"));
    g13 = emit(g12, "br label %".then(header));
    return label(g13, finish);
};

// Copies a value that is part of another into the destination (when the destination owns something, through room of its own first, since the part can be a part of what the
// destination held); the part is cleared when it is moved out
fn fromPart(g: Gen, cx: &Ctx, dropsOld: Bool, ty: &Type, dest: Int, address: &String, clear: Bool) -> Gen ~ {
    bytes = bytesIn(cx, ty);
    owns = ownsIn(cx, ty);
    target = slot(dest);
    if dropsOld && owns {
        g1 = entryTemp(g, (bytes + 7) / 8);
        room = clone(g1.last);
        g2 = copyWords(g1, room, address, bytes);
        g3 = g2;
        if clear { g3 = zeroWords(g3, address, bytes); };
        g4 = dropSlot(g3, cx, ty, dest);
        return copyWords(g4, target, room, bytes);
    };
    g1 = copyWords(g, target, address, bytes);
    if clear { return zeroWords(g1, address, bytes); };
    return g1;
};

// Frees what the destination held, if it owns something (unless it only looks at a value, as a Peek does)
fn freeOld(g: Gen, cx: &Ctx, dropsOld: Bool, ty: &Type, dest: Int) -> Gen ~ {
    if dropsOld && ownsIn(cx, ty) { return dropSlot(g, cx, ty, dest); };
    return g;
};

// The address of the element at an index of an array (or of a list of native code, whose address is that of its array), the element being the value that is made
fn elementOf(g: Gen, cx: &Ctx, f: &Function, ty: &Type, container: &Operand, index: &String) -> Gen ~ {
    g1 = arrayPtr(g, f, container);
    base = clone(g1.last);
    return elementAddress(g1, base, index, bytesIn(cx, ty));
};

// The statement that gives a value held inline to a local, made where the local is, with no pointer to it. What the local
// held is dropped by the statements of the MIR before it (MirOwnership), never here. The contracts (an index in range) are assumed.
fn assignAggregate(g: Gen, cx: &Ctx, f: &Function, dropsOld: Bool, dest: Int, ty: &Type, rv: &Rvalue) -> Gen ~ {
    bytes = bytesIn(cx, ty);
    owns = ownsIn(cx, ty);
    target = slot(dest);
    if rv is Rvalue::Use {
        g1 = operandAddress(g, cx, f, ty, (rv as Rvalue::Use).o);
        src = clone(g1.last);
        return fromPart(g1, cx, dropsOld, ty, dest, src, false);
    };
    if rv is Rvalue::Deref {
        g1 = operandPointer(g, cx, f, (rv as Rvalue::Deref).o);
        src = clone(g1.last);
        return fromPart(g1, cx, dropsOld, ty, dest, src, false);
    };
    if rv is Rvalue::ListOp {
        op = (rv as Rvalue::ListOp).op;
        args = (rv as Rvalue::ListOp).args;
        n = size(args);
        arr = sizedArray(ty);
        // 7 newArray, 8 newBoxed, 9 newEmptyBoxed, 6 set, 3 get, 1 first, 2 last, 28 addrGet, 30 addrTake
        // (an Uninit of a value held inline: an empty one is the words cleared, and the others the value as it is)
        if op = 35 && n = 0 {
            g1 = freeOld(g, cx, dropsOld, ty, dest);
            return zeroWords(g1, target, bytes);
        };
        if (op = 36 || op = 37 || op = 38) && n = 1 {
            g1 = operandAddress(g, cx, f, ty, get(args, 0));
            src = clone(g1.last);
            return fromPart(g1, cx, dropsOld, ty, dest, src, false);
        };
        // (the value held inline in a slot of memory, which is read or taken: the slot is empty after, which only the permission says)
        if (op = 28 || op = 30) && n = 2 {
            g1 = slotAddress(g, cx, f, get(args, 0), get(args, 1));
            at = clone(g1.last);
            return fromPart(g1, cx, dropsOld, ty, dest, at, false);
        };
        // Array::fromList: the elements of the list move into the array, and only the buffer of the list is freed
        if op = 45 && n = 1 && ty is Type::TArray && get(args, 0) is Operand::Move {
            o = get(args, 0);
            l = (o as Operand::Move).local;
            elem = clone(Box::unbox((ty as Type::TArray).elem));
            elemBytes = bytesIn(cx, elem);
            g1 = ins(g, "m", "load i64, ptr ".then(slot(l)));
            m = clone(g1.last);
            g2 = ins(g1, "q", "getelementptr i8, ptr ".then(slot(l)).then(", i64 8"));
            countAddress = clone(g2.last);
            g3 = ins(g2, "c", "load i64, ptr ".then(countAddress));
            count = clone(g3.last);
            g4 = ins(g3, "p", "inttoptr i64 ".then(m).then(" to ptr"));
            p = clone(g4.last);
            g5 = ins(g4, "b", "mul i64 ".then(count).then(", ").then(showInt(elemBytes)));
            total = clone(g5.last);
            g6 = zeroWords(g5, slot(l), 24);
            g7 = freeOld(g6, cx, dropsOld, ty, dest);
            g8 = emit(g7, "call void @llvm.memcpy.p0.p0.i64(ptr ".then(target).then(", ptr ").then(p).then(", i64 ").then(total).then(", i1 false)"));
            return emit(g8, "call void @tersus_addr_free(i64 ".then(m).then(")"));
        };
        if op = 7 && n = 2 && arr.ok {
            // (an array that owns something is made in room of its own, then what the destination held is freed and the elements move in)
            if dropsOld && owns {
                g1 = entryTemp(g, (bytes + 7) / 8);
                room = clone(g1.last);
                g2 = fillElements(g1, cx, f, room, arr.elem, showInt(arr.length), true, arr.length, get(args, 1));
                g3 = freeOld(g2, cx, dropsOld, ty, dest);
                return copyWords(g3, target, room, bytes);
            };
            return fillElements(g, cx, f, target, arr.elem, showInt(arr.length), true, arr.length, get(args, 1));
        };
        if op = 6 && n = 3 && arr.ok {
            // (an array that owns something is moved to room of its own first, and what the destination held is freed)
            g1 = operandAddress(g, cx, f, ty, get(args, 0));
            src = clone(g1.last);
            g2 = operandValue(g1, cx, f, Type::TInt, get(args, 1));
            index = clone(g2.last);
            g3 = elementValue(g2, cx, f, arr.elem, get(args, 2));
            value = clone(g3.last);
            g4 = freeOld(g3, cx, dropsOld, ty, dest);
            g5 = copyWords(g4, target, src, bytes);
            g6 = dropElement(g5, cx, arr.elem, target, index);
            return writeElement(g6, cx, arr.elem, target, index, value);
        };
        // an element that is a value held inline, of an array or of a list
        if op = 3 && n = 2 {
            g1 = operandValue(g, cx, f, Type::TInt, get(args, 1));
            index = clone(g1.last);
            g2 = elementOf(g1, cx, f, ty, get(args, 0), index);
            p = clone(g2.last);
            return fromPart(g2, cx, dropsOld, ty, dest, p, false);
        };
        if op = 1 && n = 1 {
            g1 = elementOf(g, cx, f, ty, get(args, 0), "0");
            p = clone(g1.last);
            return fromPart(g1, cx, dropsOld, ty, dest, p, false);
        };
        if op = 2 && n = 1 {
            g1 = arrayLength(g, f, get(args, 0));
            length = clone(g1.last);
            g2 = lastIndex(g1, length);
            index = clone(g2.last);
            g3 = elementOf(g2, cx, f, ty, get(args, 0), index);
            p = clone(g3.last);
            return fromPart(g3, cx, dropsOld, ty, dest, p, false);
        };
    };
    // a field that is held inline
    if rv is Rvalue::ReadField {
        name = (rv as Rvalue::ReadField).name;
        field = (rv as Rvalue::ReadField).field;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        i = fieldIndex(ctor.fields, field);
        if i < 0 { return failG(k.g, "Variant ".then(name).then(" has no field ").then(field)); };
        g1 = dataBase(k.g, cx, f, constructedType(cx, name), (rv as Rvalue::ReadField).o);
        base = clone(g1.last);
        g2 = ins(g1, "p", "getelementptr i8, ptr ".then(base).then(", i64 ").then(showInt(fieldOffset(cx, ctor, i))));
        p = clone(g2.last);
        return fromPart(g2, cx, dropsOld, ty, dest, p, false);
    };
    // the field is moved out of the value: what it held is left holding nothing
    if rv is Rvalue::TakeField {
        name = (rv as Rvalue::TakeField).name;
        field = (rv as Rvalue::TakeField).field;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        i = fieldIndex(ctor.fields, field);
        if i < 0 { return failG(k.g, "Variant ".then(name).then(" has no field ").then(field)); };
        g1 = dataBase(k.g, cx, f, constructedType(cx, name), Operand::Copy { local: (rv as Rvalue::TakeField).local });
        base = clone(g1.last);
        g2 = ins(g1, "p", "getelementptr i8, ptr ".then(base).then(", i64 ").then(showInt(fieldOffset(cx, ctor, i))));
        p = clone(g2.last);
        return fromPart(g2, cx, dropsOld, ty, dest, p, true);
    };
    if rv is Rvalue::MakeData {
        name = (rv as Rvalue::MakeData).name;
        names = (rv as Rvalue::MakeData).fields;
        values = (rv as Rvalue::MakeData).values;
        k = constructorG(g, cx, name);
        if size(k.g.error.bytes) > 0 { return k.g; };
        ctor = ctorAt(cx, k.i);
        g1 = k.g;
        texts = noStrings();
        i = 0;
        while i < size(ctor.fields) [{ affirm i >= 0; affirm i <= size(ctor.fields); }] ~ {
            field = get(ctor.fields, i);
            j = fieldIndex2(names, field.name);
            if j < 0 || j >= size(values) { return failG(g1, "A field is missing: ".then(name).then(".").then(field.name)); };
            g1 = elementValue(g1, cx, f, field.ty, get(values, j));
            texts = push(texts, clone(g1.last));
            i = i + 1;
        };
        g2 = freeOld(g1, cx, dropsOld, ty, dest);
        if ctor.tagged { g2 = emit(g2, "store i32 ".then(showInt(ctor.tag)).then(", ptr ").then(target)); };
        i = 0;
        while i < size(ctor.fields) && i < size(texts) [{ affirm i >= 0; affirm i <= size(ctor.fields); affirm i <= size(texts); }] ~ {
            g2 = storeSlot(g2, cx, get(ctor.fields, i).ty, target, fieldOffset(cx, ctor, i), get(texts, i));
            i = i + 1;
        };
        return g2;
    };
    // the same value, known to be that variant (a Box of the library that is cast is taken out of its room, which is freed with the value
    // moved out, so that its drop has nothing to do)
    if rv is Rvalue::AsVariant {
        o = (rv as Rvalue::AsVariant).o;
        held = operandLocalType(f, o);
        if held.ok && isBoxStruct(held.ty) {
            l = 0;
            if o is Operand::Copy { l = (o as Operand::Copy).local; };
            if o is Operand::Move { l = (o as Operand::Move).local; };
            g1 = ins(g, "b", "load ptr, ptr ".then(slot(l)));
            block = clone(g1.last);
            if o is Operand::Move {
                g2 = emit(g1, "store i64 0, ptr ".then(slot(l)));
                g3 = freeOld(g2, cx, dropsOld, ty, dest);
                g4 = copyWords(g3, target, block, bytes);
                return emit(g4, "call void @tersus_box_free(ptr ".then(block).then(")"));
            };
            g2 = freeOld(g1, cx, dropsOld, ty, dest);
            return copyWords(g2, target, block, bytes);
        };
        g1 = operandAddress(g, cx, f, ty, o);
        src = clone(g1.last);
        g2 = freeOld(g1, cx, dropsOld, ty, dest);
        return copyWords(g2, target, src, bytes);
    };
    // Box::new of an inline array: a Box of an array is a list of native code (MirLists), so the elements move into memory of their own, with
    // as many in use as there is room for
    if rv is Rvalue::MakeBox && isListStruct(ty) {
        o = (rv as Rvalue::MakeBox).o;
        element = listElement(cx, ty);
        if !element.ok { return failG(g, "a list of native code without its element type"); };
        count = 0 - 1;
        held = operandLocalType(f, o);
        if held.ok && sizedArray(held.ty).ok { count = sizedArray(held.ty).length; };
        if o is Operand::Const {
            c = (o as Operand::Const).value;
            if c is Constant::CArray { count = size((c as Constant::CArray).items); };
        };
        if count < 0 { return failG(g, "Box::new of an array that has no size"); };
        elementBytes = bytesIn(cx, element.ty);
        g1 = operandAddress(g, cx, f, Type::TArray { elem: Box::new(clone(element.ty)), size: Size::SConst { n: count } }, o);
        src = clone(g1.last);
        g2 = ins(g1, "m", "call i64 @tersus_addr_alloc(i64 ".then(showInt(count)).then(", i64 ").then(showInt(elementBytes)).then(")"));
        m = clone(g2.last);
        g3 = ins(g2, "p", "inttoptr i64 ".then(m).then(" to ptr"));
        p = clone(g3.last);
        g4 = copyWords(g3, p, src, count * elementBytes);
        g5 = freeOld(g4, cx, dropsOld, ty, dest);
        g6 = emit(g5, "store i64 ".then(m).then(", ptr ").then(target));
        g7 = ins(g6, "q", "getelementptr i8, ptr ".then(target).then(", i64 8"));
        lengthAddress = clone(g7.last);
        g8 = emit(g7, "store i64 ".then(showInt(count)).then(", ptr ").then(lengthAddress));
        g9 = ins(g8, "q", "getelementptr i8, ptr ".then(target).then(", i64 16"));
        capacityAddress = clone(g9.last);
        return emit(g9, "store i64 ".then(showInt(count)).then(", ptr ").then(capacityAddress));
    };
    // Box::unbox of a Box of an array: the elements move out of the memory of the list, which is freed
    if rv is Rvalue::Unbox && isListStruct(operandLocalType(f, (rv as Rvalue::Unbox).o).ty) {
        o = (rv as Rvalue::Unbox).o;
        l = 0;
        if o is Operand::Copy { l = (o as Operand::Copy).local; };
        if o is Operand::Move { l = (o as Operand::Move).local; };
        if o is Operand::Move {
            g1 = ins(g, "m", "load i64, ptr ".then(slot(l)));
            m = clone(g1.last);
            g2 = ins(g1, "p", "inttoptr i64 ".then(m).then(" to ptr"));
            p = clone(g2.last);
            g3 = zeroWords(g2, slot(l), 24);
            g4 = freeOld(g3, cx, dropsOld, ty, dest);
            g5 = copyWords(g4, target, p, bytes);
            return emit(g5, "call void @tersus_addr_free(i64 ".then(m).then(")"));
        };
        g1 = ins(g, "p", "load ptr, ptr ".then(slot(l)));
        p = clone(g1.last);
        g2 = freeOld(g1, cx, dropsOld, ty, dest);
        return copyWords(g2, target, p, bytes);
    };
    return failG(g, "Native code does not support this for a value held inline yet");
};

// A local that is a word is given a value (a word owns nothing: what owns is held inline, and is freed where it is made, see assignAggregate)
fn store(g: Gen, cx: &Ctx, f: &Function, dest: Int, value: &String) -> Gen ~ {
    lt = localTypeOf(f, dest);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(dest))); };
    g1 = typeText(g, lt.ty);
    t = clone(g1.last);
    return emit(g1, "store ".then(t).then(" ").then(value).then(", ptr ").then(slot(dest)));
};

// Stores the result of a statement; in the entry, the return slot being assigned is what makes the program return a value
fn storeResult(g: Gen, cx: &Ctx, entry: Bool, f: &Function, dest: Int, value: &String) -> Gen ~ {
    g1 = store(g, cx, f, dest, value);
    if entry && dest = 0 { return emit(g1, "store i1 true, ptr %returned"); };
    return g1;
};

// A copy of the value that a local owns, which shares nothing with it, given to another local (which frees the value it held)
fn cloneInto(g: Gen, cx: &Ctx, f: &Function, dest: Int, destType: &Type, o: &Operand) -> Gen ~ {
    source = "";
    if o is Operand::Copy { source = slot((o as Operand::Copy).local); };
    if o is Operand::Move { source = slot((o as Operand::Move).local); };
    if o is Operand::Const { return failG(g, "Native code does not copy a constant"); };
    if !isAggregate(destType) { return copyWords(g, slot(dest), source, bytesIn(cx, destType)); };
    owns = ownsIn(cx, destType);
    if owns {
        // the copy is made before what the local held is freed, since it can be a part of it (`t = clone of t.next`)
        bytes = bytesIn(cx, destType);
        g2 = entryTemp(g, (bytes + 7) / 8);
        room = clone(g2.last);
        g3 = cloneValue(g2, cx, f.name, destType, room, source);
        return copyWords(g3, slot(dest), room, bytes);
    };
    return cloneValue(g, cx, f.name, destType, slot(dest), source);
};

fn emitStatement(g: Gen, cx: &Ctx, entry: Bool, f: &Function, st: &Statement) -> Gen ~ {
    if st is Statement::Drop {
        l = (st as Statement::Drop).local;
        lt = localTypeOf(f, l);
        if !lt.ok { return failG(g, "Undeclared local ".then(showInt(l))); };
        if ownsIn(cx, lt.ty) { return dropSlot(g, cx, lt.ty, l); };
        return g;
    };
    dest = 0;
    rv = Rvalue::Use { o: noOperand() };
    peek = false;
    if st is Statement::Peek {
        dest = (st as Statement::Peek).local;
        rv = (st as Statement::Peek).rv;
        peek = true;
    };
    if st is Statement::Assign {
        dest = (st as Statement::Assign).local;
        rv = (st as Statement::Assign).rv;
    };
    if st is Statement::AssignRef {
        root = (st as Statement::AssignRef).local;
        steps = (st as Statement::AssignRef).steps;
        rv2 = (st as Statement::AssignRef).rv;
        g1 = placeAddress(g, cx, f, root, steps);
        if size(g1.error.bytes) > 0 { return g1; };
        addr = clone(g1.last);
        ty = assignRefType(cx, f, root, steps);
        if isAggregate(ty) {
            if rv2 is Rvalue::Use {
                g2 = operandAddress(g1, cx, f, ty, (rv2 as Rvalue::Use).o);
                source = clone(g2.last);
                return copyWords(g2, addr, source, bytesIn(cx, ty));
            };
            if rv2 is Rvalue::Deref {
                g2 = operandValue(g1, cx, f, ty, (rv2 as Rvalue::Deref).o);
                source = clone(g2.last);
                return copyWords(g2, addr, source, bytesIn(cx, ty));
            };
            return failG(g1, "an assignment through a reference of this shape is not made by native code yet");
        };
        g2 = rvalue(g1, cx, f, ty, rv2);
        if size(g2.error.bytes) > 0 { return g2; };
        value = clone(g2.last);
        g3 = typeText(g2, ty);
        storeType = clone(g3.last);
        return emit(g3, "store ".then(storeType).then(" ").then(value).then(", ptr ").then(addr));
    };
    lt = localTypeOf(f, dest);
    if !lt.ok { return failG(g, "Undeclared local ".then(showInt(dest))); };
    returned = entry && dest = 0 && !peek;
    if peek {
        if isAggregate(lt.ty) { return assignAggregate(g, cx, f, false, dest, lt.ty, rv); };
        g1 = rvalue(g, cx, f, lt.ty, rv);
        value = clone(g1.last);
        g2 = typeText(g1, lt.ty);
        t = clone(g2.last);
        return emit(g2, "store ".then(t).then(" ").then(value).then(", ptr ").then(slot(dest)));
    };
    if rv is Rvalue::Copy {
        g1 = cloneInto(g, cx, f, dest, lt.ty, (rv as Rvalue::Copy).o);
        if returned { return emit(g1, "store i1 true, ptr %returned"); };
        return g1;
    };
    if isAggregate(lt.ty) {
        g1 = assignAggregate(g, cx, f, false, dest, lt.ty, rv);
        if returned { return emit(g1, "store i1 true, ptr %returned"); };
        return g1;
    };
    g1 = rvalue(g, cx, f, lt.ty, rv);
    value = clone(g1.last);
    return storeResult(g1, cx, entry, f, dest, value);
};

// A call of a function, given its symbol or the address of it, the types of its parameters and of its result
fn call(g: Gen, cx: &Ctx, entry: Bool, f: &Function, target: &String, argTypes: &List<Type>, ptrs: &List<Bool>, returnType: &Type, args: &List<Operand>, dest: Int, next: Int) -> Gen ~ {
    values = noStrings();
    g1 = g;
    i = 0;
    while i < size(argTypes) && i < size(args) [{ affirm i >= 0; affirm i <= size(argTypes); affirm i <= size(args); }] ~ {
        wanted = get(argTypes, i);
        argument = get(args, i);
        given = operandLocalType(f, argument);
        // (a local that is a reference to what the parameter wants is given what it is to: the value itself, or for a value held inline the address of its words, which is the pointer the reference holds)
        if i < size(ptrs) && get(ptrs, i) {
            if given.ok && (given.ty is Type::TRef || given.ty is Type::TMutRef) {
                g1 = operandValue(g1, cx, f, given.ty, argument);
            } else {
                if argument is Operand::Copy { g1 = giving(g1, slot((argument as Operand::Copy).local)); };
                if argument is Operand::Move { g1 = giving(g1, slot((argument as Operand::Move).local)); };
                if !(argument is Operand::Copy) && !(argument is Operand::Move) {
                    g1 = operandValue(g1, cx, f, wanted, argument);
                    if isAggregate(wanted) {
                        address = clone(g1.last);
                        g1 = giving(g1, address);
                    } else {
                        value = clone(g1.last);
                        g1 = entryTemp(g1, 1);
                        room = clone(g1.last);
                        g1 = typeText(g1, wanted);
                        text = clone(g1.last);
                        g1 = emit(g1, "store ".then(text).then(" ").then(value).then(", ptr ").then(room));
                        g1 = giving(g1, room);
                    };
                };
            };
        } else if given.ok && (given.ty is Type::TRef || given.ty is Type::TMutRef) && refTargetOf(given.ty) = wanted {
            g1 = operandValue(g1, cx, f, given.ty, argument);
            if !isAggregate(wanted) {
                address = clone(g1.last);
                g1 = loadAt(g1, wanted, address);
            };
        } else {
            g1 = operandValue(g1, cx, f, wanted, argument);
        };
        values = push(values, clone(g1.last));
        i = i + 1;
    };
    arguments = noStrings();
    j = 0;
    while j < size(values) && j < size(argTypes) [{ affirm j >= 0; affirm j <= size(values); affirm j <= size(argTypes); }] ~ {
        if j < size(ptrs) && get(ptrs, j) {
            arguments = push(arguments, "ptr ".then(get(values, j)));
        } else {
            g1 = typeText(g1, get(argTypes, j));
            arguments = push(arguments, clone(g1.last).then(" ").then(get(values, j)));
        };
        j = j + 1;
    };
    g2 = typeText(g1, returnType);
    result = clone(g2.last);
    if isAggregate(returnType) {
        // the callee makes a value held inline in the room it is given. If the local that gets it owns something, the room is one of the function's own and the local is given
        // the value after what it held is freed; otherwise it is the slot of the local (the callee has copied its arguments by the time it writes, so the local may be one of them).
        owns = ownsIn(cx, returnType);
        // (an argument that is lent is not copied by the callee, so the room for the result is not the local that is lent)
        lends = false;
        for a in args {
            if a is Operand::Copy {
                if (a as Operand::Copy).local = dest { lends = true; };
            };
        };
        g3 = g2;
        if owns || lends {
            g3 = entryTemp(g3, slotsIn(cx, returnType));
            room = clone(g3.last);
            all = noStrings();
            all = push(all, "ptr ".then(room));
            for a in arguments { all = push(all, clone(a)); };
            g3 = emit(g3, "call void ".then(target).then("(").then(joinWith(", ", all)).then(")"));
            g3 = copyWords(g3, slot(dest), room, bytesIn(cx, returnType));
        } else {
            all = noStrings();
            all = push(all, "ptr ".then(slot(dest)));
            for a in arguments { all = push(all, clone(a)); };
            g3 = emit(g3, "call void ".then(target).then("(").then(joinWith(", ", all)).then(")"));
        };
        if entry && dest = 0 { g3 = emit(g3, "store i1 true, ptr %returned"); };
        return emit(g3, "br label %".then(blockLabel(next)));
    };
    g3 = ins(g2, "c", "call ".then(result).then(" ").then(target).then("(").then(joinWith(", ", arguments)).then(")"));
    value = clone(g3.last);
    g4 = storeResult(g3, cx, entry, f, dest, value);
    return emit(g4, "br label %".then(blockLabel(next)));
};

fn emitTerminator(g: Gen, cx: &Ctx, entry: Bool, f: &Function, t: &Terminator) -> Gen ~ {
    if t is Terminator::Goto { return emit(g, "br label %".then(blockLabel((t as Terminator::Goto).block))); };
    if t is Terminator::Switch {
        g1 = operandValue(g, cx, f, Type::TBool, (t as Terminator::Switch).cond);
        v = clone(g1.last);
        return emit(g1, "br i1 ".then(v).then(", label %").then(blockLabel((t as Terminator::Switch).yes)).then(", label %").then(blockLabel((t as Terminator::Switch).no)));
    };
    if t is Terminator::Unreachable { return emit(g, "unreachable"); };
    if t is Terminator::Call {
        callee = (t as Terminator::Call).callee;
        args = (t as Terminator::Call).args;
        dest = (t as Terminator::Call).dest;
        next = (t as Terminator::Call).next;
        if callee is Operand::Const {
            c = (callee as Operand::Const).value;
            if c is Constant::CFn {
                name = (c as Constant::CFn).name;
                i = sigIndex(cx, name);
                if i < 0 { return failG(g, "Call of a function that does not exist: ".then(name)); };
                target = get(cx.sigs, i);
                if !target.paramsOk { return failG(g, "Undeclared local of ".then(name)); };
                if !target.hasReturn { return failG(g, "Function without a result: ".then(name)); };
                return call(g, cx, entry, f, functionSymbol(name), target.params, target.ptrs, target.returns, args, dest, next);
            };
        };
        // a function value: the address of a function, with the types its type says
        callees = push([], clone(callee));
        ty = sharedType(cx, f, callees);
        if ty is Type::TFn {
            g1 = operandValue(g, cx, f, ty, callee);
            address = clone(g1.last);
            return call(g1, cx, entry, f, address, (ty as Type::TFn).args, noBools(), Box::unbox((ty as Type::TFn).ret), args, dest, next);
        };
        return failG(g, "Call of something that is not a function");
    };
    // Return
    if !f.hasReturn { return emit(g, "ret void"); };
    ty = f.returns;
    if isAggregate(ty) {
        g1 = copyWords(g, "%ret", slot(0), bytesIn(cx, ty));
        if entry {
            g2 = ins(g1, "f", "load i1, ptr %returned");
            returned = clone(g2.last);
            return emit(g2, "ret i1 ".then(returned));
        };
        return emit(g1, "ret void");
    };
    g1 = typeText(g, ty);
    tt = clone(g1.last);
    g2 = ins(g1, "v", "load ".then(tt).then(", ptr ").then(slot(0)));
    v = clone(g2.last);
    if entry {
        g3 = ins(g2, "f", "load i1, ptr %returned");
        returned = clone(g3.last);
        result = resultStruct(tt);
        g4 = ins(g3, "w", "insertvalue ".then(result).then(" undef, ").then(tt).then(" ").then(v).then(", 0"));
        withValue = clone(g4.last);
        g5 = ins(g4, "w", "insertvalue ".then(result).then(" ").then(withValue).then(", i1 ").then(returned).then(", 1"));
        both = clone(g5.last);
        return emit(g5, "ret ".then(result).then(" ").then(both));
    };
    return emit(g2, "ret ".then(tt).then(" ").then(v));
};

fn emitBlock(g: Gen, cx: &Ctx, entry: Bool, f: &Function, b: &MirBlock) -> Gen ~ {
    g1 = label(g, blockLabel(b.id));
    for st in b.stmts { g1 = emitStatement(g1, cx, entry, f, st); };
    return emitTerminator(g1, cx, entry, f, b.term);
};

// The lines of the blocks of a function
fn emitBody(cx: &Ctx, entry: Bool, f: &Function) -> Gen ~ {
    g = newGen(f.name);
    for b in f.blocks { g = emitBlock(g, cx, entry, f, b); };
    return g;
};

// The function around its blocks

// What a function is as text: its lines, and the types its code makes a function for (the newest first), or why there is none
struct FnOut { ok: Bool, error: String, lines: List<String>, types: List<Type> };

impl Clone for FnOut { };

fn failedFn(message: &String) -> FnOut [{ }] [{ }] {
    return FnOut { ok: false, error: clone(message), lines: noStrings(), types: noTypes() };
};

// What a local takes in the frame: a word, or for a value held inline all the words it is made of
fn storageText(cx: &Ctx, t: &Type) -> Res ~ {
    if isAggregate(t) { return Res { ok: true, text: "[".then(showInt(slotsIn(cx, t))).then(" x i64]") }; };
    return llvmType(t);
};

// Whether a parameter is lent and held inline
fn lentInline(f: &Function, l: Int) -> Bool ~ {
    return hasInt(f.borrowed, l) || hasInt(f.mutBorrowed, l);
};

// The declaration of a C function: its parameters and its result are words
fn externDeclaration(f: &Function) -> FnOut ~ {
    ptexts = noStrings();
    for p in f.params {
        lt = localTypeOf(f, p);
        if !lt.ok { return failedFn("Undeclared local ".then(showInt(p))); };
        r = llvmType(lt.ty);
        if !r.ok { return failedFn(r.text); };
        ptexts = push(ptexts, r.text);
    };
    ret = "void";
    if f.hasReturn {
        r = llvmType(f.returns);
        if !r.ok { return failedFn(r.text); };
        ret = r.text;
    };
    line = "declare ".then(ret).then(" ").then(functionSymbol(f.name)).then("(").then(joinWith(", ", ptexts)).then(")");
    return FnOut { ok: true, error: "", lines: push(noStrings(), line), types: noTypes() };
};

// The IR of a function: `entry` is for main, which also keeps whether the return slot was assigned
fn emitFunction(cx: &Ctx, entry: Bool, symbol: &String, f: &Function) -> FnOut ~ {
    prefix = "In ".then(f.name).then(": ");
    ptexts = noStrings();
    for p in f.params {
        lt = localTypeOf(f, p);
        if !lt.ok { return failedFn(prefix.then("Undeclared local ").then(showInt(p))); };
        r = llvmType(lt.ty);
        if !r.ok { return failedFn(prefix.then(r.text)); };
        if lentInline(f, p) { ptexts = push(ptexts, "ptr"); } else { ptexts = push(ptexts, r.text); };
    };
    valueType = "void";
    if f.hasReturn {
        r = llvmType(f.returns);
        if !r.ok { return failedFn(prefix.then(r.text)); };
        valueType = r.text;
    };
    returnsAggregate = f.hasReturn && isAggregate(f.returns);
    // (a value held inline comes back in room that the caller gives, as the first parameter)
    returnType = clone(valueType);
    if returnsAggregate {
        if entry { returnType = "i1"; } else { returnType = "void"; };
    } else {
        if entry && f.hasReturn { returnType = resultStruct(valueType); };
    };
    localTexts = noStrings();
    for d in f.locals {
        r = storageText(cx, d.ty);
        if !r.ok { return failedFn(prefix.then(r.text)); };
        localTexts = push(localTexts, r.text);
    };
    body = emitBody(cx, entry, f);
    if size(body.error.bytes) > 0 { return failedFn(prefix.then(body.error)); };
    // a parameter that is lent and held inline is the caller's words, which the function reads where they are: it has no room of its own
    params = noStrings();
    if returnsAggregate { params = push(params, "ptr %ret"); };
    i = 0;
    while i < size(f.params) && i < size(ptexts) [{ affirm i >= 0; affirm i <= size(f.params); affirm i <= size(ptexts); }] ~ {
        p = get(f.params, i);
        name = "%p.".then(showInt(p));
        if lentInline(f, p) { name = slot(p); };
        params = push(params, clone(get(ptexts, i)).then(" ").then(name));
        i = i + 1;
    };
    header = "define internal ".then(returnType).then(" ").then(symbol).then("(").then(joinWith(", ", params)).then(") {");
    lines = noStrings();
    for l in body.globals { lines = push(lines, clone(l)); };
    lines = push(lines, header);
    lines = push(lines, "entry:");
    j = 0;
    while j < size(f.locals) && j < size(localTexts) [{ affirm j >= 0; affirm j <= size(f.locals); affirm j <= size(localTexts); }] ~ {
        d = get(f.locals, j);
        if !lentInline(f, d.id) { lines = push(lines, "    ".then(slot(d.id)).then(" = alloca ").then(get(localTexts, j))); };
        j = j + 1;
    };
    for l in body.temps { lines = push(lines, clone(l)); };
    for d in f.locals {
        if isAggregate(d.ty) && needsDropIn(cx, d.ty) && !hasInt(f.params, d.id) {
            lines = push(lines, "    call void @llvm.memset.p0.i64(ptr ".then(slot(d.id)).then(", i8 0, i64 ").then(showInt(bytesIn(cx, d.ty))).then(", i1 false)"));
        };
    };
    k = 0;
    while k < size(f.params) && k < size(ptexts) [{ affirm k >= 0; affirm k <= size(f.params); affirm k <= size(ptexts); }] ~ {
        p = get(f.params, k);
        lt = localTypeOf(f, p);
        // (a value held inline is given by its address, and the function works on its own copy, unless it is lent)
        if lt.ok {
            if !lentInline(f, p) {
                if isAggregate(lt.ty) {
                    lines = push(lines, "    ".then(memcpyText(slot(p), "%p.".then(showInt(p)), bytesIn(cx, lt.ty))));
                } else {
                    lines = push(lines, "    store ".then(get(ptexts, k)).then(" %p.").then(showInt(p)).then(", ptr ").then(slot(p)));
                };
            };
        } else {
            lines = push(lines, "    store ".then(get(ptexts, k)).then(" %p.").then(showInt(p)).then(", ptr ").then(slot(p)));
        };
        k = k + 1;
    };
    if entry && f.hasReturn {
        lines = push(lines, "    %returned = alloca i1");
        lines = push(lines, "    store i1 false, ptr %returned");
        if !returnsAggregate { lines = push(lines, "    store ".then(valueType).then(" ").then(zeroOf(valueType)).then(", ptr ").then(slot(0))); };
    };
    lines = push(lines, "    br label %bb0");
    for l in body.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "overflow:");
    lines = push(lines, "    call void @tersus_overflow()");
    lines = push(lines, "    unreachable");
    lines = push(lines, "}");
    newest = noTypes();
    m = size(body.types);
    while m > 0 [{ affirm m >= 0; affirm m <= size(body.types); }] shrinks m {
        m = m - 1;
        newest = push(newest, clone(get(body.types, m)));
    };
    return FnOut { ok: true, error: "", lines: lines, types: newest };
};

// What the code of a function gives, as lines: the globals the code needs, the rooms for the values it builds, the code, and the types it makes a function for (the
// newest first)
fn bodyLines(index: Int, g: &Gen) -> List<String> ~ {
    out = noStrings();
    out = push(out, "; function ".then(showInt(index)));
    out = push(out, "; globals");
    for l in g.globals { out = push(out, clone(l)); };
    out = push(out, "; temps");
    for l in g.temps { out = push(out, clone(l)); };
    out = push(out, "; code");
    for l in g.lines { out = push(out, clone(l)); };
    out = push(out, "; types");
    i = size(g.types);
    while i > 0 [{ affirm i >= 0; affirm i <= size(g.types); }] shrinks i {
        i = i - 1;
        out = push(out, renderType(get(g.types, i)));
    };
    return out;
};

// The code of every function, each with a line that says which it is (the functions in order, then main); a function the emitter cannot make is marked
fn bodies(program: &Program) -> List<String> ~ {
    cx = contextOf(program);
    out = noStrings();
    index = 0;
    for f in program.functions {
        g = emitBody(cx, false, f);
        if size(g.error.bytes) > 0 {
            out = push(out, "; function ".then(showInt(index)));
            out = push(out, "; unsupported");
        } else {
            for l in bodyLines(index, g) { out = push(out, clone(l)); };
        };
        index = index + 1;
    };
    g = emitBody(cx, true, program.entry);
    if size(g.error.bytes) > 0 {
        out = push(out, "; function ".then(showInt(index)));
        out = push(out, "; unsupported");
    } else {
        for l in bodyLines(index, g) { out = push(out, clone(l)); };
    };
    return out;
};

// The lines that write a text, a byte at a time (tersus_writeByte is the byte of the runtime)
fn printTextLines(tagIn: &String, text: &String) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    i = 0;
    for b in text.bytes {
        out = push(out, "    %t".then(clone(tag)).then(".").then(showInt(i)).then(" = call i64 @tersus_writeByte(i64 ").then(showInt(toInt(b))).then(")"));
        i = i + 1;
    };
    return out;
};

// The lines that make the word a slot holds (slot_value of the runtime) in %<tag>w, from its address in %<tag>p
fn printWordLines(types: &List<TypeDecl>, tagIn: &String, ty: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    p = "%".then(clone(tag)).then("p");
    w = "%".then(clone(tag)).then("w");
    if isAggregate(ty) || sizedArray(ty).ok {
        out = push(out, "    ".then(w).then(" = ptrtoint ptr ").then(p).then(" to i64"));
        return out;
    };
    if ty is Type::TBool {
        out = push(out, "    %".then(clone(tag)).then("b = load i8, ptr ").then(p));
        out = push(out, "    %".then(clone(tag)).then("c = icmp ne i8 %".then(clone(tag)).then("b, 0")));
        out = push(out, "    ".then(w).then(" = zext i1 %".then(clone(tag)).then("c to i64")));
        return out;
    };
    simple = simpleLayout(ty);
    if simple.ok && simple.layout.size < 8 {
        bits = showInt(simple.layout.size * 8);
        out = push(out, "    %".then(clone(tag)).then("v = load i").then(bits).then(", ptr ").then(p));
        ext = "zext";
        if ty is Type::TWord && (ty as Type::TWord).signed { ext = "sext"; };
        out = push(out, "    ".then(w).then(" = ").then(ext).then(" i").then(bits).then(" %".then(clone(tag)).then("v to i64")));
        return out;
    };
    out = push(out, "    ".then(w).then(" = load i64, ptr ").then(p));
    return out;
};

// The lines that print the value of the type at %<tag>p
fn printCallLines(types: &List<TypeDecl>, tagIn: &String, ty: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    for l in printWordLines(types, tag, ty) { out = push(out, clone(l)); };
    out = push(out, "    call void ".then(printSymbol(types, ty)).then("(i64 %").then(clone(tag)).then("w)"));
    return out;
};

// The lines of the loop that prints elements (of the type at %<tag>p offsets in %base, their number in %count), between the brackets
fn printElementsLines(types: &List<TypeDecl>, tagIn: &String, elem: &Type) -> List<String> ~ {
    tag = clone(tagIn);
    out = noStrings();
    step = layoutOf(types, elem).size;
    for l in printTextLines(clone(tag).then("o"), "[") { out = push(out, clone(l)); };
    out = push(out, "    br label %".then(clone(tag)).then("head"));
    out = push(out, clone(tag).then("head:"));
    out = push(out, "    %".then(clone(tag)).then("i = phi i64 [0, %entry], [%").then(clone(tag)).then("next, %").then(clone(tag)).then("elem]"));
    out = push(out, "    %".then(clone(tag)).then("cond = icmp eq i64 %").then(clone(tag)).then("i, %count"));
    out = push(out, "    br i1 %".then(clone(tag)).then("cond, label %").then(clone(tag)).then("done, label %").then(clone(tag)).then("sepq"));
    out = push(out, clone(tag).then("sepq:"));
    out = push(out, "    %".then(clone(tag)).then("first = icmp eq i64 %").then(clone(tag)).then("i, 0"));
    out = push(out, "    br i1 %".then(clone(tag)).then("first, label %").then(clone(tag)).then("elem, label %").then(clone(tag)).then("sep"));
    out = push(out, clone(tag).then("sep:"));
    for l in printTextLines(clone(tag).then("s"), ", ") { out = push(out, clone(l)); };
    out = push(out, "    br label %".then(clone(tag)).then("elem"));
    out = push(out, clone(tag).then("elem:"));
    out = push(out, "    %".then(clone(tag)).then("off = mul i64 %").then(clone(tag)).then("i, ").then(showInt(step)));
    out = push(out, "    %e".then(clone(tag)).then("p = getelementptr i8, ptr %base, i64 %").then(clone(tag)).then("off"));
    for l in printCallLines(types, "e".then(clone(tag)), elem) { out = push(out, clone(l)); };
    out = push(out, "    %".then(clone(tag)).then("next = add i64 %").then(clone(tag)).then("i, 1"));
    out = push(out, "    br label %".then(clone(tag)).then("head"));
    out = push(out, clone(tag).then("done:"));
    for l in printTextLines(clone(tag).then("c"), "]") { out = push(out, clone(l)); };
    return out;
};

// The lines that print the number in %w, in decimal (the digits are made from the end of a room of the frame)
fn printDecimalLines(signed: Bool) -> List<String> ~ {
    out = noStrings();
    if signed {
        out = push(out, "    %negc = icmp slt i64 %w, 0");
        out = push(out, "    br i1 %negc, label %neg, label %conv0");
        out = push(out, "neg:");
        for l in printTextLines("m", "-") { out = push(out, clone(l)); };
        out = push(out, "    %mag0 = sub i64 0, %w");
        out = push(out, "    br label %conv");
        out = push(out, "conv0:");
        out = push(out, "    br label %conv");
        out = push(out, "conv:");
        out = push(out, "    %mag = phi i64 [%mag0, %neg], [%w, %conv0]");
    } else {
        out = push(out, "    %mag = add i64 %w, 0");
    };
    out = push(out, "    %buf = alloca [20 x i8]");
    out = push(out, "    %vp = alloca i64");
    out = push(out, "    store i64 %mag, ptr %vp");
    out = push(out, "    %cp = alloca i64");
    out = push(out, "    store i64 0, ptr %cp");
    out = push(out, "    %iszero = icmp eq i64 %mag, 0");
    out = push(out, "    br i1 %iszero, label %zero, label %dhead");
    out = push(out, "zero:");
    for l in printTextLines("z", "0") { out = push(out, clone(l)); };
    out = push(out, "    ret void");
    out = push(out, "dhead:");
    out = push(out, "    %v = load i64, ptr %vp");
    out = push(out, "    %ddone = icmp eq i64 %v, 0");
    out = push(out, "    br i1 %ddone, label %ohead, label %dbody");
    out = push(out, "dbody:");
    out = push(out, "    %d = urem i64 %v, 10");
    out = push(out, "    %ch = add i64 %d, 48");
    out = push(out, "    %chi = trunc i64 %ch to i8");
    out = push(out, "    %c = load i64, ptr %cp");
    out = push(out, "    %pos = sub i64 19, %c");
    out = push(out, "    %bp = getelementptr i8, ptr %buf, i64 %pos");
    out = push(out, "    store i8 %chi, ptr %bp");
    out = push(out, "    %nv = udiv i64 %v, 10");
    out = push(out, "    store i64 %nv, ptr %vp");
    out = push(out, "    %nc = add i64 %c, 1");
    out = push(out, "    store i64 %nc, ptr %cp");
    out = push(out, "    br label %dhead");
    out = push(out, "ohead:");
    out = push(out, "    %c2 = load i64, ptr %cp");
    out = push(out, "    %odone = icmp eq i64 %c2, 0");
    out = push(out, "    br i1 %odone, label %fin, label %obody");
    out = push(out, "obody:");
    out = push(out, "    %pos2 = sub i64 20, %c2");
    out = push(out, "    %bp2 = getelementptr i8, ptr %buf, i64 %pos2");
    out = push(out, "    %ch2 = load i8, ptr %bp2");
    out = push(out, "    %chw = zext i8 %ch2 to i64");
    out = push(out, "    %wr = call i64 @tersus_writeByte(i64 %chw)");
    out = push(out, "    %nc2 = sub i64 %c2, 1");
    out = push(out, "    store i64 %nc2, ptr %cp");
    out = push(out, "    br label %ohead");
    out = push(out, "fin:");
    out = push(out, "    ret void");
    return out;
};

// The offset of each field of a variant (after the tag of an enum)
fn printFieldStart(types: &List<TypeDecl>, variants: &List<Variant>, isEnumKind: Bool) -> Int ~ {
    payload = 1;
    for v in variants {
        l = fieldsLayout(types, v.fields);
        if l.align > payload { payload = l.align; };
    };
    if isEnumKind { return roundUp(4, payload); };
    return 0;
};

// The function that prints a value of the type
fn printFunctionLines(types: &List<TypeDecl>, t: &Type) -> List<String> ~ {
    out = noStrings();
    out = push(out, "define internal void ".then(printSymbol(types, t)).then("(i64 %w) {"));
    out = push(out, "entry:");
    if t is Type::TInt || t is Type::TAddr {
        for l in printDecimalLines(true) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TWord && (t as Type::TWord).signed {
        for l in printDecimalLines(true) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TByte || t is Type::TWord {
        for l in printDecimalLines(false) { out = push(out, clone(l)); };
        out = push(out, "}");
        return out;
    };
    if t is Type::TBool {
        out = push(out, "    %cond = icmp ne i64 %w, 0");
        out = push(out, "    br i1 %cond, label %bt, label %bf");
        out = push(out, "bt:");
        for l in printTextLines("t", "true") { out = push(out, clone(l)); };
        out = push(out, "    br label %bend");
        out = push(out, "bf:");
        for l in printTextLines("f", "false") { out = push(out, clone(l)); };
        out = push(out, "    br label %bend");
        out = push(out, "bend:");
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    if t is Type::TFn {
        for l in printTextLines("u", "<function>") { out = push(out, clone(l)); };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    arr = sizedArray(t);
    if arr.ok {
        out = push(out, "    %base = inttoptr i64 %w to ptr");
        out = push(out, "    %count = add i64 ".then(showInt(arr.length)).then(", 0"));
        for l in printElementsLines(types, "a", arr.elem) { out = push(out, clone(l)); };
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    n = declaredName(types, t);
    if !n.ok {
        out = push(out, "    ret void");
        out = push(out, "}");
        return out;
    };
    variants = variantsOf(types, n.text);
    enumKind = isEnum(types, n.text);
    start = printFieldStart(types, variants, enumKind);
    out = push(out, "    %slot = inttoptr i64 %w to ptr");
    if size(variants) > 0 && size(get(variants, 0).fields) > 0 && (beforeAngle(n.text) = "List" || beforeAngle(n.text) = "Box") {
        fields = get(variants, 0).fields;
        offset0 = 0;
        lenOffset = 0;
        offset = 0;
        i = 0;
        for f in fields {
            l = layoutOf(types, f.ty);
            offset = roundUp(offset, l.align);
            if i = 0 { offset0 = start + offset; };
            if i = 1 { lenOffset = start + offset; };
            offset = offset + l.size;
            i = i + 1;
        };
        held = get(fields, 0).ty;
        if held is Type::TAddr {
            elem = Box::unbox((held as Type::TAddr).inner);
            out = push(out, "    %addrp = getelementptr i8, ptr %slot, i64 ".then(showInt(offset0)));
            out = push(out, "    %addr = load i64, ptr %addrp");
            if beforeAngle(n.text) = "List" {
                out = push(out, "    %lenp = getelementptr i8, ptr %slot, i64 ".then(showInt(lenOffset)));
                out = push(out, "    %count = load i64, ptr %lenp");
                out = push(out, "    %base = inttoptr i64 %addr to ptr");
                for l in printElementsLines(types, "l", elem) { out = push(out, clone(l)); };
            } else {
                out = push(out, "    %eheldp = inttoptr i64 %addr to ptr");
                for l in printCallLines(types, "eheld", elem) { out = push(out, clone(l)); };
            };
            out = push(out, "    ret void");
            out = push(out, "}");
            return out;
        };
    };
    if enumKind {
        out = push(out, "    %tag = load i32, ptr %slot");
        cases = "";
        j = 0;
        for v in variants {
            cases = cases.then(" i32 ").then(showInt(j)).then(", label %v").then(showInt(j));
            j = j + 1;
        };
        out = push(out, "    switch i32 %tag, label %done [".then(cases).then(" ]"));
    };
    j = 0;
    for v in variants {
        if enumKind { out = push(out, "v".then(showInt(j)).then(":")); };
        for l in printTextLines("n".then(showInt(j)), beforeAngle(v.name)) { out = push(out, clone(l)); };
        if size(v.fields) > 0 {
            for l in printTextLines("o".then(showInt(j)), " { ") { out = push(out, clone(l)); };
            offset = 0;
            i = 0;
            for f in v.fields {
                l = layoutOf(types, f.ty);
                offset = roundUp(offset, l.align);
                if i > 0 {
                    for l2 in printTextLines("s".then(showInt(j)).then(".").then(showInt(i)), ", ") { out = push(out, clone(l2)); };
                };
                for l2 in printTextLines("f".then(showInt(j)).then(".").then(showInt(i)), beforeAngle(f.name).then(": ")) { out = push(out, clone(l2)); };
                tag = "x".then(showInt(j)).then(".").then(showInt(i));
                out = push(out, "    %".then(tag).then("p = getelementptr i8, ptr %slot, i64 ").then(showInt(start + offset)));
                for l2 in printCallLines(types, tag, f.ty) { out = push(out, clone(l2)); };
                offset = offset + l.size;
                i = i + 1;
            };
            for l in printTextLines("c".then(showInt(j)), " }") { out = push(out, clone(l)); };
        };
        if enumKind { out = push(out, "    br label %done"); };
        j = j + 1;
    };
    if enumKind { out = push(out, "done:"); };
    out = push(out, "    ret void");
    out = push(out, "}");
    return out;
};

// A print function for every type the program holds a value of
fn printFunctions(types: &List<TypeDecl>, closed: &List<Type>) -> List<String> ~ {
    out = noStrings();
    for t in closed {
        for l in printFunctionLines(types, t) { out = push(out, clone(l)); };
        out = push(out, "");
    };
    return out;
};

// The whole IR of the program: the declarations, the functions in order,
// main, and the entry point
fn ir(program: &Program) -> Entry ~ {
    cx = contextOf(program);
    pieces = [];
    roots = noTypes();
    for f in program.functions {
        r = failedFn("");
        if isExtern(f.name) { r = externDeclaration(f); } else { r = emitFunction(cx, false, functionSymbol(f.name), f); };
        if !r.ok { return failedEntry(r.error); };
        pieces = push(pieces, r.lines);
        for t in r.types { roots = push(roots, clone(t)); };
    };
    m = emitFunction(cx, true, "@tersus_main", program.entry);
    if !m.ok { return failedEntry(m.error); };
    for t in m.types { roots = push(roots, clone(t)); };
    e = entryPoint(program.types, functionNames(program), program.entry);
    if !e.ok { return e; };
    for t in e.types { roots = push(roots, clone(t)); };
    closed = closeTypes(program.types, roots);
    lines = declarations();
    for b in pieces {
        for l in b { lines = push(lines, clone(l)); };
        lines = push(lines, "");
    };
    for l in m.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    for l in dropFunctions(program.types, functionNames(program), closed) { lines = push(lines, clone(l)); };
    for l in cloneFunctions(cx, closed) { lines = push(lines, clone(l)); };
    for l in printFunctions(program.types, closed) { lines = push(lines, clone(l)); };
    for l in e.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    return Entry { ok: true, error: "", lines: lines, types: closed };
};

// The IR so far: the declarations, the made functions of the types of the locals and what they contain, and the entry point
fn outline(program: &Program) -> Entry ~ {
    entry = entryPoint(program.types, functionNames(program), program.entry);
    if !entry.ok { return entry; };
    roots = noTypes();
    for f in program.functions {
        for d in f.locals { roots = push(roots, clone(d.ty)); };
    };
    for d in program.entry.locals { roots = push(roots, clone(d.ty)); };
    for t in entry.types { roots = push(roots, clone(t)); };
    closed = closeTypes(program.types, roots);
    cx = contextOf(program);
    lines = declarations();
    for l in dropFunctions(program.types, functionNames(program), closed) { lines = push(lines, clone(l)); };
    for l in cloneFunctions(cx, closed) { lines = push(lines, clone(l)); };
    for l in printFunctions(program.types, closed) { lines = push(lines, clone(l)); };
    for l in entry.lines { lines = push(lines, clone(l)); };
    lines = push(lines, "");
    return Entry { ok: true, error: "", lines: lines, types: closed };
};

// The program is read from the standard input and its IR is written. The first argument says what: `ir` (or none) is all of it, `outline` the
// declarations, the made functions and the entry point, and `bodies` the code of each function. What cannot be read or made is
// reported on the standard error.
mode = String::arg(0, 100);
read = readLines();
if !read.ok {
    "the input is not the MIR as data: a bad name\n".printError();
    return 1;
};
program = programAt(read.value);
if !program.ok {
    "the input is not the MIR as data\n".printError();
    return 1;
};
if mode = "bodies" {
    printLines(bodies(program.value));
} else {
    if mode = "outline" || mode = "ir" || mode = "" {
        result = outline(program.value);
        if mode != "outline" { result = ir(program.value); };
        if !result.ok {
            result.error.printError();
            "\n".printError();
            return 1;
        };
        printLines(result.lines);
    } else {
        "the first argument is ir, outline or bodies\n".printError();
        return 1;
    };
};
