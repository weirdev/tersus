// Array<T, N> holds N elements, and the size is part of the type. An array is held inline, wherever it is made: in the frame of
// a function, with no pointer to it, so it costs no allocation. The size is a constant (array(5, 0), #[7, 8, 9]), and an
// element is an Int, a Bool or another array.
//
// size, get, first, last and set work on it as on a list (set gives a new array and leaves its argument alone, and in a loop
// that assigns the array back to itself it is a store into the array). There is no push: the size never changes.
//
// The validator knows the size of every array from its type, so no contract or loop invariant has to say it.
fn dot(a: Array<Int, 5>, b: Array<Int, 5>) -> Int {
    total = 0;
    i = 0;
    while i < size(a) [{ affirm i >= 0; affirm i <= size(a); }] shrinks size(a) - i {
        total = total + get(a, i) * get(b, i);
        i = i + 1;
    };
    return total;
};

// An array comes back from a function by value, as any other value
fn squares() -> Array<Int, 5> {
    out = array(5, 0);
    i = 0;
    while i < 5 [{ affirm i >= 0; affirm i <= 5; }] shrinks 5 - i {
        out = set(out, i, i * i);
        i = i + 1;
    };
    return out;
};

s = squares();                  // #[0, 1, 4, 9, 16]
ones = array(5, 1);
total = dot(s, ones);           // 30

// Arrays nest inline: a grid of 2 rows of 3 is six words
grid = array(2, array(3, 1));
grid = set(grid, 1, set(get(grid, 1), 2, 9));       // #[#[1, 1, 1], #[1, 1, 9]]
return total + get(get(grid, 1), 2) + size(#[7, 8, 9]);
