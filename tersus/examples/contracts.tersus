// The output contract is checked against the body, then instantiated at each call.
// The empty input contract [{}] is required to write an output contract alone.
fn add1(i) [{}] [{
    affirm return = (i + 1);
}] {
    return i + 1;
};

// Proof variables defined in a contract (here s) are exported to the caller.
fn firstWithSize(lst) [{
    define s = size(lst);
    rewrite eqToGtZero s;
    affirm s > 0;
}] [{
    affirm s > 0;
}] {
    return first(lst);
};

x = add1(4);
affirm x = 5;
y = firstWithSize([3, 6, 9, 12]);
affirm y = 3;
// s came from firstWithSize's contract.
affirm s > 0;
return y + x;
